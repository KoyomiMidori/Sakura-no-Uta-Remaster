astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="bluesky_summer",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm038"},
{"text"},
text={
ja={
{
"Salgo en la mañana al hospital.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Salí lo más temprano que pude, antes de que comenzaran los exámenes.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tengo algo que preguntarte, viejo.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"bg",file="ev_com_f02_02",path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000845",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué es?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Conoces a Rin Misakura?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000846",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Rin Misakura...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Mi padre tomó una expresión estática por un momento, pero después volvió al\nmismo rostro pícaro de siempre.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000847",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué pasa ahora? ¿Es que Kuzu te contó?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo hizo.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso Rin tiene alguna relación de sangre con los Natsume?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000848",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Jajaja, de ninguna manera. Entre Rin y los Natsume no existe vínculo alguno.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Después de soltar una seca risa, mi padre continuó hablando con un rostro\nserio.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000849",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fui yo quien dio con Rin Misakura. Así de simple.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Diste con ella?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_kid_000850",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí. Mi primera y única aprendiz.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuzu dijo lo mismo, ¿estás hablando en serio? Jamás te vi como el tipo de\npersona capaz de tener un aprendiz.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000851",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ni jamás pensé yo en tener uno. Pero Rin fue la excepción.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que Rin Misakura se convirtió en tu aprendiz?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="man_kid_000852",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Porque había un don en ella superior a cualquiera que haya visto hasta ahora.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Rin, una genio? ¿De la pintura?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000853",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es. Rin es una genio, y una de verdad.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuándo la conociste?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000854",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Todo sucedió cuando me enteré del estado de Mizuna y regresé por un tiempo.\nJusto cuando compré el apartamento donde vives ahora.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, recuerdo que elegiste ese apartamento porque estaba cerca del hospital\ndonde mamá estaba internada.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="man_kid_000855",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“En esos días iba con frecuencia a la residencia Natsume, en Kootoha. Fue en uno\nde esos días que por casualidad la encontré en medio de la calle.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En medio de la calle?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="man_kid_000856",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, estaba dibujando con agalmatolita.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000857",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“En ese momento decidí hacerla mi aprendiz.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso el dibujo que estaba haciendo estaba al nivel de Picasso y\nKandinsky? ¿Tan vanguardista era que te cautivó?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000858",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No te creas, los dibujos de niños son vanguardistas. Aunque, por lo general\nterminan siendo algo aburrido.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000859",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Los niños que producen dibujos capaces de impresionar incluso adultos terminan,\npor lo general, produciendo creaciones aburridas al crecer. Para qué te digo\nesto, se supone que ya lo sabes, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Por cosa rara, mi padre reaccionó con seriedad ante mi aparentemente estúpida\npregunta.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y entonces?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000860",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Cuando vi eso pensé, esto tiene que ser una enfermedad.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una enfermedad?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="man_kid_000861",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Sabes lo que hizo Rin? Convirtió el asfalto en un espejo e invirtió el mundo.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Usó el asfalto como espejo e invirtió el mundo? ¿Qué demonios?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="man_kid_000862",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pintó sobre todo el asfalto el escenario que se vería desde ese asfalto. Había\ntanto detalle y exactitud en el diseño que no pude contener la sorpresa.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Viendo cómo lo dices, debe haber sido la gran cosa.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000863",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿La gran cosa? Esa cosa no era un dibujo, era casi una fotografía.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000864",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Me quedé embobado viendo la calidad del dibujo. Fue allí que ella me dijo esto.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="man_kid_000865",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El mundo no cambiará ahí donde estás parado, dijo. Y entonces, señaló un lugar.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_kid_000866",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Yo tampoco entendí por un momento lo que quería decir. Y por eso fui al lugar\nque Rin me señaló.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="man_kid_000867",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fue ahí que lo que hasta ahora parecía ser solo un dibujo bastante exacto, tomó\nsu verdadera forma.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Su verdadera forma? ¿Cuál era esa verdadera forma?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="man_kid_000868",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fuera de ese lugar, el dibujo parecía estar enormemente deformado. Pero, justo\ncuando me puse sobre el lugar que Rin señaló--”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="man_kid_000869",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sentí que el escenario alrededor se había reflejado sobre el asfalto.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El escenario reflejado sobre el asfalto?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000870",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, era agalmatolita, ¿sabes? El blanco tenía algo de apariencia de espejismo,\ny parecía como si realmente el panorama alrededor estuviera reflejado en el\nasfalto.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es posible hacer algo así?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000871",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Usando una fotografía como lo hacen en el superrealismo y siguiendo los pasos\nadecuados, junto con algo de audacia, entonces cualquiera podría hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000872",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero lo que Rin pintó era un dibujo que solo podía verse adecuadamente en un\nsolo lugar.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="man_kid_000873",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y en un mismo día, en una misma sesión de dibujo, usó el asfalto como un enorme\nlienzo y pintó algo sin distinción alguna con la realidad.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De lo que me describes, ciertamente no es algo que cualquiera pueda hacer...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000874",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero lo más asombroso del asunto no fue su capacidad de dibujo.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000875",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Su capacidad de dibujo fue solo una herramienta en el proceso. Fue su decisión\nde usar agalmatolita para producir un efecto de espejismo, y convertir el\nasfalto en un espejo.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="man_kid_000876",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por un momento sentí que el mundo reflejado en ese espejo era el verdadero.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000877",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fue como si solo por ese instante, la forma en que veía el mundo cambiara. Es\ncomo si el disperso mundo en blanco que ella pintó fuese el mundo real, y\nnuestro nítido mundo real, falso.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es en serio? ¿Es eso posible? Supongamos que realmente pudieras convertir el\nasfalto en un espejo usando agalmatolita, ¿cómo demonios podrías percibir más\nrealidad ahí?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="man_kid_000878",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fue Rin Misakura quien pudo lograr eso.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="man_kid_000879",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fue ella quien logró producir la ilusión de que el mundo dibujado en el asfalto\nera más real que el verdadero. Y con un instrumento perecedero como lo es la\nagalmatolita.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000880",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fue Rin quien logró hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es en serio? ¿No será más bien que imaginaste cosas, viejo? Quizás solo\nquedaste impresionado por la calidad del dibujo, y por un instante te pareció\nver algo así...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="man_kid_000881",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Yo también pensé eso al principio, pero estaba equivocado.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000882",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Todo, todo estaba calculado. Todo había sido calculado hasta el más mínimo\ndetalle, para que el mundo cambiara justamente sobre ese lugar.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_kid_000883",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ella planeó y creó ese dibujo.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000884",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Además, en ese momento también me preguntó esto.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003696",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Señor, ¿está Dios dentro de usted?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bg",file="ev_com_f02_03",path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué quiso decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000885",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tal cual lo que dijo, supongo. Habrá preguntado si dentro de mí residía el dios\nde la belleza.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000886",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Obviamente, Rin contestó 'Dentro de mí está Dios'. Supongo que por eso puede\ncrear todo tipo de cosas bellas...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000887",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Dios creó el mundo en siete días. ¿Qué podría crear entonces una muchacha que\ntiene a Dios dentro de sí?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé. Si eso fuese verdad, pues podría crear cualquier cosa, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="man_kid_000888",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, y realmente tiene una imaginación que no cualquiera tiene. Y una casi\naterradora capacidad para materializar esa imaginación.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Capacidad de materialización?... Qué manera de decirlo.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000889",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya no estamos hablando de pinturas o simples creaciones. Es materialización. En\nla cabeza de esa muchacha existen todo tipo de imágenes inimaginables por las\npersonas normales, y es también capaz de recrear eso en el mundo real.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000890",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es por eso que no se trata de pintar, sino de materialización de imágenes. No\nes tan desacertado lo que insinúa cuando dice que Dios está dentro de ella.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De lo que me cuentas, pues ciertamente no. Pero aun así me cuesta creerlo.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000891",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Obviamente no me vas a creer. Es imposible conocer el terrible poder de esa\nmuchacha sin presenciarlo antes.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dices que no es creación, sino materialización. Que no se trata de talento,\nsino una habilidad especial, eh. Suena bastante a una habilidad supernatural.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000892",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así parecía serlo.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, la Rin que yo conocí no pintaba.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000893",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y yo me pregunto por qué. La verdad es que de eso no sé mucho. De qué manera\nesa genio te veía a ti... no lo sé.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="man_kid_000894",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y no sé por qué tampoco, pero parece que le gustabas más que lo que ella a\nmí...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000895",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Nah, no es nada. No hace falta que sepas esto.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000896",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De igual forma no quería que trataras mucho con ella en lo que a pintura se\nrefería.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué? ¿Es que pensabas que perdería toda la motivación al ver sus pinturas?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000897",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Amor de padre.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Amor de padre?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000898",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“O tal vez sentía que no era todavía el momento... quizás.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000899",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Quería dedicarme a formarte en todo lo relacionado a la pintura, pero\nterminaste huyendo de Estados Unidos para regresar a Japón.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, soy un hijo de mamá.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000900",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Hijo de mamá?... Pues, quizás también por eso, pero en realidad regresaste\nporque estabas preocupado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000901",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Aun con lo joven que eras, estabas enterado del conflicto entre los Natsume y\nlos Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="man_kid_000902",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sabías que lo de Mizuna ya estaba resuelto, pero aun así no aguantabas dejar a\ntu madre sola, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... De igual forma, ella tenía a los Natsume acompañándola.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000903",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Yo hubiese dicho lo mismo y habría permanecido en Nueva York trabajando, si no\nfuese porque la abuela Natsume murió.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000904",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Regresaste a Japón justamente cuando Kotoko Natsume, la abuela, murió.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="man_kid_000905",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Para decir la verdad, yo también me preocupé por dejar a Mizuna sola. Me habían\ncontado que desde la muerte de la abuela Natsume algunos tipos que parecían\nser de los Nakamura comenzaron a merodear por la residencia.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero mamá te pidió que te quedaras en Nueva York trabajando.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000906",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, eso me pidió. No tenía más opción, eh. La seguridad de Mizuna estaba\ngarantizada solo por la deuda que recaía sobre ella. Tenía que conseguir\ndinero.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000907",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y de igual forma, no pude darte una buena formación como artista.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué? ¿Y por eso te conseguiste una aprendiz?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000908",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No creas, no creas, el tiempo que estuve enseñándole a Rin fue casi una\ncentésima del que invertí contigo.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero fue la única aprendiz que has aceptado hasta ahora, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000909",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000910",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Le enseñé a describir.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A describir? ¿Eso significa que le enseñaste a dibujar?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000911",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No. Le enseñé lo que es el arte. De nada servía enseñarle los principios del\ndibujo, es mucho mejor que yo.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="man_kid_000912",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Esa muchacha tenía una genial imaginación, pero el arte no es solo eso.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="man_kid_000913",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lo podría poner de esta manera, usé esa cuña llamada 'arte' y puse cadenas\nsobre su imaginación.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cadenas sobre su imaginación? ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="man_kid_000914",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Las pinturas de esa muchacha no eran algo que un humano podría pintar.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="man_kid_000915",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De seguir inflando su imaginación sin consciencia alguna de ello, y de seguir\nmaterializando más y más, era probable que perdiera todo vestigio de\nnormalidad.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué pasaría si dejaba de ser normal?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000916",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No tengo ni idea. Lo único que puedo decir, es que ese poder no es algo que un\nhumano pueda aguantar.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué, crees eso?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000917",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Será porque vi ese dibujo? Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000918",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Los creyentes de lo místico dicen que la belleza no se puede poner en palabras.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="man_kid_000919",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y por eso fue que le enseñé a ella algo con cierta humanidad, como lo es el\narte.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Algo con cierta humanidad como lo es el arte, eh. Sí, bueno, solo los humanos\nlo hacen.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000920",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No lo digo en ese sentido.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000921",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El arte es una crítica a la vida.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién dijo eso?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000922",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Yo. Bueno, las obtuve de Matthew Arnold.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién es ese?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000923",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No importa quién sea. Así te explique no creo que tengas la suficiente\neducación como para entenderlo.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000924",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Olvida eso por ahora. Naoya, ¿qué crees que sea la crítica para el arte?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues lo que hacen los críticos del arte, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000925",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Jaa, toda una respuesta de tercera. Terrible.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué es entonces?!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000926",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Un mundo cerrado no es arte. Y para agregar a eso, un mundo cerrado no puede\nser perfecto.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un mundo cerrado? ¿No puede ser perfecto?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000927",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, así es. Cuando hablo de eso hablo también de como los pájaros cantan en un\nsilencioso bosque de cerezos.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás hablando de tu poema, ¿no? El poema grabado en 'Cerezos recostados'.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000928",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tal cual.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese poema es horriblemente críptico. No se entiende nada de lo que dice. ¿Es\nque pretendes explicarme algún día lo que quiere decir?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"bg",file="ev_com_f02_04",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000929",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Claro que quisiera explicarte. ¿Quieres que te de un simple resumen?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Explica.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000930",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El arte llega a su culminación cuando es observado.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="man_kid_000931",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Las obras son cadáveres. Pero cadáveres que no se descomponen. Son como un\nhermoso y limpio espécimen.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000932",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Un cadáver no deja de ser cadáver, por más detalle y acabado que tenga. Y en un\nmundo cerrado no dejará nunca de ser un cadáver.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="man_kid_000933",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Cuando llegas al nivel de un genio, te encuentras con que viven en un mundo\ncerrado. Y es que su mundo es perfecto.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000934",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Rin Misakura es una genio. En el sentido, también, de que sus obras son\ncerradas.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="man_kid_000935",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por esa parte, se podría decir también que el arte no es algo genial, sino\nhumano.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000936",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y es que el arte no es un mundo cerrado.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A ese nivel llega el don de Rin Misakura...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000937",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“También le hablé de la visión del arte que tuvieron los grandes intelectuales\nde la historia. Aristóteles, por ejemplo.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aristóteles? ¿Le hablaste de esas famosas líneas?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="man_kid_000938",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El arte imita a la naturaleza.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000939",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero Rin no llegó a acoplarse mucho con esa idea. Prefería todo lo contrario.\nLe gustó 'El crítico artista' y 'La decadencia de la mentira'.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No conozco esos libros.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000940",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ni hace falta que los conozcas. Hablan de la idea de que todo objeto en el\nmundo es solo una imitación del arte. No combina para nada con tu ideal\nartístico.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="man_kid_000941",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Le llaman esteticismo. Parece que le sentó muy bien a la pequeña genio.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000942",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero el esteticismo también requiere la intervención de los ojos de otros, así\nque fue útil para enseñarle a alguien como Rin, que vivía en un mundo\ncerrado.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000943",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fui yo quien juntó a Kuzu y a Rin.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000944",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Creí que funcionaría teniendo a las dos juntas...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000945",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Me pareció que Rin necesitaba un espectador. Y alguien que no se dejara\ncautivar tan fácilmente.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué no debe cautivarse?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000946",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Los ojos de los demás no representan nada para Rin.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="man_kid_000947",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Probablemente sabía, de nacimiento, que todas las demás personas tenían un\nsentido estético y una imaginación inferior a la suya. Era de esperarse\nentonces que en el punto extremo de su esteticismo no hubiera valor alguno en\nespectadores.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="man_kid_000948",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Incluso yo quedé cautivado en un abrir y cerrar de ojos por sus pinturas. Sus\ncreaciones están hechas para cautivar. Los ojos de los demás no sirven de\nnada.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000949",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Sabías? A los dos años asombró a sus padres con un dibujo que hizo. Y parece\nque desde entonces ya no ha dibujado más frente a ellos.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué? Se supone que su padre es un artista y también comerciante de\npinturas, ¿no? ¿No sería más bien una alegría para ellos descubrir que su\nhija es una genio?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000950",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Entiende, ella, inconscientemente, sabía ya que sus padres eran también\ninferiores a ella. Y tampoco quería reconocerlo.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000951",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por eso es que no volvió a dibujar frente a ellos.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Ahora que sé eso, creo que puedo entender un poco lo que percibiste en\nella...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000952",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿A que sí? Es una muchacha que nació, de cierta forma, maldecida en lo que la\npintura, o más bien lo estético se refiere.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y por qué juntaste entonces a Kuzu y a Rin?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000953",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“En ese entonces Kuzu no tenía sentimiento alguno.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No tenía sentimientos?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000954",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí. Todavía no había despertado como Hakuki, así que los Nakamura no se habían\nenterado aún. Pero esa es la peculiaridad que tienen aquellas muchachas que\nencarnan a Hakuki.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000955",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Quería darle sentimientos a Kuzu. Quería que viviera como una muchacha normal,\ncomo alguien más.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="man_kid_000956",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero lamentablemente Ai no pudo avivar sus sentimientos, e incluso yo como\nartista tampoco.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000957",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero tal vez Rin sí podrá, pensé. Se me ocurrió que Rin podría ser capaz\nincluso de crear un corazón de la nada...”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que no pareces tú, hablando tan bien de alguien...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000958",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Estás celoso?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nah, no tiene caso que envidie a alguien por su arte. Total, ya no puedo\npintar.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"bg",file="ev_com_f02_04",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000959",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Jaa... ¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000960",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Darle corazón a una muchacha sin uno.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="man_kid_000961",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Aun teniendo a una genio como Rin, no fue una labor fácil.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000962",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Kuzu ni siquiera pestañeaba al ver sus pinturas.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="man_kid_000963",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Para Rin, fue la primera vez en encontrarse con alguien así.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="man_kid_000964",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y por eso Rin siguió pintando frente a esa muchacha sin corazón.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="man_kid_000965",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Día tras día, sin parar, siguió pintando.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="man_kid_000966",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pintó todo lo que podría haber en este mundo, y todo lo que definitivamente no\nera de él.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nadie puede pintar todo lo que hay en este mundo, menos aun todo lo que no\nexiste en él...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000967",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí se puede. En las pinturas de Rin había un poder que hacía parecer eso\nposible a los demás...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="man_kid_000968",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Podrías decir que era un monstruo del esteticismo. Una muchacha maldecida por\nla belleza.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="man_kid_000969",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero fue esa muchacha quien logró darle un corazón a Kuzu.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000970",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fue Rin Misakura quien convirtió a Kuzu, a Hakuki, en una humana.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="man_kid_000971",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y fue Kuzu quien le dio a Rin lo que es realmente un espectador.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="man_kid_000972",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Rin aprendió en ese momento el júbilo de mostrarle sus obras a alguien más.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000973",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Un tiempo después, el mundo de sus pinturas se abrió un poco. Aunque siguió\nproduciendo cuadros con ese mismo sello maldito del esteticismo.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sinceramente, no veo a Rin como alguien capaz de hacer eso.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000974",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Rin era una muchacha tranquila cuando no pintaba, es de esperarse. Era incluso\nun poco torpe.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso sí lo sé.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000975",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“En el fondo es una buena muchacha. Simplemente nació maldecida por algo,\nlamentablemente.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué Rin carga con esa especie de maldición encima?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000976",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Eso no lo sé.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="man_kid_000977",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Solo hay algo que sí me atrevería a decir. Imagínate que Dios existiese, y que\nese Dios fuese perfecto. De ser así, no tendría razón alguna para crear este\nmundo, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso piensas?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000978",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya sería perfecto de por sí. Con eso bastaría. No necesitaría nada más, y no\ntendría razón para crear un mundo.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000979",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así de incomprensible es esto.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Más complicado se me hace ese ejemplo que acabas de usar.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="man_kid_000980",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿En serio? Mi intuición siempre me ha hecho preguntarme por qué si Dios es\nperfecto, por qué si en esa perfección podría permanecer completamente solo,\ncreó un mundo.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="man_kid_000981",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Siento que esa enigmática intuición se asemeja al misterio de Rin.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No entiendo nada de nada.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000982",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ella misma dice que Dios reside en ella, ¿qué necesidad habría entonces de\ncrear obras?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="man_kid_000983",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De igual forma, si ella percibió a Dios dentro de sí, y si le pareció que ahí\nhabía más valor que cualquier otra cosa, entonces ese sería un Dios fuerte.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un Dios fuerte?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000984",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí. Una vez le dije a Rin, 'tu Dios es fuerte'. Y se rió...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un Dios fuerte...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000985",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Sabes de lo que hablo?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo ni la más mínima idea.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000986",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, ya olvidaba que eres un idiota.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El idiota eres tú. Comenzaste a hablar sin explicar absolutamente nada.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000987",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues sí, no puedo negar que mi terrible explicación no ayuda en nada...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero bueno, ya entendí que Rin era una genio, y que necesitaba a Kuzu. ¿Y bien,\nqué viene después?”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000988",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Después, eh... después ocurrió aquel incendio.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El incendio...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="man_kid_000989",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Justo después fue que todo se reinició. ¿Espera, es reiniciar la palabra\nadecuada? ¿O tal vez no?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin sufrió una gran perdida por ese incendio.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000990",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, así es. Y tú también. Pero no fueron ustedes dos los únicos en perder algo.\nEl asunto es mucho más complicado.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000991",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El padre de Rin y tú intentaron ocultarle la verdad de ese incidente. Creyeron\nque eso sería lo mejor para ella.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="man_kid_000992",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero no fueron los únicos en pensar eso. Muchas otras personas han intentado\nocultar la verdad de ese accidente.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000993",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De la misma manera que tú elegiste hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que si intenté ocultarlo? Sí. Aunque juzgando por lo que dices, ¿insinúas que\nhay otra verdad aparte de la que yo conozco?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="man_kid_000994",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Exactamente.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000995",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De ese incidente conoces solo un lado. Y existe otro.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Otro lado...”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_000996",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué pasaría si los cerezos milenarios, y ese poder sobrenatural de Rin de\nmaterializar las cosas, llegaran a cruzarse?...”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="man_kid_000997",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tú lo sabes muy bien, ¿hace falta que te lo diga? De ser así, incluso el deseo\nmás difícil de cumplir, se cumpliría.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="man_kid_000998",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y bien que suena como algo maravilloso, pero en realidad lo único que harías es\nalterar el orden lógico del mundo.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="man_kid_000999",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“En ese caso, ese orden lógico alterado sería compensado por otro evento...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="man_kid_001000",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Piensa entonces, ¿qué pasaría si ese milagro fuera cancelado por otro\nmilagro?...”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="man_kid_001001",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Esa deformación lógica destrozaría toda clase de vínculo entre las personas...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un milagro, para otro milagro... espera, no me digas que...”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001002",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Como aprendizaje de esto, lo único que puedo decir es que intentar cubrir un\n'milagro' con otro no es muy buena idea.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"Kenichiro asintió ligeramente.\nY entonces.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001003",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Bueno, hasta acá llega esta historia.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
vo={
{"vo",file="man_kid_001004",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No voy a contar más.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué no?...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001005",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De ser necesario, los involucrados te contaran cuando llegue el momento.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"bg",file="ev_com_f02_07",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001006",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tampoco digo que sea un secreto que valga la pena ocultar, ni nada por el\nestilo. Pero no es bueno exponer lo oculto con tanta ligereza.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
vo={
{"vo",file="man_kid_001007",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Estamos hablando de algo oculto. Si no hay necesidad de revelarlo entonces más\nbien debería ser olvidado. Eso lo sabes bien, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001008",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿No te convenció mi historia?”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En realidad sí, ya asimilé gran parte de la historia.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001009",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No pareciera.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Después de escuchar que Rin es una supergenio, pues... no lo encuentro muy\nfácil de aceptar.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001010",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, ¿eso? No te preocupes, si llegas a encontrarte con Rin de nuevo\nprobablemente solo verás a la misma tranquila y pacífica muchacha que\nconoces.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="man_kid_001011",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y no a esa muchacha sellada con la maldición de la belleza.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001012",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya no tiene nada de ese talento.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"De cierta forma sentí que todas las piezas dentro de mi cabeza iban uniéndose.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, creo que ya entendí lo que quieres decir.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque no creo que llegue a ver a Rin de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001013",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vamos, no digas eso. Según parece, Rin se moría por ti.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso dices? Probablemente la talentosa superartista Rin me veía solo como un\npintor ordinario, uno más del montón.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="man_kid_001014",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Talentosa superartista, pero también una muchacha como las demás. Ella también\nera capaz de enamorarse.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"bg",file="ev_com_f02_04",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001015",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Todo un donjuán, eh.”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Donjuán?... Estamos hablando solo de Rin, demonios.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001016",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Eres idiota o te las das? ¿Es que acaso olvidas que también está la muchacha\nque recibió su corazón de Rin?”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué estás intentado decir?”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001017",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Rin solía hablar bastante de ti mientras pintaba...”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
vo={
{"vo",file="man_kid_001018",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tienes a una muchacha sin corazón, y a una artista que le dio uno. ¿Qué\nsentimiento crees que pudo haber dejado la huella más fuerte en ese nuevo\ncorazón?...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001019",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y sí que pasé un largo, largo tiempo con ella, así que creo saber bien eso...”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"bg",file="ev_com_f02_06",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001020",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Aunque tengo que decirlo, eh, esa muchacha es mucho para ti...”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pregunto una vez más, ¿qué estás intentado decir?”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"bgm",stop=1,time=1000},
{"bg",file="ev_com_f02_03",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001021",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Bueh, qué importa.”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Importa qué?”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
vo={
{"vo",file="man_kid_001022",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Rin le dio un corazón a Kuzu, y eso probablemente la afectó en varios aspectos,\npienso yo.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Explícame de una buena vez, ¿qué quieres decir con eso de la huella a su\ncorazón y todo lo demás? No estoy entendiendo nada.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"bgm",file="bgm007"},
{"text"},
text={
vo={
{"vo",file="man_kid_001023",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Asegúrate de protegerte cuando tengas sexo con Kuzu.”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿P-Por qué con Kuzu?! ¡Ni me atrevería a hacerlo, en primer lugar! ¡¿Es que se\nte volaron todas las tuercas de la cabeza, idiota?!”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001024",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Estás en un hospital, no hables tan duro, por Dios. Ahh, me duelen los oídos.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"bg",file="ev_com_f02_04",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001025",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Te has parecido a mí en lo popular con las mujeres. Aunque con lo guapo que soy\nes inevitable eso.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuzu me contó lo mucho que te desagradaba cuando te dijeron que nos parecíamos.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"bg",file="ev_com_f02_01",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001026",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, bueno, preferiría que el guapo fuese solo yo. Que todas se murieran solo\npor mí.”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es por eso debiste haberte casado de nuevo después de que mamá murió.”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001027",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ton, tín. Los Kusanagi somos fieles de nacimiento. Así como la abuela Natsume\nlo fue, solo podemos amar a una sola persona.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Será verdad eso? Yo creo que más bien estuviste saltando de mujer en mujer por\nallá en Nueva York.”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"bg",file="ev_com_f02_08",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001028",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Idiota, no me pongas en el mismo lugar que a ti. El que no ha perdido la\nvirginidad aún eres tú, estoy más que seguro que cuando por fin saborees a\nuna mujer te volverás un maniático del sexo.”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no, imbécil. A diferencia de ti, yo sí soy un auténtico hombre\nfiel.”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"bg",file="ev_com_f02_04",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001029",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Ah, sí? Puedes decir eso todavía que eres virgen. Yo sí tengo un historial de\nfidelidad garantizado.”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso mismo digo que no te creo.”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"bg",file="ev_com_f02_02",sync=0,face=1,time=400,path=":ev/ev_com_f02/",set="ev_com_f02"},
{"text"},
text={
vo={
{"vo",file="man_kid_001030",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Y qué pruebas tienes para decir lo contrario? ¡No me hace falta tener a\nidiotas como tú acá, vamos, vete!”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ni hace falta que lo digas, me voy! Idiota...”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
vo={
{"vo",file="man_kid_001031",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Deja de decir tonterías, idiota.”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El que dice idiota es más idiota.”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
vo={
{"vo",file="man_kid_001032",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fuiste tú quien lo dijo primero, idiota.”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"bgm",stop=1,time=1000},
{"se",file="se9010",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg067a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Me paro del sillón.",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
"Y me acerco a la puerta.",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
ja={
{
name={"Naoya"},
"“....”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sea lo que sea, estoy agradecido contigo. Gracias a ti, mamá fue feliz.”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"fg",ch="健一郎",size="z1",mode=3,resize=1,path=":fg/ken/z1/",file="ken_z1a0000",face="a0005",head="ken_z1a",lv=4,id=9},
{"bgm",file="bgm029"},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_001033",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ahí te equivocas. Fue gracias a ti que Mizuna vivió feliz hasta el último\naliento. Te agradezco por eso.”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, no vendré más por un buen rato. Procura no estirar la pata hasta que todo\ntermine.”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0003",head="ken_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_001034",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por supuesto que no lo haré. Esperaré a ver que resuelvas todo esto para irme.”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso espero.”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001035",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Otra cosa, antes de que te vayas.”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0005",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001036",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Al momento de liberar a Kuzu, asegúrate también de obtener un artefacto llamado\n'Hakuki Kagurasuzu' que los Nakamura tienen en su posesión.”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿'Hakuki Kagurasuzu'? ¿Qué demonios es eso?”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0011",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001037",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No habrá garantía alguna de seguridad para Kuzu mientras tengan ese artefacto\nen sus manos.”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ni siquiera por medio de un juramento escrito?”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
{"fgact",ch="健一郎",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001038",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Misiones imposibles es lo único que me das...”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_001039",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y te las doy porque confió en ti.”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues gracias por la confianza...”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
ja={
{
"Salí rápidamente por la puerta.",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"bgm",stop=1,time=1000},
{"se",id=1,file="gatya"},
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"excall",file="03_andoe_02_11"},
{"text"},
linkback="block_00319",
},
label = {
top={block="block_00000",label=1},
},
}
