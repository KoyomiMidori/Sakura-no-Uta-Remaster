{"excall",label="join"},
{"text"},
labelcount=1,
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Minutos después de despedirme de Rina.",
{"rt2"},
},
},
},
labelcount=2,
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Me di cuenta de que me habían rodeado.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="fem_yum_001963",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"se",file="se9004",id=1},
{"se",file="se0744",id=2},
{"se",file="se1135",id=3},
{"se",file="se3130",id=4},
{"quake",mode="mw"},
{"quake"},
{"bgm",file="bgm015"},
{"text"},
text={
ja={
{
"Un montón de gente va cerrándome, poco a poco.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"se",stop=1,id=1,time=500},
{"se",stop=1,id=2,time=500},
{"se",stop=1,id=3,time=500},
{"se",stop=1,id=4,time=500},
{"text"},
text={
ja={
{
"Qué lata... ¿Por qué tienen que venir tantas?...",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Completamente rodeada ahora, me hacen entrar a un callejón solitario.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Son bastantes...",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_yum_001964",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bien, aquí estamos. ¿Podrían decirme que necesitan de mí como para haberme\ntraído a este lugar, señoritas?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_jka_000035",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Responde algo. ¿Qué es lo que eres de Kusanagi-senpai?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_yum_001965",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya les dije que soy su novia...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"se",id=1,file="se_binta"},
{"quake",mode="mw"},
{"quake"},
{"text"},
text={
vo={
{"vo",file="fem_jka_000036",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Deja de decir estupideces. Él dijo que eso no era cierto.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_yum_001966",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Vaya que fue repentina esa bofetada. Esta es de las que gustan de imponer su\nopinión por la fuerza...",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000032",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“Instalaste una trampa en tu casillero, ¿verdad? Créeme que dolió bastante.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
delay={
vl01={
{"se",id=1,file="se_kick3"},
{"quake",size=5,mode="mw"},
{"quake"},
},
},
text={
vo={
{"vo",file="fem_yum_001967",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues nadie te manda a abrir casilleros ajen--*guoh*”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_jka_000037",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¿Sabes en qué lío estás metida? Sabes muy bien lo que te vamos a hacer ahora,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Esta vez me pateó en el vientre.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Sí, claro que lo sé.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Sé que las cosas se irán poniendo más violentas...",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_yum_001968",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Lío? Vaya lío, eh...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="fem_jka_000038",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Escucha, mosquita muerta, nadie te conoce en el colegio, solo eres una\ncualquiera más. ¿Qué te crees ahora, actuando de esa forma desde que\nterminaron las vacaciones de verano? Es insoportable.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Jaa, vaya... ¿Tanto aparentar ser la niña tranquila para esto?",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000033",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“¿Acaso tuviste alguna revelación en el verano o qué? ¿Un cambio radical de\nimagen de regreso al colegio?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001969",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Hum!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jka_000039",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¡¿Gyah?!”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"msgoff"},
{"se",file="se3130",id=1},
{"bg",x=-640,y=90,file="zbg015b",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="優美",size="z2",zoom=140,speed=400,mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0110",face="a0006",head="yum_z2a",x2=-320,x=320,y=170,lv=5,id=9,sync=0},
{"bg",file="black",id=7,lv=7,x=0,y=940,speed=300,ease="easeout_quint",path=":bg/",y2=0,sync=0},
{"bg",file="black",id=8,lv=8,x=0,y=-940,speed=300,ease="easeout_quint",path=":bg/",y2=0,sync=0},
{"extrans",time=0},
{"ex",time=300,func="wait"},
{"cgdel",id=-1},
{"bg",x=-640,y=90,file="zbg015b",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="優美",size="z2",zoom=140,mode=3,path=":fg/yum/z2/",file="yum_z2a0110",face="a0006",head="yum_z2a",x=320,y=170,lv=5,id=9,sync=0},
{"bg",file="black",id=7,lv=7,x=0,y=0,speed=300,ease="easeout_quint",path=":bg/",y2=940,sync=0},
{"bg",file="black",id=8,lv=8,x=0,y=0,speed=300,ease="easeout_quint",path=":bg/",y2=-940,sync=0},
{"extrans",time=0},
{"ex",time=100,func="wait"},
{"msgoff"},
{"cgdel",id=-1},
{"bg",time=50,file="black",path=":bg/"},
{"se",file="se1615_z",id=1},
{"bg",file="battle_008r",id=8,lv=8,rule="106r",time=50,path=":cg/battle/",set="battle"},
{"ex",time=0,func="wait"},
{"bg",file="閃光小",id=9,lv=9,rule=014,time=80,path=":cg/battle/",set="battle"},
{"se",file="se_attack05",id=2},
{"quake"},
{"text"},
text={
ja={
{
"Le lancé un puñetazo en la cara, sin titubear.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=300},
{"text"},
text={
vo={
{"vo",file="fem_jkb_000034",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Por lo general, en las peleas entre mujeres nunca hay puñetazos a la cara.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Suelen ser más llamativas. Mucho ruido, ataques exagerados.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Y por eso comienzo con algo más efectivo a una bofetada. Un puñetazo.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Cuando hay mujeres alrededor todo empieza en bofetadas, pero luego la violencia\nescala, y terminan dándote una paliza.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Luego vuelven con su irritante charla, para luego venir de nuevo con las\nbofetadas.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Repiten eso, una y otra vez. Ese es el estilo particular de los linchamientos\nentre mujeres.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Y por eso, hago lo que las mujeres no hacen.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"No, la verdad es que los hombres tampoco suelen atacar directamente a la cara.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Cosas como estas no puedes hacerlas sin tener una buena cantidad de experiencia\nprevia.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001970",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Toma!”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jka_000040",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¡Gyah!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"msgoff"},
{"se",file="se3130",id=1},
{"bg",x=-640,y=90,file="zbg015b",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="優美",size="z2",zoom=140,speed=400,mode=3,path=":fg/yum/z2/",file="yum_z2a0110",face="a0006",head="yum_z2a",x2=320,x=-320,y=170,lv=5,id=9,sync=0},
{"bg",file="black",id=7,lv=7,x=0,y=940,speed=300,ease="easeout_quint",path=":bg/",y2=0,sync=0},
{"bg",file="black",id=8,lv=8,x=0,y=-940,speed=300,ease="easeout_quint",path=":bg/",y2=0,sync=0},
{"extrans",time=0},
{"ex",time=300,func="wait"},
{"cgdel",id=-1},
{"bg",x=-640,y=90,file="zbg015b",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="優美",size="z2",zoom=140,mode=3,path=":fg/yum/z2/",file="yum_z2a0110",face="a0006",head="yum_z2a",x=-320,y=170,lv=5,id=9,sync=0},
{"bg",file="black",id=7,lv=7,x=0,y=0,speed=300,ease="easeout_quint",path=":bg/",y2=940,sync=0},
{"bg",file="black",id=8,lv=8,x=0,y=0,speed=300,ease="easeout_quint",path=":bg/",y2=-940,sync=0},
{"extrans",time=0},
{"ex",time=100,func="wait"},
{"cgdel",id=-1},
{"bg",time=100,file="black",path=":bg/"},
{"bg",file="sp0200a_上からの打撃02",id=8,lv=8,rule=215,time=50,path=":cg/"},
{"se",id=1,file="se_punch2"},
{"quake"},
{"text"},
text={
ja={
{
"Gancho izquierdo.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Mi izquierda no es tan fuerte como mi derecha, así que inclino mi peso en el\ngancho.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"La fuerza de los puñetazos suele depender de qué tanto peso apliques.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"En el caso de personas con un cuerpo pequeño como el mío, los puñetazos se\ndeben lanzar con todo el peso posible.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Mi repentino contraataque las deja a todas desconcertadas.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Y así debe dejarlas. De lo contrario estoy acabada.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Me llevan la ventaja absoluta en número.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Por más que se trate de una muchedumbre en desorden, si llegan a arrinconarme y\ngolpearme todas no tendré chance de contraatacar.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Así que mi única apuesta está en tomar ventaja con el primer ataque.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_yum_001971",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Taah!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jka_000041",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¡Gyah!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Termino con una patada.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"bg",file="sp0200p_上からの打撃02",id=9,lv=9,rule=215,time=50,path=":cg/"},
{"se",id=1,file="se_kick"},
{"quake"},
{"text"},
text={
ja={
{
"La muchacha sale volando.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_jkb_000035",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“¿Q-Qué fue eso?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_jkc_000013",ch="jkc"},
},
ja={
{
name={"Alumna C"},
"“¿Eh? ¿E-Eh?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"El miedo se está apoderando de ellas.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Las muchedumbres sujetas al terror son débiles.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Les lanzo una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_yum_001972",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pensaron que la mosquita muerta era una debilucha, ¿eh?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_yum_001973",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues lamento decirles que no lo soy.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Respondo sonriente.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"La verdad es que no me queda tanta fuerza.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"La mano con la que golpeé a la muchacha me duele más de lo que esperaba.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"¿Será que no la golpeé de la manera debida? No, probablemente se debe a que mi\ncuerpo no es el mismo de antes.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Parece que ese pesado gancho izquierdo fue mucha carga para mí.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Mi cuerpo ya no es apto para golpear a personas.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Aunque, no es nada de lo que deba preocuparme. Eso si es que me dejan ir\ndespués de esto...",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_jkd_000001",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“¿Te crees muy fuerte, perra?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_yum_001974",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Su uniforme es de otro colegio...",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Si no me equivoco, ese es el uniforme del peor colegio de la zona.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"El lugar a donde solo van idiotas y malandrines.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Y también el lugar que mi profesor me recomendó elegir para hacer la\npreparatoria.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_001975",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“*Puh*, ¿también hay una del colegio de idiotas? ¿Es que por allá son también\nmiembros del club de fans de Naoya Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",mode=-2},
{"bg",speed=200,sync=0,file="zbg015b",path=":bg/",x2=390,y2=30,x=590,y=30,ax=1920,ay=1126,bx=-960,by=-586},
{"se",id=1,file="se_punch2"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"La muchacha me lanza un potente golpe.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"De inmediato desvié el puñetazo con mi brazo, pero duele.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"¿Qué tanta fuerza carga en esos brazos?",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkd_000002",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“¡Pues disculpa que venga del colegio de idiotas, eh!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_001976",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Bloqueé su ráfaga de puñetazos con una patada.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"msgoff"},
{"se",file="se3130",id=1},
{"bg",speed=150,time=0,file="zbg015b",path=":bg/",x2=590,y2=30,x=-590,y=30,ax=1920,ay=1126,bx=-960,by=-586},
{"bg",rule="106l",time=30,file="black",path=":bg/"},
{"bg",file="battle_007",id=9,lv=9,rule="106l",time=50,path=":cg/battle/",set="battle"},
{"se",id=2,file="se_kick"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkd_000003",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“Guh...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Las piernas son más largas que los brazos...",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Y en consecuencia con ese simple hecho, mi contraataque impactó perfectamente\nsobre ella.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Y sin embargo, aún no se desmaya. Nada de qué sorprenderse considerando que\nviene del colegio de idiotas. ¿Es que es una gorila?",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_jkd_000004",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“¿V-Vas a seguir viéndome la cara de tonta, imbécil?...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_yum_001977",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Para que voy a querer ver esa cara sucia?... Qué asco.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"cgdel",id=-1},
{"bg",time=300,file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
"Analizo una vez más la situación actual.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Casi todas las mujeres están paralizadas del miedo, sin embargo, varias de las\namigas de la mujer gorila están intentando rodearme silenciosamente.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"A la vez que se me acercan retrocedo poco a poco. No puedo perderlas de vista.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Debo ser sincera. En el estado que estoy ahora, si unas cuantas llegan a\necharse sobre mí por detrás me acabarán con toda facilidad.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Lamentablemente no tengo mucha estatura, ni tampoco peso, de lo cual por cierto\nme gusta presumir.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"No soy tan fuerte tampoco.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Lo único que tengo conmigo es la experiencia que acumulé de tantas peleas que\ntuve de niña...",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Y esa experiencia me está susurrando ahora.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"-¡Yuumi-chan, te has metido en reverendo problema!-",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Aunque, tampoco es que me dejé rodear sin nada en mente.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Bien, a ver ahora cómo salgo viva de aquí...",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0002",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000187",ch="knd"},
},
ja={
{
name={"Alumna"},
"“Oigan, oigan~, ¿por qué no dejamos los golpes y resolvemos las cosas de una\nforma menos salvaje?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Una muchacha alzó su mano y gritó eso, apareciendo de entre la multitud.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_yum_001978",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Jaa? ¿Y no fueron ustedes quienes me golpearon primero?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0015",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000188",ch="knd"},
},
ja={
{
name={"Alumna"},
"“¿Nosotras? Fue ella quien te golpeó, ¿no? Yo no tengo nada que ver.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_jkd_000005",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“Cierra la boca. No podré quedarme quieta hasta que deje a esta perra tumbada en\nel suelo.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0002",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000189",ch="knd"},
},
ja={
{
name={"Alumna"},
"“Con gusto, nadie te lo impide. Pero acabo de tomar una fotografía de las dos\npeleando. ¿No crees que las cosas podrían ponerse algo feas si sus colegios\nse enteran de esto?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkd_000006",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“¡¿D-De que lado se supone que estás?!”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0010",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000190",ch="knd"},
},
ja={
{
name={"Alumna"},
"“De ninguno, no soy aliada de nadie. Y ya copié la dirección de correo, lo único\nque me falta es darle al botón de enviar.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_jkd_000007",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“N-No lo hagas, por favor. Si, si llegan a suspenderme de nuevo...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000191",ch="knd"},
},
ja={
{
name={"Alumna"},
"“¿Podemos dejar los golpes entonces~?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Otro uniforme distinto. No sé de qué colegio es.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Pero vaya que me salvó el pellejo parando la pelea.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_yum_001979",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y tú? ¿Vienes de otro colegio de idiotas y malandrines también?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0011",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000192",ch="knd"},
},
ja={
{
name={"Alumna"},
"“N-Nuestro promedio académico no es tan bajo como para que lo llames así. Aunque\nbueno, es un poco más bajo al de Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_yum_001980",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Todo colegio con un nivel más bajo al que alguien como yo pudo ingresar es un\ncolegio de idiotas.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000193",ch="knd"},
},
ja={
{
name={"Alumna"},
"“Sabes ladrar, Yuumi Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_yum_001981",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y bien?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000194",ch="knd"},
},
ja={
{
name={"Alumna"},
"“Mi nombre es Kana Nagayama. Espero que podamos llevarnos bien.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_001982",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No hace falta, esta será la última vez que nos veamos.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000195",ch="knd"},
},
ja={
{
name={"Kana"},
"“Vamos, no digas cosas tan tristes. Y además, te advierto que soy tu senpai.\nDeberías mostrarme algo de respeto.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_yum_001983",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo haría si hubiera la necesidad. ¿La hay?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000196",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Pues quién sabe? Yuumi-chan, ¿realmente no te importa que mande esta\nfotografía al colegio?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_yum_001984",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Haz lo que quieras, vea por donde la veas es claro que están rodeándome para\namenazarme. No tengo nada que temer.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000197",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eso crees? Si cambiamos un poco la perspectiva puedes ver a un grupo de\nmuchachas peleando.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_yum_001985",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Da igual. Lo máximo que me pueden hacer por pelear es suspenderme. No le temo a\neso.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="おじぎ",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000198",ch="knd"},
},
ja={
{
name={"Kana"},
"“Hummm.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_yum_001986",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Pueden decirme ya cuál es su objetivo? ¿Es que acaso quieren separarme de\nNaoya Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000199",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, probablemente ese sea el objetivo de todas. Excepto por mí, claro.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkd_000008",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“¡¿Tú no?!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000200",ch="knd"},
},
ja={
{
name={"Kana"},
"“Simplemente estoy aquí porque me interesa Yuumi Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_yum_001987",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Yo?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0002",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000201",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, tú. Pareces saber cosas de Naoya Kusanagi que yo no sé.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_yum_001988",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Jaa? ¿Qué diablos? ¿Es que acaso eres la admiradora secreta de Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000202",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, tal vez lo soy.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_yum_001989",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues de ser así no puedo contarte nada...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0013",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000203",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Por qué, por qué? Acabo de salvarte, por si no te has dado cuenta.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_yum_001990",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No necesito la ayuda de nadie.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000204",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Sí? Pues, no pareciera, la verdad. Estás en desventaja, diría yo.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_001991",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Para nada!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",size=8,time=600,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0002",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000205",ch="knd"},
},
ja={
{
name={"Kana"},
"“Vamos, no finjas. Quizás llegaste a hacer bastante desastre hace tiempo, pero\nllevas un buen rato sin hacerlo ya. ¿O me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"¿Quién rayos es esta mujer?",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"¿Sabe quién soy?",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000206",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Recuerdas a las senpai que trataste tan mal, Yuumi-chan? Estudian conmigo.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000207",ch="knd"},
},
ja={
{
name={"Kana"},
"“Apenas les pregunté por ti me pidieron que te matara. Vaya, Yuumi-chan\nrealmente da miedo, pensé. Y por eso me traje a todas estas chicas.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Ya me parecía que estaban actuando de una forma demasiado violenta como para\nser unas simples fans... Así que fue esta loca mujer quien las agitó...",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_yum_001992",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué no me matas entonces?...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000208",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, no malinterpretes las cosas. No son mis amigas, ni nada mío, así que no\ntengo deber alguno de cumplir con lo que me pidieron.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_jkd_000009",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“Por supuesto que la mataremos.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0010",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000209",ch="knd"},
},
ja={
{
name={"Kana"},
"“Vamos, solo, solo déjame hablar un poco con ella.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="香奈",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="香奈",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0100",face="a0002",head="kan_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"La mujer llamada Nagayama se acerca.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Y entonces, me susurra al oído.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0016",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000210",ch="knd"},
},
ja={
{
name={"Kana"},
"“Me imagino que estarás pensando en usar ese cuchillo tuyo como última\nalternativa, pero... no creo que el colegio te deje ir con una simple\nsuspensión después de ver una foto tuya con esa cosa.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"*Tch*... Así que ya sabían lo de mi cuchillo...",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Aunque en realidad no es un cuchillo, es un cuchillo de cocina...",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_yum_001993",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No me hace falta usarlo para huir de acá...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0004",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="おじぎ",size=5,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0003",head="kan_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000211",ch="knd"},
},
ja={
{
name={"Kana"},
"“No te hagas la dura. Solo tienes que darme la información que quiero de Naoya\nKusanagi, y haré que se acabe todo.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_yum_001994",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Información de Kusanagi? ¿Qué es lo que quieres saber de él?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0016",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000212",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sabes del mural, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_yum_001995",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿'Las huellas de los cerezos'?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0003",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="うんうん",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0016",head="kan_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000213",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, sí, ese. Dicen los medios que ese mural representa su retorno al mundo del\narte. Eso es mentira, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_yum_001996",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues, ciertamente lo es...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"A la luz pública quedó la imagen de que fue Kusanagi-senpai quien impulsó la\nculminación del mural. ¿Es que esta mujer conoce la verdad?",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0002",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000214",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sabes de los cuadros que Naoya Kusanagi publicó bajo otro nombre, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"¿Los cuadros que pintó con otro nombre?",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0016",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000215",ch="knd"},
},
ja={
{
name={"Kana"},
"“Esos cuadros son falsificaciones hechas por Naoya Kusanagi. Solo que parece que\nnadie lo ha descubierto aún.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"¿De qué me está hablando?",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"¿Falsificaciones?",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0015",head="kan_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0006",head="kan_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000216",ch="knd"},
},
ja={
{
name={"Kana"},
"“Dicen que fue él quien dirigió la obra, pero seguramente es mentira. Los trazos\nde esas ramas, no son los de Kusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0017",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000217",ch="knd"},
},
ja={
{
name={"Kana"},
"“Me puse a investigar, y parece que hay un hombre llamado Akashi involucrado con\nese mural.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0003",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000218",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y de la información que reuní, parece que también estuvo involucrado con las\nfalsificaciones.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0016",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000219",ch="knd"},
},
ja={
{
name={"Kana"},
"“Akashi es tu senpai en el club de arte al cual perteneces, ¿verdad? Supongo que\nentonces conoces también el secreto de esas falsificaciones.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_yum_001997",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, no... ehm, realmente no sé de qué me estás hablando.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0004",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000220",ch="knd"},
},
ja={
{
name={"Kana"},
"“Vamos, no te hagas la tonta. Además, eres la novia de Kusanagi-kun, debes estar\nenterada de eso, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_yum_001998",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ahh, ¿eso? Era mentira.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0006",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000221",ch="knd"},
},
ja={
{
name={"Kana"},
"“... ¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_yum_001999",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Todas ustedes me tenían harta ese día. Por eso dije que era su novia.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0013",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000222",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? ¿Eh? Estás bromeando, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_yum_002000",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues la muchacha de hace un rato lo dijo, ¿no? Que el mismo Kusanagi- senpai\nlo había negado... Fue por eso que se enojó.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0010",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000223",ch="knd"},
},
ja={
{
name={"Kana"},
"“Es, es que, Kusanagi-kun es tímido, y pensé que no sería nada raro... que lo\nnegara de igual manera.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_yum_002001",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, conociéndolo como es no sería raro que lo hiciera, así yo fuera realmente\nsu novia, pero... mentira es mentira...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0005",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000224",ch="knd"},
},
ja={
{
name={"Kana"},
"“Tú... ¿No eres la novia de Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_yum_002002",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así es. Y para agregar a eso, es la persona con quien peor me llevo en el club\nde arte. Lo odio, y probablemente no soy muy de su agrado además.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0009",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="おじぎ",time=800,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0017",head="kan_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000225",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, ahh, ahhhh, vaya, entiendo.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0015",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000226",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ajajaja, pero qué perdida de tiempo ha sido todo esto.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0016",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000227",ch="knd"},
},
ja={
{
name={"Kana"},
"“En pocas palabras, no tienes nada que me interese, supongo...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_yum_002003",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No lo sé. Pero no vas a conseguir de mí la información que quieres.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="fem_knd_000228",ch="knd"},
},
ja={
{
name={"Kana"},
"“Jujuju...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"La mujer que se hizo llamar Nagayama echó su cara hacia abajo mientras se reía,\ny entonces la volvió a alzar.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000229",ch="knd"},
},
ja={
{
name={"Kana"},
"“Muuuy bien, muchachas. Me iré ya. Sírvanse y hagan con esta pequeña lo que\nquieran.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_jkb_000036",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“¿Eh? ¿P-Pero qué estás diciendo?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_jkc_000014",ch="jkc"},
},
ja={
{
name={"Alumna C"},
"“L-Llevo sin entender lo que está pasando desde hace rato...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_jkd_000010",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“¡S-Supongo que, que no mandarás la foto entonces! ¡¿Verdad?!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000230",ch="knd"},
},
ja={
{
name={"Kana"},
"“Claro. Ya ella no me sirve de nada.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkd_000011",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“¡Entonces--!”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000231",ch="knd"},
},
ja={
{
name={"Kana"},
"“Aunque, les recomiendo que tengan cuidado. Tiene un cuchillo guardado.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000232",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y de esos grandes que parecen cuchillos de cocina. ¿O quizás debería decir que\nes un cuchillo de cocina?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"¿No solo sabe que tengo a Bob Kramer contigo, sino también que es un cuchillo\nde cocina? Pero qué tan despiadadamente acosadora es esta mujer.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000233",ch="knd"},
},
ja={
{
name={"Kana"},
"“Así que si llega a sacarlo, tómenle una foto. Probablemente la expulsen después\nde eso.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",mode=-2},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkd_000012",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“¡Excelente!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"La mujer gorila hace una pose de victoria con los brazos.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_jkd_000013",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“Ahora sí podré golpearte tanto como me dé la gana.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Vaya rostro de felicidad que tiene...",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"Sus compañeras se acercan por mi espalda, intentando rodearme.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_yum_002004",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"No me queda más opción...",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Tendré que recurrir a mi última alternativa.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Meto mi mano en la mochila.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_jka_000042",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¿V-Va a sacar el cuchillo?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_yum_002005",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Hagamos las paces!”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_jkd_000014",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“¡De ninguna forma, idiota!”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Saco mi teléfono celular. La tensión entre la muchedumbre se calmó un poco al\nver que lo que saqué fue eso.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_yum_002006",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Muchachas! ¡Quizás no lo sepan, pero en este celular tengo unas fotos tomadas\nen secreto de Kusanagi-senpai!”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jka_000043",ch="jka"},
{"vo",file="fem_jkb_000037",ch="jkb"},
{"vo",file="fem_jkc_000015",ch="jkc"},
{"vo",file="fem_jkd_000015",ch="jkd"},
},
ja={
{
name={"Alumnas"},
"“¡¿T-Tomadas en secreto?!”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_yum_002007",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Y además, completamente desnudo!”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jka_000044",ch="jka"},
{"vo",file="fem_jkb_000038",ch="jkb"},
{"vo",file="fem_jkc_000016",ch="jkc"},
{"vo",file="fem_jkd_000016",ch="jkd"},
},
ja={
{
name={"Alumnas"},
"“¡¿C-Completamente desnudo?!”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_yum_002008",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡He aquí!”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Todas las miradas se concentraron en mi mano derecha.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"En ese preciso instante, alcé mi mano izquierda metida en la mochila.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_yum_002009",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Una linterna de 11000 lumen!”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"se",id=1,file="se_bash"},
{"bg",rule=105,time=100,file="white",path=":bg/"},
{"bg",rule=105,time=100,file="black",path=":bg/"},
{"bg",rule=105,time=100,file="white",path=":bg/"},
{"text"},
text={
ja={
{
"En mi mano ya no estaba el celular.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Sino una linterna LED usada por el ejercito americano.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Una monstruosa linterna de 15000 yenes.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jka_000045",ch="jka"},
{"vo",file="fem_jkb_000039",ch="jkb"},
{"vo",file="fem_jkc_000017",ch="jkc"},
{"vo",file="fem_jkd_000017",ch="jkd"},
},
ja={
{
name={"Alumnas"},
"“Kyaah.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"El resplandor cubrió todo el lugar.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"se",file="se0744",id=1},
{"msgoff"},
{"bg",speed=200,file="zbg015b",path=":bg/",x2=-960,y2=586,x=960,y=-586,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=200},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002010",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Comencé a correr a través de la multitud.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkd_000018",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“¡H-Huyó!”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="fem_jkb_000040",ch="jkb"},
},
ja={
{
name={"Alumna B"},
"“¿Eh? ¿A-A dónde?”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="fem_jka_000046",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Eso no importa, agh, ah, mis ojooos.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkc_000018",ch="jkc"},
},
ja={
{
name={"Alumna C"},
"“Hii, mis, mis ojooos.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Parece que el impacto varía de persona en persona.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Algunas parecen haber recuperado la vista rápidamente.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Tengo que ir con rapidez.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="fem_jkd_000019",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“¡Se fue por ahí!”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Al salir por la parte trasera del callejón me topo con dos muchachas más,\nhaciendo guardia.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_002011",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“*Tch*...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="fem_jke_000001",ch="jke"},
},
ja={
{
name={"Alumna E"},
"“¿Eh? ¿Ehh?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"No parece ser de las que sabe pelear, así que decido correr con todas mis\nfuerzas.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkd_000020",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“¡No la dejes ir!”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Escucho la voz de la mujer gorila.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jke_000002",ch="jke"},
},
ja={
{
name={"Alumna E"},
"“¡N-No vas a escapar!”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"quake",mode="mw"},
{"se",id=1,file="se_kacha"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002012",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"Apenas la muchacha que pensaba que no era hostil extendió su brazo, su mano se\nenganchó a mi mochila.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="fem_yum_002013",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“*Tch*”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"Entre tanto sacar y meter cosas de la mochila no me la coloqué bien, y se me\ncayó fácilmente.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"msgoff"},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=200},
{"se",file="se0744",id=1},
{"text"},
text={
ja={
{
"Varias de las mujeres me persiguen saliendo del callejón.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Son muy insistentes.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002014",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No me sigan!”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_jkd_000021",ch="jkd"},
},
ja={
{
name={"Alumna D"},
"“¡No huyas entonces!”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"Me voy corriendo, sin poder tomar de vuelta mi mochila.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="fem_yum_002015",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Aghhh! ¡Demonios, cómo joden, cómo joden!”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Por ahora, corro.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"Tenía varias cosas importantes en mi mochila, pero lo mejor por ahora es huir.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"se",stop=1,time=500,id=1},
{"bgm",stop=1,time=500},
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"text"},
text={
ja={
{
"No recuerdo nada de lo que paso después, ni como llegué acá.",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
"Pensé que de devolverme a casa podrían enterarse dónde vivo.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Al darme cuenta, estaba ahora metida en el conducto de ventilación del colegio,\nesperando a que pasaran las horas.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"msgoff"},
{"bg",file="zeveningsky_spring01",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=960,y2=-540,x=-960,y=-540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm023"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002016",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me están buscando ahora por toda la zona... ¿Qué haré a partir de mañana?”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"Como pueden ver, estaba algo preocupada. Aunque, Yumihari es un colegio de\nniños de buena familia.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"A juzgar por lo que ha pasado hoy, dudo mucho que alguien de este colegio\nintente hacerme algo.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
vo={
{"vo",file="fem_yum_002017",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El problema está con las gorilas del colegio de idiotas...”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"Me robaron la mochila, y se nota también que son insistentes. Así que quizás no\ndesistan fácilmente de perseguirme...",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"Y cabe destacar que esa clase de gorilas suele tener contacto con los\nmalandrines de su colegio.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"Qué lata.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
"Si tan solo tuviera a mis viejos compañeros conmigo...",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"Pensando eso, me puse a ver la pantalla del celular que, casualmente, había\nmetido en mi bolsillo y pude salvar.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
"Aún tengo contacto con ellos. Y probablemente no duden en moverse de saber que\nestoy en problemas.",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="fem_yum_002018",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"Me da algo de reparo pedirles ayuda...",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Sobre todo a Okazawa.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
"Seguramente sería él quien más que nadie vendría primero a pelear conmigo. Pero\neso me sería más carga que alivio.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"Parece que Okazawa ingresó a un colegio mucho mejor al mío.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"Me han contado que es de los mejores de la prefectura.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
"No sé mucho de números de promedio académico ni de nombres de buenos colegios\nalrededor, pero en fin, parece que Okazawa está ahora en los altos estratos.",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
"Es definitivamente triste llevar a una persona tan bien encaminada a ayudarme\ncon algo tan estúpido como esto.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
vo={
{"vo",file="fem_yum_002019",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah~, ah.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
vo={
{"vo",file="fem_yum_002020",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Qué fastidiosas son las personas.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
vo={
{"vo",file="fem_yum_002021",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fuh, de niños todo era más fácil y simple.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"Ser fuerte lo era todo.",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
"¿Pero ahora? Te juzgan por todo. Promedio académico, habilidad en los deportes,\npopularidad con el sexo opuesto, qué tan atractiva es tu personalidad...",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
"Son tantos los criterios ahora que ya ni sé dónde estoy parada.",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
vo={
{"vo",file="fem_yum_002022",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ahhh, realmente que lo son.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"Y probablemente de adultos serán más los criterios. Y todo será aún más\ntedioso.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
"No conozco los criterios de juicio de los adultos. Pero si algo es seguro, es\nque ellos son los más tediosos de lidiar...",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
"Ahora que lo pienso, mamá no paraba de repetirme una y otra vez lo de 'Debes\ncuidar tu imagen...'. Aunque ya no me lo ha dicho más últimamente.",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"Al parecer hizo buen efecto haberme hecho amiga de Rina.",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
"Y más aún, haber entrado a Yumihari para poder estudiar en el mismo colegio que\nella.",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
"Desde hace un tiempo no me ha sermoneado más.",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
"Aunque bueno, tengo una hermanita menor que salió mucho mejor a mí, así que\nquizás es que todas las expectativas de mamá están sobre ella ahora.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"... ¿Eh? ¿En qué estaba pensando en un principio?",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
"... Entre tanto pensar, ya perdí el orden de las ideas...",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
"Ehm... qué era...",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"bgm",stop=1,time=2000},
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
"Me voy quedando dormida.",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"cgdel",id=-1},
{"bg",time=1500,file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bg082c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm025"},
{"text"},
text={
ja={
{
"Veo un ritual.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"El ritual de Hakuki y Housou.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"fg",ch="伯奇",size="z1",mode=3,resize=1,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_hss_000005",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Procederemos a realizar la ceremonia del 'Da'.”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
"La voz de Housoushi resuena en el lugar.",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
"Con su serenidad de siempre, este exude majestuosidad.",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
"El actual jefe del clan Nakamura, Tokitsuna, yace acostado frente a los sudare.",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
vo={
{"vo",file="man_hss_000006",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Nakaki yo no...”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
"Los cantos de Housoushi dan comienzo.",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
"Hakuki se concentra, observando silenciosamente a Tokitsuna, acostado tras los\nsudare.",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"bg",file="ev_uni_c29_01",sync=1,path=":ev/ev_uni_c29/",set="ev_uni_c29"},
{"bg",file="ev_uni_c29_03",sync=1,path=":ev/ev_uni_c29/",set="ev_uni_c29"},
{"text"},
text={
ja={
{
"Del recipiente comienza a aparecer poco a poco agua.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"bg",file="ev_uni_c29_04",path=":ev/ev_uni_c29/",set="ev_uni_c29"},
{"text"},
text={
ja={
{
"Hakuki observa absorta el líquido - el interior de esa alma - mientras este se\nderrama del recipiente.",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"msgoff"},
{"bg",file="bg082c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　　――　　El Alma　　――",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
ja={
{
"Al tomar el recipiente en sus manos, la superficie del líquido se agitó.",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　――　　El Alma de esa persona　　――",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
ja={
{
"Hakuki se llevó lentamente el recipiente a la boca, y,",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0004",head="hak_z1a",lv=4,id=9},
{"fgact",ch="伯奇",act="おじぎ",time=800,size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000064",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Ngh... *traga*...”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　　　――　　Qué diablos será esto　　――",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
"Se bebió su contenido en una sola sentada.",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"msgoff"},
{"colortone",inter=3,ssize=2,ease="in",sfade=100000,style="raster"},
{"bg",blur=10,file="bg064c",path=":bg/",sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1500},
{"text"},
text={
ja={
{
"Me parece ver algo.",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
"Pero, ese algo está cubierto de neblina.",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
"La neblina negra lo oculta, y cada vez puedo ver menos.",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
ja={
{
"Esta neblina es... rencor.",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
"Ya muchas veces he bebido est――",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"msgoff"},
{"colortone",style="raster",ease="out"},
{"bg",file="bg082c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0005",head="hak_z1a",lv=4,id=9,sync=0},
{"bg",id=9,lv=9,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"fgact",ch="伯奇",act="いいえ",time=400,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000065",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Ngh... *guf*... *cof*... *cof*... ng.”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
"Escupí toda el agua afuera.",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"fgact",ch="伯奇",act="うんうん",time=350,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000066",ch="had"},
},
ja={
{
name={"Hakuki"},
"“*cof*... *gah*... *cof*...”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
vo={
{"vo",file="man_yod_000105",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¡¿Se encuentra usted bien?!”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
vo={
{"vo",file="man_uzn_000023",ch="uzn"},
},
ja={
{
name={"Ietsuna"},
"“¡¿Qué ha ocurrido?!”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
ja={
{
"Algo le acaba de suceder. Me apresuro a acercarme a Hakuki-dono.",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"msgoff"},
{"se",file="se9023",vol=50,id=1},
{"fg",ch="伯奇",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="伯奇",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/hak/z2/",file="hak_z2a0000",face="a0005",head="hak_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="man_yod_000106",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Hakuki-dono.”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0004",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000067",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Yoshisada-sama...”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
ja={
{
"Los samurái que hacían guardia en el pasillo entran también.",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"text"},
text={
vo={
{"vo",file="man_hss_000007",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“No hay nada de qué preocuparse. Las pesadillas de esta noche han sido un poco\nmás fuertes de lo normal, es todo. La ceremonia del Da ha concluido sin mayor\ninconveniente.”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
"Housoushi anuncia eso con su tono de voz usual.",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"text"},
text={
vo={
{"vo",file="man_yod_000107",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Es eso cierto?...”",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
vo={
{"vo",file="man_hss_000008",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Así es. Sin ninguna traba, mi señor.”",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
vo={
{"vo",file="man_yod_000108",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“No está usted mintiéndome, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
vo={
{"vo",file="man_hss_000009",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Lo juro por los dioses que no.”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
vo={
{"vo",file="man_yod_000109",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“... Confiaré en sus palabras por hoy.”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
vo={
{"vo",file="man_yod_000110",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Espero desde lo más profundo de mi corazón la pronta recuperación de la\nsacerdotisa.”",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
vo={
{"vo",file="man_hss_000010",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Agradezco sus cálidas y benevolentes palabras, mi señor.”",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"¿Qué es lo que habrá pasado? Algo no está bien hoy...",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
ja={
{
"Me pareció haber visto los sueños que Hakuki-dono se tragó... o al menos me dio\nla ilusión de estar haciéndolo...",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
ja={
{
"Algo no está bien. Me da la sensación de que algo no lo está.",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
ja={
{
".........",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
ja={
{
"No creí en las palabras de Housou.",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
ja={
{
"Después de que dejé de escuchar los pasos de los otros, me di la vuelta y me\nacerqué a la habitación de Housou y Hakuki-dono.",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"msgoff"},
{"bg",x=-820,y=30,file="zbg082a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0005",head="hak_z2a",lv=5,id=9,sync=0},
{"bg",id=9,lv=9,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_hss_000011",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
ja={
{
"Ahora con todos los Nakamura fuera de la habitación, Housoushi estaba parado,\nviendo fijamente a Hakuki-dono.",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
ja={
{
"En sus ojos había algo completamente opuesto a la serenidad con la que inició\nla ceremonia hace un rato.",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
ja={
{
"Era una mirada amenazadora, llena de inocultable ira.",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
vo={
{"vo",file="man_hss_000012",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Hakuki, condenada muchacha...”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
vo={
{"vo",file="man_hss_000013",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Abriste tu corazón.”",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0004",head="hak_z2a",lv=5,id=9},
{"fgact",ch="伯奇",act="おじぎ",time=700,size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000068",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Corazón...”",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
ja={
{
"Solo eso susurra ella.",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
ja={
{
"Corazón, sentimientos. Flotando como nubes, revoloteando como pétalos.",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
ja={
{
"¿Quiere decir que todo eso ha despertado dentro de ella...?",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0008",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000069",ch="had"},
},
ja={
{
name={"Hakuki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"text"},
text={
vo={
{"vo",file="man_hss_000014",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“¿De qué te estás riendo?”",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"fg",ch="伯奇",size="z2",mode=3,path=":fg/hak/z2/",file="hak_z2a0000",face="a0002",head="hak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000070",ch="had"},
},
ja={
{
name={"Hakuki"},
"“¿Estoy... sonriendo?”",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_hss_000015",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_hss_000016",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“¡Agh! ¡No me sirves de nada en ese estado!”",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"se",file="se1512",id=1},
{"se",file="se_bafu",id=2},
{"fg",mode=-2},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"Housou abofetea a Hakuki-dono. Teniendo un cuerpo pequeño, esta cayó al suelo\nfácilmente.",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000111",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“*Ngh*”",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"text"},
text={
ja={
{
"Resisto el impulso de saltar a salvarla.",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"text"},
text={
vo={
{"vo",file="man_yod_000112",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Todavía no...”",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"text"},
text={
ja={
{
"Debo de descubrir antes la verdad...",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"text"},
text={
vo={
{"vo",file="man_hss_000017",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Te mantendré encerrada. Si no recuperas el poder tragasueños, te aseguro que te\narrepentirás de haber hecho despertar ese corazón.”",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"se",file="se9002",id=1},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Housoushi se fue diciendo eso, sin preocuparse por observar la reacción de\nHakuki-dono.",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Hakuki-dono abrió su corazón...",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"text"},
text={
ja={
{
"¿De qué manera?",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"msgoff"},
{"bgm",stop=1,time=1000},
{"ex",time=2000,func="wait"},
{"bg",file="nightsky_summer",id=9,lv=9,sync=1,path=":cg/"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002023",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Uaah?!”",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"text"},
text={
ja={
{
"Al despertarme era ya de noche.",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"text"},
text={
ja={
{
"Otra vez ese sueño...",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"text"},
text={
ja={
{
"Pero... fue algo diferente a los anteriores...",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"text"},
text={
vo={
{"vo",file="fem_yum_002024",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Por un momento me pareció haber visto un poco el interior del corazón de\nHakuki...”",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"text"},
text={
vo={
{"vo",file="fem_yum_002025",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero eso no importa. La cuestión es que ese sueño es, sin duda alguna, la\npropia historia de la leyenda de los cerezos milenarios...”",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"text"},
text={
ja={
{
"¿Con qué razón estaré soñando con ese cuento?",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"text"},
text={
vo={
{"vo",file="fem_yum_002026",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sea cual sea la razón, es algo bueno...”",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"text"},
text={
ja={
{
"No sé qué hay realmente tras esto, pero el solo hecho de poder compartir algo\ncon Rina me alegra.",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"text"},
text={
vo={
{"vo",file="fem_yum_002027",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Um, ah...”",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"se",file="se9010",id=6},
{"text"},
text={
ja={
{
"Por los momentos, salgo gateando del conducto de ventilación.",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002028",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"text"},
text={
ja={
{
"Hay alguien.",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"text"},
text={
ja={
{
"¿Me rastrearon? ¿Por qué no me atacaron mientras estaba dormida entonces?",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"text"},
text={
ja={
{
"¿Quién está ahí?",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"text"},
text={
ja={
{
"No podré huir esta vez si me vienen en grupo.",
{"rt2"},
},
},
},
linkback="block_00378",
linknext="block_00380",
},
block_00380={
{"text"},
text={
ja={
{
"Al acercarme, la silueta de la persona me habló.",
{"rt2"},
},
},
},
linkback="block_00379",
linknext="block_00381",
},
block_00381={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="znightsky_summer",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm029"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001717",ch="rna"},
},
ja={
{
name={"???"},
"“¿Dormiste bien?”",
{"rt2"},
},
},
},
linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"text"},
text={
vo={
{"vo",file="fem_yum_002029",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Esa voz es...”",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
{"text"},
text={
ja={
{
"Es Rina.",
{"rt2"},
},
},
},
linkback="block_00382",
linknext="block_00384",
},
block_00384={
{"text"},
text={
vo={
{"vo",file="fem_yum_002030",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué estás aquí?”",
{"rt2"},
},
},
},
linkback="block_00383",
linknext="block_00385",
},
block_00385={
{"text"},
text={
vo={
{"vo",file="fem_rna_001718",ch="rna"},
},
ja={
{
name={"Rina"},
"“Porque te estaba buscando.”",
{"rt2"},
},
},
},
linkback="block_00384",
linknext="block_00386",
},
block_00386={
{"text"},
text={
vo={
{"vo",file="fem_yum_002031",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero ¿cómo supiste que estaba acá?”",
{"rt2"},
},
},
},
linkback="block_00385",
linknext="block_00387",
},
block_00387={
{"text"},
text={
vo={
{"vo",file="fem_rna_001719",ch="rna"},
},
ja={
{
name={"Rina"},
"“Porque te busqué por todos lados.”",
{"rt2"},
},
},
},
linkback="block_00386",
linknext="block_00388",
},
block_00388={
{"text"},
text={
ja={
{
"Al ver con cuidado, me di cuenta de que el uniforme de Rina estaba\nterriblemente sucio.",
{"rt2"},
},
},
},
linkback="block_00387",
linknext="block_00389",
},
block_00389={
{"text"},
text={
ja={
{
"Probablemente me estuvo buscando por todos los lugares posibles.",
{"rt2"},
},
},
},
linkback="block_00388",
linknext="block_00390",
},
block_00390={
{"text"},
text={
vo={
{"vo",file="fem_rna_001720",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fuh... Realmente no paras de meterte en problemas...”",
{"rt2"},
},
},
},
linkback="block_00389",
linknext="block_00391",
},
block_00391={
{"text"},
text={
vo={
{"vo",file="fem_yum_002032",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00390",
linknext="block_00392",
},
block_00392={
{"text"},
text={
vo={
{"vo",file="fem_rna_001721",ch="rna"},
},
ja={
{
name={"Rina"},
"“Escuché unos gritos después de que te fuiste...”",
{"rt2"},
},
},
},
linkback="block_00391",
linknext="block_00393",
},
block_00393={
{"text"},
text={
vo={
{"vo",file="fem_yum_002033",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Gritos?”",
{"rt2"},
},
},
},
linkback="block_00392",
linknext="block_00394",
},
block_00394={
{"text"},
text={
vo={
{"vo",file="fem_rna_001722",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Luego de eso te vi corriendo, con varias muchachas de otros colegios\npersiguiéndote. Los seguí a todos.”",
{"rt2"},
},
},
},
linkback="block_00393",
linknext="block_00395",
},
block_00395={
{"text"},
text={
vo={
{"vo",file="fem_yum_002034",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, ya veo... Ahora que lo recuerdo me puse a gritar mientras estaba huyendo...\nFue por eso que viniste a buscarme.”",
{"rt2"},
},
},
},
linkback="block_00394",
linknext="block_00396",
},
block_00396={
{"text"},
text={
vo={
{"vo",file="fem_rna_001723",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Ah, ya veo? ¿Eso es todo? Me alarmé terriblemente cuando te vi corriendo.”",
{"rt2"},
},
},
},
linkback="block_00395",
linknext="block_00397",
},
block_00397={
{"text"},
text={
vo={
{"vo",file="fem_yum_002035",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Estuviste esperándome hasta tan tarde... aun sabiendo que estaba dormida...”",
{"rt2"},
},
},
},
linkback="block_00396",
linknext="block_00398",
},
block_00398={
{"text"},
text={
vo={
{"vo",file="fem_rna_001724",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto, ¿por qué se supone que no lo haría?”",
{"rt2"},
},
},
},
linkback="block_00397",
linknext="block_00399",
},
block_00399={
{"text"},
text={
vo={
{"vo",file="fem_yum_002036",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No lo sabía. Me hace feliz que me digas eso...”",
{"rt2"},
},
},
},
linkback="block_00398",
linknext="block_00400",
},
block_00400={
{"text"},
text={
vo={
{"vo",file="fem_rna_001725",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues qué bueno. Dios santo, ¿es que no puedes dejar de meterte en tantos líos?\nMe dejaste muy preocupada.”",
{"rt2"},
},
},
},
linkback="block_00399",
linknext="block_00401",
},
block_00401={
{"text"},
text={
vo={
{"vo",file="fem_yum_002037",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Yo soy fuerte, me puedo cuidar yo solita. No tienes nada de qué preocuparte.”",
{"rt2"},
},
},
},
linkback="block_00400",
linknext="block_00402",
},
block_00402={
{"text"},
text={
vo={
{"vo",file="fem_rna_001726",ch="rna"},
},
ja={
{
name={"Rina"},
"“Alguien fuerte y que se pueda valer por su cuenta no estaría huyendo a esta\nclase de lugar.”",
{"rt2"},
},
},
},
linkback="block_00401",
linknext="block_00403",
},
block_00403={
{"text"},
text={
ja={
{
"Rina acaricia mi cabeza con una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00402",
linknext="block_00404",
},
block_00404={
{"text"},
text={
vo={
{"vo",file="fem_rna_001727",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sé que eres bastante fuerte, Yuumi...”",
{"rt2"},
},
},
},
linkback="block_00403",
linknext="block_00405",
},
block_00405={
{"text"},
text={
vo={
{"vo",file="fem_rna_001728",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero al señor lobo lo amansaron ya...”",
{"rt2"},
},
},
},
linkback="block_00404",
linknext="block_00406",
},
block_00406={
{"text"},
text={
vo={
{"vo",file="fem_yum_002038",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Lobo?”",
{"rt2"},
},
},
},
linkback="block_00405",
linknext="block_00407",
},
block_00407={
{"text"},
text={
vo={
{"vo",file="fem_rna_001729",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. Vamos, regresemos juntas.”",
{"rt2"},
},
},
},
linkback="block_00406",
linknext="block_00408",
},
block_00408={
{"text"},
text={
ja={
{
"Rina me sonríe con ternura.",
{"rt2"},
},
},
},
linkback="block_00407",
linknext="block_00409",
},
block_00409={
{"text"},
text={
vo={
{"vo",file="fem_yum_002039",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00408",
linknext="block_00410",
},
block_00410={
{"text"},
text={
ja={
{
"Al ver esa sonrisa confirmé de nuevo lo obvio. Me muero por Rina.",
{"rt2"},
},
},
},
linkback="block_00409",
linknext="block_00411",
},
block_00411={
{"text"},
text={
vo={
{"vo",file="fem_rna_001730",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mmm? ¿Y tu mochila?”",
{"rt2"},
},
},
},
linkback="block_00410",
linknext="block_00412",
},
block_00412={
{"text"},
text={
vo={
{"vo",file="fem_yum_002040",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, sí, se me hacía estorbosa mientras huía así que la dejé por ahí.”",
{"rt2"},
},
},
},
linkback="block_00411",
linknext="block_00413",
},
block_00413={
{"text"},
text={
vo={
{"vo",file="fem_rna_001731",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Que la dejaste por ahí?...”",
{"rt2"},
},
},
},
linkback="block_00412",
linknext="block_00414",
},
block_00414={
{"text"},
text={
vo={
{"vo",file="fem_yum_002041",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No te miento.”",
{"rt2"},
},
},
},
linkback="block_00413",
linknext="block_00415",
},
block_00415={
{"text"},
text={
vo={
{"vo",file="fem_rna_001732",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hay que ir por ella entonces...”",
{"rt2"},
},
},
},
linkback="block_00414",
linknext="block_00416",
},
block_00416={
{"text"},
text={
vo={
{"vo",file="fem_yum_002042",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tranquila, la dejé en un lugar seguro.”",
{"rt2"},
},
},
},
linkback="block_00415",
linknext="block_00417",
},
block_00417={
{"text"},
text={
vo={
{"vo",file="fem_rna_001733",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿En un lugar seguro?”",
{"rt2"},
},
},
},
linkback="block_00416",
linknext="block_00418",
},
block_00418={
{"text"},
text={
vo={
{"vo",file="fem_yum_002043",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00417",
linknext="block_00419",
},
block_00419={
{"text"},
text={
vo={
{"vo",file="fem_rna_001734",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00418",
linknext="block_00420",
},
block_00420={
{"se",file="se9010",id=1},
{"mwact",act="おじぎ",size=5},
{"text"},
text={
ja={
{
"No sé por qué, pero después de eso Rina me abrazó fuertemente.",
{"rt2"},
},
},
},
linkback="block_00419",
linknext="block_00421",
},
block_00421={
{"text"},
text={
vo={
{"vo",file="fem_yum_002044",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00420",
linknext="block_00422",
},
block_00422={
{"text"},
text={
vo={
{"vo",file="fem_rna_001735",ch="rna"},
},
ja={
{
name={"Rina"},
"“Realmente eres una muchacha muy buena...”",
{"rt2"},
},
},
},
linkback="block_00421",
linknext="block_00423",
},
block_00423={
{"text"},
text={
vo={
{"vo",file="fem_yum_002045",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿E-Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00422",
linknext="block_00424",
},
block_00424={
{"text"},
text={
vo={
{"vo",file="fem_rna_001736",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí... Tanto, que incluso ganas de llorar me das...”",
{"rt2"},
},
},
},
linkback="block_00423",
linknext="block_00425",
},
block_00425={
{"text"},
text={
vo={
{"vo",file="fem_yum_002046",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿P-Por qué?”",
{"rt2"},
},
},
},
linkback="block_00424",
linknext="block_00426",
},
block_00426={
{"text"},
text={
ja={
{
"Rina siguió apretándome fuertemente después de decir eso.",
{"rt2"},
},
},
},
linkback="block_00425",
linknext="block_00427",
},
block_00427={
{"text"},
text={
ja={
{
"Tan, tan fuerte, que no pude ver la cara que tenía en ese momento.",
{"rt2"},
},
},
},
linkback="block_00426",
linknext="block_00428",
},
block_00428={
{"cgdel",id=-1},
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
