astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c06_01",path=":ev/ev_eye_c06/",set="ev_eye_c06"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_eye_c09_01",path=":ev/ev_eye_c09/",set="ev_eye_c09"},
{"ex",time=3000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"bgm",file="bgm106"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003399",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Parece que no estuviste prestándome atención.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0110",face="a0017",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“L-Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0015",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003400",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto fue lo que dije...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003401",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No hace falta que estés pendiente de mí en todo momento.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003402",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No tienes que estar siempre conmigo mientras pinto. Eso intento decir.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003403",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si hay algo que quieras hacer, usa tu tiempo en eso.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No es que quiera...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0015",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うんうん",time=300,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003404",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, sí, entiendo. En fin, tómate algo de tiempo para ti mismo.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bastante tiempo libre tengo cuando estoy en casa, y además...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003405",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya puedo, valerme sola...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Rin?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003406",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me refiero a la pintura. Con todo lo que me has enseñado ya puedo valerme sola.\nEso quise decir.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ah, entiendo...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003407",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya puedo valerme solita, Nao-kun. Así que usa tu tiempo y haz lo que quieras\nhacer.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003408",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ir a la azotea, por ejemplo.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0016",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003409",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Has estado viendo mucho la azotea últimamente.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Estaba... viendo el cielo...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003410",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El cielo.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0016",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003411",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El cielo, eh. ¿No sería mejor entonces que lo vieras desde la azotea?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003412",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mejor vista tendrás que estando acá, sin duda alguna...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, pero...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003413",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y bueno, también quisiera comenzar a concentrarme sola en mi obra.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003414",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A final de cuentas, pintar es un duelo de uno a uno, obra y pintor. ¿No es así?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003415",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Podrías dejarme entonces pintar un poco por mi cuenta?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, me iré por un rato...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003416",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vale.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Me dirigí a la puerta del salón de arte.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Pero entonces――",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003417",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun. Realmente me alegro de haber vuelto.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003418",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Cómo no estarlo? Logré hablarte de nuevo, y no solo eso, sino que también\nestás ahora enseñándome a pintar.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003419",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De no haber regresado, quizás nunca hubiera tenido esta oportunidad...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003420",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por eso me esforzaré. Pondré todo mi esfuerzo en este cuadro.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0003",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003421",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El cuadro con el cual me enseñaste a pintar.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003422",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No es eso lo que quiero...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003423",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo algo de apoyo.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003424",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Dame algo de apoyo.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003425",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Acabo de decirte que me esforzaré. Así que por lo menos dame algo de aliento.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Algo de aliento?...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003426",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tú puedes...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003427",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo necesito que me digas eso... 'Tú puedes'.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón en eso...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú puedes, Rin.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003428",ch="rnd"},
},
ja={
{
name={"Rin"},
"*Asiente con la cabeza*.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y... Rin.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003429",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias... por volver a la ciudad.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003430",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No es nada...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003431",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Gracias a ti, por recibirme.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003432",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Bueno, bueno, si sigues perdiendo el tiempo acá, se pondrá el sol. Debes irte\nya.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Está bien...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Me salgo del salón de arte, urgido por la extraña insistencia de Rin.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2},
{"bg",file="bluesky_winter",id=9,lv=9,rule="083r",sync=1,vague=40,path=":cg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sola hoy?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Al subir a la azotea me encuentro con Hikawa, pintando sola.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001929",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? Ahora que lo mencionas, Yuumi salió hace un buen rato diciendo que iba a\nrecoger algo en el salón, y no ha vuelto...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0013",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001930",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Mm! ¿L-Le habrá sucedido algo?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estaba dormida.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001931",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Dormida?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, le eché un ojo a tu salón y la vi durmiendo en su puesto. ¿No ha estado\nalgo fatigada en estos días?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001932",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad? Quizás debería ir a ver cómo está...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hace falta? Parecía simplemente estar cansada...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001933",ch="rna"},
},
ja={
{
name={"Rina"},
"“Senpai, ¿viste la cara de Yuumi mientras dormía?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, la vi.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0017",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001934",ch="rna"},
},
ja={
{
name={"Rina"},
"“Muy mal que veas a hurtadillas la cara de una chica mientras duerme.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé, pero me tenía algo preocupado...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001935",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hum, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Hikawa mueve su pincel, luciendo algo enfadada.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Has avanzado con tu cuadro?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="うんうん",time=200,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_001936",ch="rna"},
},
ja={
{
name={"Rina"},
"“Poco a poco. ¿Qué hay de ti, senpai?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Rin? Igual que tú.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Hikawa deja de mover su pincel y me observa.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001937",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me refería a ti, senpai.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estoy pintando nada, ni lo haré.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001938",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Ah, bueno.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Al decir eso, Hikawa vuelve a mover su pincel.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esperaba que preguntaras el porqué.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001939",ch="rna"},
},
ja={
{
name={"Rina"},
"“No lo haré.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0015",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001940",ch="rna"},
},
ja={
{
name={"Rina"},
"“Te lo deben preguntar a cada rato, seguramente.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001941",ch="rna"},
},
ja={
{
name={"Rina"},
"“Las pinturas son honestas. Hablan por sí solas.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001942",ch="rna"},
},
ja={
{
name={"Rina"},
"“Te dan a saber cosas sin que necesites preguntarlas...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001943",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así ha sido para mí...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Para ti? ¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001944",ch="rna"},
},
ja={
{
name={"Rina"},
"“Olvídalo. No es nada.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, ¿piensas presentar algo en la Exposición Moore?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001945",ch="rna"},
},
ja={
{
name={"Rina"},
"“La verdad es que no. O al menos me gustaría decir eso, pero Toritani-senpai se\npodría enfadar conmigo si me escucha decirlo...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001946",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero... no pinto este cuadro por premios.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente. Ahora que lo recuerdo, jamás te he visto presentando algo en una\nexposición.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0003",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001947",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No puedo decir mucho de la Exposición Moore, pero con el nivel que tienes\npodrías presentar en una exposición normal sin problema alguno.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_001948",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me alegra que me digas eso. Aunque, no me interesa mucho realmente.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Nos quedamos en silencio.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Me di la vuelta para irme a las escaleras. Pero, en ese instante...",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bgm",stop=1,time=500},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000015",ch="rld"},
},
ja={
{
name={"???"},
"“Rina onee-chaaan.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"se",file="se9004",id=1},
{"fg",mode=-2},
{"fg",ch="ルリヲ",size="z1",mx=40,mode=3,resize=1,path=":fg/rur/z1/",file="rur_z1i0000",face="i0001",head="rur_z1i",x=-345,lv=4,id=5},
{"fg",ch="鈴菜",size="z1",mx=40,mode=3,resize=1,path=":fg/suz/z1/",file="suz_z1i0000",face="i0001",head="suz_z1i",x=345,lv=4,id=6},
{"bgm",file="bgm031"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000016",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Ohhh, también está Kusanagi-chan aquí.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hace tu hermana acá?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0002",head="suz_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000020",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Parece que llegamos en buen momento.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En buen momento? ¿Qué vinieron a hacer acá?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0002",head="rur_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000017",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Aaahhh, Kusanagi-chan, solo pasábamos casualmente por acá y pensamos en venir a\nsaludarte.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pasaron casualmente por acá? Yumihari está en la cima de una colina...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0009",head="suz_z1i",x=345,lv=4,id=6},
{"fgact",ch="鈴菜",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000021",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Solo bromea. Chiste aparte, vinimos acá para mostrarte esto, Rina onee-sama.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Al decir eso, Suzuna nos mostró una fotografía de su celular.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta muchacha es...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"En la foto estaba alguien que conocíamos.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="ルリヲ",mode=-1,lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001949",ch="rna"},
},
ja={
{
name={"Rina"},
"“Solo puedo juzgar por el uniforme y el cabello, pero... probablemente sea Kana\nNagayama...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Es difícil discernirla por lo lejos que está, pero parece ser ella.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Puedo preguntar algo?... ¿Por qué tienes una foto de Nagayama?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0008",head="suz_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000022",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Rina onee-sama me pidió que le informara si llegaba a notar algo extraño\nalrededor...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0004",head="suz_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000023",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“No llegué a notar nada extraño, hasta ahora. Vi a esta persona merodeando\nfrente a mi casa, así que le tomé una foto...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Frente a la casa de los Kawachino?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0015",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001950",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me imagino que escuchó los rumores aquella vez que vino. Nagayama debe haber\npuesto sus ojos sobre Yuumi ahora...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0011",head="suz_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000024",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Quién es esta muchacha? Me crucé con ella por el portón hace un rato...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0009",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001951",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por el portón del colegio? Uwaah... El acoso está tomando fuerza.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0001",head="suz_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000025",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Acoso?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, parece que está averiguando absolutamente todo lo que tenga que ver\nconmigo. Puede que Kawachino haya terminado metida en esto por eso mismo...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0010",head="suz_z1i",x=345,lv=4,id=6},
{"fgact",ch="鈴菜",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000026",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0009",head="rna_z1b",x2=-345,x=-570,lv=4,id=5},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0001",head="rur_z1i",x=0,lv=4,id=9},
{"fg",ch="ルリヲ",speed=300,mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0001",head="rur_z1i",y2="0,-10,0,-10",x=0,y=0,lv=4,id=9},
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0010",head="suz_z1i",x2=345,x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000018",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Puedo, puedo? ¿Puede Ruriwo ver también?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0011",head="suz_z1i",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000027",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“No creo que sepas de quién se trata, Ruriwo-san...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"La hermanita de Hikawa se arrima a ver la pantalla.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0002",head="rur_z1i",x=0,y=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000019",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Jee, lo de ser buenos tomando fotos a escondidas parece ser de familia. Suzuna,\neres casi tan buena como Yuumi onee-chan.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0004",head="suz_z1i",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000028",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Te pido de manera cortés que retires lo dicho. Esta foto la tomé con los lentes\ntelescópicos que onee-sama usa con su teléfono.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Se le pueden poner lentes telescópicos al celular?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0002",head="suz_z1i",x=570,lv=4,id=6},
{"fgact",ch="鈴菜",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000029",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Se puede. Onee-sama tiene varios de ellos, así que tomé uno y lo usé.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pensé que su pasión por espiar a los demás fuera tan fuerte.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0003",head="rur_z1i",x=0,y=0,lv=4,id=9},
{"fgact",ch="ルリヲ",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rld_000020",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Ah, claro claro. Es por eso que onee-chan tiene fotos tan cercanas de\nKusanagi-chan. A Kusanagi-chan no parece gustarle mucho las fotografías, así\nque se me hacía extraño~”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una foto mía de cerca?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0014i",head="rna_z1b",x=-570,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",loop=3,time=200,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001952",ch="rna"},
},
ja={
{
name={"Rina"},
"“Wa~, wa~, wa~, ¿P-Pero qué cosas dices, Ruriwo-san? Ven acá un momento...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0010",head="suz_z1i",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000030",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“No hay nada de lo qué debas apenarte. Nadie podría resistirse a la tentación de\nencargar un par de fotos de tener una paparazzi como amiga.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001953",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿E-Encargar?! S-Suzuna-chan, ¿podrías venir acá tú también?...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="ルリヲ",mode=-1,lv=4,id=9},
{"fg",ch="鈴菜",mode=-1,lv=4,id=6},
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0014i",head="rna_z1b",x2=-570,x=0,lv=4,id=5},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tienes fotos mías, Hikawa?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011i",head="rna_z1b",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001954",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Solo, por casualidad... mera, casualidad...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_rld_000021",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Y también es casualidad que cuides bastante de la foto~? Ruriwo te ha visto,\nonee-chan. Siempre que estás sola viendo esas fotos comienzas a hacer 'Jaa,\njaa'.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Mm!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_snd_000031",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¡Mm!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0014j",head="rna_z1b",x=0,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001955",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-E-Eso no--”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",mode=-2},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0010",head="rur_z1i",x=-345,lv=4,id=5},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0009",head="suz_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000022",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Qué es lo que haces siempre con esa foto? Siempre se me ha hecho curioso~”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0007",head="suz_z1i",x=345,lv=4,id=6},
{"fgact",ch="鈴菜",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000032",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¡E-Ejem! Y-Ya reportamos lo que debíamos reportar, así que... ¿Nos vamos ya?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0014",head="rur_z1i",x=-345,lv=4,id=5},
{"fgact",ch="ルリヲ",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000023",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Eh? ¿Por qué? Apenas acabamos de llegar.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0006",head="suz_z1i",x=345,lv=4,id=6},
{"fgact",ch="鈴菜",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000033",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¡Eso no importa, vámonos! ¡Ruriwo-san!”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0006",head="suz_z1i",x2=345,x=0,lv=4,id=6},
{"text"},
delay={
[100]={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0006",head="suz_z1i",x2=0,x=210,lv=4,id=6},
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0014",head="rur_z1i",x2=-345,x=-135,lv=4,id=5},
{"se",file="se9010",id=1},
},
},
text={
ja={
{
"La hermana de Kawachino jala fuertemente de la mano a la hermana de Hikawa.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0007",head="rur_z1i",x=-135,lv=4,id=5},
{"fgact",ch="ルリヲ",act="びっくり",loop=2,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000024",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Wawawah, ¿q-qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0006",head="suz_z1i",x2=210,x=420,lv=4,id=6},
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0007",head="rur_z1i",x2=-135,x=75,lv=4,id=5},
{"se",file="se9010",id=1},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0005",head="suz_z1i",x=420,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000034",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¡No digas más nada, solo ven acá!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0001",head="rur_z1i",x=75,lv=4,id=5},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000025",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Está bien. Adióóós, Kusanagi-chaaan.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"se",file="se9004",id=1},
{"fg",ch="ルリヲ",mx=40,mode=-1,lv=4,id=5,sync=0},
{"fg",ch="鈴菜",mx=40,mode=-1,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Suzuna se lleva a Ruriwo, sermoneándola a gritos.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_snd_000035_n",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¡P-Prestame atención muy bien! ¡Esa clase de cosas no se revelan frente a un\nhombre!”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000026_n",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Ehhh? ¿Cuáles cosas?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_snd_000036_n",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¡Qué sé yo! ¡En fin, hay cosas que simplemente no se deben decir, o hacer!”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Poco a poco se va dejando de escuchar la conversación.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"Y finalmente, nos quedamos los dos solos en la azotea...",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"bgm",file="bgm007"},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0011i",head="rna_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001956",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-Eh, ehm...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0013i",head="rna_z1d",lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0014i",head="rna_z1d",lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001957",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡N-No es lo que tú crees! C-Como ya sabes, soy algo frágil de salud, Y-Y por\neso--”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué hay de ese 'Jaa, jaa'?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0007i",head="rna_z1d",lv=4,id=5},
{"fgact",ch="里奈",act="うんうん",time=200,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001958",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿De qué rayos estás hablando?!”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estabas caliente?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0019i",head="rna_z1d",lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001959",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿P-Por qué lo interpretas de esa forma?!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por la reacción de tu hermana y la de Kawachino, supongo.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0006i",head="rna_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001960",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿D-De verdad crees todo lo que dijeron?!”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0007i",head="rna_z1d",lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",time=200,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0005i",head="rna_z1d",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001961",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Por qué?! ¡Son niñas, infantes! ¡Suelen exagerarlo todo!”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez tengas razón.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero prefiero creerles igual. Por dentro quisiera que fuera verdad.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0013i",head="rna_z1a",lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001962",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿J-Jaa?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Total, es entretenido fantasear, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012j",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001963",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005j",head="rna_z1a",lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001964",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¡Mm!!”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Hikawa me lanza una fuerte mirada.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Y con una expresión en su rostro que no suelo ver mucho.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Cara completamente roja, ojos lagrimosos.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Hikawa pareciera ser una persona muy expresiva, pero en realidad no lo es.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Es realmente raro verla con esa cara.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0006i",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001965",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-Eres todo un pervertido, senpai.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La misma Kawachino lo ha dicho, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0007i",head="rna_z1a",lv=4,id=5},
{"fgact",ch="里奈",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001966",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡No le sigas la corriente a todo lo que dice!”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero tenías fotos mías, ¿no? ¿Fotos mientras me cambiaba de ropa, quizás?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010i",head="rna_z1a",lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001967",ch="rna"},
},
ja={
{
name={"Rina"},
"“P-Por supuesto que no. S-Son solo fotos tuyas, sonriendo...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sonriendo? Vaya que debe de haberse esforzado como para capturarme sonriendo.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011i",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001968",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yo misma cogí el celular de Yuumi y tomé la foto...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“V-Vaya, no sabía...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009i",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001969",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fue aquel día... Aquel momento, cuando completamos el mural...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ese día... ¿Estaba sonriendo?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001j",head="rna_z1a",lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001970",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, lo estabas...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0017i",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001971",ch="rna"},
},
ja={
{
name={"Rina"},
"“R-Reitero, por si acaso, que se trata de una foto totalmente normal y\ndecente...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0006i",head="rna_z1d",lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001972",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡A-Así que eso de estar caliente, es todo, es todo un malentendido!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Malentendido? ¿Qué clase de malentendido?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0018i",head="rna_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001973",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Senpai, ¿te, te parece que soy la clase de chica capaz de hacer cosas raras\nmientras ve una foto tuya sonriendo?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo pareces. Es por eso mismo, que me alegraría... que sea verdad.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0011j",head="rna_z1d",lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001974",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Mm!”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010i",head="rna_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001975",ch="rna"},
},
ja={
{
name={"Rina"},
"“J-Jamás imaginé, que tuvieras esa táctica de ataque en tu arsenal... Senpai.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Táctica de ataque? ¿De qué rayos hablas? Simplemente estoy diciendo que me\nalegraría eso.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008i",head="rna_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001976",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Te alegraría?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0011i",head="rna_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001977",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso sería de depravados.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hablas de mí?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0007i",head="rna_z1d",lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001978",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡No! ¡Yo! ¡Por hacer eso!”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Sería un magnífico complemento que una chica tan linda como tú fuera\ntambién una pervertida.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0013i",head="rna_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001979",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿V-Vas.. a llamarme linda? ¿Aquí, ahora?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo eres. Simplemente no lo digo con frecuencia porque Kawachino se altera.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010j",head="rna_z1d",lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001980",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uh.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Hikawa baja su mirada.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0011i",head="rna_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001981",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-Eres realmente terrible, senpai.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0009i",head="rna_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001982",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Te atreves a decirme eso aun cuando me tratas siempre como si no te importara!”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te parece que es así? Porque a mí no.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0006i",head="rna_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001983",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Te pedí que me hicieras tu discípula, y no quisiste!”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Discípula?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Discípula... Ah, pues sí. Rechazarte era la opción más obvia.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0005i",head="rna_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001984",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero a Rin-senpai sí le estás enseñando a pintar.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que sea mi discípula.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0006i",head="rna_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001985",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Pero no quisiste enseñarme a mí!”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque ya eres enormemente buena pintando...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0007i",head="rna_z1d",lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001986",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Eso no es excusa!”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No?...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0018i",head="rna_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001987",ch="rna"},
},
ja={
{
name={"Rina"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, ¿si te digo que podría comenzar a darte clases desde ahora aceptarías?”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001988",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Hago una pausa, y prosigo mis palabras lentamente.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012",head="rna_z2a",lv=5,id=5},
{"bgm",file="bgm029"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Probablemente no podré enseñarte de la forma que deseas.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001989",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De la forma que deseo?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya sabes a qué me refiero, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0001",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001990",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿D-De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Llegué a explicarte por qué no podía enseñarte?...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001991",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"La sonrojada cara de Hikawa se calma un poco.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"Pero sus ojos estaban, o al menos eso parecía, todavía humedecidos.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001992",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001993",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tu manera de pintar cambió.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001994",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tu estilo cambió bastante. Desde tu última obra oficial, 'Fantasía de un día de\ncerezos', hasta parte del dibujo que pintamos juntos, cambió mucho.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0011",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001995",ch="rna"},
},
ja={
{
name={"Rina"},
"“Casi, como si tu brazo dominante ya no funcionara... Así de extraño se sentía.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así logramos terminar la obra, ¿recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001996",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Por eso aquella noche pensé por un momento que habías recobrado tu\nhabilidad para pintar. Fue algo extraño.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001997",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Cómo es que llegaste a recuperarte solo por esa última noche?”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que me haya recuperado solo ese día. Es porque usé el último ápice de\nfuerza que me quedaba... Desde aquel día mi mano no ha podido pintar nada\nmás.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001998",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya no puedo pintar. No es que dejara de hacerlo, es que ya no puedo hacerlo.\nDesde aquel momento decidí dejar de publicar obras bajo el nombre de Naoya\nKusanagi.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001999",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eso significa que esa fue tu última obra?”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, fue la última.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todo ha sido como lo has dicho. Por ciertas razones terminé destruyendo el\nbrazo con el que pintaba. Y desde entonces perdí la facultad para pintar como\nlo hacía antes.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Excepto por esa noche...”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0011",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002000",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿F-Fue por eso que dejaste de pintar?... S-Se supone que es algo que has\nmantenido en secreto, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Totalmente.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002001",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué... me lo cuentas como si nada a mí?”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuando dijiste que sentiste algo venir del cuadro, pensé que no habría caso\nalguno en ocultarlo.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002002",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero aun así, no había necesidad de lo que revelaras tú mismo...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Había la posibilidad de que no me tomaras en serio.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muchas veces me has dicho que soy malicioso, un tramposo, que soy injusto. Y\neso me afecta, aunque no lo parezca.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0013",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002003",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás mi actitud no diga mucho, pero mentira no es. Lo último que me quedaba\nde mi mano lo di por ti.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002004",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Supongo que...”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002005",ch="rna"},
},
ja={
{
name={"Rina"},
"“No bastará con decir solo 'gracias'...”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002006",ch="rna"},
},
ja={
{
name={"Rina"},
"“Digo, diste lo último de vida que quedaba de tu mano por mí... Ni siquiera sé\nqué debería decir ahora...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que lo hagas. No lo hice buscando que me agradecieras...”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002007",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Solo querías ayudarme?”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que ya te lo dije, pero me duele que pienses que todo lo hago por\naltruismo.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No siempre hago las cosas por caridad...”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también guardo intenciones egoístas, de vez en cuando.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Momentos en que no hago algo solo por hacerlo, sino porque se trataba\njustamente de alguien en particular...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="びっくり",size=5,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002008",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Di lo último que quedaba de mi mano por ti. Por nadie más.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0011",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002009",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso en realidad es...”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada más ni menos de lo que acabo de decir. Di mi mano derecha por ti.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002010",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y-Yo, no puedo...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me arrepiento de haberlo hecho, eso sí. Más bien diría que fue un final\nadecuado para ella.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así de divertida fue aquella noche... Al menos para mí...”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"se",file="se9010",id=1},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0021",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002011",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡D-Definitivamente eres un demonio, senpai!”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y ahora por qué?...”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0020",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002012",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Eso no se vale!”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0019",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002013",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eres, malo... diciéndome eso, con esa sonrisa tan afligida...”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que haga lo que haga, terminaré siempre siendo el malo...”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0020",head="rna_z1a",lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002014",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es... que...”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
"Hikawa no dice nada más.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, estoy dispuesto a enseñarte a pintar cuando quieras. Solo dime.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0019",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002015",ch="rna"},
},
ja={
{
name={"Rina"},
"“Probablemente, ya no vuelva a pedírtelo más...”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No? Está bien, supongo.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002016",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Puedo preguntarte algo? No te molestaré más después de saber esto...”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres saber?”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002017",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nadie llegó a ver ese dibujo... el dibujo que desapareció cuando llegó aquel\ntifón.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002018",ch="rna"},
},
ja={
{
name={"Rina"},
"“Según dices, usaste toda la fuerza que te quedaba en la mano para terminarlo,\n¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Al menos así resultó todo.”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002019",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué lo hiciste?”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg081g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2i0000",face="i0002",head="rna_z2i",lv=5,id=5,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quería remover ese hedor a muerte que tenías.”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
vo={
{"vo",file="fem_rna_002020",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿P-Por qué... yo?...”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque quedé fascinado...”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
vo={
{"vo",file="fem_rna_002021",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Fascinado?”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Con tus pinturas. Y contigo...”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
vo={
{"vo",file="fem_rna_002022",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo... Pero ya la Rina de aquel entonces no existe...”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
vo={
{"vo",file="fem_rna_002023",ch="rna"},
},
ja={
{
name={"Rina"},
"“La Rina que tanto adoraba la muerte ya no está.”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé.”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"cgdel",id=-1},
{"bg",file="ev_com_d02_01",sync=0,path=":ev/ev_com_d02/",set="ev_com_d02"},
{"bg",file="reco",id=9,lv=9,sync=0,path=":sys/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues fui yo, y solo yo, quien te convirtió en una chica hecha a mi medida.”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una capaz de aceptar la muerte. Y que aun bajo su sombra, pueda dar su cara a\nla vida.”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0001i",head="rna_z2a",lv=5,id=5,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso me gustas, así como eres ahora.”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012i",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002024",ch="rna"},
},
ja={
{
name={"Rina"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Amo a la Rina de ahora.”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008i",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002025",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿P-Por qué me dices eso?”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea, la verdad. Creo que dentro de poco tendré que abrirme a lo\nque mi corazón realmente siente.”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y dependiendo de la respuesta a la que llegue, quizás llegue a\nmorir...”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0013",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002026",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Morir? ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, solo lo digo a manera de metáfora. De igual manera, en algún momento tendré\nque verme cara a cara con mi corazón.”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero planeo dar con una sola y única respuesta. Una que se mantendrá hasta el\ndía en que muera.”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002027",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Una sola respuesta? ¿Hasta que mueras?”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Bastante que Kawachino y tú me tildan de altruista, pero créeme que no lo\nsoy.”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Soy un humano más.”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No vivo solo por el altruismo.”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002028",ch="rna"},
},
ja={
{
name={"Rina"},
"“Senpai...”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0021",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002029",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Senpai!”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
ja={
{
"Hikawa rompe en llanto.",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0020",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002030",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Eres malvado! ¡Un terrible demonio, de lo peor!”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0019",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002031",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tienes un poder absoluto sobre mí, que usas siempre para jugar con mi\ncorazón...”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0021",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002032",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Y por eso debo huir de ti!”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0019",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002033",ch="rna"},
},
ja={
{
name={"Rina"},
"“De lo contrario...”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedes hacerlo, si así quieres. Por mi parte, haré lo que decida hacer.”",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás en derecho de tomar tu decisión por igual.”",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Enamorarse no tiene por qué ser algo mutuo. Pero lo debe ser en caso de ir de\neso a un romance.”",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual manera, pase lo que pase, el amor no se acabará.”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0020",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002034",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kusanagi-san...”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0021",head="rna_z2a",lv=5,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="うんうん",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_002035",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Eres un idiotaaa!”",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
"Hikawa me lanza un enfadado grito.",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
ja={
{
