astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo IV"},
{"bg",file="ev_aix_h04_01",path=":ev/ev_aix_h04/",set="ev_aix_h04"},
{"bgm",file="bgm028"},
{"text"},
text={
ja={
{
"'Olympia' era el nombre que se le daban a las prostitutas en ese entonces.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Manet presentó su desnudo de la prostituta en el salón de mayor prestigio.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Parece que incluso hubo alguien que se enfureció y comenzó a blandir su bastón\nante tal sensacional obra.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Y la razón está en su atmósfera tan real.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"En ella había un tinte de realidad que llevaba a aquellos que alguna vez habían\ncomprado prostitutas de vuelta al instante de esa compra.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="man_kid_000381",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y eso es lo que tomaré...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Una copia.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Aunque esto no puede ser solo una copia.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Lo que me voy a robar no es el diseño, ni tampoco los trazos.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Sino la 'atmósfera'.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Esa peculiar atmósfera que perciben aquellos que vienen por prostitutas.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"¿Por qué el hombre que blandió el bastón en la galería se enfureció tanto?",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"¿En qué momento y situación es que las personas enfurecen?",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Tomo esa energía de furia contenida en la imagen y la plasmo en el lienzo.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_kid_000382",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Gah.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"bg",file="ev_aix_h04_02",sync=0,face=1,time=400,path=":ev/ev_aix_h04/",set="ev_aix_h04"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000214",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“P-Profesor, ¿e-está bien?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="man_kid_000383",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“S-Sí, estoy bien. Esos idiotas se darán cuenta de la estupidez que\ncometieron...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000215",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Darse cuenta?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="man_kid_000384",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“A un pintor no se le puede llamar muerto si su brazo derecho sigue vivo. Para\nmatarlo tendrían que arrancarle ambos brazos.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000216",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Profesor...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="man_kid_000385",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Se darán cuenta mañana. De lo que puede hacer un pintor medio muerto solo con\nsu mano derecha...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Mizuna estuvo todo el tiempo observándome con una expresión de preocupación.\nPero siempre que eso pasaba, yo...",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000386",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡No! ¡Esa expresión no me sirve!”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="man_kid_000387",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“La esencia de Olympia está en su mirada retadora.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000388",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Toma una mirada más fría! ¿Qué expresión hacía tu cara cuando lo recibías acá?\n¡Obviamente esa carita amable no era!”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"bg",file="ev_aix_h04_03",sync=0,face=1,time=400,path=":ev/ev_aix_h04/",set="ev_aix_h04"},
{"text"},
text={
ja={
{
"Mizuna intentó decir algo, pero al instante siguiente tomó esa mirada.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"bg",file="zev_aix_h04_03",speed=120000,zoom=90,time=500,sync=0,path=":ev/ev_aix_h04/",set="ev_aix_h04",x2=540,y2=230,x=768,y=230,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Sí, esto era lo que buscaba.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Esa misma mirada que mostró cuando me vio por primera vez.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Una mirada que pareciera bloquear todo lo externo, y sin embargo también hace\nsentir la furia contenida internamente.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Estos ojos.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"El viejo ese no podrá resistir esta mirada.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"bg",file="ev_aix_h04_03",path=":ev/ev_aix_h04/",set="ev_aix_h04"},
{"text"},
text={
ja={
{
"El dolor de mi brazo izquierdo va calmándose.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Es la prueba irrefutable de que estaba en la zona.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Mi cerebro puso por debajo a mi brazo izquierdo y ahora está priorizando el\ncuadro que tengo enfrente. Llegó a la conclusión de que este cuadro es más\nimportante que el daño sufrido por el cuerpo.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Pinto sobre el lienzo.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"La plasmo a ella, y a mi propia furia.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"A veces el cuchillo del débil hace tropezar al fuerte, alcanzando incluso su\ngarganta.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Para eso es que ahora, sacrificaré mi brazo.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="ev_eye_c12_01",path=":ev/ev_eye_c12/",set="ev_eye_c12"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="man_syi_000181",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“... ¿Pero qué demonios?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"bg",file="ev_uni_c11_01",path=":ev/ev_uni_c11/",set="ev_uni_c11"},
{"bgm",file="bgm109"},
{"text"},
text={
ja={
{
"Shoichi Nakamura lanzó un molesto quejido al ver la pintura colgada en la\nentrada de la residencia Kootoha.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_syi_000182",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Tú! ¡¿Qué hace este cuadro colgado acá?!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="man_kfa_000026",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“N-No lo sé, señor, ¿habrá sido el hombre de ayer?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="man_syi_000183",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Ese tipo? Imposible, su brazo estaba vuelto trizas, no tenía fuerza alguna\npara hacer esto.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_kfa_000027",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¿Entonces quién?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="man_syi_000184",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Yo qué sé, no tengo idea. Es mejor preguntarle a la que vive acá.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_syi_000185",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Mizuna! ¡¿Dónde estás?!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="man_syi_000186",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Hoy honrarás tu promesa de ayer y harás lo que yo te diga!”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="man_syi_000187",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Que no está?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="man_kfa_000028",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¿Quiere que la busque?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="man_syi_000188",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Sí, y apúrate, tengo al coche esperando.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="man_kfa_000029",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“Entendido.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg002a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=-345,lv=4,id=5,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="黒服",size="z1",mx=40,mode=3,resize=1,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kfa_000030",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“N-No está por ninguna parte.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000189",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Qué me estás diciendo? ¿Cómo es que a esta hora aún no está? Ya debería haber\nregresado del colegio, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="man_kfa_000031",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“Llamaré al colegio Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000190",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Sí, apresúrate!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="黒服",mx=40,mode=-1,lv=4,id=6},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000191",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Dónde estás, Mizuna?... No me digas que huiste para evitar tener que cumplir\ntu promesa conmigo...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=-345,lv=4,id=5},
{"fgact",ch="章一",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000192",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Mierda, no dejaré pasar esta insolencia solo con una promesa... Ya\nverás...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"quake",mode="mw"},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000193",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿----?!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=-345,lv=4,id=5},
{"fgact",ch="章一",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000194",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Cómo me irrita este cuadro, demonios! ¡¿Qué hace acá?!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="黒服Ｂ",size="z1",mode=3,resize=1,path=":fg/bcb/z1/",file="bcb_z1a0000",face="a0001",head="bcb_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kfb_000012",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"“¿Sucede algo, señor?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0011",head="syo_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000195",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Este cuadro me ha estado jalando las pelotas desde hace rato, siento como si\nMizuna me estuviera viendo! ¡¿Por qué demonios la hicieron tan parecida a\nella?!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="man_kfb_000013",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"“¿En serio? ¿Se parece a Mizuna-san?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=-345,lv=4,id=5},
{"fgact",ch="章一",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000196",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Ah? ¡¿Qué no ves?! ¡Tiene la misma mirada retadora de ella!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fgact",ch="黒服Ｂ",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kfb_000014",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"“L-La verdad es que no la conozco tan a fondo...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000197",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Qué milagro que estés trabajando de escolta con esa capacidad de observación,\neh. ¿Es que esos ojos te sirven de algo?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="man_kfb_000015",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"“L-Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="黒服Ｂ",mode=-1,lv=4,id=6},
{"fg",ch="黒服",size="z1",mx=40,mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x=345,lv=4,id=6},
{"se",file="se3130",vol=50,id=1},
{"text"},
text={
vo={
{"vo",file="man_kfa_000032",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“Señor Nakamura, acabo de llamar al colegio Yumihari y me han confirmado que ya\nno está. Al parecer salió de clases hace un buen rato...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",x=-345,lv=4,id=5},
{"fgact",ch="章一",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000198",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿Qué me estás diciendo?! ¿Entonces si huyó? ¡Esa mocosa!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000199",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Le voy a enseñar que de nada le sirve huir!”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",x=-345,lv=4,id=5},
{"fgact",ch="章一",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000200",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Ah, este cuadro de mierda!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"se",id=1,file="se3467"},
{"fg",mode=-2},
{"cgact",stage="bg002",act="いいえ"},
{"fg",ch="章一",size="z2",ex03="a0097",mode=3,resize=1,path=":fg/syo/z2/",file="syo_z2a0000",face="a0006",head="syo_z2a",lv=5,id=5},
{"fgact",ch="章一",act="うなづく",lv=5,id=5},
{"text"},
text={
ja={
{
"Shoichi Nakamura no aguantó más y finalmente puso sus manos sobre el cuadro.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="章一",size="z2",ex03="a0097",mode=3,path=":fg/syo/z2/",file="syo_z2a0000",face="a0005",head="syo_z2a",lv=5,id=5},
{"fgact",ch="章一",act="うんうん",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000201",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Porquería de cuadro!”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="ev_uni_c11_01",time=500,path=":ev/ev_uni_c11/",set="ev_uni_c11"},
{"ex",time=500,func="wait"},
{"se",id=1,file="se2883_n"},
{"quake"},
{"bg",rule=800,time=300,file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg002a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="黒服",size="z1",mode=3,path=":fg/bca/z1/",file="bca_z1a0000",face="a0001",head="bca_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=300},
{"text"},
text={
vo={
{"vo",file="man_kfa_000033",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¿Está bien que rompa ese cuadro, señor?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000202",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Por qué no debería? ¡Este es terreno de los Nakamura! ¡Cualquier cosa que esté\nadentro se puede desechar!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="man_kfa_000034",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¿E-Eso cree?... En mi opinión, quizás sería mejor confirmar antes quién es el\ndueño...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="man_kid_000389",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es. Esté en tu terreno o no, eso no te da el derecho de romperlo sin\npermiso.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0007",head="syo_z1a",x=-345,lv=4,id=5},
{"fgact",ch="章一",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000203",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Tú!”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"se",file="se9056",vol=50,id=1},
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=0,lv=4,id=9},
{"quake"},
{"text"},
text={
ja={
{
"Los dos hombres de negro me rodean alertados.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"se",stop=1,time=500,id=1},
{"bgm",file="bgm008"},
{"text"},
text={
vo={
{"vo",file="man_kid_000390",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Llegaste rápido, tal como lo esperaba.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000204",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Fuiste tú quien pintó este cuadro?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="man_kid_000391",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",x=0,lv=4,id=9},
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000205",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Hmph, pero qué broma tan tonta! ¿Pintaste esto solo para que yo lo rompiera?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="man_kid_000392",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por supuesto que no, idiota. Es para vender.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000206",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Para vender?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="man_kid_000393",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Me entró un trabajillo ayer, y este fue el resultado. Justo ahora acabo de\nfirmar el contrato de venta.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",x=0,lv=4,id=9},
{"fgact",ch="章一",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000207",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Contrato de venta?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="man_kid_000394",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, así es. Un cliente me encargó este cuadro, yo se lo pinté. Y lo vendí.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",x=0,lv=4,id=9},
{"fgact",ch="章一",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000208",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Pues lo siento, eh. Envía mis disculpas al comprador. Pero la culpa la tienes\ntú por dejar esto acá.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="man_kid_000395",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Eso no tiene nada que ver. No importa donde esté puesto el cuadro, no es de tu\npropiedad. No tienes derecho a romperlo.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0003",head="syo_z1a",x=0,lv=4,id=9},
{"fgact",ch="章一",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000209",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Kukuku, ¿y cuánto se supone que cuesta?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000396",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡1 billón de yenes!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kfb_000016",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"“Fuh, ¡parece que no te bastó con un solo brazo, ¿eh?!”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="man_kfa_000035",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¿Quieres que te demos otra lección más?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",x=0,lv=4,id=9},
{"fgact",ch="章一",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000210",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Qué estupidez. ¿Qué clase de idiota compraría este cuadro por 1 billón?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000001",ch="ktk"},
},
ja={
{
name={"???"},
"“Cómo me cabrea que un idiota me llame idiota a mí, eh.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000002",ch="ktk"},
},
ja={
{
name={"???"},
"“Voy a entrar.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"msgoff"},
{"se",file="se1279",id=1},
{"fg",time=500,sync=1,mode=-2},
{"fg",ch="琴子",size="z1",ex03="a0097",time=800,mode=3,resize=1,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Una anciana cruzó la puerta de la residencia Kootoha.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Y al instante en que vio su cara, Shoichi Nakamura palideció.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000003",ch="ktk"},
},
ja={
{
name={"???"},
"“Parece que te has estado pavoneando bastante, jovencito Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000211",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Tú, la de los Natsume--!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="man_kfa_000036",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¿Qué te traes, vieja?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="man_kfa_000037",ch="kfa"},
},
ja={
{
name={"Hombre de negro A"},
"“¿--?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"se",file="se3130",id=1},
{"mwact",act="いいえ"},
{"text"},
text={
ja={
{
"Justo cuando los guardaespaldas de Nakamura intentaron agarrar a la abuela,\nunos hombres enormes se interpusieron frente a ella.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Si solo fuese eso no se hubiesen sorprendido.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"se",file="se3309",id=1},
{"mwact",act="うなづく",size=5},
{"text"},
text={
ja={
{
"Y sucede que uno de los guardaespaldas de Nakamura tenía ahora un cuchillo\napuntando justamente su estómago.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Si se mueve solo un poco, terminará cortándose el abdomen.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",lv=4,id=9},
{"fgact",ch="琴子",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000004",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Vaya pelotas que tienes para buscarle pelea a los Natsume y a la misma Kotoko\nNatsume, Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="man_kfb_000017",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"“M-Maldita vieja...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"El hombre de negro intenta moverse.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="man_syi_000212",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“No te muevas, ninguno de ellos es katagi.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",lv=4,id=9},
{"fgact",ch="琴子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000005",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Ahhhn? ¿Y es que ustedes sí lo son? Vaya que se fueron de borda con este\npartiéndole el brazo. ¿Un katagi haría eso?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000006",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Seguro nos querían imitar, sí. Pero escucha bien, jovencito. Nada bueno pasa\ncuando idiotas intentan hacerse pasar por Yakuza.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000213",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“C-Cállese, vieja.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Familia Natsume.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Su jefa, Kotoko Natsume.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"No es esposa de ningún Yakuza. Ella es la jefa legítima.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Conocida como una mujer de gran carácter, el grupo se formó con ella en el\ncentro. Después de la guerra acumuló una fortuna manejando los cargamentos\ndel puerto, convirtiéndose en una poderosa familia de apostadores.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Su fama en Yumihari se equipara con la de los Nakamura. Aunque en los bajos\nfondos su fama es aun mayor que la de ellos.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Si bien es un grupo pequeño, ha sido muy temido desde el final de la guerra por\nsu carácter violento.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"ex",time=0,func="wait"},
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000007",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Los Nakamura han estado controlando Yumihari desde los tiempos de Kamakura.\nGente de alcurnia son ustedes, sí. Y no está nada bien que ustedes, hijos de\npapi y mami, se hagan pasar por Yakuza como nosotros.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_syi_000214",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Yakuza de mierda! ¡Por si no sabías, la familia Nakamura--!”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",lv=4,id=9},
{"fgact",ch="琴子",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000008",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Familia de prestigio, ¿no? ¡Pues deberían quedarse en casa plantando flores\ncomo buenos nobles que son!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="man_syi_000215",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"*Tch*...",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000009",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿O es que van a ir a lloriquearle a los de Tokyo como lo hicieron ya una vez?\nMucho desastre se hizo aquella vez, eh, y eso que apenas acabamos de calmar\nel fuego.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_syi_000216",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿E-Es que no le tienes miedo a una guerra?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
{"fgact",ch="琴子",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",lv=4,id=9},
{"fgact",ch="琴子",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000010",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Ahhhn? ¿Qué Yakuza le podría tener miedo a la guerra? No me importa cuántos\nmueran, si guerra quieren guerra tendrán.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kfb_000018",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"“Señor Nakamura, esta señora es...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",x=0,lv=4,id=9},
{"fgact",ch="章一",act="おじぎ",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000217",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Sí, es la jefa de la familia Natsume...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kfb_000019",ch="kfb"},
},
ja={
{
name={"Hombre de negro B"},
"“¿No son los Natsume los mismos que tienen el apoyo de un enorme movimiento de\nderecha? Según, ni siquiera los grupos violentos de Kantou o Kansai han\npodido hacerle frente...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",x=0,lv=4,id=9},
{"fgact",ch="章一",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000218",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Solo son rumores. No son tan grande en realidad... no deberían.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",mode=-2},
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",lv=4,id=9},
{"fgact",ch="琴子",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000011",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Ya, ya está bien con la charla inútil. Este cuadro se lo compré a Kenichiro\nKusanagi por 1 billón de yenes. Aquí está el contrato de venta, como puedes\nver.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"se",file="se2497",id=1},
{"fgact",ch="琴子",act="うなづく",lv=4,id=9},
{"text"},
text={
ja={
{
"La abuela mostró el contrato.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Trajo al abogado a primera hora de la mañana para que lo hiciera.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Es un contrato auténtico, con toda legalidad.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="琴子",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000012",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Y usted, señor, lo rompió sin permiso alguno. Así que va a pagarme todo el\nvalor del mismo.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="man_syi_000219",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Lo estás diciendo en serio?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
{"fgact",ch="琴子",act="うんうん",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000013",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“En serio, muy en serio. Bien, bien, es 1 billón. Estoy esperando.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_syi_000220",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡No me jodas! ¡No tengo manera de pagar eso!”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0005",head="ktk_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000014",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿No tienes manera? ¿De eso se trata, señor? ¿Ustedes destruyeron propiedad de\nla familia Natsume pero no tienen para compensar por eso?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="man_syi_000221",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡N-No tengo forma de conseguir esa cantidad de dinero!”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0005",head="ktk_z1a",lv=4,id=9},
{"fgact",ch="琴子",act="うんうん",time=300,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000015",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Ya veo, ya veo. Pues si así son las cosas, nosotros haremos lo nuestro como\nsabemos hacerlo...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000016",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Ya los de Tokio no vendrán a ayudarles. Si ustedes quieren guerra en Yumihari\ncon los Natsume, van a tener que prepararse para lo que les viene.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"quake",mode="mw"},
{"se",file="se3130",id=1},
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=9},
{"fg",ch="章一",size="z1",ex01="a0099",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000222",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡A-A mí que me importa eso! ¡Nos vamos ya, idiotas!”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="man_kfa_000038",ch="kfa"},
{"vo",file="man_kfb_000020",ch="kfb"},
},
ja={
{
name={"Hombres de negro A y B"},
"“S-Sí señor.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"se",file="se9056",id=1},
{"text"},
text={
ja={
{
"Nakamura y su gente se retiran, sin mostrar ni una pizca de la actitud\namenazante de ayer.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Y obviamente no iban a hacerlo.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"No iban a poder mantener la compostura ante el oponente con el cual batallaron\nya una vez en guerra. Guerra que incluso fue cubierta por los diarios\nnacionales.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Y menos aún que ya no tienen el apoyo de los Yakuza de Kantou. Junto a los\ncuales, por cierto, tampoco pudieron eliminar a los Natsume.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg001a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",lv=4,id=9},
{"fgact",ch="琴子",act="おじぎ",lv=4,id=9},
{"bgm",file="bgm110"},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000017",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Muy bien. Kenichiro, debo decir que has hecho un buen trabajo.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="man_kid_000397",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No soy muy adepto de colaborar en los trabajillos de Yakuza, debo decir yo\ntambién.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fgact",ch="琴子",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000018",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Vamos, que eso no importa. Los Yakuza siempre se han caracterizado por ayudar a\nlos débiles y aplastar a los fuertes.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="man_kid_000398",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“A esos Yakuza solo los ves en películas.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000019",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Solo en películas? Nos tienes aquí.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="man_kid_000399",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Jaa? ¿Tú, ayudando a débiles y aplastando a fuertes, abuela? ¿Un ogro como tú?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000020",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Yasu, dale una buena paliza a este zopenco.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",mode=-2},
{"fg",ch="ヤス",size="z1",mode=3,resize=1,path=":fg/ysu/z1/",file="ysu_z1a0000",face="a0001",head="ysu_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ysu_000001",ch="ysu"},
},
ja={
{
name={"Yasu"},
"“Sí, seño'.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000400",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“E-Espera, esp-, espera un momento, tengo el brazo fracturado, ¿qué no ves?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000021",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“No te preocupes, los Yakuza sabemos de mil y un maneras de torturar a alguien\nsin destrozar su cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000401",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡¿Que no me preocupe?!”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",mode=-2},
{"fg",ch="水菜",size="z2",mode=3,resize=1,path=":fg/miz/z2/",file="miz_z2a0200",face="a0007",head="miz_z2a",lv=5,id=9},
{"fgact",ch="水菜",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000217",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡No, por favor! ¡Si va a golpear al profesor, golpéeme a mí!”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Mizuna se para frente a los Yakuza, intentando protegerme.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",mode=-2,sync=0},
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="水菜",size="z1",mode=3,resize=1,path=":fg/miz/z1/",file="miz_z1a0200",face="a0009",head="miz_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000022",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Vaya, ¿así que esta jovencita es la dichosa Mizuna?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="man_kid_000402",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, ella es Mizuna.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=-345,lv=4,id=5},
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0011",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0006",head="miz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000218",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“L-Le agradezco por haberles dado una lección a esos hombres. Pero le ruego que\nno le haga daño al profesor, por favor. Si eso quiere hacer golpeeme a mí\ntanto como quiera.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",x=-345,lv=4,id=5},
{"fgact",ch="琴子",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000023",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“No hay problema, muchachita. Esto es normal entre Kenichiro y yo.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0007",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000219",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡El profesor arriesgo su vida por mí!”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ktk_000024",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Ya me contaron. Pero un brazo o dos no es nada para un hombre intentando salvar\na la mujer que ama.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0013h",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008h",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="いいえ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000220",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Eh? ¿Ehh? N-No, e-espere, no es nada de eso. A-Al profesor le dio lástima mi\nsituación, y decidió ayudarme, solo eso...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0011",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000221",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Sería una falta de respeto para el profesor afirmar que está enamorado de mí...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000025",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“No seas tonta, muchachita. Nadie haría tanto por alguien solo por lástima.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0009",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000222",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“P-Pero, yo...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="man_kid_000403",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué pasa, Mizuna? ¿Mi amor te incomoda?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0013",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0012h",head="miz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000223",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Eh? Profesor, e-eh, ¿eh? ¿Q-Qué significa--?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ktk_000026",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Los Natsume nacemos para amar a una sola persona, muchachita. Somos capaces de\ndar hasta la vida por esa persona. Este idiota no es muy de confiar todavía,\npero siempre actuará cuando el momento lo amerite. Nieto mío tenía que ser.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0013h",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008h",head="miz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000224",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Eh? ¿Ehh? ¿N-Nieto? ¿Eh? ¿Su nieto? ¿Es acaso el profesor su nieto, señora?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="man_kid_000404",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es. No está casada, así que nuestros apellidos son distintos, pero Kotoko\nNatsume es mi abuela.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0013h",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0007h",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000225",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Eh? ¿Ehhhh? ¡¿E-Es en serio?! ¡D-Discúlpeme por mi irrespetuosa actitud! ¡M-Me\npresento, mi, mi nombre es Mizuna Nakamura--!”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ktk_000027",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Por qué tanta formalidad ahora? Qué divertida es esta muchacha. Ni se\ninmutó sabiendo que tenía a la jefa de los Natsume ante sí, pero miren ahora.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ktk_000028",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Es que entonces es más importante para ti el hecho de que yo soy su abuela? ¿A\nver, muchachita, será que tú también estás loca por este idiota?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008h",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="びっくり",time=100,size=7,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0009h",head="miz_z1a",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0011h",head="miz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000226",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Y-Yo, bueno, no puedo negar que el sentimiento existe. P-Pero, yo...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",x=-345,lv=4,id=5},
{"fgact",ch="琴子",act="びっくり",time=100,size=7,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000029",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¡Muchacha! ¡Párate derecha!”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"La abuela le da un fuerte reproche a la nerviosa e indecisa Mizuna.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0013",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000227",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡S-Sí!”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000030",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“... Hmph.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",mode=-2,sync=0},
{"bg",x=-600,y=55,file="zbg001a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="水菜",size="z2",mode=3,resize=1,path=":fg/miz/z2/",file="miz_z2a0200",face="a0001",head="miz_z2a",lv=5,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"La abuela camina lentamente alrededor de Mizuna, quien estaba ahora haciendo\nuna parada en atención. Como si estuviera evaluándola...",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000031",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Ya veo, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000032",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Tienes una buena mirada, muchachita.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0012",head="miz_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z2",mode=3,path=":fg/miz/z2/",file="miz_z2a0200",face="a0001",head="miz_z2a",lv=5,id=6},
},
vl02={
{"fgact",ch="水菜",act="うなづく",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_mzd_000228",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Eh? Ah, sí.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000033",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Tienes una mirada de coraje. Debes haber pasado por situaciones terribles...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",mode=-2,sync=0},
{"bg",file="bg001a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="水菜",size="z1",mode=3,resize=1,path=":fg/miz/z1/",file="miz_z1a0200",face="a0001",head="miz_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",x=-345,lv=4,id=5},
{"fgact",ch="琴子",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ktk_000034",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Y a pesar de eso no te has quebrado. Sigues todavía intentando oponerte a ese\ndestino. Bien, muy bien.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000035",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Una mujer no vive solo para que le roben.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ktk_000036",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“De joven también me arrebataron mucho... pero he vivido bastante ya. Y ahora\nvivo para arrebatarle a los demás.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="man_kid_000405",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Eso no es normal...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",x=-345,lv=4,id=5},
{"fgact",ch="琴子",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ktk_000037",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Ahhn? ¿Y qué tiene? El que roba tiene que estar preparado para que le roben. Y\nla gente así debería pelear en su propia arena.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ktk_000038",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Pero va en contra de las reglas robarle a alguien de otro mundo. Así como ellos\nhicieron.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0002",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000229",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Se lo agradezco bastante. Hasta ahora he tenido que someterme a todo lo que me\nhacían y decían, pero ahora me siento aliviada.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ktk_000039",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Qué bueno saberlo. Pero esto no se acaba aún.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0008",head="miz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000230",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Eh? ¿No?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="man_kid_000406",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Esta abuela podrá decir cosas osadas y heroícas, pero no trabaja de gratis. Los\nYakuza solo se mueven por dinero.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000040",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Tal cual. Acabaron con el brazo de mi nieto. Yo me quedaré con ese billón de\nyenes.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0002",head="miz_z1a",x=345,lv=4,id=6},
{"fgact",ch="水菜",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000231",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Así que realmente sí es su nieto.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000041",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Así es. Han pasado muchos años, algunos han muerto, y a muchos otros jamás los\nhe visto.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ktk_000042",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Kenichiro Kusanagi es uno de los pocos nietos con los que he podido tratar y\nver. No muchos nietos querrían lidiar con una abuela Yakuza después de todo,\neh.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="man_kid_000407",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué barbaridades andas diciendo, vieja loca? ¡Si no fuese por el dinero ni te\nhubieras molestado en ayudarme! ¡A final de cuentas todo es por el dinero!”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0005",head="ktk_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ktk_000043",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Por supuesto. Pocas cosas son más importantes para nosotros los Yakuza que un\ntrabajillo. No tenemos ni un minuto, ni un segundo que desperdiciar en\nasuntos sin valor monetario.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="man_kid_000408",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Definitivamente solo sacas locuras de esa boca, vieja...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",x=-345,lv=4,id=5},
{"fgact",ch="琴子",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000044",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Qué muchachito tan quejica, eh. Yasu, dale una pequeña lección.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",mode=-2},
{"fg",ch="ヤス",size="z1",mode=3,path=":fg/ysu/z1/",file="ysu_z1a0000",face="a0001",head="ysu_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ysu_000002",ch="ysu"},
},
ja={
{
name={"Yasu"},
"“Sí, seño'.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000409",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡E-Espera!”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",mode=-2},
{"fg",ch="水菜",size="z2",mode=3,resize=1,path=":fg/miz/z2/",file="miz_z2a0200",face="a0013",head="miz_z2a",lv=5,id=6},
{"fgact",ch="水菜",act="うなづく",lv=5,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000232",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡E-Espere, por favor!”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000045",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“No te preocupes. Es solo una forma de saludarnos.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Después de eso, Yasu-san me llevó en vehículo a un hospital.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"De un médico clandestino, eso sí...",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Aunque el doctor sabía lo que hacía. No por nada, todas las personas que\natiende flotan entre la vida y la muerte...",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Poco después de llegar me operaron.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Según me dijo, podrían quedar pequeñas secuelas en mi brazo.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Lo dejé sin tratar por varias horas. Era de esperarse.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="04_what_is_mind？_02_6"},
{"text"},
linkback="block_00216",
},
label = {
top={block="block_00000",label=1},
},
}
