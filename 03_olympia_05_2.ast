astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="zbluesky_spring",speed=240000,rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/",x2=960,y2=540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm023"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Esta mañana fue terrible.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Fue para cuando terminaron las clases que mis partes inferiores se calmaron,\ndespués de que quedaran a medio hervir tras ese beso.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Estuve intranquilo durante todo ese tiempo, pero no me podía permitir tener una\nerección, así que en esos momentos que sentía que se pararía, contenía mi\nmiembro con mi mano hacia abajo, a la fuerza.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Esta clase de maniobra es, de cierta forma, una técnica prohibida. Al echar\nhacia abajo el miembro ya erecto, no sé si el flujo de sangre simplemente\nregresa al cuerpo, o es simplemente por el dolor, pero de igual forma, hace\nque este se calme.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios... a dónde se fue la amable y cariñosa Rin que conozco...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"No sé si es por influencia de los mangas eróticos, pero la Rin que me masturbó\ncon las manos se comportó de una manera bastante maliciosa, y casi\nindistinguible de la Rin que he conocido hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nuooh.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Solo con pensar en esa maliciosa Rin, siento que se me parará de nuevo. Actué\nal instante y contuve mis partes inferiores.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Aunque, aun así, ya me masturbaron una vez hoy...",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="eveningsky_winter",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"ex",time=1000,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002351",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Parece que no hay nadie hoy.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, si esperamos un rato probablemente Toritani o alguien más regrese.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002352",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tienes razón... esto...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Con un tanto de dificultad, Rin trató de decirme algo, pero justo en ese\nmomento superpuse sus palabras con las mías.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo hacemos en mi casa?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002353",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¡¿H-Hacer qué?!”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, digo, pintar... para la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002354",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Ah, eh? C-Cierto, ajajaja. ¡Ah, sí, claro! Esa es buena idea.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué se te vino a la mente como para tener que soltar ese chillido tan\nextraño?...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002355",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nada, nada, no estoy pensando absolutamente nada raro. Ajaja...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, vayamos entonces a mi casa...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Probablemente estamos iguales los dos.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"La verdad, no creo para nada que Rin y yo, así como estoy ahora, podamos\nquedarnos a solas únicamente pintando...",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"De verdad no tengo seguridad alguna de que podamos hacer eso, pero...",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, ¿vamos entonces a mi casa?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002356",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí, d-deberíamos ir... además, por haberte hecho esta maldad en la mañana\npareces haber estado sufriendo todo el día... Según pude ver, estuviste\nconteniendo tus piernas todo este tiempo...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"De paso que se dio cuenta que estuve aguantando todo este largo rato...",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002357",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Bien, ¿nos vamos?!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Rin tomó mi mano.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002358",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Si agarras mi mano...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002359",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Si agarro tu mano?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No podré resistir hasta llegar a casa...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0013j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002360",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Eh?!”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="稟",size="z1",my=40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009j",head="rin_z1a",lv=4,id=9},
{"se",file="se3130",vol=40,id=1},
{"text"},
text={
ja={
{
"Rin se sonroja a más no poder y suelta mi mano.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Sí, probablemente no se le pasó por la cabeza la idea de que se me podría\nhinchar el miembro de tan solo agarrar mi mano. Sin embargo, mis partes\ninferiores están como nitroglicerina: Basta con un leve estímulo para que\nexploten.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002361",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Q-Qué hacemos?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué, quieres decir con 'qué hacemos'?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009j",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002362",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, cómo podría decirlo... ¿Debería, hacerlo como esta mañana?... esto...\n¿d-de nuevo, con la mano?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Con la mano? ¿Eh? ¿Eeeh? Espera, ¿a-acá?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008j",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002363",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí... esto, probablemente nadie vaya hasta el desván de la sala de\npreparativos, así que si lo hacemos allá podremos enterarnos rápidamente\ncuando alguien entre a la sala de arte, y tendremos tiempo de arreglar\nnuestra ropa en ese caso...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Ciertamente, lo que dice Rin es cierto, pero...",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Quién diría que esa penosa Rin sería capaz de decir eso...",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Y bien... c-co... con mano, te refieres... ¿a que me harás eso, de nuevo, con\ntu mano?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009j",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002364",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Ah, no... si comenzamos con la continuación de esta mañana, entonces...\neh, esto, podría comenzar de nuevo por el beso allí...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"¿Será que tomó mis palabras como una muestra de insatisfacción?",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Rin propuso algo más intenso aún.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Con lo del beso... ¡¿Te refieres a hacerlo con la boca?!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002365",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uh～～”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Rin se ruboriza hasta las orejas y baja la cabeza.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009j",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008j",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002366",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Si eso quieres hacer, entonces no tengo problema, Nao-kun. Q-Quiero hacer\ncosas que te alegren...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Mm!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"¡Rin!",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Ehm, de ser así, entonces... con todo gusto, me encantaría... que\nsiguiéramos, con la continuación de esta mañana, eh, ajajaja.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002367",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun, ¿de qué te estás riendo?...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De felicidad...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002368",ch="rnd"},
},
ja={
{
name={"Rin"},
"“T-Te estás contentando demasiado...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Es que, escuchar eso me puso feliz.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002369",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me alegra, que me digas eso, pero...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_sud_000361",ch="sud"},
},
ja={
{
name={"???"},
"“¿Qué es lo que piensan hacer con la boca? Y, ¿a qué se refieren con la\ncontinuación de esta mañana?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",mode=-2},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",lv=4,id=9},
{"bgm",file="bgm031"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eh! ¡¿Uwaaah?!”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002370",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Mmm?!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"mwact",act="びっくり"},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Tanto Rin como yo nos alejamos el uno del otro a velocidad supersónica ante esa\nrepentina voz.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mx=40,mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002371",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sui-chan...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0004",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000362",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pero qué casualidad, ¿no? Encontrarnos en este lugar...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué tiene de casualidad eso?! ¡Esta es la sala de arte! ¡Después de las\nclases esta sala se vuelve territorio del club de arte!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0016",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0002",head="sui_z1a",x=-345,lv=4,id=9},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000363",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ohhh, ¿en verdad? Eso me facilita las cosas entonces. ¡Quisiera preguntar algo!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué?...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000364",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿No estará por acá aquello que estoy buscando?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",mode=-2},
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0100",face="a0012",head="sui_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿AHHHN? ¡¿CREES QUE YO SÉ ESO, IDIOTA?!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0022",head="sui_z2a",lv=5,id=9},
{"fgact",ch="吹",act="いいえ",lv=5,id=9},
{"fgact",ch="吹",act="icon",lv=5,id=9,icon="icon12z2",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_sud_000365",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ohhh, K-Kusanagi-san, la cara que tienes ahora es la más terrorífica que me has\nmostrado jamás.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me imagino, eh. Debo tener una cara horrenda ahora, ah.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0100",face="a0001",head="sui_z2a",lv=5,id=9},
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002372",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vamos, cálmate, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, Rin, por culpa de esta idiota...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002373",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La culpa es de nosotros, por estar tratando de hacer cosas raras en el\ncolegio...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Rin me susurra eso al oído. Eso es correcto. Un argumento total,\ninequívocamente correcto.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Rin recupera la compostura y le habla a Sui.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",mode=-2},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002374",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Bien, Sui-chan, ¿crees que lo que estás buscando está acá?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0011",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000366",ch="sud"},
},
ja={
{
name={"Sui"},
"“No lo sé. Simplemente terminé llegando acá de una u otra manera.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos? ¿Eso que buscas está en este colegio?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0010",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000367",ch="sud"},
},
ja={
{
name={"Sui"},
"“No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No sabes nada?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0009",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000368",ch="sud"},
},
ja={
{
name={"Sui"},
"“Así es, no sé nada.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, qué mal, eh. Qué lástima, qué pena. Que tengas suerte~”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002375",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No tendrás alguna pista de lo que quieres buscar?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"se",file="se9010",id=1},
{"fg",mode=-2},
{"bg",speed=300,sync=0,file="zbg049b",path=":bg/",x2=-760,y2=30,x=-960,y=30,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="稟",size="z2",speed=300,sync=0,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",x2=200,x=0,lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esp--, ¡Rin!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=0,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002376",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Mm? Dime.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Ahora le susurro yo al oído a Rin.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, por fin pudimos quedarnos a solas, y... ehm, digo, podríamos continuar\ncon lo que estábamos haciendo en la mañana...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",x=0,lv=5,id=6},
{"fgact",ch="稟",act="いいえ",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009",head="rin_z2a",x=0,lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002377",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, sí... pero...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Rin señala con su dedo mis partes inferiores.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=0,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002378",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Parece que ya se calmaron.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Geh! ¡¿P-Pero qué haces calmándote ahora, muchacho?!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Parece que entre todo este jaleo, mi erección se apaciguó...",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0017",head="sui_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_sud_000369",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué puede haber de malo que un muchacho se calme?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002379",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Sui-chan, eso no importa. No tienes por qué preocuparte de eso.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000370",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Por qué?! ¡A Sui le llama la atención eso!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Cállate ya, ignóralo! ¡Ahh, mierda! ¿Y qué hay de las pistas? ¡¿Qué no hay\nninguna?!”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"Entro en desesperación. La verdad es que mucho más que estar en esto, quisiera\nquedarme a solas con Rin lo más rápido posible, pero...",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bg",time=500,file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg027c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0011",head="sui_z1a",lv=4,id=5,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000371",ch="sud"},
},
ja={
{
name={"Sui"},
"“Estoy buscando algo...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, eso lo sé. ¿Qué estás buscando?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0010",head="sui_z1a",lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000372",ch="sud"},
},
ja={
{
name={"Sui"},
"“No lo sé...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aún sin saber qué debes buscar, ¿estás buscando?...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0011",head="sui_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0009",head="sui_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000373",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí... Aunque, al observar este lugar... siento que debo buscar algo...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al observar este lugar...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"cgdel",id=-1},
{"bg",time=500,file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Aquel día, Sui lucía mucho más madura de lo normal...",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Buscar algo no siempre traerá una buena respuesta...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Eso ya lo sé, lo sé muy bien.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002380",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002381",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad no tienes ninguna pista?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x2=0,x=345,lv=4,id=6},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0009",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000374",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí, no tengo nada que se asemeje a una pista... pero, hay una palabra que me ha\nestado llamado un poco la atención.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una palabra que te llama la atención? ¿Tenías ya algo así?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000375",ch="sud"},
},
ja={
{
name={"Sui"},
"“Más que tener, diría que hace poco me dio esa sensación...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, considerando que hasta ahora no sabías en lo absoluto qué es lo que\nestás buscando, eso significa un gran paso, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Cuál es esa palabra que te llama la atención?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000376",ch="sud"},
},
ja={
{
name={"Sui"},
"“Olympia.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002382",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Olympia?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0011",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0009",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000377",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí. No sé por qué, pero... tengo ese nombre grabado en mi cabeza.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que lo tienes grabado en la cabeza? Pero si ese es el fabricante de tu ropa.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0013",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000378",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿El fabricante de mi ropa?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es nada de lo que tengas que preguntarme de nuevo, ¿no? Sin duda alguna, es\nel fabricante de tu ropa.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0009",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000379",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ahora que lo recuerdo, eso habías dicho antes, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002383",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo, así que la ropa de marca Olympia es la pista para la búsqueda, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0011",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0009",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000380",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pues, es solo una tenue sensación, pero... hay algo al respecto que me hace\nrascarme la cabeza.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002384",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No sabes dónde fue que compraste ese atuendo?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0010",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000381",ch="sud"},
},
ja={
{
name={"Sui"},
"“No, no lo sé.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ni siquiera sabes eso?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0009",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000382",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí. Son solo recuerdos borrosos, pero, siento que Olympia fue un regalo de\nparte de otra persona para mí.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002385",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Un regalo?...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuántos de tus atuendos son de marca Olympia?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000383",ch="sud"},
},
ja={
{
name={"Sui"},
"“Toda mi ropa tiene la etiqueta de Olympia.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Toda tu ropa tiene esa etiqueta?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000384",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Por qué pones una cara de tanto desconcierto?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entre tus atuendos también está el uniforme del colegio Yumihari, ¿no? ¿Quieres\ndecir entonces que tu uniforme también es marca Olympia?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0009",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000385",ch="sud"},
},
ja={
{
name={"Sui"},
"“Tengo la impresión de que sí lo era.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso los fabricantes de ropa casual fabrican también uniformes?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002386",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, no es que no haya ningún fabricante que lo haga, pero...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002387",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Podrías mostrarme un momento? Ah, Nao-kun, voltea allá, por favor.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002388",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, es verdad. Este uniforme tiene la etiqueta de Olympia.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y el tuyo?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002389",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Kyah!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Tu cuello es hermoso...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002390",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Esp--! ¡¿Pero qué buscas revisar fisgoneando en el interior de mi uniforme?!”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0006",head="rin_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
"Rin aparta mi mano a un lado.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002391",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto, mi uniforme no es de ese fabricante.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El uniforme del colegio es producido por varios fabricantes?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002392",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No lo sé. Respecto a eso, debo preguntarle a las demás personas.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tienes razón. Lo mejor es preguntarle a los demás.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002393",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quizás sea buena idea preguntarle a Mako-chan, o a Rina-chan o Yuumi-chan.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... Aunque por mala suerte, no están aquí ahora...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002394b",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué conveniente sería tener el teléfono celular en este momento...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El reglamento del colegio lo prohíbe, pero igual hay muchos que lo traen igual,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, yo las llamaré...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002395",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, ¿siempre traes tu teléfono celular al colegio?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto. No tenemos teléfono fijo en mi casa, así que si no lo llevo\nconmigo a todas partes no puedo contactar a la casa Natsume desde la mía.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002396",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿En verdad?... Pero, no creo que las demás lo tengan también consigo...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"extrans",time=300},
{"se",id=1,sync=1,file="se1343"},
{"se",id=2,file="se3434"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001690",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué pasa, Kusanagi? Estoy ocupada ahora.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento, lo siento, solo quería preguntarte algo...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=6,sync=0},
{"extrans",rule=139,vague=40},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002397",ch="rnd"},
},
ja={
{
name={"Rin"},
"“M-Mako-chan es una delincuente... No puedo creer que haya sido capaz de romper\nlas reglas del colegio...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es porque ella también vive sola. Seria muy inconveniente para ella no\nllevar el celular a todos lados, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002398",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y-Ya veo... entonces lo hace por no tener más opción...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, parece que el uniforme de Toritani tampoco tiene la etiqueta de\nOlympia.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002399",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Será que solo el uniforme de Sui-chan tiene esa etiqueta?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las posibilidades son altas, aunque también es posible que el fabricante de\nuniformes establecido por el colegio haya cambiado este año con los de primer\naño.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002400",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Desde este año? Pero por ese caso, yo también compré un uniforme este año.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues es una cuestión de posibilidades. Por los momentos, creo que sería buena\nidea preguntarle también al par de primer año, Hikawa y Kawachino. El número\nde las dos es...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002401",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creo que en este caso las dos no traen el teléfono celular consigo. No hay\nforma de que hayan comenzado a romper las reglas del colegio desde su primer\naño.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad será así?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"extrans",time=300},
{"se",id=1,sync=1,file="se1343"},
{"se",id=2,file="se3434"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000812",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Quién habla?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, soy yo. Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_yum_000813",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tch.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"se",id=1,file="se3434"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me chasqueó la lengua y cortó la llamada...”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002402",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y-Yuumi-chan también...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Casi todo el mundo lleva el teléfono consigo. La verdad es que las reglas de\nYumihari son muy poco estrictas, pues a pesar de prohibir esto o aquello,\ndesde que estoy acá nunca han realizado ninguna revisión de posesiones\npersonales...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por otro lado, ¿es que Yuumi ni siquiera ha registrado mi número telefónico\naún?...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002403",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por cierto, ¿por qué te cortó la llamada?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tengo una muy buena idea de por qué.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"extrans",time=300},
{"se",id=1,sync=1,file="se1343"},
{"se",id=2,file="se3434"},
{"text"},
text={
vo={
{"vo",file="fem_ans_000002",ch="ans"},
},
ja={
{
name={"Contestadora"},
"“El número que usted ha marcado se encuentra en estos momentos fuera de alcance,\no en su defecto, se encuentra apagado...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tal como lo imaginaba...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002404",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hikawa no contesta.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002405",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues eso es porque ella no trae su teléfono al colegio, seguramente.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, probablemente fue apagado... a manos de Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002406",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debe ser porque están solas las dos en este momento. Llevo 6 meses\nconociéndola, pero ya he empezado a entender cada vez más cómo actúa ella.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002407",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y-Ya veo... sí, bueno, ciertamente Yuumi-chan quiere mucho a Rina-chan.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Y me aborrece a mí...",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, ¿buscamos a Hikawa y Kawachino?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002408",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sabes dónde están?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí... Tratándose de Kawachino, seguramente eligió un lugar en el que\npudieran quedarse a solas las dos. Un lugar por donde no pase gente.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002409",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por ejemplo?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El depósito del gimnasio, o algo así?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002410",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué el depósito?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues es una situación de las más básicas, ¿no? En casi todas las obras de\nficción escolar el gimnasio está incluido entre los lugares predilectos para\ntener sexo.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002411",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿P-Por qué tienen que estar en un lugar para tener sexo?...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estamos hablando de esa Kawachino, es totalmente factible que ocurra. Por\nejemplo...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"bgm",stop=1,time=500},
{"bg",time=1000,file="white",path=":bg/"},
{"msgoff"},
{"bg",file="bluesky_winter",id=8,lv=8,sync=0,path=":cg/"},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"ex",time=500,func="wait"},
{"cgdel",id=9,time=1000,lv=5},
{"ex",time=500,func="wait"},
{"se",id=1,file="se2308"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000724",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi~, ¿por qué me pediste que viniera acá~?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_rna_000725",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿No está Yuumi? Pero qué raro, esa carta decía que me estaría esperando en\nel depósito del gimnasio.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_rna_000726",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi~, ¿dónde estás~?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"se",id=1,sync=1,file="se2308"},
{"se",id=2,file="key02close"},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0110",face="b0013",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="ジャンプ",lv=4,id=5},
{"bgm",file="bgm012"},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0014",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"fgact",ch="里奈",act="icon",lv=4,id=5,icon="icon09z1",x=50,y=-550},
},
},
text={
vo={
{"vo",file="fem_rna_000727",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Jaa? ¿P-Por qué, está esto a oscuras ahora? ¡Ah, la puerta se cerró!”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="ジャンプ",lv=4,id=6},
{"fgact",ch="優美",act="icon",lv=4,id=6,icon="icon03z1",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_yum_000814",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina. Estamos en graves problemas. Estamos encerradas.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0015",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000728",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, no, pero si fuiste tú quien acaba de cerrarla...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000815",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Se podría decir eso también.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0017",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000729",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso es lo único que se podría decir...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0010",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0013",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000730",ch="rna"},
},
ja={
{
name={"Rina"},
"“Siempre con esos chistes tuyos, Yuumi... ¿Crees que podemos pintar o hacer algo\nen este lugar tan oscuro?... ¿Ah? ¿Are? ¿Arere?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000816",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No era mentira lo de que estábamos encerradas.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0006",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000731",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Q-Qué truco usaste?!”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="ジャンプ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000817",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El mismo método que Thomas usó la vez pasada, enganché una vara a los rieles de\nla puerta...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0009",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000732",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿P-Por qué hiciste eso?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000818",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Shh, haz silencio, Rina. ¿No te parece que hace algo de calor acá?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0014",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"fgact",ch="里奈",act="icon",lv=4,id=5,icon="icon09z1",x=50,y=-550},
{"fg",ch="優美",my=40,mode=-1,lv=4,id=6},
{"se",file="se0897s",id=1},
},
},
text={
vo={
{"vo",file="fem_rna_000733",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, a pesar de que ya terminaron las vacaciones de verano, aún es\nseptiembre... ¿Espera, por qué estás desnudándote? ¡Yuumi!”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_yum_000819",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si nos quedamos así corremos el riesgo de sufrir hipertermia y morir las dos.\nVamos, quítate tú también la ropa, Rina.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0006i",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000734",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿P-Pero qué idioteces dices?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000820",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Rina, tu cara está roja, esto es grave! ¡Estás comenzando a deshidratarte!”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0015i",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000735",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Espera, espera, obviamente me pondré roja teniendo a mi mejor amiga\ndesnudándose frente a mí!”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"De repente, Kawachino besa a Hikawa.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000736",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mn... mmng... ¡¿Mnn?! Ngg, ngg.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="fem_yum_000821",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ngh... *chuumu*... ngh, *reru*... *jururu*... ng...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2d0100",face="d0006j",head="rna_z2d",lv=5,id=5},
{"fgact",ch="里奈",act="ジャンプ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000737",ch="rna"},
},
ja={
{
name={"Rina"},
"“Puhaaa. ¡¿Pero qué estás haciendo?!”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_yum_000822",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Estoy tratando de hacer que recuperes líquido! Tómalos, Rina.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0007",head="rna_z2d",lv=5,id=5},
{"fgact",ch="里奈",act="icon",lv=5,id=5,icon="icon05z2",x=90,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_rna_000738",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Quiero saber en qué parte del mundo hay alguien que trate de ayudar a alguien\na hidratarse mediante un beso!”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000823",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jejeje, el único líquido que hay en este lugar es el de mis labios. ¡Por eso te besé, Rina!”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0011",head="rna_z2d",lv=5,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000739",ch="rna"},
},
ja={
{
name={"Rina"},
"“No sé qué pretendes diciéndolo con tanto orgullo...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="fem_yum_000824",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, pero creo que yo también tengo ganas de hidratarme contigo, Rina...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0021",head="rna_z2d",lv=5,id=5},
{"fgact",ch="里奈",act="いいえ",lv=5,id=5},
{"fgact",ch="里奈",act="icon",lv=5,id=5,icon="icon18z2",x=-250,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_rna_000740",ch="rna"},
},
ja={
{
name={"Rina"},
"“W-Wawah, n-no trates, de seguir b-besándome...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_yum_000825",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No tienes de qué preocuparte. Los fluidos no los tomaré de la boca de arriba...\nVamos.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010j",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="ジャンプ",lv=5,id=5},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_000741",ch="rna"},
},
ja={
{
name={"Rina"},
"“D-Deten--, a-auhh... ah, no, n-no metas tu mano dentro de mi falda... ah, ¡no!”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="fem_yum_000826",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Todo está bien. No hay ninguna equivocación. Es justo acá adentro donde está el\nlugar del cual quiero hidratarme...”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0020j",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="いいえ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000742",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡I-IyaaaAaaahh!”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"msgoff"},
{"bg",file="reco",id=9,lv=9,path=":sys/"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"bg",time=1000,file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=6,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y si eso es lo que busca, pues es muy factible que elija ese lugar.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002412",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿P-Pero qué cosas estás imaginándote?...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002413",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En primer lugar, no hay forma de que eso suceda. Ambas son chicas.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así te parece? En lo personal, creo que ella es una lesbiana de verdad, y\nademás una pervertida.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002414",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Con qué pruebas afirmas eso...”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, ¿qué será?... De alguna forma, siento en ella algo cercano a mí...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0014",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002415",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Espera, Nao-kun, ¿tú también eres un pervertido?!”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un poquito.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0022",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=6},
},
vl02={
{"fgact",ch="稟",act="ジャンプ",lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002416",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Será entonces que en realidad siempre has estado enamorado de Akashi-senpai?\n¿O quizás Kei-kun? ¿O tal vez el profesor Wakata? ¿Te gustan los barbudos?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Pero qué andas diciendo?”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002417",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Es que, Nao-kun, eres un homosexual y un pervertido, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, no, te equivocas! ¡Te equivocas, Rin! ¡No soy ningún homosexual! Y en\nprimer lugar, si fuera un homosexual no saldría contigo, ¿no crees?...”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002418",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por eso mismo se me ocurrió que quizás estés saliendo conmigo para enmascarar\nel hecho de que eres un homosexual...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“I-Idiota, ¿qué clase de estúpido gastaría su primera confesión por esa razón?”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002419",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿F-Fue tu primera confesión?”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obvio que lo fue. ¿Crees que voy a andar por ahí confesándome a diestra y\nsiniestra?”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000386",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Pero qué tanto están hablando de confesiones y máscaras?! ¡¿En verdad tienen\ntoda la seria intención de resolver el misterio de Sui?!”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002420",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, l-lo siento.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, deben estar en alguna habitación angosta y cerrada. El depósito del\ngimnasio, algún retrete del baño de chicas, o también... ¡En fin, deben estar\nen algún lugar donde puedan hidratarse y recobrar fluidos!”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002421",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo de hidratarse es solo un delirio tuyo, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero en el caso de estar encerradas en un espacio cerrado en una época de\nfuerte calor, hidratarse bien se hace importante.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002422",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Se supone que ambas están pintando afuera para preparar sus obras para la\nExposición Moore, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002423",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué deberían estar las dos dentro de una habitación cerrada entonces?\n¿Piensan acaso pintar algo en ese tipo de lugar?”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, ahora que lo dices, no hay mucho que se pueda pintar en un cuarto\ncerrado, eh... No, espera, sí lo hay. ¡Hay una temática que puede darse justo\npor tratarse de un cuarto cerrado!”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002424",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué clase de temática?”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Las dos en desnudo! ¡Después de haberse desnudado, Kawachino le quita la ropa\na Hikawa! ¡Ambas dibujan sus cuerpos desnudos mutuamente después de haberse\nhidratado entre sí y haber empapado sus cuerpos con sus fluidos corporales!”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"msgoff"},
{"se",file="se9012",id=1},
{"fg",ch="稟",time=500,sync=1,mode=-1,lv=4,id=6},
{"fg",ch="稟",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=6},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento. Rin, ¿podrías dejar de hacer esa sonrisa de terror que tienes ahora\ny que muestras de vez en cuando?”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"fgact",ch="稟",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002426",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te da miedo? En realidad no estoy tratando de poner una cara terrorífica.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues en realidad... esa sonrisa tuya da miedo...”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002427",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No es eso por estar pensando en cosas sucias, Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002428",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En fin, y dejando de lado el delirio tan absurdo de Nao-kun, si las dos fueron\na hacer un dibujo del natural, entonces pienso que deberían estar afuera. Si\nestuvieran tratando de pintar un bodegón no se hubieran tomado la molestia de\nsalir afuera.”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso digo, debe ser una pintura al desnudo.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=6},
{"fgact",ch="稟",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002429",ch="rnd"},
},
ja={
{
name={"Rin"},
"“DEJANDO DE LADO tu ridículo delirio. Acabo de decir eso, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tu sonrisa da miedo.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",mode=-2},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0010",head="sui_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000387",ch="sud"},
},
ja={
{
name={"Sui"},
"“R-Rin, tu sonrisa da miedo...”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002430",ch="rnd"},
},
ja={
{
name={"Rin"},
"“V-Vamos, no da miedo. Sui-chan, tú también...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0001",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002431",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pero, esto, creo que lo de que ambas están a solas no está tan equivocado.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No?”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002432",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, creo que también sé dónde están.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002433",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso creo, pero... bueno, no en vano ayudo siempre a los profesores, y creo que\ntengo más chance de acertar que tus delirios, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ayudar a los profesores? ¿Qué tiene que ver eso con el hecho de que sepas\ndónde están?”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002434",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Les explicaré eso mientras nos desplazamos.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"fg",ch="吹",speed=5000,mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0001",head="sui_z1a",x2=-345,x=655,lv=4,id=5},
{"fg",ch="稟",speed=5000,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x2=345,x=1345,lv=4,id=6},
{"se",file="se9012",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",stop=1,id=1,time=500},
{"se",file="se9038",id=2},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0110",face="a0017",head="yum_z1a",x=0,lv=4,id=9},
{"fgact",ch="優美",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000827",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿P-Por qué Kusanagi está acá?!”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0110",face="a0017",head="yum_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mx=40,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002435",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo siento, yo lo traje acá...”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"Al parecer, Rin, quien asiste con frecuencia a los profesores, conoce más o\nmenos a qué manos van los préstamos de las llaves del colegio.",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"No sabe exactamente quién lo hizo, pero parece que se enteró que la llave de la\nazotea había sido tomada prestada por algunos miembros del club de arte.",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
"En pocas palabras, si excluimos a Toritani y a Thomas, no cabe entonces casi\nduda de que se trata de estas dos.",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
"Y por tal razón entonces es que vinimos ahora hasta la azotea.",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"fg",ch="優美",mode=-1,lv=4,id=9},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1d0100",face="d0012",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000743",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué sucede, muchachos?”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002436",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ehm, esto, disculpen que vengamos de repente. Queríamos saber si el uniforme de\nalguna de las dos tiene una etiqueta con la marca 'Olympia'.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0009",head="rna_z1d",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000744",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿La etiqueta? No sé, la verdad. Jamás la he revisado.”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",lv=4,id=9},
{"fgact",ch="優美",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000828",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Ja?! ¡Claro!”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0100",face="a0016",head="yum_z2a",lv=5,id=9},
{"fgact",ch="優美",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Kawachino mete su mano en su mochila.",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
"Yo respondo de manera inmediata.",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"bg",y=100,zoom=70,x=-380,speed=200,time=0,sync=0,file="zbg053b",path=":bg/",x2=0,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="優美",size="z2",time=0,mode=3,path=":fg/yum/z2/",file="yum_z2a0110",face="a0006",head="yum_z2a",lv=5,id=9},
{"fg",ch="優美",speed=200,time=0,sync=0,mode=3,path=":fg/yum/z2/",file="yum_z2a0110",face="a0006",head="yum_z2a",x2=0,x=-300,lv=5,id=9},
{"quake"},
{"quake",mode="mw"},
{"se",id=1,file="se2500"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000829",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tch.”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh... ya conozco qué trucos te traes debajo de la manga.”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eres una pervertida, a fin de cuentas. Seguramente planeabas desnudar por\ncompleto a Hikawa con la excusa de revisar la etiqueta. Y yo era un estorbo\npara eso.”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tratándose de ti, estaba seguro de que vendrías por mis ojos. ¡El tiempo que\ngastaste metiendo la mano en tu mochila fue suficiente para prepararme para\nel combate!”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0100",face="a0016",head="yum_z2a",x=-300,lv=5,id=9},
{"fgact",ch="優美",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000830",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vamos, ¿pero qué dices? No hay necesidad de desnudarla por completo. No hace\nfalta además que se quite la ropa interior...”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, claro... ahora que lo dic--”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"fg",ch="優美",size="z2",time=0,sync=0,mode=3,path=":fg/yum/z2/",file="yum_z2a0110",face="a0017",head="yum_z2a",x=-300,lv=5,id=9},
{"fg",ch="優美",speed=200,time=0,sync=0,mode=3,path=":fg/yum/z2/",file="yum_z2a0110",face="a0017",head="yum_z2a",x2=-300,x=0,lv=5,id=9},
{"fgact",ch="優美",act="うなづく",size=50,lv=5,id=9},
{"se",id=1,file="se2500"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Gyaah!”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0012",head="rna_z1d",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="ジャンプ",lv=4,id=5},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0004",head="yum_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000831",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bien, ya acabé con los ojos de Kusanagi. ¡Este es el momento! ¡Te quitarás el\nuniforme ahora! ¡Vamos, desnúdate por completo!”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0007",head="rna_z1d",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=-345,lv=4,id=5},
{"se",file="se9010",id=1},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x2=-345,x=150,lv=4,id=5},
{"fgact",ch="優美",act="うなづく",size=50,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000745",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esp--, ¿p-por qué, debo desnudarme por completo? ¡¿Solo hace falta que voltees\nun poco la camisa, no?! Eh, wa, wawawah, n-no, espera, kyaah.”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0016",head="yum_z1b",x=150,lv=4,id=5},
{"fgact",ch="優美",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="びっくり",lv=4,id=5},
{"fgact",ch="優美",act="icon",lv=4,id=5,icon="icon09z1",x=50,y=-550},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",x=150,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000832",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Desnúdate, vas a desnudarte, el cuerpo desnudo es sin duda alguna lo más\nmajestuoso que... ¡¿Guhoo?! ¿Q-Qué es esto? ¡¿Un hadaka jime?!”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0012",head="rna_z1d",x=345,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",lv=4,id=1},
{"fg",ch="稟",speed=3000,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",x2=0,x=-680,lv=4,id=1},
{"fg",ch="優美",speed=3000,mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",x2=150,x=-345,lv=4,id=5},
{"se",file="se1437",id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002437",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por Dios... No puedes hacer eso, Kawachino-san. Si tratas con tanta violencia\nsu uniforme, se romperá.”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"se",stop=1,time=500,id=1},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0020",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000833",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“R-Rin-senpai...”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=-680,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002438",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si aprieto solo un poco más, puedo hacer incluso que te desmayes,\nKawachino-san.”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="ジャンプ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000834",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí... de cierta manera puedo sentirlo. Si empujas aún más esos enormes pechos\nque estás pegando contra mi espalda... me correré.”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",x=-680,lv=4,id=1},
{"fgact",ch="稟",act="おじぎ",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002439",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto... ¿No estás malinterpretando un tanto el significado de lo que dije?”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="ジャンプ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0016",head="yum_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000835",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Vamos, presiona esos majestuosos pechos contra mi espalda! ¡Me harás ascender\na los cielos con ellos! ¡Vamos!”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Guh...”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
ja={
{
"Mis ojos no ven muy bien, pero parece que Kawachino se aprovechó después de\ncegarme para tratar de desnudar a Hikawa, pero Rin la detuvo...",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
"Con sus pechos...",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_olympia_05_3"},
