},
text={
ja={
{
"Sin decir una sola palabra, Rina se acercó a la mochila, y sacó algo de\nadentro.",
{"rt2"},
},
},
},
linkback="block_00479",
linknext="block_00481",
},
block_00481={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué... demonios, es eso?”",
{"rt2"},
},
},
},
linkback="block_00480",
linknext="block_00482",
},
block_00482={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0500",face="b0018",head="rna_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002955",ch="rna"},
},
ja={
{
name={"Rina"},
"“Una cámara de video... Intentó grabarnos en secreto.”",
{"rt2"},
},
},
},
linkback="block_00481",
linknext="block_00483",
},
block_00483={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja, recordando lo que mencionó del netorare, tiene sentido.”",
{"rt2"},
},
},
},
linkback="block_00482",
linknext="block_00484",
},
block_00484={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0500",face="b0006",head="rna_z1b",x=345,lv=4,id=6},
