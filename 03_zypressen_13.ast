vo={
{"vo",file="fem_rna_002874",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, mm, ngh, mm, ngh, mm, Naoya-san, embarra mi cara, con tu semen... *chup*,\n*kyup*...”",
