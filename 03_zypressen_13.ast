},
block_00360={
{"bg",file="ev_rna_h09_03",sync=0,face=1,time=400,path=":ev/ev_rna_h09/",set="ev_rna_h09"},
{"text"},
text={
ja={
{
"Las caderas de Rina estaban meneándose. Seguramente lo hace inconscientemente,\nbuscando más placer.",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"bg",file="ev_rna_h09_04",sync=0,face=1,time=400,path=":ev/ev_rna_h09/",set="ev_rna_h09"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002893",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kuuhn, haauun, se siente genial... Jaa, jaaa, ngah, ngah, ah, ahh...”",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"text"},
text={
ja={
{
"Rina me cabalga, embistiendo con ritmo con sus caderas. La fricción que tanto\nanhelaba de mi pene la enloquece, olvidando controlar su voz.",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002894",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kaahn, ah, ah, ah.... N-Naoya-san... ngaah... es, tan grande... Ah, ah, ah...\nngaah... se siente, muy bieeen.”",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh, mi pe*e, también siente la fricción... y se siente, genial. R-Rina,\n¿puedes sentirlo tú también?”",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"text"},
text={
vo={
{"vo",file="fem_rna_002895",ch="rna"},
},
ja={
{
name={"Rina"},
"“Auh, auh... s-sí, sí puedo... tu pe*e... tu pe*e, pe*e... Ahhaahh, ¡AAaahhhh!”",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Estás gimiendo bastante... ¿Lo estás disfrutando? Ayer parecías estar en\ndolor...”",
