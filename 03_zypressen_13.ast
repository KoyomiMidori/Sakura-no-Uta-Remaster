linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"text"},
text={
vo={
{"vo",file="fem_rna_002899",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, ayer, no pude, pero.... hoy sí. Ya, sé... dónde me gusta, que me lo\nhagaaas... kufuuh.”",
