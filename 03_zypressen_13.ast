vo={
{"vo",file="fem_rna_002890",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Sí... Pero, tu cosa, también está increíblemente caliente, Naoya-san. A pesar\nde que te acabas de venir... está caliente, y bastante duro, y salta\nbastante... Dentro, de mí...”",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"text"},
