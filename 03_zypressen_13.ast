},
block_00291={
{"text"},
text={
vo={
{"vo",file="fem_rna_002867",ch="rna"},
},
ja={
{
name={"Rina"},
"“Estás en mi lugar ahora. No hace falta que aguantes más. Eyacula, eyacula\nbastante. Yo me encargaré de tomarlo todo...”",
{"rt2"},
},
},
},
linkback="block_00290",
