},
block_00369={
{"text"},
text={
vo={
{"vo",file="fem_rna_002897",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Sí... ayer, después de que lo hicimos... recordé lo sucio, y erótico que fue,\ny... no pude evitar, masturbarme...”",
{"rt2"},
},
},
},
linkback="block_00368",
