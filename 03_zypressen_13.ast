linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí... Está caliente adentro, y este víscoso líquido... se siente,\nincreíble...”",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"text"},
