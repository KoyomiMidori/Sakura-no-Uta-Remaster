astver = 2.0
astname = "ast"
ast = {
block_00000={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg014a",path=":bg/",sync=0},
{"extrans",rule="083r",vague=40},
{"se",id=1,file="se2225"},
{"bgm",file="bgm005"},
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mx=40,mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mx=40,mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="うなづく",time=300,lv=4,id=5},
{"fgact",ch="優美",act="うなづく",time=300,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000236",ch="rna"},
},
ja={
{
name={"Rina"},
"“Buenas, tiempo sin verle.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="man_tns_000001",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Bienveni... ¡Ah! ¡Kusanagi-kun! ¡Pero si es Naoya Kusanagi-kun! ¡Tiempo sin\nverte, eh!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí, buenas...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000383",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Reacciona súbitamente únicamente con senpai...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="man_tns_000002",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¿Y a que vienes? ¿Te dieron ganas de pintar de nuevo? Tengo unas pinturas muy\nbuenas, minerales de gran valor molidos y usados como pinturas. Este azul tan\núnico es, sin duda alguna...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no, no vine por pintar de nuevo...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0015",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0017",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000237",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero cómo te adora el dueño de la tienda. Aún teniendo a dos colegialas\nadentro, nos está ignorando por completo.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="man_tns_000003",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Ah~, pueees, es que llevaba tiempo sin ver a Kusanagi-kun en la tienda. ¿Quizás\nmedio año ya?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000238",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Hace medio año? Pero había escuchado que senpai dejó de pintar mucho antes...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="man_tns_000004",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Ah~, pues, es que...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, hoy estoy viniendo para comprar materiales que no necesariamente usaré\npara pintar yo, ¿no? No hay razón para que alguien que no agarre más el\npincel no pueda venir a una tienda de instrumentos de pintura.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000384",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero aun así, no creo que alguien vaya a una tienda de instrumentos de pintura\nsin razón alguna, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hace medio año fue justamente cuando la enfermedad de Kenichiro Kusanagi\nempeoró y regresó al país. Por culpa de ese idiota tuve que ponerme a buscar\nvarias cosas que necesitaba.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000239",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Estuviste comprando los materiales de pintura para tu padre?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así fue...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000385",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eras bastante considerado con tu padre, a pesar de decir que se llevaban mal.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cualquiera se tomaría el trabajo de hacer eso, por lo menos...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_tns_000005",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Y bien, ¿que buscas hoy, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No creo que lo tengan acá, pero...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="man_tns_000006",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¿Acetona?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Acetona, el disolvente orgánico.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="man_tns_000007",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Las tiendas de instrumentos de pintura no manejan esa clase de productos. Vete\na una farmacia, es más seguro conseguirlo allá. Aunque, si realmente lo\nnecesitas, pues podría ordenártela.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fui primero a una farmacia y me dijeron lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000240",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué es acetona?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000386",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es un disolvente bastante fuerte. Es excelente, no solo para pinturas de óleo,\nsino también para disolver plástico y artículos de goma. Tiene buen uso como\narma.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te pongas a usar acetona como arma...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000387",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No es tan peligroso. Tan inofensivo es que incluso lo usan para remover el\nesmalte de las uñas.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡En tu caso lo usas como spray para ir tras mis ojos!”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000388",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Los ojos son partes débiles, y por eso siempre voy tras ellos. En el mundo\nsalvaje se vive siempre explotando las debilidades de los demás.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque este no es el mundo salvaje, eh.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000241",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Derrite plástico y goma igual que el ácido clorhídrico? Ese ácido es bastante\nterrible...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es así. Simplemente sucede que la polaridad de la acetona es alta con\nrespecto a los plásticos.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, para el caso de las pinturas de óleo podrías verla como una simple\nsolución removedora. Es un disolvente bastante fuerte y especial, capaz de\nretirar de manera impecable toda pintura endurecida.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000242",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahh, ya veo. Ahora que lo recuerdo, la pintura de Rin-senpai se había\nendurecido y no pudieron retirarla bien con un removedor normal, ¿no? Y por\neso se alteraron aquel día.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="man_tns_000008",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¿De verdad? ¿No les sirvió un removedor normal para pinturas de óleo? Pero qué\npintura de tan mala calidad estaban usando...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh, es que usó las pinturas que encontré enterradas entre el montón de cosas\nde la sala de arte y reuní para ella... Es todo un surtido de pinturas que no\nsé ni de qué época son o de qué fabricante.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="man_tns_000009",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Hmmm, pues es algo que puede pasar cuando juntas pinturas en ese estado. Hay\nalgunas que dicen 'Made in OOO' y en ese caso no hay forma de saber qué\ncompuestos usan.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, varias veces he necesitado removedores más fuertes, y en esos casos he\nlogrado sacar pintura endurecida que no se podía remover con los removedores\nnormales usando acetona.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_tns_000010",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Pues, el problema está en la polaridad. También depende de los componentes de\nla pintura usada... Pero vaya, acetona de nuevo, eh. ¿Es que acaso por esos\nlares tuyos está de moda usar acetona, Naoya-kun?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De moda?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quiere decir? A mi parecer creo que soy la única persona capaz de usar\nacetona como removedor...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="man_tns_000011",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“¿De verdad? Pero, el jefe del club de arte de tu colegio vino a pedirme acetona\ntambién.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000243",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Jefe? ¿Se refiere a Toritani-senpai?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_tns_000012",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“No. Ehm, ¿cómo era que se llamaba? ¿Era Akashi-kun, o algo así?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000389",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Akashi-senpai ya no es el jefe del club...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="man_tns_000013",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Ah, ya veo. Aunque, él vino a eso de marzo de este año, así que aún era jefe\npara la época, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Marzo? Marzo de este año... ¿Y por qué Akashi quería acetona?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="man_tns_000014",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“La verdad es que no sé, aunque dijo que quería una gran cantidad de ella.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una gran cantidad?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="man_tns_000015",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“Había dicho que aparte de acetona, también le serviría acetato de etilo,\ntetrahidrofurano o cloruro de metileno, pero todas contienen compuestos\nquímicos que no pueden ser manipulados sin licencia, así que no son tan\nfáciles de obtener en una tienda de instrumentos de pintura.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000390",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Puros materiales explosivos e inflamables. Me siento extasiada con tan solo\nescuchar esos nombres.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No deberías extasiarte con nombres de disolventes orgánicos...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Acetona, acetato de etilo, tetrahidrofurano, cloruro de metileno... Todos son\ndisolventes orgánicos...",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"La acetona es, ciertamente, usada como disolvente para pinturas de óleo, pero\naun así es una excepción contada.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Jamás he escuchado de alguien que use los otros disolventes nombrados en\npinturas de óleo.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Disolventes orgánicos...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000391",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué la cara complicada?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="man_tns_000016",ch="tns"},
},
ja={
{
name={"Dueño de la tienda"},
"“De igual manera, Akashi-kun quería una gran cantidad de disolvente orgánico,\nasí que si lo obtuvo ya, entonces quizás aún le quede un poco, tal vez.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... Tratándose de Akashi, seguramente lo obtuvo de alguna manera...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000392",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Qué bien, ¿no? Nada más saber que quizás Akashi-senpai tenga algo de acetona\nsignifica que no estuvo de más venir acá.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0003",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
},
vl02={
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000244",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bien, nosotras también deberíamos comprar ya lo que necesitamos. Senpai, tienes\nque ir a tus clases suplementarias en un rato, ¿no? Mejor nos apuramos.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="zbluesky_winter",id=9,lv=9,speed=300000,path=":cg/",x2=960,y2=0,x=-960,y=0,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",rule="083r",vague=40},
{"bgm",file="bgm036"},
{"text"},
text={
ja={
{
"Tomo mis clases suplementarias.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Kei tenía que venir desde la mañana (puesto que está reparando casi todas las\nmaterias), pero en mi caso, solo se trata de geografía, así que se me es\nrelativamente cómodo.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Aunque aun así...",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué sueño tengo...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Es realmente curioso lo que pasa con las cosas que odiamos. Por más que\ntratemos de aprenderlas y memorizarlas, no nos entra nada de ellas a la\ncabeza. Aun cuando en el caso de las cosas que nos interesa, nos aprendemos\nhasta el detalle más insignificante...",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"No me entra nada de lo que me enseñan en la materia que tanto odio. Y al no\nentrarme nada a la cabeza, mi sueño se va acrecentando...",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Demonios, si sigo así terminaré durmiéndome.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Si llego a dormirme en las clases suplementarias donde estoy ahora nada más con\nKei, no cabe duda de que me descubrirán. No hay manera de encubrirlo.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Observo hacia afuera para refrescar un poco los ánimos.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es eso?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Son pocas las siluetas de las personas que se pueden observar en el jardín del\ncolegio en plenas vacaciones de verano.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Y sin embargo, hay una enorme silueta que destaca entre todas ellas...",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese es... Akashi.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Este tipo, está de nuevo observando la pared de la iglesia...",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos estará pensando?...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_aid_000525",ch="aid"},
},
ja={
{
name={"Ai"},
"“Eso es lo que me pregunto yo. ¡Idiota!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"se",file="se1437",vol=50,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2h0000",face="h0005",head="aix_z2h",lv=5,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="藍",act="いいえ",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Auch!...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Ai me pellizca la mejilla.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0006",head="aix_z2h",lv=5,id=9},
{"text"},
delay={
vl02={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0006",head="aix_z2e",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000526",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Ya llevas un buen rato bostezando y ahora viendo afuera! ¡¿Pero qué rayos\nestás pensando?! ¡Ponte por un momento en mi lugar! ¡Aun siendo profesora de\nlenguaje me pusieron a supervisar las clases de geografía!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0006",head="aix_z1e",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cómo duele... Lo siento. Por cierto, Ai, ¿por qué estás ocupándote de las\nclases suplementarias de geografía?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x2=0,x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000933",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No solo geografía, Nee-chan se está encargando de todas las materias!”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0006",head="aix_z1e",x=345,lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000527",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Por culpa tuya!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"se",id=1,file="se2192"},
{"fg",ch="藍",time=200,mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0006",head="aix_z1e",x2="345,245",x=345,lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0020",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000934",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Hiin!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0015",head="aix_z1e",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000528",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por andar tratando de huir de cualquiera manera, los otros profesores se dieron\npor vencido con este idiota...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fgact",ch="圭",act="ジャンプ",time=300,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000935",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ehhen!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0006",head="aix_z1e",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000529",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡No te pavonees con eso, idiota!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Nada más en lo que concierne a huir es que Kei demuestra tener excelentes\nhabilidades. Es de imaginarse que cualquier profesor normal pase bastante\ntrabajo con él...",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"En parte, por el hecho de ser también hermanos, es que Ai está encargada ahora\nde todas las materias, pero... Estoy empezando a sentir pena por Ai y el\nhecho de que tenga esta clase de hermano menor...",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, lamento haberte interrumpido. Sigue con la clase, por favor...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Me dispuse a ponerle atención con seriedad a la clase.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057a",path=":bg/",sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm041"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No está...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Me pongo sobre el lugar donde me pareció que Akashi estuvo parado hace un rato.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Desde acá se puede observar muy bien la pared de la iglesia.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué Akashi estuvo observando la pared de la iglesia?...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, las hermanitas de Akashi trabajan de monjas en esta\niglesia...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"¿Será que Akashi está viniendo entonces a ver cómo están sus hermanitas?",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Pues, es factible.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La iglesia...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Parece que el acceso a la iglesia del colegio Yumihari es libre.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Según, la gran mayoría de los alumnos visitan esta iglesia cuando entran de\nnuevo ingreso a su primer año en el colegio.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"La sola existencia de una iglesia es rara, y este sombrero puntiagudo es, digan\nlo que digan, una especie de símbolo de este colegio.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Parece que la edificación que los nuevos desean siempre ver de primero es esta.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Aunque, eso solo dura por los primeros meses. La gran mayoría de los alumnos no\nvuelve a venir después de visitarla unas cuantas veces.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Para aquellos sin ningún tipo de fe religiosa, la iglesia deja de ser de\ninterés tan pronto se les hace familiar.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Por cierto, yo no he entrado ni una sola vez.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Se me haya hecho familiar o no a la vista, la iglesia no representa nada de\ninterés para mí.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Me paro frente a la iglesia.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Empujo la puerta.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se1329"},
{"text"},
text={
ja={
{
"Era una puerta bastante grande, pero contrario a lo que me esperaba, se abrió\nligeramente.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=140000,file="zbg056a",path=":bg/",x2=630,y2=270,x=10,y=270,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans"},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"El diseño interior estaba totalmente alejado del estilo gótico tan\nexcesivamente empleado en la arquitectura del colegio Yumihari.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Lo primero que entra a mis ojos son los vitrales.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Son magníficos.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Avanzo por la nave de la iglesia, me paro en las escaleras del santuario y\nobservo toda la capilla.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"¿La habrá diseñado alguna persona muy bien versada en las artes?",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"El exterior tiene el estilo arquitectónico de la edad media, sin embargo, en el\ninterior se pueden observar los rastros de la influencia del estilo artístico\nmoderno cristiano.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"A juzgar por este desequilibrio, probablemente fue reformada hace poco.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Las características peculiares de la arquitectura gótica. Un espacio dividido\npor los llamados elementos lineales, los cuales son elementos en forma de\nvaras redondas y delgadas.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Los vitrales de la pared, divididos por esos elementos lineales. Al pararme en\nla nave, me doy cuenta de que todo es mucho más brillante que el estilo\nregular gótico.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg056a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Comparándolo a la parte exterior, el interior da una impresión de modernidad...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"se",file="se9028",loop=1,id=1},
{"text"},
text={
ja={
{
"Al caminar por el pasillo, este suelta un sonido rígido y seco. De no ser lo\nsuficientemente gruesas las piedras empleadas en él, no emitiría ese sonido.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está muy bien pulido todo...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Toco las paredes de la capilla.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Probablemente tanto la pared como el suelo, usados desde hace un gran tiempo,\nfueron pulidos.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque por otro lado...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=240000,file="zbg056a",path=":bg/",x2=0,y2=0,x=0,y=586,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Los vitrales son realmente espléndidos.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"El uso de los colores es excepcional.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Toda la totalidad de los vitrales pareciera tener la influencia del pintor Mark\nChagall, sin embargo, la hábil técnica observada en ciertas partes viene de\nÉmille Gallé. Además, la estructura de la iglesia como tal busca alcanzar un\nmotivo distinto.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Uno de los artistas representativos del siglo XX. Henri Matisse, llamado\ntambién como el mago del color.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Se dice que la Capilla del Rosario de la Orden Dominicana, de la cual se\nencargó él de su diseño, es la obra representativa de la arquitectura\ncristiana del siglo XX.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Me atrevería a decir que el nivel de brillo de este diseño fue inspirado\nsiguiendo la misma línea de la Capilla del Rosario.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Más que obra de un artesano, la construcción parece tener una forma creada por\nun artista.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Aunque... este uso de colores, y esta forma... tengo una fuerte impresión de\nhaberlos visto anteriormente...",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"se",file="se9028",loop=1,id=1},
{"text"},
text={
ja={
{
"Y mientras pensaba eso, me doy una vuelta por la capilla.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los vitrales espléndidamente reflejados en las hermosamente pulidas blancas\nparedes fueron, seguramente, inspiradas en la Capilla del Rosario...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"El característico grado de acabado del interior de esta iglesia. Ese acabado se\nencuentra, justamente, en el desequilibrio.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"La belleza de la arquitectura gótica está en las minuciosas peculiaridades de\nsu estructura. Si agregamos más, se podría decir incluso que su misma\nestructura, de por sí, le da cuerpo a la belleza de la arquitectura.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Es imposible darle una estructura distinta solo a la parte interior por medio\nde reformas, y, se podría decir que hacer eso sería una salvajez.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Gracias al diseño de los vitrales, y a la ampliación de la cantidad de luz, se\npudo crear una imagen totalmente diferente.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Al observar el borde del vitral, veo que emplean un material de acero para\nreforzar las columnas.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"A la imagen que evoca la arquitectura gótica se le denomina como 'un espacio\nrodeado de algo como una membrana', aunque este interior posee una estructura\nque persigue ese peculiar estado de membrana.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Una fusión del estilo arquitectónico cristiano del siglo XIV y XX, eh...",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es sorprendente el cambio de imagen aportado únicamente por el diseño de los\nvitrales y la ampliación de luz...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg056a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Al observar la blanca pared que recibía la luz de los vitrales, me topo con un\npasillo al lado.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Al avanzar un poco el pasillo, había una puerta.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Probablemente posicionaron la puerta al fondo para no romper con el balance\narmónico del lugar.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Seguramente esto también lo cambiaron al momento de hacer la reforma.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tras esta puerta debe estar la habitación del padre o del pastor, lo que sea...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Giro la manilla de la puerta.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",id=1,file="gatya"},
{"text"},
text={
ja={
{
"La puerta se abre sin esfuerzo alguno.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La sensación de libertad de acceso de este colegio es increíble...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Aunque no puedo negar que me da la sensación de que el paso a este lugar está\nprohibido a las personas ajenas...",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Trato de sobrepasar el escalón que estaba tras la puerta.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000066",ch="kmd"},
},
ja={
{
name={"???"},
"“Está prohibido entrar con zapatos allí.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",mode=-2,sync=0},
{"bg",file="bg056a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Prohibido entrar con zapatos?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Al observar bien, había una especie de cajón de zapatos colocada en el lugar.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Ya veo, así que a partir de este escalón está prohibido pasar con zapatos...",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"fg",ch="小牧",size="z1",mode=3,resize=1,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",lv=4,id=9,sync=0},
{"extrans",time=500,sync=1},
{"text"},
text={
ja={
{
"Al voltear, allí estaba parada la hermanita de Akashi.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Si no mal recuerdo, era la mayor de las gemelas Akashi, Komaki, ¿era así?...",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hay algún otro problema aparte del de entrar con zapatos?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0012",head="kom_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000067",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Te refieres a...?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, digo, normalmente a esta clase de lugares solo puede entrar personal\nautorizado, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"se",id=1,file="gatya"},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",lv=4,id=9},
{"fgact",ch="小牧",act="うなづく",lv=4,id=9},
{"text"},
text={
ja={
{
"Komaki abre, con una sonrisa en su cara, el cajón de zapatos.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Allí adentro estaban una gran cantidad de uwabaki para niños.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000068",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Más allá de este lugar está el salón de la escuela dominical. Cualquiera que\nquiera recibir clases puede entrar.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo también, ayer salieron varios niños de esta iglesia...",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0003",head="kom_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000069",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Quisieras ver el salón de la escuela dominical?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, no soy de carácter muy religioso, y si llego a entrar allí me podría\ncaer un castigo del Cielo.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000070",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Si Dios te castigara por eso, ¿no debería haberte castigado ya por haber\nentrado a la capilla?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo dices, tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0012",head="kom_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000071",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Por qué viniste a la iglesia?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, es la edificación representativa de Yumihari, ¿no es así? Pensé en venir a\nverla por lo menos una vez.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0003",head="kom_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000072",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Pensaba que nada más los estudiantes recién ingresados pensaban de esa forma.\n¿Y bien, podrías decirme qué clase de impresión recibiste al verla?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me alegro de haber venido a verla. El interior es maravilloso. Implementaron un\ndiseño nuevo manteniendo las técnicas antiguas. En particular, me parecieron\nespectaculares los vitrales.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Alguien con bastante experticia debe haber estado involucrado en su\nconstrucción...”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fgact",ch="小牧",act="うなづく",lv=4,id=9},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000073",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Me alegra mucho que digas eso.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te alegra? Lo dices como si tú lo hubieras construido, eh.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0003",head="kom_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0016",head="kom_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000074",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“No hay forma de que yo pueda construir algo tan esplendido como esto. Solo que\nme alegra que hablen bien de la iglesia.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Siendo monja en esta iglesia, debe tener bastante apego por ella, supongo.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0012",head="kom_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000075",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Te vas ya?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Iré a pasarme por el club de arte.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0005",head="kom_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000076",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Kusanagi-senpai, ¿no se supone que no eras miembro del club de arte?”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estoy dando lecciones de pintura por los momentos. Así que bueno, estoy\nrelativamente ocupado.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0008",head="kom_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000077",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Me lo imagino. Te toca presentar los exámenes de ingreso a la universidad\ntambién, así que debes estar agobiado, ¿no, Kusanagi-senpai?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No he estudiado nada, así que realmente lo de ocupado no es por eso...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0012",head="kom_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0008",head="kom_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000078",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Oh, vaya, vaya, ¿y no te traerá problemas eso?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso es que estoy esforzándome con mis clases suplementarias.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0005",head="kom_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000079",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿No se supone que las clases suplementarias son justamente por no haberte\nesforzado?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“También se podría decir eso. En fin, disculpa haberte quitado tu tiempo, eh.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",lv=4,id=9},
{"fgact",ch="小牧",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_kmd_000080",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Para nada, para nada. Gracias por haber venido. Que te vaya bien.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fgact",ch="小牧",act="おじぎ",lv=4,id=9},
{"text"},
text={
ja={
{
"Komaki hace una rápida reverencia.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Es realmente una chica muy buena, de muy buenos modales, y con bastante sentido\ncomún. Nada que ver con el monstruo de su hermanita.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"excall",file="02_abend_06_2"},
{"text"},
linkback="block_00199",
},
label = {
top={block="block_00000",label=1},
},
}
