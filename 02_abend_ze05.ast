astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo II"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"extrans",time=1000},
{"fg",mode=-2,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm009"},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000549",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿K-Kusanagi-senpai?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Justamente después de que Akashi se fuera, Hikawa y Kawachino aparecieron en la\nentrada del Templo Hakuki.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hikawa, ¿sucedió algo? Pensé que habías acabado con el club por hoy y te habías\nido a casa ya.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0015",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000405",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Este, mequetrefe, entrometido! Agghh, ¿por qué será que siempre tienes que\nvenir a interrumpirnos a las dos?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Venir a interrumpir a las dos? Fui yo quien llegó primero acá, por si no\nsabías.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000550",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si no me equivoco, parecías estar hablando con alguien...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es nada de mucha importancia. En fin, ¿qué hay con ustedes dos? Si van a\nregresar a casa pues eligieron la ruta más larga.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000551",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no es nada de eso. Simplemente, quise venir a ver el lugar...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El lugar? ¿Te refieres al templo?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000552",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué de nuevo el Templo Hakuki?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000553",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no, realmente no es nada serio...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Hikawa se queda observando el templo.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada serio, eh... Ruego que así sea.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000554",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esa forma de decirlo deja un tanto que pensar.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo niego. Y es que no tengo muy buenos recuerdos en lo que a este lugar\nrespecta.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000555",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿En lo que a este lugar respecta? ¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, son solo cosas mías. Olvídalo...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, sí, fue bien raro lo que vimos ayer... Si es eso lo que les preocupa,\npues les digo que no he visto nada hoy acá.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo el mismo Templo Hakuki, y la misma colina de Yumihari de siempre.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo único extraño que ha habido por acá es un tipo raro que estuvo viendo el\nlugar. Más nada.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000556",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Fue con Akashi-san con quien estuviste hablando hace un momento?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Solo con escuchar 'tipo raro' ya supiste de quién se trataba?...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
},
vl02={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000557",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no es eso. Solo que últimamente los dos parecen estar juntos tramando algo.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Akashi y yo? No me metas en el mismo saco. Yo no estoy haciendo nada con él.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
},
vl02={
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000406",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Quién sabe... Los dos parecen llevarse muy bien, por mí podrían avanzar a una\nrelación más seria. Dicen por ahí que el sexo entre las parejas gay se\ndisfruta bastante.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No entiendo de dónde sacas tantas ridiculeces!”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0015",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000407",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Te parece ridículo? A mi parecer, todo se resolvería muy bien si tan solo\ncomenzaras a salir con hombres, senpai. Aunque no lo parezca.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"quake",size=5,mode="mw"},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué mierda quieres decir con 'aunque no lo parezca'?!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000558",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No hubo nada raro hoy acá?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todo normal. No vi nada fuera de lo común.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000559",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué habrá sido eso entonces?...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes por qué preocuparte tanto por ello. Los hechos misteriosos, eso que\nconocemos como fenómenos sobrenaturales son, por lo general, provocados por\nfactores absurdos. Engaños de nuestra vista, cosas así.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000560",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, supongo que sí.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque bueno, supongo que es normal que les llame la atención, considerando el\nlugar donde ocurrió...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ustedes también conocen la leyenda de los cerezos milenarios, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000561",ch="rna"},
},
ja={
{
name={"Rina"},
"“Conozco la historia...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000408",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“La leyenda de aquellos cerezos que florecen ante los sentimientos y deseos más\nintensos de las personas, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Ese monstruo que se alimenta de los sentimientos más fuertes de las\npersonas y hace florecer sus cerezos.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000409",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Pero qué andas diciendo? Siento algo ponzoñoso en esa descripción.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, es difícil no aguantarme las ganas de decirlo de esa forma...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Míralo así. Supongamos que los sentimientos de alguien en el pasado revivieran\nahora, en el presente, y llegaran a afectar de alguna manera a las personas\nde esta época. ¿Hay otra forma de describir eso que no sea como una\nmaldición?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000562",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí? Aunque, la leyenda de los cerezos milenarios que llegué a conocer yo era\nuna historia más romántica...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué manera te la contaron a ti?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0018",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000563",ch="rna"},
},
ja={
{
name={"Rina"},
"“Según escuché yo, los cerezos florecen para darle forma, en el presente, a los\ndeseos de alguien en el pasado que nunca llegaron a cumplirse...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000564",ch="rna"},
},
ja={
{
name={"Rina"},
"“Era, más que una historia cruel, una milagrosa, me parece.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás sea bonita la historia, de solo escucharla así.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000565",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿La versión que escuchaste era distinta, senpai?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es la misma. Pero los milagros son la misma cosa que las maldiciones.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Maldiciones y milagros, ambos se parecen. Solo que el enfoque es distinto para\ncada uno.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",x=345,lv=4,id=6},
},
vl02={
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000410",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Muy atroz esa forma de decirlo, Kusanagi-senpai. A juzgar por la manera en que\nlo dices, se nota que en tu vida no existe nada parecido a la palabra\nmilagro.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Absolutamente, nada que ver con los milagros. Y es que el mero hecho de que los\nhumanos podamos vivir es ya de por sí milagroso. No necesito ni quiero\nmilagros que no he pedido.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0018",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000411",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Agh! ¡¿El mero hecho de vivir es ya un milagro?! ¡Pero qué basura! Para mí,\nmilagro es cuando nuestros deseos se cumplen, y es justamente eso lo que le\nda valor a nuestras vidas.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez sea así. No me parece mal que pienses eso tampoco.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000412",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué te crees? Hablando como si supieras más que uno.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que me crea más que tu. No odio a las personas que piensan así, y de\nhecho me parece bien que vean las cosas de esa manera. Solo que yo no puedo\nhacerlo, es todo.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0018",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="du",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000413",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eres bueno sacándolo a uno de sus casillas, de verdad.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Veo lentamente hacia arriba, al árbol de cerezos.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Obviamente no hay ningún cerezo floreciendo. El árbol está recubierto del verde\nde verano.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"se",id=1,file="se2192"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"Me van a patear.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0110",face="a0005",head="yum_z1a",x=345,lv=4,id=4},
{"fgact",ch="優美",act="びっくり",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000414",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Siempre haces lo mismo, comportándote como si fueras la gran cosa!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Tonta, no es que me estaba dando aires de grandeza ni nada de eso.\nSimplemente estaba pensando en algo.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=345,lv=4,id=4},
{"fgact",ch="優美",act="lr",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0018",head="yum_z1b",x=345,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_yum_000415",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Vámonos! ¡Cada vez que estoy con este tipo pierdo los estribos!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"msgoff"},
{"se",file="se9010",id=1},
{"fg",ch="優美",speed=500,mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0018",head="yum_z1b",x2=345,x=-570,lv=4,id=4},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0013",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"ex",time=500,func="wait"},
{"se",file="se9004",id=1},
{"fg",ch="優美",time=800,mx=-1280,mode=-1,lv=4,id=4},
{"fg",ch="里奈",time=800,mx=-1280,mode=-1,lv=4,id=5},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000566",ch="rna"},
},
ja={
{
name={"Rina"},
"“W-Wawah, no me jales de la mano tan repentinamente--”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tengan cuidado al regresar. Ya el sol se está poniendo, y de aquí a la colina\nYumenouki se pondrá oscuro.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_yum_000416",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No hay de qué preocuparse. ¡Si alguien se atreve a intentar hacerle algo a\nRina, se las verá con Bob Kramer!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Haces eso y ten por seguro que irás presa por exceso en legítima defensa.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg038b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=345,lv=4,id=6,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm024"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000417",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Maldita sea, ¿por qué tenía que estar justamente a donde íbamos?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0009",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000567",ch="rna"},
},
ja={
{
name={"Rina"},
"“Espera, espera, estás acusándolo de algo que no hizo. No cabe duda de que\nKusanagi-senpai fue quien llegó primero allí.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0018",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000418",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así que estuvo esperando por nosotras... Quizás se podría decir que tiene\ntalento como stalker...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0015",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000568",ch="rna"},
},
ja={
{
name={"Rina"},
"“No creo que Kusanagi-senpai quiera escuchar eso viniendo justamente de ti.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000419",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A final de cuentas no pudimos observar bien el templo.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000569",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, bueno.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000420",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aunque, ¿por qué se te ocurrió querer ir a ese templo de repente, como si nada?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000570",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no, tampoco es que la razón sea de mucha importancia, solo que...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000421",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo que...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000571",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, sí, me llamó un poco la atención y quise ir a darle un vistazo, supongo.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000422",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Mmmm. Vayamos a verlo mañana entonces.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0003",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000572",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, es buena idea. ¿Vamos a verlo después de acabar con las labores del club?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000423",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si vamos después de terminar con el club podrían interrumpirnos de nuevo. Es\nmejor ir temprano.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0015",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000573",ch="rna"},
},
ja={
{
name={"Rina"},
"“Qué flojera ir en la mañana--”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000424",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Yo te despertaré.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0005",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000574",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tampoco es para tanto, no tienes que venir hasta mi casa solo para\nlevantarme...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0015",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0003",head="yum_z1a",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000425",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bien, entendido. Entonces hoy me quedaré a dormir en tu casa.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0017",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="rl",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000575",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eh, espera, ¿por qué eso?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000426",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Para despertarte en la mañana muy cariñosamente.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0005",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000576",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Muy cariñosamente? ¿De qué forma?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
vl02={
{"fgact",ch="優美",act="うんうん",lv=4,id=6},
},
vl03={
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
vl04={
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000427",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así, ¿supongo? *soba pechos*, *soba soba*, *soba*, *soba soba soba*.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0018",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000577",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Rechazo de manera rotunda esa oferta!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="lr",time=450,lv=4,id=6},
},
vl03={
{"fgact",ch="優美",act="lr",time=700,size=60,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000428",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo bromeaba. En realidad pensaba hacerlo así. así, *mete*, así así *mete\nmete*.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0006",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000578",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Esp--, deja de doblar los dedos de esa manera tan sugestiva!”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0010",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0018",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000429",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Todo es en broma, Rina. Jamás haría algo que te desagradara. Lo único que haré\nes simplemente masturbarme al otro día recordando la cara que tuviste\ndurmiendo.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000579",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uwah, qué asco~, no quiero tenerte en mi casa~”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000430",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Está bien. Si es así, ¿si no me masturbo al otro día dejarás que me quede a\ndormir?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0005",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000580",ch="rna"},
},
ja={
{
name={"Rina"},
"“No tengo problema con que te quedes, si es solo a dormir.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",mode=-2},
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0120",face="a0003",head="yum_z2a",lv=5,id=6},
{"fgact",ch="優美",act="うんうん",lv=5,id=6},
{"se",file="se9031",id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000431",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿En serio? Oh Dios qué feliz estoy pero qué miedito tengo.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0006",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0120",face="a0003",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000581",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Qué clase de reacción es esa?!”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000432",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No es nada. Simplemente no pude contener tanta alegría y comencé a sentir miedo\nde mí misma.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0015",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000582",ch="rna"},
},
ja={
{
name={"Rina"},
"“Más miedo tengo yo de alojar a alguien así en mi casa.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000433",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No digas eso, Rina. Yo soy tu fiel esclava, totalmente obediente y sumisa a ti.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000583",ch="rna"},
},
ja={
{
name={"Rina"},
"“No quiero ni en ningún momento he querido tener a alguien así.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000434",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0015",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000584",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué no es obvio? ¿Qué clase de persona crees que soy?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0003",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
},
vl03={
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000435",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Una personita linda. Muy, muy linda. Si me lo permites podría explicártelo,\npero me tomará algo de tiempo, ¿no te importa?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0007",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0017",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000585",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Ya, está bien, está bien! Hoy te quedarás a dormir en mi casa, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",mode=-2},
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0120",face="a0003",head="yum_z2a",lv=5,id=6},
{"fgact",ch="優美",act="うんうん",lv=5,id=6},
{"se",file="se9031",id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000436",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí oh Dios qué feliz estoy pero qué miedito tengo.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0120",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000586",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Otra vez con eso?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="いいえ",lv=4,id=6},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",x=345,lv=4,id=6},
},
vl03={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000437",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, lo siento. Solo que, cuando algo que causa mucho júbilo ocurre, las\npersonas comienzan a sentir miedo de seguir viviendo...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="du",lv=4,id=6},
},
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
},
vl03={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000438",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero no te preocupes por mí. Siempre que esté en tu casa me aseguraré de fingir\nque solo somos unas dos mejores amigas muy normales, e incluso conversaremos\nde cosas de niñas, como todas las mejores amigas lo hacen.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0011",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000439",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aunque las cosas podrían salirse de control cuando regrese a mi casa...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0017",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000587",ch="rna"},
},
