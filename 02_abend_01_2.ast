astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bgm",file="bgm036"},
{"fg",mode=-2},
{"bg",file="ev_com_a30_06",rule=139,vague=40,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000206",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rinaaa. ¿Estás bien aún estando en este lugar, con este sol tan fuerte?...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_rna_000196",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tengo mi sombrero de paja, así que estoy bien...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_yum_000207",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero deberías usar tu sombrilla... Te desmayarás.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"bg",file="ev_com_a30_08",sync=0,face=1,time=400,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000197",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no vayas all--”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"bgm",stop=1,time=1000},
{"se",file="se9004",id=1},
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"bg",file="ev_com_a31_01",path=":ev/ev_com_a31/",set="ev_com_a31"},
{"se",stop=1,time=500,id=1},
{"bgm",file="bgm007"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000198",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_yum_000208",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Mi mirada se cruza con la de Kawachino, quien había venido a buscar la\nsombrilla.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Sin embargo, más impactante que eso fue...",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Debido a la posición que teníamos Kawachino y yo... su ropa interior se veía\npor completo.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"O, por lo menos, si llega a descubrir eso, me matará...",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Me enfoqué en observar nada más la cara de Kawachino para tratar de que no se\ndiera cuenta (tratando de no ver).",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"bg",file="ev_com_a31_02",sync=0,face=1,time=400,path=":ev/ev_com_a31/",set="ev_com_a31"},
{"text"},
text={
ja={
{
"El rostro de Kawachino retorna a la misma cara inexpresiva de siempre.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Ehm... Hola...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_yum_000209",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"se",file="se9010",vol=30,id=1},
{"bg",file="ev_com_a31_03",sync=0,face=1,time=400,path=":ev/ev_com_a31/",set="ev_com_a31"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Kawachino desaparece.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"¿Eh? ¿Le dio tanta vergüenza que huyó, o algo así?",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Justo en el instante en que pensé eso...",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"bg",file="ev_com_a31_04",sync=0,face=1,time=400,path=":ev/ev_com_a31/",set="ev_com_a31"},
{"se",file="se9004",vol=70,id=1},
{"se",id=2,file="se1226"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡U-Uwaaah!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="fem_yum_000210",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hay algo creciendo al lado de la piscina, así que... vamos a darle algo de\nagua...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿A-Agua?! ¡Pero si es el agua de la piscina!”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_yum_000211",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, crece bastante con mucho cloro.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡No voy a crecer con eso!!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_yum_000212",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Kusanagi-senpai, ¿desde cuándo has estado aquí?...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, fui el primero en estar aquí...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"se",id=1,file="se1226"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡U-Uwaah!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_yum_000213",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Estoy preguntando por la razón por la cual estabas escondié~ndote.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_rna_000199",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajajaja... Fui yo quien le pidió a senpai que se mantuviera en silencio. Lo\nsiento, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_yum_000214",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... Fuh, ya veo.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_rna_000200",ch="rna"},
},
ja={
{
name={"Rina"},
"“Perdóname, ¿sí? Debes estar enojada de que haya escuchado varias cosas que,\nprobablemente no quisieras que un hombre escuchara...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_yum_000215",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Realmente no... Me es insignificante lo que alguien insignificante piense de\nmí...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_yum_000216",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo que...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡E-Eh, espera!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Al final, lo que hizo Kawachino...",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"se",file="se9020",id=2},
{"bg",file="zev_com_a31_04",speed=300,time=50,path=":ev/ev_com_a31/",set="ev_com_a31",x2=-380,y2=-520,x=-960,y=60,ax=1920,ay=1080,bx=-960,by=-540},
{"ex",time=300,func="wait"},
{"bg",rule="084a",time=200,file="black",path=":bg/"},
{"se",id=2,file="se2936"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"Fue lanzar el tapacubos que tenía en la mano para llevar el agua.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"El tapacubos pasó por encima de la malla metálica trazando una precisa\nparábola, e impactó fuertemente sobre mi cara.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Sin embargo... desde esta posición se veía la ropa interior de Kawachino,\npero... Parece que no se dio cuenta de eso. Qué alivio, qué alivio...",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Si me hubiera descubierto...",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me hubiera matado...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"bg",file="ev_com_a31_02",path=":ev/ev_com_a31/",set="ev_com_a31"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000217",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"M-Mierda, se me salió la voz sin querer...",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"La mirada de Kawachino se dirigió a su propia falda.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Y después de eso, observó mi cara.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"msgoff"},
{"bg",file="ev_com_a31_05",path=":ev/ev_com_a31/",set="ev_com_a31",sync=0},
{"quake"},
{"se",file="se3130",vol=30,id=1},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_yum_000218",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“K-Kusanagi... senpai.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No, espera... ¡Kawachino!”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡N-No he visto nada!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_yum_000219",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... Mentiroso... Hoy son blancas, así que deberías haberlas visto bien...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿No era de encaje negro?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_yum_000220",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así que sí las viste por completo, eh.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"bg",file="bluesky_winter",id=9,lv=9,time=500,path=":cg/"},
{"se",file="se1437",id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡EHHHHHHHHHHHHHH! ¡SI LLEGAS A DEJAR CAER ESO MORIRÉ!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Kawachino estaba alzando una valla de bloques que no sé de dónde sacó.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"se",stop=1,id=1,time=500},
{"se",id=2,file="se1743"},
{"quake",sync=1},
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"ex",time=1000,func="wait"},
{"cgdel",id=-1},
{"bg",file="ev_com_a30_10",rule=139,vague=40,path=":ev/ev_com_a30/",set="ev_com_a30"},
{"bgm",file="bgm036"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000221",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué Kusanagi también está dentro de la sombrilla?...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, solo que la sombra que está del lado de la piscina se volvió muy pequeña,\ny...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_rna_000201",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahh... La verdad, me parece que no tiene sentido alguno que estemos todos\nacá...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_yum_000222",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fuu, pienso que no hay problema con que Rina y yo estemos... ¡Pero esta persona\ntan innecesaria!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Auch, eso duele. No me pellizques... y además, soy tu senpai, así que no me\nllames persona innecesaria.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_yum_000223",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Puedo llamarte senpai todo lo que quieras siempre y cuando no te involucres\ntanto. Mientras sigas tratando de meterte serás una persona innecesaria.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm, no entiendo por qué dices eso... Además, ¿es que hay alguna persona con\nsentido común capaz de lanzar una valla de bloques?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_yum_000224",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues, saliste ileso, así que no hay problema, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si me hubiera pegado estaría muerto ya.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_yum_000225",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿De verdad? Es una pena...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhh...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_yum_000226",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Dejando eso de lado... ¿Por qué estás acá, Kusanagi-senpai?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_rna_000202",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ciertamente. ¿Por qué estás en el colegio, senpai? Estamos en vacaciones de\nverano, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, vine a resolver un asuntillo insignificante.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_rna_000203",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Un asuntillo insignificante?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues es un asunto insignificante, en el pleno sentido de la palabra.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y creo que seré llamado pronto para ese asuntillo, así que...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_rna_000204",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tienes razón. Si nos quedamos en este lugar realmente quedaremos insolados\ntodos...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"se",file="se9012",vol=60,loop=1,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zoom=100,speed=200000,file="zbg046a",path=":bg/",z2=50,x2="@",y2="@",x=-300,y=100,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2b0110",face="b0001",head="rna_z2b",x=-400,lv=5,id=9,sync=0},
{"extrans",time=500},
{"cgact",stage="zbg046",act="びっくり",size=2,time=500,loop=-1,sync=0},
{"fgact",ch="里奈",act="びっくり",size=2,loop=-1,time=350,sync=0,lv=5,id=9},
{"bgm",file="bgm041"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000205",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_rna_000206",ch="rna"},
},
ja={
{
name={"Rina"},
"“Senpai, ¿por qué estás caminando en la misma dirección que Rina?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque vamos en la misma dirección, ¿será?...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0110",face="b0008",head="rna_z2b",x=-400,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000207",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad? ¿No se supone que para los de tercer año el piso es distinto?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no iré a recibir clases, así que tampoco voy al salón de tercer año.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0110",face="b0001",head="rna_z2b",x=-400,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000208",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahora que lo recuerdo, habías dicho que tenías que resolver un asunto\ninsignificante, ¿no? ¿De qué trata?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fgact",ch="里奈",act="停止",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0110",face="b0001",head="rna_z1b",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_yum_000227",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es bastante obvio la clase de asuntillos que podría tener que resolver alguien\nen esta época...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A-Acaso ustedes no están caminando también en dirección contraria a los\nsalones?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_rna_000209",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues eso es porque vamos a las actividades de club.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Actividades de club...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé si vas al club de arte o al de astronomía, pero debe ser terrible\ncomenzar las vacaciones de verano con eso.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000228",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Debe ser terrible también para ti comenzar las vacaciones de verano de esta\nmanera, eh, senpai. Por ser un tonto.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No es por ser tonto!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000210",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es raro que caminemos así como ahora juntos, ¿no creen?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así te parece?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000211",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hace tiempo caminábamos juntos en la misma dirección a veces, pero a medida que\ncrecimos, el solo hecho de ser de años escolares distintos hizo que cada vez\nsucediera menos...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Ahora que lo menciona, me da esa misma sensación.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
},
vl02={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0003",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000212",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quizás sea un tanto insignificante esto, pero ha pasado algo de tiempo desde la\núltima vez que caminamos así, juntos...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000213",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque si nuestro camino de vuelta a casa fuera el mismo, podríamos regresar\njuntos también.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Nos vamos juntos?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"se",id=1,file="se1437"},
{"fg",mode=-2},
{"ex",time=0,func="wait"},
{"fg",ch="優美",size="z2",my=40,mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0100",face="a0005",head="yum_z2a",lv=5,id=6},
{"fgact",ch="優美",act="うんうん",lv=5,id=6},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡GYAAH! ¡Kawachino! ¡¿Por qué me pisoteas el pie?!”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2b0110",face="b0003",head="yum_z2b",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2b0110",face="b0004",head="yum_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000229",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, lo siento. Fue a propósito.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Pero es que ni siquiera tienes ganas de dar una excusa?!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"se",stop=1,time=500,id=1},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000230",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Dejando eso a un lado, Rina irá conmigo ahora a participar en las actividades\nde club.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Al club? Ah, claro, tienen que ir al club de arte.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000231",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Así es! ¡Y por ende, Kusanagi-senpai, no eres miembro del club, así que vete\nde una buena vez!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que lo digas de manera tan intimidante...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Actividades de club...",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, aún estaba a mitad de enseñarle a pintar a Rin.\nYa debería estar por terminar esa pintura...",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"En fin, tan pronto termine con este asuntillo, supongo que me pasaré por el\nclub de arte...",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tan pronto mate este asuntillo, me pasaré por el club de arte.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000232",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué?...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya la pintura con la que he estado ayudando a Rin debe estar por terminarse.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="里奈",size="z1",mx=-40,mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x2=0,x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000214",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tienes razón. Ya la pintura de Rin-senpai debería estar lista pronto.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000233",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo, ¿eso quiere decir que no te saltarás ese asuntillo?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los asuntillos también son importantes.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0004",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000215",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000234",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Pues, a mí me parece que te podrías ir solo tan pronto termines con tu\nasuntillo!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No trates con tanta crueldad a tu senpai.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0010",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000235",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jaa, ¿sí?... Qué lata.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"excall",file="02_abend_02_1",cond="f.rinroute==1"},
{"excall",file="02_abend_02_1",cond="f.makroute==1"},
{"excall",file="02_abend_02_1",cond="f.shzroute==1"},
{"excall",file="02_abend_ze01",cond="f.rnaroute==1"},
