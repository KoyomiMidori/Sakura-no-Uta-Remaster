astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"bg",file="ev_com_j09_01",path=":ev/ev_com_j09/",set="ev_com_j09"},
{"bgm",file="bgm110"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fridmann.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="man_frd_000383",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Qué pasa, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias, eh.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"bg",file="ev_com_j09_02",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
vo={
{"vo",file="man_frd_000384",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No necesitas agradecerme. Yo solo me muevo por dinero.\nCreo que ya te lo dije antes.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lograste conseguir dinero de esto?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="man_frd_000385",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No hace falta preocuparse por eso... Si bien no puedo dar un estimado\ninmediato, las ganancias serán altas...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Con esa obra? Claro que no, vamos.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="man_frd_000386",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Quién sabe?...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin también vino, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"bg",file="ev_com_j09_03",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
vo={
{"vo",file="man_frd_000387",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"bg",file="ev_com_j09_02",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
ja={
{
"Fridmann suelta una irónica sonrisa.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"bg",file="ev_com_j09_01",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
vo={
{"vo",file="man_frd_000388",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí. Dijo que quería ver tu obra.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi obra...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"bg",file="ev_com_j09_04",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fiuu... Entonces ya sabían que esa no es obra de Kenichiro.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_frd_000389",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Por supuesto. Yo soy el administrador de Kenichiro. Tengo además una copia de\nese plano en mi posesión.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"bg",file="ev_com_j09_05",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Pues entonces debo agradecerte aún más por cooperar con mi terrible\nactuación.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="man_frd_000390",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Ya te lo dije, no necesito agradecimientos. Actué sabiendo que eso se\ntraduciría en dinero.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"bg",file="ev_com_j09_01",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="man_frd_000391",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"bg",file="ev_com_j09_05",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no me gusta el arte, solo trabajo en esto porque da dinero. ¿Te he descrito\nbien?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"bg",file="ev_com_j09_06",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
vo={
{"vo",file="man_frd_000392",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Fufufu, sí.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mándale mis saludos a Rin. Y dile que aquí estoy...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"bg",file="ev_com_j09_07",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
vo={
{"vo",file="man_frd_000393",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Qué interés podría tener Rin por ti? Estando aquí, atrapado en estas tierras.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"bg",file="ev_com_j09_08",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees? A mi parecer, siempre es bueno tener a un conocido cerca al\nregresar.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sé que ha tenido éxito por todo el mundo. Pero no estaría mal que regrese de\nvez en cuando.Dile que le invitaré unas cervezas cuando vuelva.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="man_frd_000394",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Le haré llegar tu mensaje.Aunque probablemente su cara será de desagrado.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no. Seguramente se alegrará.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="man_frd_000395",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"bg",file="ev_com_j09_09",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
vo={
{"vo",file="man_frd_000396",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿De dónde venimos? ¿Quiénes somos? ¿Adónde vamos?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"bg",file="ev_com_j09_01",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así se llamaba la obra del hombre que murió en aquella lejana isla tropical.\nAh, no, era su firma...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="man_frd_000397",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“El pintor Paul Gauguin murió en tierras lejanas, sin regresar a su tierra natal\nde Francia.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con más razón.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="man_frd_000398",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Con más razón?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No quiero que Rin muera de esa forma. Gauguin fue un hombre infeliz.\nSe quedó sin un lugar a donde regresar, y por eso siguió huyendo de isla a isla.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese estilo de vida no combina con Rin.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La golondrina se fue a Egipto, pero algún día regresará.\nRegresará a estas tierras.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"bg",file="ev_com_j09_03",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
vo={
{"vo",file="man_frd_000399",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Eso no se lo comunicaré...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"bg",file="ev_com_j09_08",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué? Es lo que realmente pienso.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_frd_000400",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Si es lo que realmente piensas, entonces con más razón no podría decírselo.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"bg",file="ev_com_j09_10",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="man_frd_000401",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Preferiría no tener que volver de nuevo a estas lejanas tierras de Oriente.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bg",file="ev_com_j09_08",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué dices, Fridmann? Tú también deberías venir de vez en cuando.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"bg",file="ev_com_j09_11",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
vo={
{"vo",file="man_frd_000402",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Fuh... Padre e hijo,\nambos tan buenos en conquistar el corazón de los demás.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"bg",file="ev_com_j09_12",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me compares con ese idiota.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="man_frd_000403",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Seguramente Kenichiro diría lo mismo.\nNo me compares al idiota de Naoya, diría.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"bg",file="ev_com_j09_13",sync=0,face=1,time=400,path=":ev/ev_com_j09/",set="ev_com_j09"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nos estamos viendo, Fridmann.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="man_frd_000404",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí, algún día...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"msgoff"},
{"bg",file="eveningsky_winter",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Sonará obvio,\npero al parecer Fridmann había descubierto ya la verdad de mi plan.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Y por supuesto, Rin también...",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"¿Qué habrá sentido Rin al ver esa obra?",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bgm",stop=1,time=2000},
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="nightsky_winter",time=2000,sync=1,id=1,lv=5,path=":cg/"},
{"ex",time=1000,func="wait"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000372",ch="skr"},
{"vo",file="fem_rld_000164",ch="rld"},
{"vo",file="fem_snd_000119",ch="snd"},
{"vo",file="fem_ntd_000078",ch="ntd"},
},
ja={
{
name={"Todos"},
"“¡¡¡SALUD!!!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="奈津子",size="z1",mode=3,resize=1,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x=-680,lv=4,id=1,sync=0},
{"fg",ch="桜子",size="z1",mode=3,resize=1,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x=-210,lv=4,id=7,sync=0},
{"fg",ch="ルリヲ",size="z1",mode=3,resize=1,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=210,lv=4,id=8,sync=0},
{"fg",ch="鈴菜",size="z1",mode=3,resize=1,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=680,lv=4,id=2,sync=0},
{"extrans",time=500},
{"fgact",ch="ルリヲ",act="おじぎ",lv=4,id=8},
{"bgm",file="bgm006"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000165",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¡Ah, esto es para celebrar, sí! ¡Vamos, vamos, Kusanagi-chan, otra copa más!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni se atrevan a tocar el alcohol. De ninguna manera.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0021",head="rur_z1c",x=210,lv=4,id=8},
{"fgact",ch="ルリヲ",act="うんうん",time=300,lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rld_000166",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Tranquilo, tranquilo. Ya hicimos algo lo suficientemente peligroso. No vamos a\narriesgar nuestra admisión al colegio por eso.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0009",head="suz_z1c",x=680,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000120",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Realmente pasamos por tanto peligro? El hospital nos apoyó en todo lo\nnecesario.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, todo gracias a Toritani. Esta vez logramos completar la obra de manera\nlegal, sin romper ninguna ley o regla.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0003",head="sku_z1a",x=-210,lv=4,id=7},
{"fgact",ch="桜子",act="うなづく",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000373",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Fue divertido!”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0017",head="suz_z1c",x=680,lv=4,id=2},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000121",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Sí, pero ¿divertido?... En mi caso los nervios me estaban matando...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x=680,lv=4,id=2},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x=-210,lv=4,id=7},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=210,lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=210,lv=4,id=8},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_rld_000167",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Siempre estás pensando de más, Suzuna. Take it easy, señorita.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=210,lv=4,id=8},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",x=-680,lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000079",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Fue realmente asombroso que la proyección coincidiera tan bien con el mural.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ¿eso? Debo decir que fue pura casualidad.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",x=-210,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000374",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Pura casualidad?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Calculé hasta el más mínimo detalle, sí... Pero es muy raro que los valores\nteóricos y los prácticos coincidan. Y que haya funcionado tan bien con una\nelaboración de una noche es sorprendente.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0004",head="rur_z1c",x=210,lv=4,id=8},
{"fgact",ch="ルリヲ",act="いいえ",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rld_000168",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Uheeh, qué temerario eres, Kusanagi-chan.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=680,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000122",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Pero el diseño fue creado por Kenichiro Kusanagi-sama. En algún momento habrá\nexperimentado por su cuenta, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, sí...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="奈津子",mode=-1,lv=4,id=1},
{"fg",ch="ルリヲ",mode=-1,lv=4,id=8},
{"fg",ch="鈴菜",mode=-1,lv=4,id=2},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0011",head="sku_z1a",x=-210,lv=4,id=7},
{"fg",ch="桜子",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0011",head="sku_z1a",x2=-210,x=0,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000375",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“... Jummm. ¿Será eso cierto?...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0011",head="sku_z1b",x=0,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000376",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Nada de nada...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0009",head="sku_z1b",x=0,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000377",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Definitivamente usted no es de fiar, profesor...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000169",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Ah, ah, ¿qué sucede, Sakizaki-senpai? ¿Por qué está de mal humor?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0003h",head="sku_z1b",x=0,lv=4,id=7},
{"fgact",ch="桜子",act="うなづく",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000378",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No estoy de mal humor.\nSería absurdo ponerme de mal humor en medio de una celebración.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_rld_000170",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Bueno, qué importa. ¡A beber hoy se ha dicho!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sí, pero solo jugo para ustedes.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0011h",head="sku_z1b",x=0,lv=4,id=7},
{"fgact",ch="桜子",act="びっくり",size=5,lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_skr_000379",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pues, sí... *Hic*”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah! ¡Demonios, Ruriwo! ¡Le metiste alcohol a las bebidas, ¿verdad?!”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_rld_000171",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Un poco, solo un poquito.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_snd_000123",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Un poquito de alcohol sigue siendo alcohol.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_ntd_000080",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¿En serio? No me di cuenta...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0003h",head="sku_z1b",x=0,lv=4,id=7},
{"fgact",ch="桜子",act="いいえ",time=300,size=5,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000380",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Es sholo un poquito, no hay probrema! ¡Eshtoy, bien!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_rld_000172",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Oeh? Sakizaki-senpai, la veo un poco extraña~”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_snd_000124",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Todas nosotras parecemos estar bien, así que supongo que solo ella no es muy\nfuerte con el alcohol.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_ntd_000081",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Así parece. En mi caso he bebido bastante, pero estoy bien.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"mwact",act="いいえ"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Basta, basta! ¡Ruriwo, nada de darles alcohol!\nY deja de meter Smirnop, que es difícil de diferenciar del jugo...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fgact",ch="桜子",act="ジャンプ",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000381",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Sha le dije, que eshtoy bien!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, ¿qué parte de estar ebria se puede calificar de bien?...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0013h",head="sku_z1b",x=0,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000382",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Profesor...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué ocurre?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Sakizaki-kun se me queda viendo.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"msgoff"},
{"se",file="se9004",id=1},
{"fg",ch="桜子",time=500,sync=1,mode=-1,lv=4,id=7},
{"fg",ch="桜子",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/sku/z2/",file="sku_z2b0200",face="b0013h",head="sku_z2b",lv=5,id=7},
{"se",stop=1,time=500,id=1},
{"ex",time=500,func="wait"},
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0003h",head="sku_z2b",lv=5,id=7},
{"fgact",ch="桜子",act="うなづく",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000383",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Qué guapo es usted...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0003h",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000384",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Usted, es tan guapo...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ruriwo! ¡Sakizaki-kun está actuando de una manera muy rara!”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_rld_000173",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Sí? ¿Y qué problema hay? Tienes a una linda chica diciendo que eres guapo.\nVaya que no se te puede subestimar, Kusanagi-chan.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0003h",head="sku_z2a",lv=5,id=7},
{"fgact",ch="桜子",act="うなづく",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000385",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Cárgueme.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Me crees capaz de hacer eso?!”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fgact",ch="桜子",act="うなづく",lv=5,id=7},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_skr_000386",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“*Gyuh*...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡N-No me abraces!",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Sakizaki-kun abraza mi brazo. S-Sus pechos... Me están apretando bastante.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="奈津子",size="z2",mode=3,resize=1,path=":fg/nat/z2/",file="nat_z2b0200",face="b0002",head="nat_z2b",x=-345,lv=5,id=5},
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0002h",head="sku_z2a",lv=5,id=7},
{"fg",ch="奈津子",speed=150,mode=3,path=":fg/nat/z2/",file="nat_z2b0200",face="b0002",head="nat_z2b",y2="0,10",x=-345,y=0,lv=5,id=5},
{"fg",ch="桜子",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0002h",head="sku_z2a",x2=0,x=345,lv=5,id=7},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000082",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“... *Gyuh*”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera! ¡¿Por qué ahora tú también?!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="奈津子",size="z2",mode=3,path=":fg/nat/z2/",file="nat_z2b0200",face="b0004h",head="nat_z2b",x=-345,y=0,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000083",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“... *Pui*”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No vengas ahora a sonrojarte y bajar la mirada!”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Además, tú no estás ebria!”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_rld_000174",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Vaya vaya, qué afortunado, Kusanagi-chan.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_snd_000125",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Fuh... Qué situación tan caótica.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="奈津子",mode=-1,lv=5,id=5},
{"fg",ch="桜子",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0002h",head="sku_z2a",x2=345,x=0,lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000387",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Profesor...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0003h",head="sku_z2a",x=0,lv=5,id=7},
{"fgact",ch="桜子",act="うなづく",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000388",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Usted es tan guapo...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, ya entendí...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0001h",head="sku_z2a",x=0,lv=5,id=7},
{"fgact",ch="桜子",act="うなづく",lv=5,id=7},
{"se",file="se9031",id=1},
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eh--! ¡AUCH, AUCH, AUCH! ¡¿Q-Q-Qué estás haciendo?!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0005h",head="sku_z2a",x=0,lv=5,id=7},
{"fgact",ch="桜子",act="うなづく",lv=5,id=7},
{"se",file="se9031",id=1},
{"text"},
delay={
vl01={
{"fgact",ch="桜子",act="うんうん",lv=5,id=7},
{"se",file="se9031",id=2},
},
},
text={
vo={
{"vo",file="fem_skr_000389",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“*Hammm*, *hwam*, *hwam*, *hammm*...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué me muerdes?! ¡No me muerdas el brazo!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0009h",head="sku_z2a",x=0,lv=5,id=7},
{"fgact",ch="桜子",act="いいえ",size=3,lv=5,id=7},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0013h",head="sku_z2a",x=0,lv=5,id=7},
},
},
text={
vo={
{"vo",file="fem_skr_000390",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Lo vi muy alegre de que Natsuko lo abrazara... Así que decidí dejar mi marca de\nbeso.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Beso una mierda, estabas mordiéndome!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0008h",head="sku_z2a",x=0,lv=5,id=7},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0010h",head="sku_z2a",x=0,lv=5,id=7},
},
},
text={
vo={
{"vo",file="fem_skr_000391",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Mi instinto me dijo que alguien intentaría llevarse a este hombre tan guapo. Y\nde esa frustración, decidí dejar mi marca.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué demonios estás hablando? No estoy entendiendo absolutamente nada.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000175",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Si esto llega a descubrirse te despedirán, Kusanagi-chan.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Y-Y de quién crees que es la culpa?! ¡Diablos!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="奈津子",size="z1",mode=3,resize=1,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x=-570,lv=4,id=3},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",lv=4,id=8},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=570,lv=4,id=4},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000176",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Bueno, nosotras nos vamos ya.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000126",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Sakizaki-senpai se ha dormido, así que la dejaremos acá, aunque... ¿De verdad\npodemos confiar en usted?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto. Apenas despierte la llevaré a su casa.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0009",head="nat_z1a",x=-570,lv=4,id=3},
{"fgact",ch="奈津子",act="おじぎ",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000084",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Ah~, debí haberme emborrachado yo también.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0015",head="rur_z1c",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rld_000177",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Emborracharse con el grado alcohólico de esa bebida está difícil~”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0008",head="nat_z1a",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0009",head="nat_z1a",x=-570,lv=4,id=3},
{"fgact",ch="奈津子",act="おじぎ",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_ntd_000085",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Ciertamente... Uhhh, Sakizaki-san, qué envidia me das.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",lv=4,id=8},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0013",head="suz_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000127",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Tenga por seguro que si llega a cometer algún 'error', le informaré\ninmediatamente al colegio.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ya te, dije que, no voy a hacer, nada de eso!”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",lv=4,id=8},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",x=-570,lv=4,id=3},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0003",head="suz_z1c",x=570,lv=4,id=4},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=8},
{"fgact",ch="鈴菜",act="うなづく",lv=4,id=4},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_snd_000128",ch="snd"},
{"vo",file="fem_rld_000178",ch="rld"},
{"vo",file="fem_ntd_000086",ch="ntd"},
},
ja={
{
name={"Todas"},
"“Bueno, lo dejamos de momento. ¡Gracias por su tiempo!”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vayan con cuidado...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"msgoff"},
{"bg",file="nightsky_winter",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Voy a la entrada y despido a todas mis alumnas.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Todas, exceptuando una...",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, qué lata...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Diablos. Bueno, supongo que con que duerma unas horas se recuperará...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_skr_000392",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Profesor?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, Sakizaki-kun, ¿ya despertaste?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Sakizaki-kun intenta levantarse... pero entonces.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Wah!”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"cgact",stage="bg004",act="うなづく"},
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0008",head="sku_z2a",lv=5,id=7},
{"fgact",ch="桜子",act="うなづく",lv=5,id=7},
{"se",vol=50,id=1,file="se3356"},
{"text"},
text={
ja={
{
"Se tropezó. Y justo antes de que cayera al suelo, la sostengo.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ten cuidado. Descansa un poco más.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0008",head="sku_z2a",lv=5,id=7},
{"bgm",file="bgm043"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000393",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Profesor...\nEsa obra, no es de Kenichiro Kusanagi, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0010",head="sku_z2a",lv=5,id=7},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0001",head="sku_z2a",lv=5,id=7},
},
},
text={
vo={
{"vo",file="fem_skr_000394",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Esa obra no es de Kenichiro. Es de usted, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿C-Cómo?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0002",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000395",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Lo sé... Sé que esa no es obra suya...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0010",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000396",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Y sé que los demás saben también, por lo menos, que esa obra es suya...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya acusación que me haces, y sin prueba alguna. No sé cuántas veces lo he\ndicho ya, esa obra es de Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0002",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000397",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pruebas tengo. Le pregunté a Toritani-san si esa obra era realmente del señor\nKusanagi o no, antes de que regresara a Tokio.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué dijo?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0010",head="sku_z2a",lv=5,id=7},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0001",head="sku_z2a",lv=5,id=7},
},
},
text={
vo={
{"vo",file="fem_skr_000398",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“'Vaya, asombroso. Ni siquiera yo me di cuenta'...\n'Solo tú y Rin Misakura', dijo...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Rin y Toritani se vieron?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0010",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000399",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Al parecer estuvieron en la azotea, viendo el vitral de celofán...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Así que estuvo observando desde ahí...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0008",head="sku_z2a",lv=5,id=7},
{"fgact",ch="桜子",act="うなづく",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000400",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡No es justo! Esa obra es suya, ¿verdad?\nNo de Kenichiro Kusanagi, ni tampoco de Bourbagi.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0001",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000401",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Es su obra, obra de Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo es...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0008",head="sku_z2a",lv=5,id=7},
{"fgact",ch="桜子",act="うなづく",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000402",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Pues entonces--!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una vez dije lo mismo cuando tenía tu misma edad.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0001",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000403",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Justamente cuando terminamos de pintar 'Las huellas de los cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"msgoff"},
{"bg",file="bg059a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ante el público, esa obra quedó como mía, pero en realidad fue Akashi, un\nsenpai mío quien la planeó por varios años.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero por fuerza de varios intereses, la obra se publicó con mi nombre en ella.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En ese momento, Akashi dijo exactamente lo mismo que yo dije.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Con qué propósito nace una obra? ¿Con qué propósito creamos esa obra? Siempre\ny cuando no perdamos eso de vista, todo estará bien...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y eso es lo que siento yo en este momento. Siempre y cuando no pierda de vista\npor qué creamos esa obra, todo estará bien.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="桜子",size="z1",mode=3,resize=1,path=":fg/sku/z1/",file="sku_z1a0210",face="a0008",head="sku_z1a",lv=4,id=7,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_skr_000404",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Entonces, ¿qué razón hubo para la obra?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú también participaste en su elaboración, Sakizaki-kun. Debes saberlo muy bien\nya.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0001",head="sku_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000405",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Yo?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque fue divertido.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y porque además, quería dedicarle esa obra a alguien.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0010",head="sku_z1a",lv=4,id=7},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0008",head="sku_z1a",lv=4,id=7},
},
},
text={
vo={
{"vo",file="fem_skr_000406",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Dedicársela a alguien? ¿A quién?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quién será. Solo digamos que quería mostrarle a ese alguien lo divertido\nque fue crear la obra entre todos.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0010",head="sku_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000407",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Me parece que Rin Misakura vio la obra.\nO vino a verla, supongo...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así parece.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0008",head="sku_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000408",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Usted quería mostrarle eso a Rin Misakura?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién sabe? Podría decir que sí, pero también que no.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0001",head="sku_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000409",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Qué quiere decir con eso?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo más importante de esa obra es la 'diversión' que nació de ella.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo niego, quería que Rin sintiera la emoción que hay en esa obra.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ha estado tan ocupada viajando por el mundo que no debe tener tiempo para\ndivertirse...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero de la misma manera, también quería transmitirle eso a ustedes.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De la misma forma que tú percibiste diversión en 'Las huellas de los\ncerezos'...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y también a ese alguien que ni conozco, y que reside en la lejanía...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0010",head="sku_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000410",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“... No es justo.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es justo?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0008",head="sku_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000411",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Es tan injusto.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es injusto?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0001",head="sku_z1a",lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000412",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Profesor...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
delay={
[1000]={
{"fg",ch="桜子",size="z2",mode=3,resize=1,path=":fg/sku/z2/",file="sku_z2a0210",face="a0008",head="sku_z2a",lv=5,id=7},
{"fgact",ch="桜子",act="うなづく",lv=5,id=7},
{"quake",mode="mw"},
{"se",id=1,file="se3356",vol=50},
},
},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ah, ¿q-qué haces? ¿Sakizaki-kun? ¡Esp--, wah!”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Sakizaki-kun cae sobre mí.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿S-Sakizaki-kun?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_skr_000413",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Usted, siempre tan guapo y genial.\nEso es tan injusto...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no, ¿qué estás diciendo?...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0010",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000414b",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“El atletismo había sido mi única meta todo este tiempo...\nY cuando lo perdí, sentí que lo había perdido todo.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0009",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000415",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“La primera vez que lo vi a usted en la azotea, se me hizo muy similar a mí.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0008",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000416",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Alguien que había perdido algo. Alguien sin objetivos... Así lo vi a usted.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0010",head="sku_z2a",lv=5,id=7},
{"fgact",ch="桜子",act="うなづく",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000417",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Y por eso me interesó...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0008",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000418",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pero usted resultó ser completamente diferente a mí.\nUsted no había perdido nada...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fgact",ch="桜子",act="いいえ",size=5,lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000419",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No, eso es mentira. Usted seguramente ha perdido mucho más que yo.Mi dolor no\nse podría comparar al suyo.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me estás poniendo en un pedestal que no me corresponde... Solo soy un profesor\nflojo, nada más que eso...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0010",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000420",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No, sé muy bien de lo que hablo.\nY es que yo también he perdido bastante... Pero no al nivel de usted.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0008",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000421",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Y aun así, a usted no le faltaba nada.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0009",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000422",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“A pesar de todo lo que usted ha perdido... A usted no le faltaba nada como\npersona.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0010",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000423",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Estaba segura que usted era idéntico a mí, pero resultó ser todo lo contrario.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0008",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000424",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Eso no es justo, profesor... De seguir junto a usted, yo...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, espera un momento, Sakizaki-kun.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0010",head="sku_z2a",lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000425",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ahora que he visto cómo realmente es usted, yo...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera, espera! ¡Hay muchos malentendidos en esto! ¡No apresures las\ndecisiones, Sakizaki-kun!\n¡Además, yo no soy ningún santo! N-No creo que pueda ser capaz de permanecer con la cabeza fría en esta...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fgact",ch="桜子",act="おじぎ",size=3,lv=5,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000426",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh. ¿Sakizaki-kun?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="桜子",my=40,mode=-1,lv=5,id=7},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_skr_000427",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“ZZZ......”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿S-Se durmió?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Fiuu, estuvo cerca.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás dormida, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Q-Qué bueno... Para ser honesto, no sabía si podría controlarme.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si no se hubiese dormido le hubiese hecho algo, estoy seguro...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso estuvo cerca, muy cerca...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Observo a Sakizaki-kun.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Su falda está algo levantada.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Se la arreglo, procurando no ver.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"No lo puedo negar, tiene una cara hermosa...",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Y tampoco puedo negar que podría masturbarme solo con esa cara.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me podrían arrestar si llego a eyacular sobre su cara?”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué cosas digo? Eso es un crimen, claro que lo es.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mejor voy al baño y me descargo allá. De seguir en este estado podría terminar\nponiéndole las manos encima.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg002c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Corro hacia el baño.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"se",id=1,file="gatya"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fiuu... Hora de masturb--”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"msgoff"},
{"se",file="se9010",id=1},
{"fg",ch="桜子",size="z1",sync=1,mx=-40,mode=3,resize=1,path=":fg/sku/z1/",file="sku_z1a0210",face="a0009",head="sku_z1a",x=-345,lv=4,id=5},
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Je?”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0005",head="sku_z1b",x=-345,lv=4,id=5},
{"fgact",ch="桜子",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000428",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿--?!”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué haces--?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0004",head="sku_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="桜子",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_skr_000429",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“T-Tengo ganas de vomitar... ¡Hágase a un lado, por favor!”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"se",file="se9023",vol=50,id=1},
{"fg",ch="桜子",speed=1000,mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0004",head="sku_z1b",x2=-345,x=345,lv=4,id=5},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0005h",head="sku_z1a",lv=4,id=5},
{"fgact",ch="桜子",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000430",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿Qué se supone que estaba haciendo en el baño?!”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡N-No es lo que crees, solo vine a orinar!”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0012h",head="sku_z1a",lv=4,id=5},
{"fgact",ch="桜子",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000431",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿Y-Y cómo iba a entrar algo tan grande en la taza del inodoro?!”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡E-Es, es que!”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0011h",head="sku_z1a",lv=4,id=5},
{"text"},
text={
ja={
{
"No, creo que es mejor no salir con excusas.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"Es mi responsabilidad. Aun si se enfada y me despiden, no hay nada que pueda\nhacer.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Unuh... La verdad, es que...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"bgm",stop=1,time=1000},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Sakizaki-kun escuchó toda mi explicación con inesperada calma.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"Sin fruncir el ceño ni enfadarse. Fríamente...",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"msgoff"},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0002",head="sku_z1a",lv=4,id=5,sync=0},
{"extrans",time=500},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000432",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Agradezco su honestidad conmigo.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0009h",head="sku_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000433",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No, también es mi culpa. Por embriagarme y hacer esas cosas...”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te equivocas, es por mi culpa que terminaste tragando alcohol.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0005",head="sku_z1b",lv=4,id=5},
{"fgact",ch="桜子",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000434",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No, más bien fue usted quien intentó que no me dieran licor...”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0011",head="sku_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000435",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“P-Por otro lado...”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0008h",head="sku_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000436",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No me imaginaba... que usted también pudiera verme con esos ojos.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, sí...”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0009h",head="sku_z1b",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002h",head="sku_z1b",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_skr_000437",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿S-Será que, digo, solo como posibilidad, que... que, usted tiene sentimientos\nrománticos por mí, y eso hizo que, que se 'levantara'?”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no. Para los hombres la lujuria y el amor son dos cosas distintas.\nSimplemente me calenté, no te preocupes.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"bgm",stop=1,time=1000},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0005",head="sku_z1a",lv=4,id=5},
{"fgact",ch="桜子",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000438",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Ngh!”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="桜子",size="z2",mode=3,resize=1,path=":fg/sku/z2/",file="sku_z2a0200",face="a0005",head="sku_z2a",lv=5,id=5},
{"fgact",ch="桜子",act="うなづく",lv=5,id=5},
{"se",id=1,file="se2023"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Gwoh!”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"Por alguna razón me pateó los testículos.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"msgoff"},
{"fg",mode=-2},
{"bg",file="nightsky_winter",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Un rato después escolté a Sakizaki-kun de vuelta a su casa.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"La borrachera se le había pasado, y había vuelto a su estado normal.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"Caminamos junto en la oscuridad de la ciudad, ambos más silenciosos que de\ncostumbre.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
