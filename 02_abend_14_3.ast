astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",time=2000,file="bg061a",path=":bg/"},
{"bgm",file="bgm009"},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=-570,lv=4,id=3,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=0,lv=4,id=9,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=570,lv=4,id=4,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rna_000355",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué tan distraído?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es nada...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=570,lv=4,id=4},
{"fgact",ch="稟",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000964",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vamos, ya falta poco para terminar de limpiar.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0015",head="rna_z1b",x=-570,lv=4,id=3},
{"fgact",ch="里奈",act="ジャンプ",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rna_000356",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fuiii. Qué calor hizo. Tanto que quisiera darme un chapuzón de agua.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=570,lv=4,id=4},
{"fgact",ch="稟",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000965",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo también quisiera hacerlo...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=570,lv=4,id=4},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0010",head="yum_z1a",x=0,lv=4,id=9},
{"fgact",ch="優美",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000745",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aún después de haber comprado los trajes de baño, no los hemos usado aún.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podrían limpiar entonces en traje de baño, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=0,lv=4,id=9},
{"fgact",ch="優美",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000746",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Sukatan!”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"se",id=1,file="se1528"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Auch!”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0018",head="yum_z1a",x=0,lv=4,id=9},
{"fgact",ch="優美",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_yum_000747",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Por qué tenemos que usar nuestros trajes de baño recién comprados para\nlimpiar una piscina?! ¡Y además, en primer lugar, la razón por la cual no\npudimos usarlos es porque--”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, está bien. Lo siento, lo siento...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="里奈",mode=-1,lv=4,id=3},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001485",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por cierto, parece que hoy habrá una exhibición de fuegos artificiales.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Exhibición de fuegos artificiales?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fgact",ch="稟",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000966",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Al parecer la harán en el Parque Costero.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0003",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001486",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Lo sabías ya? ¿Sabes si se pueden ver bien desde acá?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000748",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿Acá se pueden ver los fuegos artificiales?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001487",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso es porque el colegio Yumihari está construido sobre una colina. Dicen por\nahí que desde este lugar en particular se pueden contemplar con bastante\ndetalle.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_rna_000357",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es increíble que te hayas enterado de eso. ¿Es verdad?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001488",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Akashi-senpai me lo contó, así que debe ser verdad, ¿no? Pues parece que llegó\na infiltrarse de noche en el colegio muchísimas veces para completar la\nreforma de la iglesia.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, ¿dónde anda Akashi?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_rnd_000967",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Akashi-senpai? Estaba estudiando algo.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estudiando?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"¿Aún a este punto está pensando avanzar hacia la universidad?",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Y esperen un momento, aun cuando nosotros también tenemos exámenes de ingreso\ndentro de unos meses, ¿por qué él es el único que puede estudiar ahora\nmientras nosotros estamos obligados a hacer esto?",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué estamos nosotros limpiando acá mientras él está estudiando? ¡Se supone\nque somos nosotros los que más necesitamos estudiar! ¡¿No?!”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Y la verdad es que yo no debería estar haciendo esto ahora, yo debería estar\ntrasnochándome estudiando!”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001489",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Pero qué estás diciendo? Nadie que haya procurado estudiar un poco cada día\ndesde el primer año podría decir eso.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, tal vez, pero... En primer lugar, ¿cuántas horas para ti significa ese\n'poco'?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001490",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues comenzando desde primer año, serían más o menos 3 horas diarias, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Tres horas diarias...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Ese es mi tiempo de estudio diario en este momento...",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Ciertamente, si se estudian 3 horas diarias desde el primer año, entonces\nquizás no sea necesario estudiar para los exámenes de ingreso...",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001491",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tienes 24 horas en el día, tómate por lo menos 3 para estudiar. Igual te\nquedarán otras 21.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero tengo que venir al colegio, y además tengo que dormir...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001492",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es, también es necesario dormir bien. Por eso es que no es efectivo tratar\nde estudiar todo de una sola vez. ¿Es que acaso no lo sabías?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir? No es que no lo sepa, es que simplemente no entiendo lo que\ndices.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001493",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Un tiempo de sueño adecuado es necesario para fortalecer y mantener lo\naprendido. ¿Es que acaso tampoco sabes eso?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, creo que normalmente nadie sabría eso...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001494",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entonces apréndetelo desde ya. Lo más ineficaz que puede haber es 'trasnocharse\nestudiando', y además, tratar de lidiar con varias materias de forma alterna.\nSi quieres mejorar tu eficacia estudiando, entonces concéntrate en la misma\nmateria todo el día y duerme bien. Esto es muy importante.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“J-Jaa...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001495",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso es que en el caso de exámenes con muchas materias, es difícil ver\nbuenos resultados si no estudias poco a poco con bastante tiempo de\nantelación. ¿No eres tú uno de los que se la pasa estudiando toda la noche\nantes de los exámenes siempre?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, con mucha frecuencia...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0015",head="mak_z1a",lv=4,id=3},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001496",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso está completamente mal. Un buen sueño es necesario para la memoria, así que\nsuponiendo que quieras aprender algo en un corto tiempo, entonces debes\nestudiar una sola materia, tomar algo de sueño MOR y no MOR, despertar y\npasar a otra materia, y así.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“U-Uhh... Sabes bastante...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001497",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es una forma para optimizar la eficacia al estudiar. No está mal saberlo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no sé muy bien, pero creo que tienes razón... lo siento...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"No entendí del todo bien, pero fue todo tan correcto lo que dijo que\nsimplemente no puedo replicar nada.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x2=0,x=-345,lv=4,id=3},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, ¿tú también estudias la misma cantidad de tiempo?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000968",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no, en mi caso no estudié tanto durante el primer año.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“M-Me lo imagino. ¿Qué tanto has estudiado?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000969",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿E-En horas?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, dime cuantas horas verdaderamente estudias.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000970",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, veamos. Creo que 2 horas diarias, cuando estaba en primer año. En segundo\naño superé un poco a Toritani-san y estudiaba 4 horas, y ahora tengo como\nestándar 6 horas diarias...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera un momento! ¿Pero qué tanto estudian todas ustedes? ¿Y en qué momento\nduermes estudiando 6 horas diarias?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000971",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? No tengo problemas para dormir... Por lo general llego un poco antes de\nlas 6 a mi casa, ceno, me baño... y duermo a eso de las 2 AM, más o menos.\nAunque, muy a menudo suelo llegar tarde a casa por el club u otras cosas, así\nque hay veces en las que solo duermo 4 horas.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿C-Casi que estudiar nada más después de regresar a casa?...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001498",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso es increíble. Yo no puedo estudiar 6 horas en un día a menos que sea un día\nlibre. Ya veo el porqué de la diferencia entre nuestras calificaciones...\nTambién estudias los días libres, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000972",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no, de verdad no estudio nada esos días.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Lo dijo. Lo acaba de decir. La técnica mortal, 'de verdad no estudio nada'.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"De ninguna forma alguien que se la pasa estudiando 6 horas diarias los días de\nla semana va a dejar de estudiar los días libres.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Y además, ¿qué demonios tienen en la cabeza estudiando tanto desde primer año?\n¡Normalmente el tiempo se te va en el trabajo de medio tiempo y saliendo por\nahí, no debería quedar nada de holgura para estudiar!",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"No puedo con esto... ¿He estado todo este tiempo pasando el tiempo y bromeando\ncon estas personas tan dedicadas y diligentes?...",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Si yo cuando regreso a casa, preparo la comida, ceno y me pongo en la\ncomputadora se me hacen las 2 o 3 AM en un abrir y cerrar de ojos...",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"No estudio bajo ningún modo a menos que tenga un examen acercándose...",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"O más bien, ni siquiera en mi primer o segundo año estudiaba para los\nexámenes...",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La hormiga y el saltamontes, eh...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0010",head="mak_z1d",x=-345,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0017",head="mak_z1d",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001499",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El saltamontes estaba ocupado con sus actividades artísticas, ¿no? ¿Qué\nestuviste haciendo tú?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento... Me he ocupado principalmente en navegar la red y jugar... Incluso\nme he metido en juegos sociales. Lo único de lo que me puedo enorgullecer es\nde como hago abdominales y las lagartijas.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001500",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Entrenas? ¿Por qué no vas a una universidad deportiva entonces?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi record académico durante toda mi vida estudiantil no me permite obtener\nninguna carta de recomendación... y probablemente, no logre mejorar ese\nrecord...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=-345,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001501",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahora que lo recuerdo, Kusanagi, aparte del club de arte, muchos otros clubes\nde deportes te invitaron también a entrar, ¿no? Tienes buen físico, además.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me encanta entrenar, pero realmente me incomodan las relaciones\njerárquicas, así que si llegara a ir a un club deportivo probablemente los\nsenpai me maten. Me encanta el mundo sin jerarquía.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x2=-345,x=-570,lv=4,id=3},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x2=345,x=0,lv=4,id=6},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0017",head="rna_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rna_000358",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esas son las palabras de un total inadaptado social...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad es que eso me tiene en aprietos.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pero en fin, eso da igual! ¡No puedo permitir que le eximan nada más a Akashi\nla labor de limpiar esta piscina y que estudie mientras tanto! ¡Voy a\nquebrarlo!”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0017",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001502",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Muchacho... ¿Es que acaso no puedes pensar en otra cosa que no sea jalarle los\npies a los demás?...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000973",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Akashi-senpai ya se graduó, así que no es raro que lo eximan de la limpieza de\nla piscina.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, si él está participando en el campamento también, entonces también debe\nlimpiar la piscina! ¡¿Es que acaso limpiar la piscina no era la condición\npara poder participar en el campamento?!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=570,lv=4,id=4},
{"fgact",ch="里奈",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rna_000359",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y por eso mismo Akashi-senpai no participará en el campamento, ¿no? Parece que\nregresará a su casa al atardecer.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eso no tiene nada que ver! ¡Es ilógico y absurdo permitir eso cuando en mi\ncaso estoy participando de forma obligada!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",x=-570,lv=4,id=3},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001503",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque no creo que te sirva de nada tratar de interrumpirle su estudio...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",file="se1279",id=1},
{"bg",rule=139,vague=40,file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm012"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Akashi, ¿estás ahí?!”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000578",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Vaya~, pero si es el burrito Kusanagi-kun~”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué dices~? Ni creas que te voy a perdonar por engañarme y ponerte a estudiar.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0010",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000749",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Esta es la peor jalada mutua de pies que puede haber... Absolutamente nadie\ndebe terminar así.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000360",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues sí, por cosa extraña no tengo objeciones con lo que dices esta vez, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0007",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000579",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Wah, n-no me interrumpas. Estoy tratando de estudiar~”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No avances con los estudios mientras yo ando limpiando la piscina. Ven tú\ntambién a ayudar, bastardo.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000580",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eso no me incumbe a mí, ¡no me incumbe!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000974",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Y qué materias estás estudiando ahora?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000581",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No es realmente ninguna materia, estudio para obtener un certificado\nprofesional. En esta época los certificados son más importantes que el\ncolegio~ Los certificados son esenciales.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dices... certificados... profesionales?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Esas palabras son muy, pero muy ciertas y lógicas como para venir de este tipo.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Ciertamente, los certificados valen. Es mucho mejor tenerlos a que no.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=-300,file="zbg049a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",x=500,lv=5,id=6,sync=0},
{"extrans",time=500},
{"fgact",ch="稟",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000975",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Je~, ¿certificados? ¿Qué clase de cosas se estudian para obtener un\ncertificado?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="明石",size="z2",mx=-40,mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2a0000",face="a0002",head="aka_z2a",x=-500,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000582",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Esto.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"se",file="se9010",vol=60,id=1},
{"fg",ch="稟",speed=500,mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",x2=500,x=345,lv=5,id=6},
{"text"},
text={
ja={
{
"Rin le da un vistazo al contenido de estudio de Akashi con una suave sonrisa en\nsu cara. Y su sonrisa se congela a los pocos segundos.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",x=345,lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",x=345,lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000976",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Ehm... esto es...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué diablos estás estudiando?! ¡Te conozco muy bien, seguramente encontraste\nuna especie de cosa secreta o algún truco! ¡Muéstrame!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"se",file="se3130",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"quake"},
{"extrans",time=200},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000583",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“N-N-No te robes mi libro de texto, nya~”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, veamos... ve, a... mos.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"En el libro que le había arrebatado a Akashi, estaba escrito lo siguiente.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"'La libreta asesina'",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La libreta asesina?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_rna_000361",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uwa... pero ¿qué clase de materia es esta?... ¿En qué materia de qué\ndepartamento estudian esto?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000584",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya les dije que no es ningún departamento, es para un certificado profesional.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué licencia se supone que necesitas para 'la libreta asesina'?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000585",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Una licencia para matar.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Una licencia para matar'. No me jodas.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000586",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Dentro de las asignaturas obligatorias está también la 'Libreta del amor'~. Y\nes que la 'Licencia del amor' también es necesaria para la 'Licencia para\nmatar'~”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh, ya veo. Qué bien. Qué bien, eh~”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",mode=-2},
{"bgm",stop=1,time=1000},
{"se",file="se3214",id=1},
{"text"},
text={
ja={
{
"Suelto un suspiro y me siento sobre la silla.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"bgm",file="bgm011"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000362",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pareces estar muy, pero muy aliviado ahora.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001504",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Que Akashi-senpai no esté estudiando de verdad no significa que tú tampoco\ndebas estudiar.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí, sí. Lo haré. ¡A partir de mañana!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0017",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000363",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esa es la frase típica de una persona inútil...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tiene nada de inútil siempre y cuando comience mañana, ¿no? Además, hoy me\nobligaron a limpiar la piscina bajo este inclemente sol. Y para agregar aún\nmás, me pondrán a cocinar ahora. ¿Crees que puedo estudiar así?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000977",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No te preocupes. Lo harás. Haré que lo hagas.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Rin, esa sonrisa da miedo...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000978",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero no puedes seguir así, Kusanagi-kun. Realmente terminarás mal.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001505",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Después de todo seguramente estás pensando 'no importa que no ingrese a la\nuniversidad este año' o algo así, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. No tengo nada de dinero. Si no ingreso en mi primer\nintento entraré en bancarrota.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0017",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001506",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Entonces por qué te la pasas de ocioso?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Es que acaso tú no has tonteado y bromeado con nosotros también todo este\ntiempo?!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001507",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero yo sí estuve estudiando.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Yo no...",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000979",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque, Kusanagi-kun, tus calificaciones en tus asignaturas fuertes son altas,\nasí que de poder elegir las asignaturas a presentar quizás puedas lograrlo.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001508",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, ¿les parece si estudiamos todos después de comer?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_rna_000364",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Nosotras también?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001509",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De ninguna manera, solo los de tercer año. Ustedes pueden ir a divertirse, si\nquieren.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vamos a estudiar?...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001510",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque bueno, igual pondré un momento de descanso en el intermedio.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un momento de descanso en el intermedio?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fgact",ch="真琴",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001511",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo hablaba sola. Bien, a preparar rápido la comida. Comeremos a las 5, ¿bien?\nAsí que hay que tener listo todo para las 5.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es demasiado pronto. Ni siquiera es la hora del atardecer.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001512",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Yo nunca ceno. En fin, pase lo que pase, nunca meto comida en mi boca 6 horas\nantes de dormir o menos.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001513",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, a cocinar.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, ¿qué se va a preparar? A juzgar por los ingredientes que hay acá, ¿el\ntípico curry?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001514",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, por si no te das cuenta también se puede preparar nikujaga, y también un\nestofado de res.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo rayos se va a preparar nikujaga y estofado de res con pollo?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001515",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pensé que de tratarse de ti podrías hacer algo al respecto, Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo voy a preparar eso con pollo? Se necesita carne de res, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001516",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Puedes ir al supermercado más cercano.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Vas a hacerme ir a comprar también?!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué ridiculez. ¡Bien, vamos a preparar curry! Por Dios, 'estudia', 'anda a\ncomprar', pero qué absurdo todo...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000980",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Curry... El curry es difícil de preparar.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001517",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿El curry es difícil de preparar?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000981",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, es bastante difícil freír la harina de trigo sin quemarla. La harina se\nquema muy fácilmente.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001518",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Harina de trigo? ¿Eh? ¿No es cebolla?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota, ¿cómo vas a preparar curry a partir de salsa marrón?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001519",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué es eso?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La salsa marrón se hace salteando harina de trigo y mantequilla. Aquellos que\nfabrican su propio polvo de curry suelen usarla.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001520",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿El polvo de curry se puede fabricar?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, de hacerlo se puede ajustar el sabor fácilmente al gusto de uno, así que\nvarias personas lo hacen. Aunque bueno, no es más que una especie de\npasatiempo.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000982",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque los condimentos son recién molidos, así que despide un aroma muy\ngustoso.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001521",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Je, prepara eso.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000983",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, no, no! ¡No vamos a hacer algo tan tedioso como eso! En primer lugar, ¿de\ndónde vamos a sacar los condimentos?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=-570,lv=4,id=3},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x2=-345,x=0,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x2=345,x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000995",ch="ked"},
},
ja={
{
name={"Kei"},
"“Puedo darme una vuelta con la moto e ir por ellos.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=570,lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001522",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, si Kei va en su motocicleta se conseguirán rápido, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh, vamos, por favor. Eso es terriblemente fastidioso.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000984",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vamos, no hay problema. Yo me encargaré de preparar el polvo de curry.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, yo me encargaré de eso.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000985",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? No hay problema, yo puedo hacerlo...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, tú encárgate de saltear las cebollas.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000986",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Pero acabas de decir que te daba fastidiooo!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001523",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. ¿Por qué dices eso ahora después de haber puesto esa cara de tanto\ntedio?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000987",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, respecto a eso, preparar el polvo de curry implica básicamente preparar el\ncurry al gusto propio de uno, así que las personas que lo han hecho antes\nsiempre buscan prepararlo por su cuenta.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los polvos de curry comerciales son buenos, sí, pero es un curry normal\najustado al paladar de todos. El curry casero, ajustado al paladar individual\nes un tanto diferente.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001524",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Je, en pocas palabras, tanto Rin-chan como Kusanagi terminarían preparando\nalgo distinto.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000988",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, eso es lo que implica.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001525",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué no preparar dos curry distintos entonces?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000989",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Una competencia de cocina, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-570,lv=4,id=3},
{"fgact",ch="圭",act="うなづく",lv=4,id=3},
},
},
text={
vo={
{"vo",file="man_ked_000996",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ohh, eso enciende las cosas.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no, no le llego ni a los pies a Rin... Bien, Kei, esta es la lista de\ncondimentos que quiero que compres...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000990",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Eh! ¡¿En verdad quieres competir?!”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="02_abend_14_4"},
{"text"},
linkback="block_00178",
},
label = {
top={block="block_00000",label=1},
},
}
