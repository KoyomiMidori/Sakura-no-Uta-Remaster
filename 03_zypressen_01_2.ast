astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="bluesky_winter",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"bgm",file="bgm017"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000920",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Qué buen clima hace hoy también.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_rna_001262",ch="rna"},
},
ja={
{
name={"Rina"},
"“Un buen clima es lo mejor para pintar paisajes.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_yum_000921",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Pero no es bueno que te expongas mucho a la luz solar, Rina. Debes permanecer\nen un lugar con sombra.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_rna_001263",ch="rna"},
},
ja={
{
name={"Rina"},
"No tienes por qué preocuparte tanto, yo misma conozco muy bien mi propio\ncuerpo. No pasa nada.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000922",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Bueno...",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000923",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Pero ¿por qué elegiste el paisaje que se ve desde la azotea como imagen para tu\npintura?",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_rna_001264",ch="rna"},
},
ja={
{
name={"Rina"},
"Ya que has estado viendo lo que he estado pintando deberías tener ya una idea\ndel porqué, ¿no?",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000924",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Me cuesta ver bien lo que es solo viendo el bosquejo.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_rna_001265",ch="rna"},
},
ja={
{
name={"Rina"},
"De aquí se puede ver cómo los bosques de cipreses y cerezos se solapan.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0013",head="yum_z1b",lv=4,id=9},
{"fgact",ch="優美",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000925",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Ah, sí, ahora que lo mencionas...",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_rna_001266",ch="rna"},
},
ja={
{
name={"Rina"},
"Todavía estamos en verano, así que no hay forma de verlo. Pero, cuando llega la\nprimavera y los cerezos florecen se puede ver el negro de los cipreses entre\nel bosque de cerezos.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001267",ch="rna"},
},
ja={
{
name={"Rina"},
"Apenas llegó la primavera vine acá a la azotea y tomé una fotografía.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000926",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¿Una fotografía?",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_rna_001268",ch="rna"},
},
ja={
{
name={"Rina"},
"Sí. Seguiré pintando los cerezos y cipreses que se ven desde acá en estos tres\naños que permaneceré en este colegio.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000927",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Ya veo...",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_rna_001269",ch="rna"},
},
ja={
{
name={"Rina"},
"Y por eso no tengo mucho interés en la Exposición Moore, la verdad. En especial\neste año...",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_rna_001270",ch="rna"},
},
ja={
{
name={"Rina"},
"Además, el único paisaje de cerezos florecidos que tengo ahora es en\nfotografía.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000928",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¿No estás segura de poder pintar algo bueno para este año?",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_rna_001271",ch="rna"},
},
ja={
{
name={"Rina"},
"Más que segura o no de eso, me conformaría con pintar algo que yo misma\nconsidere como bueno. Aunque sí, el año que viene quisiera pintar los cerezos\ny los cipreses en primavera, presenciándolos en vivo.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000929",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¿Aún te gustan los cipreses, Rina?",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="fem_rna_001272",ch="rna"},
},
ja={
{
name={"Rina"},
"Me gustan. Pero, ahora me gustan los cerezos también.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000930",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Ya veo...",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_rna_001273",ch="rna"},
},
ja={
{
name={"Rina"},
"Bien, ¿comenzamos a pintar ya?",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000931",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Hay que preparar los instrumentos primero...",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Comenzamos a preparar todo para pintar.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000932",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Por cierto, ¿tuviste algún sueño ayer?",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_rna_001274",ch="rna"},
},
ja={
{
name={"Rina"},
"Sí, creo.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0011",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000933",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¿No lo recuerdas?",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"bgm",stop=1,time=2000},
{"text"},
text={
vo={
{"vo",file="fem_rna_001275",ch="rna"},
},
ja={
{
name={"Rina"},
"Pues... de que lo recuerdo, lo recuerdo... pero...",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Titubeo.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Para ser del todo sincera, sí lo recuerdo todo.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Y con lujo de detalles. Casi como si yo misma lo hubiera vivido.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"¿Qué habrá sido ese sueño...?",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg064c",path=":bg/",sync=0},
{"bg",id=12,lv=12,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=2000},
{"fg",ch="義貞",size="z1",mode=3,resize=1,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",lv=4,id=9},
{"bgm",file="bgm025"},
{"text"},
text={
vo={
{"vo",file="man_yod_000045",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Así que accedió a venir usted por mí.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_had_000014",ch="had"},
},
ja={
{
name={"Hakuki"},
"La carta decía 'Quisiera encontrarme con usted esta noche en la colina de los\ncerezos muertos', así que vine tal como se me fue indicado.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0002",head="yos_z1a",lv=4,id=9},
{"fgact",ch="義貞",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000046",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Jajaja, ¿tal como se lo indiqué? Eso se escucha muy a usted.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_had_000015",ch="had"},
},
ja={
{
name={"Hakuki"},
"¿Muy a mí?",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000047",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Solo divagaciones mías, olvide lo que dije. Por cierto, todos los árboles de\ncerezos de este lugar son viejos, y ya no florecen. Eso ha llevado a que\ntodos le teman a esta colina, y por eso nunca se acercan acá en las noches.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_had_000016",ch="had"},
},
ja={
{
name={"Hakuki"},
"¿Cómo le llaman a esta colina?",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000048",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"No tiene nombre alguno. Simplemente una colina de árboles muertos.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000049",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Es el lugar ideal para encontrarnos sin que nadie nos vea--",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",lv=4,id=9},
{"fgact",ch="義貞",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000050",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"No, creo que antes de hablar de esto debí haberle agradecido en primer lugar.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_had_000017",ch="had"},
},
ja={
{
name={"Hakuki"},
"¿Agradecerme?",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",lv=4,id=9},
{"fgact",ch="義貞",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000051",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Sí. Le agradezco profundamente por haber acabado con las pesadillas de mi\npadre.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_had_000018",ch="had"},
},
ja={
{
name={"Hakuki"},
"Ese es el deber de Hakuki.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000052",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"No diga eso, por favor. Déjeme por lo menos expresar mi gratitud por usted.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_had_000019",ch="had"},
},
ja={
{
name={"Hakuki"},
"......",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000053",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Aunque, debo admitir que no pensé que vendría.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_had_000020",ch="had"},
},
ja={
{
name={"Hakuki"},
"¿Por qué?",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000054",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Pues, no creí haberle dado una muy buena impresión aquel primer día que nos\nvimos.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_had_000021",ch="had"},
},
ja={
{
name={"Hakuki"},
"Hakuki no posee sentimientos.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000055",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Claro, lo había olvidado. ¿Y por eso usted dice que no tuvo ninguna impresión\nen particular en aquel momento?",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_had_000022",ch="had"},
},
ja={
{
name={"Hakuki"},
"Sí.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000056",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"En lo que a eso respecta, aún no soy capaz de creerlo... De que dentro de usted\nno hay ninguna clase de sentimiento...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000057",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Ahora que lo recuerdo, me han contado que la sacerdotisa de Yumehari tiene\nprohibido hablar, ver y escuchar. Sin embargo, usted me habló, me vio y me\nescuchó.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_had_000023",ch="had"},
},
ja={
{
name={"Hakuki"},
"......",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000058",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Eso implica que usted rompió con todos los vetos impuestos sobre usted,\nHakuki-dono. ¿Por qué usted, que alma ni sentimientos posee, incurrió en\nsemejante acto?",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_had_000024",ch="had"},
},
ja={
{
name={"Hakuki"},
"No lo sé...",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0005",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000059",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"¿No lo sabe?",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_had_000025",ch="had"},
},
ja={
{
name={"Hakuki"},
"No...",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"No sé.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Realmente no lo sé.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"¿Por qué abrí los ojos aquel día?",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"¿Por qué le presté atención a sus palabras en aquel momento?",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"¿Por qué hablé con él?",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"¿Y por qué estoy ahora acá, en este lugar?",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_had_000026",ch="had"},
},
ja={
{
name={"Hakuki"},
"No lo sé...",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"En el instante en que lo imaginé a él parado solo, debajo de ese árbol muerto,\nen medio de esta desolada colina donde absolutamente nada florece...",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Mis piernas se movieron, y me llevaron caminando a ella.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"¿Por qué cometí semejante locura?",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000060",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Por mi culpa usted rompió su veto, Hakuki-dono.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000061",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Pero, no tengo intención de disculparme por eso.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",lv=4,id=9},
{"fgact",ch="義貞",act="うなづく",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000062",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Me siento alegre de poder estar así con usted, ahora. Por eso mismo no puedo\ndisculparme.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_had_000027",ch="had"},
},
ja={
{
name={"Hakuki"},
"Estar conmigo... te alegra...",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"'Alegría'.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Pensé que sus sentimientos habían entrado dentro de mí.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Eso pensé. Pero...",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_had_000028",ch="had"},
},
ja={
{
name={"Hakuki"},
"Ngh.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Sentí una punzada en lo más profundo de mi corazón.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0005",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000063",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"¿Le sucede algo?",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_had_000029",ch="had"},
},
ja={
{
name={"Hakuki"},
"Sentí una punzada en el pecho.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0002",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000064",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Ah, ¿punzadas en el pecho? Yo las tengo en todo momento.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_had_000030",ch="had"},
},
ja={
{
name={"Hakuki"},
"¿En todo momento?",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000065",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Siempre que pienso en usted siento un punzante dolor en mi pecho, Hakuki-dono.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_had_000031",ch="had"},
},
ja={
{
name={"Hakuki"},
"Siempre, que piensas en mí...",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0002",head="yos_z1a",lv=4,id=9},
{"fgact",ch="義貞",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000066",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Sí. Y es que yo a usted la amo.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Yoshisada-dono se ríe.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_had_000032",ch="had"},
},
ja={
{
name={"Hakuki"},
"---",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Duele.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Mi pecho duele, como si algo lo estuviera apretando.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"¿Por qué?",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"¿Será que alguna parte de mi cuerpo está afectado por algún mal?",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0005",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000067",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"¿Sucede algo?",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_had_000033",ch="had"},
},
ja={
{
name={"Hakuki"},
"Ugh.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Mis ojos se cruzan con los de Yoshisada-sama. Mi mirada se fue hacia abajo, sin\nquerer.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"¿Por qué?",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"No logro entender absolutamente nada de esto.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"¿Qué es lo que realmente me está pasando?",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_had_000034",ch="had"},
},
ja={
{
name={"Hakuki"},
"Yoshisada-sama, creo que... me siento mal.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000068",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"¿Se siente usted mal? ¡Hay que hacer algo al respecto!",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="義貞",size="z2",mode=3,resize=1,path=":fg/yos/z2/",file="yos_z2a0000",face="a0003",head="yos_z2a",lv=5,id=9},
{"fgact",ch="義貞",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Yoshisada-sama toma mi brazo.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_had_000035",ch="had"},
},
ja={
{
name={"Hakuki"},
"¡¡---!!",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Nuestras miradas se cruzan.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_had_000036",ch="had"},
},
ja={
{
name={"Hakuki"},
"A-Auh...",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="義貞",size="z2",mode=3,path=":fg/yos/z2/",file="yos_z2a0000",face="a0005",head="yos_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000069",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Sí, ahora que la veo bien de cerca, realmente tiene la cara completamente roja.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_had_000037",ch="had"},
},
ja={
{
name={"Hakuki"},
"S-Sí...",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="義貞",size="z2",mode=3,path=":fg/yos/z2/",file="yos_z2a0000",face="a0003",head="yos_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
"No, no es eso.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"No es que sus sentimientos están entrando dentro de mí.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Esto nació de mí misma.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"¿Son estos sentimientos?",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Hasta este día he venido tragando una innumerable cantidad de sentimientos.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_had_000038",ch="had"},
},
ja={
{
name={"Hakuki"},
"Nghh.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Un punzante dolor atraviesa mi pecho.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_had_000039",ch="had"},
},
ja={
{
name={"Hakuki"},
"...--",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Un dolor distinto al de hace rato comienza a invadirme apenas percibí\nsentimientos dentro de mí.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_had_000040",ch="had"},
},
ja={
{
name={"Hakuki"},
"Uh...",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"se",file="se_bafu",id=1},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-500,speed=200,file="zbg064c",path=":bg/",y2=0,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"quake"},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=200},
{"text"},
text={
ja={
{
"Me desplomo sobre el suelo.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="man_yod_000070",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"¿S-Se encuentra bien?",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_had_000041",ch="had"},
},
ja={
{
name={"Hakuki"},
"Y-Yo...",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Yoshisada-sama me extendió su mano, pero yo...",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"cgdel",lv=5,id=5,rule="cinema",time=400},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg064c",path=":bg/",sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"quake"},
{"se",id=1,file="se_hand_pan2"},
{"extrans",time=300},
{"text"},
text={
ja={
{
"La hice a un lado bruscamente con un golpe.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="義貞",size="z1",mode=3,resize=1,path=":fg/yos/z1/",file="yos_z1a0000",face="a0005",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000071",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"H-Hakuki-dono...",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_had_000042",ch="had"},
},
ja={
{
name={"Hakuki"},
"L-Lo siento mucho. Yo soy Hakuki.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000072",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Sí, lo sé. Usted es Hakuki-dono.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_had_000043",ch="had"},
},
ja={
{
name={"Hakuki"},
"Hakuki no es persona, es un recipiente.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_had_000044",ch="had"},
},
ja={
{
name={"Hakuki"},
"Y de allí, es que puede comer los sueños de los demás.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000073",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"Hakuki-dono...",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_had_000045",ch="had"},
},
ja={
{
name={"Hakuki"},
"Ngh.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_had_000046",ch="had"},
},
ja={
{
name={"Hakuki"},
"Perdóneme.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"cgdel",lv=5,id=5,rule="cinema",time=400},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se0744"},
{"text"},
text={
ja={
{
"Salgo corriendo.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Corro sin parar entre los árboles muertos.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Me concentro únicamente en correr por este bosque de árboles muertos,",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"todo para poder huir de él.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"El húmedo aire hace borrosa la silueta de la luna en el cielo.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"se",stop=1,time=500,id=1},
{"bgm",stop=1,time=1000},
{"msgoff"},
{"ex",time=2000,func="wait"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001276",ch="rna"},
},
ja={
{
name={"Rina"},
"...",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_yum_000934",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¿Rina, qué pasa?",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0120",face="a0001",head="yum_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001277",ch="rna"},
},
ja={
{
name={"Rina"},
"¿Eh? ¿Con qué?",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0008",head="yum_z2a",lv=5,id=9},
{"fgact",ch="優美",act="うなづく",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000935",ch="yum"},
},
ja={
{
name={"Yuumi"},
"En ningún momento moviste el pincel. ¿Estuviste pensando en algo?",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_rna_001278",ch="rna"},
},
ja={
{
name={"Rina"},
"Ah, s-sí...",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0017",head="yum_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000936",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¿R-Rina, estuviste quizás pensando acerca, de esos sueños?...",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"Oh~",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="直哉",size="z1",mode=3,resize=1,path=":fg/nao/z1/",file="nao_z1a0100",face="a0001",head="nao_z1a",lv=4,id=9},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
name={"Naoya"},
"Así que realmente se la pasan en la azotea, eh.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_yum_000937",ch="yum"},
},
ja={
{
name={"Yuumi"},
"...",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0016",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Por qué me ves con esa cara?... Me das miedo.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_yum_000938",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Pues creo que mi cara lo dice todo.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_rna_001279",ch="rna"},
},
ja={
{
name={"Rina"},
"¿Kusanagi-senpai, necesitas algo? ¿No estabas dándole tus lecciones a\nRin-senpai?",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0002",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"Lo estoy haciendo. Por eso me la traje acá.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003350",ch="rnd"},
},
ja={
{
name={"Rin"},
"Muchachas, hola~",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000939",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¡Rin-senpai!",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_rna_001280",ch="rna"},
},
ja={
{
name={"Rina"},
"¿Rin-senpai, también dibujarás un paisaje?",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003351",ch="rnd"},
},
ja={
{
name={"Rin"},
"Sí, así parece.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"Todos andan ocupados en sus obras para la Exposición Moore, y por eso no hay\nnadie ahora en la sala de arte. Deprime estar encerrado sin nadie alrededor\nadentro, así que le propuse a Rin que pintáramos afuera y aceptó.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000940",ch="yum"},
},
ja={
{
name={"Yuumi"},
"A Rin-senpai la recibo con brazos abiertos, sí, pero... ¿Por qué viniste tú\ntambién, Kusanagi-senpai?...",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"Soy yo quien la está instruyendo, ¿qué quieres que haga?",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003352",ch="rnd"},
},
ja={
{
name={"Rin"},
"Yuumi-chan, aprovecha que Kusanagi-kun está aquí y pídele que te enseñe.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0011",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="いいえ",size=5,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000941",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Ugh... Senpai, si así me lo pides...",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_rna_001281",ch="rna"},
},
ja={
{
name={"Rina"},
"¿Qué piensas pintar, Rin-senpai?",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003353",ch="rnd"},
},
ja={
{
name={"Rin"},
"No lo sé, la verdad. Aunque, creo que quisiera pintar la iglesia.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_rna_001282",ch="rna"},
},
ja={
{
name={"Rina"},
"¿La iglesia? ¿La iglesia de 'Las huellas de los cerezos'?",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003354",ch="rnd"},
},
ja={
{
name={"Rin"},
"Sí. Es nuestro recuerdo del verano de este año, así que de poder quisiera\ngrabarlo en una pintura.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"La composición de la arquitectura gótica es bastante desordenada, no va a ser\nfácil. Y hay un motivo para ese desorden, así que está fuera de lugar pintar\nsin prestarle suficiente atención a los detalles.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003355",ch="rnd"},
},
ja={
{
name={"Rin"},
"Agradecería tu instrucción en esos detalles más complicados, Kusanagi- kun.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うんうん",time=200,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003356",ch="rnd"},
},
ja={
{
name={"Rin"},
"¿Y-Y? ¿Rina-chan, Yuumi-chan, qué pintan ustedes?",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_rna_001283",ch="rna"},
},
ja={
{
name={"Rina"},
"Ah, solo un simple paisaje...",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003357",ch="rnd"},
},
ja={
{
name={"Rin"},
"Ya veo. Sí, el paisaje que se ve de acá es fenomenal, ¿verdad?",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_rna_001284",ch="rna"},
},
ja={
{
name={"Rina"},
"Lo es.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003358",ch="rnd"},
},
ja={
{
name={"Rin"},
"¿Y tú, Yuumi-chan?",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0016",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000942",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¡Un desnudo tuyo, senpai!",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003359",ch="rnd"},
},
ja={
{
name={"Rin"},
"¿Je?",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fgact",ch="優美",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000943",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¡¿Acaso olvidaste que prometeríamos hacerlo algún día?!",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003360",ch="rnd"},
},
ja={
{
name={"Rin"},
"¿L-Lo hice?",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",mode=-2,sync=0},
{"bg",y=100,x=600,file="zbg053a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0120",face="a0022",head="yum_z2a",lv=5,id=5,sync=0},
{"extrans",time=200},
{"quake"},
