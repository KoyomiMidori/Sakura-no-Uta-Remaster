},
block_00257={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000972",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¡Sí lo hice!",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡¿Lo hiciste?!",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0016",head="yum_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0005",head="yum_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000973",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Pues lo hice, soy una pervertida y es normal para mí hacerlo. ¡Pero los hombres\nfantasean con cualquier chica que vean, y por eso no es justo!",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ese argumento no tiene nada de lógica...",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="fem_rna_001309",ch="rna"},
},
ja={
{
name={"Rina"},
"¿Podríamos dejar ya de hablar de esto?",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003380",ch="rnd"},
},
ja={
{
name={"Rin"},
"Sí, es lo mejor. Creo que no es lo más apropiado para hablar frente a un chico.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0018",head="yum_z1a",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000974",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Maldita sea, maldito estorbón. ¡Acabaste con nuestra charla erótica de chicas,\ntodo por tu culpa!",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="fem_rna_001310",ch="rna"},
},
ja={
{
name={"Rina"},
"Espera, espera, en un principio esta clase de cosas tampoco se hablan entre\nchicas, normalmente.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003381",ch="rnd"},
},
ja={
{
name={"Rin"},
"¿No? A mí me gusta hablar de estos temas con otras chicas.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001311",ch="rna"},
},
ja={
{
name={"Rina"},
"¿Eh? ¿S-Sí?",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0016",head="yum_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000975",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Nunca me decepcionas, Rin-senpai.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"No se tomen a pecho lo que Rin diga. Desde pequeña siempre dice las cosas\ncuidando de no arruinar la atmósfera del momento.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003382",ch="rnd"},
},
ja={
{
name={"Rin"},
"Claro que no. Estás siendo prejuicioso allí también.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="fem_rna_001312",ch="rna"},
},
ja={
{
name={"Rina"},
"Senpai, creo que sería mejor darle la razón a Kusanagi-senpai en este caso...",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003383",ch="rnd"},
},
ja={
{
name={"Rin"},
"Aunque, volviendo al tema... No hemos avanzado nada con nuestras obras.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
vo={
{"vo",file="fem_rna_001313",ch="rna"},
},
ja={
{
name={"Rina"},
"Ah...",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"Era de esperarse...",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0017",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000976",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¡Este, estorbón!",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡¿Es que es mi culpa ahora?!",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
