{"vo",file="fem_rnd_003361",ch="rnd"},
},
ja={
{
name={"Rin"},
"¡K-Kusanagi-kun!",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000946",ch="yum"},
},
ja={
{
name={"Yuumi"},
"No te preocupes, no fue un golpe mortal.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001287",ch="rna"},
},
ja={
{
name={"Rina"},
"El solo hecho de hundirle los ojos con los dedos a alguien es mortal...",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000947",ch="yum"},
},
ja={
{
name={"Yuumi"},
"No importa, en fin, observa esto que tengo acá, senpai.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003362",ch="rnd"},
},
ja={
{
name={"Rin"},
"¿Eh?",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_rna_001288",ch="rna"},
},
ja={
{
name={"Rina"},
"¿Qué es esto?",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0004",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000948",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¡El desnudo de Rin-senpai! (Dibujo ficticio)",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003363",ch="rnd"},
},
ja={
{
name={"Rin"},
"¡Está muy bien hecho! ¡Parece casi una fotografía!",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_rna_001289",ch="rna"},
},
ja={
{
name={"Rina"},
"Muchacha, tú...¿Cuándo la fotografiaste sin que se diera cuenta?",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="うんうん",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000949",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Ajaja, parece que me descubriste. Qué buen ojo, Rina.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_rna_001290",ch="rna"},
},
ja={
{
name={"Rina"},
"Es una foto retocada (aikora)...",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003364",ch="rnd"},
},
ja={
{
name={"Rin"},
"¿Una foto retocada?",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_rna_001291",ch="rna"},
},
ja={
{
name={"Rina"},
"Una foto modificada con una computadora, en la que se corta la cara del modelo\noriginal y se coloca otra. Le llaman también 'aikora' a aquellas fotografías\nen las que se toman las caras de ídolos musicales y se retocan sobre fotos de\nmujeres desnudas.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003365",ch="rnd"},
},
ja={
{
name={"Rin"},
"¿Entonces esto es una foto retocada? El acabado es impresionante.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_rna_001292",ch="rna"},
},
ja={
{
name={"Rina"},
"Rin-senpai, esta muchacha estuvo tomándote fotos sin tu permiso. Deberías\nenojarte más.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="びっくり",loop=2,time=200,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000950",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¿Rina, estás enojada? ¡Quizás te fui infiel! ¡P-Pero, casi todas las\nfotografías a escondidas que tomo son tuyas, perdóname!",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_rna_001293",ch="rna"},
},
ja={
{
name={"Rina"},
"¡No estoy enojada por eso! ¡¿Y podrías explicarme muy bien de qué se trata eso\nde que casi todas las fotografías son mías?!",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うんうん",time=200,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003366",ch="rnd"},
},
ja={
{
name={"Rin"},
"Vamos, calma, calma. Debes recordar que tomar fotos sin permiso no es bueno.\nPodemos tomarnos fotos juntas si quieres, solo debes decirme.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0013",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="うんうん",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000951",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¿Lo dices en serio, senpai? ¡Excelente, entonces haz el signo de la paz con\nambas manos! ¡Comencemos por ahí!",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003367",ch="rnd"},
},
ja={
{
name={"Rin"},
"¿El signo de la paz? ¿A-Así?",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001294",ch="rna"},
},
ja={
{
name={"Rina"},
"¡No hace falta que lo hagas, senpai! ¡¡Esta mujer solo tiene motivos sucios en\nsu mente!!",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000952",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¡De ninguna manera usaré esta fotografía para motivos impuros! ¡Solo la usaré\npara fabricar una dakimakura!",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_rna_001295",ch="rna"},
},
ja={
{
name={"Rina"},
"¡¿Espera, fabricas dakimakuras con las fotografías de otros?!",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0016",head="yum_z1b",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000953",ch="yum"},
},
ja={
{
name={"Yuumi"},
"Sí. Solo de las tuyas ya tengo 10, Rina.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_rna_001296",ch="rna"},
},
ja={
{
name={"Rina"},
"Escucha, esa no es la clase de cosas que se revelan con tanto descaro...",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003368",ch="rnd"},
},
ja={
{
name={"Rin"},
"Increíble. Rina-chan, realmente te aman.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000954",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¡Sí!",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_rna_001297",ch="rna"},
},
ja={
{
name={"Rina"},
"No, senpai, esta es esa clase de amor que no se debe aceptar. Mira nada más lo\nque ha hecho, toma fotografías a escondidas y hace dakimakuras con ellas.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003369",ch="rnd"},
},
ja={
{
name={"Rin"},
"Tienes razón. Así que ya no más fotografiar a escondidas, Yuumi-chan. ¿Sí?",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000955",ch="yum"},
},
ja={
{
name={"Yuumi"},
"¡Por supuesto! ¡Bien, Rina, paz en las manos tú también!",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001298",ch="rna"},
},
ja={
{
name={"Rina"},
"¡¿Crees que voy a hacerlo?!",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003370",ch="rnd"},
},
ja={
{
name={"Rin"},
"Aunque suena muy tierno lo de las dakimakuras. Son esas que se abrazan al\ndormir, ¿cierto?",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0003",head="yum_z1a",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000956",ch="yum"},
},
ja={
{
