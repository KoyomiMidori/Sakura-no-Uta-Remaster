},
block_00174={
{"fg",ch="直哉",size="z2",mode=3,path=":fg/nao/z2/",file="nao_z2a0100",face="a0015",head="nao_z2a",x=500,lv=5,id=10},
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Qué? ¿Por qué me señalas a mí después de decir eso?",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2a0120",face="a0016",head="yum_z2a",x=-500,lv=5,id=9},
