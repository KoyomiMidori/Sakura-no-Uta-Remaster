},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_rna_001286",ch="rna"},
},
ja={
{
name={"Rina"},
"¡Antes de que Rin-senpai viniera estuviste todo el rato pintando el paisaje\nacá, ¿acaso lo olvidas?!",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"bg",x=0,y=100,speed=1000,time=0,sync=0,file="zbg053a",path=":bg/",x2=600,y2=100,ax=1920,ay=1126,bx=-960,by=-586},
