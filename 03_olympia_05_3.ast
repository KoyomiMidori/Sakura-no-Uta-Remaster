astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0120",face="a0001",head="yum_z1a",x=-570,lv=4,id=3,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",x=0,lv=4,id=10,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=570,lv=4,id=4,sync=0},
{"extrans",rule=139,vague=40},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=10},
{"bgm",file="bgm005"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000746",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tampoco he escuchado jamás de algún fabricante de ropa llamado Olympia...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0013",head="yum_z1a",x=-570,lv=4,id=3},
{"fgact",ch="優美",act="びっくり",lv=4,id=3},
{"fgact",ch="優美",act="icon",lv=4,id=3,icon="icon09z1",x=50,y=-550},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0016",head="yum_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_yum_000836",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Jaa! ¡¿Será que se trata de un fabricante de ropa interior?!”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0005",head="rna_z1d",x=0,lv=4,id=10},
{"fgact",ch="里奈",act="いいえ",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_rna_000747",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Pero q--! ¡No trates de extender tus manos hacia mi falda mientras dices eso!”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",x=570,lv=4,id=4},
{"fgact",ch="稟",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002440",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A fin de cuentas, parece que no es uno de los fabricantes que se encarga de\nhacer los uniformes de este colegio.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",mode=-2},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0110",face="a0010",head="sui_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000388",ch="sud"},
},
ja={
{
name={"Sui"},
"“En conclusión, ¿qué es lo que significa todo eso? Explíquenle a Sui de manera\nque entienda, por favor.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si tratamos de explicarlo de manera que entiendas, lo único que se podría decir\nes que aún no hay ninguna pista.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0013",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000389",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Es verdad eso? Fumuh. Este misterio se está volviendo cada vez más profundo.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Este misterio se está volviendo cada vez más profundo...",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"No, espera, en un principio, ¿Sui se habrá dado cuenta ya de lo raro que es\nesto?",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"El día que nos encontramos por primera vez.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"A pesar de haber sido solo por un instante, ella confundió su propio nombre con\nel del fabricante de ropa.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Y además, está emprendiendo una búsqueda por algo que no sabe qué es.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Sin embargo, entre todo eso, hay algo de lo que logré darme cuenta.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"El uniforme de Sui no es el establecido por el colegio.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"En pocas palabras, eso implica que ella no es una estudiante formal de esta\ninstitución.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"De ser así, son altas las posibilidades de que su atuendo haya sido fabricado\ntratando de asemejarse a los uniformes de acá.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"¿Por qué existirá un atuendo imitación del uniforme del colegio Yumihari?",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"¿Es para un cosplay?",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"De ser así, sería mucho más conveniente comprar un uniforme legal.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Lo cual implica que el uniforme de Sui fue hecho como una imitación del\nuniforme de Yumihari por alguna razón en específico.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Nada más esto ya representa una enorme pista para mí.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Olympia, eh.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo... Shizuku había dicho algo al escuchar ese nombre...",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Había dicho que al parecer, y aparte de la obra de Manet, hay algo más que\nposee ese mismo nombre...",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002441",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sui-chan, ¿no tienes alguna otra pista?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0008",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000390",ch="sud"},
},
ja={
{
name={"Sui"},
"“Fumuh... sí... Para comenzar, me da la sensación de que este colegio es muy\nimportante.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002442",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿El colegio Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000391",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí, no puedo evitar pensar que hay cierta conexión entre este lugar y aquello\nque estoy buscando...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este lugar... Eso acabas de decir, ¿no, Sui?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000392",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí, así lo dije. ¿Sucede algo con eso?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En pocas palabras, ¿se puede asumir que no solo se trata del colegio Yumihari,\nsino también de toda la colina de Yumihari también?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0009",head="sui_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000393",ch="sud"},
},
ja={
{
name={"Sui"},
"“Pues sí. Ahora que lo dices, realmente siento que más que esta edificación,\ntodo este terreno es muy importante.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Todo comenzó en ese sitio de construcción... y ahora, le sigue la colina de\nYumihari...",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No hay algún otro lugar que te llame la atención? Algo que de cierta manera\nsientas tener en tus recuerdos.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000394",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Algún lugar que crea tener en mis memorias?... Ehh, hay un río corriendo, y a\nsu lado hay un parque...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un parque por el cual pasa un río. Si es por ese lugar, entonces no hay duda de\nque es el parque Sakuragahara.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002443",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, sí, ciertamente. El único parque a cuyo lado pasa un río por esta zona es\nel parque Sakuragahara.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, ¿vamos a verlo?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002444",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"msgoff"},
{"bg",file="zeveningsky_summer",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=0,x=-960,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se9004",id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002445",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Llevo tanto tiempo sin venir al parque Sakuragahara...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hace bastante solías venir con frecuencia, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002446",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, antes venía frecuentemente acá. Pero ¿por qué lo habré hecho?... Se supone\nque está muy lejos del lugar donde vivo...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_sud_000395",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí, ciertamente... es aquí.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lograste enterarte de algo?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_sud_000396",ch="sud"},
},
ja={
{
name={"Sui"},
"“No puedo decirlo con toda seguridad, aunque de cierta manera puedo sentir\nalgo... ¿Podríamos ir siguiendo el río?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Vamos caminando por el parque contiguo al río.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Y al llegar a la parte de ese parque ubicada cerca de la costa, nos topamos con\nun parque aún más grande.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_sud_000397",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Esto es?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es la entrada al Parque Costero Hinayumi. Al bajar acá por las escaleras,\nllegas a la costa Hinayumi, y al cruzar las puertas de este parque, se llega\nal Parque Costero Hinayumi.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_sud_000398",ch="sud"},
},
ja={
{
name={"Sui"},
"“Quisiera ir al Parque Costero Hinayumi.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg035b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="吹",size="z1",mx=40,mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000399",ch="sud"},
},
ja={
{
name={"Sui"},
"“Fumuh...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002447",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Lograste darte cuenta de algo?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0015",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000400",ch="sud"},
},
ja={
{
name={"Sui"},
"“Lamentablemente, no logro dar con nada.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
"Observo a Rin.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002448",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿S-Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no... no es nada, solo que... ya está atardeciendo...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002449",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y... pensé que ya no hay mucho tiempo para seguir buscando...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002450",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, tal vez.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Examino cuidadosamente la cara de Rin.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Y también la expresión de Sui...",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Y entonces, entendí algo.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",mode=-2},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002451",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, Sui-chan, ya está oscureciendo. ¿No crees que es un poco difícil ya\nseguir con la búsqueda?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0009",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0010",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000401",ch="sud"},
},
ja={
{
name={"Sui"},
"“Tienes razón... Buscar en la penumbra es toda una tarea laboriosa.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002452",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, así que, ¿qué te parece si lo dejamos hasta aquí por hoy?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000402",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí, quizás sea buena idea.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Terminamos entonces, eh!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Digo eso con un tono de voz claramente muy alegre.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002453",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Y al hacerlo, por alguna razón Rin se sonroja.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0003",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000403",ch="sud"},
},
ja={
{
name={"Sui"},
"“Bien entonces, creo que Sui hará su retirada ya.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, eso es lo mejor. Sí. Ya es hora que los mocosos regresen a casa.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0018",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0011",head="sui_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000404",ch="sud"},
},
ja={
{
name={"Sui"},
"“No soy ninguna mocosa. O, normalmente estaría comenzando ya mi contraataque de\nesa manera, pero los dos me acompañaron hoy para ayudarme, así que les doy\nmis gracias.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te agradezco yo también que no lo hagas. Estoy tan exhausto de caminar ahora\nque no creo poder aguantar un contraataque tuyo en este momento.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0003",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000405",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí, probablemente no puedas. Fumuh.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Sui asiente fuertemente una vez.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Y entonces, observa la cara de Rin.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0004",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000406",ch="sud"},
},
ja={
{
name={"Sui"},
"“Muchas gracias por hoy. Por acompañarme al pasado.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002454",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Por acompañarte al pasado?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000407",ch="sud"},
},
ja={
{
name={"Sui"},
"“Y gracias a ti también, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, aunque en un principio fue en contra de mi voluntad, eh.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000408",ch="sud"},
},
ja={
{
name={"Sui"},
"“Eso lo sé también. En fin, disfruten ahora de su tiempo juntos.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso haremos.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002455",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Esto...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000409",ch="sud"},
},
ja={
{
name={"Sui"},
"“Me despido entonces.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="吹",mx=-40,mode=-1,lv=4,id=5},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Sui corre y desaparece dentro del bosque.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x2=345,x=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu... al fin se termino esto...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002456",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Se acabó...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Siento un pequeño alivio ante el hecho de que la búsqueda de Sui terminó, al\nfin, por hoy.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Por acompañarme al pasado... eh.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Ya lo entiendo.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bgm",stop=1,time=1000},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008j",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002457",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Al ver a Rin, parece estar algo inquieta.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011j",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002458",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... Has estado viéndome desde que entramos a este parque, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿S-Sí?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009j",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002459",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Estabas... esperándolo?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Por qué piensas eso?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bgm",file="bgm016"},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011j",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002460",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Tus pantalones están algo hinchados.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? A-Ahh, e-esto es...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Al ver con cuidado, me doy cuenta que mi miembro estaba algo hinchado.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009j",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002461",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A medida que el sol fue poniéndose... tu mirada se tornaba cada vez más sucia,\nNao-kun...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... no tengo manera de rebatir eso...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Es un hecho que en lo que el atardecer iba avanzando, Rin se me comenzó a hacer\nmás seductora que de usual... pero, de cierta forma pude contenerme gracias a\nque Sui aún estaba...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tengo que admitirlo. P-Pues...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Estuve, viéndote todo este tiempo...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002462",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“D-Digo, e-es que, justo después de que dijiste que seguiríamos con la\ncontinuación de lo de esta mañana, tuve que acompañarte a ti y a Sui en su\nbúsqueda.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además... te veías muy provocativa con la luz del sol del atardecer\niluminándote.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015j",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002463",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002464",ch="rnd"},
},
ja={
{
name={"Rin"},
"“M-Muchas gracias.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Por alguna razón que desconozco, Rin baja la cabeza y hace una reverencia.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa? ¿Por qué haces una reverencia?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008j",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002465",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿T-Te tuve esperando todo este tiempo?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Me tuviste esperando, todo este largo rato...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002466",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya entiendo que te dejé esperando todo el día, pero... no pensé que se pondría\nasí...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Esta clase de fenómenos fisiológicos en los hombres son inevitables...\naunque, aún no se ha terminado de agrandar por completo.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008j",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009j",head="rin_z1a",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002467",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Aún no, ¿verdad? Y... ¿cómo está ahora?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres averiguarlo?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008j",head="rin_z1a",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002468",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? No, n-no quise decir eso... esto...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Solo bromeaba.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque bueno, basta con flexionar y estirarme un poco para que se calme. Así se\nmanejan los descontroles de las partes inferiores de los hombres.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"mwact",act="うんうん",time=200},
{"se",file="se3130",id=1,vol=50},
{"text"},
delay={
[300]={
{"se",file="se3130",id=2,vol=50},
},
},
text={
ja={
{
name={"Naoya"},
"“Essa, essa.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Comienzo a hacer ejercicios de flexión y estiramiento.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002469",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te es eso suficiente para calmarte?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no lo es, pero no puedo hacer más nada, ¿no? Estamos en un parque.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002470",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero estás ahora así por haber aguantado desde la mañana,\n¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, así es, pero...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005j",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002471",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡E-Esto, Nao-kun!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",x=0,lv=5,id=6},
{"fgact",ch="稟",act="うなづく",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002472",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿P-Podrías mostrarme... cómo te encuentras ahora?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",x=0,lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",x=0,lv=5,id=6},
{"fgact",ch="稟",act="おじぎ",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002473",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, me interesa saber, en qué estado está ahora. Ah, en ese caso asumiré toda\nla responsabilidad y me encargaré de él hasta el final...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm... eso, quiere decir... que...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0008j",head="rin_z2a",x=0,lv=5,id=6},
{"fgact",ch="稟",act="いいえ",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0011j",head="rin_z2a",x=0,lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002474",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No lo haré si te desagrada la idea. Simplemente tengo interés en eso...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No, eso me pone alegre. Me hace bastante feliz que me digas eso. Pero no hay\nningún lugar donde podamos escondernos por acá... Sería un peligro hacerlo\nentre los arbustos. Parece que últimamente los parques han estado siendo\nequipados con cámaras de seguridad.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0009j",head="rin_z2a",x=0,lv=5,id=6},
{"fgact",ch="稟",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002475",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Entiendo... Es, peligroso hacerlo en los arbustos entonces.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Aunque bueno, no es que no hay ningún lugar para hacerlo, tampoco...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0008",head="rin_z2a",x=0,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002476",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por ejemplo?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, pero no podemos hacerlo ahí. No.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",x=0,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002477",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Dónde?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues los baños tienen sus retretes individuales...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",x=0,lv=5,id=6},
{"fgact",ch="稟",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002478",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿E-En los baños?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Por eso, no tengo intención alguna de llevarte a hacerlo en un lugar tan\nasqueroso, así que no te preocupes.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",x=0,lv=5,id=6},
{"fgact",ch="稟",act="いいえ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002479",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿N-No te gustaría hacerlo ahí?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no me desagradaría... Hay una atmósfera muy lasciva en ellos...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",x=0,lv=5,id=6},
{"fgact",ch="稟",act="おじぎ",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008j",head="rin_z2a",x=0,lv=5,id=6},
},
vl02={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0015j",head="rin_z2a",x=0,lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002480",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Entiendo... ya veo. F-Fui yo quien cortó las cosas esta mañana, y además, fui\nyo también quien te dejó esperando después durante toda la tarde... a-así\nque, Nao-kun, si así lo deseas, podríamos ir al lugar que prefieras...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? E-Eso significa que...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"¿E-En el baño?... Ese no es precisamente el lugar donde una pareja sin mucha\nexperiencia lo haría, pero... hay en ellos esa gran atmósfera obscena y\nlasciva, que...",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008j",head="rin_z2a",x=0,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002481",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿C-Crees... que podríamos hacerlo allí?...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005j",head="rin_z2a",x=0,lv=5,id=6},
{"fgact",ch="稟",act="ジャンプ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002482",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡C-Claro, s-sí!”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Entonces--!”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="man_krn_000001",ch="krn"},
},
ja={
{
name={"Encargado"},
"“¡Bien, bien, muchachos! ¡Ya se pasó la hora de cierre, ya son más de las cinco!\nLa verdad es que ya a esta hora no deberíamos dejar salir bicicletas tampoco.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002483",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Mmm?!”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ah, sí.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="man_krn_000002",ch="krn"},
},
ja={
{
name={"Encargado"},
"“¡Bien entonces! Vamos, salgan, salgan.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, s-sí, pero nosotros vinimos caminando, así que...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="man_krn_000003",ch="krn"},
},
ja={
{
name={"Encargado"},
"“Ah, ya veo. Pero son estudiantes, ¿no? No me parece muy bien ver a una pareja\nde jóvenes solos en este lugar a estas horas, cuando el sol se está poniendo,\neh.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, bueno, sí, tiene razón, supongo.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="man_krn_000004",ch="krn"},
},
ja={
{
name={"Encargado"},
"“Por reglamento interno, ningún estudiante puede quedarse en este lugar hasta\naltas horas de la noche. Siempre que los encontramos el administrador del\nparque se pone insistente y me manda a mí a sacarlos.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí, tiene razón.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="man_krn_000005",ch="krn"},
},
ja={
{
name={"Encargado"},
"“En fin, me van a regañar a mí, así que váyanse ya. De lo contrario yo tampoco\npodré irme, ¿no les parece?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Al decir eso, el encargado señaló la cámara que estaba en la entrada.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Según ese gesto, parece estar indicando que 'ahora que nos vieron, no tengo más\nopción que sacarlos o me regañarán a mí'.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_002484",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Entendemos. ¿Nao-kun, nos vamos ya?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Lo dices en serio?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002485",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Vamos, nos tenemos que ir.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pero... yo...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_olympia_05_4"},
