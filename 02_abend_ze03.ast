astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo II"},
{"bg",file="black",path=":bg/"},
{"bgm",file="bgm026"},
{"text"},
text={
ja={
{
"Aquello era un sueño.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Nada más que un sueño.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"En ninguno de mis recuerdos había algo parecido.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"'Nakaki yo no, too no nefuri no minamesame, naminorifune no oto no yoki kana'",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Me llegó ese poema a mis oídos.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"No sabía lo que significaba. Pero, me pareció un poema agradable.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"msgoff"},
{"bg",zone="0x000000",file="bg082a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="man_hss_00000_1",ch="hss"},
},
ja={
{
"¿Te sucede algo?",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="伯奇",size="z1",mode=3,resize=1,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000001",ch="had"},
},
ja={
{
name={"Mujer"},
"“Ah, no...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Estaba sentada en la habitación de huéspedes junto a aquel hombre.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="man_hss_00000_2",ch="hss"},
},
ja={
{
"Nuh...",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"El hombre me observa fijamente.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Al ver su rostro, recordé por primera vez la relación que había entre los dos.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="man_hss_00000_3",ch="hss"},
},
ja={
{
"Hmh, qué raro, eh... Justo ahora me parece haber visto algo parecido a una\nexpresión en tu rostro...",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_had_000002",ch="had"},
},
ja={
{
name={"Mujer"},
"“Es que escuché un poema...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_hss_00000_4",ch="hss"},
},
ja={
{
"Probablemente fue alguien de la residencia quien estuvo recitándolo. Yo también\nlo escuché.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="man_hss_00000_5",ch="hss"},
},
ja={
{
"Sin embargo, te recuerdo que no estás en posición para disfrutar de cantos y\npoemas.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fgact",ch="伯奇",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000003",ch="had"},
},
ja={
{
name={"Mujer"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="man_hss_00000_6",ch="hss"},
},
ja={
{
"Pero bueno, qué más da. Hakuki, iré a hablar con el señor Tokitsuna. Quédate\nesperando acá.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_had_000004",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Por supuesto, Housou-sama.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="man_hss_000001",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“El ritual a realizarse pronto podría ser nuestro chance para recuperar el poder\nen Kyo. Creo que no debería preocuparme por nada ahora, pero... No hace falta\nque te lo explique, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fgact",ch="伯奇",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_had_000005",ch="had"},
},
ja={
{
name={"Hakuki"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="man_hss_000002",ch="hss"},
},
ja={
{
name={"Housoushi"},
"“Partiré entonces.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Observo en silencio la espalda de mi padre -de Housoushi- alejarse.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Y ahora, me quedo sola en la habitación.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Los sudare están desplegados a mi alrededor.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Y no por ser una huésped.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Sino por el hecho de que yo soy Hakuki.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"No una persona, ni un humano. Simplemente Hakuki.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=550,y=210,zone="0x000000",file="zbg082a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="義貞",size="z2",mode=3,resize=1,path=":fg/yos/z2/",file="yos_z2a0000",face="a0003",head="yos_z2a",lv=5,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"fgact",ch="義貞",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_yod_000001",ch="yod"},
},
ja={
{
"Nunuh...",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Escucho una voz venir del otro lado de las sudare.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Puedo ver la tenue silueta de alguien.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="man_yod_000002",ch="yod"},
},
ja={
{
"En la aldea decían que se trataba de una bestia peluda de cuatro ojos, y sin\nembargo...",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="man_yod_000003",ch="yod"},
},
ja={
{
"No puedo permitir que semejante monstruo ponga sus pies en esta aldea. ¡Agh,\nque todo sea como el destino lo disponga!",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"se",file="se9010",id=1},
{"fg",ch="義貞",mx=40,mode=-1,lv=5,id=9},
{"text"},
text={
ja={
{
"Algo levanta las sudare, y al siguiente instante una persona entró a la\nhabitación.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"se",file="se3130",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",file="bg082a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"fg",ch="義貞",size="z1",mx=-40,mode=3,resize=1,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000004",ch="yod"},
},
ja={
{
"¡¿--?!",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Fue un jovencito en plena adolescencia quien entró. Los movimientos de su\ncorazón eran aquellos de los de un joven.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"El inesperado visitante se sentó rápidamente de rodillas, y bajó su cabeza\nhasta más no poder.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg082a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=1500},
{"text"},
text={
vo={
{"vo",file="man_yod_000005",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“M-M-Mi nombre es Yoshisada Nakamura, hijo mayor de Tokitsuna, jefe del clan\nNakamura.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Hakuki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="man_yod_000006",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Se escuchan muchos rumores entre los aldeanos de la llegada de un chamán\nproveniente de Kyo, y quise venir a confirmar eso, en mi digna posición como\nfuturo sucesor del clan Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000007",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“He escuchado que Housoushi controla a una bestia, permitiéndole consumir los\ncorazones de las personas y adivinar su futuro... Mi gente se encuentra\nintranquila por ello.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",x=-345,lv=4,id=5},
{"fgact",ch="義貞",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000008",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Ah, eh, disculpe mi descortesía. Fue una gran injuria de mi parte llamarle\nmonstruo a una damisela t-tan hermosa como usted. Perdóneme.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Hakuki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000009",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Aun después de cierto rato, el joven visitante parecía estar viendo a\nhurtadillas mi cara.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="man_yod_000010",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"De su corazón comienza a brotar el sentimiento de suspicacia.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fgact",ch="義貞",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000011",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Será posible que se trate... de una marioneta?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"se",file="se9010",id=1},
{"fg",ch="義貞",speed=500,mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x2=-345,x=-210,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Yoshisada"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="man_yod_000013",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Me lo imaginaba, ni un solo parpadeo se nota en su cara.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",x=-210,lv=4,id=5},
{"fgact",ch="義貞",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x=-210,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_yod_000014",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Jaa～～ Solo una marioneta. Con buena razón no se mueve en lo más mínimo. He\nescuchado que entre los chamanes de la capital hay algunos que son capaces de\nmanejar marionetas. No me imaginaba que Housoushi era uno de esos...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="man_yod_000015",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Sin embargo, el acabado de esta marioneta es impresionante. ¿Es que es posible\ncrear una tan maravillosa como esta? Por más que venga de la capital...\nNunuh...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"El joven visitante me observa muy fijamente.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fgact",ch="義貞",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",x=-210,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_yod_000016",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Fumuh, en mi vida he visto jamás a una persona tan hermosa. No cabe duda de que\nes una marioneta fabricada en la capital. No menos podía esperar de la tierra\ndonde reside su majestad el emperador, ni siquiera entre los artículos más\nfinos traídos a la provincia he visto algo así...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="man_yod_000017",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Es difícil creer que su piel esté hecha de porcelana... Se ve tan suave, casi\ncomo si fuera a moverse en cualquier momento...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"se",file="se9010",id=1},
{"fg",ch="義貞",speed=500,mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",x2=-210,x=0,lv=4,id=5},
{"text"},
text={
ja={
{
"Junto a un suspiro de admiración, la mano del joven se acerca suavemente hacia\nmí.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Y la mano que había estirado tocó suave y amablemente mi mejilla.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000018",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Qué clase de marioneta es esta? Es suave... y se siente... cálida...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0005",head="yos_z1a",x=0,lv=4,id=5},
{"fgact",ch="義貞",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000019",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Je? ¿¿Suave... y cálida??”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000020",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“S-Será que...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"El visitante acercó su oreja lentamente a mi boca.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0005",head="yos_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000021",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“E-Está... respirando...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Y su cara se palideció.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="義貞",time=400,mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0005",head="yos_z1a",y2="0,-10",x=0,y=0,lv=4,id=5},
{"fg",ch="義貞",speed=1000,mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0005",head="yos_z1a",x2=0,x=-210,y=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="義貞",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0005",head="yos_z1a",y2="0,-10",x=-210,y=0,lv=4,id=5},
{"fg",ch="義貞",speed=500,mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0005",head="yos_z1a",x2=-210,x=-345,y=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_yod_000022",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“～～, u-uwah... wah.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Este retrocedió tres pasos y bajó profundamente su cabeza.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fgact",ch="義貞",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",x=-345,y=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_yod_000023",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¡L-Le, le ruego que me perdone por tanta descortesía!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0005",head="yos_z1a",x=-345,y=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000024",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¡¿Pero por qué?! ¡¿Por qué esta muñeca tan hermosa es, es una humana?!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x=-345,y=0,lv=4,id=5},
{"text"},
text={
ja={
{
"Es raro ver a un humano del cual pueda percibir tan fácilmente los cambios en\nsu corazón. A pesar de no haberlo tragado.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"No, quizás de esta manera es que despiertan los hombres jóvenes.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Y es que jamás he visto a alguien dormir. Excepto por Housou, mi padre.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Es por eso que me pareció realmente extraño ver semejante torbellino de\nemociones, tan rápidamente cambiantes.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fgact",ch="義貞",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000025",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¡¡--!!”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0005",head="yos_z1a",x=-345,y=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",x=-345,y=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_yod_000026",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Ah, quiero decir, r-realmente lo siento por confundirle con una marioneta. Ah,\nno, no se trata de eso, sino que, eh, esto.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Después de deslizar sus ojos de un lado a otro por un rato, el joven finalmente\nterminó bajando su mirada.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x=-345,y=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000027",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“No, debo más bien disculparme por haberla tocado, y con tanta insolencia.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",x=-345,y=0,lv=4,id=5},
{"fgact",ch="義貞",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000028",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Le pido mis más sinceras disculpas...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_had_000006",ch="had"},
},
ja={
{
name={"Hakuki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x=-345,y=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",x=-345,y=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_yod_000029",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Ehm... ¿Está usted, enojada? Por eso no me habla, ¿cierto? O será que, eh...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"'Pánico', 'confusión', 'desconcierto'. Percibo esos sentimientos dentro de él.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x=-345,y=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000030",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Será acaso que no puede usted hablar? ¿No se le tiene permitido hablar?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="man_yod_000031",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Sin embargo, es un hecho que quedé cautivado ante su belleza, y que entre tanta\nhermosura no resistí tocarle...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",x=-345,y=0,lv=4,id=5},
{"fgact",ch="義貞",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000032",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Si realmente le hice enojar, le imploro que me perdone... Se lo ruego...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"El joven me habla, con una voz casi imperceptible.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Toda una marea de sentimientos, fuertemente variantes en intensidad, entran\ndentro de mí.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Esta clase de situaciones no me son muy convenientes.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"'No verás, no escucharás, ni hablarás fuera de los rituales.'",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Ese es el veto de Housou.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Y siendo algo que Housou me prohibió, debo hacer lo posible por alejar al\nvisitante que tengo ahora frente a mis ojos.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fgact",ch="伯奇",act="うなづく",size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_had_000007",ch="had"},
},
ja={
{
name={"Hakuki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Sin decir nada, señalé con mi dedo hacia afuera de la habitación.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x=-345,y=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000033",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿E-Eso significa, que me vaya?”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fgact",ch="伯奇",act="うなづく",size=5,lv=4,id=6},
{"text"},
text={
ja={
{
"Asiento ligeramente.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",x=-345,y=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000034",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Ya, ya veo... Sí, era de imaginarse...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fgact",ch="義貞",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000035",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“R-Realmente lo siento mucho.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"se",file="se9010",id=1},
{"fg",ch="義貞",speed=500,mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",x2=-345,x=-500,y=0,lv=4,id=5},
{"text"},
text={
ja={
{
"Tras hacer una profunda reverencia, el joven visitante se paró rápidamente y me\ndio la espalda. Sin embargo...",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x=-500,y=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000036",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Podría... ¿Podría por lo menos, darme su nombre?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Hakuki"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"No puedo, de ninguna manera, dar mi nombre.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Y es que el veto me impide incluso hablar... Menos aún puedo decir mi verdadero\nnombre.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0004",head="yos_z1a",x=-500,y=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000037",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“... Así que tampoco puedo saber su nombre... Era de esperarse, después de la\ninsolencia que cometí.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fgact",ch="義貞",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000038",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Discúlpeme. De verdad lo siento.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_had_000008",ch="had"},
},
ja={
{
name={"Hakuki"},
"“... Hakuki.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0005",head="yos_z1a",x=-500,y=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000039",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"¿Por qué di mi nombre? No lo sé.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_had_000009",ch="had"},
},
ja={
{
name={"Hakuki"},
"“Me llamo Hakuki.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",x=-500,y=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000040",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="義貞",size="z1",mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0003",head="yos_z1a",x=-500,y=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000041",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Ya veo... así que su nombre es Hakuki. Es un nombre un tanto peculiar.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡Yoshisada-sama! ¡¿Dónde se encuentra?! ¡Yoshisada-samaaa!",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Se escuchan unas voces a lo lejos llamando.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fgact",ch="義貞",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_yod_000042",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Ah, vienen acá. Parece que los sirvientes me están buscando.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="man_yod_000043",ch="yod"},
},
ja={
{
name={"Yoshisada"},
"“Hakuki-dono, procuraré venir de nuevo. Le pido que recuerde el nombre de\nYoshisada hasta entonces.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="義貞",mx=-40,mode=-1,lv=4,id=5},
{"se",id=1,file="se2185"},
{"text"},
text={
ja={
{
"Se escucha el sonido de los pasos alejándose.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",file="bg082a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"fg",ch="伯奇",size="z1",mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"El silencio volvió a la habitación, y con este regresó también la normalidad.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"¿Normalidad?",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Siento que algo cambió en el aire. Hace más frío ahora.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"No-- ¿Será que el ambiente de hace un momento era cálido?",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"¿Por qué habré dado mi nombre?",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Tengo prohibido decir mi propio nombre. Mi verdadero nombre. Hakuki. Sin\nembargo...",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Para aquella que nació como la sacerdotisa de Yumehari, destinada al eterno\nsilencio, eso es de nula importancia.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"No es más que polvo ante el viento.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Así como el mismo veto de Housou.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"'Nakaki yo no, too no nefuri no minamesame, naminorifune no oto no yoki kana'",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Me pareció haber escuchado de nuevo ese poema.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
".........",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg073a",path=":bg/",sync=0},
{"extrans",time=1500},
{"text"},
text={
vo={
{"vo",file="fem_rna_000502",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_rna_000503",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Oeh?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Al despertar, me encontré con la habitación donde duermo siempre.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Para ser eso un sueño, se sintió muy real.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_rna_000504",ch="rna"},
},
ja={
{
name={"Rina"},
"“... ¿Qué... habrá sido eso?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Puedo recordar hasta los más pequeños detalles de aquel sueño. Casi como si se\ntrataran de recuerdos del pasado.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_rna_000505",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fumuh...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Recordé la cara de aquel joven que apareció en mi sueño.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm009"},
{"fg",ch="優美",size="z1",mx=40,mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000327",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Buenos días, mi Rina.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000506",ch="rna"},
},
ja={
{
name={"Rina"},
"“Buenos días. Y por cierto, no soy solo tuya.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000328",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tienes razón. Eres muy preciada para tu familia también.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000507",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, sí, claro.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Y al darle fin con un breve comentario a la misma charla cómica de todos los\ndías, Yuumi y yo nos vamos al colegio.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000508",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahora que lo recuerdo, la primera vez que hablamos fue en aquel parque,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000329",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. Aunque ya no están ninguno de los equipos de juego que habían entonces.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000509",ch="rna"},
},
ja={
{
name={"Rina"},
"“En esa época llevabas el cabello corto.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000330",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_rna_000510",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eras como un niño.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000331",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, era muy indiferente a mi propio aspecto... Ah, pero no confundas las cosas,\nno es que quiera volverme hombre ni nada de eso. Simplemente soy lesbiana, y\nme gustas.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000511",ch="rna"},
},
ja={
{
name={"Rina"},
"“En ningún momento pregunté por eso.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000332",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No está de más que escuches con seriedad mis comentarios de vez en cuando.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000512",ch="rna"},
},
ja={
{
name={"Rina"},
"“La última vez que lo hice intentaste violarme.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="うんうん",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000333",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Era imposible no hacerlo. Aquel día estuve describiendo tu hermosura con varias\npalabras, tu hermosura, sí, y mi cordura no pudo más, no aguanté más, sí.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000513",ch="rna"},
},
ja={
{
name={"Rina"},
"“Entonces no tengo razón ni motivación para hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000334",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ahh, siempre tan fría conmigo, Rina. Pero, igualmente me encanta lo\nhermosamente fría e impasible que eres.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000514",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué parte de mí se supone que es fría e impasible? Por Dios.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000335",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo eres. Y esa es una de las cosas que me enamoraron de ti.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000515",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si Kusanagi-senpai llegara a escuchar eso, seguramente se quedaría como\n'¿Jaa?'.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000336",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eso no...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Yuumi se traga las palabras que estaba a punto de soltar.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000337",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡E-Ese zopenco jamás podría darse cuenta de tu encanto!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000516",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0009",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000517",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0018",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000338",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En primer lugar, la culpa de todo la tiene ese maniático, ese excéntrico. ¡Ese\nimbécil de Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0010",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うんうん",time=200,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000518",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, sí, ya entendí. Deja la mala maña de echarle siempre la culpa por todo a\nKusanagi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000339",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero, es que él... se me hace incómodo.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000519",ch="rna"},
},
ja={
{
name={"Rina"},
"“Se te hace incómodo... Sí, se nota a simple vista que Kusanagi-san te cae\npesado, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000340",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Y a quién no le caería pesado ese tipo?!”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000520",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, solamente a ti. Kusanagi-san tiene ciertos aspectos en los que no tiene\narreglo, por más incómodo que sea. Y es que, Kusanagi-san es――”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000341",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Te equivocas.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000521",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vaya, vaya, me han interrumpido.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000342",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Porque estás diciendo cosas que no son.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000522",ch="rna"},
},
ja={
{
name={"Rina"},
"“No he dicho nada aún.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000343",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Estuviste a punto de decirlo, con toda seguridad.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000523",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tienes razón. Y sí, quizás sea lo correcto.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000344",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Debo admitir que me asombré un poco... Pero tampoco soy capaz de odiar a\nalguien por semejante razón. ¡Para mí él es un enemigo! ¡Lo mataré!”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000524",ch="rna"},
},
ja={
{
name={"Rina"},
"“Espera, espera, una joven muchacha ataviada con uniforme colegial no puede\nandar diciendo esas cosas en plena mañana.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0012",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000345",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Uniforme? ¡Claro, el uniforme! ¡El uniforme de Yumihari!”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000525",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Qué sucede con eso?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0018",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000346",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A pesar de ser una tonta para los estudios, puse toda mi sangre y mi alma, solo\npara poder llevar el mismo uniforme que tú, Rina. Y lo logré, entré al\ncolegio Yumihari, ¡comenzando con calificaciones infinitamente por debajo del\npromedio!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000526",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo de infinitamente por debajo del promedio no tiene sentido...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000347",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Ah--, y ahora puedo cambiar mi uniforme con el de Rina, sin que se de cuenta!\n¡Esto es simplemente maravilloso!”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010",head="rna_z1d",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008",head="rna_z1d",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000527",ch="rna"},
},
ja={
{
name={"Rina"},
"“Espera, espera, obviamente me daré cuenta. Nuestros uniformes difieren bastante\nen tamaño...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",mode=-2},
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0100",face="a0004",head="yum_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="うなづく",lv=5,id=6},
},
vl02={
{"fgact",ch="優美",act="うんうん",time=400,lv=5,id=6},
},
vl03={
{"fgact",ch="優美",act="ジャンプ",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000348",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Me pondré tu uniforme, Rina! ¡Me lo pondré! ¡Me lo pondré, y, me masturbaré!”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000528",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Wah, wah! ¡Tonta, no digas esas cosas con esa voz tan alta!”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"se",file="se3130",vol=50,id=1},
{"cgdel",id=-1},
{"bg",time=250,rule=280,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"Me apresuro a jalar la mano de Yuumi.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Y por supuesto, lo hice porque todas las personas que habían alrededor se\nquedaron viéndonos fijamente, sorprendidos.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=280,time=300,vague=40},
{"fg",ch="里奈",size="z1",mx=-40,mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010",head="rna_z1d",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mx=-40,mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="うんうん",time=500,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0009",head="rna_z1d",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000529",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa, m-muchacha.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0012",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000349",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Oh, oh, oh...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0009",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000530",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué haces gruñendo mientras observas tu mano derecha?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000350",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Estoy disfrutando de la sensación de tu mano izquierda.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0011",head="rna_z1d",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000531",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fuh, no vengas a decir ahora en voz alta que te autocomplacerás con eso o algo\nasí.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000351",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Si lo hago en voz bajita si puedo decirlo?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0008",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000532",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, si es lo suficientemente baja para que solo yo la escuche, entonces el\ndaño sería mucho menor...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2d0100",face="d0011",head="rna_z2d",x=-345,lv=5,id=5,sync=0},
{"extrans",time=500},
{"se",file="se9010",vol=30,id=1},
{"fg",ch="優美",size="z2",sync=1,mx=40,mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2b0110",face="b0016",head="yum_z2b",x=345,lv=5,id=4},
{"text"},
text={
ja={
{
"Yuumi se acerca a mi súbitamente.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_yum_000352",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me mashturbaré recordando la sensación de tu manita izquierda, Rinaaa.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0014",head="rna_z2d",x=-345,lv=5,id=5},
{"fgact",ch="里奈",act="びっくり",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0005",head="rna_z2d",x=-345,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000533",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡N-No me susurres esas cosas al oído, me asustaste! ¡¿Y además, qué clase de\nactuación de niña boba es esa?!”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2b0110",face="b0004",head="yum_z2b",x=345,lv=5,id=4},
{"fgact",ch="優美",act="うんうん",lv=5,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000353",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo intentaré de nuevo entonces.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"se",file="se9010",id=1,vol=30},
{"fgact",ch="優美",act="いいえ",size=3,lv=5,id=4},
{"text"},
text={
ja={
{
"Yuumi vuelve a acercar su boca a mi oreja.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0006",head="rna_z2d",x=-345,lv=5,id=5},
{"fgact",ch="里奈",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000534",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡No hace falta que lo hagas!”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2d0100",face="d0005",head="rna_z2d",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000535",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por Dios...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Yuumi es siempre así.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Por supuesto, tampoco es que siempre ha sido así desde que nos conocimos.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"La Yuumi que conocí al principio era totalmente distinta a la de ahora. Era\notra persona. Probablemente las amigas que la conocieron en el pasado no la\nreconocerían al verla ahora.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Así de drástico ha sido el cambio que ha tenido en comparación a entonces.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000354",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina me está viendo ahora fijamente. ¿Será que estás pensando en mí?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010",head="rna_z1d",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000536",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, pues sí.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000355",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Será, será entonces que--?!”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0017",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000537",ch="rna"},
},
ja={
{
name={"Rina"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0010",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000356",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero, aún no he dicho nada...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_rna_000538",ch="rna"},
},
ja={
{
name={"Rina"},
"“Con toda seguridad ibas a decir algo que no es cierto.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000357",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Muuuh, ¿qué te cuesta dejarme decirlo?...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000358",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Decir lo mucho que estabas pensando en masturbarte pensando en mí!”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0015",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000539",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaaa, ¿por qué esta muchacha terminó así?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000359",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Mi amor por ti me convirtió en esto!”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0009",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000540",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si es así, entonces eso me hace culpable.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000360",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tu lindura es un crimen.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000541",ch="rna"},
},
ja={
{
name={"Rina"},
"“Un crimen, eh...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000542",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tal vez lo sea...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"bgm",stop=1,time=1000},
{"bg",time=1000,file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="zev_uni_c28_01",speed=180000,path=":ev/ev_uni_c28/",set="ev_uni_c28",x2=-160,y2=-540,x=-960,y=-540,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1500},
{"bgm",file="bgm038"},
{"text"},
text={
ja={
{
"En la noche de los cipreses.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Aquella noche antes de que los cipreses se convirtieran en cerezos.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"La niña estaba esperando por el lobo, tiza blanca en mano.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"La niña germinó y creció allí, para ser devorada por el lobo.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Así que el lobo fue, probablemente, víctima de la tetrodotoxina.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"El lobo sucumbió al veneno.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"La niña que el lobo devoró tenía una dieta a base de 'UFT Sunfural S'.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Al alimentarse de veneno, naturalmente este se acumulaba en su cuerpo. Ella era\nuna seta venenosa, del género de las Amanita, con tallo y sombrilla blanca.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"La niña Amanita atrae a los demás con una sonrisa. La niña Amanita está siempre\nsonriendo entre todos.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Una seta venenosa, sola, oculta en el bosque de cipreses. Ni siquiera el lobo\npodría resistirse a poner sus garras sobre ella.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Y por eso, ella es la víctima.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"bgm",stop=1,time=1000},
{"bg",time=1000,file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0010",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",x=345,lv=4,id=6},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000361",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Rina?... ¿Pasa algo?”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",size=5,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000543",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Ah, eh? No, no sucede nada.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0011",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000362",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“De repente te quedaste sin decir nada. Pensé que te habías enojado y me sentí\nalgo intranquila.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000544",ch="rna"},
},
ja={
{
name={"Rina"},
"“Oye, Yuumi. ¿Alguna vez has tocado a un lobo?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000363",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿A un lobo? Pues, no, jamás lo he hecho... ¿Tú sí?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000545",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, tal vez, creo.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000364",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Tal vez?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000546",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, tal vez haya sido un señor lobo.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000365",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000547",ch="rna"},
},
ja={
{
name={"Rina"},
"“No tiene tanta importancia.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"msgoff"},
{"bg",file="bluesky_summer",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"El lobo tiene colmillos, y unas enormes garras.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"El filo de ellas es suficiente como para cortar en pedazos a cualquier persona.\nPero su pelaje es suave.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Y cuando este duerme, más aún.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
