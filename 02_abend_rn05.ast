linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani ¿está bien si Shizuku viene con nosotros?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001324",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Ja? ¿Qué ideas le metiste a Shizuku para verla en traje de baño?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Pero de dónde sacas eso?!”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0005",head="mak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001325",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te vi susurrándole al oído, así que pensé que le habías dicho alguna cochinada\npara que aceptara.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000350",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tranquila. Admito que Naoya es una bestia pervertida y un protagonista de lo\nmás depravado, pero no soy tan débil como para que él me manipule...”",
{"rt2"},
},
},
},
