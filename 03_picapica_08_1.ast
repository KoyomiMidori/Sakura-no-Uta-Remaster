astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c05_01",path=":ev/ev_eye_c05/",set="ev_eye_c05"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"se",id=1,file="se2225"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm109"},
{"text"},
text={
ja={
{
"La campana de la puerta resuena en el silencioso interior del local. Detengo\nlos estudios por un momento y levanto ligeramente los ojos.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"El lugar donde estoy ahora y que se ha vuelto casi que mi puesto designado está\nrodeado de varias plantas decorativas que sirven de partición, por lo que\npuedo ver lo que sucede en el interior de todo el local sin peligro a que me\nvean.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="麗華",size="z1",mode=3,resize=1,path=":fg/rei/z1/",file="rei_z1a0000",face="a0001",head="rei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000001",ch="rik"},
},
ja={
{
name={"???"},
"“Hmph--, así que es aquí.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_obs_000016",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Sí, este es el lugar.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_bit_000021",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“¡Bienvenidas～! Les guiaré hasta su mesa, si no es molestia esperen un m--”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="fem_obs_000017",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Ah, no hace falta.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_bit_000022",ch="bit"},
},
ja={
{
name={"Muchaha"},
"“Jaa～...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="麗華",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"La mujer que vino junto a la abogada ignoró por completo a la muchacha de medio\ntiempo y prosiguió caminando rápidamente hacia el interior de la tienda.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"La abogada coloca prudentemente el pesado empaque que llevaba en sus brazos\nsobre la mesa más cercana y sigue a la mujer.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"La muchacha de medio tiempo pone una expresión suspicaz, y entra lenta pero\ndiscretamente a la cocina. Seguramente va a avisarle a Toritani.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0001",head="rei_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000002",ch="rik"},
},
ja={
{
name={"???"},
"“¿Es este?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_obs_000018",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0010",face="a0011",head="rei_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000003",ch="rik"},
},
ja={
{
name={"???"},
"“Hmph...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Las dos se detienen frente al cuadro de la urraca. Al tomar la confirmación de\nla abogada, la mujer procede a contemplar sin reserva alguna la pintura.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0010",face="a0002",head="rei_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0005",head="rei_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rik_000004",ch="rik"},
},
ja={
{
name={"???"},
"“Sí, es que tiene que ser. Quizás engañó a los demás, pero no podrá engañarme a\nmí... Lo único que sabe hacer bien esa mujer es mentir, realmente. Pero qué\nproblema, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_obs_000019",ch="obs"},
},
ja={
{
name={"Abogada"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0005",head="rei_z1a",x=0,lv=4,id=9},
{"fgact",ch="麗華",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000005",ch="rik"},
},
ja={
{
name={"???"},
"“¿Y bien? ¿Dónde se supone que está la hija de esa mujer?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"La mujer escanea con sus ojos el interior del local portando una expresión de\nsoberbia en su rostro. No hay ningún otro cliente adentro aparte de mí.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="麗華",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0005",head="rei_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003092",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Señora, disculpe la intromisión, pero de seguir hablando de esa manera podría\nexaltar a los demás clientes. ¿Podría agradecerle que baje un poco el tono de\nvoz?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fgact",ch="麗華",act="びっくり",lv=4,id=9},
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0003",head="rei_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0002",head="rei_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rik_000006",ch="rik"},
},
ja={
{
name={"???"},
"“Ajaja, no hay ningún cliente, ¿a qué se debe tanta formalidad? ¿No estarán ya\npor cerrar las puertas? Con lo desierto que está aun a esta hora.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Pues, estoy yo... Aunque bueno, supongo que es difícil verme estando aquí. Me\ntraigo la silla y salgo de la cubierta de las plantas.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"La mujer me vio con el rabillo del ojo, pero decidió ignorarme por completo.\nParece que no tiene intención alguna de retirar lo que dijo.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"La mujer observa de pies a cabeza a Toritani, y se ríe de forma desdeñosa.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0001",head="rei_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0002",head="rei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="麗華",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rik_000007",ch="rik"},
},
ja={
{
name={"???"},
"“... Qué pinta tan sucia y vulgar. Aunque sí, se ve perfecta para una engendra\nde los Toritani como tú.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003093",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Viniste por algo hoy, Reika-san? Si se trata de eso podemos hablar en el fondo\no en el piso de arriba.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Reika... me lo imaginaba. Así que esta mujer es el origen de todo este\ndesastre.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0010",face="a0005",head="rei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="麗華",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0010",face="a0004",head="rei_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rik_000008",ch="rik"},
},
ja={
{
name={"Reika"},
"“¿Jaa? ¿Por qué tengo que tomarme yo la molestia de subir las escaleras e ir a\ntu cochina habitación? No logro entenderlo, sinceramente.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0010",face="a0005",head="rei_z1a",x=-345,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0009",head="mak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003094",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1c0900",face="c0001",head="mak_z1c",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
"Toritani le dice unas breves palabras en voz baja a la muchacha de medio tiempo\nque estaba justo detrás de ella observando la escena.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"se",file="se2225",id=1},
{"text"},
text={
ja={
{
"Al salir apresuradamente del local, la muchacha coloca el cartel de 'cerrado'.\nParece que entró en su descanso por los momentos.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0010",face="a0002",head="rei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="麗華",act="おじぎ",lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rik_000009",ch="rik"},
},
ja={
{
name={"Reika"},
"“Pues bien... Usé mi preciado tiempo para hacerte el favor de venir\npersonalmente hasta acá, así que me imagino que ya sabes lo que tienes que\nhacer tú ahora, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0015",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003095",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Toritani lanza un ligero suspiro, para luego ver directamente a los ojos a\nReika. Está confrontándola ahora, no como una empleada de Quimera, sino como\nMakoto Toritani.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0005",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003096",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, no sé. Ni quiero saberlo.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0010",face="a0007",head="rei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="麗華",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000010",ch="rik"},
},
ja={
{
name={"Reika"},
"“Vaya nada más...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Reika abre sus ojos y parpadea, como si estuviera fuertemente asombrada.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0009",head="rei_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="麗華",act="おじぎ",lv=4,id=9},
},
vl02={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0005",head="rei_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rik_000011",ch="rik"},
},
ja={
{
name={"麗華"},
"“Muchacha... Ya lo sabía, pero debo decirlo de todas formas. Realmente eres una\ntonta. Jaa... Qué más da. Suetake, explícale paso a paso y lentamente, de\nmanera que esta tonta entienda.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_obs_000020",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_obs_000021",ch="obs"},
},
ja={
{
name={"Abogada"},
"“La señora Reika Honma solicita la devolución del jarrón de urraca que se\nencuentra en la casa de la familia Toritani... El jarrón de 'Una imagen de un\npaisaje de nieve y una urraca'.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0005",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003097",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Devolución?... Ese jarrón es propiedad de los Toritani. ¿No está ella\nmalinterpretando las cosas?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0004",head="rei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="麗華",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0005",head="rei_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rik_000012",ch="rik"},
},
ja={
{
name={"麗華"},
"“Vaya, pero qué insolencia. Tal cual madre, tal cual hija... Ah, ahora que lo\nrecuerdo, Shizuru también era así.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"¿Shizuru?... ¿Por qué la dueña de Quimera -también prima de Toritani- salió en\nla conversación?...",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"No, no hace falta preguntar el por qué. Ya veo... Parece que la mala raíz que\nla dueña dejó en el pasado era mucho más profunda de lo que parecía.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0010",head="rei_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000013",ch="rik"},
},
ja={
{
name={"Reika"},
"“Veo que no sabes nada, así que te lo contaré. Se supone que ese jarrón de\nurraca sería para mí. A pesar de que había hablado y llegado a ese acuerdo\ncon Shizuru, esta se arrepintió y lo escondió.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0008",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0013",head="mak_z1d",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003098",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Que lo escondió?... Espera, no me digas que para eso corriste todo ese\nriesgo... ¿Todo por ese jarrón?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0002",head="rei_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000014",ch="rik"},
},
ja={
{
name={"Reika"},
"“Y algo más. No crean que no me he dado cuenta de que han colaborado con la\npolicía para interponerse ne mi camino. Hace un buen tiempo que descubrí sus\nplanes, y por eso es que tomé mi propia contramedida.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Reika le hace una señal a la abogada, apuntando con su mentón ligeramente hacia\nun lado e ignorando la pregunta de Toritani.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"La abogada desamarra el nudo del paquete envuelto en la toalla, y saca\ncuidadosamente el contenido de la caja de madera que había sido revelada.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0012",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003099",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Era un jarrón. Su diseño era exactamente el mismo al de la pintura de la urraca\ncolgada en la pared de Quimera.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0002",head="rei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="麗華",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000015",ch="rik"},
},
ja={
{
name={"Reika"},
"“Yo quiero el verdadero, y solo el verdadero. Es una crueldad para las obras de\narte que estén en manos de personas sin ojo para discernir entre una\nverdadera obra y una imitación, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0003",head="rei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="麗華",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000016",ch="rik"},
},
ja={
{
name={"Reika"},
"“Ese jarrón de urraca solo podrá mostrar su verdadero valor cuando esté en manos\nde una verdadera conocedora del arte, como lo soy yo.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0002",head="rei_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000017",ch="rik"},
},
ja={
{
name={"Reika"},
"“Así que escúchame bien. Ve y cambia el jarrón verdadero que está en la casa de\nlos Toritani con esta copia. Si haces eso, podría quizás considerar desistir\nde los cuadros de Kei.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0003",head="rei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="麗華",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000018",ch="rik"},
},
ja={
{
name={"Reika"},
"“¿Estás entendiendo lo que estoy haciendo por ti? Básicamente estoy diciéndote\nque estoy dispuesta a perdonar a Kirino Onda por haber lastimado a mi hijo.\nAgradece lo piadosa y compasiva que soy.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0006",head="mak_z1d",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003100",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Y no fue acaso tu hijo quien le causó esa grave herida a la hija de Kirino-\nsan?!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0013",head="rei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="麗華",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0002",head="rei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="麗華",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rik_000019",ch="rik"},
},
ja={
{
name={"Reika"},
"“¿Jaa? ¿Qué intentas decir? Si algo le sucedió a esa niña fue por su propia\nculpa. Además, no están en derecho alguno de achacarme la culpa a mí... Vaya\nosadía que tienen para hacer eso, me dejan atónita.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0005",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003101",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No parecen las palabras de la misma persona que trató de espiarnos metiendo un\nmicrófono en la ropa de Kirino-san... Eres de lo peor.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0002",head="rei_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000020",ch="rik"},
},
ja={
{
name={"Reika"},
"“Ah, cierto, lo olvidaba, la mujer esa destruyó el aparato. Ya le envié la\nfactura, así que recuérdale que debe pagarme.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0013",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0006",head="mak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003102",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Factura?... Reika-san, ¿estás consciente de lo que estás diciendo? ¡Lo que\nestás haciendo está penado por la ley!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0010",face="a0005",head="rei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="麗華",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0010",face="a0003",head="rei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="麗華",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rik_000021",ch="rik"},
},
ja={
{
name={"Reika"},
"“¿Qué insinúas, hija de ladrona? No podía esperar nada menos de la hija de la\nmisma ladrona que sedujo a mi hermano.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0010",face="a0005",head="rei_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000022",ch="rik"},
},
ja={
{
name={"麗華"},
"“Desde hace años ustedes las Toritani no se han cansado de ponerse en mi camino,\ny la verdad es que ya estoy harta. Y para más colmo, se robaron a Kei y a sus\ncuadros, todo propiedad de la familia Nakamura... ¿No será más bien que todos\nlos Toritani llevan sangre de ladrones por dentro?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0005",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003103",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Propiedad?... Kei es un humano, una persona, no es propiedad de nadie.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0010",face="a0004",head="rei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="麗華",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000023",ch="rik"},
},
ja={
{
name={"Reika"},
"“Ahh... Me da tanta lástima por mi hermano. Jamás debió haberse casado con esa\nmujer.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Reika lanzó un exagerado suspiro y se puso de pie. La conversación con ella no\nllega a ninguna parte.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="麗華",size="z1",mode=3,path=":fg/rei/z1/",file="rei_z1a0000",face="a0005",head="rei_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000024",ch="rik"},
},
ja={
{
name={"Reika"},
"“Vámonos ya. Tengo muchas cosas por hacer.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_obs_000022",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Entendido, Reika-sama.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="麗華",mx=-40,mode=-1,lv=4,id=9},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0005",head="mak_z1d",x2=345,x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_obs_000023",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Toritani-sama, le contactaré en unos días para arreglar los detalles, así que\nagradecería algo de su tiempo en ese momento. Muchas gracias.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"La abogada le lanza una breve e insinuante mirada a Toritani.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Sin embargo, solo fue por un instante, volviendo luego a la misma expresión\nmecánica de siempre.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_obs_000024",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Me retiro. Con su permiso.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"La abogada hace una delicada reverencia bajando la cabeza para luego seguir a\nReika.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_rik_000025",ch="rik"},
},
ja={
{
name={"Reika"},
"“Oye, Suetake. ¿No habrá manera de quedarme con el cuadro de la urraca también?\nEstoy en mi pleno y legal derecho de demandarlo, y simplemente estoy haciendo\nuso de ese derecho, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_obs_000025",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Es tal como usted dice, Reika-sama.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_rik_000026",ch="rik"},
},
ja={
{
name={"Reika"},
"“Por algo estoy invirtiendo tanto dinero en alguien tan torpe e inútil como tú,\nasí que acaba con esto lo más rápido posible, ¿te quedó claro? No me estés\ndando más preocupaciones.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_obs_000026",ch="obs"},
},
ja={
{
name={"Abogada"},
"“... Entendido.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bgm",stop=1,time=500},
{"se",file="se2225",id=1},
{"text"},
text={
ja={
{
"Reika y la abogada salen de Quimera.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0015",head="mak_z1a",lv=4,id=6},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003104",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003105",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo siento... Parece que te metí en un asunto algo descabellado.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no... No importa, de verdad. Pero... Todo lo que dijo esa mujer fueron\npuros disparates...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0006",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003106",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Es caprichosa, hace lo que le viene en gana, piensa que solo ella tiene la\nrazón, y es extremadamente terca en sus ideas... Siempre interpreta la\nrealidad a su favor.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003107",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Una vez que le achaca la culpa al otro por lo que ella hizo, ataca a la otra\npersona sin piedad ni duda alguna, como si eso fuera verdad.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0018",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003108",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La palabra 'egoísta' no basta para describirla... Aunque eso no significa que\nno lo haya sido desde hace bastante tiempo...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003109",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Al reencontrármela en la escuela dominical me dio la sensación de que los años\nhan hecho que su personalidad se vuelva aún más terca, y sinceramente, ya\npareciera no tener remedio.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... Pero, quién diría que esa mujer estuvo también involucrada en el robo en\nla casa Toritani del cual me hablaste...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003110",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque no fue Reika quien entró como tal a la casa... Parece que quien entró a\nhurtar le contó a esa mujer que fue Reika quien ordenó el robo.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, ¿la directora capturó al ladrón?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003111",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, ¿quién sabe? Parece que tiene contratado a un guardaespaldas, así que tal\nvez fue él quien lo capturó, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0015",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003112",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Escuché que resolvieron todo hablando y no llegaron a pedir intervención de la\npolicía, así que me pareció raro...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No contactaron a la policía? ¿Entonces lo que Reika dijo de colaborar con la\npolicía es todo producto de su imaginación?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003113",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así mismo. Aunque... puede que haya sido en ese momento que la abogada y la\ndirectora se conocieron.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que la abogada esa ha estado pasando por bastante trabajo también...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003114",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, así parece...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hace unos días me contaste frente al cuadro de la urraca de cómo la dueña\nengañó a alguien usando la obra que creó basándose en el cuadro, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003115",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... te lo conté. ¿Ya sabes de quién se trata?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. La pista está en lo que la dueña dijo susurrando. Lo de que la factura por\nhaber engañado tanto le salió enorme.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0015",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0025",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003116",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... Y esto es lo que faltó pagar de esa factura. Aunque, seguramente la dueña\ntampoco llegó a imaginarse que nosotros también tendríamos que pagar.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así de profundo sugieres que es el rencor y la terquedad de Reika?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0010",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0011",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003117",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Después de tantos años que han pasado, Reika-san se convirtió en un\nmonstruo que acabó superando todas las expectativas posibles de la dueña...\nSupongo que lo podrías ver de esa forma.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003118",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo siento, creo que cerraré la tienda por hoy. Contactaré a la muchacha de\nmedio tiempo y me iré a cambiar.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vas a donde la directora? Si es así entonces yo también iré.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0009",head="mak_z1b",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0017",head="mak_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003119",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No hace falta que vengas... O por lo menos quisiera decir eso, pero\nconociéndote bien como eres y después de haberte hecho escuchar todo eso,\nprobablemente me seguirás igualmente.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es, y además, ya hace un buen rato que me metí de lleno en este caso. Así\nque ríndete de una vez y llévame contigo. Quizás te pueda servir de algo.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0015",head="mak_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003120",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso ya lo sé. Dios santo... Por cosas como estas es que siempre me dejas sin\nsaber cómo reaccionar, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? ¿Incluso ahora?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0016",head="mak_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003121",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Quién sabe?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="nightsky_summer",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg059c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
"Para cuando pudimos coger a la muy ajetreada Directora, ya era de noche.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Después de haber escuchado hasta el final lo que sucedió, la directora nos vió\na Toritani y a mí.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_htd_000264",ch="htd"},
},
ja={
{
name={"Directora"},
"“Y bien, ¿qué piensan hacer ustedes?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0005",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000265",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Me van a pedir que le dé el jarrón de la urraca a ella?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003122",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No. Y es que después de todo, personas como ella nunca quedan conformes de no\nobtener absolutamente todo lo que quieren.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debe estar planeando apoderarse del jarrón de la urraca y luego de los cuadros\nde Kei.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Y por supuesto, la mujer esa no tiene ni una pizca de duda al respecto de que\nlo logrará. Seguramente cree que todo saldrá como lo desea, tal como ha\nvenido sucediendo hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0010",head="sak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="紗希",act="うなづく",lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000266",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es. Y va a ser ella quien terminará haciendo el ridículo si llega a\nobtenerlo.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000267",ch="htd"},
},
ja={
{
name={"Directora"},
"“Parece que dentro de poco se hará una exhibición de antigüedades. Los buenos\nconocedores del arte llevarán consigo sus artículos más preciados.\nSeguramente está pensando en llevar el jarrón allá.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0011",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003123",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003124",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... De ser necesario, quizás le pida a usted el jarrón de la urraca. Aunque\nigualmente me encargaré de solucionarlo todo.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0027",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003125",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Directora Toritani, no pienso pedirle que haga nada en este caso. Sin embargo,\nes importante tener contacto constante, ¿no le parece?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fgact",ch="紗希",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000268",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, ciertamente lo es. Es absolutamente esencial compartir información.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003126",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo es. Por eso es que solo vine a informarle que Reika vino buscándome, y me\npidió que cambiara el jarrón de urraca con una copia falsa.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003127",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿O quizás ya usted lo sabía? Pues parece que ha estado tramando unas cuantas\ncosas junto a esa abogada.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000269",ch="htd"},
},
ja={
{
name={"Directora"},
"“... La doctora Suetake es la abogada asesora de Reika Honma.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003128",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tiene razón. Aunque, parece estar cansada de los caprichos de Reika.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Cansancio es poco para describir lo que esa abogada debe tener sobre sus\nhombros ahora. Aun sabiendo eso, Toritani está edulcorando sus palabras.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Esa abogada está completamente exhausta y harta de las descabelladas peticiones\nde Reika. Es más que seguro que la directora se ha dado cuenta también.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003129",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, yo me encargaré de darle punto y final a este asunto por mi lado. Así\nque pongo en sus manos el asunto de la negociación.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0009",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000270",ch="htd"},
},
ja={
{
name={"Directora"},
"“No hace falta que me lo digas. No te preocupes, acabaré con esto en unos pocos\ndías. Si no tuviera la seguridad de eso no hubiera encerrado a la familia\nOnda de esa manera.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003130",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¿Tienes posibilidad de ganar?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0002",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000271",ch="htd"},
},
ja={
{
name={"Directora"},
"“La victoria se decide, por lo general, antes de ir a la batalla, ¿sabías?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bgm",stop=1,time=1000},
{"bg",time=1500,file="black",path=":bg/"},
{"ex",time=1300,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031d",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000,sync=1},
{"ex",time=1000,func="wait"},
{"se",file="se2580",id=1},
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=800,sync=1},
{"bgm",file="bgm009"},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0025",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003131",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hubieras regresado de una vez a casa, debes estar cansado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Toritani me lanza una mirada un tanto exasperada al haberla acompañado de\nvuelta a Quimera. Aunque, de su voz rebosaba consideración y amabilidad por\nmí.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vine porque vas a quedarte despierta ahora a pensar en una buena estrategia\ncontra Reika, ¿o me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003132",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmm... Pues sí. Ya que la negociación de ellas dos se está acercando, quisiera\nacabar rápidamente con el problema de mi parte.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Podrías entonces escuchar por un momento la idea que tengo?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003133",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Se te ocurrió una idea? ¿En tan corto tiempo?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, la verdad. Estás con el hombre indicado en lo que a planes siniestros\nrespecta.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003134",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Planes siniestros, eh...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no creas que es ningún plan nefasto en realidad, ni nada de eso.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003135",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso ya lo sé... Está bien, cuéntame.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
".........",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003136",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Toritani se cruza de brazos con una expresión seria al escuchar mi idea. Su\nrostro indica que está considerando seriamente en si adoptar el plan o no.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque bueno, es algo que requiere tocar un poco el tabú que tienes, así que\nsi no te agrada la idea, entonces no hace fal--”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003137",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo haré.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tan pronto y ya decidiste?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003138",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003139",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No voy a negar que mi propia filosofía de vida y mi plan de negocios como\nHakushuu Usagiko me han hecho rechazar la idea de soltar los jarrones de 'La\nLuna y las Estrellas' al mundo.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003140",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y eso no lo dije a la ligera, ni en broma. Pero estoy ahora en un dilema de\nprioridades.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003141",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quiero acabar con todo por mi parte antes de que Reika y la directora entren en\nla negociación. Y si es por eso, tomaré el plan que más rápido y pronto pueda\nejecutar.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003142",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por más que me ponga a pensar durante el poco tiempo que me queda, no creo que\npueda idear algo mejor que lo que se te acaba de ocurrir.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003143",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me conozco. Sé lo que terminaría haciendo de actuar sola. 'Oh, estoy en tercer\naño, pensaré en algo bueno', diré. ¿Y qué sucederá? Pensaré y pensaré, haré\nlas cosas mal y todo terminará en un desastre... Estoy consciente de lo\nestúpida que puedo llegar a ser.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003144",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y además, ciertamente odio bastante a Reika, pero también odio la idea de\nseguir el sendero que la directora me tendió y contribuir a que Reika termine\nhaciendo el ridículo.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La directora había dicho que habría una exposición, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003145",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, probablemente fueron la directora y la abogada a quienes se les ocurrió\ntraerme a Reika justo en este momento.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003146",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Todas las cosas importantes han venido decidiéndose a mis espaldas, y lo único\nque he hecho es ver esos resultados...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Toritani hace una mirada como viendo a lo lejos por un momento, y luego se\nencogió de hombros de manera burlona.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0028",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0025",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003147",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La otra opción sería seguir por la vía que la directora tendió y resolver todo\nde una vez. Sí... es una opción segura, pero nada interesante para mí,\nsinceramente.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003148",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si no hubiera otra alternativa, hubiese tenido que tomar la vía segura. Pero\njusto ahora me acabas de ofrecer esa otra alternativa que deseaba.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Je.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, así que tú también tienes algo de espíritu rebelde juvenil.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0028",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003149",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues créeme que sí. Diría que lo soy, y bastante empedernida. Quizás trate de\nno aparentarlo, pero no he podido en ningún momento quitarme de la cabeza el\nconflicto que he tenido con esa mujer.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0003",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003150",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y bueno, así son las cosas. Entre los planes que están a mi alcance ahora, el\nmejor es el tuyo, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, está bien.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso sí, la próxima vez cuéntame más acerca de lo empedernida que puedes ser,\n¿eh?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003151",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿P-Por qué vienes con eso de repente?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De repente? ¿No recuerdas que me llevaste hace unos días al ayuntamiento y me\ncontaste varias cosas?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003152",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"bg",file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg013b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=6,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Aquella tarde en el ayuntamiento, estando frente a ese cuadro, pude enterarme\nde varios de los sentimientos que Toritani llevaba guardado en su pecho.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002400",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Perdona que te haya contado cosas tan raras aquella vez. Pero, quería que lo\nsupieras.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002401",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque la verdad es que hay algo más que quisiera que supieras...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedes contarme lo que sea.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002402",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_002403",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero dame solo un poco más de tiempo. ¿Crees que puedas esperar un poquito más\npara escuchar todo lo que tengo que contarte?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que lo preguntes...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002404",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"cgdel",id=-1},
{"bg",file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0015",head="mak_z1a",lv=4,id=6,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003153",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Aunque vaya memoria que tienes para acordarte de eso.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani... ¿Crees que voy a olvidarme de todo lo que me contaste después de\nque me dijeras algo tan sugestivo? Y déjame agregar que además me llamas la\natención, y quiero saber qué es.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003154",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003155",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Después de que Toritani abriera y cerrara su boca repetidamente tratando de\ndecir algo, asintió ligeramente con la cabeza echada hacia abajo. Sus orejas\nestán un tanto sonrojadas.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Probablemente su parte mansa y dócil está más cercana a su verdadera esencia.\nMe parece bastante linda cuando se comporta así, y estoy seguro de que esa\nparte suya no es, en lo absoluto, una muestra de debilidad.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003156",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... Cuando todo esto termine, escucha todo... lo que tengo que decirte, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro, esperaré por ti.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
