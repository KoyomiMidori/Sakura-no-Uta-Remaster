astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"bg",file="ev_eye_c13_01",path=":ev/ev_eye_c13/",set="ev_eye_c13"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="zev_uni_c08_01",zoom=60,speed=100000,time=2000,path=":ev/ev_uni_c08/",set="ev_uni_c08",x2=192,y2=-108,x=192,y=108,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm018"},
{"text"},
text={
ja={
{
"Estaba de nuevo en ese parque, mirando el cielo.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"El mismo lugar donde me despedí del viejo, y de Kei...",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Estaba contemplando ese mundo de cerezos revoloteando, desde abajo.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004019",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tanto tiempo...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... tiempo sin verte.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004020",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Cómo te ha ido?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, ya puedes ver...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004021",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Escuché que reprobaste tus exámenes de ingreso...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no es sorpresa alguna. Me la he pasado perdiendo el tiempo, en el ocio...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004022",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Así es.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004023",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me han contado que no aplicaste a ninguna universidad de artes...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te mintieron.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Rin se recuesta en el suelo.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Y se dispuso a ver el mundo que había en ese cielo desde lo más bajo, al igual\nque yo.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"bg",file="ev_com_i10_01",path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004024",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No... volverás a pintar?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí seguiré. El año que viene aplicaré a Geidai.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004025",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Alguna otra?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No se me ha ocurrido ninguna otra... Me concentraré en Geidai.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004026",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te convertirás en pintor?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no creo.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004027",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero ya nada te impide que pintes...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004028",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya no tienes... que esconder nada.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"bg",file="ev_com_i10_02",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004029",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Todo regresó a mí el día que Kei-kun falleció.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004030",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mis recuerdos... y también mi habilidad para la pintura...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desconozco el motivo, pero... no he visto más a Sui desde entonces.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No se ha aparecido más desde el día que Kei murió...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me enfrenté con ella en un duelo de pintura.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El cual terminó en empate, pero...\nahora que me pongo a pensarlo, quizá Sui lo hizo para obligarme a usar toda mi habilidad...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es la única forma que podría empatar con ella.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias a las pistas que me dio su pintura es que pude crear un cuadro capaz de\nhacerle frente a Kei.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque bueno, terminó ganándome...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004031",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sui y tú pintando en la piscina...\nTengo recuerdos de eso.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al final, ¿quién era ella? ¿Eras tú?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004032",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Se podría decir que sí, pero también que no.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004033",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo único que sí puedo afirmar es que Sui sigue existiendo aún.\nConmigo...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004034",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku la regresó a mí.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ella la regresó?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004035",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, aunque, creo que realmente fue que no pude controlar mis emociones después\nde escuchar lo de Kei-kun...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004036",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero por ahora decidí hacerme creer que fue Shizuku quien la regresó.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku... fue quien la regresó...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004037",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Todo lo que Shizuku y tú han ocultado por mi bien... Todo eso, lo he\nrecordado...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004038",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así que...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Rin se queda sin palabras.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Conque de ahí salió ese cuadro...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"bg",file="ev_com_i10_01",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004039",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿El que presenté en la Exposición Moore?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo vi en la televisión. Me sorprendí cuando te vi.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004040",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya me lo imagino. En mi condición normal no hubiese podido ganar semejante\npremio...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estabas en condición de hacerlo, ¿no? Con tu habilidad ahora no es nada\ndifícil.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue Fridmann, ¿verdad?\nFue él quien metió tu cuadro en la séptima selección.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004041",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese cuadro fue pintado pasada la fecha final de entrega.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es decir, no pasó por el debido proceso de selección.\nY aun así, obtuvo el máximo premio de la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizá es que Fridmann ha tenido, probablemente, sus ojos puestos sobre ti todo\neste tiempo.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es posible que tu puesto haya estado reservado desde hace un buen rato...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004042",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Rin no contestó nada.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese cuadro está hecho exactamente como el viejo había descrito tus\nobras.\nPareciera romper la definición que existe de pintura.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La muchacha que tiene a Dios adentro, eh...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... No es algo que un humano pudiera pintar.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004043",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No es algo... que una persona pudiera pintar?...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004044",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, tal vez tengas razón...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004045",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y es que,\nlo primero que hice después de que todo regresó a mí...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004046",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No fue ni llorar a Kei-kun,o a mi madre,\nni tampoco arrepentirme por la estupidez que cometí.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004047",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Menos aun intentar compensarle a todos por lo que hice.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004048",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo primero y único que hice... fue pintar.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004049",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mientras todos lloraban, y estaban en duelo por Kei-kun...\nYo simplemente pintaba.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004050",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pintar, y pintar, y pintar.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"bg",file="ev_com_i10_02",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004051",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo eso...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo cual te ganó un galardón de la Exposición Moore. Y si no fuese poco, el más\ngrande de todos, el Platine Épaulard. El segundo en Japón después de\nKenichiro Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="ev_com_i10_01",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004052",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...aunque...\nla verdad es que no me interesa mucho eso.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no digas eso. Toritani ha estado tras el premio todo este tiempo, si\nllegara a escucharte eso se enfadaría.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además, seguramente Kei también...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004053",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... ¿Kei-kun?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, probablemente Kei también se enfadaría.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004054",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te parece? Yo diría que no.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que no?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004055",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La pequeña golondrina solo quería... estar junto al príncipe.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Golondrina?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004056",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Aunque permanecer junto al príncipe era muy difícil...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004057",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ella debía volar alto, más alto que nadie... solo para estar a su lado...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004058",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tal cual como lo escuchas...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué estupidez... ¿Qué intentas decir?...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ustedes siempre han volado alto――",
{"rt2"},
"　　　　　　　　　　　　　　　　――y siempre soy yo el que se queda atrás.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004059",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"bg",file="ev_com_i10_02",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004060",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun... No lo logras entender...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entender qué?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004061",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No entiendes nada,\npor eso Kei-kun tuvo que llegar al extremo de crear semejante obra.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004062",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo sí entiendo muy bien lo que él sentía...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004063",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hubiese sido mucho mejor si la golondrina se hubiese enamorado de una simple\nestatua de cobre...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004064",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De esa manera hubiesen podido estar juntos en medio del frío...\nAún cuando la muerte les esperase...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004065",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quizá el frío congele el cuerpo, pero estando juntos se consigue calor...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004066",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No hay razón alguna para que la golondrina viaje a Egipto...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La golondrina sí irá a Egipto.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tanto Kei... como tú...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero está bien que se marchen.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las estaciones cambian, y siempre habrá un lugar a donde regresar.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"bg",file="ev_com_i10_01",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004067",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Un lugar a donde regresar?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por más alto que vuelen, tarde o temprano las alas se quedarán sin fuerza.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y necesitan un lugar donde regresar.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004068",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Hablas de Kei-kun y yo?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ustedes dos.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei partió a un lugar muy lejano, pero su lugar de retorno está acá.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al igual que tú.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las estaciones cambian... Y solo tienen que volar acá cuando llegue el momento.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004069",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Una y otra vez?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, las estaciones van y vienen una y otra vez.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"bg",file="ev_com_i10_03",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004070",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Definitivamente como artista te pareces a los cerezos.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004071",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Siempre tan casualmente haciendo florecer flores milagrosas, una y otra vez.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004072",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero es algo tan cotidiano que florezcan, que las personas no se dan cuenta del\nmilagro que representa...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004073",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque sus flores caigan y desaparezcan...\nEn sus ramas florecen nuevamente.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004074",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ese gigantesco tronco sienta profundamente raíz en el suelo, y se extiende sin\nfin hasta el cielo...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004075",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y cada vez que sus flores caen, el tronco se vuelve más grande, las ramas más\naltas, la raíz más profunda, penetrando más aún el suelo.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"bg",file="ev_com_i10_02",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004076",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo Kei-kun sabía eso...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004077",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por eso él pintó ese cuadro.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004078",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y superó ese límite...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si yo soy cerezos, entonces tú debes ser algo más grande...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El viejo solía decirlo.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"bg",file="ev_com_i10_01",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004079",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Lo de que... tengo a Dios, dentro de mí?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bg",file="ev_com_i10_02",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004080",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo. Ahora sí puedo entender muy bien lo que Kenichiro-san quería decir...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004081",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y del precio que hay que pagar para obtener eso...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004082",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Alas que no sientan raíz en el suelo. Por más fuertes, nobles y bellas que\nsean, no tienen sustancia...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004083",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así tenga a Dios, sin tierra donde caer perdería esas alas...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"bg",file="ev_com_i10_03",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004084",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Claro...\nPoniéndolo de esa forma me doy cuenta de lo bien que ese cuadro describe eso...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004085",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es sugestivo.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"bg",file="ev_com_i10_01",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004086",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Probablemente muy pocos podrán darse cuenta de lo que insinúa...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004087",ch="rnd"},
},
ja={
{
name={"Rin"},
"“'Soñando con mariposas'...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004088",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Una infinidad de mariposas cruzando el mar. Cubriendo el cielo entre tantas...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004089",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahí no hay tierra alguna. Solo un hermoso y translúcido abismo que se extiende\nhasta la nada.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004090",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero eso es un sueño. Esa imagen es solo un sueño.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004091",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y a pesar de eso,\nel mundo real termina intercambiándose fácilmente con ese instante de sueño.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004092",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La tierra al mar, el mar a la tierra.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004093",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El abismo es la tierra sobre la cual ponemos los pies.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004094",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El abismo no es la continuación del sueño.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004095",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Debajo del cielo cubierto de infinitas mariposas está el abismo.\nPero ese abismo es en realidad el suelo, nuestro suelo.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"bg",file="ev_com_i10_02",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004096",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y al pisarlo, se escucha la melodía de los sueños.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La melodía de los sueños...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es una melodía hermosa?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"bg",file="ev_com_i10_03",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004097",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, y además muy cruel.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004098",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De lo contrario, no sería hermosa...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"bg",file="ev_com_i10_01",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004099",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun... yo.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004100",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo... yo no volveré a voltear hacia atrás...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004101",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ni siquiera para eso me alcanza el tiempo...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedo imaginarlo... Partirás pronto, afuera.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004102",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No. No, no es eso...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces qué?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004103",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No es eso... La verdad es que no...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"bg",file="ev_com_i10_04",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004104",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero aun así, debo ir.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Nos quedamos viendo el cielo juntos.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"bg",file="zev_uni_c08_01",zoom=60,speed=100000,time=1000,path=":ev/ev_uni_c08/",set="ev_uni_c08",x2=192,y2=-108,x=192,y=108,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"El viento de primavera levantaba una y otra vez los cerezos.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004105",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué hermosos se ven los cerezos desde acá, acostados, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se ven preciosos.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004106",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Viendo el cielo desde lo más bajo del suelo, observando cómo los cerezos que\ncaen vuelan una y otra vez...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una vez, estuve acá con Kei...\nNos quedamos viendo el cielo en el bosque de cerezos, de esta misma manera.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004107",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Acá?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004108",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kei-kun también vio este paisaje...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Mediodía de abril, con algo de frío aún remanente en el viento.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Rin y yo estábamos ahora tumbados en el suelo, bajo la lluvia de flores de\ncerezo.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Podía ver el cielo.\nY también los cerezos.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"El viento sopla.\nLlevándoselos consigo.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Como si trataran de obstruir nuestra vista...",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Y entonces,\nlas nubes se mueven.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Lentamente...\nCorriendo por este enorme cielo...",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"bg",file="ev_com_i10_01",path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004109",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La naturaleza imita al arte...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La visión artística de Wilde...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004110",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El significado de esta pintura está en su belleza.\nY ser es su razón de existir.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Conozco esas palabras. Son las mismas con las que el poeta inglés Algernon\nSwinburne describió a 'Azaleas' de Albert Joseph Moore.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004111",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Fueron esas palabras las que pasaron a formar la raíz del esteticismo.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esteticismo... La corriente artística de finales del siglo diecinueve que\npromovía el disfrute y creación de la belleza como lo máximo.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Recuerdo que una vez me comparaste con Wilde y 'El Principe Feliz', sin embargo\nresulta que el mismo Wilde fue símbolo de esa corriente.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El viejo me contó que te enseñó arte cuando eras pequeña.\nSegún él, el arte es algo humano, y sintió que debía enseñártelo.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004112",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo cual no resultó precisamente como Kenichiro-san lo quiso...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente. 'El significado de esta pintura está en su belleza.\nY ser es su razón de existir'. ¿Habrá necesidad de intervención humana en ese caso?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004113",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Quién sabe? No sé qué pensaban Swinburne o Wilde al usar esas palabras.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero sí pareces estar clara en lo que crees.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tu esteticismo no es el mismo que se apoderó de Europa en el siglo diecinueve.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004114",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004115",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero igualmente me gusta Oscar Wilde.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004116",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Todas sus palabras parecieran reflejar lo que mi corazón siente...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004117",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La naturaleza imita al arte...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004118",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Supongo que no serán mucho de tu agrado.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En realidad no me desagradan. Me parece que describen muy bien la esencia del\narte.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque me gusta más la versión que la originó. 'El arte imita a la\nnaturaleza'.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004119",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aristóteles.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tal cual.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004120",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En ese caso, la obra artística nace de la imitación de la naturaleza. Es una\ncorriente de pensamiento muy clara, y evidentemente fuerte.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004121",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Se puede decir que la historia del arte equivale a la historia de cómo se ha\nbuscado interpretar la naturaleza.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque describiéndolo de otra manera te das cuenta de que dicho postulado no\nes inquebrantable.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La historia del arte equivale a la historia de cómo hemos buscado interpretar\nla manera en que vemos a la naturaleza.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese cambio de palabras fractura la idea de Aristóteles.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y me parece que el esteticismo representa esa fractura.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El hombre pensó por un largo tiempo que el mundo que veía era tal cual lo que\nsu retina percibía.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La humanidad estaba convencida de que la imagen percibida por el ojo era la\nmisma naturaleza.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, ver no implica construir una representación del mundo.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004122",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ciertamente. Las células nerviosas del ojo humano le dan una resolución de solo\nun millón de píxeles. Y a pesar de eso las personas siguen pidiendo cámaras\nde mayor resolución.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004123",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si el mundo reflejado en nuestra retina fuese el mundo real, entonces ese mundo\nsería pobre en esencia.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004124",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ver implica introducir valor y sentido a las cosas.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004125",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Wilde decía así.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004126",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uno no ve nada hasta que ve su belleza.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004127",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es al ver su belleza que ese algo realmente existe.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004128",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tenemos también al poeta inglés William Wordsworth, quien amaba el Distrito de\nlos Lagos y escribía simples pero apasionados poemas de apreciación a la\nnaturaleza.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004129",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Se dice que su obra poética estaba inspirada espiritualmente por la naturaleza.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004130",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sin embargo, de él Wilde dijo――”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004131",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Wordsworth fue a los lagos, pero nunca fue un poeta de ellos. Simplemente\nencontró en las piedras los sermones que ya había escondido allí.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La razón por la cual gente ve niebla ahora no es porque eso sea niebla.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La niebla existe porque muchos poetas y pintores le mostraron a la gente la\nenigmática belleza que hay en ella.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En Londres quizá haya habido niebla por siglos. Me atrevo a decir que sí.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, nadie la veía, y no sabíamos nada de ella.\nNo existió sino hasta que el arte la descubrió.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso escribió Wilde también.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya cosa que dijo, ¿no? La niebla nunca existió hasta que los artistas la\ndescubrieron...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, esta afirmación podría tomarse como correcta.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004132",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La belleza se descubre. Gracias a que ha sido descrita es que frente a nosotros\nencontramos escenarios hermosos.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004133",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La gente piensa que la naturaleza es nuestra gran madre.\nPero la realidad es otra. Ella fue nuestra creación.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Definitivamente palabras de Wilde son...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa afirmación es correcta por un lado, pero completamente incorrecta por otro.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004134",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por otro lado?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, solo es una cara de la verdad.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, Aristóteles fue un gran personaje.\nNo es posible negar lo que dijo por completo.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004135",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿A qué te refieres?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Wilde habla de la belleza como algo que ha estado siempre en la cabeza de las\npersonas.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ¿realmente es así?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso la belleza ha existido realmente en nuestras cabezas? ¿Aun antes\nde hacer contacto con la naturaleza?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004136",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No lo sé, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Alguien hizo esto.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Criaron a un gatito recién nacido dentro de una caja pintada con solo líneas\nverticales.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Era para él un mundo compuesto solo de líneas verticales, sin ninguna otra\nnoción presente.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué crees que sucedió con este gato?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004137",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué sucedió?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al parecer hicieron el experimento.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y como resultado,\nel gato no podía esquivar cilindros dispuestos horizontalmente. Siempre se golpeaba con ellos.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es decir, no podía detectar objetos horizontales.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En su cabeza no existía el concepto de horizontal. Vivía en un mundo compuesto\núnicamente de lo vertical.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004138",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué sucedió con el gato?”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se crían normalmente si los dejas crecer en el mundo exterior.\nAfuera no solo hay figuras horizontales, sino todo lo demás también.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En la naturaleza puedes encontrar todo concepto habido y por haber.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque la palabra concepto aplicada a un gato suena a algo de lenguaje...\nQuiero decir, un objeto de atención, junto a todo aquello requerido para distinguirlo de lo demás.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál será la lección de esta historia?”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El gatito no tenía todo en su cabeza desde un principio.\nEs decir, los seres vivos aprenden de la naturaleza y van descubriendo una miríada de realidades.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A final de cuentas, todo lo sacamos de la naturaleza...”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que dijo Aristoteles era completamente cierto.\nLas personas imitan a la naturaleza y crean de todo.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O eso quisiera decir, pero eso es solo una media verdad.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y es que podemos poner esto de otra manera completamente distinta.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizá fue gracias a que el gato descubrió lo horizontal, que lo horizontal\nexistió en la naturaleza.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es exactamente lo mismo a lo que se refería Wilde cuando dijo que la niebla no\nexistió hasta que el arte la descubrió.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo horizontal no existió en el mundo hasta que ese gato la descubrió.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se puede afirmar lo uno y lo otro.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál de las dos proposiciones será la correcta?”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese gato descubrió, en algún lugar, el concepto de lo horizontal.\n¿Dónde descubrimos nosotros a la belleza entonces?”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En nuestras mentes? ¿O en la naturaleza?”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿O quizá en ninguna de las anteriores, sino en algún lugar lejano?”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al sopesar en eso, me puse a pensar en algo.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La mente y la naturaleza.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Son acaso esas dos tan distintas?”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso mente y naturaleza son dos cosas totalmente diferentes?”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O más bien lo subjetivo y lo objetivo, lo interior y lo exterior, en fin, no\nimporta cómo lo llames.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La cuestión es, ¿son acaso esas dos tan distintas entre sí?”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vuelvo al tema del gato. ¿Su concepto de lo horizontal nació de la naturaleza o\nde su mente? ¿No es algo limitante pensar en solo una?”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es algo extraño pensar en que debió haber nacido de solo un lugar?”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y es que se trata de algo único en el mundo que ese gato ve.\nPensar en que lo exterior y lo interior no interfieren entre sí, ¿no será un error?”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo mismo se puede decir de la belleza.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La naturaleza imita al arte.\nO, el arte imita a la naturaleza.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parecieran ser opuestos entre sí, pero quizá en realidad digan lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O más bien, tal vez sí sean lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso explicaría muchas cosas.”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una genio poeta dijo una vez esto.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“The Brain－is wider than the Sky－",
{"rt2"},
"El cerebro es más amplio que el cielo.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"“For－put them side by side－",
{"rt2"},
"Colócalos juntos.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
name={"Naoya"},
"“The one the other will contain",
{"rt2"},
"With ease－and You－beside－”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Contendrá uno al otro, holgadamente,",
{"rt2"},
"y tú también.”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
name={"Naoya"},
"“The Brain is deeper than the sea－",
{"rt2"},
"El cerebro es más hondo que el mar.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
name={"Naoya"},
"“For－hold them－Blue to Blue－",
{"rt2"},
"Retenlos, azul contra azul.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
name={"Naoya"},
"“The one the other will absorb－",
{"rt2"},
"As Sponges－Buckets－do－”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Absorberá el uno al otro,",
{"rt2"},
"como la esponja al balde.”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
name={"Naoya"},
"“The Brain is just the weight of God－",
{"rt2"},
"For－Heft them－Pound for Pound－”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El cerebro es el mismo peso de Dios.",
{"rt2"},
"Pésalos libra por libra.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“And they will differ－if they do－",
{"rt2"},
"As Syllable from Sound－”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se diferenciarán -si se pueden diferenciar-",
{"rt2"},
"como la sílaba del sonido.”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004139",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Dickinson?”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ella misma.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizá, solo sean tan distintos como la sílaba del sonido.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez solo se diferencien en la forma de verse o sentirse.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo y mi cuerpo somos solo una parte de este mundo.”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estas palabras no están erradas.”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero de la misma forma, el mundo es también una parte que atraviesa mi cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, son frases polarizadas.”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi límite es el límite del mundo.”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Asumamos que digo eso.”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizá sea correcto, pero no vale por sí solo.”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se escucha como si alguno de los dos existiera previamente, o ambos al mismo\ntiempo.”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El límite de mi lenguaje es el límite de mi mundo.”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Justamente lo mismo aplica para esta frase.”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El gatito recién nacido observa la naturaleza y descubre el todo en su mente.\nY al descubrir el todo, ese todo existe en la naturaleza.”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es lo mismo. Nuestro mundo es bastante dinámico.”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ver, descubrir, existir, todo se produce en una especie de ciclo.”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En el límite del mundo me muevo en ciclo, y en mi límite el mundo se mueve en\nciclo.”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La naturaleza y yo estamos siempre en ciclo.”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La mente y la naturaleza están siempre en ciclo.”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso, no se puede separar una de la otra.”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Son lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es algo indiscutible. El mismo paisaje que observamos día a día contiene\nsiempre pasado, presente y futuro.”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es un compendio de fenómenos que se desplaza con el tiempo... Un compendio de\nprocesos...”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y es absurdo decir que es estático. El mundo es dinámico.”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un instante grabado no representa al mundo.”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso es que podemos caminar.”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hablar.”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pensar en pintar.”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso también podemos pararnos frente al lienzo, tomar el pincel, licuar la\npintura y grabar un instante del dinámico mundo.”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues así como el gato descubrió, nosotros también descubrimos. Descubrimos en\nla naturaleza cosas para dar, para otorgar.”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto, no siempre son cosas buenas. Pegarse con un cilindro dispuesto\nhorizontalmente duele.”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero son esas propiedades las que vamos descubriendo, el mundo y yo en mi\ninterior.”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y de esa forma el mundo y yo nos movemos en un mismo ciclo.”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La naturaleza y la mente no son entes distintos. Son elementos iguales que\nconforman a mi yo.”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004140",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo. Así que para ti, la belleza es cíclica y dinámica, así como el límite\ndel mundo y mi propio límite.”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, de eso se trata.”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"bg",file="ev_com_i10_04",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004141",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo. Quizá tengas razón, Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004142",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero ¿aplica eso también para lo que estoy a punto de decir?”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"bg",file="ev_com_i10_01",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004143",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Cuando el hombre se volvió hombre, inventó una herramienta.”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004144",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Era solo un hueso con cortes y fracturas.\nSin embargo, eran cortes y fracturas con propósito, provocadas adrede.”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un palo con cortes y fracturas? ¿Usado para medir, como una regla o algo así?”",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004145",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estás cerca. Pero no del todo. No era un instrumento para medir longitud.”",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004146",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Era un instrumento para medir el tiempo, así como los calendarios que usamos\nhoy en día.”",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004147",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Al parecer usaban ese calendario para registrar cuándo y adónde se movía su\npresa para poder cazarla.”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004148",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tomaron algo invisible como el tiempo y lo midieron.\nPor medio del número plasmaron el tiempo en ese espacio que representaba el hueso.”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004149",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El primer ser vivo en darle numeración a algo conceptual como el tiempo fue el\nhumano.”",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004150",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Según lo que propusiste, los números deben ser descubiertos en la naturaleza y\nen la mente para que existan.”",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004151",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De ser así, ¿cómo es que los números explican fenómenos que aún no han sido\nobservados en la naturaleza?”",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004152",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Cómo es que podemos explicar la naturaleza usando la matemática?”",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004153",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pitágoras, Kepler, Galileo, Descartes, Newton.”",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004154",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ellos descubrieron las leyes del mundo a través de verdades matemáticas.”",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004155",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y las respuestas que encontraron diferían por completo con las encontradas por\nlo empírico.”",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004156",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Muchos vieron al sol elevarse, a la luna girar, y observaron que el suelo era\nplano. Así que pensaron que las estrellas circulaban por encima de nuestra\ntierra plana.”",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004157",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero la matemática reveló que eso era mentira.”",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004158",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La matemática prueba verdades que no podrían ser experimentadas por el hombre,\ny las descubre.”",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004159",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La física moderna ha previsto matemáticamente una gran cantidad de fenómenos\nque no pueden todavía ser observados en experimentación.”",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004160",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El mundo matemático ha descubierto el mundo que nosotros conocemos.”",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004161",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Volviendo a tu proposición anterior...\n¿Será la mente o la naturaleza la que descubre las verdades matemáticas?...”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Eso es...”",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004162",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué significan los números?...”",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Los números.”",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
ja={
{
"Ciertamente, las verdades matemáticas no son algo que puedas descubrir\nobservando la naturaleza.\nMuchas verdades físicas se han descubierto matemáticamente previo a su observación en la naturaleza.",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
ja={
{
"¿Es entonces la mente la que descubre eso?",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
ja={
{
"¿Es que nuestra mente viene equipada por defecto con esas verdades matemáticas?",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004163",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo diría que los matemáticos más puros son creyentes del misticismo.\nFue esa creencia la que llevó a un genio matemático a crear los teoremas de\nincompletitud, según.”",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004164",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Él, una de las mentes matemáticas más grandes del siglo 20, creó la 'prueba\nontológica'.”",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004165",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y el arte portaba, muy seguramente, la misma forma de pensar que ese\nmatemático.”",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004166",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La pintura occidental evolucionó a través de su búsqueda de la prueba de Dios.”",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, eso es verdad...\nAsí lo dice la historia del arte...”",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"text"},
text={
ja={
{
"Las matemáticas, la astronomía, la música y el arte han tenido una relación\nestrecha en lo que concierne a la historia del arte occidental.",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"text"},
text={
ja={
{
"Cada una tiene un fuerte vínculo con la belleza matemática.",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"text"},
text={
ja={
{
"La música y el arte han descrito las bellas leyes del mundo. Eso es verdad.",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"text"},
text={
ja={
{
"Miguel Ángel, Leonardo Da Vinci, Rafael, muchos artistas del Renacimiento\nempleaban diseños matemáticos.",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"text"},
text={
ja={
{
"El número áureo, el número plateado, el triángulo áureo, el pentagrama, la\nperspectiva, números sin fin.",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"text"},
text={
ja={
{
"Y revelar estas verdades requiere siempre una difícil prueba matemática.",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"text"},
text={
ja={
{
"El número pi, el teorema de Desargues, series de Fibonacci, la espiral\nlogarítmica.",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"text"},
text={
ja={
{
"La realidad es que entre la naturaleza y la belleza se esconden muchos factores\nmatemáticos.",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004167",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La verdad matemática existe, hayan o no personas.”",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004168",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No es así?”",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004169",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿O será acaso que dichas verdades cambian cuando no hay personas?”",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No... Aunque la humanidad se extinga la verdad matemática no desaparecerá...”",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Probablemente exista sin vínculo alguno a la mente humana...”",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004170",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué los números son hermosos? Preguntar eso es lo mismo a preguntar por\nqué la novena sinfonía de Beethoven es hermosa.”",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004171",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si no lo sabes, nadie más podrá explicarte.”",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004172",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sé que los números son hermosos. Si no lo son, entonces nada lo es.”",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004173",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso dijo una vez el famoso matemático húngaro Paul Erdős.”",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004174",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Incluso en el campo de la matemática se busca la belleza en las demostraciones.”",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004175",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Se persigue la elegancia. ¿Por qué será?”",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Porque muchas de esas formulas son... bellas?”",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004176",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quizá por ser bellas es que las formulas describen a nuestro mundo.”",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004177",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Paul Erdős decía que Dios tenía un libro con las demostraciones matemáticas\nmás hermosas habidas.”",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dios...”",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004178",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, tras la belleza siempre se encuentra Dios.”",
{"rt2"},
},
},
},
linkback="block_00378",
linknext="block_00380",
},
block_00380={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004179",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo pienso esto.”",
{"rt2"},
},
},
},
linkback="block_00379",
linknext="block_00381",
},
block_00381={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004180",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La belleza y su verdad existen independientemente de si hay o no humanos.”",
{"rt2"},
},
},
},
linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004181",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La belleza es independiente en sí, e independiente existe.”",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso es que tu estética no requería de espectadores...”",
{"rt2"},
},
},
},
linkback="block_00382",
linknext="block_00384",
},
block_00384={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, si lo que dices es cierto entonces no habría razón para meter a los\ndemás a juzgar el valor de la belleza.”",
{"rt2"},
},
},
},
linkback="block_00383",
linknext="block_00385",
},
block_00385={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una belleza sin personas de por medio, eh... Debe ser una muy estoica...”",
{"rt2"},
},
},
},
linkback="block_00384",
linknext="block_00386",
},
block_00386={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004182",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Artistas así hay.”",
{"rt2"},
},
},
},
linkback="block_00385",
linknext="block_00387",
},
block_00387={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004183",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La autora del poema que recitaste hace un momento, por ejemplo.”",
{"rt2"},
},
},
},
linkback="block_00386",
linknext="block_00388",
},
block_00388={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004184",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Emily Dickinson solo llegó a publicar siete poemas en toda su vida.”",
{"rt2"},
},
},
},
linkback="block_00387",
linknext="block_00389",
},
block_00389={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004185",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A pesar de haber escrito más de mil setecientos de ellos.”",
{"rt2"},
},
},
},
linkback="block_00388",
linknext="block_00390",
},
block_00390={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004186",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué solo publicó siete poemas?”",
{"rt2"},
},
},
},
linkback="block_00389",
linknext="block_00391",
},
block_00391={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004187",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Acaso sus poemas realmente requerían de espectadores?”",
{"rt2"},
},
},
},
linkback="block_00390",
linknext="block_00392",
},
block_00392={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00391",
linknext="block_00393",
},
block_00393={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004188",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Durante la era soviética, había un genio conductor de la Filarmónica de\nLeningrado llamado Yevgueni Mravinski.”",
{"rt2"},
},
},
},
linkback="block_00392",
linknext="block_00394",
},
block_00394={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004189",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uno de sus ensayos alcanzó un nivel de perfección tan alto que ni siquiera él\nse lo podía creer.”",
{"rt2"},
},
},
},
linkback="block_00393",
linknext="block_00395",
},
block_00395={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004190",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mravinsky experimentó algo fuera de este mundo durante el clímax de esa\nejecución.”",
{"rt2"},
},
},
},
linkback="block_00394",
linknext="block_00396",
},
block_00396={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004191",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y por eso decidió cancelar la presentación oficial.”",
{"rt2"},
},
},
},
linkback="block_00395",
linknext="block_00397",
},
block_00397={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004192",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La razón que argumentó fue que 'no hay manera de que pueda volver a realizar\nuna ejecución como la de ese ensayo'.”",
{"rt2"},
},
},
},
linkback="block_00396",
linknext="block_00398",
},
block_00398={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Conozco esa historia. A veces escucho algo de música clásica, solo como\npasatiempo.”",
{"rt2"},
},
},
},
linkback="block_00397",
linknext="block_00399",
},
block_00399={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004193",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Un artista de tu talla debe haber tenido momentos así. Cuando piensas que quizá\nno deberías revelar tu obra al público.”",
{"rt2"},
},
},
},
linkback="block_00398",
linknext="block_00400",
},
block_00400={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Debo decir que es un comentario dolorosamente acertado...”",
{"rt2"},
},
},
},
linkback="block_00399",
linknext="block_00401",
},
block_00401={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004194",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tú muy bien debes saberlo, Kusanagi-kun. Para definir el valor de la belleza y\nde la ética es necesario un mediador absoluto.”",
{"rt2"},
},
},
},
linkback="block_00400",
linknext="block_00402",
},
block_00402={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004195",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Un juicio final. Bello o no, todo se dictaminará en ese día.”",
{"rt2"},
},
},
},
linkback="block_00401",
linknext="block_00403",
},
block_00403={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004196",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por eso es que un artista es capaz de dar su vida por el arte y su belleza.”",
{"rt2"},
},
},
},
linkback="block_00402",
linknext="block_00404",
},
block_00404={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es decir, Dios...”",
{"rt2"},
},
},
},
linkback="block_00403",
linknext="block_00405",
},
block_00405={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004197",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es. Las masas no determinan el valor. El espectador tampoco.”",
{"rt2"},
},
},
},
linkback="block_00404",
linknext="block_00406",
},
block_00406={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004198",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La belleza tiene valor en su existencia como belleza.”",
{"rt2"},
},
},
},
linkback="block_00405",
linknext="block_00407",
},
block_00407={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y esa es la razón de existencia del mismo Dios.”",
{"rt2"},
},
},
},
linkback="block_00406",
linknext="block_00408",
},
block_00408={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004199",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00407",
linknext="block_00409",
},
block_00409={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00408",
linknext="block_00410",
},
block_00410={
{"text"},
text={
ja={
{
"Me quedé sin argumentos...",
{"rt2"},
},
},
},
linkback="block_00409",
linknext="block_00411",
},
block_00411={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004200",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kusanagi-kun... ¿Podría preguntarte algo?”",
{"rt2"},
},
},
},
linkback="block_00410",
linknext="block_00412",
},
block_00412={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00411",
linknext="block_00413",
},
block_00413={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004201",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No tienes a Dios en ti?”",
{"rt2"},
},
},
},
linkback="block_00412",
linknext="block_00414",
},
block_00414={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa pregunta no tiene nada de sentido...”",
{"rt2"},
},
},
},
linkback="block_00413",
linknext="block_00415",
},
block_00415={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004202",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te parece?”",
{"rt2"},
},
},
},
linkback="block_00414",
linknext="block_00416",
},
block_00416={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque según tú, 'Dios' es lo que está detrás de ti al momento de pintar y\ncrear algo bello.”",
{"rt2"},
},
},
},
linkback="block_00415",
linknext="block_00417",
},
block_00417={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te refieres al Dios que vive en el Cielo, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00416",
linknext="block_00418",
},
block_00418={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004203",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es. Mi Dios es aquel que acabas de describir.”",
{"rt2"},
},
},
},
linkback="block_00417",
linknext="block_00419",
},
block_00419={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004204",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Basado en lo que la gente piensa y cree al momento de crear algo bello.”",
{"rt2"},
},
},
},
linkback="block_00418",
linknext="block_00420",
},
block_00420={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues siendo así, yo también tengo a un Dios conmigo.”",
{"rt2"},
},
},
},
linkback="block_00419",
linknext="block_00421",
},
block_00421={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004205",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo sé.\nPero tu Dios es uno que no juzga ni castiga la belleza.\nEs un Dios que no haría nada en el juicio final...”",
{"rt2"},
},
},
},
linkback="block_00420",
linknext="block_00422",
},
block_00422={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que no haría nada en el juicio final, eh...\n¿Eso crees?...”",
{"rt2"},
},
},
},
linkback="block_00421",
linknext="block_00423",
},
block_00423={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004206",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sí lo haría?”",
{"rt2"},
},
},
},
linkback="block_00422",
linknext="block_00424",
},
block_00424={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00423",
linknext="block_00425",
},
block_00425={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tu dios es trascendental. Y tu belleza, toda para ese todopoderoso ser. De esa\nforma la gente crea.”",
{"rt2"},
},
},
},
linkback="block_00424",
linknext="block_00426",
},
block_00426={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde hace mucho tiempo en occidente... no, creo que incluso se veía en las\nartes de las religiones más primitivas.”",
{"rt2"},
},
},
},
linkback="block_00425",
linknext="block_00427",
},
block_00427={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La belleza que te representa sería descrita por Wilde así.”",
{"rt2"},
},
},
},
linkback="block_00426",
linknext="block_00428",
},
block_00428={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El hombre imita a la belleza, o quizá a Dios.”",
{"rt2"},
},
},
},
linkback="block_00427",
linknext="block_00429",
},
block_00429={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues la belleza ha existido mucho antes que el hombre.”",
{"rt2"},
},
},
},
linkback="block_00428",
linknext="block_00430",
},
block_00430={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De la misma forma que los matemáticos creen que las fórmulas han existido en su\nforma perfecta desde antes que naciera la humanidad.”",
{"rt2"},
},
},
},
linkback="block_00429",
linknext="block_00431",
},
block_00431={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y visto así, el Dios, o mejor dicho la belleza en la que yo creo es algo así.”",
{"rt2"},
},
},
},
linkback="block_00430",
linknext="block_00432",
},
block_00432={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dios,",
{"rt2"},
"　　 y la belleza,",
{"rt2"},
"imitan al hombre.”",
{"rt2"},
},
},
},
linkback="block_00431",
linknext="block_00433",
},
block_00433={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004207",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo, asumiéndolo así... significaría que la belleza es también creación del\nhombre...”",
{"rt2"},
},
},
},
linkback="block_00432",
linknext="block_00434",
},
block_00434={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así sería.”",
{"rt2"},
},
},
},
linkback="block_00433",
linknext="block_00435",
},
block_00435={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es creación del hombre, entonces no es perfecta. No hay perfección en la\nbelleza, pues esta cambia con las emociones de las personas.”",
{"rt2"},
},
},
},
linkback="block_00434",
linknext="block_00436",
},
block_00436={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No existe lógica en la belleza creada por el hombre.”",
{"rt2"},
},
},
},
linkback="block_00435",
linknext="block_00437",
},
block_00437={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004208",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué Dios tan débil sería ese.”",
{"rt2"},
},
},
},
linkback="block_00436",
linknext="block_00438",
},
block_00438={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un Dios débil... Sí, tienes razón.Su valor cambiaría dependiendo de las\nemociones de la gente. Podría ser uno que no vale ni por un centavo...”",
{"rt2"},
},
},
},
linkback="block_00437",
linknext="block_00439",
},
block_00439={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizá no tenga valor alguno para ti que puedes visualizar la idea de la\nbelleza...”",
{"rt2"},
},
},
},
linkback="block_00438",
linknext="block_00440",
},
block_00440={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizá sea un Dios débil para ti.”",
{"rt2"},
},
},
},
linkback="block_00439",
linknext="block_00441",
},
block_00441={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero... siempre que alguien se ponga frente a frente con la belleza.”",
{"rt2"},
},
},
},
linkback="block_00440",
linknext="block_00442",
},
block_00442={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O se conmueva por algo.”",
{"rt2"},
},
},
},
linkback="block_00441",
linknext="block_00443",
},
block_00443={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O haga una gran decisión.”",
{"rt2"},
},
},
},
linkback="block_00442",
linknext="block_00444",
},
block_00444={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O ame a alguien.”",
{"rt2"},
},
},
},
linkback="block_00443",
linknext="block_00445",
},
block_00445={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese Dios estará al lado de esa persona.”",
{"rt2"},
},
},
},
linkback="block_00444",
linknext="block_00446",
},
block_00446={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El Dios que nos acompaña podrá ser débil,\npero estará con nosotros siempre y cuando creamos en él.”",
{"rt2"},
},
},
},
linkback="block_00445",
linknext="block_00447",
},
block_00447={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El Dios que la gente crea es débil, puede que sí.”",
{"rt2"},
},
},
},
linkback="block_00446",
linknext="block_00448",
},
block_00448={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero justamente al crearlo nosotros, permanece con nosotros.”",
{"rt2"},
},
},
},
linkback="block_00447",
linknext="block_00449",
},
block_00449={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así veo yo la belleza...”",
{"rt2"},
},
},
},
linkback="block_00448",
linknext="block_00450",
},
block_00450={
{"bg",file="ev_com_i10_04",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004209",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si eso es el vacío, entonces el mismo vacío es así,",
{"rt2"},
"　　　　　　　　　　　　y hasta cierto grado, es compartido por todos.”",
{"rt2"},
},
},
},
linkback="block_00449",
linknext="block_00451",
},
block_00451={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004210",ch="rnd"},
},
ja={
{
name={"Rin"},
"(Y así como el todo son todos dentro de mí,",
{"rt2"},
"　　　　　　　　　también así es el todo dentro de cada uno de todos)",
{"rt2"},
},
},
},
linkback="block_00450",
linknext="block_00452",
},
block_00452={
{"bg",file="ev_com_i10_01",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004211",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Suena a Primavera y Caos.”",
{"rt2"},
},
},
},
linkback="block_00451",
linknext="block_00453",
},
block_00453={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... suena a Primavera y Caos.”",
{"rt2"},
},
},
},
linkback="block_00452",
linknext="block_00454",
},
block_00454={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004212",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00453",
linknext="block_00455",
},
block_00455={
{"bg",file="ev_com_i10_04",sync=0,face=1,time=400,path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004213",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00454",
linknext="block_00456",
},
block_00456={
{"text"},
text={
ja={
{
"Rin susurró algo.",
{"rt2"},
},
},
},
linkback="block_00455",
linknext="block_00457",
},
block_00457={
{"se",file="se9010",id=1},
{"bg",file="ev_com_i10_05",path=":ev/ev_com_i10/",set="ev_com_i10"},
{"text"},
text={
ja={
{
"Y se para.",
{"rt2"},
},
},
},
linkback="block_00456",
linknext="block_00458",
},
block_00458={
{"text"},
text={
ja={
{
"Canto el poema que Fridmann me contó una vez.",
{"rt2"},
},
},
},
linkback="block_00457",
linknext="block_00459",
},
block_00459={
{"text"},
text={
ja={
{
name={"Naoya"},
"“I dwell in Possibility―",
{"rt2"},
"Vivo en la posibilidad.”",
{"rt2"},
},
},
},
linkback="block_00458",
linknext="block_00460",
},
block_00460={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A fairer House than Prose―",
{"rt2"},
"Una casa mejor que la prosa.”",
{"rt2"},
},
},
},
linkback="block_00459",
linknext="block_00461",
},
block_00461={
{"text"},
text={
ja={
{
name={"Naoya"},
"“More numerous of Windows―",
{"rt2"},
"Que tiene más ventanas.”",
{"rt2"},
},
},
},
linkback="block_00460",
linknext="block_00462",
},
block_00462={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Superior―for Doors―",
{"rt2"},
"Y puertas superiores.”",
{"rt2"},
},
},
},
linkback="block_00461",
linknext="block_00463",
},
block_00463={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Of Chambers as the Cedars―",
{"rt2"},
"Y con cedros en sus cámaras.”",
{"rt2"},
},
},
},
linkback="block_00462",
linknext="block_00464",
},
block_00464={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Impregnable of Eye―",
{"rt2"},
"Inexpugnables al ojo.”",
{"rt2"},
},
},
},
linkback="block_00463",
linknext="block_00465",
},
block_00465={
{"text"},
text={
ja={
{
name={"Naoya"},
"“And for an Everlasting Roof",
{"rt2"},
"The Gambrels of the Sky―”",
{"rt2"},
},
},
},
linkback="block_00464",
linknext="block_00466",
},
block_00466={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y que por techo eterno tiene,",
{"rt2"},
"tejas del cielo――”",
{"rt2"},
},
},
},
linkback="block_00465",
linknext="block_00467",
},
block_00467={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Of Visitors―the fairest―",
{"rt2"},
"La visitan solo los más hermosos.”",
{"rt2"},
},
},
},
linkback="block_00466",
linknext="block_00468",
},
block_00468={
{"text"},
text={
ja={
{
name={"Naoya"},
"“For Occupation―This―",
{"rt2"},
"Y mi trabajo es.”",
{"rt2"},
},
},
},
linkback="block_00467",
linknext="block_00469",
},
block_00469={
{"text"},
text={
ja={
{
name={"Naoya"},
"“The spreading wide of narrow Hands",
{"rt2"},
"To gather Paradise―”",
{"rt2"},
},
},
},
linkback="block_00468",
linknext="block_00470",
},
block_00470={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Extender estas pequeñas manos,",
{"rt2"},
"y tomar el paraíso.”",
{"rt2"},
},
},
},
linkback="block_00469",
linknext="block_00471",
},
block_00471={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004214",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso es de Dickinson también.”",
{"rt2"},
},
},
},
linkback="block_00470",
linknext="block_00472",
},
block_00472={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, un tipejo desagradable me lo contó en el taller de los Natsume.”",
{"rt2"},
},
},
},
linkback="block_00471",
linknext="block_00473",
},
block_00473={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004215",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00472",
linknext="block_00474",
},
block_00474={
{"text"},
text={
vo={
{"vo",file="man_frd_000341",ch="frd"},
},
ja={
{
name={"???"},
"“¿Ya terminó la conversación?”",
{"rt2"},
},
},
},
linkback="block_00473",
linknext="block_00475",
},
block_00475={
{"excall",file="05_the_happy_prince_08_2"},
{"text"},
linkback="block_00474",
},
label = {
top={block="block_00000",label=1},
},
}
