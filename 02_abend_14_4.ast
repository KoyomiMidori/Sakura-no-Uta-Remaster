astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"se",file="se1279",id=1},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",lv=4,id=9},
{"bgm",file="bgm041"},
{"fg",ch="圭",size="z1",mx=40,mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0018",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000997",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡C-Compré las cosas!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, ¿comenzamos?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0110",face="a0003",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001526",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, ¿me encargo yo entonces de pelar las papas?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000991",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hay bastantes papas por pelar. ¿Quieres que lo haga yo?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001527",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, no, está bien, Rin-chan, tú encárgate de mezclar los condimentos.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0003",head="rna_z1a",x=570,lv=4,id=4},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x2=-345,x=-570,lv=4,id=5},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x2=345,x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000365",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yo también ayudaré a pelar los vegetales.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién va a picar las cebollas en dados?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=570,lv=4,id=4},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",x=-570,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001528",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tú, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Yo?! ¡Esa es la peor labor de todas!”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",x=-570,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",x=-570,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001529",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Para cortar las cebollas en dados hay que saber picarlas con buen ritmo, ¿no?\nEres el único hombre aquí que puede hacer eso.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué estás restringiendo la labor solo a hombres?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=-570,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",x=-570,lv=4,id=5},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x=-570,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001530",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Cualquiera que le toque cortar en dados esa gran cantidad de cebollas terminará\nbañado en lágrimas, ¿no? No podemos dejar que una chica haga eso. ¿No crees\nque un hombre debería hacerlo entonces?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_yum_000750",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, ciertamente también dijeron eso durante la reforma de la iglesia. ¡¿Crees\nque puedo dejar que una mujer haga eso?! o algo así.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, eso era en el sentido de la labor física que eso involucraba y de\nlo imposible que era para una mujer eso. Básicamente, la cebolla le entra en\nlos ojos a cualquiera, sea hombre o mujer, y el dolor es el mismo.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000587",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No, una mujer no debe hacer eso. ¡Carga tú con todo el dolor! ¡Eso haría un\nhombre, ¿no, Kusanagi?!”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Entonces hazlo tú!”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0006",head="mak_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001531",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No se puede hacer eso. Si Akashi-senpai llega a hacerlo seguramente terminará\nsacando cebollas cortadas en rodajas.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y por qué no usar cebollas en rodajas? En primer lugar, ¿por qué hay que usar\ncebollas cortadas en dados para un curry?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",x2=0,x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0003",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000751",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Presente yo~ Se debe a que odio la cebolla~”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Crees que voy a darle atención a ese capricho tuyo, idiota?!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001532",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A mí tampoco me gustan las cebollas cortadas en rodajas. Me gusta más con\ncebolla finamente picada.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escuchen un segundo...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x2=-345,x=0,lv=4,id=5},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x2=345,x=570,lv=4,id=6},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="man_ked_000998",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajaja, por cierto, yo tampoco puedo comer cebolla a menos que venga picada en\ndados.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre hago que te las comas, así sea a golpes, ¿no recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000992",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Quieres que las corte yo?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000366",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nosotras somos las encargadas de cortar los vegetales, podemos hacerlo\nnosotras.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x2=-345,x=-570,lv=4,id=5},
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x2=345,x=0,lv=4,id=6},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000752",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, está bien. Lo haré. ¡Lo haré, demonios!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-570,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000993",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Mierda... El terror que infundía la mirada de Kawachino cuando Hikawa dijo que\nellas podían hacerlo...",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No importa. Yo cortaré las cebollas.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Y fue así como tuve que ponerme a cortar las cebollas.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Dejo reposar lo más posible las cebollas en agua.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"De esa forma, los componentes lacrimógenos de la cebolla quedarán, en parte,\natrapados en el agua y no saldrán tan fácilmente.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Pero para esta cantidad...",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"se",id=1,file="se1049"},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0019",head="mak_z1b",x=-570,lv=4,id=3},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=3},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0020",head="kei_z1a",x=0,lv=4,id=9},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0019",head="yum_z1b",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001533",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Pica demasiado! ¡Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000999",ch="ked"},
},
ja={
{
name={"Kei"},
"“Las lágrimas no me paraaan...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0020",head="yum_z1b",x=570,lv=4,id=4},
{"fgact",ch="優美",act="いいえ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000753",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Mis ojos me pican bastanteee...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Y qué esperaban?! ¡Era obvio que sucedería esto teniendo que picar toda esta\ncantidad de cebollas en dados!”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000588",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pero qué debiluchos todos. ¿Por qué andan llorando tanto?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No voy a permitir que alguien con gafas de sol nos diga eso!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",ex03="a0097",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000754",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Enclenque!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Pero q--?! ¡¿De dónde sacaste esa máscara de gas?!”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fgact",ch="優美",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000755",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“De mi casa. La necesito al momento de manipular químicos.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No te pongas a manipular químicos que requieran esa clase de artefactos aquí\nen el club de arte! ¡Si quieres hacer eso entonces métete al club de química!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fgact",ch="優美",act="いいえ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000756",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No quiero meterme en ese club donde lo único que hacen es inspeccionar la\ncalidad del agua todos los días... Es muy aburrido, no tiene sentido entrar\nallí.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No digas eso! ¡Discúlpate con los clubes de química de todo el país!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0020",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0019",head="rna_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000994",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Realmente pica...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0020",head="rna_z1a",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000367",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues es de esperarse con esta cantidad de cebollas.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0020",head="rin_z1a",x2=-345,x=-570,lv=4,id=5},
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0020",head="rna_z1a",x2=345,x=0,lv=4,id=6},
{"fg",ch="優美",size="z1",ex03="a0097",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000757",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Toma, Rina. Esta máscara de gas es para ti.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=0,lv=4,id=6},
{"fgact",ch="里奈",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000368",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, espera un segundo. Si llego a ponerme esto no podré pelar los vegetales.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="うんうん",lv=4,id=4},
},
vl02={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",ex03="a0097",head="yum_z1a",x2="570,550",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_yum_000758",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, para nada, para nada, esta máscara tiene un campo de visión bastante\namplio. Vamos, póntelo nada más, ¿no te parece que sí?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="里奈",size="z1",ex03="a0097",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=0,lv=4,id=6},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_000369",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ohh, es verdad. El campo de visión es amplio.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No se emocionen a mi lado por una cosa con tan poco sentido!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fgact",ch="優美",act="ジャンプ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000759",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿De tan poco sentido?! ¡Pero qué irrespeto! ¡Estoy protegiendo los ojos de\nRina del gas maligno que tú estás despidiendo!”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo no lo estoy despidiendo, ni tampoco es un gas maligno. ¡En primer lugar, es\na mí a quien más le duele! ¡Me pica más a mí que a los demás!”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0021",head="mak_z1d",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001534",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Deja de perder el tiempo hablando y pica eso ya de una vez!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ya lo sé!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bgm",stop=1,time=1000},
{"fg",mode=-2},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Y finalmente, se termina de crear la montaña de cebolla picada.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Dicen que los ojos se secan y las lágrimas dejan de salir... pero eso es\nmentira.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"No hay forma de que las lágrimas dejen de salir. Siguen saliendo, y bastantes.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Y después, termina convirtiéndose en una mezcla que no se sabe si son lágrimas\no mocos.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu... bien, ya termine...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0019",head="rin_z1a",x=-570,lv=4,id=3},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",x=0,lv=4,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0019",head="mak_z1d",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000370",ch="rna"},
},
ja={
{
name={"Rina"},
"“Debes haber sufrido bastante. Te esforzaste mucho.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0020",head="rin_z1a",x=-570,lv=4,id=3},
{"fgact",ch="稟",act="おじぎ",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000995",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es increíble. Yo tampoco puedo dejar de llorar.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada más escuchándolas a ustedes, siento como si hubiera logrado algún suceso\ndigno de mucha emoción y júbilo, pero lo único que hice fue picar las\ncebollas en dados...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? Ya piqué este montón de cebolla. ¿Quién va a sofreír esto?...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0020",head="mak_z1a",x=570,lv=4,id=4},
{"fgact",ch="真琴",act="いいえ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001535",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues quién más sino tú, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Pero qué dem--?! ¡¿Sabes el trabajo tan arduo que involucra sofreír toda esta\ncantidad de cebollas?!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000996",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo lo haré.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",x=570,lv=4,id=4},
{"fgact",ch="真琴",act="いいえ",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001536",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De ninguna forma. Sofreír toda estas cebollas picará tanto a los ojos como\ncuando se cortaron. No puedo dejar que hagas esto.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0016",head="rna_z1b",x=0,lv=4,id=9},
{"fgact",ch="里奈",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000371",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Pero tenemos esta máscara de gas!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0009",head="mak_z1a",x=570,lv=4,id=4},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001537",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Obviamente no se podrá hacer con esa cosa que reduce tanto el campo de\nvisión...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0003",head="rna_z1b",x=0,lv=4,id=9},
{"fgact",ch="里奈",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0004",head="rna_z1b",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000372",ch="rna"},
},
ja={
{
name={"Rina"},
"“No, para nada. El campo de visión de esta máscara es muy bueno... pruébalo nada\nmás.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"se",file="se9010",id=1},
{"fg",ch="真琴",size="z1",ex03="a0097",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=570,lv=4,id=4},
{"fgact",ch="真琴",act="びっくり",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001538",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oh, vaya, realmente lo es. Se puede hacer bastante teniendo esto.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, bien, si van a venir a hacer ridiculeces entonces yo las sofreiré...\nDemonios, es que no hay casi nadie acá que sea capaz de freír todas estas\ncebollas...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Envuelvo las cebollas en unas servilletas que se pueden encontrar en cafés y\nrestaurantes.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Parece que Wakata las trae para usar en lugar de toallas. Vaya mentalidad de\npobre. Pero qué profesor tan malo.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0013",head="mak_z1d",lv=4,id=4},
{"fgact",ch="真琴",act="びっくり",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_mkd_001539",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Espera, espera, ¿pero qué estás haciendo? Se supone que hay que sofreírlas,\n¿por qué las envuelves en eso?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No se pueden meter todas, así que sepáralas así y caliéntalas en el microondas,\npor favor.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0012",head="mak_z1d",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001540",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Calentarlas?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sirve de atajo, y además como protección anti-lacrimógena. Toman más fácilmente\nel color caramelo cuando las calientas previamente en microondas.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001541",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿En el microondas?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ponlas por 3 minutos y medio, o por ahí.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Los componentes lacrimógenos de la cebolla son fácilmente volatilizables y\ndescomponibles, así que se pierden fácilmente al calentarlos. Mientras que\npor otro lado, sus azúcares son difíciles de volatilizar y descomponer.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Esta es la razón por la cual las cebollas se tornan dulces al sofreírlas.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Caliéntalas bastante en el microondas.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y fríe esa carne en esa sartén, por favor.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000373",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Vas a freír la carne en una sartén separada?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, la carne sabe mejor frita que cocida. Fríe también unas zanahorias y\nchampiñones en la misma sartén, y cuando termines vierte algo de agua en ella\ny échalo todo al caldero, junto al jugo de la carne.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000760",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Parece ser una preparación muy especial, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para cocinar toda esta cantidad, es mucho mejor simplificar los pasos a seguir,\n¿no? Y además, hay muchos aquí adentro. Es mejor realizar las labores lo más\nposible de forma paralela. ¿Akashi y Kei, están haciendo el arroz?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000589",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Umuh... aunque la verdad, no estoy muy seguro de poder realmente preparar arroz\nen olla...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si haces como te dije y mides bien el tiempo no habrá problema. Al terminar hay\nque subir el fuego al máximo por un momento, pero de esa parte me encargo yo.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000997",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kusanagi-kun, de verdad eres muy hábil en esto.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No soy hábil, simplemente soy un experto haciendo las cosas a lo chapucero.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-570,lv=4,id=3,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=0,lv=4,id=9,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=570,lv=4,id=4,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm037"},
{"fgact",ch="圭",act="びっくり",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="man_ked_001000",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Pero qué bueno está!”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0004",head="mak_z1a",x=0,lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001542",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ambos saben muy bien.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000998",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué alivio.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000374",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque el de Kusanagi-senpai es algo picante...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez. Mi curry es algo picante, quizás.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x2="345,325",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000761",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina odia el picante. Toma, Rina, té con leche frío.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué llevabas eso contigo?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000762",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Medidas contra el picante.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"¿Y por qué esa medida es un té con leche?",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="優美",mode=-1,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001543",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque el de Rin-chan es bastante suave, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000375",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, me gusta más este.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000999",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, sí. Mi curry quizás no sea tan picante. Comenzando porque tiene leche,\nademás.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000376",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, por eso es que es algo blanco, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001000",ch="rnd"},
},
ja={
{
name={"Rin"},
"“También tiene calabaza adentro.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0002",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_001001",ch="ked"},
},
ja={
{
name={"Kei"},
"“Creo que a mí me gusta más el curry de Naoya. El curry de Rin-chan, más que\ncurry parece una sopa de curry.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001001",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tal vez.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_001002",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Naoya! ¡Está muy bueno!”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah~, gracias, sí, por la misma reacción de siempre, realmente puedo saborear la\nalegría de haberlo preparado todo, sí...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_001003",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Pero es que realmente está muy bueno! Está delicioso, ajajaja.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="明石",act="うんうん",time=200,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000590",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Está bueno esto... Fumufumu...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Tú no leas mientras comes! ¡¿Pero qué clase de educación te han dado?!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="du",lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001544",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aún después de haber estado tres años juntos... Es la primera vez que cocinamos\nalgo todos juntos, ¿no les parece?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000377",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo mencionas, sí...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="man_wtd_000591",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues, es la primera vez que tenemos un campamento como tal, eh.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001545",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque, justamente por eso es que quería hacer el campamento en algún lugar\nlejano...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000161",ch="ksd"},
},
ja={
{
name={"???"},
"“Pudieron haber ido...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"msgoff"},
{"se",file="se1279",id=1},
{"fg",time=300,sync=1,mode=-2},
{"fg",ch="小沙智",size="z1",mx=40,mode=3,resize=1,path=":fg/kos/z1/",file="kos_z1a0100",face="a0005",head="kos_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="小牧",size="z1",mx=40,mode=3,resize=1,path=":fg/kom/z1/",file="kom_z1a0100",face="a0001",head="kom_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500,sync=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kosachi?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0008",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0009",head="kos_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000162",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Si hubiesen ido no habrían ocasionado ese enorme escándalo...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001546",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues eso está fuera de lugar, ¿no? Aunque no estuviéramos nosotros\nAkashi-senpai y Kusanagi lo hubieran hecho.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0003",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0002",head="kom_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000181",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Pero no hubieran podido terminar la obra. Si no hubieran estado todos, esa obra\nno se hubiese terminado.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001547",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De ser así, hubiera terminado como un feo garabato. ¿Aun así te parece que\ndebimos haber ido de campamento, Kosachi?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0005",head="kos_z1a",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000163",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué?... ¿Viniste a buscar pelea ahora, a este punto?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0018",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000164",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Dame algo de curry.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0007",head="kos_z1a",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0005",head="kos_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000165",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Saca curry para mí! ¡Y para Komaki también! ¡Y mi ración la quiero, grande!\n¡¿Bien?!”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0004",head="kom_z1a",x=345,lv=4,id=6},
{"fgact",ch="小牧",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000182",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Yo quiero una ración pequeña.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0001",head="kos_z1a",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000166",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Y por supuesto, de ambos tipos! ¡Sírvenos de esos dos curry!”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ¿pero es que viniste a comer curry?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0002",head="kos_z1a",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000167",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Toma, Makoto.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"se",id=1,file="se1815"},
{"text"},
text={
ja={
{
"Kosachi saca una llave.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Esa llave la he visto antes.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Cuando estábamos limpiando hace rato esa...",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001002",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esa es la llave de la piscina, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0003",head="kos_z1a",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000168",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Así es. Makoto me la pidió.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001003",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Te la pidió?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001548",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso es que me apresuré. De esa piscina se pueden ver los fuegos\nartificiales, ¿recuerdan?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_rna_000378",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso quiere decir que...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0003",head="kom_z1a",x=345,lv=4,id=6},
{"fgact",ch="小牧",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000183",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, esta es la recompensa por haber limpiado la piscina. Los profesores\nautorizaron el uso de la misma también.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-570,lv=4,id=3},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0003",head="yum_z1a",x=0,lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0001",head="kei_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000763",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿En serio?!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=0,lv=4,id=9},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000379",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Es por eso que nos pediste que trajéramos trajes de baño?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0007",head="kei_z1a",x=570,lv=4,id=4},
{"fgact",ch="圭",act="びっくり",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="man_ked_001004",ch="ked"},
},
ja={
{
name={"Kei"},
"“Yo no he escuchado nada de eso.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te puedes meter a nadar en ropa interior y ya, ¿no? Después de todo eres un\nniñito.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0006",head="kei_z1a",x=570,lv=4,id=4},
{"fgact",ch="圭",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="man_ked_001005",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué rayos dices?! ¡Me voy a enojar!”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0006",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000592",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Yo tampoco me enteré de eso. ¿Kusanagi, trajiste algo?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los shorts de gimnasia bastan y sobran.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="du",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000593",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Supongo que podré irme en uniforme entonces.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay problema con eso, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",mode=-2},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0007",head="kos_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0005",head="kos_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000169",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Por supuesto que lo hay! Toma, Wataru, Makoto me había avisado ya así que te\ntraje tu traje de baño.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"mwact",act="ジャンプ"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000594",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ohh, te lo agradezco.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0015",head="kei_z1a",lv=4,id=4},
{"fgact",ch="圭",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="man_ked_001006",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué hagoooo? Tampoco traje el uniforme de gimnasia.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te lo dije, con ir en interiores te basta, niñito.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0022",head="kei_z1a",lv=4,id=4},
{"fgact",ch="圭",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="man_ked_001007",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué tengo que hacer eso?!”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_szd_000408",ch="szd"},
},
ja={
{
name={"???"},
"“Eso suena divertido...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",lv=4,id=4},
{"fgact",ch="圭",act="びっくり",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="man_ked_001008",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"se",file="se1279",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"extrans",time=500},
{"fg",ch="雫",size="z1",sync=1,mx=40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001549",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Viniste rápido.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000409",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Terminé rápido el trabajo y vine.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0013",head="kos_z1a",x=210,lv=4,id=8},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0013",head="kom_z1a",x=680,lv=4,id=2},
{"text"},
delay={
vl01={
{"fgact",ch="小沙智",act="びっくり",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_ksd_000170",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“--¡T-Tú!”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0003",head="kom_z1a",x=680,lv=4,id=2},
{"fgact",ch="小牧",act="ジャンプ",lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0004",head="kom_z1a",x=680,lv=4,id=2},
},
},
text={
vo={
{"vo",file="fem_kmd_000184",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Ah~, eres la Kuzuka-san que sale con frecuencia en televisión, ¿verdad?\nRealmente es un honor poder conocerte en persona.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fgact",ch="小沙智",act="びっくり",lv=4,id=8},
{"text"},
delay={
vl01={
{"fgact",ch="小沙智",act="おじぎ",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_ksd_000171",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡E-Esto! ¡E-Es un placer conocerte!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0003",head="shz_z1a",x=-345,lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000410",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“El gusto es mío.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0008",head="kos_z1a",x=210,lv=4,id=8},
{"fgact",ch="小沙智",act="びっくり",lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0002",head="kos_z1a",x=210,lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_ksd_000172",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“I-Increíble... Realmente es hermosa... Realmente existe alguien así de\nhermosa...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=-345,lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000411",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tus palabras me dan bastante alegría. Muchas gracias. Aunque, dejando eso de\nlado, también hay otras visitantes más.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Visitantes?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"se",file="se1279",id=1},
{"fg",mode=-2},
{"fg",ch="ルリヲ",size="z1",mx=40,mode=3,resize=1,path=":fg/rur/z1/",file="rur_z1i0000",face="i0001",head="rur_z1i",x=-345,lv=4,id=5},
{"fg",ch="鈴菜",size="z1",mx=40,mode=3,resize=1,path=":fg/suz/z1/",file="suz_z1i0000",face="i0001",head="suz_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000011",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Howaaa, Kusanagi-chan, tiempo sin verte~”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0009",head="suz_z1i",x=345,lv=4,id=6},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000016",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Hace muy poco lo viste, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0001",head="suz_z1i",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pero q--! ¡Si son las hermanitas de Hikawa y Kawachino!”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0008",head="rur_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0004",head="rur_z1i",x=-345,lv=4,id=5},
{"fgact",ch="ルリヲ",act="びっくり",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000012",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Esto, ¿podrías dejar de llamarme 'hermanita?...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0002",head="suz_z1i",x=345,lv=4,id=6},
{"fgact",ch="鈴菜",act="du",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0001",head="suz_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_snd_000017",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Vamos, no hay ningún problema, ¿no? Por otro lado, Shizuku-sama, terminemos con\nnuestra tarea.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000412",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Cierto, cierto, estuve a punto de olvidarlo. Y bien, aquí están sus trajes de\nbaño.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="man_ked_001009",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Trajes de baño?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿También está el mío?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0003",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="du",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000413",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, Toritani-san me dijo que serían necesarios, así que los traje.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Para eso fue que viniste?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000414",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No. Para esto.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0300",face="a0001",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esp--, m-muchacha.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="man_ked_001010",ch="ked"},
},
ja={
{
name={"Kei"},
"“E-Eh, eso es muy vulgar. ¿Por qué te subes tu propia falda?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",my=40,mode=3,resize=1,path=":fg/tho/z1/",file="tho_z1a0100",face="a0002",head="tho_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000111",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“OHHH, YEEES.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0006",head="kei_z1a",x=-570,lv=4,id=3},
{"fgact",ch="圭",act="びっくり",lv=4,id=3},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=0,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0009",head="mak_z1b",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0022",head="kei_z1a",x=-570,lv=4,id=3},
{"fgact",ch="圭",act="いいえ",lv=4,id=3},
},
},
text={
vo={
{"vo",file="man_ked_001011",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Oye, en ningún momento te apareciste y vienes a salir ahora! ¡¿Dónde se supone\nque estabas escondido?! ¡Ahh, deja! ¡No veas! ¡No la veas!”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001550",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Este hombre, acaba de salir del hueco que hay entre los casilleros...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=0,lv=4,id=9},
{"fgact",ch="雫",act="du",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000415",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No hay problema. Debajo está mi traje de baño.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0015",head="kei_z1a",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0005",head="kei_z1a",x=-570,lv=4,id=3},
{"fgact",ch="圭",act="うなづく",lv=4,id=3},
},
},
text={
vo={
{"vo",file="man_ked_001012",ch="ked"},
},
ja={
{
name={"Kei"},
"“P-Pero aun así, eso es impropio de una dama. ¡No puedes hacer eso!”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aún tratándose de un traje de baño, si haces eso entonces...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000416",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No funcionó?... Naoya, ¿odias este tipo de cosas?...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es que las odie... más bien, me gustan, pero...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=0,lv=4,id=9},
{"fgact",ch="雫",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000417",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Lo hago otra vez?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No! ¡Está bien! ¡Me harás sufrir de muchas formas si lo haces acá!”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0017",head="mak_z1d",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001551",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿El problema es el lugar?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es eso...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0003",head="shz_z1a",x=0,lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000418",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Entonces, ¿lo hacemos en la casa?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"se",id=1,file="se3214"},
{"fg",mode=-2},
{"fg",ch="稟",size="z1",my=40,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="里奈",size="z1",my=40,mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
"*gata*",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001552",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¿Por qué se pararon de repente? Ustedes dos...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001004",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Ah... esto...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000380",ch="rna"},
},
ja={
{
name={"Rina"},
"“M-Mera casualidad...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001553",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De verdad? Pero, tus gustos en trajes de baño rayan en lo pervertido,\nKusanagi. Si te gustan los trajes de baño blancos entonces existe la\nposibilidad de que al levantar la falda se te parezcan a unas panties de\nverdad y sientas el doble de felicidad, o algo así, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir con esa doble felicidad?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000419",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tanto las panties como los trajes de baño tienen sus buenos aspectos por\nseparado. ¿Es eso?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, es cercano a eso... ¡Espera, esa no es la cuestión!”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0005",head="rna_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001005",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_rna_000381",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001554",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué les pasa a ustedes dos?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000382",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Je?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001006",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Acerca... de qué?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",mode=-2},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0009",head="suz_z1i",x=0,lv=4,id=9},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0002",head="suz_z1i",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_snd_000018",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Fuu, ¿les molesta si yo también como algo de curry?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Suzuna susurra eso, algo exasperada.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0002",head="suz_z1i",x2=0,x=-345,lv=4,id=9},
{"fg",ch="ルリヲ",size="z1",mx=40,mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0007",head="rur_z1i",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="ルリヲ",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rld_000013",ch="rld"},
},
ja={
{
name={"Rurio"},
"“Ah~, yo también quiero comer.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1i0000",face="i0002",head="suz_z1i",x2=-345,x=-570,lv=4,id=9},
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0007",head="rur_z1i",x2=345,x=0,lv=4,id=6},
{"fg",ch="雫",size="z1",mx=40,mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_szd_000420",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Lo mismo que la de la derecha.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Si hasta Shizuku come, ¿entonces que haremos con Ai cuando esté en casa?”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_aid_000597",ch="aid"},
},
ja={
{
name={"???"},
"“No harán ni tendrán que hacer nada, ¿en serio creían que el colegio les\nprestaría la piscina en la noche sin que esté la supervisora?...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"se",file="se1279",id=1},
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mx=40,mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, ¿Ai?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0006",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000598",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Pero cuántas veces tengo que decirte que es profesora Ai!”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x2=0,x=-345,lv=4,id=9},
{"fg",ch="圭",size="z1",mx=40,mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0018",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_001013",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Tú también estás acá, nee-chan? Pero qué glotona, eh.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"se",id=1,file="grigri"},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0007",head="aix_z1f",x=-345,lv=4,id=9},
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0007",head="aix_z1f",x2="-345,-295,-395,-295,-395,-295",x=-345,lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0007",head="kei_z1a",x=345,lv=4,id=6},
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0007",head="kei_z1a",x2="345,395,295,395,295,395",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000599",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Por qué, se supone, que soy glotona～～?!”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0100",face="a0023",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="du",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_001014",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Auch, duele, de verdad duele!”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",mode=-2},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0003",head="kom_z1a",lv=4,id=2},
{"fgact",ch="小牧",act="うなづく",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000185",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Por supuesto, no fue el consejo estudiantil quien dio la autorización, así que\ntambién tendremos la asistencia de la profesora supervisora.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Diría más bien que es sorprendente que hayan autorizado eso.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0004",head="kom_z1a",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000186",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Fue la directora quien dio la autorización.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",mode=-2},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0001",head="kos_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001555",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0015",head="kos_z1a",x=-345,lv=4,id=5},
{"fgact",ch="小沙智",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0008",head="kos_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000173",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Obviamente... ¿Crees que basta el permiso de un simple profesor para hacer esta\nclase de cosa?”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_aid_000600",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así es. Gracias a la autorización de la directora, podrán usar la piscina.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001556",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0017",head="kos_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000174",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“No pareces estar muy satisfecha.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001557",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“N-No es eso, pero...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000601",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vamos, no importa. A fin de cuentas, fue tu deseo ver los fuegos artificiales\ndesde la piscina, ¿no? No hay problema entonces.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",mode=-2},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0001",head="kos_z1a",x=-345,lv=4,id=5},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0001",head="kom_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0100",face="a0002",head="kos_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000175",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Tal cual. Así que bien, comamos rápido y vayamos a la piscina.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0100",face="a0004",head="kom_z1a",x=345,lv=4,id=6},
{"fgact",ch="小牧",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000187",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0003",head="aix_z1f",x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000602",ch="aid"},
},
ja={
{
name={"Ai"},
"“Dame un poco a mí también.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000421",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Quisiera un poco para mí también. Con mucha carne y sin vegetales.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku, eso no está bien, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
