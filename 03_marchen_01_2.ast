linkback="block_00387",
linknext="block_00389",
},
block_00389={
{"text"},
text={
vo={
{"vo",file="fem_yum_002696",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Esto... auh, m-mis, pantis...”",
{"rt2"},
},
},
},
linkback="block_00388",
linknext="block_00390",
},
block_00390={
{"text"},
text={
vo={
{"vo",file="fem_rna_000975",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué sucede con las pantis?”",
{"rt2"},
},
},
},
linkback="block_00389",
linknext="block_00391",
},
block_00391={
{"text"},
text={
vo={
{"vo",file="fem_yum_002697",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jaa, jaa, es mortificante, hacerlo sobre la tela de mis pantis.”",
{"rt2"},
},
},
},
linkback="block_00390",
linknext="block_00392",
},
block_00392={
{"text"},
text={
vo={
{"vo",file="fem_rna_000976",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Quieres tocarte directamente?”",
{"rt2"},
},
},
},
linkback="block_00391",
linknext="block_00393",
},
block_00393={
{"text"},
text={
vo={
{"vo",file="fem_yum_002698",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, ¿puedo? Jaa, jaa, ¿podría, meter mi mano en mis pantaletas, y tocar\ndirectamente, mi... coño?”",
{"rt2"},
},
},
},
linkback="block_00392",
linknext="block_00394",
},
block_00394={
{"text"},
text={
vo={
{"vo",file="fem_yum_002699",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Siempre, me masturbo... tocando directamente mi co*o, y... y, q-quisiera\nhacerlo ahora también...”",
{"rt2"},
},
},
},
linkback="block_00393",
linknext="block_00395",
},
block_00395={
{"text"},
text={
vo={
{"vo",file="fem_rna_000977",ch="rna"},
},
ja={
{
name={"Rina"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00394",
linknext="block_00396",
},
block_00396={
{"text"},
text={
vo={
{"vo",file="fem_yum_002700",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¡¿N-No puedo?!”",
{"rt2"},
},
},
},
linkback="block_00395",
linknext="block_00397",
},
block_00397={
{"text"},
text={
vo={
{"vo",file="fem_rna_000978",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. Te prohíbo que metas tus manos en tus pantaletas. ¿No podrías mejor\nbajártelas para que yo pueda ver bien cómo te tocas?”",
{"rt2"},
},
},
},
linkback="block_00396",
linknext="block_00398",
},
block_00398={
{"text"},
text={
vo={
{"vo",file="fem_yum_002701",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Mis pantis?”",
{"rt2"},
},
},
},
linkback="block_00397",
linknext="block_00399",
},
block_00399={
{"text"},
text={
vo={
{"vo",file="fem_rna_000979",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Y, me gustaría que me mostraras en qué estado estás ahí adentro. Con tus\ndos manos.”",
{"rt2"},
},
},
},
linkback="block_00398",
linknext="block_00400",
},
block_00400={
{"text"},
text={
vo={
{"vo",file="fem_yum_002702",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿C-Con mis dos manos?”",
{"rt2"},
},
},
},
linkback="block_00399",
linknext="block_00401",
},
block_00401={
{"text"},
text={
vo={
{"vo",file="fem_rna_000980",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. ¿Podrías sostener la falda con tu boca y abrir bien tu co*o con las manos\npara yo poder ver bien?”",
{"rt2"},
},
},
},
linkback="block_00400",
linknext="block_00402",
},
block_00402={
{"text"},
text={
vo={
{"vo",file="fem_yum_002703",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿M-Mi coño?!”",
{"rt2"},
},
},
},
linkback="block_00401",
linknext="block_00403",
},
block_00403={
{"text"},
text={
vo={
{"vo",file="fem_rna_000981",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí... ¿No quieres hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00402",
linknext="block_00404",
},
block_00404={
{"text"},
text={
vo={
{"vo",file="fem_yum_002704",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Para nada... me alegra bastante que me pidas eso... B-Bien, me quitaré las\npantis...”",
{"rt2"},
},
},
},
linkback="block_00403",
linknext="block_00405",
},
block_00405={
{"text"},
text={
vo={
{"vo",file="fem_rna_000982",ch="rna"},
},
ja={
{
name={"Rina"},
"“Muy bien, Yuumi. Abre bien tus sucias partes para que yo pueda ver bien.”",
{"rt2"},
},
},
},
linkback="block_00404",
linknext="block_00406",
},
block_00406={
{"text"},
text={
vo={
{"vo",file="fem_yum_002705",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí, a-abriré mis sucias partes para, para que puedas verlas bien... Kuuun.”",
{"rt2"},
},
},
},
linkback="block_00405",
linknext="block_00407",
},
block_00407={
{"se",file="se0897s",vol=50,id=1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Me voy bajando lentamente las pantaletas, así como Rina me lo ordenó. Jamás\nhabía sentido el aire del exterior en mis partes privadas.",
{"rt2"},
},
},
},
linkback="block_00406",
linknext="block_00408",
},
block_00408={
{"text"},
text={
ja={
{
"No es extraño, puesto que no es nada normal quitarse la ropa interior afuera.\nMenos aun exponer mis genitales con mi boca sosteniendo mi falda.",
{"rt2"},
},
},
},
linkback="block_00407",
linknext="block_00409",
},
block_00409={
{"text"},
text={
ja={
{
"Ya habiendo llegado hasta debajo de mis muslos, la gravedad se lleva consigo\nfácilmente mis pantaletas.",
{"rt2"},
},
},
},
linkback="block_00408",
linknext="block_00410",
},
block_00410={
{"text"},
text={
ja={
{
"La parte inferior de mi cuerpo quedó completamente descubierta.",
{"rt2"},
},
},
},
linkback="block_00409",
linknext="block_00411",
},
block_00411={
{"msgoff"},
{"bg",file="zbluesky_summer",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=960,y2=540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
vo={
{"vo",file="fem_rna_000983",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bien. Ahora dame eso.”",
{"rt2"},
},
},
},
linkback="block_00410",
linknext="block_00412",
},
block_00412={
{"text"},
text={
vo={
{"vo",file="fem_yum_002706",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eh...”",
{"rt2"},
},
},
},
linkback="block_00411",
linknext="block_00413",
},
block_00413={
{"text"},
text={
vo={
{"vo",file="fem_rna_000984",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Me las das?”",
{"rt2"},
},
},
},
linkback="block_00412",
linknext="block_00414",
},
block_00414={
{"text"},
text={
vo={
{"vo",file="fem_yum_002707",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00413",
linknext="block_00415",
},
block_00415={
{"text"},
text={
ja={
{
"Le doy a Rina mis pantis, mojadas en mis fluidos.",
{"rt2"},
},
},
},
linkback="block_00414",
linknext="block_00416",
},
block_00416={
{"text"},
text={
vo={
{"vo",file="fem_rna_000985",ch="rna"},
},
ja={
{
name={"Rina"},
"“Gracias. Uwaah, vaya que están completamente empapadas.”",
{"rt2"},
},
},
},
linkback="block_00415",
linknext="block_00417",
},
block_00417={
{"text"},
text={
ja={
{
"Rina inspecciona cuidadosamente mi ropa interior.",
{"rt2"},
},
},
},
linkback="block_00416",
linknext="block_00418",
},
block_00418={
{"text"},
text={
vo={
{"vo",file="fem_yum_002708",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No las veas con tanta fijeza.”",
{"rt2"},
},
},
},
linkback="block_00417",
linknext="block_00419",
},
block_00419={
{"text"},
text={
vo={
{"vo",file="fem_rna_000986",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué? Huelen bien... y además, también saben bien...”",
{"rt2"},
},
},
},
linkback="block_00418",
linknext="block_00420",
},
block_00420={
{"text"},
text={
vo={
{"vo",file="fem_yum_002709",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00419",
linknext="block_00421",
},
block_00421={
{"text"},
text={
ja={
{
"... La lengua de Rina se pasó por mi ropa interior.",
{"rt2"},
},
},
},
linkback="block_00420",
linknext="block_00422",
},
block_00422={
{"text"},
text={
ja={
{
"No lo puedo creer... La Rina que llevo conociendo desde hace tiempo, está\npasando ahora su boca por mis pantis. Sorbiendo mis fluidos vaginales...",
{"rt2"},
},
},
},
linkback="block_00421",
linknext="block_00423",
},
block_00423={
{"text"},
text={
vo={
{"vo",file="fem_rna_000987",ch="rna"},
},
ja={
{
name={"Rina"},
"“*yururu*... Puhaa... ¿Crees que una simple 'mejor amiga' haría esto?”",
{"rt2"},
},
},
},
linkback="block_00422",
linknext="block_00424",
},
block_00424={
{"text"},
text={
vo={
{"vo",file="fem_rna_000988",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Todavía insistes en que es imposible que seamos pareja? ¿Que se supone que soy\nyo de ti entonces, Yuumi?...”",
{"rt2"},
},
},
},
linkback="block_00423",
linknext="block_00425",
},
block_00425={
{"text"},
text={
vo={
{"vo",file="fem_yum_002710",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“R-Rinaa... Rina, eso quiere decir---”",
{"rt2"},
},
},
},
linkback="block_00424",
linknext="block_00426",
},
block_00426={
{"text"},
text={
vo={
{"vo",file="fem_rna_000989",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bien, bien, se acabó la charla. Aun no has terminado de hacer lo que te ordené.”",
{"rt2"},
},
},
},
linkback="block_00425",
linknext="block_00427",
},
block_00427={
{"text"},
text={
vo={
{"vo",file="fem_yum_002711",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo que me ordenaste...”",
{"rt2"},
},
},
},
linkback="block_00426",
linknext="block_00428",
},
block_00428={
{"text"},
text={
vo={
{"vo",file="fem_rna_000990",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Que ya se te olvidó? Te lo dije muy claro, ¿no? Sostén la falda con tu boca y\nabre bien tu co*o para que yo pueda ver.”",
{"rt2"},
},
},
},
linkback="block_00427",
linknext="block_00429",
},
block_00429={
{"text"},
text={
vo={
{"vo",file="fem_yum_002712",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No se me ha olvidado, s-sí, lo haré.”",
{"rt2"},
},
},
},
linkback="block_00428",
linknext="block_00430",
},
block_00430={
{"text"},
text={
ja={
{
"Sostengo mi falda con mi boca y pongo mi mano sobre mis genitales.",
{"rt2"},
},
},
},
linkback="block_00429",
linknext="block_00431",
},
block_00431={
{"text"},
text={
vo={
{"vo",file="fem_rna_000991",ch="rna"},
},
ja={
{
name={"Rina"},
"“No basta con una mano. Usa las dos y ábrelo bien.”",
{"rt2"},
},
},
},
linkback="block_00430",
linknext="block_00432",
},
block_00432={
{"text"},
text={
vo={
{"vo",file="fem_yum_002713",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Con las dos manos... abrirlo... bien... con, las dos... manos.”",
{"rt2"},
},
},
},
linkback="block_00431",
linknext="block_00433",
},
block_00433={
{"text"},
text={
ja={
{
"Repito las palabras de Rina como si fueran una especie de conjuro, y hago lo\nque me pidió.",
{"rt2"},
},
},
},
linkback="block_00432",
linknext="block_00434",
},
block_00434={
{"cgdel",id=-1},
{"bg",file="ev_rna_h02_05",path=":ev/ev_rna_h02/",set="ev_rna_h02"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002714",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“H-Hauuh.”",
{"rt2"},
},
},
},
linkback="block_00433",
linknext="block_00435",
},
block_00435={
{"text"},
text={
ja={
{
"Abro mi vagina con mis dos manos.",
{"rt2"},
},
},
},
linkback="block_00434",
linknext="block_00436",
},
block_00436={
{"text"},
text={
vo={
{"vo",file="fem_rna_000992",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uwaah, esto es asombroso. Oye, Yuumi, describe el estado en el que está tu co*o\nen este momento.”",
{"rt2"},
},
},
},
linkback="block_00435",
linknext="block_00437",
},
block_00437={
{"text"},
text={
vo={
{"vo",file="fem_yum_002715",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Q-Que lo describa?”",
{"rt2"},
},
},
},
linkback="block_00436",
linknext="block_00438",
},
block_00438={
{"text"},
text={
vo={
{"vo",file="fem_rna_000993",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quiero que me expliques con tus propias palabras lo que mis ojos ven. ¿No\nquieres hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00437",
linknext="block_00439",
},
block_00439={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002716",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uh～～～”",
{"rt2"},
},
},
},
linkback="block_00438",
linknext="block_00440",
},
block_00440={
{"text"},
text={
ja={
{
"Para nada. Más bien, me muero por hacerlo...",
{"rt2"},
},
},
},
linkback="block_00439",
linknext="block_00441",
},
block_00441={
{"text"},
text={
vo={
{"vo",file="fem_yum_002717",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“L-Lo haré. Lo describiré todo.”",
{"rt2"},
},
},
},
linkback="block_00440",
linknext="block_00442",
},
block_00442={
{"text"},
text={
vo={
{"vo",file="fem_rna_000994",ch="rna"},
},
ja={
{
name={"Rina"},
"“Muy bien. Ah, no vayas a soltar la falda mientras hablas, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00441",
linknext="block_00443",
},
block_00443={
{"text"},
text={
vo={
{"vo",file="fem_yum_002718",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Está bien... Jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00442",
linknext="block_00444",
},
block_00444={
{"text"},
text={
ja={
{
"Mi pecho está latiendo tan fuertemente que no alcanzo a escuchar mi propia voz.",
{"rt2"},
},
},
},
linkback="block_00443",
linknext="block_00445",
},
block_00445={
{"text"},
text={
ja={
{
"Mi respiración está tan agitada que no puedo articular bien las palabras.",
{"rt2"},
},
},
},
linkback="block_00444",
linknext="block_00446",
},
block_00446={
{"text"},
text={
vo={
{"vo",file="fem_yum_002719",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Estoy, jaa, jaa, m-muy... mojada...”",
{"rt2"},
},
},
},
linkback="block_00445",
linknext="block_00447",
},
block_00447={
{"text"},
text={
vo={
{"vo",file="fem_rna_000995",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Dónde estás mojada?”",
{"rt2"},
},
},
},
linkback="block_00446",
linknext="block_00448",
},
block_00448={
{"text"},
text={
vo={
{"vo",file="fem_yum_002720",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-En, mi co...”",
{"rt2"},
},
},
},
linkback="block_00447",
linknext="block_00449",
},
block_00449={
{"text"},
text={
vo={
{"vo",file="fem_rna_000996",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué pasa? Todo el tiempo lo dices como si nada, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00448",
linknext="block_00450",
},
block_00450={
{"text"},
text={
vo={
{"vo",file="fem_yum_002721",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡M-Mi coño!”",
{"rt2"},
},
},
},
linkback="block_00449",
linknext="block_00451",
},
block_00451={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡¡*bikunbikun*!!",
{"rt2"},
},
},
},
linkback="block_00450",
linknext="block_00452",
},
block_00452={
{"text"},
text={
vo={
{"vo",file="fem_rna_000997",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Nm?”",
{"rt2"},
},
},
},
linkback="block_00451",
linknext="block_00453",
},
block_00453={
{"text"},
text={
vo={
{"vo",file="fem_yum_002722",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jaa, jaa, jaa, jaa... auuhh.”",
{"rt2"},
},
},
},
linkback="block_00452",
linknext="block_00454",
},
block_00454={
{"text"},
text={
vo={
{"vo",file="fem_rna_000998",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Se sintió bien cuando lo dijiste?”",
{"rt2"},
},
},
},
linkback="block_00453",
linknext="block_00455",
},
block_00455={
{"text"},
text={
vo={
{"vo",file="fem_yum_002723",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí, jaa, jaa, se sintió muy bien.”",
{"rt2"},
},
},
},
linkback="block_00454",
linknext="block_00456",
},
block_00456={
{"text"},
text={
vo={
{"vo",file="fem_rna_000999",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Es que... te viniste?”",
{"rt2"},
},
},
},
linkback="block_00455",
linknext="block_00457",
},
block_00457={
{"text"},
text={
vo={
{"vo",file="fem_yum_002724",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí, un poco... me vine un poquito...”",
{"rt2"},
},
},
},
linkback="block_00456",
linknext="block_00458",
},
block_00458={
{"text"},
text={
vo={
{"vo",file="fem_rna_001000",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo. Solo con usar la palabra 'coño' te viniste.”",
{"rt2"},
},
},
},
linkback="block_00457",
linknext="block_00459",
},
block_00459={
{"text"},
text={
vo={
{"vo",file="fem_yum_002725",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. Tus órdenes, me hicieron esto... Jaa, jaa, y también, el hecho de que me\nvieras haciéndolo.”",
{"rt2"},
},
},
},
linkback="block_00458",
linknext="block_00460",
},
block_00460={
{"text"},
text={
vo={
{"vo",file="fem_rna_001001",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vaya, solo con tenerme dándote órdenes y viéndote desnuda te corriste.”",
{"rt2"},
},
},
},
linkback="block_00459",
linknext="block_00461",
},
block_00461={
{"text"},
text={
vo={
{"vo",file="fem_yum_002726",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. Me, me gustas mucho, Rina, y yo, jamás me imaginé que haría esto contigo.”",
{"rt2"},
},
},
},
linkback="block_00460",
linknext="block_00462",
},
block_00462={
{"text"},
text={
vo={
{"vo",file="fem_rna_001002",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Hacer qué?”",
{"rt2"},
},
},
},
linkback="block_00461",
linknext="block_00463",
},
block_00463={
{"text"},
text={
vo={
{"vo",file="fem_yum_002727",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hauuh. A-Auhh... A-Abrir mi coño bajo tus órdenes, acá, y contigo viéndomeee.”",
{"rt2"},
},
},
},
linkback="block_00462",
linknext="block_00464",
},
block_00464={
{"text"},
text={
vo={
{"vo",file="fem_rna_001003",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vaya panorama, eh.”",
{"rt2"},
},
},
},
linkback="block_00463",
linknext="block_00465",
},
block_00465={
{"text"},
text={
vo={
{"vo",file="fem_yum_002728",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00464",
linknext="block_00466",
},
block_00466={
{"text"},
text={
vo={
{"vo",file="fem_rna_001004",ch="rna"},
},
ja={
{
name={"Rina"},
"“Queda muy bien contigo, pequeña pervertida Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00465",
linknext="block_00467",
},
block_00467={
{"text"},
text={
vo={
{"vo",file="fem_yum_002729",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, encaja a la perfección conmigo...”",
{"rt2"},
},
},
},
linkback="block_00466",
linknext="block_00468",
},
block_00468={
{"text"},
text={
vo={
{"vo",file="fem_rna_001005",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo. Y bien, ¿quieres sentir cosas más ricas?”",
{"rt2"},
},
},
},
linkback="block_00467",
linknext="block_00469",
},
block_00469={
{"text"},
text={
vo={
{"vo",file="fem_yum_002730",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿M-Más?”",
{"rt2"},
},
},
},
linkback="block_00468",
linknext="block_00470",
},
block_00470={
{"text"},
text={
vo={
{"vo",file="fem_rna_001006",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. Haré que te sientas mucho mejor.”",
{"rt2"},
},
},
},
linkback="block_00469",
linknext="block_00471",
},
block_00471={
{"text"},
text={
vo={
{"vo",file="fem_yum_002731",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rinaa.”",
{"rt2"},
},
},
},
linkback="block_00470",
linknext="block_00472",
},
block_00472={
{"text"},
text={
ja={
{
"'Más. Quiero más placer.'",
{"rt2"},
},
},
},
linkback="block_00471",
linknext="block_00473",
},
block_00473={
{"text"},
text={
ja={
{
"Quizá fue ese deseo lo que hizo que mi dedo índice se acercara, como si por\ngravedad fuera, a mi clítoris.",
{"rt2"},
},
},
},
linkback="block_00472",
linknext="block_00474",
},
block_00474={
{"text"},
text={
vo={
{"vo",file="fem_rna_001007",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡No! No puedes tocarte ahí.”",
{"rt2"},
},
},
},
linkback="block_00473",
linknext="block_00475",
},
block_00475={
{"text"},
text={
vo={
{"vo",file="fem_yum_002732",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Je?”",
{"rt2"},
},
},
},
linkback="block_00474",
linknext="block_00476",
},
block_00476={
{"text"},
text={
ja={
{
"Yo atontada, Rina pasa suavemente su mano por mi cabello.",
{"rt2"},
},
},
},
linkback="block_00475",
linknext="block_00477",
},
block_00477={
{"text"},
text={
vo={
{"vo",file="fem_rna_001008",ch="rna"},
},
ja={
{
name={"Rina"},
"“No lo harás.”",
{"rt2"},
},
},
},
linkback="block_00476",
linknext="block_00478",
},
block_00478={
{"text"},
text={
vo={
{"vo",file="fem_yum_002733",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A-Auh...”",
{"rt2"},
},
},
},
linkback="block_00477",
linknext="block_00479",
},
block_00479={
{"text"},
text={
vo={
{"vo",file="fem_rna_001009",ch="rna"},
},
ja={
{
name={"Rina"},
"“Te prohíbo que te toques. Vas a hacer como te dije y solo abrirlo.”",
{"rt2"},
},
},
},
linkback="block_00478",
linknext="block_00480",
},
block_00480={
{"text"},
text={
vo={
{"vo",file="fem_yum_002734",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Solo abrirlo?”",
{"rt2"},
},
},
},
linkback="block_00479",
linknext="block_00481",
},
block_00481={
{"text"},
text={
vo={
{"vo",file="fem_rna_001010",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es, solo te encargarás de abrirlo. No permitiré que sigas tocándote sola.”",
{"rt2"},
},
},
},
linkback="block_00480",
linknext="block_00482",
},
block_00482={
{"text"},
text={
vo={
{"vo",file="fem_yum_002735",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué, por qué? Quiero, quiero sentir más.”",
{"rt2"},
},
},
},
linkback="block_00481",
linknext="block_00483",
},
block_00483={
{"text"},
text={
vo={
{"vo",file="fem_rna_001011",ch="rna"},
},
ja={
{
name={"Rina"},
"“Haré que te sientas mejor. Veamos, ¿que sucedería si paso mis dedos por acá?”",
{"rt2"},
},
},
},
linkback="block_00482",
linknext="block_00484",
},
block_00484={
{"text"},
text={
vo={
{"vo",file="fem_yum_002736",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00483",
linknext="block_00485",
},
block_00485={
{"se",file="se2405",id=1},
{"bg",file="ev_rna_h02_06",path=":ev/ev_rna_h02/",set="ev_rna_h02"},
{"text"},
text={
ja={
{
"Rina desliza sus manos sobre la zona de mi pubis.",
{"rt2"},
},
},
},
linkback="block_00484",
linknext="block_00486",
},
block_00486={
{"text"},
text={
vo={
{"vo",file="fem_rna_001012",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Y qué sucedería si mis dedos llegan a bajar aún más?”",
{"rt2"},
},
},
},
linkback="block_00485",
linknext="block_00487",
},
block_00487={
{"text"},
text={
vo={
{"vo",file="fem_yum_002737",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hauuh.”",
{"rt2"},
},
},
},
linkback="block_00486",
linknext="block_00488",
},
block_00488={
{"text"},
text={
ja={
{
"――*se estremece*...",
{"rt2"},
},
},
},
linkback="block_00487",
linknext="block_00489",
},
block_00489={
{"text"},
text={
ja={
{
"Mi cuerpo se estremece, y tiembla. Eso solo imaginándome el instante en que ese\ndedo índice toque mi clítoris.",
{"rt2"},
},
},
},
linkback="block_00488",
linknext="block_00490",
},
block_00490={
{"text"},
text={
ja={
{
"Sin embargo, la mano de Rina se alejó.",
{"rt2"},
},
},
},
linkback="block_00489",
linknext="block_00491",
},
block_00491={
{"text"},
text={
ja={
{
"Y entonces, comenzó a tocar mi cabello.",
{"rt2"},
},
},
},
linkback="block_00490",
linknext="block_00492",
},
block_00492={
{"text"},
text={
vo={
{"vo",file="fem_rna_001013",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sabes, Yuumi? Me encanta tu cabello.”",
{"rt2"},
},
},
},
linkback="block_00491",
linknext="block_00493",
},
block_00493={
{"text"},
text={
vo={
{"vo",file="fem_rna_001014",ch="rna"},
},
ja={
{
name={"Rina"},
"“La pequeña bestia que tanto adoro... Esa bestia que tantos llevó bajo su mando\nestá ahora temblando mientras acaricio su cabello. Esa noble y majestuosa\nbestia está ahora temblando, con su cara sonrojada.”",
{"rt2"},
},
},
},
linkback="block_00492",
linknext="block_00494",
},
block_00494={
{"text"},
text={
vo={
{"vo",file="fem_yum_002738",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y-Yo no soy noble, ni nada de--”",
{"rt2"},
},
},
},
linkback="block_00493",
linknext="block_00495",
},
block_00495={
{"text"},
text={
ja={
{
"Justo cuando traté de negar lo que Rina dijo...",
{"rt2"},
},
},
},
linkback="block_00494",
linknext="block_00496",
},
block_00496={
{"text"},
text={
vo={
{"vo",file="fem_rna_001015",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nmm.”",
{"rt2"},
},
},
},
linkback="block_00495",
linknext="block_00497",
},
block_00497={
{"text"},
text={
ja={
{
"Me sacó, súbitamente, su lengua.",
{"rt2"},
},
},
},
linkback="block_00496",
linknext="block_00498",
},
block_00498={
{"text"},
text={
ja={
{
"La lengua cubierta en saliva de Rina me tienta.",
{"rt2"},
},
},
},
linkback="block_00497",
linknext="block_00499",
},
block_00499={
{"text"},
text={
vo={
{"vo",file="fem_rna_001016",ch="rna"},
},
ja={
{
name={"Rina"},
"“Puedes chuparla.”",
{"rt2"},
},
},
},
linkback="block_00498",
linknext="block_00500",
},
block_00500={
{"text"},
text={
vo={
{"vo",file="fem_yum_002739",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tu... lengua... hauuh...”",
{"rt2"},
},
},
},
linkback="block_00499",
linknext="block_00501",
},
block_00501={
{"text"},
text={
vo={
{"vo",file="fem_yum_002740",ch="yum"},
},
ja={
{
name={"Yuumi"},
"*rero*",
{"rt2"},
},
},
},
linkback="block_00500",
linknext="block_00502",
},
block_00502={
{"text"},
text={
ja={
{
"Le doy una pequeña lamida a la lengua de Rina.",
{"rt2"},
},
},
},
linkback="block_00501",
linknext="block_00503",
},
block_00503={
{"text"},
text={
ja={
{
"Intento entonces enrollar mi lengua con la suya, pero Rina la retrae.",
{"rt2"},
},
},
},
linkback="block_00502",
linknext="block_00504",
},
block_00504={
{"text"},
text={
vo={
{"vo",file="fem_rna_001017",ch="rna"},
},
ja={
{
name={"Rina"},
"“Dime, pequeña bestia, ¿a qué sabe el cuerpo que tanto has querido comerte?”",
{"rt2"},
},
},
},
linkback="block_00503",
linknext="block_00505",
},
block_00505={
{"text"},
text={
vo={
{"vo",file="fem_yum_002741",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sabe, espectacularmente, delicioso...”",
{"rt2"},
},
},
},
linkback="block_00504",
linknext="block_00506",
},
block_00506={
{"text"},
text={
vo={
{"vo",file="fem_rna_001018",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo. Puedes chuparla entonces, pero con más delicadeza. Y con más\nintensidad.”",
{"rt2"},
},
},
},
linkback="block_00505",
linknext="block_00507",
},
block_00507={
{"text"},
text={
ja={
{
"Rina lanza una sonrisa jocosa y saca su lengua.",
{"rt2"},
},
},
},
linkback="block_00506",
linknext="block_00508",
},
block_00508={
{"text"},
text={
vo={
{"vo",file="fem_yum_002742",ch="yum"},
},
ja={
{
name={"Yuumi"},
"*Ahm*",
{"rt2"},
},
},
},
linkback="block_00507",
linknext="block_00509",
},
block_00509={
{"text"},
text={
ja={
{
"Engancho mi lengua con la de Rina.",
{"rt2"},
},
},
},
linkback="block_00508",
linknext="block_00510",
},
block_00510={
{"text"},
text={
vo={
{"vo",file="fem_rna_001019",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nm, mm, kuh, *chuu*...”",
{"rt2"},
},
},
},
linkback="block_00509",
linknext="block_00511",
},
block_00511={
{"text"},
text={
ja={
{
"Muevo la lengua de Rina dentro de su boca mientras observo cada una de sus\nreacciones.",
{"rt2"},
},
},
},
linkback="block_00510",
linknext="block_00512",
},
block_00512={
{"text"},
text={
ja={
{
"La suave y sensual sensación de su lengua, y la calidez de todos los fluidos\najenos a los míos.",
{"rt2"},
},
},
},
linkback="block_00511",
linknext="block_00513",
},
block_00513={
{"text"},
text={
ja={
{
"Mi cabeza se va derritiendo poco a poco.",
{"rt2"},
},
},
},
linkback="block_00512",
linknext="block_00514",
},
block_00514={
{"text"},
text={
vo={
{"vo",file="fem_yum_002743",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Nnm, hauuh, ngh, *kuchuu*, *chupaa*, ngh...”",
{"rt2"},
},
},
},
linkback="block_00513",
linknext="block_00515",
},
block_00515={
{"text"},
text={
vo={
{"vo",file="fem_yum_002744",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, estoy en tu boca, tu boca, hauh, *chupaa*, nnm...”",
{"rt2"},
},
},
},
linkback="block_00514",
linknext="block_00516",
},
block_00516={
{"text"},
text={
vo={
{"vo",file="fem_rna_001020",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Cómo está? ¿Está calentita? ¿Está suavecita?”",
{"rt2"},
},
},
},
linkback="block_00515",
linknext="block_00517",
},
block_00517={
{"text"},
text={
vo={
{"vo",file="fem_yum_002745",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, está suave, tan calentita. Esto es, tan sucio, nmm, *chuu*, *kuchuu*...\nhauuh.”",
{"rt2"},
},
},
},
linkback="block_00516",
linknext="block_00518",
},
block_00518={
{"text"},
text={
ja={
{
"Mis genitales palpitan, calientes. Los fluidos vaginales que estaban cayendo\nahora a gotas mojan el suelo.",
{"rt2"},
},
},
},
linkback="block_00517",
linknext="block_00519",
},
block_00519={
{"text"},
text={
vo={
{"vo",file="fem_yum_002746",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“P-Pe, pero.”",
{"rt2"},
},
},
},
linkback="block_00518",
linknext="block_00520",
},
block_00520={
{"text"},
text={
vo={
{"vo",file="fem_rna_001021",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00519",
linknext="block_00521",
},
block_00521={
{"text"},
text={
vo={
{"vo",file="fem_yum_002747",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“R-Rina, no aguanto más. No puedo seguir abriendo mi vagina con mis dedos sin\nhacer más nada. ¿N-No puedo, tocarla? Quiero, quiero tocarme.”",
{"rt2"},
},
},
},
linkback="block_00520",
linknext="block_00522",
},
block_00522={
{"text"},
text={
vo={
{"vo",file="fem_rna_001022",ch="rna"},
},
ja={
{
name={"Rina"},
"“Años tras años llevaste esperando que esto sucediera, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00521",
linknext="block_00523",
},
block_00523={
{"text"},
text={
vo={
{"vo",file="fem_rna_001023",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué no esperar unos cuantos minutos más entonces? Si te esperas un poquito\npodrás disfrutarlo más.”",
{"rt2"},
},
},
},
linkback="block_00522",
linknext="block_00524",
},
block_00524={
{"text"},
text={
vo={
{"vo",file="fem_yum_002748",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No, no puedo aguantar más. No puedo esperar más, así sea solo cuestión de\nminutos, quiero tocarmeee.”",
{"rt2"},
},
},
},
linkback="block_00523",
linknext="block_00525",
},
block_00525={
{"text"},
text={
vo={
{"vo",file="fem_rna_001024",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Tocar, tocar, tocar dónde?”",
{"rt2"},
},
},
},
linkback="block_00524",
linknext="block_00526",
},
block_00526={
{"text"},
text={
vo={
{"vo",file="fem_yum_002749",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Mi coño. Déjame tocar mi coño, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00525",
linknext="block_00527",
},
block_00527={
{"text"},
text={
vo={
{"vo",file="fem_rna_001025",ch="rna"},
},
ja={
{
name={"Rina"},
"*tiembla*...",
{"rt2"},
},
},
},
linkback="block_00526",
linknext="block_00528",
},
block_00528={
{"text"},
text={
ja={
{
"El cuerpo de Rina tiembla.",
{"rt2"},
},
},
},
linkback="block_00527",
linknext="block_00529",
},
block_00529={
{"text"},
text={
vo={
{"vo",file="fem_rna_001026",ch="rna"},
},
ja={
{
name={"Rina"},
"“No sabía que fueras capaz de verme con esa cara. Ahh, Yuumi, tú... esa noble y\nmajestuosa bestia... Jaa, jaa, está rogándome ahora, con esa cara tan\nembriagada en placer.”",
{"rt2"},
},
},
},
linkback="block_00528",
linknext="block_00530",
},
block_00530={
{"text"},
text={
vo={
{"vo",file="fem_yum_002750",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No soy ni noble ni majestuosa... kufuu... s-simplemente, me gustas.”",
{"rt2"},
},
},
},
linkback="block_00529",
linknext="block_00531",
},
block_00531={
{"text"},
text={
vo={
{"vo",file="fem_rna_001027",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa, ¿te gusto, Yuumi? ¿No me odias por obligarte a hacer todas estas\ncosas tan vergonzosas?”",
{"rt2"},
},
},
},
linkback="block_00530",
linknext="block_00532",
},
block_00532={
{"text"},
text={
vo={
{"vo",file="fem_yum_002751",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Claro que no. Me gustas, me encantas, Rina. Estoy feliz, estoy feliz de hacer\ntodo esto, de que me ordenes hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00531",
linknext="block_00533",
},
block_00533={
{"text"},
text={
vo={
{"vo",file="fem_rna_001028",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa, Yuumi, qué linda eres. ¿Por qué eres tan linda, Yuumi?... *chuu*,\nngh... *kuchuu*, *chuu*...”",
{"rt2"},
},
},
},
linkback="block_00532",
linknext="block_00534",
},
block_00534={
{"text"},
text={
ja={
{
"Rina vuelve a juntar su lengua con la mía.",
{"rt2"},
},
},
},
linkback="block_00533",
linknext="block_00535",
},
block_00535={
{"text"},
text={
ja={
{
"Y yo la recibo con alegría.",
{"rt2"},
},
},
},
linkback="block_00534",
linknext="block_00536",
},
block_00536={
{"text"},
text={
ja={
{
"Pero mi vagina seguía todavía abierta, sin poder tocarla, y goteando mis\nlíquidos.",
{"rt2"},
},
},
},
linkback="block_00535",
linknext="block_00537",
},
block_00537={
{"text"},
text={
ja={
{
"Mi hinchado y erecto clítoris ardía.",
{"rt2"},
},
},
},
linkback="block_00536",
linknext="block_00538",
},
block_00538={
{"text"},
text={
vo={
{"vo",file="fem_yum_002752",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, Rinaa, mi, mi coñooo.”",
{"rt2"},
},
},
},
linkback="block_00537",
linknext="block_00539",
},
block_00539={
{"text"},
text={
vo={
{"vo",file="fem_rna_001029",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Te sientes sola allí abajo?”",
{"rt2"},
},
},
},
linkback="block_00538",
linknext="block_00540",
},
block_00540={
{"text"},
text={
vo={
{"vo",file="fem_yum_002753",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, mi coñito se siente solo, Rinaa.”",
{"rt2"},
},
},
},
linkback="block_00539",
linknext="block_00541",
},
block_00541={
{"text"},
text={
vo={
{"vo",file="fem_rna_001030",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eres tan tierna. Jamás pensé que podría ver este lado de ti, Jaa, jaa, Yuumi,\nmi Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00540",
linknext="block_00542",
},
block_00542={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002754",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Hii?!”",
{"rt2"},
},
},
},
linkback="block_00541",
linknext="block_00543",
},
block_00543={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡¡¡¡*bikubikubiku*!!!!",
{"rt2"},
},
},
},
linkback="block_00542",
linknext="block_00544",
},
block_00544={
{"se",file="se9010",vol=20,id=1},
{"bg",file="ev_rna_h02_07",path=":ev/ev_rna_h02/",set="ev_rna_h02"},
{"text"},
text={
ja={
{
"Siento de nuevo los dedos debajo. Pero el placer que me dieron fue mucho más\ngrande a cualquiera que hubiera experimentado antes.",
{"rt2"},
},
},
},
linkback="block_00543",
linknext="block_00545",
},
block_00545={
{"text"},
text={
vo={
{"vo",file="fem_yum_002755",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Fueh? Rinaaa, ah, ¡tus, dedos! ¿Eh, ehh? ¿Rina, tus dedos? A-Ahhhh.”",
{"rt2"},
},
},
},
linkback="block_00544",
linknext="block_00546",
},
block_00546={
{"text"},
text={
ja={
{
"Sin ningún previo aviso, Rina trepó sus dedos por la zona que yo tenía abierta\ncon mis dedos.",
{"rt2"},
},
},
},
linkback="block_00545",
linknext="block_00547",
},
block_00547={
{"text"},
text={
vo={
{"vo",file="fem_yum_002756",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No, puedo, creerlo, tus dedos, están donde mi co*o abierto, *hig*.”",
{"rt2"},
},
},
},
linkback="block_00546",
linknext="block_00548",
},
block_00548={
{"text"},
text={
vo={
{"vo",file="fem_rna_001031",ch="rna"},
},
ja={
{
name={"Rina"},
"“Asombroso, asombroso. Solo con tocarlo un poquito te retuerces. ¿Se siente\nbien, Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00547",
linknext="block_00549",
},
block_00549={
{"text"},
text={
vo={
{"vo",file="fem_yum_002757",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, se sienten muy, muy bien tus dedos, Rinaa.”",
{"rt2"},
},
},
},
linkback="block_00548",
linknext="block_00550",
},
block_00550={
{"text"},
text={
vo={
{"vo",file="fem_rna_001032",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bastante te dejé aguantando, ciertamente. Tu coño está caliente, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00549",
linknext="block_00551",
},
block_00551={
{"text"},
text={
vo={
{"vo",file="fem_yum_002758",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A-Auh, ah, hauh, Rina, tus dedos, tus dedos, se sienten tan bieeen.”",
{"rt2"},
},
},
},
linkback="block_00550",
linknext="block_00552",
},
block_00552={
{"text"},
text={
vo={
{"vo",file="fem_rna_001033",ch="rna"},
},
ja={
{
name={"Rina"},
"“Se siente bien, ¿verdad? Jaa, jaa, eres tan linda, mi Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00551",
linknext="block_00553",
},
block_00553={
{"text"},
text={
ja={
{
"Rina me besa.",
{"rt2"},
},
},
},
linkback="block_00552",
linknext="block_00554",
},
block_00554={
{"text"},
text={
vo={
{"vo",file="fem_yum_002759",ch="yum"},
},
ja={
{
name={"Yuumi"},
"～～～～～～～～～～～",
{"rt2"},
},
},
},
linkback="block_00553",
linknext="block_00555",
},
block_00555={
{"text"},
text={
ja={
{
"Mi cabeza se queda en blanco. No logro asimilar lo que sucedió.",
{"rt2"},
},
},
},
linkback="block_00554",
linknext="block_00556",
},
block_00556={
{"bg",id=9,lv=9,sync=1,time=1000,file="white",path=":bg/"},
{"cgdel",id=9,lv=9},
{"bg",file="ev_rna_h02_08",sync=1,time=1000,vague=100,path=":ev/ev_rna_h02/",set="ev_rna_h02"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡*bikun*! ¡¡¿¿*bikubikubikun*??!!",
{"rt2"},
},
},
},
linkback="block_00555",
linknext="block_00557",
},
block_00557={
{"text"},
text={
vo={
{"vo",file="fem_rna_001034",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00556",
linknext="block_00558",
},
block_00558={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*bikuuuu*...",
{"rt2"},
},
},
},
linkback="block_00557",
linknext="block_00559",
},
block_00559={
{"text"},
text={
vo={
{"vo",file="fem_yum_002760",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ngh, nmmm, ngh, ¡kah! Kuhn, ngaaah, kuun, haaannn...”",
{"rt2"},
},
},
},
linkback="block_00558",
linknext="block_00560",
},
block_00560={
{"text"},
text={
ja={
{
"Pero, aun después de que el placer corriera por mi cerebro como un corrientazo,\nmi cuerpo siguió temblando de semejante manera que parecía ser el cuerpo de\nalguien más.",
{"rt2"},
},
},
},
linkback="block_00559",
linknext="block_00561",
},
block_00561={
{"text"},
text={
vo={
{"vo",file="fem_yum_002761",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Nkuh, nguuun, kuun... Jaa, jaa, jaa, ngh, ah, ahhh.”",
{"rt2"},
},
},
},
linkback="block_00560",
linknext="block_00562",
},
block_00562={
{"text"},
text={
vo={
{"vo",file="fem_rna_001035",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Te viniste?”",
{"rt2"},
},
},
},
linkback="block_00561",
linknext="block_00563",
},
block_00563={
{"bg",file="ev_rna_h02_09",sync=0,face=1,time=400,path=":ev/ev_rna_h02/",set="ev_rna_h02"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002762",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Je? ¿M-Me, me vine? Jaa,Jaa, hauh, nkuh, kuh.”",
{"rt2"},
},
},
},
linkback="block_00562",
linknext="block_00564",
},
block_00564={
{"bg",file="ev_rna_h02_08",sync=0,face=1,time=400,path=":ev/ev_rna_h02/",set="ev_rna_h02"},
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*bikubiku*...",
{"rt2"},
},
},
},
linkback="block_00563",
linknext="block_00565",
},
block_00565={
{"text"},
text={
ja={
{
"Mi cuerpo no deja de retorcerse.",
{"rt2"},
},
},
},
linkback="block_00564",
linknext="block_00566",
},
block_00566={
{"text"},
text={
ja={
{
"El placer me invade entre cada vaivén.",
{"rt2"},
},
},
},
linkback="block_00565",
linknext="block_00567",
},
block_00567={
{"text"},
text={
ja={
{
"Fue entonces que me di cuenta de que me había corrido.",
{"rt2"},
},
},
},
linkback="block_00566",
linknext="block_00568",
},
block_00568={
{"text"},
text={
vo={
{"vo",file="fem_rna_001036",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ni siquiera te enteraste de que te habías corrido.”",
{"rt2"},
},
},
},
linkback="block_00567",
linknext="block_00569",
},
block_00569={
{"text"},
text={
ja={
{
"――*pikupiku*...",
{"rt2"},
},
},
},
linkback="block_00568",
linknext="block_00570",
},
block_00570={
{"bg",file="ev_rna_h02_09",sync=0,face=1,time=400,path=":ev/ev_rna_h02/",set="ev_rna_h02"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002763",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jaa, jaa, se sintió muy bien... pero, mi cabeza se quedó en blanco... y por\neso...”",
{"rt2"},
},
},
},
linkback="block_00569",
linknext="block_00571",
},
block_00571={
{"text"},
text={
vo={
{"vo",file="fem_rna_001037",ch="rna"},
},
ja={
{
name={"Rina"},
"“No pensé que te correrías tan pronto, Yuumi... Debilucha.”",
{"rt2"},
},
},
},
linkback="block_00570",
linknext="block_00572",
},
block_00572={
{"text"},
text={
vo={
{"vo",file="fem_yum_002764",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A-Auh... lo siento.”",
{"rt2"},
},
},
},
linkback="block_00571",
linknext="block_00573",
},
block_00573={
{"text"},
text={
vo={
{"vo",file="fem_rna_001038",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jeje, está bien. Ya sé que eres una pequeña y débil pervertida.”",
{"rt2"},
},
},
},
linkback="block_00572",
linknext="block_00574",
},
block_00574={
{"text"},
text={
vo={
{"vo",file="fem_yum_002765",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Quería seguir disfrutando más, pero, pero yo, nkuh, hauh.”",
{"rt2"},
},
},
},
linkback="block_00573",
linknext="block_00575",
},
block_00575={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*pikupikupikun*...",
{"rt2"},
},
},
},
linkback="block_00574",
linknext="block_00576",
},
block_00576={
{"text"},
text={
ja={
{
"Aun no paran los temblores.",
{"rt2"},
},
},
},
linkback="block_00575",
linknext="block_00577",
},
block_00577={
{"text"},
text={
vo={
{"vo",file="fem_rna_001039",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aun siguen los temblores. ¿Tanto así lo disfrutaste?”",
{"rt2"},
},
},
},
linkback="block_00576",
linknext="block_00578",
},
block_00578={
{"text"},
text={
vo={
{"vo",file="fem_yum_002766",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí... mucho. Fuiste tú quien me hizo sentir así, Rina. Me gustó mucho, mucho,\nmuchísimo.”",
{"rt2"},
},
},
},
linkback="block_00577",
linknext="block_00579",
},
block_00579={
{"text"},
text={
vo={
{"vo",file="fem_rna_001040",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me alegro que lo disfrutaras.”",
{"rt2"},
},
},
},
linkback="block_00578",
linknext="block_00580",
},
block_00580={
{"text"},
text={
vo={
{"vo",file="fem_rna_001041",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero no he hecho ni un tercio de lo que hago en mis fantasías...”",
{"rt2"},
},
},
},
linkback="block_00579",
linknext="block_00581",
},
block_00581={
{"text"},
text={
vo={
{"vo",file="fem_yum_002767",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿¿Fanta... sías...??”",
{"rt2"},
},
},
},
linkback="block_00580",
linknext="block_00582",
},
block_00582={
{"text"},
text={
vo={
{"vo",file="fem_rna_001042",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, fantasías. Yo también las tengo... Me imagino contigo, haciendo cosas\nindecentes...”",
{"rt2"},
},
},
},
linkback="block_00581",
linknext="block_00583",
},
block_00583={
{"text"},
text={
vo={
{"vo",file="fem_yum_002768",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Has tenido... fantasías conmigo?”",
{"rt2"},
},
},
},
linkback="block_00582",
linknext="block_00584",
},
block_00584={
{"text"},
text={
vo={
{"vo",file="fem_rna_001043",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. ¿Te he desilusionado?”",
{"rt2"},
},
},
},
linkback="block_00583",
linknext="block_00585",
},
block_00585={
{"text"},
text={
vo={
{"vo",file="fem_yum_002769",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, todo lo contrario. Estoy feliz, muy feliz. ¡Sé que contigo puedo correrme\ntantas veces como mi cuerpo aguante, así que haz conmigo todo lo que has\nhecho en tus fantasías!”",
{"rt2"},
},
},
},
linkback="block_00584",
linknext="block_00586",
},
block_00586={
{"text"},
text={
vo={
{"vo",file="fem_rna_001044",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí?... Pero, te advierto que hago puras crueldades en mis fantasías. ¿No te\nimporta?”",
{"rt2"},
},
},
},
linkback="block_00585",
linknext="block_00587",
},
block_00587={
{"text"},
text={
vo={
{"vo",file="fem_yum_002770",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eso sería como una recompensa para mí. Juega conmigo, todo lo que quieras.”",
{"rt2"},
},
},
},
linkback="block_00586",
linknext="block_00588",
},
block_00588={
{"text"},
text={
vo={
{"vo",file="fem_rna_001045",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo... ¿Será que doy la próxima orden entonces?”",
{"rt2"},
},
},
},
linkback="block_00587",
linknext="block_00589",
},
block_00589={
{"msgoff"},
{"bg",file="zbluesky_summer",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se0897s",vol=20,id=1},
{"text"},
text={
ja={
{
"Rina se para, y mete su mano en su falda.",
{"rt2"},
},
},
},
linkback="block_00588",
linknext="block_00590",
},
block_00590={
{"text"},
text={
ja={
{
"Y deslizó su ropa interior hacia abajo, quitándosela como si estuviera sola en\nsu propia habitación.",
{"rt2"},
},
},
},
linkback="block_00589",
linknext="block_00591",
},
block_00591={
{"text"},
text={
vo={
{"vo",file="fem_yum_002771",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿R-Rina?”",
{"rt2"},
},
},
},
linkback="block_00590",
linknext="block_00592",
},
block_00592={
{"text"},
text={
ja={
{
"Al terminar, Rina volvió a sentarse.",
{"rt2"},
},
},
},
linkback="block_00591",
linknext="block_00593",
},
block_00593={
{"text"},
text={
vo={
{"vo",file="fem_rna_001046",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi... ¿Harás... lo que te ordene?”",
{"rt2"},
},
},
},
linkback="block_00592",
linknext="block_00594",
},
block_00594={
{"text"},
text={
vo={
{"vo",file="fem_yum_002772",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“U-Uhm... ah, digo, ¡s-sí!”",
{"rt2"},
},
},
},
linkback="block_00593",
linknext="block_00595",
},
block_00595={
{"text"},
text={
vo={
{"vo",file="fem_rna_001047",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo... No sabes lo mucho que me alegra escuchar eso...”",
{"rt2"},
},
},
},
linkback="block_00594",
linknext="block_00596",
},
block_00596={
{"text"},
text={
ja={
{
"Y entonces, abrió sus piernas hasta más no poder...",
{"rt2"},
},
},
},
linkback="block_00595",
linknext="block_00597",
},
block_00597={
{"text"},
text={
vo={
{"vo",file="fem_rna_001048",ch="rna"},
},
ja={
{
name={"Rina"},
"“He abierto mis piernas...”",
{"rt2"},
},
},
},
linkback="block_00596",
linknext="block_00598",
},
block_00598={
{"text"},
text={
vo={
{"vo",file="fem_yum_002773",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00597",
linknext="block_00599",
},
block_00599={
{"text"},
text={
vo={
{"vo",file="fem_rna_001049",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿En qué estado crees que está la zona entre mis piernas?... Aquí, tras mi\nfalda.”",
{"rt2"},
},
},
},
linkback="block_00598",
linknext="block_00600",
},
block_00600={
{"text"},
text={
vo={
{"vo",file="fem_yum_002774",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“R-Rina... acabas, de quitarte la ropa interior, así que...”",
{"rt2"},
},
},
},
linkback="block_00599",
linknext="block_00601",
},
block_00601={
{"text"},
text={
vo={
{"vo",file="fem_rna_001050",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es, no tengo nada puesto. Teniendo las piernas así de abiertas no sería\nsorpresa alguna que mi coño se viera...”",
{"rt2"},
},
},
},
linkback="block_00600",
linknext="block_00602",
},
block_00602={
{"text"},
text={
vo={
{"vo",file="fem_yum_002775",ch="yum"},
},
ja={
{
name={"Yuumi"},
"*traga saliva*...",
{"rt2"},
},
},
},
linkback="block_00601",
linknext="block_00603",
},
block_00603={
{"text"},
text={
vo={
{"vo",file="fem_rna_001051",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi... Consuélame acá...”",
{"rt2"},
},
},
},
linkback="block_00602",
linknext="block_00604",
},
block_00604={
{"text"},
text={
vo={
{"vo",file="fem_yum_002776",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00603",
linknext="block_00605",
},
block_00605={
{"text"},
text={
vo={
{"vo",file="fem_rna_001052",ch="rna"},
},
ja={
{
name={"Rina"},
"“Probablemente, estoy... tan mojada acá, que... no soportaría verlo por mí\nmisma... Quizás esté peor que tú...”",
{"rt2"},
},
},
},
linkback="block_00604",
linknext="block_00606",
},
block_00606={
{"text"},
text={
vo={
{"vo",file="fem_rna_001053",ch="rna"},
},
ja={
{
name={"Rina"},
"“Dentro de mi falda está oculto mi coño, palpitando... Yuumi, quiero que le des\nconsuelo...”",
{"rt2"},
},
},
},
linkback="block_00605",
linknext="block_00607",
},
block_00607={
{"text"},
text={
ja={
{
"Trago saliva.",
{"rt2"},
},
},
},
linkback="block_00606",
linknext="block_00608",
},
block_00608={
{"text"},
text={
ja={
{
"A pesar de estar dándome órdenes, su voz está temblando.",
{"rt2"},
},
},
},
linkback="block_00607",
linknext="block_00609",
},
block_00609={
{"text"},
text={
ja={
{
"Nada de qué sorprenderse, considerando la pinta y la pose que está haciendo en\nsemejante lugar. Bastante pena le debe dar.",
{"rt2"},
},
},
},
linkback="block_00608",
linknext="block_00610",
},
block_00610={
{"text"},
text={
ja={
{
"Y aun así, Rina sigue ordenando.",
{"rt2"},
},
},
},
linkback="block_00609",
linknext="block_00611",
},
block_00611={
{"text"},
text={
vo={
{"vo",file="fem_rna_001054",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi, dale consuelo a mi húmedo y caliente coño...”",
{"rt2"},
},
},
},
linkback="block_00610",
linknext="block_00612",
},
block_00612={
{"text"},
text={
ja={
{
"Rina levanta un poco el borde de la falda.",
{"rt2"},
},
},
},
linkback="block_00611",
linknext="block_00613",
},
block_00613={
{"text"},
text={
vo={
{"vo",file="fem_yum_002777",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Está bien...”",
{"rt2"},
},
},
},
linkback="block_00612",
linknext="block_00614",
},
block_00614={
{"text"},
text={
ja={
{
"Me arrodillo.",
{"rt2"},
},
},
},
linkback="block_00613",
linknext="block_00615",
},
block_00615={
{"text"},
text={
ja={
{
"Rina, con las piernas abiertas. Y yo, arrodillada frente a ella. Una escena\nbastante particular.",
{"rt2"},
},
},
},
linkback="block_00614",
linknext="block_00616",
},
block_00616={
{"text"},
text={
ja={
{
"En ninguna de mis fantasías llegué a ver algo así.",
{"rt2"},
},
},
},
linkback="block_00615",
linknext="block_00617",
},
block_00617={
{"cgdel",id=-1},
{"bg",file="ev_rna_h05_01",path=":ev/ev_rna_h05/",set="ev_rna_h05"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002778",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“R-Rina... ¿No te importa?”",
{"rt2"},
},
},
},
linkback="block_00616",
linknext="block_00618",
},
block_00618={
{"text"},
text={
vo={
{"vo",file="fem_rna_001055",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso es lo de menos... Te estoy dando una orden...”",
{"rt2"},
},
},
},
linkback="block_00617",
linknext="block_00619",
},
block_00619={
{"text"},
text={
vo={
{"vo",file="fem_yum_002779",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“V-Voy a subir la falda...”",
{"rt2"},
},
},
},
linkback="block_00618",
linknext="block_00620",
},
block_00620={
{"text"},
text={
vo={
{"vo",file="fem_rna_001056",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-Está bien...”",
{"rt2"},
},
},
},
linkback="block_00619",
linknext="block_00621",
},
block_00621={
{"text"},
text={
ja={
{
"Rina se levanta lentamente la falda.",
{"rt2"},
},
},
},
linkback="block_00620",
linknext="block_00622",
},
block_00622={
{"text"},
text={
ja={
{
"Aun no atardecía. Estábamos bajo pleno sol.",
{"rt2"},
},
},
},
linkback="block_00621",
linknext="block_00623",
},
block_00623={
{"text"},
text={
ja={
{
"Y sus partes ocultas dejaron, por fin, verse.",
{"rt2"},
},
},
},
linkback="block_00622",
linknext="block_00624",
},
block_00624={
{"se",file="se9010",vol=40,id=1},
{"bg",file="ev_rna_h05_02",sync=0,face=1,time=400,path=":ev/ev_rna_h05/",set="ev_rna_h05"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001057",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00623",
linknext="block_00625",
},
block_00625={
{"text"},
text={
ja={
{
"Junto a un suspiro, de entre los labios de Rina comenzaron a brotar fluídos\nvaginales.",
{"rt2"},
},
},
},
linkback="block_00624",
linknext="block_00626",
},
block_00626={
{"text"},
text={
vo={
{"vo",file="fem_yum_002780",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ngh...”",
{"rt2"},
},
},
},
linkback="block_00625",
linknext="block_00627",
},
block_00627={
{"text"},
text={
vo={
{"vo",file="fem_rna_001058",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué la cara?... ¿Te ha asustado tenerlo de frente?”",
{"rt2"},
},
},
},
linkback="block_00626",
linknext="block_00628",
},
block_00628={
{"text"},
text={
vo={
{"vo",file="fem_yum_002781",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“C-Claro que no. T-Tu vagina, tiene... un color muy hermoso, y... q-quedé...\nquedé cautivada...”",
{"rt2"},
},
},
},
linkback="block_00627",
linknext="block_00629",
},
block_00629={
{"text"},
text={
vo={
{"vo",file="fem_rna_001059",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, que te hayas quedado anonadada viéndome allí abajo no me cautiva mucho a\nmí...”",
{"rt2"},
},
},
},
linkback="block_00628",
linknext="block_00630",
},
block_00630={
{"text"},
text={
vo={
{"vo",file="fem_yum_002782",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Puedo usar la boca?”",
{"rt2"},
},
},
},
linkback="block_00629",
linknext="block_00631",
},
block_00631={
{"text"},
text={
vo={
{"vo",file="fem_rna_001060",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, eso planeaba pedirte...”",
{"rt2"},
},
},
},
linkback="block_00630",
linknext="block_00632",
},
block_00632={
{"text"},
text={
vo={
{"vo",file="fem_yum_002783",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Me dejas lamerte?”",
{"rt2"},
},
},
},
linkback="block_00631",
linknext="block_00633",
},
block_00633={
{"se",file="se9010",vol=30,id=1},
{"text"},
text={
ja={
{
"Rina toma cariñosamente mi cabeza.",
{"rt2"},
},
},
},
linkback="block_00632",
linknext="block_00634",
},
block_00634={
{"text"},
text={
ja={
{
"Guiada por su mano, acerco mi cara a su vagina abierta.",
{"rt2"},
},
},
},
linkback="block_00633",
linknext="block_00635",
},
block_00635={
{"text"},
text={
ja={
{
"El dulce olor de sus partes privadas llegó a mi nariz.",
{"rt2"},
},
},
},
linkback="block_00634",
linknext="block_00636",
},
block_00636={
{"text"},
text={
vo={
{"vo",file="fem_yum_002784",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El coño, de Rina...”",
{"rt2"},
},
},
},
linkback="block_00635",
linknext="block_00637",
},
block_00637={
{"text"},
text={
vo={
{"vo",file="fem_rna_001061",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh...”",
{"rt2"},
},
},
},
linkback="block_00636",
linknext="block_00638",
},
block_00638={
{"text"},
text={
ja={
{
"Rina está apartando su vista a un lado, probablemente de la vergüenza. Era de\nesperarse, teníendome a mí viendo sus partes más íntimas en este lugar tan\niluminado.",
{"rt2"},
},
},
},
linkback="block_00637",
linknext="block_00639",
},
block_00639={
{"text"},
text={
ja={
{
"Dejo descansar mi mejilla sobre su muslo... Se siente suave, y está muy\ncálido... -'Ah, este es el calor de Rina'- fue lo primero que se me vino a la\nmente...",
{"rt2"},
},
},
},
linkback="block_00638",
linknext="block_00640",
},
block_00640={
{"text"},
text={
ja={
{
"Teniendo mi mejilla sintiendo su calor, le di un pequeño beso a sus mojadas\npartes.",
{"rt2"},
},
},
},
linkback="block_00639",
linknext="block_00641",
},
block_00641={
{"bg",file="ev_rna_h05_03",sync=0,face=1,time=400,path=":ev/ev_rna_h05/",set="ev_rna_h05"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002785",ch="yum"},
},
ja={
{
name={"Yuumi"},
"*chuu*...",
{"rt2"},
},
},
},
linkback="block_00640",
linknext="block_00642",
},
block_00642={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001062",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngaah.”",
{"rt2"},
},
},
},
linkback="block_00641",
linknext="block_00643",
},
block_00643={
{"text"},
text={
ja={
{
"Su espalda se arquea ligeramente hacia atrás.",
{"rt2"},
},
},
},
linkback="block_00642",
linknext="block_00644",
},
block_00644={
{"text"},
text={
ja={
{
"Le doy otro beso, lentamente. Más largo que el anterior...",
{"rt2"},
},
},
},
linkback="block_00643",
linknext="block_00645",
},
block_00645={
{"text"},
text={
vo={
{"vo",file="fem_yum_002786",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ngh... *chuu*... *churu*... *chuchuu*... ngh... *chuu*... *chuu*...”",
{"rt2"},
},
},
},
linkback="block_00644",
linknext="block_00646",
},
block_00646={
{"text"},
text={
ja={
{
"Le doy un beso profundo.",
{"rt2"},
},
},
},
linkback="block_00645",
linknext="block_00647",
},
block_00647={
{"text"},
text={
vo={
{"vo",file="fem_rna_001063",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, ngh, ahn, jaa, jaa, ng, nm.”",
{"rt2"},
},
},
},
linkback="block_00646",
linknext="block_00648",
},
block_00648={
{"text"},
text={
ja={
{
"Mi lengua le está dando placer a Rina.",
{"rt2"},
},
},
},
linkback="block_00647",
linknext="block_00649",
},
block_00649={
{"text"},
text={
ja={
{
"Los sensuales gemidos que se escapan de su boca me encienden aún más.",
{"rt2"},
},
},
},
linkback="block_00648",
linknext="block_00650",
},
block_00650={
{"text"},
text={
vo={
{"vo",file="fem_yum_002787",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Nm, amuh, *rero*, *churu*.”",
{"rt2"},
},
},
},
linkback="block_00649",
linknext="block_00651",
},
block_00651={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001064",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nnngh.”",
{"rt2"},
},
},
},
linkback="block_00650",
linknext="block_00652",
},
block_00652={
{"text"},
text={
vo={
{"vo",file="fem_yum_002788",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“*chupaa*... *rero*... *amuh*... ngh, estás, bastante mojada... aquí... Me\nencanta, este sucio sabor...”",
{"rt2"},
},
},
},
linkback="block_00651",
linknext="block_00653",
},
block_00653={
{"text"},
text={
vo={
{"vo",file="fem_rna_001065",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, no hables, mientras chupas, ngh, me pones a temblar, y a sentir cosas\nextrañas--”",
{"rt2"},
},
},
},
linkback="block_00652",
linknext="block_00654",
},
block_00654={
{"text"},
text={
vo={
{"vo",file="fem_yum_002789",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“*chuchuu*... ngh, *ahm*, *rero*, nmuh, *rero*, *rero*... ¿Lo estás,\ndisfrutando?”",
{"rt2"},
},
},
},
linkback="block_00653",
linknext="block_00655",
},
block_00655={
{"text"},
text={
vo={
{"vo",file="fem_rna_001066",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ngh, l-lo estoy... S-Solo observa como, como estoy debajo... ahn.”",
{"rt2"},
},
},
},
linkback="block_00654",
linknext="block_00656",
},
block_00656={
{"text"},
text={
vo={
{"vo",file="fem_yum_002790",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“*rero*, *ahm*, *chuchuu*... sí, tu co*o, estaba bastante caliente... así que,\nlo enfriaré con mi lengua... *chuchuchuu*”",
{"rt2"},
},
},
},
linkback="block_00655",
linknext="block_00657",
},
block_00657={
{"text"},
text={
vo={
{"vo",file="fem_rna_001067",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vas a hacer... que se ponga, más caliente... más, y más, y entonces no podré\nparar de mojarme tantooo...”",
{"rt2"},
},
},
},
linkback="block_00656",
linknext="block_00658",
},
block_00658={
{"text"},
text={
vo={
{"vo",file="fem_yum_002791",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No te preocupes... Me encantaría, probar más de... *rero*, *chuchuru*, *rero*,\nngh, *chupaa*... tu jugo... *yurururu*...”",
{"rt2"},
},
},
},
linkback="block_00657",
linknext="block_00659",
},
block_00659={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001068",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kunuuun, no, no chupes... Ah, ngh, nm, Jaa, jaa, ah, ahnn.”",
{"rt2"},
},
},
},
linkback="block_00658",
linknext="block_00660",
},
block_00660={
{"text"},
text={
ja={
{
"Voy tomando amorosamente con mi lengua la dulce miel que emana de su interior.",
{"rt2"},
},
},
},
linkback="block_00659",
linknext="block_00661",
},
block_00661={
{"text"},
text={
ja={
{
"Y entonces, empecé a dar vueltas con mi lengua por el lugar de donde emanaban\nesos dulces jugos... La entrada a su vagina, zona protegida por su himen.",
{"rt2"},
},
},
},
linkback="block_00660",
linknext="block_00662",
},
block_00662={
{"text"},
text={
ja={
{
"Todavía con las piernas abiertas, Rina se estremeció, y comenzó a temblar.",
{"rt2"},
},
},
},
linkback="block_00661",
linknext="block_00663",
},
block_00663={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001069",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, hiiii... kuuhh...”",
{"rt2"},
},
},
},
linkback="block_00662",
linknext="block_00664",
},
block_00664={
{"text"},
text={
ja={
{
"Ahh, no puedo... Verla así me hará...",
{"rt2"},
},
},
},
linkback="block_00663",
linknext="block_00665",
},
block_00665={
{"text"},
text={
vo={
{"vo",file="fem_yum_002792",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“*yuruu*, *churuu*, *chupaa*, ngh, *churu*, ngh, nmm... a-auhh... iiihh...”",
{"rt2"},
},
},
},
linkback="block_00664",
linknext="block_00666",
},
block_00666={
{"text"},
text={
ja={
{
"Poco a poco se van escapando más gemidos de mi boca...",
{"rt2"},
},
},
},
linkback="block_00665",
linknext="block_00667",
},
block_00667={
{"text"},
text={
vo={
{"vo",file="fem_rna_001070",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, jaa, ya me lo esperaba... eres como eres después de todo, Yuumi... Jaa,\njaa... ngh, nmm, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00666",
linknext="block_00668",
},
block_00668={
{"text"},
text={
ja={
{
"Rina no tardó en darse cuenta de eso...",
{"rt2"},
},
},
},
linkback="block_00667",
linknext="block_00669",
},
block_00669={
{"text"},
text={
vo={
{"vo",file="fem_yum_002793",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí... no pude aguantarme... *churu*, *rero*, *chupa*, ngh, lo siento... creo,\nque incumplí las reglas...”",
{"rt2"},
},
},
},
linkback="block_00668",
linknext="block_00670",
},
block_00670={
{"text"},
text={
vo={
{"vo",file="fem_rna_001071",ch="rna"},
},
ja={
{
name={"Rina"},
"“No importa... Ya me parecía que lo harías, y... me excita aún más, que me lamas\nallí abajo... mientras te veo gimiendo...”",
{"rt2"},
},
},
},
linkback="block_00669",
linknext="block_00671",
},
block_00671={
{"text"},
text={
ja={
{
"――*guchoguchugucha*...",
{"rt2"},
},
},
},
linkback="block_00670",
linknext="block_00672",
},
block_00672={
{"text"},
text={
ja={
{
"Los viscosos sonidos no venían solo de Rina. Sino también desde abajo.",
{"rt2"},
},
},
},
linkback="block_00671",
linknext="block_00673",
},
block_00673={
{"text"},
text={
vo={
