},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
vo={
{"vo",file="fem_yum_002683",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“R-Rinaa...”",
{"rt2"},
