linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"text"},
text={
vo={
{"vo",file="fem_rna_000971",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No puedo ver?”",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
{"text"},
text={
vo={
{"vo",file="fem_yum_002693",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Auhh, n-no es eso--”",
{"rt2"},
},
},
},
linkback="block_00382",
linknext="block_00384",
},
block_00384={
{"text"},
text={
vo={
{"vo",file="fem_rna_000972",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué no es?”",
{"rt2"},
},
},
},
linkback="block_00383",
