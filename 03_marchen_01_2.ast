},
block_00333={
{"text"},
text={
vo={
{"vo",file="fem_yum_002679",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A-Auh, s-sí, pero...”",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
vo={
{"vo",file="fem_rna_000956",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hazlo como lo haces siempre, fantaseando.”",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
vo={
{"vo",file="fem_yum_002680",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“R-Rina, ¿me estás pidiendo, que me masturbe acá?”",
