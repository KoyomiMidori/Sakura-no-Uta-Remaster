linknext="block_00331",
},
block_00331={
{"text"},
text={
vo={
{"vo",file="fem_rna_000955",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quiero ver cómo te masturbas. Siempre lo haces pensando en mí, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
"――*dokun*",
{"rt2"},
