},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
vo={
{"vo",file="fem_rna_000959",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo harás acá, conmigo viéndome. Eres la clase de chica capaz de hacer eso.”",
{"rt2"},
