linknext="block_00733",
},
block_00733={
{"text"},
text={
vo={
{"vo",file="fem_rna_001096",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo... Realmente eres una pequeña pervertida.”",
{"rt2"},
},
},
},
linkback="block_00732",
linknext="block_00734",
},
block_00734={
{"text"},
text={
vo={
{"vo",file="fem_yum_002815",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A-Ahn... Jaa, jaa... Rinaaa... Rinaa... Rina, me encantas... Jaa, haaa... me\nencanta, cuando... me miras...”",
{"rt2"},
},
},
},
linkback="block_00733",
linknext="block_00735",
},
block_00735={
{"text"},
text={
vo={
{"vo",file="fem_rna_001097",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, así parece... Pareces estar disfrutándolo bastante.”",
{"rt2"},
},
},
},
linkback="block_00734",
linknext="block_00736",
},
block_00736={
{"text"},
text={
vo={
{"vo",file="fem_yum_002816",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jaa, jaa, jaaa... Me da tanta pena... que me veas mientras me masturbo, y... no\npuedo parar, de mover mis dedos...”",
{"rt2"},
},
},
},
linkback="block_00735",
linknext="block_00737",
},
block_00737={
{"text"},
text={
vo={
{"vo",file="fem_rna_001098",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así que cuando te sientes apenada no puedes detener tus manos...”",
{"rt2"},
},
},
},
linkback="block_00736",
linknext="block_00738",
},
block_00738={
{"text"},
text={
vo={
{"vo",file="fem_yum_002817",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, entre más vergüenza mejor lo siento, ahh... Mírame, mírame más, por\nfavor... Jaa, jaa, observa mi co*o... Mira, mira más cómo... cómo me\nmasturbooo...”",
{"rt2"},
},
},
},
linkback="block_00737",
linknext="block_00739",
},
block_00739={
{"text"},
text={
ja={
{
"No aguanté más, y eché mis caderas hacia adelante. Quería que Rina me viera\nmás...",
{"rt2"},
},
},
},
linkback="block_00738",
linknext="block_00740",
},
block_00740={
{"text"},
text={
vo={
{"vo",file="fem_yum_002818",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ngh... Jaa... R-Rina, mírame más... Mira, mi co*o... está, tan mojado, de tanto\nmasturbarme... Jaa, jaa... ah, no pued--, me voy de nuevo...”",
{"rt2"},
},
},
},
linkback="block_00739",
linknext="block_00741",
},
block_00741={
{"text"},
text={
vo={
{"vo",file="fem_rna_001099",ch="rna"},
},
ja={
{
name={"Rina"},
"“Debes describirlo todo si quieres correrte. Cómo, dónde, y de qué manera te\ncorrerás...”",
{"rt2"},
},
},
},
linkback="block_00740",
linknext="block_00742",
},
block_00742={
{"text"},
text={
vo={
{"vo",file="fem_yum_002819",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, s-síii... E-Estoy, masturbándome... en la azotea, frente a Rina... abriendo\nmi co*o, y... se siente, muy bieeen... ¡¡Mm!!”",
{"rt2"},
},
},
},
linkback="block_00741",
linknext="block_00743",
},
