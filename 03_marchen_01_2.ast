linknext="block_00376",
},
block_00376={
{"text"},
text={
vo={
{"vo",file="fem_rna_000969",ch="rna"},
},
ja={
{
name={"Rina"},
"“Imposible... eh.”",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"text"},
text={
ja={
{
"Una triste expresión se tornó, por un instante, sobre el rostro de Rina.",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"text"},
text={
ja={
{
"La angustia se apoderó de mí al verla así. Sentí escalofríos... pero, justo\nentonces.",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"text"},
text={
vo={
{"vo",file="fem_rna_000970",ch="rna"},
},
ja={
{
name={"Rina"},
"“Conque así te masturbas siempre, eh, pequeña pervertida.”",
{"rt2"},
},
},
},
linkback="block_00378",
linknext="block_00380",
},
block_00380={
{"text"},
text={
ja={
{
"Rina se acercó alegremente a observar el movimiento de mis dedos.",
{"rt2"},
},
},
},
linkback="block_00379",
linknext="block_00381",
},
block_00381={
{"text"},
