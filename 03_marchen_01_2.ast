linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
vo={
{"vo",file="fem_rna_000958",ch="rna"},
},
ja={
{
name={"Rina"},
"“No es algo que no hagas todos los días, ¿no? ¿O es que acaso no quieres hacerlo\nfrente a mí?”",
