},
block_00323={
{"text"},
text={
vo={
{"vo",file="fem_rna_000951",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Siempre se pone así?”",
{"rt2"},
},
},
},
linkback="block_00322",
