linknext="block_00366",
},
block_00366={
{"text"},
text={
vo={
{"vo",file="fem_rna_000965",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo. ¿Y qué tal se siente, ahora que lo estás haciendo?”",
