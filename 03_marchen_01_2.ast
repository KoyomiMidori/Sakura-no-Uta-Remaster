{"text"},
text={
vo={
{"vo",file="fem_rna_000841",ch="rna"},
},
ja={
{
name={"Rina"},
"♪～～～～♪～～～♪",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm103"},
{"text"},
text={
ja={
{
"Rina pinta, de muy buen humor.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"No sé si es mi imaginación, pero parece estar pintando muy fluidamente.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_yum_002570",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“R-Rina... ¿Qué tal va tu pintura?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0016",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="あくび",lv=4,id=9},
{"fgact",ch="里奈",act="icon",y=-500,lv=4,id=9,icon="icon03z1",x=50},
{"text"},
text={
vo={
{"vo",file="fem_rna_000842",ch="rna"},
},
ja={
{
name={"Rina"},
"～～～～～～♪",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Rina me pasa su lienzo mientras tararea.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_yum_002571",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"¿Su cuadro ha cambiado?",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Aunque, de cambiar un poco la perspectiva se ve igual a la versión anterior.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_yum_002572",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Esta montaña de cipreses parece un animal... es como...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000843",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Es como?...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_yum_002573",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Un lobo?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0004",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000844",ch="rna"},
},
ja={
{
name={"Rina"},
"“Correcto. Así es, todos estos cipreses forman un lobo.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_yum_002574",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y este árbol de cerezos? Se parece a...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000845",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es una seta blanca.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_yum_002575",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿No estabas pintando un paisaje?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0003",head="rna_z1d",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000846",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. La temática de este cuadro es el paisaje que se observa desde acá.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_yum_002576",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vaya...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0002",head="rna_z1d",lv=4,id=9},
{"text"},
text={
ja={
{
"No sé muy bien por qué, pero solo esa explicación me bastó para quedar\nconvencida.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Sí. Si los cipreses se convierten en cerezos, entonces,",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"aunque este bosque de cipreses se haya convertido en este gigantesco lobo, y\naunque todos estos blancos cerezos se transformen en una seta blanca que\ncrece sobre él...",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"No hay absolutamente nada raro.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000847",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué tal está?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_yum_002577",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, sí, creo que me gusta más que la anterior...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000848",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí? Me alegra oír eso.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_rna_000849",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hyu, hum.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"excall",label="yesextrascene",cond="s.scene==1",call=0},
{"excall",label="noextrascene",cond="s.scene==0",call=0},
{"bgm",file="bgm103"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rina se sienta a mi lado, rozando su piel con la mía.",
{"rt2"},
},
},
},
labelcount=9,
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_002578",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿R-Rina?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0001",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000850",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Uhm? ¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_yum_002579",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Esto, ¿e-está bien que nos juntemos tanto?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000851",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Me lo estás preguntando en serio? ¿Te tengo que recordar quién es la que\nsiempre intenta hacer contacto físico intenso conmigo?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_yum_002580",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sé... que he sido yo, pero...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000852",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué insinúas? ¿Está bien que lo hagas tú, pero no te gusta que lo haga yo?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Rina me lanza una sonrisa pícara.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_yum_002581",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Claro que no, para nada. Me alegra, me gusta mucho.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うんうん",time=300,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0004",head="rna_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000853",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo, ya veo, qué bueno.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Rina arrima su piel contra la mía.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Su cuerpo es suave y blando.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000854",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uhm, tu cabello siempre huele muy bien, Yuumi. Me encanta. ¿Qué champú usas?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_yum_002582",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, creo, que ya te lo dije antes. No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0001",head="rna_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0004",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うんうん",time=300,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000855",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Me lo habías dicho ya? Ya veo, ya veo.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="あくび",lv=5,id=9},
{"fgact",ch="里奈",act="icon",y=-500,lv=5,id=9,icon="icon03z2",x=90},
{"text"},
text={
vo={
{"vo",file="fem_rna_000856",ch="rna"},
},
ja={
{
name={"Rina"},
"♪～～～～",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Rina vuelve a tararear.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"¿Qué canción será?...",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fgact",ch="里奈",act="あくび",lv=5,id=9},
{"fgact",ch="里奈",act="icon",y=-500,lv=5,id=9,icon="icon03z2",x=90},
{"text"},
text={
vo={
{"vo",file="fem_rna_000857",ch="rna"},
},
ja={
{
name={"Rina"},
"～♪",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うんうん",time=200,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000858",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, lo olvidaba. Entre chicas no hay mucha diferencia de altura, así que las\npartes que se apiñan al apretujarnos son las mismas.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Al escuchar eso me doy cuenta de que nuestros muslos y pechos están\napretujándose uno contra el otro, y de que nuestras caras están muy cercanas\nentre sí.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0004",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000859",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ejeje~ Estamos pegaditas.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_yum_002583",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se_chu"},
{"text"},
text={
ja={
{
"Tras decir eso, Rina me besó súbitamente.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_yum_002584",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000860",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tus labios se sienten muy bien, Yuumi. Son tiernos.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_yum_002585",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿Qué... fue eso?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000861",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No te gustó?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002586",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Claro que sí, sí, pero...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000862",ch="rna"},
},
ja={
{
name={"Rina"},
"“No hay problema entonces, supongo.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_yum_002587",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No lo hay...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_yum_002588",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“O-Oye, Rina.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0001",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000863",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_yum_002589",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Q-Quizás no lo parezca, pero soy una lesbiana tranquila. Me controlo muy bien.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000864",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso lo sé.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_yum_002590",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero, si sigues haciendo eso me, me...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000865",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ejeje, ¿te convertirás en el señor lobo?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_002591",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uh.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000866",ch="rna"},
},
ja={
{
name={"Rina"},
"“No me importaría.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_yum_002592",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="うんうん",time=500,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000867",ch="rna"},
},
ja={
{
name={"Rina"},
"“Señor lobo, señor lobo, ¿no le gustaría comerse a esta blanquita niña?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"bg",time=200,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se3356"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002593",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah--”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_rna_000868",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vaya, vaya...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"msgoff"},
{"bg",file="zbluesky_summer",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=960,y2=540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Apenas me di cuenta, ya había tumbado a Rina al suelo.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"'L-Lo siento.'",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Así lo quisiera, ni siquiera esas palabras pudieron salir de mi boca.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"No podía más.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_yum_002594",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“*Nchu*... *kuchuu*... *chuu*... *chum*... *rero*... *slurp*... ah...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Paso mi lengua por el cuello de Rina.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_rna_000869",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ah, ¿v-vas a hacerlo acá?... Ahn.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_rna_000870",ch="rna"},
},
ja={
{
name={"Rina"},
"“Auh, Yuumi, ¡Yuumi!”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_yum_002595",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jaa, jaa, jaa... ngh... *chumu*... *ngh*, *reru*... *slurp*... ah...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_rna_000871",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por Dios... Ahn.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_yum_002596",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jaa, jaa, jaa... *rero*... *rero*... *slurp*... *rero*...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"se",id=1,file="se_punch_poka"},
{"mwact",act="うなづく"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000872",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Yuumi! ¡Rayos, Yuumi, despierta!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"mwact",act="うんうん"},
{"se",id=1,file="se_punch_poka"},
{"text"},
delay={
[100]={
{"se",id=2,file="se_punch_poka"},
},
},
text={
ja={
{
"Siento golpecitos en la cabeza.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_yum_002597",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¡Ah, ahh!”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"M-Me dejé llevar por completo...",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_002598",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Eso, eso solo, yo... R-Rina, esto es--”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0015",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="うんうん",time=200,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000873",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, está bien, no necesito excusas. En fin, toma esto.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Al decir eso, Rina saca algo de su mochila.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000874",ch="rna"},
},
ja={
{
name={"Rina"},
"“Créeme que pesó bastante...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_yum_002599",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué es esto? ¡E-Está pesado!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000875",ch="rna"},
},
ja={
{
name={"Rina"},
"“Una cerradura.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_yum_002600",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Una cerradura? ¿Eh? ¿Para qué?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000876",ch="rna"},
},
ja={
{
name={"Rina"},
"“Con ella podremos cerrar la puerta de la azotea desde adentro.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_yum_002601",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0016",head="rna_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000877",ch="rna"},
},
ja={
{
name={"Rina"},
"“La usan para abrirla desde afuera, pero la forma de la manija es la misma, así\nque se puede usar para cerrar desde adentro. La saqué de su lugar y la traje\naquí para poder cerrar desde adentro.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_yum_002602",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿P-Pero, por qué?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0015",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000878",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, sería todo un lío si alguien llega a venir mientras lo hacemos.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_yum_002603",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“R-Rina...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0016",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000879",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué quieres hacer? ¿Lo dejamos así?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002604",ch="yum"},
},
ja={
{
name={"Yuumi"},
"*Agita la cabeza a los lados*",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Giro mi cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000880",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ten entonces... ¿Puedes colocarla?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_yum_002605",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=160,x=-960,file="zbg053a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Tomo la pesada cerradura y me dirijo a la puerta.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Mi corazón late violentamente. Estoy tan exaltada que me siento algo mareada.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_yum_002606",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿E-Eh?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Intento colocar la cerradura, pero no logro hacerlo.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_yum_002607",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Q-Qué extraño esto. ¿P-Por qué no entra?...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="里奈",size="z2",mx=-40,mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2b0100",face="b0001",head="rna_z2b",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000881",ch="rna"},
},
ja={
{
name={"Rina"},
"“Te están temblando las manos.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_yum_002608",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0004",head="rna_z2b",x=-345,lv=5,id=5},
{"fgact",ch="里奈",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000882",ch="rna"},
},
ja={
{
name={"Rina"},
"“Dame, te ayudaré.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Diciendo eso, Rina puso sus manos sobre las mías, envolviéndome con sus brazos.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_yum_002609",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0100",face="b0002",head="rna_z2b",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000883",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aquí está el agujero de la cerradura, ¿lo ves?... Vamos, mete bien la llave...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"se",id=1,file="se_lock_light"},
{"text"},
text={
ja={
{
"Guiada por la mano de Rina, meto la llave y la giro, escuchándose un ligero\nsonido metálico a la vez que cierro la cerradura.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_yum_002610",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rinaaa.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",sync=0,mode=-2},
{"bg",file="zbluesky_summer",speed=300000,id=9,lv=9,sync=0,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"quake"},
{"se",file="se_bafu",id=1},
{"text"},
text={
ja={
{
"No tardé ni un segundo en abrazar a Rina y robarme sus labios.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_rna_000884",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nm...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_yum_002611",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rinaa, siempre, siempre he querido hacer esto, contigo.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Veo a Rina directamente a los ojos.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Rina no mostró ni una pizca de desconcierto, y más bien me devolvió la mirada,\ncon una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_rna_000885",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo sé...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Esta vez es su boca la que se acerca a la mía.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Y entonces nuestros labios se tocan.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Rina me besó. Fue un largo, largo beso.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_yum_002612",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Nm... *kuchuu*...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Su lengua se enrolla con la mía, como si tratara de lamerla.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Rina siempre ha estado a mi lado.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Nunca parando de sonreírme.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Mi Rina es pura, muy amable y realmente cariñosa.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Y por eso es que nunca había conocido esta cautivadora y sensual sensación. A\npesar de que todo esto está ocurriendo justo ahora, todavía no lo puedo\ncreer.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Pero la sensación era certera. La cálida lengua de Rina estaba moviéndose por\ntoda mi boca.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_rna_000886",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Jaa... *puhaa*...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Los labios de Rina se alejan.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_yum_002613",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah... no...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Apenas la sentí irse volví a acercar mi boca a la suya.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Vuelvo a enrollar la lengua de Rina con la mía.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_yum_002614",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“*Nchu*... *kuchuu*... *chuu*... *chum*... *rero*... *slurp*. *chuu*...\n*kuchuu*... Fuh.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_rna_000887",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi, espera... ¡Para un momento!”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_yum_002615",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="里奈",size="z1",my=40,mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",lv=4,id=5},
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Rina me aparta de ella.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000888",ch="rna"},
},
ja={
{
name={"Rina"},
"“No puedo respirar si me besas así...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_yum_002616",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah... l-lo siento...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0015",head="rna_z1a",lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000889",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa, vaya. Quizás sea necesario disciplinarte un poco.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_yum_002617",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿D-Disciplinarme?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000890",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. Disciplinarte.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000891",ch="rna"},
},
ja={
{
name={"Rina"},
"“El señor lobo solo sabe cazar y devorar. Hay que enseñarle los modales a la\nhora de comer.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0016",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000892",ch="rna"},
},
ja={
{
name={"Rina"},
"“El señor lobo necesita algo de disciplina.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_yum_002618",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Disciplina? ¿Señor lobo? Rina, qué estás...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"msgoff"},
{"se",file="se9004",vol=50,id=1},
{"fg",ch="里奈",time=500,sync=1,mode=-1,lv=4,id=5},
{"fg",ch="里奈",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",lv=5,id=5},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rna_000893",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sabes, Yuumi?... Algo de dolor y disciplina al principio podría hacerte sentir\nmuy bien después.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Rina me ve con una sonrisa, sensual como nunca había visto antes.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Me da un pequeño espasmo. Me paraliza esa sonrisa suya.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="うなづく",time=300,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000894",ch="rna"},
},
ja={
{
name={"Rina"},
"“Buena niña... Sí, así, mansita es más fácil educarte...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000895",ch="rna"},
},
ja={
{
name={"Rina"},
"“A partir de ahora te disciplinaré, muy lentamente... Si logras permanecer\nquietecita mientras tanto... te prometo que te haré sentir muy, muy bien...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_yum_002619",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿H-Hacerme sentir bien?... ¿T-Tú, Rina?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000896",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No quieres?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_yum_002620",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, c-claro que sí. ¿C-Cómo rechazaría una oferta tuya?...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0016",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000897",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hmph. Qué linda eres diciéndome eso... Bien, quédate quieta y no te muevas.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_yum_002621",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¡¿Ah--?!”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"La mano de Rina se cuela por mi falda.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_yum_002622",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Ah, eh? ¿Ehhh? ¿R-Rina? Hauu.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bg",file="ev_rna_h02_01",path=":ev/ev_rna_h02/",set="ev_rna_h02"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000898",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tu piel es tan tersa, Yuumi...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Rina desliza sus dedos lentamente sobre mis piernas.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_002623",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Haun, hauh, kuh.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*bikunbiku*",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Rina hace bailar suavemente sus dedos sobre mi piel. La sensación llega\ndirectamente a mi cerebro, y mis piernas comienzan a temblar.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_rna_000899",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sucede algo, Yuumi? Solo te toqué un poco y tus piernas ya están temblando.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_yum_002624",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A-Ah, auhh, e-es, que, hauun, nm, uh... ngh...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_rna_000900",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Se siente bien solo con tocarte los muslos?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_yum_002625",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“H-Haun, s-sí... s-se siente, muy bien... h-hauuu.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_rna_000901",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vaya, así que solo con tocarte los muslos sientes placer.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Sus dedos trepan lentamente por mi piel, y poco a poco van subiendo hacia mi\ningle.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_yum_002626",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí, tus dedos, tus dedos se sienten muy, muy, muy bieeen.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_rna_000902",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo, y solo con las piernas. De ser así...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Los dedos de Rina trepan aún más. Suben por mi ingle, y ahora se deslizan por\nel borde de mis pantaletas.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_yum_002627",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“R-Rina.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_rna_000903",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No te gusta que te acaricie las caderas?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_yum_002628",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No es que no me guste... p-pero...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Dos de sus dedos van rozando la línea de mis panties. Su ritmo era\nexcesivamente sensual, e infinitamente placentero.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_yum_002629",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A-Ahn.... A-Ah, ahhh...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_rna_000904",ch="rna"},
},
ja={
{
name={"Rina"},
"“Qué linda ropa interior llevas... Definitivamente eres toda una chica, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_yum_002630",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y-Yo, no... a-ahh.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_rna_000905",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Yo no? ¿Y qué me dices del volante que llevan tus panties? Es tan femenino...\nEres realmente tierna... Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_yum_002631",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Es que, soy muy desarreglada, y... p-pensé, en quizás, cambiar un poco...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_rna_000906",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Desarreglada, tú? No, para nada. Eres una muchacha muy linda, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_rna_000907",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y no para menos, pues fui yo quien te convirtió en esto...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_yum_002632",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿T-Tú?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_rna_000908",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo que el señor lobo comió fue una seta blanca, mortalmente venenosa... La\namanita lleva a la muerte a aquellos que comen de ella.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_rna_000909",ch="rna"},
},
ja={
{
name={"Rina"},
"“Indefensa su presa, esta cae al suelo sin vida, y de su cadáver nace una seta\nblanca.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_rna_000910",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esa seta blanca era una preciosa, muy preciosa muchacha. Nacida de la más\nvaliente de las bestias, es la muchacha más noble y pura de todas...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_yum_002633",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Esa muchacha, es...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_rna_000911",ch="rna"},
},
ja={
{
name={"Rina"},
"“No es nada que tengas que saber, no te preocupes. Solo déjalo todo en mis\nmanos, te amaestraré lenta y cariñosamente... En eso fue que te transformé,\ndespués de todo...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_rna_000912",ch="rna"},
},
ja={
{
name={"Rina"},
"“Observa, ya mis dedos están bajando por la línea de tus panties... Adivina que\nes lo que viene después.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_yum_002634",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh--? ¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_rna_000913",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Yuumi... Es increíble. Aun tras tu espalda puedo escuchar tus latidos. Y\ncada vez se aceleran más...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_yum_002635",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“R-Rinaaa... Kufuuu.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"se",file="se9010",vol=30,id=1},
{"bg",file="ev_rna_h02_02",path=":ev/ev_rna_h02/",set="ev_rna_h02"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_002636",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Mm?! ¡¿A-Auuhh, kuun?!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡¡*bikubikun*!!",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"Las punta de aquellos hermosos dedos que trepan por mi piel agitan todas mis\nconexiones neuronales.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_yum_002637",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿Hauu? ¿Eh, auh? Hauuun.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"No pude comprender lo que sucedió.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Solo sé que las conexiones nerviosas de mi cerebro hicieron cortocircuito ante\ntanto gozo, y todas las conexiones de mi cuerpo se llenaron de señales\neléctricas de placer.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"No podía estar más de pie. La parte inferior de mi cuerpo comienza a temblar\nsin parar.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*bikubikubiku*",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_rna_000914",ch="rna"},
},
ja={
{
name={"Rina"},
"“Guau... estás temblando, como si te estuvieran electrocutando.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_yum_002638",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Es que, se siente como si corriente pasara por debajo de mis caderas, Y- Y se\nsiente tan bieen, hauhn.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_rna_000915",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Así de bien se siente que lo haga con los dedos?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_yum_002639",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Los dedos?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_rna_000916",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No te has dado cuenta, del lugar que estoy tocando ahora?...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_yum_002640",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? Auuh. ¿T-Tus dedos, están aquí? ¿Eh, ehh? Jaa, haiih.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_rna_000917",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Ya te diste cuenta? Mis dedos están tocándote... aquí.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_yum_002641",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿Tus dedos, e-están, tocándome? ¡Hauhn, ah! Ahh.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*bikun*",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Mi cabeza no alcanza a comprender lo que sucede.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Pero mis ojos vieron, con toda certeza, la mano de Rina moverse dentro de mi\nropa interior.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"No percibo una sola pizca de realidad. Y sin embargo, un placer tan intenso que\npodría hacer quebrar mis caderas corre por todo mi cuerpo.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_yum_002642",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡R-Rina, n-no! Hau, haun, ah, ahhh.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Mis neuronas están en estado de confusión. El placer se traga toda facultad de\ncomprensión, y bloquea todo mi raciocinio. El placer esclaviza mi cuerpo, el\ncual solo era capaz ahora de reaccionar al deleite del acto.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Mi cuerpo no para de estremecerse, embobado, atontado por el placer...",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"――*pakupaku*...",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"El temblor de mis piernas se intensifica, y ahora están moviéndose\ndescontroladamente a los lados.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Doy pena.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Confundida por el placer, termino por mostrar mi lado más vergonzoso y sucio a\nRina. ¿Qué tan ridícula me veré ante los ojos de los demás? Toda la zona\ninferior a mis caderas está estremeciéndose, y me muevo como en una especie\nde baile cómico.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Pero――",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_yum_002643",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rinaa, Rinaa, Rinaaa, Rinaaa, ah, ahh.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Grito su nombre. Probablemente mis mejillas están empapadas con lágrimas, y\nestoy chorreando saliva de mi boca.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Aun en ese estado, Rina me abraza cariñosamente y me sostiene.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="fem_rna_000918",ch="rna"},
},
ja={
{
name={"Rina"},
"“Increíble, es increíble, Yuumi. ¿Tan bien se sintió? Abrías y cerrabas tanto\nlas piernas, ¿tan bien se sentían mis dedos?”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_yum_002644",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Se sienten bien, Rina, tu mano, se sintió muy bien.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_rna_000919",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vaya cara que tienes. Se te está saliendo la saliva.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="fem_yum_002645",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Es que, no puedo, no puedo creer que hicieras esto conmigo, hauuuh.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="fem_rna_000920",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Jamas creíste que pudiera ser capaz de hacerte esto?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="fem_yum_002646",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, jamás, hauh.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="fem_rna_000921",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Aun cuando siempre te la pasas imaginándolo?”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="fem_yum_002647",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ni siquiera en mi imaginación eres tan atrevida.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_rna_000922",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo. ¿Lo cual quiere decir que esto ha superado tu imaginación?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="fem_yum_002648",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, es mucho mejor. No puedo creer, que tus dedos... pudieran... pudieran,\nhacerme tanto cariño...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="fem_rna_000923",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues sí, la realidad superó mi imaginación también. Jamás pensé que las chicas\npudieran mojarse tanto como lo has hecho.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="fem_yum_002649",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“P-Pero es que... me gustas.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="fem_rna_000924",ch="rna"},
},
ja={
{
name={"Rina"},
"“De igual manera jamás me imaginé que pudieras... mojarte tanto. Mi mano está\nbañada con tus fluidos vaginales.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_yum_002650",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero, es que, Rina, Rina.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
"Lo único que podía hacer en el momento era disfrutar el placer que me invadía.\nNo tenía la facultad para comprender lo que sucedía.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"A pesar de eso, sabía que mis fluidos estaban cayendo por mis piernas, y\ntambién de que estos se estaban chorreando de las manos de Rina, cayendo\nhacia el suelo.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="fem_rna_000925",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es increíble, tus fluidos están goteando sobre el suelo, Yuumi. Si sigues\ngoteando podría formarse un charquito.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="fem_rna_000926",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, pero si llegara a suceder eso podrías deshidratarte y desmayarte.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
vo={
{"vo",file="fem_yum_002651",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Kuun, c-creo que antes de eso terminaría volviéndome loca del placer.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
vo={
{"vo",file="fem_rna_000927",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así parece. Por la forma en que te tiemblan las piernas y te estremeces\nmientras te chorreas, no pareces tener mucho control de tu propio cuerpo\nahora.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="fem_yum_002652",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es, es que, fuuhn.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="fem_rna_000928",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así que de esta forma alcanzan las mujeres el orgasmo... aunque, viendo todo\neste desastre diría que eres la única mujer que lo alcanza de esta manera. Ni\nsiquiera yo he llegado a estos extremos.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
vo={
{"vo",file="fem_yum_002653",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“P-Pero, es que yo, yooo... kuun, hauh.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
vo={
{"vo",file="fem_rna_000929",ch="rna"},
},
ja={
{
name={"Rina"},
"“Está bien, cálmate un poco y habla. Puedes quedarte tranquila, que no dejaré de\njugar contigo acá abajo.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="fem_yum_002654",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Es justamente por eso, que no puedo hablar bien.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
vo={
{"vo",file="fem_rna_000930",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Paro entonces?”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
vo={
{"vo",file="fem_yum_002655",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, no pares, no quiero.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
vo={
{"vo",file="fem_rna_000931",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mentira, solo bromeaba. No dejaré de tocarte, así que cálmate y habla.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*bikunbikun*",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="fem_yum_002656",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hauuh, kuun.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
vo={
{"vo",file="fem_yum_002657",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Apenas se me ocurrió, la idea de que podrías hacerme, auh, esto, yo--”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="fem_rna_000932",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Yo?”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
vo={
{"vo",file="fem_yum_002658",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“P-Pensé, sería imposible, no terminar asííí.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="fem_rna_000933",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mmmm. ¿Y bien? ¿Puedes explicarme detalladamente de qué manera terminaste, y\ndónde?”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="fem_yum_002659",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"se",file="se9010",vol=50,id=1},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Sentí el usual, dulce olor del cabello de Rina. Su aroma...",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
"Y justo en ese instante, se alejó de mí.",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="fem_yum_002660",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿R-Rina?”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"se",file="se9012",vol=50,id=1},
{"text"},
delay={
[1000]={
{"se",stop=1,time=500,id=1},
},
},
text={
ja={
{
"Rina camina unos pasos, para luego detenerse.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Y entonces me observa de nuevo con esa sensual, y a la vez enormemente amorosa\nsonrisa.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"msgoff"},
{"bg",file="zbluesky_summer",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=-960,y2=-540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
vo={
{"vo",file="fem_rna_000934",ch="rna"},
},
ja={
{
name={"Rina"},
"“A ver, ¿dónde es que lo sientes? Dímelo, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="fem_yum_002661",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? E-Eso--”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
vo={
{"vo",file="fem_rna_000935",ch="rna"},
},
ja={
{
name={"Rina"},
"“Explícame bien dónde... Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="fem_yum_002662",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A-Auuh, Rinaaa.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
"Con Rina envolviéndome entre sus brazos hasta ahora, me había olvidado de todo.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
"Pero, ahora que se aleja de mí y pierdo su calor, entro en cuenta de la\nridícula y asquerosa escena que he hecho frente a ella.",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
"Las señales eléctricas de placer que corrían por mi cuerpo se convierten en\nseñales de vergüenza, y siento ahora como si la sangre me estuviera\nhirviendo.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
vo={
{"vo",file="fem_rna_000936",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tienes la cara completamente roja... Fue tan fuerte la sensación que te mojaste\nlos muslos e incluso derramaste un poco sobre el suelo. ¿Es que no te da pena,\nYuumi?”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
vo={
{"vo",file="fem_yum_002663",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sííí...”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
vo={
{"vo",file="fem_rna_000937",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bien, tus respuestas están mejorando. Quizás valga la pena amaestrarte después\nde todo...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
vo={
{"vo",file="fem_yum_002664",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“R-Rinaaa... esto me da mucha pena...”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
vo={
{"vo",file="fem_rna_000938",ch="rna"},
},
ja={
{
name={"Rina"},
"“Apenas estamos comenzando, Yuumi...”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"Rina me ve con una tierna y hechizante sonrisa.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
vo={
{"vo",file="fem_rna_000939",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pronto esa vergüenza se volverá placer... pues tendrás que revelarme todo lo\nque llevas por dentro...”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
vo={
{"vo",file="fem_yum_002665",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Revelar... todo lo que llevo dentro?”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
vo={
{"vo",file="fem_rna_000940",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es. ¿Me lo mostrarías, Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
vo={
{"vo",file="fem_yum_002666",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿M-Mostrar qué?”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
vo={
{"vo",file="fem_rna_000941",ch="rna"},
},
ja={
{
name={"Rina"},
"“El lugar de donde estás derramando todo estos jugos... ¿No te da curiosidad\nsaber que sucede allí?”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
vo={
{"vo",file="fem_yum_002667",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eh, y-yo...”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
vo={
{"vo",file="fem_rna_000942",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yo sí me muero por saber... Observa mis dedos.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"Rina me muestra los dedos con los que estuvo tocándome.",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
vo={
{"vo",file="fem_rna_000943",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así, solo basta que los suba un poco para que tus líquidos caigan hacia mi\nmuñeca.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
vo={
{"vo",file="fem_rna_000944",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quiero ver tu coño, Yuumi. Ese mismo coño que derramó todo esto.”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
"Rina menciona el nombre que le dan al aparato reproductor de las mujeres. Co*o.\nY se refiere específicamente al mío.",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
"Su juego de palabras penetra y excita mis oídos.",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002668",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hauuhn.”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"――*dokun*",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
"Sus sensuales palabras estimulan mi vagina.",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
"Mi vagina, roja ahora, se hincha y palpita, como si estuviera recibiendo toda\nla sangre saliendo de mi corazón.",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
"Solo con escuchar a Rina decir 'Tu coño', me mojé aún más.",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
vo={
{"vo",file="fem_yum_002669",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y-Yoo...”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
vo={
{"vo",file="fem_rna_000945",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi, muéstrame tu coño.”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
vo={
{"vo",file="fem_yum_002670",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sííí...”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
"Contesto de manera automática.",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
"Disciplinar. Eso fue lo que Rina propuso.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
"Disciplina, amaestramiento. Eso es lo que Rina hace por mí ahora, y es la más\ngrande de las recompensas que ha preparado para mí.",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
"Y por eso respondo de la manera más delicada, y también absurda posible. Como\nlo haría una perra buscando cariño de su dueño.",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
ja={
{
"Así funciona la dominación con amor.",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"cgdel",id=-1},
{"se",file="se0897s",vol=50,id=1},
{"bg",file="ev_rna_h02_03",path=":ev/ev_rna_h02/",set="ev_rna_h02"},
{"text"},
text={
ja={
{
"Levanto mi falda.",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
ja={
{
"Casi como si se tratara del saludo de una damisela.",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
"Sin embargo, las reverencias se hacen alzando solo un poco la punta de la\nfalda. No alzándola hacia la zona del pecho y exponiendo la ropa interior\ncomo lo estoy haciendo ahora.",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
"Con la pose de una reverencia de señorita, expongo, la ropa interior... que\ncubre, mi sucia y palpitante vagina.",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
vo={
{"vo",file="fem_rna_000946",ch="rna"},
},
ja={
{
name={"Rina"},
"“Increíble... tienes la ropa interior tan mojada, que... se puede ver tras\nella...”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_002671",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Uh, ugh...”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
vo={
{"vo",file="fem_rna_000947",ch="rna"},
},
ja={
{
name={"Rina"},
"“Está tan mojado que parecieras haberte orinado encima. Menuda cosa, no podía\nesperar más de la pequeña pervertida que siempre fantasea conmigo.”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
"Contesto con una floja y dejada sonrisa. Ante su amorosa dominación respondo\ncon amorosa sumisión.",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
vo={
{"vo",file="fem_yum_002672",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí... soy una pequeña pervertida, que siempre fantasea contigo.”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
vo={
{"vo",file="fem_rna_000948",ch="rna"},
},
ja={
{
name={"Rina"},
"“No lo dudo, siempre andas diciendo que eres una. Pero no pensé que lo fueras\ntanto hasta que vi cómo te transformaste apenas te toqué el coño.”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
ja={
{
"Una vez más se escapa la palabra 'coño' de los hermosos labios de Rina. Solo\ncon escuchar eso mi vergüenza fue pasando poco a poco a convertirse en\nplacer.",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
vo={
{"vo",file="fem_yum_002673",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Es porque, porque me encantas, Rina. Solo con sentirte tocándome, yo... kuun.”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
ja={
{
"――*hikuhikuhiku*...",
{"rt2"},
},
