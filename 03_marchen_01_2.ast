},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
vo={
{"vo",file="fem_yum_002682",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, viéndome...”",
{"rt2"},
