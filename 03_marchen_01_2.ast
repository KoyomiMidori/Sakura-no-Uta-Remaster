},
},
},
linkback="block_00384",
linknext="block_00386",
},
block_00386={
{"text"},
text={
vo={
{"vo",file="fem_rna_000973",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uhm, ya veo. Quisiera ver entonces más, más y más de tu lado pervertido, Yuumi.\nQuiero ver más de lo que haces a solas todos los días.”",
{"rt2"},
},
},
},
linkback="block_00385",
linknext="block_00387",
},
block_00387={
{"text"},
