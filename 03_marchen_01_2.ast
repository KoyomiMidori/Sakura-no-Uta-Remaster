block_00732={
{"text"},
text={
vo={
{"vo",file="fem_yum_002814",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Sí... Jaa, jaa... Cuando me ves, mi pecho... se acelera, y... sale, más...”",
{"rt2"},
},
},
},
