"“Kyaaan... ¡¡¡¡IYAAAAAAAAAAAAAAAAAaahhhnnn!!!!”",
{"rt2"},
},
},
},
linkback="block_00852",
linknext="block_00854",
},
block_00854={
{"bg",file="ev_rna_h01_10",sync=0,face=1,time=400,path=":ev/ev_rna_h01/",set="ev_rna_h01"},
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡¡*Bsshhh*...!!",
{"rt2"},
},
},
},
linkback="block_00853",
linknext="block_00855",
},
block_00855={
{"text"},
text={
ja={
{
"Eyaculo también.",
{"rt2"},
},
},
},
linkback="block_00854",
linknext="block_00856",
},
block_00856={
{"bg",file="ev_rna_h01_11",sync=0,face=1,time=400,path=":ev/ev_rna_h01/",set="ev_rna_h01"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001132",ch="rna"},
},
ja={
{
name={"Rina"},
"“A-Ahh... ay... ahaa... a-ahh...”",
{"rt2"},
},
},
},
linkback="block_00855",
linknext="block_00857",
},
block_00857={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*tiembla*...",
{"rt2"},
},
},
},
linkback="block_00856",
linknext="block_00858",
},
block_00858={
{"text"},
text={
vo={
{"vo",file="fem_yum_002863",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jaa, iiih... Jaa, jaa, jaa, auuuaahh...”",
{"rt2"},
},
},
},
linkback="block_00857",
linknext="block_00859",
},
block_00859={
{"text"},
text={
ja={
{
"Nuestros temblores van calmándose poco a poco, aun las dos con nuestros\nclítoris empujados uno contra el otro.",
{"rt2"},
},
},
},
linkback="block_00858",
linknext="block_00860",
},
block_00860={
{"text"},
text={
ja={
{
"Después de temblar ambas al mismo ritmo, caímos de trasero sobre el suelo de la\nazotea.",
{"rt2"},
},
},
},
linkback="block_00859",
linknext="block_00861",
},
block_00861={
{"text"},
text={
vo={
{"vo",file="fem_rna_001133",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa... jaa... nmm...”",
{"rt2"},
},
},
},
linkback="block_00860",
linknext="block_00862",
},
block_00862={
{"text"},
text={
vo={
{"vo",file="fem_yum_002864",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ngh, ah, nmm... Jaa... nmmm... Jaa...”",
{"rt2"},
},
},
},
linkback="block_00861",
linknext="block_00863",
},
block_00863={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Respiramos agitadamente, sin aliento alguno para decir algo.",
{"rt2"},
},
},
},
linkback="block_00862",
linknext="block_00864",
},
block_00864={
{"text"},
text={
ja={
{
"Nos vemos a los ojos mientras nuestros hombros suben y bajan violentamente.",
{"rt2"},
},
},
},
linkback="block_00863",
linknext="block_00865",
},
block_00865={
{"text"},
text={
ja={
{
"Y entonces, nos besamos lentamente.",
{"rt2"},
},
},
},
linkback="block_00864",
linknext="block_00866",
},
block_00866={
{"text"},
text={
ja={
{
"Fue nuestro beso más largo hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00865",
linknext="block_00867",
},
block_00867={
{"text"},
text={
ja={
{
"Seguimos besándonos, sin parar, hasta que los temblores desaparecieron...",
{"rt2"},
},
},
},
linkback="block_00866",
linknext="block_00868",
},
block_00868={
{"scene",file="scene09"},
{"msgoff"},
{"bgm",stop=1,time=1000},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_summer",id=9,lv=9,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm009"},
{"text"},
text={
ja={
{
"Después de acomodarnos los uniformes y haber recogido los instrumentos de\npintura, volvimos a echarle un ojo a la azotea.",
{"rt2"},
},
},
},
linkback="block_00867",
linknext="block_00869",
},
block_00869={
{"text"},
text={
vo={
{"vo",file="fem_yum_002865",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jaaa... No debería haber quedado rastro alguno.”",
{"rt2"},
},
},
},
linkback="block_00868",
linknext="block_00870",
},
block_00870={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001134",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esperemos que no, pero vaya que salió volando por todo el lugar... No pensé que\nel cuerpo humano fuera capaz de expulsar tanto líquido...”",
{"rt2"},
},
},
},
linkback="block_00869",
linknext="block_00871",
},
block_00871={
{"text"},
text={
vo={
{"vo",file="fem_yum_002866",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, cierto, ¿estás bien de la anemia? Con lo frágil que eres me da miedo de que\nhaya sido demasiado para ti.”",
{"rt2"},
},
},
},
linkback="block_00870",
linknext="block_00872",
},
block_00872={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001135",ch="rna"},
},
ja={
{
name={"Rina"},
"“Estoy bien. O no, creo que no del todo...”",
{"rt2"},
},
},
},
linkback="block_00871",
linknext="block_00873",
},
block_00873={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001136",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque bueno, era algo que quería hacer después de todo.”",
{"rt2"},
},
},
},
linkback="block_00872",
linknext="block_00874",
},
block_00874={
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_002867",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00873",
linknext="block_00875",
},
block_00875={
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="うなづく",lv=5,id=5},
{"se",file="se9010",id=1,vol=30},
{"text"},
text={
ja={
{
"Abrazo a Rina.",
{"rt2"},
},
},
},
linkback="block_00874",
linknext="block_00876",
},
block_00876={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0013",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001137",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Pasa algo? ¿A qué viene este repentino abrazo romántico?...”",
{"rt2"},
},
},
},
linkback="block_00875",
linknext="block_00877",
},
block_00877={
{"text"},
text={
vo={
{"vo",file="fem_yum_002868",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, no pasa nada... Solo que, te quiero mucho.”",
{"rt2"},
},
},
},
linkback="block_00876",
linknext="block_00878",
},
block_00878={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001138",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yo también. Te amo, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00877",
linknext="block_00879",
},
block_00879={
{"text"},
text={
ja={
{
"Sin nada que poder responder a esas palabras, solo pude quedarme abrazando\nfuertemente a Rina.",
{"rt2"},
},
},
},
linkback="block_00878",
linknext="block_00880",
},
block_00880={
