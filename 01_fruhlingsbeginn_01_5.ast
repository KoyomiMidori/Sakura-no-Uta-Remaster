astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bgm",file="bgm030"},
{"bg",file="ev_com_a15_08",rule=139,vague=40,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000199",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y bien? ¿De qué forma comenzó este sistema?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, el sistema takikomi gohan...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"El sistema takikomi gohan... Bueno, debo admitir que ese nombre encaja\nperfectamente.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Me parece que todo comenzó un día que fui a la cantina después del receso del\nmediodía...",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"bgm",file="bgm027"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No le sobra algo de pan?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="man_oys_000006",ch="oys"},
},
ja={
{
name={"Viejo"},
"“Ya cerramos. Ya comenzaron las clases, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás comenzaron ya, pero tengo hambre.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="man_oys_000007",ch="oys"},
},
ja={
{
name={"Viejo"},
"“Ya veo, entiendo. Tendrás que aguantar entonces, muchacho. Si de veras crees\nque en la vida todo resultará como lo quieres, entonces estás bien\nequivocado. Los estudiantes suelen ser bastante ignorantes de eso...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, si me dice eso entonces me pone en aprietos ahora...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"El viejo de la cantina estaba comiendo un arroz de microonda y una lata de\nyakitori.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese es el yakitori de Hotoi... ¿Es de sabor a sal?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="man_oys_000008",ch="oys"},
},
ja={
{
name={"Viejo"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los de sabor a sal saben muy bien...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="man_oys_000009",ch="oys"},
},
ja={
{
name={"Viejo"},
"“Estos son mis favoritos.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueh, ciertamente son sabrosos, pero solo eso...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="man_oys_000010",ch="oys"},
},
ja={
{
name={"Viejo"},
"“¿Qué quieres decir con 'solo eso'? Basta con que sepa bien, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente, es importante el sabor, sin embargo la versatilidad es también\nimportante en los ingredientes.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="man_oys_000011",ch="oys"},
},
ja={
{
name={"Viejo"},
"“¿Versatilidad? ¿De qué me estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"El yakitori de Hotoi.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Aun siendo una de las marcas más famosas, es también la lata de yakitori que\nmás fanáticos empedernidos posee.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Desde que nació en un año tan movido como lo fue 1970, ha seguido siendo el\ncorredor estrella.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Es la primera lata de yakitori del mundo.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Por ende, son muchos los que poseen peculiaridades respecto a estas latas.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"¡Las de sabor a sal son las mejores! ¡No, las mejores son las de tare! ¡No, las\nde tare picante! ¡No, me parece que las número uno son las de ajo pimienta!\n¡Tampoco se puede dejar atrás las de yuzukosho!",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Debido a lo barato del producto, estos gourmet de clase B son muy quisquillosos\nrespecto a los sabores.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="man_oys_000012",ch="oys"},
},
ja={
{
name={"Viejo"},
"“Yo he venido comiendo estas latas desde que salieron a la venta por primera\nvez. Y las que más me encantan son estas de sabor a sal. Jovencito, no vengas\na hablarme de eso a mí como si supieras tanto.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo lo que trata de decir... pero ¿no le parece algo triste ir\nsiempre con lo mismo?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="man_oys_000013",ch="oys"},
},
ja={
{
name={"Viejo"},
"“No siempre es lo mismo. A veces como las de caballa hervida, y otras, caballa\nhervida en miso. Por supuesto, a veces también como papardas al estilo\nkabayaki.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Este viejo... Me está hablando igual de puros enlatados.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No ha querido nunca comer ese yakitori de una manera más deliciosa?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="man_oys_000014",ch="oys"},
},
ja={
{
name={"Viejo"},
"“¿De una manera más deliciosa? ¿Qué demonios quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal como lo dice la palabra. Yo puedo ofrecerle una manera mucho más sabrosa y\ndistinta a la que tiene usted de comer esa lata de yakitori.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="man_oys_000015",ch="oys"},
},
ja={
{
name={"Viejo"},
"“¿De qué estás hablando?... Baja tu tono, mocoso...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por ejemplo, eh... ¿Qué le parecería un takikomi gohan preparado con esa lata?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="man_oys_000016",ch="oys"},
},
ja={
{
name={"Viejo"},
"“¿Takikomi gohan?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, claro, en ese caso sale mejor usar las de sabor a tare... ¿Qué tal?\nImagíneselo. El sabor del takikomi gohan impregnado con el yakitori de lata\nsabor a tare...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="man_oys_000017",ch="oys"},
},
ja={
{
name={"Viejo"},
"“Hmph, ya veo... Y por eso estuviste chachareando acerca de la versatilidad y\ntodo eso...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, e incluso para hacer oyakodon sirve también. Las de sabor a tare son más\nversátiles...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_oys_000018",ch="oys"},
},
ja={
{
name={"Viejo"},
"“¿Oyakodon?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, si tan solo me da los huevos puedo preparárselo. Hay muchas otras maneras\nde comer esas latas.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"El viejo se imaginó la gran variedad de platos que podrían prepararse con las\nlatas de yakitori y estuvo a punto de babearse. Pero...",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="man_oys_000019",ch="oys"},
},
ja={
{
name={"Viejo"},
"“Hmph. De igual manera, es imposible conseguir los utensilios en el colegio.\nCuando regrese a casa lo haré por mi cuenta.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso, si esto fuera un colegio normal...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero tengo un plan en mente. Qué tal, ¿se apunta al plan o no, viejo?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="man_oys_000020",ch="oys"},
},
ja={
{
name={"Viejo"},
"“¿Y bien? ¿Tu nombre es?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="man_oys_000021",ch="oys"},
},
ja={
{
name={"Viejo"},
"“¿Kusanagi? ¿Me estás diciendo que te llamas Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"El viejo observó detenidamente mi cara. Y entonces...",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="man_oys_000022",ch="oys"},
},
ja={
{
name={"Viejo"},
"“¡Está bien! ¡Me anoto!”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",file="ev_com_a15_08",path=":ev/ev_com_a15/",set="ev_com_a15"},
{"bgm",file="bgm004"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000200",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo, los instrumentos de cocina, eh... Y de esa manera elegiste a nuestro\nsupervisor...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"bg",file="ev_com_a15_09",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000201",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero qué problemático eso de andar involucrando a nuestro supervisor... Por\nDios, si llegan a descubrirlos podría ponerse en peligro al club de arte.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero el tipo se alegró bastante en aquel momento.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"bg",file="ev_com_a15_10",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000202",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ciertamente, es una apuesta peligrosa, pero Wakata no habrá tenido más opción\nque unirse a ese plan.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Wakata es un simple profesor de tiempo parcial. Aun siendo un profesor, no\ntiene dinero.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"bg",file="ev_com_a15_11",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000203",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, no me refiero a eso...... Me refiero a algo mucho más simple.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000204",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Este takikomi gohan está muy bueno. Bastante... Así que por eso era inevitable\nque yo llegara tarde a clases, ¿tal vez?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bueno, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"bg",file="ev_com_a15_09",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000205",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No está mal.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Acabas de decir que está muy bueno.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"bg",file="ev_com_a15_12",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000206",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sí? ¿No será tu imaginación?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bg",file="ev_com_a15_08",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000207",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dejando eso de lado, Kusanagi, ¿por qué te la pasas metido en esta sala de arte\naun cuando no pintas?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tampoco me la paso metido acá... Además, este es el único lugar donde puedo\nconseguir los instrumentos para preparar el Takikomi gohan...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000208",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si buscas instrumentos de cocina podrías buscarlos en la sala de práctica de\ncocina, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si llego a prepararlo allí me descubrirán rápidamente.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"bg",file="ev_com_a15_09",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000209",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero aun así, en todo momento vienes a la sala de arte con una nueva excusa,\n¿no?...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fueron ustedes en principio quienes me trajeron aquí a la fuerza...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"bg",file="ev_com_a15_08",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000210",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Al principio? Ahh, cierto. Ahora que lo recuerdo, la primera vez que nos vimos\nte secuestré y te traje acá.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No vuelvas a secuestrar a nadie de esa manera. Aquel día me asusté bastante.\nUna mujer que jamás había visto antes me gritó de repente, molesta.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"cgact",stage="bg049",act="いいえ"},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2b0200",face="b0006",head="mak_z2b",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",size=20,lv=5,id=9},
{"se",file="se3130",id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000211",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Tú eres Naoya Kusanagi? ¡Tú! ¡¿Cómo puedes ser capaz de hacer algo tan\ndisparatado como no entrar al club de arte?!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_com_a15_08",path=":ev/ev_com_a15/",set="ev_com_a15",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aquel momento pensé 'No sé qué esperas de mí golpeando la mesa y buscándome\ndiscusión'.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bg",file="ev_com_a15_12",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000212",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es que realmente no me parecía que tuviera sentido alguno que no entraras a\nnuestro club de arte, aun con el talento que tienes.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tenga o no talento, eso no lo decide nadie más. Soy yo quien decide a qué club\nquiero unirme.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bg",file="ev_com_a15_09",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000213",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero aun así no podía aceptarlo.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, a juzgar por la manera en que hablas, pareciera que te refirieras a algo\ndel pasado, eh. ¿Ya te rendiste acaso?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000214",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De ninguna manera. Todavía no lo he terminado de aceptar aún. Además, no\naprendo tan fácilmente las cosas.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya estamos en tercer año... ¿Aún no desistes de la idea?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"bg",file="ev_com_a15_13",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000215",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por supuesto que no. Ya lo sabes, ¿no? ¡Makoto Toritani es egoísta, y no se\nqueda tranquila hasta que todo sale como ella lo desea! ¡¿No es así?!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Toritani dice eso de manera tajante y fuerte mientras me señalaba con su dedo.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Después de quedarme pasmado por un momento, puse una sonrisa forzada en mi\nboca.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todo como lo desea uno, eh...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"bg",file="ev_com_a15_09",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000216",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué quieres decir? ¿Por qué sonríes de esa manera tan sugestiva?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es nada...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Observo el bulto de caballetes que tumbé hace días.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Están mejor organizados que como estaban antes de que los tumbara.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Probablemente, aunque pase mis dedos por ese montón de caballetes, no tendrán,\nal igual que el marco de la ventana, ni una sola partícula de polvo...",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente te gusta el club de arte.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"bg",file="ev_com_a15_14",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000217",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En realidad no tanto, simplemente es el único lugar donde puedo pasar el\ntiempo...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente, es bastante acogedora esta sala de arte...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"bg",file="ev_com_a15_09",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000218",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí, es acogedora...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias a alguien que se esmera en mantenerla de esa manera...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"bg",file="ev_com_a15_15",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000219",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"bg",file="ev_com_a15_09",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000220",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien, ya entendí. En fin, te la pasas acá porque te parece agradable... Es\nasí, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bg",file="ev_com_a15_11",sync=0,face=1,time=400,path=":ev/ev_com_a15/",set="ev_com_a15"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000221",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo... Si es así, supongo que está bien...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000222",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, ¿será que nos vamos a la clase?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿No te lo vas a comer todo?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000223",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Idiota, las asistencias se cuentan como tardías, pero solo hasta el primer\ntercio de la clase... Si no vamos ya, me pondrán como inasistente.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué tacaña, eh.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0002",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000224",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí. Soy tacaña. Y egoísta. Así que no se te olvide.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0016",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000225",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dame de comer de eso que preparas de vez en cuando. ¡Siempre te dejo que uses\neste lugar, así que es una orden!”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0003",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000226",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Y además! ¡Después de clases! ¡Hoy también iremos con todas a atraer nuevos\nintegrantes! ¡¿Entendido?!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, está bien.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Ajajaja...",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Esta mujer realmente es tacaña y egoísta.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"select",label="label05",exp="f.mak=f.mak+1",text="select"},
{"select",label="label06",text="select"},
{"select",name="select01_01_3",mode="sys"},
{"text"},
select={
ja={
"Pero también es terriblemente amable.",
"Pero así es Toritani.",
{"rt2"},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero también es terriblemente amable.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"excall",label="join3"},
{"text"},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero así es Toritani.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"excall",label="join3"},
{"text"},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0008",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000227",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué estás diciendo?”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es nada. En fin, vamos a clases, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0003",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000228",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Vamos rápido.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vale, vale.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
"Las clases de la tarde terminaron, al igual que las de la mañana, sin ningún\nproblema.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"A pesar de eso, debido a que llevaba tiempo sin experimentar la vida escolar,\nuna ligera fatiga estaba invadiendo poco a poco mi cuerpo.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Estoy cansado...",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Estrecho ligeramente la espalda, y aprovecho para echar un ojo por el salón.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Casualmente la cercanía del asiento donde Rin estaba sentada pasó por mi vista,\naunque... supongo que ya hizo algunos amigos de confianza, pues está ahora\nhablando y riendo animadamente con ellos.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Al ver de reojo esa escena por un instante, me dirigí a los pasillos, de los\ncuales se podía escuchar el usual bullicio que se escucha al terminar las\nclases.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Si me quedo despistado podría acabar metiéndome en otro problema innecesario\nmás.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"se",file="se9012",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",stop=1,id=1,time=500},
{"se",file="se1279",id=2},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"En los pasillos del colegio estaba dándose a cabo, al igual que ayer, una\nfuerte guerra entre los clubes para atraer a nuevos integrantes.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, Toritani dijo que hoy también iríamos con todo a buscar\nnuevos integrantes, pero...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obviamente, debo huir de eso...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que... la mejor opción es irme de una vez.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"En fin, es importante procurar no encontrarme con Toritani.\nY, cuando traté de dirigirme en dirección hacia el portón frontal del colegio――",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Del final del pasillo vino corriendo de manera desesperada una estudiante con\nuna falda llamativamente corta.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"bgm",stop=1,time=500},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=-590,y=40,zone="0x000000",file="zbg046a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2c0000",face="c0001",head="kei_z2c",lv=5,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_ked_000456",ch="ked"},
},
ja={
{
name={"???"},
"“¡Esto es grave! ¡Hay un gran alboroto por la ciudad!”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Ohhh.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"se",file="se9023",id=1},
{"bgm",file="bgm007"},
{"msgoff"},
{"cgdel",lv=1,id=5,rule="cinema",time=400,sync=0},
{"fg",mode=-2,sync=0},
{"bg",x=-420,y=40,zoom=80,speed=10000,file="zbg046a",path=":bg/",z2=100,x2=-590,y2=40,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0001",head="kei_z2c",lv=5,id=9,sync=0},
{"extrans",time=500},
{"cgact",stage="zbg046",act="びっくり",size=3,time=300,loop=-1,sync=0},
{"fgact",ch="圭",act="びっくり",size=3,loop=-1,time=200,sync=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000457",ch="ked"},
},
ja={
{
name={"???"},
"“¡Uwaan! ¡Qué cruéles! ¡Qué cruéles son!”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"La muchacha vino corriendo hacia acá, con lágrimas en los ojos.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"msgoff"},
{"fg",mode=-2},
{"se",file="se9023",id=1},
{"bg",sync=0,file="bg046i",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"fg",ch="圭",size="z2",zoom=110,speed=500,sync=0,mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0001",head="kei_z2c",x2=260,y2=-32,z2=80,x=0,y=0,lv=5,id=9},
{"ex",time=100,func="wait"},
{"se",stop=1,id=1,time=500},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0020",head="kei_z2c",x=0,y=0,lv=5,id=9,zoom=110},
{"fgact",ch="圭",act="びっくり",lv=5,id=9},
{"se",id=2,file="se1866"},
{"quake"},
{"quake",mode="mw"},
{"fgact",ch="圭",act="icon",lv=5,id=9,icon="icon09z2",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_000458",ch="ked"},
},
ja={
{
name={"???"},
"“¡Ugyan!”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0006",head="kei_z2c",x=0,y=0,lv=5,id=9,zoom=110},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000459",ch="ked"},
},
ja={
{
name={"???"},
"“¡¿Qué te pasa, imbécil?! ¡¿Cómo vas a atacarme con un lariat de repente?!”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0012",head="kei_z2c",x=0,y=0,lv=5,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="man_ked_000460",ch="ked"},
},
ja={
{
name={"???"},
"“¿Mm? Eh... ¿Naoya?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal como me lo imaginaba. Kei...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"El evento tradicional de cada año. Ya me acostumbré por completo.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Encima de llevar un vestido de mujer, tiene amarrado el cabello y lleva una\npeluca puesta... A los ojos de cualquiera se ve como toda una mujer...",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Su otro nombre es la misteriosa Miss Yumihari.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Se ha vuelto una leyenda, conocida por ser una misteriosa y hermosa chica que\nsolo aparece por esta época y en los días del festival cultural.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2c0000",face="c0008",head="kei_z2c",x=0,y=0,lv=5,id=9,zoom=110},
{"text"},
text={
vo={
{"vo",file="man_ked_000461",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Naoya, necesito que me escuches!”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1c0000",face="c0008",head="kei_z1c",x=0,lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Pervertido.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0013",head="kei_z1c",x=0,lv=4,id=9},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000462",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qu--?!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Después de decir únicamente eso, me regreso en la otra dirección como si no\nhubiera visto nada, de manera cruel.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"El hecho de que esté merodeando por ahí vestido así significa que ya las cosas\nhan progresado bastante.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0005",head="kei_z1c",x=0,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000463",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡E-Eh! ¡Espera! ¡Por lo menos sabes que me obligaron a hacer esto en contra\nde mi voluntad, ¿no?!”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? No sé, la verdad, pero te estás esforzando, eh...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Mientras hablaba con una débil voz, Kei agarró el borde de mi uniforme al\ntratar de irme y volvió una vez más a tratar de pedirme ayuda.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0006",head="kei_z1c",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0009",head="kei_z1c",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000464",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡E-Espera un momento! ¡Naoya-kun, ¿piensas dejarme solo en este estado?!”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No... Por estar en ese estado es que quiero y deseo que no te me acerques.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0021",head="kei_z1c",x=0,lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000465",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Qué malo! ¡Qué cruel! ¡Ahh!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Al escuchar mis palabras, Kei infló sus cachetes. Fue una reacción muy alejada\na todo lo que entiende como hombría.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0019",head="kei_z1c",x=0,lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000466",ch="ked"},
},
ja={
{
name={"Kei"},
"“Jaa... ¿Por qué tuve que terminar de esta manera comenzando apenas el período\nescolar? Me quiero morir...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Kei se puso detrás de mí, tratando de esconderse mientras jalaba el borde de su\nfalda, visiblemente preocupado por lo corta que era.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",x=0,lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000467",ch="ked"},
},
ja={
{
name={"Kei"},
"“Auh, ahh, t-todos están viendo hacia acá. Seguramente están pensando que estoy\nloco... Seguramente están pensando que me falta un tornillo, que soy un\nrarito.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Probablemente eso no es cierto... No hay nadie que sepa que 'esto' es Kei.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Encima de eso, probablemente nadie se da cuenta de que 'esto' es un hombre. Lo\nque está robando la atención de todos es simplemente lo lindo que se ve.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0005",head="kei_z1c",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000468",ch="ked"},
},
ja={
{
name={"Kei"},
"“Por ahora me ocultaré en el baño.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si buscas el baño de chicas, está por acá.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0015",head="kei_z1c",x=0,lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000469",ch="ked"},
},
ja={
{
name={"Kei"},
"“Qué cruel eres, aun viendo cómo tu mejor amigo está en tantos aprietos.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lamentablemente, mi mejor amigo o lo que sea que sea no es una chica tan linda.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0006",head="kei_z1c",x=0,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000470",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No soy una chica! ¡Y aunque me llames linda eso solo me molesta!”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, realmente me da igual, no te me acerques. El hecho de que estés acá\nsignifica que...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"se",file="se9023",id=1},
{"fg",ch="真琴",size="z1",mx=-40,mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-345,lv=4,id=10},
{"fg",ch="圭",speed=500,mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0006",head="kei_z1c",x2=0,x=345,lv=4,id=9},
{"ex",time=0,func="wait"},
{"se",stop=1,time=500,id=1},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0016",head="mak_z1b",x=-345,lv=4,id=10},
{"fgact",ch="真琴",act="うなづく",lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000229",ch="mkd"},
},
ja={
{
name={"???"},
"“Fufufu... Qué ingenuo eres. No dejaré que huyas... ¡Kei Natsume! ¡No, mejor\ndicho, la modelo estrella del club de arte!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0014",head="kei_z1c",x=345,lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"fgact",ch="圭",act="icon",x=-100,lv=4,id=9,icon="icon18z1",y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_000471",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Nyaaah! ¡¿Apareció?! ¡Apareció! ¡Naoya!”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fgact",ch="圭",act="停止",lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",x=-345,lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0017",head="mak_z1b",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000230",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, pero si está también Kusanagi. A juzgar por tu aspecto, tenías toda la\nintención de huir, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tch, por culpa de Kei me descubrió...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0016",head="mak_z1b",x=-345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000231",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque trates de huir no lo lograrás... ¡Hoy es el momento para capturar\nbastantes nuevos integrantes, así que vengo con toda la intención de hacerlos\ntrabajar hasta que se desmayen!”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0006",head="kei_z1c",x=345,lv=4,id=9},
{"fgact",ch="圭",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0008",head="kei_z1c",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000472",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Eso es una violación a los derechos humanos! ¡Te voy a demandar! ¿No crees, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A mí no me metas.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0007",head="kei_z1c",x=345,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000473",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué?! ¡¿Qué hay de mis derechos humanos?! ¡Después de que me vestiste de\nesta manera comenzando el período!”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000232",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hmph, no me hagas reír. Reclama por tus derechos humanos cuando te empiecen a\nsalir vellos en las piernas.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Así es, así es! ¡Tú reclama por tus derechos humanos cuando te salgan vellos\nen las piernas!”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0021",head="kei_z1c",x=345,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000474",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué tú también, Naoya?! ¡Esto es demasiado cruel!”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dejando eso de lado, Toritani. No hay problema con él, pero en mi caso las\nhoras de trabajo fuera del horario regular están prohibidas por la ley.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",mode=-2},
{"se",file="se3130",vol=60,id=1},
{"fg",ch="真琴",size="z2",my=40,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0200",face="a0017",head="mak_z2a",lv=5,id=10},
{"fgact",ch="真琴",act="icon",lv=5,id=10,icon="icon05z2",x=90,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000233",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Aahn?!”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Me ve con una aterradora cara.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las leyes fueron reformadas en abril de este año.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Retrocedo con bastante fuerza.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0210",face="a0025",head="mak_z2a",lv=5,id=10},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0210",face="a0004",head="mak_z2a",lv=5,id=10},
},
},
text={
vo={
{"vo",file="fem_mkd_000234",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien... vamos, vamos, no te quedes parado ahí, Kusanagi, colabora tú también\ncon la repartición de folletos. Vamos a cazar nuevos integrantes.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0200",face="d0002",head="mak_z2d",lv=5,id=10},
{"fgact",ch="真琴",act="うなづく",lv=5,id=10},
{"se",file="se2497",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Toritani me extendió el bulto de folletos que tenía en sus manos.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, ¿repartí folletos ayer y hoy también tengo que hacerlo?... ¿Es que acaso\nsoy un revolucionario de algún país por ahí?...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"se",file="se9012",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",stop=1,time=500,id=1},
{"excall",file="01_fruhlingsbeginn_01_6"},
{"text"},
