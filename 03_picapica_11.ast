astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c05_01",path=":ev/ev_eye_c05/",set="ev_eye_c05"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"ex",time=1000,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg050a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Tomo una de los frascos de vidrio que estaban dispuestos en una esquina de la\nsala del club. Adentro había una especie de polvo bastante fino.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Harina? ¿Harina de trigo?... No... son cenizas.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003580",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Kusanagi? ¿Qué estás haciendo acá--- ah, eso.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Toritani señala la muestra que cargo en mis manos.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Son cenizas?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003581",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Es uno de los materiales usados para crear esmalte cerámico. Ya te\nhabía dicho que la dueña suele mandarme, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003582",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A veces me manda cargamentos de hasta unos 10 kilos, y otras veces me manda\npaquetes que solo alcanzan los tantos cientos de gramos.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003583",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En cualquier caso, siempre guardo muestras así como esa...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003584",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No sé de dónde son extraídas. Ni qué tipo de ceniza, o de metal o piedra o\ntierra. No sé nada al respecto, y por eso guardo las muestras...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003585",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo único que me queda es escribirles la fecha y alguna que otra información no\nmuy detallada... Por Dios, ni siquiera sé si sirve de algo guardarlas como\nmuestras.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La fecha?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003586",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está escrita al fondo de la botella.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Al voltear la botella, veo que en la base estaba escrita la fecha. También está\nescrita la información verificada por Toritani. Estas son... cenizas de\nabedul.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0003",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003587",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, cierto, este es el momento indicado. Dame un segundo.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"se",file="se9010",id=1},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani abre la tapa de una caja que sacó del estante. Al ver adentro, habían\nunas piezas de cerámica en miniatura y un pequeño frasco de vidrio.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003588",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Recuerdas que dije que te mostraría la muestra de las piedras que usé para\nfabricar 'La Luna y las Estrellas'? Lo que está en este pequeño frasco es esa\nmuestra.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y estas piezas miniatura de cerámica?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003589",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Son piezas de prueba. Las hago antes de aplicar el esmalte cerámico a la pieza\nverdadera, para comprobar la consistencia de la mezcla y probar otras cosas.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé, tampoco desconozco tanto del tema. Simplemente no pensé que también\nfueras capaz de fabricar cosas tan lindas como estas.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003590",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿L-Lindas? ¿Te parece? Probar el esmalte en una pieza real y con volumen me\nsirve para ver cómo recae este sobre la misma pieza, y de qué forma se\nproducen parches irregulares en el acabado...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Están muy bien hechas, ¿no crees que quizás así como están tengan potencial\nsuficiente como producto?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003591",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmm... Hay algunos fabricantes que crean y venden juntos mamezara y choko, pero\nyo prefiero almacenarlos junto a los datos experimentales de mezcla y\ncocción.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, como resultado experimental, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003592",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tal cual.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003593",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque estas tres las fabriqué usando el mismo esmalte, bajo la misma\ntemperatura y en el mismo horno, así que son prácticamente iguales... Te daré\nuna.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Toritani pone la pieza de prueba sobre mi mano.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad puedo quedármela?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0004",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003594",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Se nota en tu cara que te mueres por quedártela. Es muy raro ver esa expresión\ntuya.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Toritani se ríe al decir eso y cierra la caja.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003595",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque... para hablar con más precisión... ah, aunque creo que ya debes\nsaberlo.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003596",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay veces que dependiendo del lugar del horno donde se coloque la pieza, el\ntipo de horno, entre otros factores, ocurre el 'youhen'...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El youhen, eh.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Dentro de todo lo que ocurre en el horno, hay ciertos aspectos que no se pueden\nconocer sino hasta abrirlo.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Hay veces que la combinación de diversos factores actúan entre sí, produciendo\nun resultado totalmente inesperado para el alfarero.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"A eso se le llama, en japonés, youhen(窯変).",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No parece ser un factor muy de tu agrado. ¿O quizás debería decir más bien, del\nagrado de Usagiko-san?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003597",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí. Para mí... o más bien, para Usagiko Hakushuu, en lo que a piezas\nideales se refiere es preferible, en la medida de lo posible, evitar todo\ntipo de yohen incontrolable...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003598",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"De repente, Toritani cierra su boca. Su mirada cambia, como si estuviera ahora\nviendo a lo lejos, inmersa ahora profundamente dentro de sí...",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Recuerdo lo que Toritani me llegó a decir una vez.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000559",ch="mkd"},
},
ja={
{
"――¿Que por qué?... Cualquiera se daría cuenta. El olor a pintura que llevabas\nencima. El aspecto que tenías a diario... Esa característica atmósfera\nalrededor que tiene alguien cuando pinta...",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000560",ch="mkd"},
},
ja={
{
"――Esa cara pensando en la estructura. Esa cara pensando en los pigmentos a\nusar. La manera de actuar de alguien que pinta, es especial...",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg050a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Sí... es verdad. Ciertamente, la manera de actuar de alguien que pinta―― o\nque fabrica cualquier cosa, en general, es especial.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",id=1,file="se1895"},
{"msgoff"},
{"bg",file="bg048e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
"Suena la campana, y las clases de la mañana llegan a su fin. Todos los\nestudiantes comienzan a desplazarse, cada uno buscando disfrutar el receso\ndel mediodía a su manera.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
"... ¿Mm?",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"se",file="se1279",id=1},
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"La dirección que Toritani tomó al salir del salón...",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"No va ni al horno escalonado ni tampoco a la sala de arte. ¿A dónde irá?",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",file="se9012",id=1,loop=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zoom=100,speed=200000,file="zbg046e",path=":bg/",z2=50,x2="@",y2="@",x=-300,y=100,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="真琴",size="z2",speed=100000,sync=0,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2c0100",face="c0001",head="mak_z2c",x2=-100,x=200,lv=5,id=9},
{"cgact",stage="zbg046",act="びっくり",size=2,time=500,loop=-1,sync=0},
{"fgact",ch="真琴",act="びっくり",size=8,loop=-1,time=270,sync=0,lv=5,id=9},
{"text"},
text={
ja={
{
"Pensé que podría alcanzarla a mitad de camino, pero se movió con bastante\nrapidez.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"La manera en que se abre paso de manera fluida entre los montones de alumnos\napostados en los pasillos charlando era ligera y con gracia.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Camina sin duda ni incertidumbre, sin voltear.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Muy seguramente ni se imagina que la estoy siguiendo...",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",stop=1,id=1,time=500},
{"msgoff"},
{"bg",file="bg052a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"La biblioteca, eh...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Camino lentamente entre los estantes de libros, buscando a Toritani.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"La biblioteca del colegio Yumihari es bastante extensa, y teniendo a Toritani\nmoviéndose también, la tarea de encontrarla se hace terriblemente difícil.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Termino dándome por vencido, y decido esperar cerca de las mesas de lectura. No\nhabía casi nadie en el amplio rincón de lectura, a pesar de que estamos en\npleno receso de mediodía.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Probablemente se deba a que aún están todos almorzando. No hay nadie en la\nsilenciosa biblioteca.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003599",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Oh, vaya.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ey.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Toritani me saluda con una mano, cargando entre sus brazos unos cuantos libros\nde mediano tamaño, y uno de tamaño grande.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003600",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Qué raro que estés viniendo a la biblioteca.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Toritani se sienta, y a pesar de no haber nadie en la biblioteca, procura\nhablar en voz baja.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003601",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué no te sientas?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, creo que lo haré.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",mode=-1,lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al sentarme en la silla, Toritani dejó de hablarme y comenzó a leer los libros\nen silencio.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Eran libros especializados en cerámica y alfarería.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"A pesar de tener ya suficiente conocimiento y técnica, todavía los sigue\nleyendo... Muy propio de ella, tan diligente y aplicada.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Siendo una institución con bastante fuerza en lo que son las artes, el colegio\nYumihari está muy bien dotado de libros de arte y textos técnicos.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Su biblioteca es el lugar indicado para buscar libros especializados que, de\nintentar comprarlos normalmente, resultarían muy caros.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"se",file="se2497",vol=50,id=1},
{"text"},
text={
ja={
{
"Solo se escucha el sonido de las páginas siendo hojeadas.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Al posar mi mirada sobre el enorme libro que Toritani se trajo, extiendo mi\nmano.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Este libro parece ser de una temática distinta a la de los demás. Más que un\nsimple enorme libro, parece ser un catálogo...",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Botero...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Fernando Botero. Es un artista conocido por las particulares expresiones de\naspecto gordo y grueso en sus obras. Si Botero se encargara de dibujarlos,\ntendríamos a una Mona Lisa obesa y a un Cristo gordo.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"El catálogo que Toritani se trajo era de Botero, y no de sus pinturas, sino de\nsus esculturas.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003602",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, eso es un catálogo de una exposición de esculturas al aire libre realizada\nhace unos años en la ciudad. Quería recopilar y verlas todas juntas, así que\nel catálogo me ahorrará el trabajo.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo usarás de referencia? Aunque me parece que esto está bastante alejado a lo\nque normalmente fabricas... ¿Piensas cambiar de rumbo ahora?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003603",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ni en broma, no soy capaz de hacer esa apuesta tan peligrosa ya a este punto.\nSolo que...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Solo que?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003604",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, ¿cuál crees que es la mayor diferencia que hay entre la contemplación\nde un cuadro y la de una escultura?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003605",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A mi parecer, es la capacidad para tocar.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0027",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003606",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso me encantan las obras de arte en bronce de Botero. Son muy populares\ncomo arte público, entretenidas y tocables. Las considero como un ideal a\nseguir.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0028",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003607",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tienen una forma grande, con bastante masa y volumen... redondas y gruesas... A\ncualquiera se le escaparía la risa de ver algo así en su ciudad.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003608",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es una forma alejada del paisaje cotidiano, pero que logra convivir con el\nhumor, y por eso no se hace desagradable.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003609",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Una forma simple y gentil, a la cual los niños puedan extender sus manos\ninocentemente después de preguntarse '¿Qué es eso?'.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0004",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003610",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y bueno, yo también llegué a hacer lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Has visto sus obras en persona?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003611",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, llegué a cruzarme con el gato sin bigotes en el jardín de Alicia.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El gato sin bigotes en el jardín de Alicia... Una metáfora... no es, supongo.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0027",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003612",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es justo como lo dije. Fue cuando era aún niña, así que no sé en qué museo fue,\npero... hay un jardín de esculturas llamado 'El jardín de Alicia'.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003613",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Para entonces no conocía quién era Fernando Botero, y me tomó tiempo darme\ncuenta de que la escultura se trataba de un gato.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0028",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003614",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Era grande, y redondo. Cuando lo vi, pensé, '¿Qué será esto...?'. Quería\ntocarlo, y lo hice. Era liso, y como el sol caía directamente sobre él, era\ncálido.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003615",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Era todavía una niña, así que no pude describirlo bien en palabras, pero de\nhacerlo ahora, diría que lo que hubo en mi corazón en ese momento fue\nemoción.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003616",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Era una cosa enorme y extraña. Se me hizo enorme, brillante, y... muy llena de\nsecretos.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003617",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esta extraña cosa está llena de 'algo'. Y por eso es que está tan grande y\ngruesa. Eso fue lo que pensé.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0028",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003618",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sentí algo bastante misterioso en ese 'algo'... Y no es algo que pueda explicar\ncon la lógica, así que no puedo decir más respecto a por qué me pareció\nmisterioso...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003619",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, fue en ese jardín donde conocí por primera vez la emoción que nace de\nesa avasalladora cantidad de masa y su textura.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pasó a ser una huella imborrable de tu infancia?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003620",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... así es.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0028",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003621",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y tal vez por eso quise volver a verlo una vez más.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0027",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003622",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En lo que son los detalles, tal vez se vea muy distinto a lo que estoy tratando\nde crear. Pero si voy a crear un objeto de arte, entonces...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003623",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quiero que sea algo que cualquier persona pueda tocar y sentir sin reserva\nalguna, y con tranquilidad.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003624",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque la verdad, si es por volver a verlo de nuevo, entonces podría investigar\nen qué museo está e ir a tocarlo yo misma, pero...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podrías ir, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0012",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003625",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eh.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vamos juntos el fin de semana?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
},
vl02={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003626",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A-Ah, sí... podría ser...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? Es raro verte hablando de manera entrecortada.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003627",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La verdad es que, todavía no sé muy bien... si hacer lo otro este fin de\nsemana, o no.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí, ya lo habías mencionado antes. ¿Aún no te has decidido?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003628",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... Me pareció que era una apuesta un tanto peligrosa... Y no estoy muy\nsegura de si sea buena idea usar mi valioso fin de semana en algo tan\nincierto...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0010",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003629",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De poder, quisiera ir por lo seguro, y hacer todo lo que pueda sin meter tanto\nla pata... o al menos eso he pensado hacer, pero... en todo momento se me\nviene a la cabeza...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003630",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero creo que dentro de poco tomaré mi decisión.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo. De ser así te acompañaré el fin de semana, así que dime cuando\nquieras. Te ayudaré.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0025",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003631",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Realmente lo dices como si no fuera la gran cosa. ¿Qué piensas hacer si la\nlabor se complica mucho?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que qué haré? Pues nada, seguiré acompañándote.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0013h",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003632",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011h",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003633",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Realmente lo dices... con tanta ligereza...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tampoco creas que soy capaz de decirle eso a cualquiera con tanta facilidad. Lo\ndigo porque eres tú, y nadie más.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0018h",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003634",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso lo sé...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0010h",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003635",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por Dios...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Toritani hundió su cara en el libro a medio leer que tenía enfrente suyo. Su\ncabellera no logró ocultar sus rojas orejas y su enrojecido cuello, pero\npreferí no decirle nada al respecto.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="nightsky_spring",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",lv=4,id=9},
{"bgm",file="bgm009"},
{"text"},
text={
ja={
{
"Toritani apareció mientras yo usaba la portátil.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te mandaron de nuevo a que te tomaras un descanso?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0015",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003636",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, lo mismo de nuevo... Esas muchachas, están preocupándose demasiado por mí.\nY por cosa extraña, se veían algo alegres cuando me mandaron a descansar...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente tienes una cara extraña en este momento.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003637",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Una cara extraña? Pero qué maleducado... Simplemente no me parece justo que\nhagan eso.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="真琴",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani se sienta al otro lado de la mesa, de la misma forma que la vez\npasada, mientras murmuraba quejas. Oculta por las plantas decorativas,\nninguno de los clientes puede verla donde está ahora.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=500,y=-120,file="zbg031a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",file="zchair1",id=3,lv=3,zoom=70,x=310,y=10,path=":cg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"fg",ch="真琴",size="z2",my=-40,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"se",file="se3214",id=1,vol=50},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003638",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué trajiste tu portátil hoy?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quise investigar unas cuantas cosillas. Y por si acaso, ya le pedí permiso a\nlas otras muchachas de medio tiempo para usar el tomacorriente.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003639",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya lo sé. Además, acá permitimos el uso de computadoras sin mayor\ninconveniente.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Giro la portátil, de manera que la pantalla dé hacia Toritani.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es acá, ¿no? Donde está el gato sin bigotes.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0012",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
ja={
{
"Toritani muestra una expresión de ligero asombro, y luego asiente.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0003",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"fgact",ch="真琴",act="うなづく",lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003640",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, es ahí. Es increíble que lo encontraras.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo encontré relativamente rápido, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Debido a que los bigotes estaban a la altura de los niños que asistían al museo\ny era peligroso, le solicitaron permiso al autor y los retiraron.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=16},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0028",head="mak_z2a",x=0,y=50,lv=5,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003641",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo, así que fue por esa razón... Se podría decir entonces que el artista\nprefirió la convivencia de su obra con los espectadores sobre todo, supongo.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así pareciera.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0028",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003642",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A mí también me gustaría crear una obra así, que pueda ser tocada y sentida por\nmuchas personas. Sería algo triste que se quedara encerrada cuidadosamente en\nuna bóveda.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás fue ese deseo lo que te llevó a crear vajillas y tazas que pudieran\najustarse a las manos y bocas de bastantes usuarios.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=5,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003643",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... tal vez. Creo que también influyó eso. Al principio solo fue por hacer\ndinero, pero después se fue volviendo cada vez más entretenido.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente da igual lo que te haya motivado a comenzar. Lo que importa es que\ntus vajillas y tazas están muy minuciosa y cuidadosamente diseñadas para el\nuso de todos.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",x=0,y=50,lv=5,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003644",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... aunque, quizás sea eso lo que me esté alejando del verdadero arte. Los\nartistas suelen tener un ego inflado como un globo...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003645",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero creo que es justamente eso lo que les lleva a crear toda esa enorme\ncantidad de obras por las cuales se destacan.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueh, hay algunos que son así, y otros que no. Podemos poner al mismo Botero de\nejemplo, ¿no? Prefirió mantener a los niños fuera del peligro de sufrir una\nherida a dejar su obra intacta.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"fgact",ch="真琴",act="うんうん",size=5,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003646",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jeje, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente, debe sentirse bien tocar este gato. Toda esta masiva forma... y su\nsuave textura...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0012",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003647",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué pasa, por qué te quedas callado de repente?...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es nada... Simplemente, me acordé de algo inesperadamente.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0017",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003648",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0015",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003649",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Procuraré no preguntártelo ahora.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué? Vamos, pregúntame.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=100},
{"fg",ch="真琴",size="z1",my=40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0900",face="a0007h",head="mak_z1a",lv=4,id=16},
{"se",file="se3214",id=1,vol=50},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0018h",head="mak_z1a",lv=4,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003650",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No quiero! ¡Y además, ya se terminó mi descanso! ¡Nos vemos después!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0018h",head="mak_z1b",lv=4,id=16},
{"text"},
delay={
[150]={
{"se",file="se9012",vol=60,id=1},
},
[200]={
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=16},
},
},
text={
ja={
{
"Toritani desaparece al fondo de la barra mientras se sonrojaba. Tan aguda como\nsiempre, sí señor...",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Nos vemos después, eh. Eso quiere decir que quizás me pregunte después.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Los músculos de mi cara se aflojan, a punto de tomar una embobada sonrisa. La\nactitud de Toritani conmigo se ha vuelto bastante suave.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
"Las horas de trabajo en Quimera llegan a su fin.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Las muchachas de medio tiempo, al haber terminado las labores del cierre del\nlocal, se habían ido ya, y justo cuando traté de irme yo también, Toritani me\nllamó.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=16},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=16},
{"fgact",ch="真琴",act="うなづく",lv=4,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003651",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me llegaron unos mensajes al celular. Uno de la dueña, y el otro de Nei-chan.\nLo dejé apagado mientras trabajaba, así que fue hace un momento que me di\ncuenta.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acerca de la Exposición Moore?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fgact",ch="真琴",act="うなづく",lv=4,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003652",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... así es.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0003",head="mak_z1a",lv=4,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003653",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo de Nei-chan fue un mensaje de agradecimiento. Me dio las gracias por el\nlibro, y por la luna de papel.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0028",head="mak_z1a",lv=4,id=16},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003654",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dijo que, 'la luna que mamá bajó para mí es brillante como la luna de verdad, y\nes muy preciosa'... Y que por eso, cuidará muy bien de ella.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003655",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Suena a una vieja canción.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una canción?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0028",head="mak_z1a",lv=4,id=16},
{"text"},
text={
ja={
{
"Toritani comienza a tatarear suavemente. Era una de las canciones que sonó del\nviejo reproductor de casetes.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0029",head="mak_z1a",lv=4,id=16},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003656",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es un viejo número musical. 'Incluso una luna de papel puede convertirse en una\nde verdad'.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003657",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“'Si tu amor me das'... Así va la canción.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una canción de amor?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fgact",ch="真琴",act="うなづく",lv=4,id=16},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0028",head="mak_z1a",lv=4,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003658",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, una canción de amor. Una simple, inocente y cariñosa canción de amor.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0027",head="mak_z1a",lv=4,id=16},
{"text"},
text={
ja={
{
"Toritani vuelve sus ojos de nuevo al cielo.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003659",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... La pieza perfecta para los que buscan recitar su amor.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=16},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003660",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero no puedo quedarme solo con canciones de amor. Hay algo que quiero\nconseguir, sea lo que sea que tenga que hacer.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003661",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Al ver tu cuadro... ese cuadro tuyo, el que decora el ayuntamiento――'Fantasía\nde un día de cerezos'.\nAl ver ese cuadro, me quedé estancada, detenida en el camino. Sin embargo,\nKei intentó seguir adelante.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003662",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kei es, sin duda alguna, un genio. Y por eso...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="いいえ",lv=5,id=16},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0005",head="mak_z2a",lv=5,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003663",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por Kei--- no, no solo Kei. Por el bien de esos dos genios, yo...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003664",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No me daré por vencida. No quiero hacerlo. Y por eso, es que daré todo lo mejor\nde mí.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0026",head="mak_z2a",lv=5,id=16},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0011",head="mak_z2a",lv=5,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003665",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por más que ponga todo mi conocimiento, voluntad y técnica... no sería\nsuficiente para crear una obra que cautive a los dos genios. Una obra que los\npropulse aún más hacia adelante.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003666",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es por eso que ya no puedo seguir divagando más... Entre tanto pensar y pensar,\npor fin me decidí.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=16},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0015",head="mak_z2a",lv=5,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003667",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En nuestra primera noche... desperté dentro de tus brazos. Tus brazos\nenvolviéndome se sentían tan cálidos, y... y, por eso, me dije a mí misma que\nno podía seguir así.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0009",head="mak_z2a",lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003668",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eres amable, muy bueno. Aunque fabrique una luna de papel, seguramente harías\nde ella una luna de verdad, con tu amor y todas esas otras cosas hermosas que\nexisten.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0010",head="mak_z2a",lv=5,id=16},
{"fgact",ch="真琴",act="いいえ",lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003669",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero las cosas no pueden terminar así. Yo no quiero que terminen así.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0011",head="mak_z2a",lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003670",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No tengo alas para ir a la luna.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0005",head="mak_z2a",lv=5,id=16},
{"fgact",ch="真琴",act="うなづく",lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003671",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero ya no soy esa niña que lloraba pidiendo por ella.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0026",head="mak_z2a",lv=5,id=16},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0027",head="mak_z2a",lv=5,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003672",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Una luna de papel no es suficiente――\nY no por mí, sino por esos genios, yo--”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0005",head="mak_z2a",lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003673",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Conseguiré la luna de verdad.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003674",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La crearé con mis propias manos.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_picapica_12_1"},
{"text"},
linkback="block_00193",
},
label = {
top={block="block_00000",label=1},
},
}
