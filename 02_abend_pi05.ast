astver = 2.0
astname = "ast"
ast = {
block_00000={
{"bg",file="ev_eye_c03_01",path=":ev/ev_eye_c03/",set="ev_eye_c03"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="black",path=":bg/"},
{"se",id=1,file="se2225"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm009"},
{"fg",ch="真琴",size="z1",mx=40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0900",face="d0004",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001350",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bienvenido... ah, vaya, llegaste rápido.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"La impactante revelación de ayer me hizo olvidar por completo recibir la taza,\nasí que vine a buscarla.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001351",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vas a estudiar ahora de todas formas, ¿no? No tengo problema en llevártela\nhasta tu casa si quieres.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni en broma, no puedo obligarte a hacer ese trabajo con lo ocupada que estás.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0004",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001352",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm, está bien, de ser así... toma.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Toritani me da la caja con la taza adentro. No podré incurrir en gastos fuera\nde lo necesario por un buen tiempo, pero la satisfacción que me da esta taza\nlo vale.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001353",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero qué carita de satisfacción tienes...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jamás pensé que llegaría a poner mis manos sobre esta serie de la marca.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001354",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Te irás a las clases suplementarias después de esto?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, pensaba regresar a casa antes para dejar la taza.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Toritani le echa una pequeña mirada al reloj.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0002",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001355",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aun así te sobra tiempo, ¿no? Quédate un momento entonces a probar un nuevo\nplatillo.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es? ¿Algo dulce? ¿O algo salado?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0003",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001356",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es dulce. Aunque, vaya, Kusanagi... a pesar de ese aspecto tuyo veo que te\ngustan las cosas dulces.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo admito. Me da la impresión de que en un futuro terminaré siendo la clase\nde adulto que acompaña su cerveza con torta de chocolate.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0017",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001357",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Torta de chocolate como acompañante de cerveza? Realmente no te importa nada,\nen cierta forma...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tiene de malo combinar las cosas que a uno le gusta?... ¿Y bien? ¿Dónde\nestá ese platillo o lo que sea que se va a probar?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001358",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, espera un momento, lo traigo enseguida.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"se",file="se9012",id=1},
{"fg",ch="真琴",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Después de ver a Toritani desaparecer en la cocina, me siento sobre una silla\ncercana. El local estaba hoy también tranquilo y silencioso, solo con unos\npocos de sus clientes más habituales adentro.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"se",stop=1,time=500,id=1},
{"fg",ch="真琴",size="z1",mx=40,mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001359",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aquí está, toma.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Toritani coloca en la mesa una taza de café, y algo con la forma de un ave que\nparecía estar hecho de azúcar.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0003",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001360",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es un rakugan. Conseguí algo de azúcar raro, así que lo preparé yo misma.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Rakugan? ¿Ese dulce que se hace con una mezcla de azúcar y harina endurecida?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001361",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, es usual verlos ser ofrecidos como ofrendas a los espíritus durante el\nObon, aunque ahora están surgiendo nuevos tipos.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0004",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001362",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay de sabor a chocolate, de chai, de ramune... Y también los hay en formas muy\nlindas, como pingüinos o corazones.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Existen todas esas variedades?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001363",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Los preparé usando azúcar rara y un poco de sirope, así que no es\nprecisamente un rakugan, y el azúcar raro que usé es distinto también al\nwasanbon usado normalmente, así que lo llamo así solo por conveniencia.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué ambigua esa descripción.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001364",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La dueña lo envío, y lo único que escribió fue 'te envío algo de azúcar rara',\nasí que tampoco sé de dónde la obtuvo.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0029",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001365",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque bueno, puedes llamarlo 'dulce' y ya, si quieres. Por cierto, yo misma\nhice el molde.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Con un cincel?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001366",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, ¿por qué?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que eres hábil para todo, eh.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001367",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No convence mucho que me lo diga alguien como tú.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Sobre el centro del pequeño plato estaba servido un dulce del tamaño de la\nsegunda falange del dedo pulgar. Tiene la forma de un ave.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Tomo con mis dedos el brillante y blanco dulce.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es una garza?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001368",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001369",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Garzas y patos salvajes. También grullas y cisnes.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿'El atrapapajaros'?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0003",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001370",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Tampoco es que lo he leído tantas veces, pero esa escena me dejó una fuerte\nimpresión, y siempre he querido preparar algo así.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001371",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Leí una y otra vez esta escena y me la aprendí, todo para preparar estos dulces\nde garza.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001372",ch="mkd"},
},
ja={
{
name={"Makoto"},
"'Es muy fácil. Las garzas se reúnen en los bancos de arena de la Vía Láctea,\ndonde se pueden relajar, ya que siempre, vayan donde vayan, regresan a su río\nde origen.'",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001373",ch="mkd"},
},
ja={
{
name={"Makoto"},
"'Espero a que bajen, las atrapo por sus patas extendidas y luego, las aplano\ncontra el suelo, donde mueren tranquilamente.'",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001374",ch="mkd"},
},
ja={
{
name={"Makoto"},
"'Después, lo único que hay que hacer es prensarlas.'",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001375",ch="mkd"},
},
ja={
{
name={"Makoto"},
"'¿Prensarlas? ¿Para conservarlas como ejemplares de estudio?'",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001376",ch="mkd"},
},
ja={
{
name={"Makoto"},
"'No, no. Para comerlas, por supuesto.'",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001377",ch="mkd"},
},
ja={
{
name={"Makoto"},
"'¡Qué raro! ~dijo Campanella, doblando el cuello con extrañeza.'",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001378",ch="mkd"},
},
ja={
{
name={"Makoto"},
"'No hay nada de raro. Mirad ~el hombre se levantó, bajó su fardo de la red de\nequipajes y lo desató con movimientos rápidos~'",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0029",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001379",ch="mkd"},
},
ja={
{
name={"Makoto"},
"'Están recién cazadas.'",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001380",ch="mkd"},
},
ja={
{
name={"Makoto"},
"'¡Anda, son de verdad! ~gritaron lo muchachos sin darse cuenta.'",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001381",ch="mkd"},
},
ja={
{
name={"Makoto"},
"'Unas diez garzas, tan blancas y brillantes como la Cruz del Norte que habían\nvisto un momento antes, estaban alineadas con el cuerpo un poco aplanado y\nlas patas negras encogidas, de modo que parecían un relieve.'",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001382",ch="mkd"},
},
ja={
{
name={"Makoto"},
"'Mira, tienen los ojos cerrados ~dijo Campanella, tocando con delicadeza los\nblancos párpados en forma de media luna. Las plumas de la cresta, también\nblancas, sobresalían como pequeñas lanzas.'",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"El pequeño dulce de garza blanca que tenía entre mis dedos brillaba\nligeramente. Tanto los blancos párpados en forma de media luna, así como las\nblancas plumas de la cresta con forma de lanza, habían sido reproducidas\nsobre el manjar.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Al meterlo en mi boca, este desapareció de mi lengua, como si fuera nieve\nderritiéndose. Era un dulzor que me atravesaba, totalmente distinto al azúcar\nque consumo normalmente.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001383",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pensé que sabría bien metiéndolo en el café.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0004",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001384",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así como normalmente acompañamos el café con galletas o chocolate, estoy\nplaneando incluir esto como un pequeño extra durante un tiempo.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001385",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A la dueña le gusta el color negro, pero también le gusta el blanco, por lo que\nsiempre suele mandar varias cosas blancas como esta azucar.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001386",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y por eso es que he tenido muchas más oportunidades de usar el color blanco en\nmi esmalte cerámico.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0900",face="d0011",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001387",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quizás los demás le digan 'blanco Usagiko', pero en realidad ese esmalte\ncerámico ha nacido de la arena y las piedras que la dueña me ha enviado, y lo\nque yo en realidad hago es solo una pequeña parte de todo el trabajo.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero eres tú quien fabrica el esmalte. Si no fuera por ti, entonces todo lo que\nla dueña ha enviado no pasaría de ser más que piedra y arena.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0008",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001388",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tienes razón. Lo reconozco.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001389",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Un dulce azucarado. Hecho con un azúcar rara que solo recibí una vez, y que\nno volveré a tener en mis manos. Realmente es un encuentro único de por vida.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0002",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001390",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y así como este azúcar, también he recibido muchas piedras y arenas que jamás\nvolveré a recibir jamás... Sirven bien para piezas únicas, pero para mis\npropios productos, no.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Piedra y arena... Ya veo, los materiales base para el esmalte cerámico...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001391",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entre todos esos materiales base, hay una clase de arena en particular que no\npuedo olvidar.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001392",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El banco de la Vía Láctea, donde las garzas caen del cielo en oscuro violeta\ncomo si fueran nieve... La dueña llegó a ir una vez a un lugar así.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001393",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Las garzas que caen sobre los bancos de arena de la Vía Láctea. Las blancas\naves que van desvaneciéndose al tocarlas. La arena del río que brilla tenue,\nblanca, en la noche...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001394",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La dueña llegó a enviarme arena de ese mismo lugar, así que no puedo negar su\nexistencia, pero... Pero, no volveré a tenerlo en mis manos, pues tampoco\nsabemos dónde queda ese lugar.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001395",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La misma dueña trató una y otra vez de ir de nuevo, pero no ha podido. Las\npistas que ella misma escribió no sirven de nada, así que no hay manera de\nhacer algo.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh... sí, habías dicho que tenía problemas de orientación, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001396",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sé que tú también lo eres, Kusanagi, pero la dueña es, en particular, un caso\nbastante severo. Con bastante frecuencia se perdía cuando trataba de ir a su\npropio colegio.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sorprende que aun así sea capaz de viajar por allí y por allá, eh...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001397",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Siempre que se propone ir a una plantación, termina comprando el café de un\nlugar completamente distinto. Es normal que haga eso. Y no se conformó con\nJapón. Ahora está merodeando y haciendo lo mismo por todo el globo...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siendo como es, realmente es asombroso que aun así pueda regresar a Quimera\nocasionalmente.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0016",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001398",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que siempre termina regresando justamente cuando no piensa en regresar.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001399",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, se me olvidaba. También hice unos caramelos, ¿quieres?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2d0900",face="d0002",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Toritani me muestra los caramelos que habían en una cesta. Eran unos caramelos\ncasi en forma de botón, con un ligero color amarillo y envueltos en papel\ntransparente.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Bekkoame?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0003",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001400",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Estos también los hice yo misma, de mi propio molde.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Jaa?! Esos moldes son de chapa, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay que ver que definitivamente eres hábil para todo...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0017",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001401",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya te lo dije, Kusanagi, no me convence para nada que me lo digas tú.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0015",head="mak_z2d",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0001",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_001402",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El colegio Yumihari está muy bien dotado, solo con tener los materiales y el\nequipo necesario se puede hacer prácticamente todo. Tú mismo lo has\nexperimentado ya, Kusanagi. ¿O no?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque me queda la duda, ¿por qué estás haciendo tantos dulces?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0002",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001403",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, me pidieron el favor de que hiciera unos cuantos dulces para repartir a\nniños.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0004",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001404",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Los bekkoame solo llevan agua y azúcar, así que rinden muy bien para su\nprecio... Mucho mejor que las galletas y las tortas.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0003",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001405",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si tratara de hacer caramelos de leche tendría que usar nata, y eso saldría\ncaro.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te pidieron que los hicieras? ¿Es para un bazar o algo así?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0029",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001406",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí, algo por el estilo.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"A pesar de solo tener agua y azucar, los bekkoame estaban deliciosos. Me metí\nuno a la boca, y unos cuantos más en mi bolsillo.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="真琴",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0003",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001407",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Con el calor que hace afuera se te van a derretir.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De eso me preocuparé cuando tenga que preocuparme de eso.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="02_abend_11_1"},
{"text"},
linkback="block_00096",
},
label = {
top={block="block_00000",label=1},
},
}
