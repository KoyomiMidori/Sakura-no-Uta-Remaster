astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"msgoff"},
{"bg",file="bluesky_summer",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_aid_001060",ch="aid"},
},
ja={
{
name={"???"},
"“¿Pensando en algo?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg047a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1h0010",face="h0002",head="aix_z1h",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0015",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0005",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001061",ch="aid"},
},
ja={
{
name={"Ai"},
"“Dios, ¿cuántas veces te lo debo repetir? Estando en el colegio soy la profesora\nNatsume.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001062",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me han contado que llegaste tarde hoy.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ¿viniste a amonestarme?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001063",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jamás te buscaría por pequeñeces como esa. Te vi sentado solo en las escaleras\ny decidí acercarme.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2f0000",face="f0002",head="aix_z2f",lv=5,id=9},
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_aid_001064",ch="aid"},
},
ja={
{
name={"Ai"},
"“Uff...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Ai se sienta a mi lado.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las escaleras están sucias.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0001",head="aix_z2f",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001065",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tú también estás sentado sobre ellas...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"select",label="label01",exp="f.aix=f.aix+1",text="select"},
{"select",label="label02",text="select"},
{"select",name="select05_04_1",mode="sys"},
{"text"},
select={
ja={
"Supongo que con lo largo de tu falda tampoco se verán tus pantis.",
"Solo asegúrate de no arrugar mucho la falda.",
{"rt2"},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno. Supongo que con lo largo de tu falda tampoco se verán tus\npantis.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0008",head="aix_z2f",lv=5,id=9},
{"fgact",ch="藍",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001066",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por supuesto que no. ¿Por qué comentar algo tan obvio?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se le ven a las muchachas con falda corta que se sientan acá.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0012",head="aix_z2f",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0001",head="aix_z2f",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001067",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Es así? La próxima vez tendré que venir a advertirles entonces.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"excall",label="join"},
{"text"},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo asegúrate de no arrugar mucho la falda.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0002",head="aix_z2f",lv=5,id=9},
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001068",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, está bien. Sé que siempre la planchas por mí, procuraré cuidarla.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te preocupes. Es mi tarea encargarme de las labores de la casa.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"excall",label="join"},
{"text"},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0011",head="aix_z2f",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001069",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sea lo que sea, como profesora no es muy correcto estar haciendo esto, supongo.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si eso te preocupa, te digo que es difícil que te vean acá. Solo un poco desde\nel edificio de al lado.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Esas escaleras llevan a la azotea, así que casi nadie pasa por aquí.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0002",head="aix_z2f",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001070",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué haces en tan solitario lugar? ¿Pensando a solas?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, en eso estaba...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_aid_001071",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"se",file="se9010",id=1},
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
{"text"},
text={
ja={
{
"Al decir eso, Ai me agarra por la cabeza.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mm?! ¡¿Q-Qué haces?!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0004",head="aix_z2f",lv=5,id=9},
{"fgact",ch="藍",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001072",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ejejeje... Hace tiempo solía hacerte esto, ¿recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Q-Qué cosa? Auch--”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0003",head="aix_z2f",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0002",head="aix_z2f",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001073",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vamos, relájate... Solo déjate caer lentamente...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Caer... lentamente?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fgact",ch="藍",act="うんうん",time=200,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001074",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, deja caer tu peso...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"Justo al decir eso, Ai llevó mi cabeza hacia sus piernas.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"bg",file="ev_com_i04_01",path=":ev/ev_com_i04/",set="ev_com_i04"},
{"bgm",file="bgm023"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001075",ch="aid"},
},
ja={
{
name={"Ai"},
"“Recuéstate sobre mis piernas.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué?!”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"bg",file="ev_com_i04_02",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001076",ch="aid"},
},
ja={
{
name={"Ai"},
"“Si ves esto sabrás porqué.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No puedo ver bien en esta posición!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_aid_001077",ch="aid"},
},
ja={
{
name={"Ai"},
"“Voy a limpiarte las orejas. Solía hacértelo cuando eras pequeño, ¿recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuando estaba muy, muy pequeño, ¿sabes?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_aid_001078",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero la diferencia de edad no ha cambiado.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué no es obvio?! ¡Sería de terror si de repente cambiara!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"bg",file="ev_com_i04_03",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001079",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, está bien, solo quédate tranquilo. Comenzaré a limpiar.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y a todo esto... ¿Por qué repentinamente decidiste limpiar mis orejas?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_aid_001080",ch="aid"},
},
ja={
{
name={"Ai"},
"“Uhm, vi el limpiador en la tienda de cien yenes, me llamó la atención y decidí\ncomprarlo. Está completamente nuevo, así que pensé en estrenarlo limpiando\ntus orejas.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué clase de razón es esa?...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_aid_001081",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vamos, no está mal hacerlo de vez en cuando. Relax, relax.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué puedo hacer?...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"bg",file="ev_com_i04_04",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001082",ch="aid"},
},
ja={
{
name={"Ai"},
"“Hay bastante luz solar por acá, es perfecto para ver bien el interior de tus\norejas.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Está bien que hagas esto? Si alguien ve a un alumno haciendo esto con su\nprofesora, podría malentender las cosas.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="fem_aid_001083",ch="aid"},
},
ja={
{
name={"Ai"},
"“No lo niego. Pero antes de ser profesora y alumno, somos miembros de la familia\nNatsume, ¿no? Tranquilo, no te preocupes tanto por eso.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien que me exiges que te llame profesora en el colegio.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_aid_001084",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por más que lo exija nunca lo haces, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_aid_001085",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Por qué no? Siento que eres algo terco con eso.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea... Siempre has sido Ai para mí, desde hace mucho tiempo...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_aid_001086",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por lo menos procura llamarme profesora Ai.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm... Sí, creo que sería más sencillo llamarte así...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Natsume es el apellido de la abuela, y también el de Kei, así que se me hace\nalgo difícil llamarte así.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_aid_001087",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo, tiene sentido. Pero pase lo que pase debes llamarme 'profesora' en el\ncolegio.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, procuraré hacerlo de ahora en adelante.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"bg",file="ev_com_i04_05",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001088",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jaja...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Ai comienza a limpiar mis orejas en medio de risas.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Siempre me las he limpiado yo mismo, así que se siente algo extraño esto.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"bg",file="ev_com_i04_04",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001089",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kenichiro-san y tú se parecen en ciertos aspectos, pero también difieren en\notros.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_aid_001090",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kenichiro-san no solía preocuparse por las cosas de la misma manera que lo\nhaces tú.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Él era del tipo que actuaba antes de preocuparse y luego terminaba\narrepintiéndose. En ese aspecto somos diferentes.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_aid_001091",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí. Por eso al ver la expresión que tienes recordé a Mizuna-san, a\nMizuna nee-sama.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A mamá...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_aid_001092",ch="aid"},
},
ja={
{
name={"Ai"},
"“A diferencia de Kenichiro, nee-sama se preocupaba con frecuencia por varias\ncosas. Siempre se preocupaba, pensaba, y al final lograba conseguir una\nsolución.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_aid_001093",ch="aid"},
},
ja={
{
name={"Ai"},
"“Como buen hijo de ella te le pareces, no solo en cara, sino también en tus\ngestos.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_aid_001094",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pensar mucho antes de conseguir una respuesta, o actuar de inmediato y esperar\nel resultado. La verdad es que no sé cuál opción es la correcta.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_aid_001095",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero no me molestaba ver a nee-sama pensando tanto.\nEn esos momentos solía molestarla.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_aid_001096",ch="aid"},
},
ja={
{
name={"Ai"},
"“Normalmente un adulto se pondría de mal humor si un niño lo molestara mientras\npiensa en algo importante, pero Mizuna nee-sama nunca llegó a hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"bg",file="ev_com_i04_05",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001097",ch="aid"},
},
ja={
{
name={"Ai"},
"“Al contrario, aun siendo una niña me explicaba de manera sencilla sus\npreocupaciones... Y al contarme ella sus problemas, me sentía a la misma\naltura de un adulto. Me ponía feliz.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mamá hacía eso?... Jamás llegué a vivir algo así con ella.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_aid_001098",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tal vez porque vivíamos en aquella casa es que me trataba como una adulta\nmás...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué clase de cosas hablaba mamá contigo?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_aid_001099",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues llegó a pedirme consejos acerca del mismísimo Kenichiro-san.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Del viejo?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_aid_001100",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, él solía venir frecuentemente a la residencia Natsume. Al parecer nee-sama\nno sabía qué hacer exactamente con él.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"bg",file="ev_com_i04_04",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001101",ch="aid"},
},
ja={
{
name={"Ai"},
"“Su principal preocupación era no involucrarlo en lo nuestro. Aunque creo\nque también había felicidad en ella.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_aid_001102",ch="aid"},
},
ja={
{
name={"Ai"},
"“Viendo a nee-sama así, mi mente de niña me decía 'Nee-sama realmente quiere\nmucho a Kenichiro-san'.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_aid_001103",ch="aid"},
},
ja={
{
name={"Ai"},
"“Si algo te preocupa, contarle a alguien es una buena opción.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"bg",file="ev_com_i04_06",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001104",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tengo muchas más respuestas a problemas ahora en comparación a aquellos\ntiempos.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me estás sugiriendo que te cuente mis problemas?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"bg",file="ev_com_i04_05",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001105",ch="aid"},
},
ja={
{
name={"Ai"},
"“No debo ser yo necesariamente. Solo digo, hay muchas cosas que se resuelven\ncontándole a alguien y no solo pensando por cuenta propia.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Contarle a alguien mis problemas...",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Sí, definitivamente no tengo esa noción en mí...",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai, ¿en qué momento decidiste volverte profesora?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bg",file="ev_com_i04_04",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001106",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Yo? Desde muy pequeña ya había decidido convertirme en profesora.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_aid_001107",ch="aid"},
},
ja={
{
name={"Ai"},
"“Alguien que se hacía llamar profesor solía venir a menudo a la residencia de\nKootoha.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, él...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_aid_001108",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sentía algo de admiración por él, seguramente. El profesor llegó a mostrarme\nmuchas cosas.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_aid_001109",ch="aid"},
},
ja={
{
name={"Ai"},
"“El universo que Kenichiro-san me mostró cambió mi oscura infancia, y la\nconvirtió en algo completamente diferente.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_aid_001110",ch="aid"},
},
ja={
{
name={"Ai"},
"“Quedé asombrada de lo que la pintura podía hacer.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_aid_001111",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y por eso fue que en un principio intenté incesantemente convertirme en\nprofesora de arte.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tú?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_aid_001112",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, pero me di por vencida en poco tiempo. Ajaja, sonará obvio, pero como\nartista... mi talento era inexistente.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_aid_001113",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fue entonces que supe que no son las pinturas lo que logran tanto. Fue el mismo\nKenichiro Kusanagi quien, a través de la pintura, pudo mostrar varios\nuniversos.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_aid_001114",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y de ahí se me ocurrió intentar, de una manera distinta, mostrarle a alguien\nnuevos universos, así como él lo hacía.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_aid_001115",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y así como lo hizo conmigo...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_aid_001116",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bueno, tal vez haya sido algo prepotente compararme con un artista de renombre\ninternacional...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"bg",file="ev_com_i04_06",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001117",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero fue por él que decidí tomar este camino...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"bg",file="ev_com_i04_04",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001118",ch="aid"},
},
ja={
{
name={"Ai"},
"“Al darme cuenta, ya estaba intentando entrar a universidades convenientes para\naspirantes a docencia.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué se te ocurrió convertirte en profesora de lenguaje?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_aid_001119",ch="aid"},
},
ja={
{
name={"Ai"},
"“Simplemente porque se me daba bien la asignatura. Pertenezco por completo a las\nhumanidades. Aunque, fue gracias a la directora que mantuve mi aspiración\ndespués de que Kenichiro falleciera.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La directora?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_aid_001120",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, la directora hizo de todo para ayudarme a entrar a este colegio. Realmente\nle estoy agradecida.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_aid_001121",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fue ella quien me contrató como profesora acá.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La directora? ¿Esa directora hizo de todo para ayudarte?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_aid_001122",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así es. Habrá tenido sus razones, supongo.\nPero de igual manera le estoy agradecida.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bg",file="ev_com_i04_06",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001123",ch="aid"},
},
ja={
{
name={"Ai"},
"“A mi parecer, las personas que el destino nos trae son muy importantes.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_aid_001124",ch="aid"},
},
ja={
{
name={"Ai"},
"“Hay siempre un límite para lo que podemos hacer solos.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_aid_001125",ch="aid"},
},
ja={
{
name={"Ai"},
"“El camino por el cual nos llevan esas personas... Todo es obra del destino,\npienso yo. Sea lo que sea, son esas personas quienes cambian nuestras vidas.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo... Las personas que el destino nos hace encontrar...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bg",file="ev_com_i04_05",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001126",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tal cual, así como nosotros dos nos conocimos también.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente. Si el viejo y mamá no se hubiesen conocido, yo ni siquiera\nexistiría.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_aid_001127",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El destino... Nacer y llegar a este mundo es también un encuentro entre\npersonas. Tiene sentido.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_aid_001128",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por eso debes apoyarte más en los demás, Naoya. No puedes tratar de resolver\ntodo solo.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que realmente tenga la intención de hacerlo todo yo, la verdad...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"bg",file="ev_com_i04_04",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001129",ch="aid"},
},
ja={
{
name={"Ai"},
"“De igual forma te estás presionando mucho.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bg",file="ev_com_i04_06",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001130",ch="aid"},
},
ja={
{
name={"Ai"},
"“Esto pienso yo.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_aid_001131",ch="aid"},
},
ja={
{
name={"Ai"},
"“Él... te está esperando.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_aid_001132",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y así ha sido desde hace bastante tiempo... No es algo reciente.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_aid_001133",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así que, creo yo, tienes la opción de seguir dejándolo esperando.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Hablas... de Kei?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bg",file="ev_com_i04_04",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001134",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_aid_001135",ch="aid"},
},
ja={
{
name={"Ai"},
"“La forma de ser de Kei es algo peligrosa.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_aid_001136",ch="aid"},
},
ja={
{
name={"Ai"},
"“Es centrado, pero imprudente... Pierde toda noción de sus alrededores.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_aid_001137",ch="aid"},
},
ja={
{
name={"Ai"},
"“Justamente así está ahora, ¿lo has visto?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, exactamente así.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_aid_001138",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ha estado durmiendo tan poco que hace unos dos meses desconecté la bujía de su\nmotocicleta.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_aid_001139",ch="aid"},
},
ja={
{
name={"Ai"},
"“No paré de advertirle, '¡No montes la motocicleta sin haber dormido nada!',\npero nunca llegó a prestarme atención.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Era de esperarse de Ai. Ya le había advertido a Kei previamente al respecto.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_aid_001140",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero aun así, siempre consigue un repuesto y vuelve a montarla. Es el peligro\nmismo hecho persona.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_aid_001141",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya me pediste una vez que no dejara a Kei ir al colegio, pero yo sabía que\nprobablemente esa sería la única opción a mi alcance.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_aid_001142",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así es Kei... Aunque sé que tú también eres un hueso duro de roer, no en vano\nlo has puesto así.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_aid_001143",ch="aid"},
},
ja={
{
name={"Ai"},
"“El nivel que ambos tienen como pintores es algo que mi cabeza jamás podría\nllegar a comprender.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez Kei sí, pero no en mi caso.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_aid_001144",ch="aid"},
},
ja={
{
name={"Ai"},
"“Todo el empeño que Kei ha puesto lo dice todo, tú también estás en ese nivel.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_aid_001145",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y eso me da algo de miedo...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Miedo?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_aid_001146",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me pongo a pensar en qué pasaría con los dos si decidieras correr esa\ncarrera...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No le pasará nada a Kei. Está encerrado en mi casa, y dudo que termine muriendo\nde fatiga.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_aid_001147",ch="aid"},
},
ja={
{
name={"Ai"},
"“No hablo de eso.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_aid_001148",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me da miedo que los dos decidan correr tan rápido que nadie los pueda\nalcanzar...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_aid_001149",ch="aid"},
},
ja={
{
name={"Ai"},
"“Si ambos desearan eso, no me importaría tanto, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_aid_001150",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero cuando te veo con esa cara de preocupación...Me dan ganas de decirte que\nlos Natsume no somos tan insensibles.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_aid_001151",ch="aid"},
},
ja={
{
name={"Ai"},
"“Que Kei te espera con paciencia. Que no necesitas apresurarte tanto.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo... Sí, eso lo sé.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"excall",label="flagon",cond="f.aix==1"},
{"excall",label="flagoff",cond="f.aix==0"},
{"bgm",stop=1,time=300},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001153",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah--”",
{"rt2"},
},
},
},
labelcount=3,
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm? ¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"se",id=1,file="se3130"},
{"bg",time=300,sync=0,file="black",path=":bg/"},
{"quake",mode="mw"},
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Wah--?!”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
"¡¿Q-Qué está pasando?!",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"D-De repente todo se oscureció.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_jka_000055",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Ah, profesora Ai, holita~”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001154",ch="aid"},
},
ja={
{
name={"Ai"},
"“A-Ah, h-holita~”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"¿De quién es esa voz?\nSuena a una colegiala, pero se escucha algo lejana.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"A juzgar por la fuerza de su voz, parece que encontró a Ai desde el pasillo del\nedificio contiguo. ¿Será eso?",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_jka_000056",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¿Podría ayudarme con mis estudios después de clases?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001155",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, sí, n-no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_jka_000057",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¡Bien, pues iré entonces a la sala de profesores después de clases!”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"mwact",act="うなづく",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001156",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡B-Bueno!”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"se",file="se9012",id=1},
{"text"},
text={
ja={
{
"El sonido de los pasos de, lo que creo era una alumna, se va desvaneciendo.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"se",stop=1,time=500,id=1},
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡AAAhhh!!”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Alzo mi cabeza.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Recupere la vista, pero...",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"El lugar de donde salí era...",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"bg",file="zev_com_i04_07",zoom=160,x=-470,y=-1180,sync=1,path=":ev/ev_com_i04/",set="ev_com_i04",ax=1920,ay=1080,bx=-960,by=-540},
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",id=1,file="se2362"},
{"ex",time=200,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"bg",file="zev_com_i04_07",zoom=50,x=0,y=0,speed=200,time=0,z2="160,50,60",path=":ev/ev_com_i04/",set="ev_com_i04",x2="-470,0,0",y2="-1180,0,0",ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se3130",id=2},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿T-Tu falda?!”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"bg",file="ev_com_i04_08",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001157",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, lo siento... no pude evitarlo...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Escucha... Ai.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_aid_001158",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Por qué será? Yo misma dije que no habría problema, pero cuando sentí a esa\nalumna venir no dude ni un segundo en ocultarte con mi falda...”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, ese no es el problema ahora...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Al bajar la vista, mis ojos dieron con la blanca ropa interior de Ai.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Con esa falda tan larga, jamás creí que podría ver sus pantis...",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_aid_001159",ch="aid"},
},
ja={
{
name={"Ai"},
"“P-Perdona, que te haya ocultado en semejante lugar... Seguramente fue una\nexperiencia desagradable.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, para nada. Solo que...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, Ai. Así como te lo dije ayer... y solo por si lo has olvidado lo\nvuelvo a decir. Eres también una mujer.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_aid_001160",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, lo sé. Así que, de ser posible, ¿podrías moverte de esta posición tan\nincómoda?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_aid_001161",ch="aid"},
},
ja={
{
name={"Ai"},
"“M-Mis calzones están, completamente expuestos en este momento...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú misma causaste esto...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Intento salir de la falda.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Pero entonces...",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"se",id=1,file="se3130"},
{"bg",file="ev_com_i04_10",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿--?!”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_jka_000058",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Por cierto, profesora, olvidé comentarle acerca del modelo de prueba de hace\nunos días.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001162",ch="aid"},
},
ja={
{
name={"Ai"},
"“A-Ah, sí, ¿c-cómo estuvo?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_jka_000059",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Obtuve una A para mi primera opción, la Universidad Pública de Educación de\nYumihari.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"mwact",act="うなづく",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001163",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Eso es genial.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_jka_000060",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“Sí, y todo gracias a usted que me ayudó con la escritura china que tan mal se\nme daba.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_aid_001164",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me alegro. Sí, las puntuaciones requeridas en lenguaje allí son relativamente\naltas.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_jka_000061",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¡Sí, y por eso quiero darle las gracias!”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001165",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, no hay de qué.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_jka_000062",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“¡Bueno, nos vemos en un ratito!”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"mwact",act="うなづく",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001166",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Está bien...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"bg",file="ev_com_i04_07",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"se",file="se3130",id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pwaaah!”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_aid_001167",ch="aid"},
},
ja={
{
name={"Ai"},
"“N-Naoya... esto...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Señorita...De seguir en lo mismo me quedaré a vivir acá.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001168",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Vivir?... ¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No acepto quejas de una profesora capaz de meter a estudiantes dentro de su\nfalda!”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"bg",file="ev_com_i04_08",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001169",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Estoy consciente de lo que hice, pero...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, aunque no niego que tuve suerte...\nAhora la proporción que ocupas como mujer en mi mente ha aumentado.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_aid_001170",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿La proporción que ocupo como mujer en tu mente? ¿Qué es eso?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Déjame aclarar bien esto. He hecho mi mayor esfuerzo para no verte ni a ti ni a\nShizuku como miembros del sexo opuesto, en consideración de que vivimos\njuntos ahora.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_aid_001171",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero antes éramos como hermanos, ¿no?\nLlegamos incluso a entrar juntos a la tina, ¿no recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿De cuántos años atrás estamos hablando?!”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_aid_001172",ch="aid"},
},
ja={
{
name={"Ai"},
"“Estaré bien, Naoya. No te preocupes.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"bg",file="ev_com_i04_08",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001173",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sé que puedo repelerte si llegaras a intentar hacerme algo.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acaso pudiste repelerme ayer?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"bg",file="ev_com_i04_07",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"mwact",act="びっくり",size=5},
{"text"},
delay={
vl01={
{"bg",file="ev_com_i04_08",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
},
},
text={
vo={
{"vo",file="fem_aid_001174",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, es que, cuando se trata de besos, y eso... Es algo romántico, y bueno, me\ndejé llevar.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota, acabas de decirme que éramos como hermanos.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_aid_001175",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ni tú ni nadie más ha intentado acercarse a mí antes, mi popularidad con el\nsexo opuesto es cero. Por eso soy algo débil ante esos gestos.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tu popularidad es cero? No puede ser... Alguna vez se te han confesado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_aid_001176",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jamás.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jamás?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_aid_001177",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así es. Nunca.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="fem_aid_001178",ch="aid"},
},
ja={
{
name={"Ai"},
"“Eso quisiera saber yo... Oye, ¿podrías salir ya de mi falda?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Viviré acá hasta que suene la campana.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_aid_001179",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Eso de vivir... Sí, sé que la culpa de esto la tengo yo, pero...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_aid_001180",ch="aid"},
},
ja={
{
name={"Ai"},
"“No creo que haya nada interesante debajo de mi falda.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai, ¿qué es una confesión para ti?”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="fem_aid_001181",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eh? Que la persona que te gusta, te diga que también gusta de ti... ¿no?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es decir, que la persona que te gusta te diga que siente algo por ti, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="fem_aid_001182",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, así es. ¿No habías dicho tú también que era así?”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"mwact",act="うんうん",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ahí está! ¡Eso es! ¡La mala influencia de la abuela Natsume! ¡Escucha, las\nconfesiones por parte de personas que no te gustan también cuentan!”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"bg",file="ev_com_i04_09",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001183",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eh? ¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A esa señora le encantaba decir que los Kusanagi son fieles a una sola persona,\ny le ha lavado el cerebro a toda la familia con eso... Cielos...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"bg",file="ev_com_i04_08",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001184",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Entonces también cuenta cuando cualquier otra persona dice que le gustas?”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Exactamente.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="fem_aid_001185",ch="aid"},
},
ja={
{
name={"Ai"},
"“Si es así, entonces hay algo raro.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="fem_aid_001186",ch="aid"},
},
ja={
{
name={"Ai"},
"“De ser así, un tercio de las personas que me han dicho eso son mujeres...”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... a veces pasa...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"Esa maestría que tiene con las artes marciales la debe haber hecho popular con\nlas chicas también...",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Déjame decirte que estás muy equivocada, y te explico el porqué.\nEres hermosa, popular entre hombres y mujeres, e incluso yo te veo como\ntoda una mujer.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
vo={
{"vo",file="fem_aid_001187",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vamos, no vengas con eso.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los Natsume suelen tener caras hermosas. Las tres preciosas hermanas Natsume,\nasí le llaman a ustedes dos y a Kei, ¿recuerdas que te lo dije?”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="fem_aid_001188",ch="aid"},
},
ja={
{
name={"Ai"},
"“Son solo piropos sin sentido.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si sigues diciendo esas tonterías, me quedaré a vivir de verdad dentro de esta\nfalda.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001189",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿P-Por qué?!”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
vo={
{"vo",file="fem_aid_001190",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Escucha... Sé que tuve la culpa de esto, pero... no es buena idea seguir...”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuiste tú la que hizo dos veces lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
vo={
{"vo",file="fem_aid_001191",ch="aid"},
},
ja={
{
name={"Ai"},
"“L-Lo sé... pero, créeme que yo también me muero de la vergüenza...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"bg",file="ev_com_i04_08",sync=0,face=1,time=400,path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
ja={
{
"Ai se sonroja y aparta su vista.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"Conozco a Ai desde pequeño.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"Y por eso mismo sé que como mujer es una preciosura.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ush...”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"se",file="se9010",id=1},
{"bg",file="ev_com_i04_11",path=":ev/ev_com_i04/",set="ev_com_i04"},
{"text"},
text={
ja={
{
"Me levanto y vuelvo a mi posición original.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
vo={
{"vo",file="fem_aid_001192",ch="aid"},
},
ja={
{
name={"Ai"},
"“Q-Qué alivio... De verdad creí que te quedarías todo el rato adentro.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. Solo fue una pequeña broma...”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y sé que ya te lo he dicho varias veces, pero no lo olvides.\nEres hermosa, Ai, y es muy fácil que te vea como una mujer.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="fem_aid_001193",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que procura cuidarte de que no sea así.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="fem_aid_001194",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no sé cuándo podría perder el control.”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
vo={
{"vo",file="fem_aid_001195",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué podría pasar si pierdes el control?”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Intentaría tomarte por la fuerza.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="fem_aid_001196",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me aseguraré de ahuyentarte en ese caso.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hazlo, por favor. Así me escuches diciendo locuras.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="fem_aid_001197",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Locuras?”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, palabras... en el furor del momento, como que me gustas, o cualquier otra\ncosa...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
vo={
{"vo",file="fem_aid_001198",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eres capaz de decir algo tan importante como si fuese cualquier cosa, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por eso te estoy diciendo que pongas resistencia en ese momento! ¡Si llegara a\ndecirlo probablemente sea en un ataque de locura!”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
vo={
{"vo",file="fem_aid_001199",ch="aid"},
},
ja={
{
name={"Ai"},
"“Locuras, ya veo... Está bien, lo tomaré en cuenta.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
vo={
{"vo",file="fem_aid_001200",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aunque, si llegara a suceder, sería mi primera confesión...”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
vo={
{"vo",file="fem_aid_001201",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, no, no es nada. Ajajaja...”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
