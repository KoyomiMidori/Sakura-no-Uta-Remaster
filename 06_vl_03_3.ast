astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"bg",rule=139,vague=40,file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues bueno, las dejo. Debo limpiar todo.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="奈津子",size="z1",mode=3,resize=1,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x=-680,lv=4,id=1},
{"fg",ch="桜子",size="z1",mode=3,resize=1,path=":fg/sku/z1/",file="sku_z1a0200",face="a0008",head="sku_z1a",x=-210,lv=4,id=7},
{"fg",ch="ルリヲ",size="z1",mode=3,resize=1,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=210,lv=4,id=8},
{"fg",ch="鈴菜",size="z1",mode=3,resize=1,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=680,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_skr_000245",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Disculpe que le demos tanto trabajo...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que te disculpes. Además, fui yo quien propuso hacer esto.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x=-210,lv=4,id=7},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0015",head="rur_z1c",x=210,lv=4,id=8},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rld_000133",ch="rld"},
},
ja={
{
name={"Rurio"},
"“No te preocupes por eso. Kusanagi-chan parece haberse divertido, además.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, sí... Me divertí más de lo que esperaba.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",x=210,lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rld_000134",ch="rld"},
},
ja={
{
name={"Rurio"},
"“Vaya, qué honesto.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ser adulto implica no fingir lo que no se es.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0018",head="suz_z1c",x=680,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000091",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Pues me parece que fingió bastante con lo del tema de su virginidad.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Es que se trata de un problema que te afecta mientras más envejeces...\n¡Espera, ya no más con eso! ¡Para ya!”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fgact",ch="鈴菜",act="うんうん",time=200,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000092",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Sí, sí.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=210,lv=4,id=8},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=680,lv=4,id=2},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",x=-680,lv=4,id=1},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000062",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Muchas gracias por ayudarnos tanto hoy.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay de qué.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_snd_000093",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Debo admitir que me divertí bastante. Ahora debo asegurarme de agradecerle de\notra manera.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0001",head="rur_z1c",x=210,lv=4,id=8},
{"fgact",ch="ルリヲ",act="ジャンプ",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rld_000135",ch="rld"},
},
ja={
{
name={"Rurio"},
"“Así es, así es. ¿Qué piensas hacer? Rurio hará lo que sea.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No salgan con esas tonterías. Ustedes formarán parte del colegio a partir del\npróximo año. Yo solo hice lo que un profesor debe hacer.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x=-210,lv=4,id=7},
{"text"},
text={
vo={
{"vo",file="fem_skr_000246",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Aun así...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",x=-680,lv=4,id=1},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=1},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0003",head="sku_z1a",x=-210,lv=4,id=7},
{"fgact",ch="桜子",act="うなづく",lv=4,id=7},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=210,lv=4,id=8},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=8},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0003",head="suz_z1c",x=680,lv=4,id=2},
{"fgact",ch="鈴菜",act="うなづく",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_skr_000247",ch="skr"},
{"vo",file="fem_rld_000136",ch="rld"},
{"vo",file="fem_ntd_000063",ch="ntd"},
{"vo",file="fem_snd_000094",ch="snd"},
},
ja={
{
name={"Todas"},
"“¡Muchas gracias por todo!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Todas bajan la cabeza al mismo tiempo, en agradecimiento.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Lo único que pude hacer fue rascarme la cabeza de la pena.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"msgoff"},
{"bg",file="eveningsky_spring01",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Llevaba bastante tiempo sin quedarme en el colegio después de clases.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"¿La última vez no fue cuando todavía estudiaba acá?",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Salgo de la sala de arte y cierro la puerta con llave.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"se",file="se1279",vol=70,id=1},
{"bg",file="bg046b",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
vo={
{"vo",file="fem_nei_000073",ch="nei"},
},
ja={
{
name={"???"},
"“Esto... Usted, es el profesor Kusanagi... ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Justo al pasar la llave alguien me llama, y volteo.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="寧",size="z1",mode=3,resize=1,path=":fg/nei/z1/",file="nei_z1a0200",face="a0001",head="nei_z1a",lv=4,id=9},
{"bgm",file="bgm029"},
{"text"},
text={
vo={
{"vo",file="fem_nei_000074",ch="nei"},
},
ja={
{
name={"???"},
"“Escuché que este colegio no tiene club de arte...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es, no hay club de arte, aunque... ehm...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fgact",ch="寧",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000075",ch="nei"},
},
ja={
{
name={"???"},
"“Me llamo Onda. Nei Onda, de primer año.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo... Onda... Onda, eh...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Onda... Onda... Eh... ¿Quién era ella?",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fgact",ch="寧",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000076",ch="nei"},
},
ja={
{
name={"Nei"},
"“Sí, Onda. Por cierto, profesor, ¿se va a crear un club de arte acá?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, por ahora eso está algo difícil...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0007",head="nei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000077",ch="nei"},
},
ja={
{
name={"Nei"},
"“¿No eran actividades de club lo que estaban haciendo adentro?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no eran actividades de club... Digamos que, estaba dándoles unas\npequeñas lecciones de pintura.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_nei_000078",ch="nei"},
},
ja={
{
name={"Nei"},
"“¿Usted estaba dando clases?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, algo así...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0002",head="nei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0003",head="nei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_nei_000079",ch="nei"},
},
ja={
{
name={"Nei"},
"“Hace un rato pasé frente a la sala de arte, y me llamó la atención las risas\nque se escuchaban adentro... Todos parecían estar divirtiéndose bastante...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0002",head="nei_z1a",lv=4,id=9},
{"fgact",ch="寧",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000080",ch="nei"},
},
ja={
{
name={"Nei"},
"“Si por alguna razón se vuelve a crear un club de arte en el colegio, quisiera\naplicar a él.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0001",head="nei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000081",ch="nei"},
},
ja={
{
name={"Nei"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Aunque no es muy probable que se logre.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0008",head="nei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000082",ch="nei"},
},
ja={
{
name={"Nei"},
"“¿De verdad?...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Esa cara...",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Siento que la he visto en algún otro lado...",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"O más bien... Se me parece a alguien...",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0001",head="nei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000083",ch="nei"},
},
ja={
{
name={"Nei"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no... lo siento. Solo que... te me pareciste a alguien.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0010",head="nei_z1a",lv=4,id=9},
{"fgact",ch="寧",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000084",ch="nei"},
},
ja={
{
name={"Nei"},
"“¿Parecerme... a alguien?...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0001",head="nei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000085",ch="nei"},
},
ja={
{
name={"Nei"},
"“Sí, tal vez.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"La muchacha que tenía enfrente tenía una cara algo fría, y no muy expresiva.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_nei_000086",ch="nei"},
},
ja={
{
name={"Nei"},
"“Por cierto, profesor Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿S-Sí?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_nei_000087",ch="nei"},
},
ja={
{
name={"Nei"},
"“¿No se puso usted algo nervioso al ver mi cara?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... Es que me cogiste de sorpresa cuando me llamaste.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0008",head="nei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000088",ch="nei"},
},
ja={
{
name={"Nei"},
"“Puso la misma cara que alguien pondría al ver un fantasma.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0010",head="nei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000089",ch="nei"},
},
ja={
{
name={"Nei"},
"“... Solo bromeaba.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0002",head="nei_z1a",lv=4,id=9},
{"fgact",ch="寧",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000090",ch="nei"},
},
ja={
{
name={"Nei"},
"“Espero con ansias el restablecimiento del club de arte.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, como te dije, no se va a restablecer realmente--”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0003",head="nei_z1a",lv=4,id=9},
{"fgact",ch="寧",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0002",head="nei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_nei_000091",ch="nei"},
},
ja={
{
name={"Nei"},
"“Sí, le he entendido. Aunque, espero con ansias su restablecimiento.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... B-Bueno...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1a0200",face="a0001",head="nei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_nei_000092",ch="nei"},
},
ja={
{
name={"Nei"},
"“Me retiraré. Buenas tardes.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Onda hace una reverencia.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"msgoff"},
{"fg",ch="寧",size="z1",mode=3,path=":fg/nei/z1/",file="nei_z1b0200",face="b0001",head="nei_z1b",lv=4,id=9},
{"fgact",ch="寧",act="おじぎ",lv=4,id=9},
{"ex",time=1500,func="wait"},
{"se",file="se9012",id=1},
{"fg",ch="寧",sync=1,mx=-40,mode=-1,lv=4,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"¿Por qué será?...",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Se me parece a alguien... Pero no logro dar con esa persona...",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"O será que... su manera de actuar es tan distinta ahora...",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueh, suele pasar...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Como profesor debo ver las caras de cientos y cientos de estudiantes.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Así que... supongo, que de vez en cuando ocurrirán cosas como estas...",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"ex",time=500,func="wait"},
{"msgoff"},
{"bg",file="eveningsky_spring01",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000742",ch="knd"},
},
ja={
{
name={"???"},
"“Vaya, tiempo sin verte, Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh... tú eres...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Alguien me saluda mientras bajaba por la colina de Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Su cara se me hacía conocida.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"cgdel",id=-1},
{"bg",file="ev_com_j04_01",path=":ev/ev_com_j04/",set="ev_com_j04"},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000743",ch="knd"},
},
ja={
{
name={"Kana"},
"“Te has vuelto todo un profesor, sí. Mira cómo te quieren tus alumnas... Fufufu.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kana Nagayama.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_knd_000744",ch="knd"},
},
ja={
{
name={"Kana"},
"“Vaya, qué alegría. Esta vez si me recordaste.Juraba que no recordarías ni mi\nnombre.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tanto tiempo que pasamos juntos, ¿cómo podría olvidarte?... Más bien sería para\npreocuparme si se me olvidara.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, parece que has encendido los medios impresos de arte, eh. Suelo ver tu\nnombre con frecuencia.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_knd_000745",ch="knd"},
},
ja={
{
name={"Kana"},
"“Así que lees esa clase de revistas.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Será solo de tiempo parcial, pero sigo siendo profesor de arte. No me viene mal\nenterarme de las últimas tendencias artísticas.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Grupo de arte Bourbagi es que se llamaba? Veo que han recibido numerosas\ncríticas y quejas por sus extravagantes presentaciones.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_knd_000746",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Y? El arte siempre será y debe ser sensacional. Arte sin peligro no es más que\nun cadáver.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Arte sensacional... Ya veo. Pues, veo que hacen lo que predican.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_knd_000747",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Acaso tu padre no hizo lo mismo para darse a descubrir? Siempre él tan\nsensacional. ¿No fue acaso el blanco de críticas y quejas?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez. No sé en realidad qué pasó, eso sí.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, ¿qué haces en Yumihari? De lo que recuerdo, tú no te graduaste acá,\n¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_knd_000748",ch="knd"},
},
ja={
{
name={"Kana"},
"“Así es. Aunque entre nuestros miembros, hay un egresado de tu club de arte.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé. Thomas Takizawa. Desde joven le ha gustado hacer locuras. Supongo\nque se ha adherido muy bien a tu grupo.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_knd_000749",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, ha cumplido muy bien su papel. Sus actos insólitos nos han ayudado\nbastante.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Marketing viral lo de ustedes, definitivamente.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_knd_000750",ch="knd"},
},
ja={
{
name={"Kana"},
"“Eso es un halago para nosotros.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Ese ideal de tu grupo no coincide en absoluto con el mío, sin duda\nalguna.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"bg",file="ev_com_j04_05",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000751",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pues sí. Y tampoco con el de ella.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Con el de ella?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"bg",file="ev_com_j04_02",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000752",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Has hablado con ella después de lo que sucedió?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De quién hablas?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_knd_000753",ch="knd"},
},
ja={
{
name={"Kana"},
"“Rin Misakura. La genio artística.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué podrían tener en común una genio del arte y un profesor a tiempo parcial\nde Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_knd_000754",ch="knd"},
},
ja={
{
name={"Kana"},
"“Tan bien que se llevaban hace tiempo.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hace tiempo, tú misma lo has dicho. Nadie permanece igual. No podemos seguir\nsiendo los mismos niños de siempre.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_knd_000755",ch="knd"},
},
ja={
{
name={"Kana"},
"“Has dado en el clavo.\nA medida que los años nos pasan encima nuestras posiciones cambian.\nY nuestros entornos también.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_knd_000756",ch="knd"},
},
ja={
{
name={"Kana"},
"“Nunca faltan los idiotas que no se dan cuenta de eso, e intentan hablarte como\nsi nada con la excusa de ser viejos conocidos. Obviamente, la conversación no\nfluye.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_knd_000757",ch="knd"},
},
ja={
{
name={"Kana"},
"“Una artista de renombre internacional, y un simple profesor de arte de la\nprovincia...Entre Misakura-san y Kusanagi-kun ya no hay ningún punto en\ncomún, obviamente...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal cual.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"bg",file="ev_com_j04_04",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000758",ch="knd"},
},
ja={
{
name={"Kana"},
"“En mi caso es diferente.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_knd_000759",ch="knd"},
},
ja={
{
name={"Kana"},
"“Puedes estar seguro de que algún día superaremos a Rin Misakura.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Superar a Rin Misakura, eh...\n¿Todavía sigues con eso?...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_knd_000760",ch="knd"},
},
ja={
{
name={"Kana"},
"“Por supuesto. Para eso nos hemos venido esforzando hasta ahora.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues ese esfuerzo de ustedes pareciera ser solo una provocación a la sociedad.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_knd_000761",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Y en qué difiere eso con Kenichiro Kusanagi? ¿O con Rin Misakura?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_knd_000762",ch="knd"},
},
ja={
{
name={"Kana"},
"“Rin Misakura solo resultó ser joven y hermosa. De ahí que ganó fama y por\ncierta equivocación también aquel premio.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por equivocación? ¿Me estás tomando el pelo?... Eso no fue ninguna\nequivocación.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"bg",file="ev_com_j04_03",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000763",ch="knd"},
},
ja={
{
name={"Kana"},
"“Lo sé.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"bg",file="ev_com_j04_04",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000764",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero ¿qué pensarán los idiotas?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_knd_000765",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Sabes algo? Las masas no conocen el valor de los genios. Ellos solo se dejan\nllevar por lo que piensan los demás, y terminan fijando su opinión basándose\nen los otros.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_knd_000766",ch="knd"},
},
ja={
{
name={"Kana"},
"“Solo el talentoso conoce el valor del genio.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"bg",file="ev_com_j04_05",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000767",ch="knd"},
},
ja={
{
name={"Kana"},
"“Solo personas como yo, sin suficiente talento para ser genio pero más que el\nmediocre, podemos entender eso.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hace un buen tiempo te denominabas a ti misma como mediocre. ¿Es que eso cambió\nahora?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_knd_000768",ch="knd"},
},
ja={
{
name={"Kana"},
"“He invertido una gran cantidad de esfuerzo al respecto. Así que ahora soy del\ngrupo de los talentosos.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tanta fijación por Rin Misakura entonces?\n¿Acaso te gusta?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"bg",file="ev_com_j04_04",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000769",ch="knd"},
},
ja={
{
name={"Kana"},
"“Me gusta. Pero mi odio por ella es más grande aun.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_knd_000770",ch="knd"},
},
ja={
{
name={"Kana"},
"“Los talentosos aman y odian al genio por igual.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Pues esa relación de odio y amor se parece a la de Mozart y Antonio\nSalieri en 'Amadeus'.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bg",file="ev_com_j04_01",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000771",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, yo también vi esa película cuando era niña. La historia del genio Mozart y\nel talentoso Salieri.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bg",file="ev_com_j04_04",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000772",ch="knd"},
},
ja={
{
name={"Kana"},
"“Las masas apreciaban el valioso talento musical de Mozart, mientras que los\notros compositores hablaban mal de su personalidad libre, vulgar y descortés.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_knd_000773",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero así como solo Salieri entendió que el talento de Mozart era la más grande\nde las bendiciones de Dios, entendió también que su talento alcanzaba\núnicamente para entender la genialidad de Mozart.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_knd_000774",ch="knd"},
},
ja={
{
name={"Kana"},
"“Fue de ahí que el sufrimiento de Salieri por sus enormes celos por Mozart\nprovocaron una tragedia.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_knd_000775",ch="knd"},
},
ja={
{
name={"Kana"},
"“El genio y el talentoso. Esa es la relación más difícil de superar, y la más\nllena de amor y odio a la vez.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vas a terminar provocando tu propia tragedia también.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_knd_000776",ch="knd"},
},
ja={
{
name={"Kana"},
"“No. La historia no es solo de los genios.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_knd_000777",ch="knd"},
},
ja={
{
name={"Kana"},
"“A veces el talentoso logra superar al genio.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_knd_000778",ch="knd"},
},
ja={
{
name={"Kana"},
"“No solo eso. Los genios no solo son blanco de nuestro miedo. Se podría decir\nque son simples talentosos que han logrado dominar la tendencia actual.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_knd_000779",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y yo llegaré a donde ella está, sea como sea.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Vaya, me asombras.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque te ha estado ignorando, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bg",file="ev_com_j04_05",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000780",ch="knd"},
},
ja={
{
name={"Kana"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mencionaste hace rato que tu ideal no coincide con el de 'ella'. Te referías a\nRin Misakura, ¿cierto? Seguramente has intentado acercarte a ella, y sin\nembargo te ha venido ignorando.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿O acaso me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"bg",file="ev_com_j04_03",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000781",ch="knd"},
},
ja={
{
name={"Kana"},
"“No lo niego...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"bg",file="ev_com_j04_04",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000782",ch="knd"},
},
ja={
{
name={"Kana"},
"“Aunque la historia del arte no es solo de los genios.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_knd_000783",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y me estaré repitiendo, pero no son solo los genios los que escriben la\nhistoria.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"bg",file="ev_com_j04_01",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000784",ch="knd"},
},
ja={
{
name={"Kana"},
"“En los próximos días superaremos a Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Superar a Kenichiro Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_knd_000785",ch="knd"},
},
ja={
{
name={"Kana"},
"“Así es. Los medios se conmocionarán.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué quieres decir con...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_knd_000786",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Quién sabe? Aunque creo que hablar de esto contigo es absurdo.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Absurdo?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_knd_000787",ch="knd"},
},
ja={
{
name={"Kana"},
"“Quizá solo quería confirmarlo todo yo misma.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"bg",file="ev_com_j04_05",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000788",ch="knd"},
},
ja={
{
name={"Kana"},
"“Parezco idiota. ¿Fantasma?\nSí, creo que eras como un fantasma para mí.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_knd_000789",ch="knd"},
},
ja={
{
name={"Kana"},
"“Aunque vi que ese fantasma ya no es ni la sombra de lo que era. El conflicto\ndentro de mí se ha resuelto.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"bg",file="ev_com_j04_04",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000790",ch="knd"},
},
ja={
{
name={"Kana"},
"“No vale la pena intentar buscar pelea con alguien como tú.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_knd_000791",ch="knd"},
},
ja={
{
name={"Kana"},
"“Eres solo un fantasma del pasado para mí.\nPolvo en el aire.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Polvo... Vaya palabras que te gastas, teniéndome enfrente.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_knd_000792",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Enfrente? ¿Y qué?\nMe basta con caminar por la ciudad para encontrarme con miles\nde don nadies.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_knd_000793",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Qué diferencia puede haber entre el polvo y esa multitud con la que solo te\ncruzas una vez?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_knd_000794",ch="knd"},
},
ja={
{
name={"Kana"},
"“La gran mayoría de las personas son como el polvo. Son escasas las personas y\nlas cosas esenciales, y por eso yo solo confío en lo esencial.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Así que para ti yo soy polvo...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Nagayama sigue hablando, como si no escuchase ni una sola de mis palabras.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bg",file="ev_com_j04_06",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000795",ch="knd"},
},
ja={
{
name={"Kana"},
"“Superaré a Kenichiro Kusanagi y escalaré a donde Rin Misakura se encuentra.\nEso es todo.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_knd_000796",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, así es. Ya aclaré mi mente.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bg",file="ev_com_j04_01",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000797",ch="knd"},
},
ja={
{
name={"Kana"},
"“Adiós, Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_knd_000798",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Sabes algo? Me gustabas mucho. Me encantabas.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_knd_000799",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero parece que todo fue un enorme malentendido.\nY de cierta forma, eso me tranquilizó.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bg",file="ev_com_j04_06",sync=0,face=1,time=400,path=":ev/ev_com_j04/",set="ev_com_j04"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000800",ch="knd"},
},
ja={
{
name={"Kana"},
"“Iré adelante, mucho más allá.\nA un lugar que gente como ustedes, siempre contentos con el entorno que los ha aceptado, jamás podrían alcanzar.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_knd_000801",ch="knd"},
},
ja={
{
name={"Kana"},
"“Allí llegaré yo.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Nagayama se va caminando.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Ya no tenía ojos para mí.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"msgoff"},
{"bg",file="zeveningsky_spring01",speed=240000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=0,x=0,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"En ese instante recordé unas palabras.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Solo donde el genio es fino, puede verse el talento. Genio es lo que nos hace\nolvidar el talento.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El genio y el talentoso, eh...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"El grupo de arte Bourbagi.\nSi bien no me agradan para nada, debo admitir que la obsesión de Nagayama por la belleza artística supera a la de los talentosos.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"De cierta forma, esa obsesión era casi como la de un genio...",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Hay diferencias de talento que simplemente no pueden ser superadas.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Rin Misakura es la genio que hasta el propio Kenichiro Kusanagi llegó a temer.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Qué estará pensando hacer?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"El arte de ese grupo se basa, por lo general, en provocar a la sociedad y el\norden.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Debe estar planeando algo grande para alcanzar a Rin Misakura.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Aunque.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Un simple profesor de tiempo parcial como yo no tiene mucho que ver en tal\nmeollo...",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues bueno, creo que iré por mi Happoushu diario. Y luego, de vuelta a casa...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Caminé de vuelta a casa.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"cgdel",id=-1},
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="06_vl_04_1"},
{"text"},
linkback="block_00185",
},
label = {
top={block="block_00000",label=1},
},
}
