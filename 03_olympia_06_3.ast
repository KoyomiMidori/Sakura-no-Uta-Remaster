},
block_00428={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003010",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, jaa... haaa... sí, está bien... Eyacula bastante sobre mis pechos, por,\nfavor... *yiururu*... n-npoh, npoh, *rerorero*... n, nngh, Jaa...”",
{"rt2"},
},
},
},
linkback="block_00427",
linknext="block_00429",
},
block_00429={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ah, aaah... no puedo, más, de verdad, creo, que m-me voy...”",
{"rt2"},
