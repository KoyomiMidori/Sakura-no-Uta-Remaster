astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bgm",file="bgm002"},
{"msgoff"},
{"bg",file="eveningsky_spring01",id=8,lv=8,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"bg",file="nightsky_summer",id=9,lv=9,sync=1,path=":cg/"},
{"ex",time=1000,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063c",path=":bg/",sync=0},
{"extrans",time=1000},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002849",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ese día, fui transferida en contra de mi voluntad a un colegio que quedaba en\nla zona donde vivía la familia de mi padre.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0005",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002850",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No pude perdonarlo... No pude perdonar a mi padre por haberme separado de mi\nmadre...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sigues sintiendo lo mismo que en ese entonces?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0005",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002851",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, las cosas son distintas ahora... Lo que siento por papá no ha cambiado aún,\npero... pero, ahora tengo otros sentimientos distintos a esa época dentro de\nmí...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002852",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué... no me habrá dicho nada?...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002853",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si tuvo una razón para hacerlo, quiero que me lo diga. No, aun si no tiene\nalguna razón no importa, incluso una excusa me serviría. No me importaría\nincluso que me viera a la cara y me dijera pedantemente '¿y qué pasa?'...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002854",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero, papá no dice ni siquiera eso. No trata de decírmelo...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002855",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Simplemente se queda impasible, odiado por mí... Callado, sin dar ninguna\nrazón...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí...",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, yo estoy haciendo lo mismo ahora.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002856",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, lo sé. Eso lo sé. Probablemente tú también sabes algo, ¿no es así, Nao-\nkun?...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. No todo, pero... sé cosas que tú no sabes.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002857",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, pero, creo que ya eso está compensado con otra cosa...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Compensado?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002858",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, compensado. Y es que por cargar con ese peso, te viste obligado a salir con\nuna mujer tan latosa como yo.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002859",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En qué desastre terminé metiéndote...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota... ¿Qué pretendes con eso? Mejor recompensa no podría recibir...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002860",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Dices que yo soy la recompensa? Nao-kun, me parece que estás confundiendo\nmucho las cosas. Salir con alguien como yo no es más que un castigo...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002861",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No creo... que haya una mujer tan tediosa como yo en alguna otra parte.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tonta...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-230,file="zbg063c",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",id=1,file="se3356"},
{"bgm",file="bgm033"},
{"text"},
delay={
[1000]={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",size=3,lv=5,id=9},
{"se",file="se9010",id=1},
},
[3000]={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0019",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"se",file="se9010",vol=50,id=1},
},
[5000]={
{"bg",file="znightsky_summer",id=9,lv=9,speed=300000,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
},
},
text={
ja={
{
"Abrazo a Rin.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Rin odiaba a su padre por haberle despojado los últimos momentos de su madre.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Sin embargo, eso quedó ya en el pasado.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Ahora, odia a su padre por no explicarle nada.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Seguramente por eso, regresó una vez más a las tierras de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"No para odiar, sino para buscar una respuesta, fue que seguramente regresó a\neste lugar.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Probablemente, Rin no encontrará una, sino varias verdades pronto.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"No sé qué es lo que encontrará.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Sin embargo, sea cual sea esa respuesta, ella regresó acá para obtenerla.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Para construir una nueva relación con su padre. Para ver el pasado de una forma\ndistinta.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Y por eso...",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"bgm",file="bgm033"},
{"cgdel",id=-1},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",file="se9010",id=1,vol=50},
{"text"},
text={
ja={
{
"Abrazo fuertemente a Rin.",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002862",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Nuestros labios se tocan.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002863",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ngh... *chuu*, ah... *chuu*...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Nos abrazamos fuertemente y nos besamos.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Las lágrimas corren por el rostro de Rin.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002864",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ng, ng... nnm...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Tratamos de huir del dolor, enganchando nuestras lenguas.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002865",ch="rnd"},
},
ja={
{
name={"Rin"},
"“*chuu*... ngh, ah... nnmm...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"msgoff"},
{"bg",file="nightsky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"En eso de compartir una y otra vez intensos besos, Rin comenzó a llorar de\nrepente, sin saber por qué.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Mientras la besaba más y más fuertemente, Rin lloraba con intensidad.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Solo la abrazo.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Simplemente pensé en acogerla.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Pensé que eso era lo mejor que podía hacer por ella ahora.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-230,file="zbg063c",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0019j",head="rin_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002866",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejeje, Nao-kun, ¿sabes? Cualquier persona se sentiría cautivada, agradecida de\nser tratada con tanta bondad...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002867",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero yo soy una chica pervertida, así que en esos casos termino excitándome.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002868",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, quiero tu cuerpo. No solo tus labios. Quiero todo lo demás también...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010j",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_002869",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quiero hacer bastante el amor. Quiero seguir con lo que hicimos ayer. Quiero\nsentirte mucho, mucho más. Con mis labios, y... por supuesto, allá abajo\ntambién...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Volvemos a besarnos.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002870",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejejeje... ¿Qué tal está así?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"msgoff"},
