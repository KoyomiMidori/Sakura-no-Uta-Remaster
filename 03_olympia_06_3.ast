vo={
{"vo",file="fem_rnd_003044",ch="rnd"},
},
ja={
{
name={"Rin"},
"“T-También es eso, pero... Kuuh... Ah, mientras hablábamos, entró aún más hacia\nel fondo...”",
{"rt2"},
},
},
},
linkback="block_00509",
linknext="block_00511",
},
block_00511={
{"text"},
text={
ja={
{
"Veo a Rin desde abajo.",
