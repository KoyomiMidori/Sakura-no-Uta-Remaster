},
block_00508={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003043",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, más que gustarme... es que quiero tragar toda tu cosa, Nao-kun...”",
