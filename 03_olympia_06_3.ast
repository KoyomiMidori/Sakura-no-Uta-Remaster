},
block_00281={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002953",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí... Ya, no puedo más, no aguantaré. No puedo resistir más el placer... Jaa,\njaa... Se siente, tan bien... masturbarme... mientras... ves mi vag*na...\n¡¡HawaaAAaaah!!”",
