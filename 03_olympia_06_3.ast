},
block_00452={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003020",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nm... nguh, ngh, *zuchuu*... *yiuuu*... nguh, ngh... *gokyuu*...”",
{"rt2"},
},
},
},
linkback="block_00451",
linknext="block_00453",
},
block_00453={
{"text"},
text={
ja={
{
"Rin va lamiendo y tragando el semen disparado que reboza de su boca. Y después,\ncomo si tratara de no dejar ni una sola gota sobrante, toma delicadamente el\nsemen sobre sus pechos con sus dedos y se los lleva a la boca...",
{"rt2"},
},
},
},
linkback="block_00452",
linknext="block_00454",
},
block_00454={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003021",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nnnn... nguh... i-increíble...... puhaa... salió, en cantidades\ninimaginables...”",
{"rt2"},
},
},
},
linkback="block_00453",
linknext="block_00455",
},
block_00455={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh... a-ahh... sí, salió bastante...”",
{"rt2"},
},
},
