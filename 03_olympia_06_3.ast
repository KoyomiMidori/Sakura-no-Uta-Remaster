linknext="block_00286",
},
block_00286={
{"text"},
text={
vo={
{"vo",file="fem_rnd_002955",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto que sí... No hay manera, de que yo... odie, comportarme de esta\nforma, tan sucia... me siento, como en un sueño, recibiendo órdenes, tan\nsucias, de mi amado Nao-kuuun...”",
{"rt2"},
},
