},
},
},
linkback="block_00500",
linknext="block_00502",
},
block_00502={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003041",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kufuun... Jaa, jaa, jaa... entró... ngh, p-pero, aún, no todo, creo...”",
