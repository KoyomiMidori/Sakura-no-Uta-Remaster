linkback="block_00497",
linknext="block_00499",
},
block_00499={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003040",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ngh... Kuhaaa... ¡¡¿Haaaan?!!”",
{"rt2"},
},
},
},
linkback="block_00498",
linknext="block_00500",
},
block_00500={
{"text"},
text={
ja={
{
"――*nyurun*",
{"rt2"},
},
},
},
linkback="block_00499",
linknext="block_00501",
},
block_00501={
{"bg",file="ev_rin_h02_02",path=":ev/ev_rin_h02/",set="ev_rin_h02"},
{"text"},
text={
ja={
{
"A diferencia de la primera vez, la inserción se hace relativamente fácil al\nencontrar la entrada.",
