linkback="block_00491",
linknext="block_00493",
},
block_00493={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003037",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajaja, sí, tienes razón. Sí, si llegara a correrme con esto, sería un\ndesperdicio... Quiero que me lo metas.”",
{"rt2"},
},
},
},
linkback="block_00492",
linknext="block_00494",
},
block_00494={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, yo también quiero irme dentro de ti.”",
{"rt2"},
},
},
},
linkback="block_00493",
linknext="block_00495",
},
block_00495={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003038",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me encanta cuando dices esas cosas. Suelta bastante semen dentro de mí, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00494",
linknext="block_00496",
},
block_00496={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De dónde, aprendiste, esa frase?”",
