},
block_00514={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué dices ahora? Fuiste tú la que se montó encima...”",
{"rt2"},
},
},
},
linkback="block_00513",
linknext="block_00515",
},
block_00515={
{"text"},
