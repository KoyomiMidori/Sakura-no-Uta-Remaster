},
block_00604={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...",
{"rt2"},
},
},
},
linkback="block_00603",
linknext="block_00605",
},
block_00605={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003080",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Mmm?!”",
{"rt2"},
},
},
},
linkback="block_00604",
linknext="block_00606",
},
block_00606={
{"text"},
text={
ja={
{
"Rin se sobresalta.",
{"rt2"},
},
},
},
linkback="block_00605",
linknext="block_00607",
},
block_00607={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00606",
linknext="block_00608",
},
block_00608={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003081",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿E-Está saliendo aún?”",
{"rt2"},
},
},
},
linkback="block_00607",
linknext="block_00609",
},
block_00609={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí, aún está palpitando, así que... creo que todavía está saliendo...”",
{"rt2"},
},
},
},
linkback="block_00608",
linknext="block_00610",
},
block_00610={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003082",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, increíble... aún, después de haberte ido una vez sobre mis pechos...\nestá saliendo bastante...”",
{"rt2"},
},
},
},
linkback="block_00609",
linknext="block_00611",
},
block_00611={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo mismo va para los dos...”",
{"rt2"},
},
},
},
linkback="block_00610",
linknext="block_00612",
},
block_00612={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003083",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, ¿puedo besarte?”",
{"rt2"},
},
},
},
linkback="block_00611",
linknext="block_00613",
},
block_00613={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes por qué preguntarlo cada vez que vayas a hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00612",
linknext="block_00614",
},
block_00614={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003084",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Bien, entonces... *chuu*...”",
{"rt2"},
},
},
},
linkback="block_00613",
linknext="block_00615",
},
block_00615={
{"text"},
text={
ja={
{
"Rin me besó cariñosamente.",
{"rt2"},
},
},
},
