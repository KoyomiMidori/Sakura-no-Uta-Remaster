linkback="block_00507",
linknext="block_00509",
},
block_00509={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? ¿No estabas encantada la vez pasada cuando puse mi pe*e a vibrar al\nfondo?”",
