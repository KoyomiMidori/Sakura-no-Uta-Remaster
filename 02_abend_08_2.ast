astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg054a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9,sync=0},
{"extrans",rule="083r",sync=1,vague=40},
{"fg",ch="明石",sync=1,mx=-40,mode=-1,lv=4,id=9},
{"bgm",file="bgm101"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese es...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Sin pensarlo, me oculto.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Akashi...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Akashi estaba de nuevo parado frente a la pared de la iglesia.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Solo que hoy no estaba frente, sino de espaldas a la pared.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es lo que está viendo?...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Akashi estaba, sin duda alguna, observando algo.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué está observando?...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Se quedó unas cuantas decenas de minutos, lo cual es bastante tiempo como para\nandar parado.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Está observando algo, pensando muy seriamente.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"No hay manera de quedarse viendo fijamente un solo punto por tanto tiempo de no\nser así.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"se",file="se9004",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"bg",rule="083r",vague=40,file="bg057a",path=":bg/"},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Me paro en el lugar en el cual él se había parado, y de la misma manera.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Trato de ver en la misma dirección, y de observar lo mismo que él estaba\nobservando...",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es lo que se puede ver desde acá?...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Por más que observe, solo puedo ver las plantaciones de árboles que rodean al\ncolegio y las casas a lo lejos.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay nada que resalte en particular...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Se ve un pequeño parque. Unos cuantos conjuntos de apartamentos. También se ve\nalgo que parece un edificio. No sé qué clase de edificación es, pero no\nparece ser nada extraño.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"En pocas palabras, solo se puede ver un paisaje ordinario y común...",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué era lo que estaba viendo ese tipo?...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"msgoff"},
{"bg",file="zbluesky_spring",id=9,lv=9,speed=240000,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",time=500,sync=1},
{"text"},
text={
ja={
{
"Wataru Akashi. Nos conocemos desde que entré a este colegio... Ya han pasado\njustamente más de 2 años de conocernos.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un extraterrestre...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Un genio que siempre rompe el molde.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"No en vano laboró como el jefe del club de arte.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Tiene una forma de pensar irregular, atípica, inusual. Todo lo que hace parece\nser ridículo y absurdo, pero dentro de él, todo está conectado como si de una\nsola gran línea se tratara.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Es capaz de ver vínculos que las personas normales no pueden ver, y por otro\nlado, a veces no logra ver aquellas conexiones que las personas normales sí\npueden identificar.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Es diferente al genio de renombre internacional, Kenichiro Kusanagi. Y también\ndiferente a aquel muchacho bendecido con una aptitud natural y absoluta para\nlas artes, Kei Natsume...",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"En realidad, si lo comparamos con ellos dos, se queda atrás en lo que a talento\npuramente artístico se refiere.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Sin embargo, Akashi también tiene un talento distinto.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para ser sincero... en el momento en que entré al colegio Yumihari, me quedé\nasombrado...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Los únicos genios que había conocido en toda mi vida hasta ese entonces eran\nKenichiro Kusanagi y Kei Natsume.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Ya de por sí, esos dos genios eran algo fenomenal para mí. Me dieron a saber,\nde manera totalmente portentosa, de que en este mundo existen personas así...",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Sin embargo, en lo que concierne al colegio Yumihari, la concentración de\ntalento que hay alrededor de su club de arte es totalmente anormal.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"¿Cómo es que todas estas personas terminaron reuniéndose acá?",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quién diría que en este lugar tan pequeño, se podría encontrar tanto talento\ncondensado...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"¿Será eso parte de la historia, o quizás tradición de este colegio?",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"No, dentro de la larga historia de este colegio nunca hubo una época de tanta\nconcentración de talento como ahora...",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así será, supongo...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Al leer las historias de las vidas de los más eminentes y grandes hombres, es\ncomún ver que alrededor de aquellas personas con talento se congregan, por\nalguna razón, personas con talento.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Y además, se limita a las mismas épocas y lugares.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"No sé si es casualidad, o simplemente algo destinado a ser así...",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057a",path=":bg/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"No logro rastrear de ninguna forma la dirección que toma su pensamiento.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, ya tiene todos los instrumentos y materiales.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Seguramente, los tiene casi todos ya.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Sin embargo, no logro seguirle el paso a sus ideas...",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Genios de mierda...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Observo en la dirección en la que Akashi estaba dirigiendo sus ojos.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"No tengo idea alguna de lo que estaba viendo allí en ese momento.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Si me quedo haciendo esto, el sol se va a poner en cualquier momento.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Y cuando sea de noche, ya no se podrá ver nada.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Trato de buscar algo, pero no lo encuentro.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Al pararme solo acá, muchos pensamientos se vienen y se van de mi mente.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que Akashi está en ausencia justificada del colegio...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Juraba que había repetido el año.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Y de hecho, siempre se la pasaba saltándose las clases... Parecieran haber mil\ny un razones para que de verdad repitiera el año.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero en realidad, no fue así. Es tal como lo dijo una vez...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"msgoff"},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_wtd_000286",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Es que no les dije ya que simplemente retrasé un poco mi graduación?...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"msgoff"},
{"cgdel",id=-1},
{"bg",speed=300000,file="zbg057a",path=":bg/",x2=960,y2=-540,x=-960,y=-540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estaba esperando por algo... Ciertamente, la retrasó para hacer algo...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nunca sé cuándo habla en serio y cuándo lo hace en broma...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué era lo que estaba esperando?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Estuvo esperando hasta verano...",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Tengo cierta idea de ese porqué.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Uwabaki fácilmente derretibles. Aunque se calienten con una estufa, en pleno\ninvierno volverían a endurecerse rápidamente.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Sería mucho más eficiente hacerlo en verano.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Probablemente para eso fue que consiguió el ventilador industrial.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Secará la goma derretida rápidamente con él, y la pegará sobre un lienzo\ngigante.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Y por eso estuvo esperando por el verano.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Pero ¿realmente fue solo por eso?",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Si realmente esa es la única razón, entonces ya debió haber tenido varias\noportunidades para ejecutar su plan.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Hoy también hizo calor...",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Solo en este mes ya han habido varios días con más de 30°C. Incluso debieron\nhaber algunos que superaran los 35°C...",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Él no estuvo esperando simplemente el verano.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Seguramente está esperando por un día de verano, un día en específico...",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál es ese día qué está esperando?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000108",ch="ksd"},
},
ja={
{
name={"???"},
"“¿Andas de mirón?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057a",path=":bg/",sync=0},
{"extrans",time=500},
{"se",file="se9004",id=1},
{"fg",ch="小沙智",size="z1",sync=1,mx=-40,mode=3,resize=1,path=":fg/kos/z1/",file="kos_z1b0000",face="b0017",head="kos_z1b",lv=4,id=9},
{"se",stop=1,time=500,id=1},
{"bgm",file="bgm016"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, pero si eres tú...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0001",head="kos_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0016",head="kos_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ksd_000109",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Últimamente has venido frecuentemente a la iglesia. ¿Tienes tus ojos puestos\nsobre Komaki? Si es así, entonces estás perdiendo tu tiempo. Esa muchacha no\nse tomará la molestia de hablar contigo.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, creo que me habla bastante, más bien...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0015",head="kos_z1b",lv=4,id=9},
{"fgact",ch="小沙智",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000110",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Fuu, ¿por qué Komaki se pondrá a conversar con un tipo como tú?...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué manera tan cruel de referirte a mí...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0005",head="kos_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000111",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Ustedes dos se parecen algo... Es por eso que no me agradas.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo y quién?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0006",head="kos_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0008",head="kos_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ksd_000112",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Tú y Wataru. Mi hermano y tú se parecen un poco...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, puedes decir lo que sea menos eso. ¿Qué clase de castigo es esto\ncomo para que me digas que me parezco a él?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0009",head="kos_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000113",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Ustedes dos se parecen...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué mala...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0001",head="kos_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000114",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Wataru vino hoy también.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así parece.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0005",head="kos_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0015",head="kos_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ksd_000115",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Y aun cuando antes no venía casi nunca a la iglesia... En qué demonios estará\npensando...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres decir que tú tampoco tienes idea de lo que Akashi está pensando hacer?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0006",head="kos_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0017",head="kos_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ksd_000116",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Obviamente. ¿Por qué debería saber lo que él piensa? Siempre se desliza por la\ntangente de la expectativa de los demás.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Así que la hermanita de Akashi tampoco sabe lo que él está haciendo...",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dijiste que Akashi casi nunca venía a la iglesia antes, ¿no? ¿Más o menos\ncuándo fue que comenzó a frecuentar la iglesia?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0010",head="kos_z1b",lv=4,id=9},
{"fgact",ch="小沙智",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0012",head="kos_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ksd_000117",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Ni idea... no lo sé. Ah, pero escuché que antes de que nosotras entráramos a\neste colegio, cuando Wataru aún era de primer año, él solía venir\nfrecuentemente a ver esta iglesia.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Escuchaste? ¿Quién te contó?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0003",head="kos_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000118",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“El padre.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, el padre que no está por ahora.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0001",head="kos_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0005",head="kos_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ksd_000119",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“No es que no esté, simplemente está de reposo.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, eso parece. Según me contaron, ustedes están esforzándose bastante mientras\nesperan a que se reincorpore.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0003",head="kos_z1b",lv=4,id=9},
{"fgact",ch="小沙智",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0002",head="kos_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ksd_000120",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Por supuesto. El padre se mejorará y regresará, con toda seguridad.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Ya veo, así que realmente quiere mucho a ese padre. No, debería decir más bien\nque ambas hermanas quieren a ese padre...",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres al padre?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0004",head="kos_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000121",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Por supuesto!”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino. De no ser así no estarían trabajando de monjas, ¿verdad? Parece\nser algo bien tedioso.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0002",head="kos_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000122",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Quizás para alguien sin fe como tú sea un trabajo fastidioso, pero a pesar de\ntodo es bastante satisfactorio.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es así?...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="小沙智",size="z2",mode=3,resize=1,path=":fg/kos/z2/",file="kos_z2b0000",face="b0001",head="kos_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000123",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“El padre ayudó a Komaki. Aunque es algo de ya hace mucho tiempo...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La ayudó?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z2/",file="kos_z2b0000",face="b0002",head="kos_z2b",lv=5,id=9},
{"fgact",ch="小沙智",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000124",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Sí, cuando éramos niñas... Aunque bueno, de pensarlo ahora quizás sea algo\ninsignificante. Tal vez al contárselo a los demás se reirían... Pero Komaki,\ny también yo, fuimos salvadas por las palabras del padre.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"De pensarlo ahora quizás sea algo insignificante...",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"¿Será que el padre les sirvió de soporte emocional y las salvó cuando eran\nniñas?...",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Aunque, eso de tener que recibir ayuda emocional de un padre cuando eran\nniñas... ¿Qué clase de problemas se cargaban encima cuando eran pequeñas?",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="小沙智",size="z1",mode=3,resize=1,path=":fg/kos/z1/",file="kos_z1b0000",face="b0004",head="kos_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000125",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Aunque bueno, quizás realmente no tengo tanta fe, sino que simplemente aprecio\nal padre, quien salvó a Komaki...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál es el vínculo entre Akashi y el padre?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0008",head="kos_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000126",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Pues diría que no lo hay, ¿tal vez? La verdad es que no lo sé...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que no tiene vínculo con el padre...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000109",ch="kmd"},
},
ja={
{
name={"???"},
"“Parece que sí lo hubo.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"se",file="se9010",id=1},
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0008",head="kos_z1b",x2=0,x=-345,lv=4,id=9},
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0012",head="kos_z1b",x=-345,lv=4,id=9},
{"fg",ch="小牧",size="z1",mx=40,mode=3,resize=1,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000127",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Komaki.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000110",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Escuché unas voces conversando muy entretenidamente, así que terminé viniendo\nsin pensarlo.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0006h",head="kos_z1b",x=-345,lv=4,id=9},
{"fgact",ch="小沙智",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000128",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡N-No estábamos hablando entretenidamente!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hay algún vínculo entre el padre y Akashi?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",x=345,lv=4,id=6},
{"fgact",ch="小牧",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0003",head="kom_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000111",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, parece que antes de que nosotras entráramos a este colegio, justo cuando\nonii-chan era un estudiante de primer año, él venía a hablar muy a menudo con\nel padre.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0013",head="kos_z1b",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0017",head="kos_z1b",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ksd_000129",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Eh? ¿El padre y Wataru? ¿Qué clase de cosas hablaban? No hay forma de que esos\ndos puedan entablar una conversación, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000112",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Parece que era acerca de arquitectura. Al parecer, onii-chan tenía\nconocimientos de arquitectura y todo lo relacionado a ella, y venía a hablar\nfrecuentemente con el padre.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hablar... de arquitectura...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0012",head="kom_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000113",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es nada, prosigue, por favor.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0003",head="kom_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000114",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Parece que tenían conversaciones muy animadas respecto a lo curioso e\ninteresante que se les hacía el estilo arquitectónico de esta iglesia.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, es un estilo arquitectónico bastante raro, eso sí...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000115",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Escuché que hablaron de varias cosas, de quién la diseñó en un principio, de\ncuándo se reformó el interior y de quién condujo esa reforma.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0012",head="kos_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000130",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Ya veo. Así que por eso era que en su primer año venía con tanta frecuencia a\nla iglesia.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0003",head="kom_z1b",x=345,lv=4,id=6},
{"fgact",ch="小牧",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000116",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, también escuché que en ese momento recibió varias cosas del padre.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Varias cosas?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0016",head="kom_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000117",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Yo tampoco sé muy bien de que se trataba, pero... en ese momento recuerdo que\nse emocionó bastante. Es raro ver a onii-chan contentarse de aquella forma...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no es raro verlo contento, ¿no? Basta con darle una galleta senbei para\nque explote en alegría.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0001",head="kos_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000131",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Pues en realidad no tanto. Wataru no suele emocionarse tanto en casa como lo\nhace afuera.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De veras?...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000118",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“No es que sea antipático, pero por lo general siempre pareciera estar pensando\nalgo. En especial últimamente.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0017",head="kos_z1b",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0015",head="kos_z1b",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ksd_000132",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“No habría problema si sus pensamientos fueran acerca de ideas nobles y\nrefinadas, pero la gran mayoría de ellas no son nada buenas... Por Dios, ¿por\nqué aún comportándose tan seriamente actúa luego de manera tan ridícula?...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Yo tampoco puedo decir mucho en lo que a eso respecta...",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, ¿Akashi escuchó muchas historias del padre y luego recibió algo?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",x=345,lv=4,id=6},
{"fgact",ch="小牧",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000119",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, una especie de ilustración, o de plano de diseño... La verdad es que no\nconozco los detalles...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una ilustración? ¿Un plano?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000120",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, onii-chan nunca llegó a mostrármelo, así que solo recuerdo cómo él lo veía\ny se emocionaba...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Una ilustración... Un plano de diseño...",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Unas ilustraciones y planos de diseño capaces de hacerlo estallar de la\nfelicidad...",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, Komaki, me habías contado algo antes...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0012",head="kom_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000121",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De que la persona que reformó el interior de la iglesia fue un profesor de este\ncolegio.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fgact",ch="小牧",act="うなづく",lv=4,id=6},
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0001",head="kom_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000122",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",mode=-2},
{"fg",ch="小牧",size="z2",mode=3,resize=1,path=":fg/kom/z2/",file="kom_z2b0000",face="b0001",head="kom_z2b",lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Era un profesor de tiempo parcial, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="小牧",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0013",head="kom_z2b",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小牧",mode=3,path=":fg/kom/z2/",file="kom_z2b0000",face="b0008",head="kom_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000123",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“¿Eh? L-La verdad es que no sé, pero...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",mode=-2},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0008",head="kos_z1b",x=-345,lv=4,id=5},
{"fg",ch="小牧",size="z1",mode=3,resize=1,path=":fg/kom/z1/",file="kom_z1b0000",face="b0008",head="kom_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000278",ch="rna"},
},
ja={
{
name={"???"},
"“¡Senpai!”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Se escucha una fuerte voz desde el edificio del colegio. Es la voz de Hikawa.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_rna_000279",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Qué estás haciendo allí?!”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Al voltear con dirección a esa voz, vi como gritaban de la ventana\ncompletamente abierta de la sala de ate.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_yum_000581",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Qué haces perdiendo el tiempo hablando afuera con mujeres desconocidas~?!”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya, pero qué escandalosas...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0003",head="kos_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0002",head="kos_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000133",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Tus compañeros te están llamando. Vete rápido.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A eso se le puede llamar compañeros?...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0002",head="kom_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000124",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Por supuesto que sí. Le tengo algo de envidia a los miembros del club de arte.\nTodos parecen llevarse muy bien.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0016",head="kos_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000134",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Si tan solo no se sobrepasaran en entusiasmo y causaran tan grandes problemas,\neso sí...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0004",head="kom_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000125",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Ajajajaja... Tampoco han causado problemas tan grandes, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0015",head="kos_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000135",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Lo han hecho.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1b0000",face="b0003",head="kom_z1b",x=345,lv=4,id=6},
{"fgact",ch="小牧",act="うんうん",time=180,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000126",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Vamos, vamos, no han hecho nada que amerite expulsión...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0003",head="kos_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0004",head="kos_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_ksd_000136",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡No podría contener la alegría si así lo fuera! ¡Al fin, Wataru expulsado!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_yum_000582",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Es que no estás escuchando que te estamos llamando~?!”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, pero qué ruidosas... En fin, no importa. Gracias por la valiosa\ninformación.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1b0000",face="b0012",head="kos_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000137",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Valiosa información? ¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, solo me hablaba a mí mismo. Nos vemos...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",lv=4,id=1},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0110",face="b0001",head="rna_z1b",x=-570,lv=4,id=3},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=570,lv=4,id=4},
{"bgm",file="bgm004"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000583",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Pero qué estás haciendo?... Toqueteando con otras nuevas estudiantes bajo este\nsol tan inclemente...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo que toqueteando con otras nuevas estudiantes? ¿Qué clase de ojos tienes?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0006",head="yum_z1b",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000584",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Una mirada bastante filosa, como la de un lobo.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, ¿qué es lo que no sabes hacer como para que tuvieras que llamarme\ngritando?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000585",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ohhh, así que me estás ignorando...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, te ignoro. Te estoy preguntando que en qué necesitas ayuda.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0001",head="yum_z1a",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000586",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No te preocupes por mí, revisa esta parte de la pintura de Rin-senpai.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿No querías preguntarme algo acerca de la tuya?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000866",ch="rnd"},
},
ja={
{
name={"Rin"},
"“L-Lo siento... Kusanagi-kun, tenías algo que hacer, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0011",head="yum_z1a",lv=4,id=1},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0010",head="yum_z1a",lv=4,id=1},
},
},
text={
vo={
{"vo",file="fem_yum_000587",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿A fin de cuentas se podría decir eso? Lo único que estaba haciendo era\nconversar muy entretenidamente con dos chicas que no conozco frente a la\niglesia...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0012",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_rnd_000867",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y-Ya veo. Ahh, Kusanagi-kun, realmente eres popular con las muchachas...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué dicen eso?!”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010",head="rna_z1d",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0016",head="rna_z1d",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rna_000280",ch="rna"},
},
ja={
{
name={"Rina"},
"“No te pudiste conformar con entablar comunicación con la nutrida cantidad de\nmujeres del club de arte y tuviste que ir a hablar con mujeres nuevas\nafuera... eres asombroso, Kusanagi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota, era la presidenta del consejo estudiantil, Komaki Akashi y la\nvicepresidenta, Kosachi Akashi. Solo estábamos charlando un poco...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_rna_000281",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? Ellas son las hermanitas de Akashi-senpai, ¿cierto? Qué raro que\nestuvieras hablando con ellas...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, también tenía que resolver ciertas cosas. ¿Y bien? ¿Qué es lo que no\nsabes hacer?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000868",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, es--”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="eveningsky_spring02",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=4,sync=0},
{"extrans"},
{"bgm",file="bgm009"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu... estoy exhausto.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fgact",ch="稟",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000869",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo siento tanto por tener que obligarte todos los días a ayudarme...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, enseñarte a pintar realmente no cansa tanto.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_rna_000282",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Es por las clases suplementarias?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, mañana terminan, pero, mm~ Después de eso igualmente tengo que presentar el\nexamen de reparación.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001277",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y después de que termines iremos todos al campamento, no lo olvides.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo no tengo nada que ver en ese meollo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000588",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué no tienes nada que ver?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? Te recuerdo que no pertenezco al club de arte.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000589",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué una persona que no pertenece al club de arte está siempre en la sala\nde arte? Quizás los documentos digan otra cosa, pero a mi parecer, eres otro\nmiembro más del club de arte de Yumihari, Kusanagi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun así, no te agradaría que nosotros también fuéramos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000590",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces no hay problema con que no vaya, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"bgm",stop=1,time=5000},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",lv=4,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000591",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... Si no vas todos los demás, se sentirán tristes.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"bgm",stop=1,time=500},
{"bgm",file="bgm012"},
{"fg",mode=-2},
{"fg",ch="トーマス",size="z1",my=40,mode=3,resize=1,path=":fg/tho/z1/",file="tho_z1a0100",face="a0001",head="tho_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000095",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“YEEES. Espiemos juntos el baño de las chicas desde el baño de los chicos. Si no\nrealizamos este evento tradicional japonés el verano de este año se nos\npasará encima, MASU.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_yum_000592",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No hay ningún evento de ese tipo en Japón!”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"se",id=1,file="se2192"},
{"fg",ch="トーマス",mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0010",head="tho_z1a",lv=4,id=9},
{"fgact",ch="トーマス",act="quake",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000096",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“¡OUCH!”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kawachino, no conviene que reacciones a todo momento a cada una de las\ntonterías de este idiota.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="man_ked_000967",ch="ked"},
},
ja={
{
name={"Kei"},
"“Aunque, es curioso. Pensé que Thomas no tenía interés en otra cosa que no\nfueran mujeres, así que no creí que te invitaría, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="トーマス",mode=3,path=":fg/tho/z1/",file="tho_z1a0100",face="a0001",head="tho_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000097",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“Kei, eres muy bajo de estatura, así que eres inútil como soporte para pararme y\nespiar, DESU.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Solo me invitaste para servirte de soporte?...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fgact",ch="トーマス",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000098",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“YEEES.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Thomas muestra una sonrisa de lado a lado.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"O más bien, pareciera tener una cara extasiada.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"Me irrita hasta la médula.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
delay={
vl01={
{"fgact",ch="トーマス",act="ジャンプ",loop=-1,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_tmd_000099",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“El evento clásico de Japón de espiar en las aguas termales... OOHHH, YEEEAHH...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fgact",ch="トーマス",act="びっくり",loop=-1,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tmd_000100",ch="tmd"},
},
ja={
{
name={"Thomas"},
"“OH, YEAH. OH, YEEAAH. OH, YEEAeee, u-uh... *biku*, *biku*... *bikunbikun*.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="トーマス",my=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Thomas terminó desmayándose. Ya no puedo más con este extranjero.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="02_abend_08_3"},
{"text"},
linkback="block_00223",
},
label = {
top={block="block_00000",label=1},
},
}
