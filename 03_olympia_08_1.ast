astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c04_01",path=":ev/ev_eye_c04/",set="ev_eye_c04"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="ev_uni_c42_01",path=":ev/ev_uni_c42/",set="ev_uni_c42"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003134",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Dónde... estoy...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Una pared blanca...",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"No. Esto no es una pared.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Es el techo.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Un techo distinto al de mi casa.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Un techo que no conozco.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Rin? ¿Recobraste la consciencia?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003135",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿N-Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ah, espera, no trates de levantarte si no puedes.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003136",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, y-ya estoy bien...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Levanto la parte superior de mi cuerpo de la cama.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=100,file="zbg067a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003137",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Esto es... un hospital?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh... parece que no tienes tan mala cara. Qué alivio. Cuando te desmayaste\npensé que te había pasado algo.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003138",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Me... desmayé?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, te desmayaste en el apartamento de tu papá. ¿Lo recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"bg",time=50,sync=0,file="black",path=":bg/"},
{"se",file="se9014",id=1},
{"bg",file="ev_uni_c35_01",rule=7,time=50,sync=0,face=1,path=":ev/ev_uni_c35/",set="ev_uni_c35"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,sync=0,file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003139a",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo... fui al apartamento de papá...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",mode=-2,sync=0},
{"bg",y=100,file="zbg067a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"quake",mode="mw"},
{"bgm",file="bgm025"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003139b",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Auch...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rin, ¿estás bien?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003140",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, n-no pasa nada. E-Estoy bien...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"¿Qué fue... eso?",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, hace un tiempo ese mismo escenario se cruzó por mi mente\npor un instante.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Ciertamente, eso fue...",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"La primera vez que tomé carboncillo en mis manos, al recién ingresar al club de\narte.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Esa sensación del carbón me hizo rememorar algo dentro de mí.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"¿Qué fue lo que me hizo recordar el carbón?",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"bg",time=50,sync=0,file="black",path=":bg/"},
{"se",file="se9014",id=1},
{"bg",file="ev_uni_c35_01",rule=7,time=50,sync=0,face=1,path=":ev/ev_uni_c35/",set="ev_uni_c35"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Ese escenario...",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Era como si una edificación estuviera quemándose...",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Esa casa era...",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"bg",time=50,sync=0,file="black",path=":bg/"},
{"se",file="se9014",id=1},
{"bg",file="ev_uni_c35_01",rule=7,time=50,sync=0,face=1,path=":ev/ev_uni_c35/",set="ev_uni_c35"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,sync=0,file="black",path=":bg/"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003141",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Auch--”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",mode=-2,sync=0},
{"bg",y=-586,speed=300000,file="zbg067a",path=":bg/",x2=960,y2=-586,x=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Estás bien? No te esfuerces tanto. Vamos, acuéstate.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003142",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Voy a llamar al doctor y decirle que ya despertaste, ¿está bien? Quizás me\ntarde un poco, ¿crees que puedas esperarme?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003143",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Pero...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Agarro la mano de Nao-kun.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa, Rin?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003144",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nada. Solo quería agarrar tu mano...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que solo querías agarrarla?...",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003145",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y... gracias.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Gracias por qué?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003146",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por preocuparte por mí...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué dices? ¿Que no es acaso obvio que me preocupe por ti? Ah, demonios,\npero qué clase de cosas andas diciendo ahora...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Aprieto la mano de Nao-kun.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Su mano derecha.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Está cálida.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003147",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Ah, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? Bien, bueno, apenas acabas de recobrar la consciencia, de verdad,\nno trates de esforzarte tanto.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003148",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, tranquilo, estoy bien...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Voy y vuelvo entonces, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"se",id=1,file="gatya"},
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg067a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Nao-kun sale de la habitación.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Pero ¿por qué me habré desmayado?...",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Y, por cierto...",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Anoche, fui... al apartamento de papá, y...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"bg",time=50,sync=0,file="black",path=":bg/"},
{"se",file="se9014",id=1},
{"bg",file="ev_uni_c35_01",rule=7,time=50,sync=0,face=1,path=":ev/ev_uni_c35/",set="ev_uni_c35"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,sync=0,file="black",path=":bg/"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003149",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Auch...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Fui al apartamento de papá.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Y allí, yo――",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_knd_000125",ch="knd"},
},
ja={
{
name={"???"},
"“Rin-chan, ¿estás bien～?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Una voz no muy familiar interrumpió mi pensamiento.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003150",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Q-Quién es?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg067a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",id=1,file="gatya"},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000126",ch="knd"},
},
ja={
{
name={"Kana"},
"“Soy Kana. ¿Ya me olvidaste?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003151",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿K-Kana-chan?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Kana Nagayama-chan. La chica que estuvo en el mismo salón que yo cuando éramos\nniñas.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Sin embargo, no llegué a hablar con ella sino hasta hace poco.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"¿Por qué estará acá?",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0002",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000127",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ejejeje, escuché que te habías desmayado, así que vine a visitarte. ¿Ehmmm,\npodré dejar las flores aquí?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003152",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, disculpa que te moleste de esta forma...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000128",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Pero qué estás diciendo, Rin-chan? ¿No somos acaso amigas? Aunque, ya varias\nveces me han interrumpido...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003153",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000129",ch="knd"},
},
ja={
{
name={"Kana"},
"“Nada, solo me hablaba a mí misma. Sí, charla interna.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003154",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000130",ch="knd"},
},
ja={
{
name={"Kana"},
"“De verdad que Kusanagi-kun te ama, ehhh. Rin-chan, me das bastante envidia.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003155",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Q-Qué pena...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0010",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000131",ch="knd"},
},
ja={
{
name={"Kana"},
"“Estuvo todo este tiempo cuidándote. En ningún momento llegó a salir o\ndistraerse, así que no podía entrar a la habitación. Pero qué lío...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003156",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, ¿cuando dijiste que te habían interrumpido varias veces, quizás te referías\na Nao-kun? Discúlpame si eso te hizo sentir mal, ¿sí? Parece que Nao-kun\nestaba preocupado por mí, y se tomo bastantes molestias para cuidarme...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000132",ch="knd"},
},
ja={
{
name={"Kana"},
"“De verdad que sí. Estuvo esforzándose bastante para evitar que nosotras dos nos\nencontráramos.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003157",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No es eso. Es por el estado en que estoy ahora...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000133",ch="knd"},
},
ja={
{
name={"Kana"},
"“Jeje. Pero qué está diciendo ahora... Te equivocas. Naoya-kun no quiere que\nnosotras dos nos encontremos. Ni un solo momento, de ahora en adelante...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000134",ch="knd"},
},
ja={
{
name={"Kana"},
"“Tu salud no tiene nada que ver, Rin-chan. Estoy segura de que aún después de\nesto tratará de evitar que nosotras dos hagamos contacto.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003158",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿P-Por qué dices eso? Nao-kun no es ese tipo de persona.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000135",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, él es muy amable. Y solo contigo...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003159",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun es muy amable con todos, no solo conmigo.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000136",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eso crees? Mis ojos solo ven a un idiota, que por ser amable, tan amable\ncontigo, terminó perdiéndolo todo.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003160",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿P-Por qué... dices eso?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0015",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000137",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y la verdad, si no se hubiera empeñado en ser amable contigo, no hubiera\nterminado de esta forma.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0011",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0010",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000138",ch="knd"},
},
ja={
{
name={"Kana"},
"“No creo que hubiera acabado pudriéndose en esta ciudad perdida en medio del\ncampo. No es una exageración decir que tenía el talento suficiente como para\npoder haber sido el artista más joven en recibir un premio de la Exposición\nMoore.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003161",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De... qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000139",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Es que no sabes de qué estoy hablando? Ya veo, pero qué despreocupada y alegre\neres, eh. Me imagino que es esa misma actitud lo que hace caer a los hombres\nante tus pies, ¿no?. Vaya buena actriz que serías si en realidad estuvieras\nfingiendo, mujer.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003162",ch="rnd"},
},
ja={
{
name={"Rin"},
"¿Qué, quieres decir... con eso de despreocupada, o con eso de fingir?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000140",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, perdón, ¿te lastimó lo que dije? No creas que estoy tratando de\nrecriminarte, Rin-chan. Quizás los demás no lo sepan, pero podría decir que\nincluso hasta estoy agradecida contigo.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003163",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nagayama-san...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0010",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0005",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000141",ch="knd"},
},
ja={
{
name={"Kana"},
"“Hace tiempo eras toda una hermosa chica, amada por ese genio pintor. Me dabas\nenvidia, me causabas celos, pero... pero ahora las cosas cambiaron.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000142",ch="knd"},
},
ja={
{
name={"Kana"},
"“Estoy agradecida contigo por haber aplastado y convertido en chatarra a ese\nexcepcional talento. Pero no siento envidia, ni celos ahora.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003164",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Q-Qué quieres--”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="香奈",size="z2",mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0100",face="a0017",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
{"se",file="se2497",id=1},
{"text"},
text={
vo={
{"vo",file="fem_knd_000143",ch="knd"},
},
ja={
{
name={"Kana"},
"“Toma y lee esto...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Nagayama-san me da una copia impresa de algo.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Y esa copia era la de un artículo publicado en uno de los diarios locales.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003165",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E... esto, es...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0005",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000144",ch="knd"},
},
ja={
{
name={"Kana"},
"“Tragedia por incendio en la casa de la familia Misakura. El artículo habla de\ncomo se incendió la casa de Yuuzou Misakura, pintor y administrador de un\nnegocio de pinturas en la ciudad Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0016",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000145",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ya sabía desde hace tiempo que eras refinada, adinerada, pero no sabía que\nvivías en semejante mansión. Quedé pasmada cuando leí este artículo, 1320\nmetros cuadrados, es increíble.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0003",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000146",ch="knd"},
},
ja={
{
name={"Kana"},
"“Tu padre era un pintor con algo de fama, pero no creo que pudiera hacer mucho\ndinero de ahí, así que debe haber sido su talento como comerciante de\npinturas. Aunque bueno, la economía estaba mucho mejor que ahora, así que me\nimagino que habrá obtenido su fortuna haciendo sus negocios.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0015",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000147",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero cualquiera se quedaría estupefacto al ver quemarse todo eso por un\nincendio, ¿no te parece?...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003166",ch="rnd"},
},
ja={
{
name={"Rin"},
"“U-Un incendio...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0016",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000148",ch="knd"},
},
ja={
{
name={"Kana"},
"“Vamos, lee esta parte. Quedé asombrada cuando lo leí, parece que fue la\nhabitación infantil la que más se quemó.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0003",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000149",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Y sabes qué más? Tanto la policía como los bomberos llegaron a la conclusión\nde que el origen del fuego fue en la habitación infantil. En pocas palabras,\ntu habitación, Rin-chan. ¿No es así?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0016",head="kan_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000150",ch="knd"},
},
ja={
{
name={"Kana"},
"“Entiendes lo que eso significa, ¿no? El hecho que de tu propia habitación se\nhaya originado el fuego.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003167",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿D-De mi habitación comenzó el fuego?...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0003",head="kan_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0015",head="kan_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000151",ch="knd"},
},
ja={
{
name={"Kana"},
"“Así es. Para ponerlo corto y sencillo, tú misma quemaste tu casa, Rin- chan...\nPero qué cruel, ¿no? En eso te llevaste la vida de tu propia madre, y el\nbrazo derecho de Naoya Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003168",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Recordé.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"bg",time=50,file="black",path=":bg/"},
{"se",file="se9014",id=1},
{"bg",file="ev_uni_c35_01",rule=7,time=50,path=":ev/ev_uni_c35/",set="ev_uni_c35"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"se",file="se9043",id=9,vol=50,loop=1},
{"bg",file="ev_uni_c35_01",time=2000,path=":ev/ev_uni_c35/",set="ev_uni_c35"},
{"text"},
text={
ja={
{
"El cielo se tiñe de rojo intenso.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Estruendosos sonidos.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Las llamas se elevan y se extienden, produciendo estruendosos sonidos.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003169",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Mamáááá!”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000001",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¡Rin!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"se",id=1,file="se2534"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"El vidrio de la terraza se rompe, elevando un fuerte ruido.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Todo el estruendo alrededor aplaca nuestras voces.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000002",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¡Rin, cuidado!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Mamá me empuja hacia un lado.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"se",id=1,file="se1451"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003170",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Kyaah!”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Los pilares rodeados de fuego caen, como si hubieran sido enrollados por una\nlengua carmesí.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_mmd_000003",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003171",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Mamá! ¡Mamá!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000004",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Parece que se me atascaron las piernas con eso...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003172",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Trato de levantar el pilar que estaba ahora aplastando las piernas de mamá.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Pero el pilar no se mueve en lo absoluto.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003173",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si tuviera un palo o una vara.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Trato de usar un palo que había tirado por allí como palanca para mover el\npilar.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"se",id=1,file="se2661"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003174",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ughhh.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"El palo se rompe, soltando el característico sonido de la madera abriéndose por\nla mitad.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003175",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Necesito un palo más duro...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000005",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Rin, ya no puedo moverme...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003176",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No, mamá!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="man_mtt_000115",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“¡¿Me escuchan?! ¡Dónde están!”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Se escucha una voz viniendo de los pisos inferiores.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Esa es la voz de papá.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"se",file="se1641",id=1},
{"text"},
text={
ja={
{
"Abro una de las ventanas que había cerca.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"bg",file="ev_uni_c43_01",path=":ev/ev_uni_c43/",set="ev_uni_c43"},
{"se",id=1,file="kazenari"},
{"text"},
text={
ja={
{
"De la ventana se podía ver una enorme luna llena.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Una enorme, inmensa luna llena.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"El terror me invadió al ver esa luna llena.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"La luz completamente azulada de la luna me pareció realmente espeluznante.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Más espeluznante que el fuego brillando y ardiendo en profundo rojo.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003177",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"En lo que me quedé paralizada del miedo por la vista de la luna, escucho un\ngrito venir hacia mí.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin! ¡¿Estás ahí?!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Una voz resuena justo debajo de mis ojos.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Allí estaba alguien gritando, con bastante fuerza.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003178",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Nao-kun!”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="man_mtt_000116",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Rin, ¿eres tú? ¡Rin, ¿dónde estás?!”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Papá reacciona a mi voz y me llama. Su voz no viene de afuera, sino del\ninterior de la mansión.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"¿Papá aún está dentro de la mansión?",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"¿Dónde?",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Vine huyendo de las llamas sin ver a donde iba, y no sabía dónde siquiera\nestaba.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Pero aun así, sé cuál es el lugar donde estoy ahora. El paisaje que se ve desde\nesta ventana es justamente el mismo que se puede ver desde la ventana del\npiso más alto de la mansión.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin! ¡¿Estás bien?!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003179",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Mi mamá! ¡A mi mamá se le atascaron las piernas!”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Nao-kun me encuentra y me grita. Grito yo también por Nao-kun.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Maldita sea, pero qué andan haciendo los bomberos?! ¡¿Que no tienen ninguna\nescalera?!”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="man_mtt_000117",ch="mtt"},
},
ja={
{
name={"Padre de Rin"},
"“Rin, ¿dónde estááás?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003180",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué hago, qué puedo hacer?...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000006",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Mamá me llama con una débil voz.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003181",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Mamá!”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"En ese mismo instante corrí a acercarme a mamá.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bg",file="ev_uni_c35_01",path=":ev/ev_uni_c35/",set="ev_uni_c35"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003182",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mamá, ¿qué hago? Papá está aún en la mansión, pero los bomberos no han venido.\nTienes ahora las piernas atascadas, mamá, ¿qué hago? ¿Qué puedo hacer?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000007",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Préstame atención, ¿sí, Rin? Vas a escuchar muy bien lo que te diré ahora.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003183",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000008",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Eres una buena niña, ¿verdad, Rin?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003184",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000009",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“De ninguna forma vas a causarle problemas a papá, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003185",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000010",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“De ninguna manera harías algo que me ponga triste, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003186",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000011",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Eres capaz de vivir con fuerza, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003187",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, y tú también lo harás, mamá.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000012",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000013",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Pero tú deberás vivir con mucha, mucha más fuerza, Rin.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003188",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Con más fuerza?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000014",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¿Puedes prometerle eso a mamá?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003189",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, lo prometo.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Mamá muestra una sonrisa de alivio en su rostro.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000015",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Muy buena respuesta. Rin, siempre fuiste una niña muy buena. Tan buena que\nllegaste a preocuparnos a veces incluso...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003190",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso no es verdad, yo... ¡Yo!”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000016",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Para nada. Has sido una excelente muchacha.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000017",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Gracias por haber nacido y venido a nosotros, Rin.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003191",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mamá, ¿qué estás diciendo? ¡Yo, yo--!”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mmd_000018",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¡¿Quién está afuera?! ¡¿Hay alguien, hay alguien afuera?!”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Yo! ¡Soy yo, Naoya Kusanagi! ¡¿Esa voz, es usted la mamá de Rin?!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000019",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Kusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000020",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¡¿Mi esposo, el padre de Rin, no está allí?!”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡El señor entró a la mansión para buscarlas a las dos!”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000021",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Ese hombre...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000022",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¡Grita hacia la mansión y di que ambas estamos a salvo ya! ¡Haz que mi esposo\nsalga inmediatamente ya de la mansión, por favor!”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¡P-Pero!...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"se",id=1,file="se2534"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mmd_000023",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Kaah.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003192",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Kyaah!”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"Un explosivo sonido viene a la habitación acompañado de un ardiente viento.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000024",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Ugh... ya no queda casi tiempo.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000025",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¡Kusanagi-kun! ¡¿Hay algún otro adulto por ahí?!”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Hay unos cuantos!”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000026",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¿Hay alguien allí que yo conozca?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No lo sé, creo que son personas del mismo vecindario!”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mmd_000027",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¡¿Hay alguien allí?! ¡¿Algún adulto?!”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Con su cuerpo ahora aplastado por el pilar, mamá no tenía forma de saber cómo\nestaba todo afuera.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Al ver hacia abajo desde la ventana, habían varios adultos reunidos, pero todos\nestaban simplemente absortos viendo la mansión, con rostros nerviosos.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Quizás mamá se dio cuenta de eso por mi expresión. Inmediatamente volvió a\nllamar a Nao-kun.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000028",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¡Kusanagi-kun! ¡Tengo un favor que pedirte!”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pídamelo!”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000029",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¡Hace un tiempo llegaste a contarme con mucho orgullo lo fuerte que eras,\n¿cierto?!”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí! ¡Papá me crió poniéndome desde pequeño unos ridículos aparatos expansores\nde entrenamiento para pintar, así que tengo mucha confianza en la fuerza de\nmis brazos!”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que si me pide que trepe la mansión, entonces probablemente pueda hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000030",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Jaja...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Mamá se ríe al escuchar la respuesta de Nao-kun.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000031",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Qué buen amigo te conseguiste, Rin...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003193",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí, Nao-kun es un buen amigo.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000032",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000033",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¡Kusanagi-kun! ¡Escúchame bien, por favor! ¡Se supone que esto debería hacerlo\nmi esposo, pero--!”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000034",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¡Te pediré un favor muy, muy terrible! ¡¿Serías capaz aun así de\ncumplírmelo?!”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Lo que sea, solo dígame!”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000035",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Realmente fuiste bendecida con un gran amigo, Rin...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000036",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Y realmente es lamentable que la madre de tu amiga sea tan cruel,\nKusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000037",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¡Si hay algún otro adulto por allí entonces ayúdeme, por favor!”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000038",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¡Tomen a Rin!”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003194",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000039",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“Ya no tengo salvación alguna. Pero Rin aún está a salvo. ¡Aún es una niña, así\nque no pesa tanto!”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="fem_mmd_000040",ch="mmd"},
},
ja={
{
name={"Madre de Rin"},
"“¡Así que preferiría que los otros adultos me ayuden! ¡Por favor, tomen, tomen a\nRin!...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003195",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mamá, qué... ¿qué estás diciendo?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"se",id=1,file="se1451"},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003196",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"bg",rule=036,time=300,file="black",path=":bg/"},
{"se",stop=1,time=500,id=1},
{"se",stop=1,id=9,time=500},
{"bg",file="zev_uni_c36_01",rule=036,time=300,zoom=50,x=0,y=0,speed=180000,z2=100,path=":ev/ev_uni_c36/",set="ev_uni_c36",x2=-960,y2=450,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se2340",vol=60,id=1},
{"text"},
text={
ja={
{
"Una fría y suave sensación.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Sentí como si hubiera tocado el ojo de la luna.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Al gélido, frío ojo de la noche.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Me dio la sensación de haber tocado ese ojo.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"Ese terrorífico ojo se sentía frío, glacial. El cielo de la noche estaba teñido\ncon el viscoso líquido que emanaba de ese ojo.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Solo había el vacío allí.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Y por eso es que caí dando vueltas en la noche de ese viscoso ojo, sin saber\ndónde estaba el 'arriba' y el 'abajo'.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Solo caigo, entre vuelta y vuelta, por ese viscoso cielo nocturno.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"La luna brillaba.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"El mundo brillaba.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"La luna azul... y las llamas rojas.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
"En la suavidad de la no-gravedad caigo, y caigo, dentro del cielo.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin!”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"Escucho una nostálgica voz en medio de ese cielo nocturno que se me hacía tan\nirreal.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003197",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡N-Nao-kun!”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Trato de ver hacia esa dirección.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Pero lo único que hago y puedo hacer es dar vueltas en ese casi aparentemente\nviscoso cielo.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"Ah, claro.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Fue en ese momento que finalmente... me di cuenta de que estaba cayendo.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Estoy cayendo de cabeza desde el piso más alto de la mansión.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"¿Será que la explosión me mandó volando?",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
"¿O será que mamá usó sus últimas fuerzas para empujarme, y caí?",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
"No lo sé.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"No lo sé, y lo único que hago ahora es dar vueltas, y vueltas, en este mundo de\nazul y rojo.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin!”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"Por un momento vi esa silueta.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"A Nao-kun abriendo sus dos brazos.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"A Nao-kun corriendo y acercándose hacia mí.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"No lo hagas.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"Es peligroso, estoy cayendo con mucha velocidad, no te acerques.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"Eso quise gritar.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
"Pero el suelo se acerca mucho antes de que esas palabras pudieran convertirse\nen sonido.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"se",file="se0744",id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡UOOooohHHH!”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"se",stop=1,id=1,time=500},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",id=1,file="se3356"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003198",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡--!”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Guwaaah!”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"Por un instante todo mi cuerpo se calienta.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Aun cuando estaba en medio de las llamas, no llegué a sentir tanto calor como\nahora.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
"Después de que pasó ese calor que parecía estar a punto de desgarrarme por\ncompleto... solo quedó el silencio.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rin...”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003199",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"bg",file="ev_com_c09_01",path=":ev/ev_com_c09/",set="ev_com_c09"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué alivio... Rin... estabas a salvo...”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
"Nao-kun dijo eso con una voz casi a punto de desvanecerse en cualquier momento.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
"Con una voz más débil que incluso la mía después de haber caído.",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003200",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Nao-kun, Nao-kun, perdóname, perdóname!”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué estás disculpándote?... No tienes nada por qué hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003201",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero, pero, si tan solo hubiera saltado correctamente--”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con esa altura, era imposible...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003202",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero... pude haber hecho algo. ¡Por ejemplo, el ukemi del judo, o algo así!”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con esa altura el ukemi del judo no te hubiera servido para nada.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003203",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero no lo sabemos, tal vez, si hubiera podido hacer algo, si hubiera hecho\nalgo, no hubieras terminado herido de esa forma, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te preocupes. Yo mismo quise hacer esto...”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
"Nao-kun toma un gran respiro y grita.",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Señora Misakura! ¡Quédese tranquila, ya tengo a Rin conmigo!”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
"No hay ninguna respuesta.",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
"De la mansión solo se escuchaba el espeluznante estruendo del fuego.",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"se",file="se9023",id=1},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"se",file="se9014",id=2},
{"bg",rule=7,time=50,file="bg067a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"se",file="se9014",id=3},
{"bg",rule=7,time=50,file="bg066a",path=":bg/"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"se",file="se9014",id=4},
{"bg",rule=7,time=50,file="bg015c",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"No recuerdo más de lo que sucedió después.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"Simplemente corrí, sin razón alguna.",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"Me pareció haber escuchado la voz de Nagayama-san.",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
"Pero ni siquiera eso puedo recordar ahora.",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
"Simplemente, no pude resistir la verdad que acababa de recordar. La confusión\nme invadió, y salí corriendo.",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
"Fui yo quien destrozó el brazo de Nao-kun.",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
"Nao-kun perdió su brazo derecho para protegerme.",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
"El brazo derecho que tanto entrenó para pintar.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"Aquellas maravillosas y fantásticas pinturas que solo él puede crear.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
"Yo lo despojé de la mano derecha que usaba para eso.",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
"Esas palabras que Nagayama-san me dijo antes de yo salir corriendo atraviesan\nmi cabeza.",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
"Las palabras de la verdad se agolpan sobre mí incontables veces.",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
"Eso fue un crimen.",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
"Una verdad que no debió haber sido olvidada.",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
"Y aún a pesar de eso, una verdad de la cual terminé huyendo.",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
"Un castigo del cual estuve huyendo airosa hasta ahora, borrando eso de mis\nmemorias.",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",style="gray"},
{"bg",file="bg067a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",lv=4,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0010",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000152",ch="knd"},
},
ja={
{
name={"Kana"},
"“Me sorprende la tranquilidad con la que has vivido hasta ahora, aún después de\nhaber hecho trizas el talento de semejante genio. Si hubiera sido yo, la\nsensación de culpabilidad me hubiera matado ya.”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0011",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000153",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, definitivamente, si fuera yo, sería tanta la pena que no podría vivir.”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0010",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000154",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sin duda alguna, me mataría.”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000155",ch="knd"},
},
ja={
{
name={"Kana"},
"“De verdad que tienes bastantes agallas, Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000156",ch="knd"},
},
ja={
{
name={"Kana"},
"“Estar por ahí libre, sin ningún castigo, aún después de haber cometido ese\ncrimen.”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000157",ch="knd"},
},
ja={
{
name={"Kana"},
"“Basta con ser linda para que todos te perdonen cualquier cosa, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"bgm",stop=1,time=1000},
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"colortone",style="reset"},
{"bg",file="black",path=":bg/"},
{"se",file="se9023",id=1},
{"text"},
text={
ja={
{
"Comencé a correr de repente, como huyendo de algo, sin sentido ni lógica\nalguna.",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_olympia_08_2"},
{"text"},
linkback="block_00307",
},
label = {
top={block="block_00000",label=1},
},
}
