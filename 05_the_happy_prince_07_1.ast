astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"bg",file="ev_eye_c13_01",path=":ev/ev_eye_c13/",set="ev_eye_c13"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="zbluesky_spring",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm017"},
{"text"},
text={
ja={
{
"Un día de tantos, tras varias semanas del cierre de aplicaciones de la\nExposición Moore.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Llegaron dos sobres enviados por Fridmann.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"No tenían destinatario escrito.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Procuré preguntarle por teléfono.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"msgoff"},
{"se",file="se1343",sync=1,id=1},
{"se",file="se3434",id=1},
{"text"},
text={
vo={
{"vo",file="man_frd_000276",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Son boletos para la ceremonia de premiación.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué dos?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="man_frd_000277",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Quién sabe? Un error... o tal vez es que los jueces no logran decidirse aún...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hablas como si no fuese asunto tuyo. Tú también eres juez.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="man_frd_000278",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Solo bromeaba.\nSon certificados auténticos de nominación.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo cual quiere decir que... ¿ambos fuímos nominados?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="man_frd_000279",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí, los dos.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“I-Increíble... Si a veces ni siquiera hay ningún nominado japonés...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="man_frd_000280",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Eso no es cierto, no recientemente. Cada uno de estos últimos años han habido\nvarios nominados.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero es impresionante el hecho de que lleguen dos de estas invitaciones a esta\ncasa.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_frd_000281",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Dos estudiantes nominados. Cómo ha decaído la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Definitivamente no sabes ahorrarte los malos comentarios.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="man_frd_000282",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Diga lo que diga, son documentos de nominación auténticos.\nAmbos pasaron la sexta selección.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="man_frd_000283",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Será un placer tenerte acá junto a Kei Natsume.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, está bien.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="man_frd_000284",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Nosotros nos encargaremos de sus atuendos. Solo requerimos que lleguen a tiempo\nal lugar.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vale, ya entiendo.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="man_frd_000285",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Para cualquier pregunta puedes contactarme directamente. Me encargaré en ese\ncaso.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno... La verdad es que tengo muchas, así que quizá te llame.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="man_frd_000286",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Bien, espero verte en la ceremonia...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"se",file="se3434",id=1},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg010a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Pasamos la sexta selección... Dos más para la última.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"¿Es que realmente... logramos llegar tan alto?",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1b0400",face="b0017",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001249",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Llamó alguien?\n¿Con quién hablabas?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Apenas terminé de hablar con Fridmann, Kei apareció del pasillo.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con alguien no muy agradable...\nEn fin, llegaron dos sobres de la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2b0400",face="b0007",head="kei_z2b",lv=5,id=9},
{"fgact",ch="圭",act="うなづく",lv=5,id=9},
{"se",file="se3130",id=1},
{"text"},
text={
vo={
{"vo",file="man_ked_001250",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿En serio?!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aquí están.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Le muestro los dos sobres a Kei.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="man_ked_001251",ch="ked"},
},
ja={
{
name={"Kei"},
"“O-Oye, esto, esto significa que ambos seremos premiados, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, por ahora solo nominados.\nAunque al parecer eso significa que pasamos la sexta selección.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0017",head="kei_z2b",lv=5,id=9},
{"fgact",ch="圭",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001252",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿De veras?! ¡¿No es eso asombroso!?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya en sí pasar la sexta selección es un gran logro. No es algo que ves con\nnormalidad.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0002",head="kei_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0003",head="kei_z2b",lv=5,id=9},
{"fgact",ch="圭",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001253",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Pues bastante esfuerzo que le pusimos!”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues en mi caso hice realmente lo que pude...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0002",head="kei_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001254",ch="ked"},
},
ja={
{
name={"Kei"},
"“Si es por eso yo también.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"No he visto el cuadro de Kei.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Kei tampoco ha visto el mío.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Pero basta con observar su cara.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Seguramente está más que satisfecho con lo que pintó.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0003",head="kei_z2b",lv=5,id=9},
{"fgact",ch="圭",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001255",ch="ked"},
},
ja={
{
name={"Kei"},
"“Cielos, cielos, ¿te imaginas a los dos de famosos? La ciudad se conmocionará.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te aceleres tanto, tonto. No hemos recibido premio alguno todavía.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0001",head="kei_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001256",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero ya el solo ser nominado es algo asombroso, ¿no? ¿Será que saldremos en la\ntele por eso?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El día de la ceremonia sí. Aunque sí, es raro ser nominado a esta edad, así que\nseguramente nos entrevistarán.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0003",head="kei_z2b",lv=5,id=9},
{"fgact",ch="圭",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0014",head="kei_z2b",lv=5,id=9},
},
vl02={
{"fgact",ch="圭",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001257",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Los dos en la tele! ¡No lo puedo creer!”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tan genial es salir en la televisión? La odio.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0013",head="kei_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001258",ch="ked"},
},
ja={
{
name={"Kei"},
"“Lo dices porque eres famoso desde pequeño, pero para mí es algo asombroso.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Bueno, quizá sí sea un honor aparecer en la televisión cuando no se\ntrate de un escándalo.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Repito, solo hemos sido nominados. No premiados.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0002",head="kei_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001259",ch="ked"},
},
ja={
{
name={"Kei"},
"“Lo sé, pero creo que nosotros ganaremos.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es estúpido pensar que saldrá todo así de bien.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0003",head="kei_z2b",lv=5,id=9},
{"fgact",ch="圭",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001260",ch="ked"},
},
ja={
{
name={"Kei"},
"“Nones nones, se trata de nosotros, dos genios, ¿recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"El acabado de mi cuadro fue satisfactorio.Seguramente sucedió lo mismo con Kei\nen su caso.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Pero todavía hay muchos artistas en este país que han dejado su huella a nivel\ninternacional.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Entre ellos hay varios grandes nombres que por mera mala suerte no han podido\nganar aún.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Y si me pongo a contarlos no me alcanzarán los dedos de las manos.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0001",head="kei_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001261",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Te imaginas que gane el Platine Epaulard? ¿Qué voy a hacer?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta preocuparse por eso.\nEn primer lugar, esta nominación es para los tres premios de cobre. La nominación para los otros es distinta.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2b0400",face="b0009",head="kei_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001262",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿De veras?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Claro, hay casos de doble nominación... Aunque es mejor no esperar mucho.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1b0400",face="b0009",head="kei_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué andas haciendo tú? Tienes las manos embadurnadas de aceite.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0017",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0002",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001263",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, sí. He abandonado la moto por tanto tiempo que ya no enciende.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es bastante vieja, ¿qué esperas? ¿Por qué no mejor comprar una nueva?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0004",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0019",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0001",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001264",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Una nueva? No, no, a mí me gusta esta.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmmmph... Le tienes apego, eh.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0002",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001265",ch="ked"},
},
ja={
{
name={"Kei"},
"“De que lo tengo, lo tengo. Es super guay en primer lugar, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, para mí es solo un simple scooter.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0013",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0018",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001266",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ya te dije que no es un scooter, demonios. Cielos, realmente que no sabes nada\nde motocicletas, Naoya...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya, bueno, dale buen mantenimiento. Es tan vieja que con solo pisar un charco\nsus frenos dejan de funcionar, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0009",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001267",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues sí, no sabes lo que puede pasarle si no tienes cuidado.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muy intrépido eres yendo al colegio en esa moto, y más aún después de pasar la\nnoche sin dormir.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0017",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0001",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001268",ch="ked"},
},
ja={
{
name={"Kei"},
"“Vamos, siempre dormía antes de montarla. Solo que no podía dormir tanto.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo dice el mismo idiota que se desmayó en la sala de arte...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="圭",size="z1",ex01="b0099",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0003",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001269",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, sí. Yo también me asusté ese día.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Te asustaste?! ¡¿Y qué crees que sentimos nosotros?!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0002",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001270",ch="ked"},
},
ja={
{
name={"Kei"},
"“Vamos, no me pasó nada grave a pesar de todo.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, pero toma más cuidado de ahora en adelante.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0001",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0003",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001271",ch="ked"},
},
ja={
{
name={"Kei"},
"“Está bien. Ah, no puedo esperar ya por la ceremonia.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí. Por cierto, la ceremonia es en Tokyo. Supongo que irás en tren, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0019",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001272",ch="ked"},
},
ja={
{
name={"Kei"},
"“Hmmm, no lo sé. Queda algo lejos para ir en moto, supongo.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No vengas con eso, ese scooter no da para tal viaje.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0013",head="kei_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001273",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ya te dije que no es un scooter.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0008",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0002",head="kei_z1b",lv=4,id=9},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0400",face="b0001",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001274",ch="ked"},
},
ja={
{
name={"Kei"},
"“Aunque... bueno, lo pensaré.\nArreglaré todo para irme en moto, eso sí.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aun así insistes con la moto?...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"msgoff"},
{"fg",mode=-2},
{"bg",file="zbluesky_spring",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Pasaron las semanas y llegó el invierno.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"El cielo de invierno es inmenso.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Las nubes son inalcanzables.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Regreso a mi habitación.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"A seguir estudiando.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Estas semanas las he gastado en puro pintar, y no he avanzado nada con los\nestudios.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="man_ked_001275",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Pueees bien! Creo que iré a jugar un poco más con el motor.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Kei se va de vuelta al fondo del patio. Seguramente va a hacerle mantenimiento\na la moto.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Qué vida tan fácil debe tener siendo con esa despreocupada actitud.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Cielos, con lo débil que llegó a estar es asombroso ver lo animado que se\nencuentra ahora.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Aunque bueno, es mejor así.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Levanto la mirada y veo hacia el lejano cielo.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"La Exposición Moore, eh...",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"La misma exposición a la cual Kenichiro Kusanagi aplicó tantas veces y falló.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Fue al perder lo más valioso para él que finalmente pudo obtener el premio\nmayor.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es fácil...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tan lejos podremos llegar con nuestro nivel actual?...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"ex",time=1500,func="wait"},
{"text"},
text={
ja={
{
"Finalmente llegó el día.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"El lugar de la ceremonia estaba repleto de periodistas y demás asociados.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=300000,file="zbg078f",path=":bg/",x2=0,y2=0,x=-960,y=0,ax=1920,ay=1347,bx=-960,by=-807,sync=0},
{"extrans",time=500},
{"bgm",file="bgm037"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001264",ch="aid"},
},
ja={
{
name={"Ai"},
"“Qué cantidad de gente...Se supone que no pueden entrar visitantes normales,\n¿no? ¿Tantos asociados hay así?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Y se ha corrido la noticia de que este año hay bastantes nominados\njaponeses.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue hace tres años que recibimos el Airain Loutre. Seguramente los medios\nvolverán a alborotarse de ganarse de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_aid_001265",ch="aid"},
},
ja={
{
name={"Ai"},
"“Hmmm, ya veo. Increíble.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="man_ksa_000001",ch="ksa"},
},
ja={
{
name={"Periodista A"},
"“Disculpaaa, soy Matsushita de la televisora ASO... Eres Naoya Kusanagi,\n¿verdad? ¡El hijo del famoso Kenichiro Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="man_ksb_000001",ch="ksb"},
},
ja={
{
name={"Periodista B"},
"“Vengo del periódico Sanei, ¿me permite una pregunta?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_ksc_000001",ch="ksc"},
},
ja={
{
name={"Periodista C"},
"“Eh-, soy Arimoto del Geijutsu Kodan. Hace un tiempo――”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg078f",path=":bg/",ax=960,ay=673,bx=0,by=-133,sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah-, tengo cosas que hacer, disculpen.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0013",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001266",ch="aid"},
},
ja={
{
name={"Ai"},
"“Eh, waaah.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"se",file="se9023",id=1},
{"fg",ch="藍",speed=3000,mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0013",head="aix_z1e",x2=0,x=-680,lv=4,id=9},
{"cgdel",id=-1},
{"bg",time=250,rule=280,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"Tomo a Ai de la mano y corro.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg077a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=280,time=300,vague=40},
{"se",stop=1,time=500,id=1},
{"fg",ch="藍",size="z1",mx=40,mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0013",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001267",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Espera, ¿por qué huyes?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No quiero que me entrevisten solo por haber sido nominado.Será horrible si el\npremio para en manos de alguien más...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001268",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eso crees? He escuchado que el solo ser nominado ya es algo de gran\nreconocimiento.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, pero...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001269",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Pues qué tiene de malo ser entrevistado entonces?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me gusta. Y siempre que leo lo que escriben, resulta ser algo completamente\ndistinto.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001270",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues en televisión entonces.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Peor aún en televisión. Odio mostrar mi cara en público, y a veces termino como\nun idiota después de la edición.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0015",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001271",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Tan malo es?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001272",ch="aid"},
},
ja={
{
name={"Ai"},
"“Para mí, que te entreviste alguien del periódico o la televisión es\nsencillamente increíble.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tan impresionante te parece?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001273",ch="aid"},
},
ja={
{
name={"Ai"},
"“Quiero decir, se supone que acá nada más pueden entrar personas asociadas a\neste mundo.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Exactamente.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001274",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero incluso personas como yo pueden entrar siendo invitadas por nominados,\ncomo tú. ¿No te parece increíble eso?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Exageras.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001275",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aunque en principio se supone que debí haber venido como invitada de Kei.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no paraba de insistir en venir en moto... Y no hay manera de saber a qué\nhora llegará, así que es difícil entrar como su invitado.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque al final no sabía realmente si venir en moto o tren.¿Por qué habrá\ninsistido tanto en venir en motocicleta?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001276",ch="aid"},
},
ja={
{
name={"Ai"},
"“Supersticiones suyas, seguramente...\nAl parecer Kenichiro-san también asistió a su ceremonia en esa motocicleta...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Esa motocicleta? ¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001277",ch="aid"},
},
ja={
{
name={"Ai"},
"“No importa, tranquilo. Ya quiero que comience la ceremonia.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004060",ch="mkd"},
},
ja={
{
name={"???"},
"“Yahoo~”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",lv=4,id=9},
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Eh?! ¿T-Toritani? ¿C-Cómo entraste acá?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0029",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004061",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jeje~n, le pedí el favor a alguien.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta no es la clase de lugar donde puedas entrar pidiendo favores...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",mode=-2},
{"fg",ch="フリッドマン",size="z1",mode=3,resize=1,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000287",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Yo la dejé entrar.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Fridmann?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0009",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000288",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Me recordó la ocasión en que cerró el restaurante para nosotros.\nMe dijo que había hecho una excepción muy rara y que quería compensación por eso.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004062",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Exactamente.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000289",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Por qué te me quedas viendo así, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás tramando algo?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="man_frd_000290",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿Por qué piensas eso?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No eres el tipo de persona capaz de dejarse llevar por las palabras de alguien como Toritani.\nPor eso pensé que tendrías algo en mente.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="man_frd_000291",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Eso no es cierto.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",x2=0,x=345,lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004013",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pero... ¿Habrá sido buena idea que yo también viniera?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rin, ¿tú también?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_004014",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí... Por alguna razón me dejaron entrar a mí también... No tengo ninguna\nrelación con este evento, y bueno... ¿Estará bien esto?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="man_frd_000292",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No hay problema. Sé que tienes una profunda relación con Kei Natsume y Naoya\nKusanagi, Rin Misakura. Quise que entraras a ver la ceremonia.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“......”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Este señor... ¿Será que dejó entrar a Toritani para que Rin viera la ceremonia?",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Habiendo, claramente, escuchado de Rin por parte del viejo.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué estarás pensando...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="man_frd_000293",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“¿De?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Has visto las pinturas de Rin?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="man_frd_000294",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Sí, le pedí el favor a esta señorita que me dejara verlas.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0003",head="mak_z1a",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0004",head="mak_z1a",x=345,lv=4,id=9},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004063",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, Fridmann-san me pidió que le mostrara las pinturas del club de arte de\nYumihari. Genial, ¿no? Tener al curador de la Fundación Moore viendo nuestros\ncuadros.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo los vio?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0004",head="mak_z1a",x=345,lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0010",head="mak_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004064",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ajaja... Fue un gran y rotundo 'no' previo a la ceremonia.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004015",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A mí me dijo que estudiara lo más básico, y me dio varios consejos.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",mode=-2},
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0003",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000295",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“No me pareció nada mal para ser cuadros de estudiantes.\nAunque lamentablemente la Exposición Moore es algo de otro nivel.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004065",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero tanto Kusanagi como Kei tienen posibilidades de ser premiados, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0002",head="fri_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0008",head="fri_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000296",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Han sido nominados, solo eso. Solo observa a los demás artistas nominados y\ndime si puedes estar tan confiada aún.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004066",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Ni la misma Toritani pudo evitar quedarse en silencio.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Era de esperarse.\nLa verdad es que nuestra profesión y edad resalta demasiado.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Todos los demás son artistas del más alto nivel.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000297",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“... Por cierto, ¿qué ha pasado con Kei Natsume?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, debería estar en camino hacia acá...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0007",head="fri_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_frd_000298",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Hmm, qué raro... Le había pedido que viniera temprano... Naoya, ¿por qué no\nvinieron juntos?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo no sé, insistió en venir en motocicleta y no me prestaba atención...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0007",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000299",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Motocicleta, eh... No debería haberle afectado tanto el tráfico...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="フリッドマン",size="z1",mode=3,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_frd_000300",ch="frd"},
},
ja={
{
name={"Fridmann"},
"“Solo por si acaso le pediré al personal que investiguen...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"se",file="se9012",id=1},
{"fg",ch="フリッドマン",mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Al decir eso, Fridmann se marchó a pasos rápidos.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Tiene razón, ya debería haber llegado... ¿Qué diablos está haciendo Kei?",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmph...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0012",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004067",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Traje formal, eh. Y además, esmoquin.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues veo que ustedes vinieron vestidas como siempre.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004068",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Yo no gané nada, no debería haber problema con que venga en uniforme, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te recuerdo que es la grandiosa ceremonia de premiación de la Fundación Moore,\nlo normal sería venir en traje formal.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0008",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004069",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Pero no tengo ningún traje formal.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004016",ch="rnd"},
},
ja={
{
name={"Rin"},
"Sí, ninguna chica de nuestra edad tiene traje formal.Aunque veo que tú sí\ntienes un esmoquin, Kusanagi-kun.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0012",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004070",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Se ve bastante caro, ¿lo compraste solo para esta ocasión?",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"Para nada, fueron los de Moore los que me prepararon este traje.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0013",head="mak_z1d",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_004071",ch="mkd"},
},
ja={
{
name={"Makoto"},
"¿Eh? ¿Es en serio?",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, me dijeron que habían preparado un traje para mí y pidieron que llegara\ntemprano.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0012",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0003",head="mak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_004072",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Ya veo. Vaya, pues no esperaba menos para un artista nominado.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, y te recuerdo que solo nominado.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0002",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0004",head="mak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_004073",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Lo sé, pero ambos fueron nominados, ¿no?Quizá no sea absurda la idea de que\nalguno de los dos gane.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"Los profesionales de verdad se enojarán si te escuchan decir eso.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"Y ha sido tal el escándalo que han hecho que los peces gordos nos están viendo\nahora...",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0013",head="mak_z1d",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0011",head="mak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_004074",ch="mkd"},
},
ja={
{
name={"Makoto"},
"¿Eh? ¿D-De verdad?",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004017",ch="rnd"},
},
ja={
{
name={"Rin"},
"Pero, si llegaras a ganar sería impresionante. Pasarías de ser la celebridad de\nYumihari a un ídolo nacional, Kusanagi-kun.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0003",head="mak_z1d",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004075",ch="mkd"},
},
ja={
{
name={"Makoto"},
"No, no, alguien galardonado en la Exposición Moore no termina como un simple\nídolo nacional, se convierte en artista de renombre internacional.Los cuadros\nde los galardonados siempre venden a precios altísimos.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004018",ch="rnd"},
},
ja={
{
name={"Rin"},
"Es increíble. Podrías terminar ganando.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"Solo son posibilidades, nada más.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001278",ch="aid"},
},
ja={
{
name={"Ai"},
"Volviendo al tema, Kei se está tardando mucho.Lo llamé, pero no contesta.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"Si está manejando no podrá escuchar el sonido del celular.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001279",ch="aid"},
},
ja={
{
name={"Ai"},
"Lo sé, pero he estado tratando de llamarlo desde que salió en la mañana.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya veo... ¿Qué le habrá pasado?",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg077e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Las luces en el auditorio se fueron apagando.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya está por comenzar. Deberíamos sentarnos.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001280",ch="aid"},
},
ja={
{
name={"Ai"},
"Tienes razón.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"Me toca sentarme en la primera fila. Ustedes siéntense en los asientos de\ninvitados.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001281",ch="aid"},
},
ja={
{
name={"Ai"},
"Bueno, está bien.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Me siento en la primera fila.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"El lugar más indicado para entrar rápidamente a los hombros del escenario.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Apenas nos sentamos comenzaron los anuncios.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"De que comenzaría la ceremonia.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Y de que este año habían galardonados japoneses.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"El auditorio se animó ante la noticia.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Y después que se anunciara que eran dos, el tumulto fue aun mayor.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Exceptuando los de la primera fila, quienes se quedaron contemplando el\nescenario sin hacer un solo movimiento.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Como era de esperarse, supongo...",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"La fila de los nominados estaba repleta de rostros prominentes.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"El hombre sentado al fondo es la actual autoridad del pop art, Kiyohiko\nMurata...",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"Tiene obras en exhibición en el museo de arte moderno de Nueva York y el\ncontemporaneo de Los Angeles. El año pasado salió en las noticias por haber\nrecibido el premio al arte del ministerio de educación y cultura.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Su historial y habilidad están a un nivel mucho más alto que el mío.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"A su lado está Shouzou Sakamoto.Este también trabaja principalmente en el\nexterior, y fue seleccionado como uno de los cien artistas más influyentes\npor la revista artística Écrits.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"No es muy conocido en Japón, pero si en la escena artística internacional.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"La habilidad de estos dos es tal que se hace raro que no hayan ganado\nanteriormente en la Exposición Moore.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"También está Mudou Sakamichi, experto en pintura japonesa.Lo suyo no es el arte\nmoderno, sino la pintura japonesa clásica, y ha presentado exposiciones\nindividuales en otros países.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"Finalmente está Jiro Hidaka, del género pop-art. Se dice que sus cuadros son\nsiempre creados desde un punto de vista único en su estilo.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Su pop-art es extremadamente teórico e ideológico.Ahora debe estar trabajando\ncomo profesor invitado en la universidad de California, campus de Los\nÁngeles.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Y a su lado estoy yo, Naoya Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"La verdad es que me siento algo intimidado estando entre tantas figuras\neminentes.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"Además que el más joven de todos es Shouzou Sakamoto, con un poco más de\ntreinta años... Los demás están en sus cuarenta, o cincuenta. Siendo el único\nmenor de veinte años, se siente bastante íncomodo.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"No había podido creer que llegué aquí, y estando acá sentado me lo recuerda.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"Al otro extremo está el único asiento vacío.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
"Todavía sin nadie sentado ahí.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"El lugar donde Kei Natsume debería estar sentado.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"Y ahora que lo pienso...",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"De verdad... ¿Qué demonios estará haciendo?",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg077a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"El auditorio se oscureció.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Una mujer que he visto en la televisión anuncia que servirá de conductora.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"Después de terminar de ver, la autoridad actual del pop-art, Kiyohiko Murata,\nse paró.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Después le siguió Shouzou Sakamoto, dirigiéndose juntos afuera.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Ambos ganaron?",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"¿Será que se dirigen al hombro del escenario?",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
"Reviso mi reloj.",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
"Todavía quedaba algo de tiempo para el anuncio de los ganadores, así que decidí\nseguirlos.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"bg",file="ev_com_i06_01",path=":ev/ev_com_i06/",set="ev_com_i06"},
{"text"},
text={
ja={
{
"Y lo que me encontré fue simplemente el cuarto para fumadores.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
"Al parecer Kiyohiko Murata y Shouzou Sakamoto se conocían. Estaban los dos\nfumando con gusto.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"bg",file="ev_com_i06_02",sync=0,face=1,time=400,path=":ev/ev_com_i06/",set="ev_com_i06"},
{"text"},
text={
vo={
{"vo",file="man_mrt_000001",ch="mrt"},
},
ja={
{
name={"Murata"},
"¿Oh? ¿Qué sucede, jovencito?",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"Parece que me descubrieron siguiéndolos.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ah, no... Nada en particular...",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="man_skm_000001",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"¿Nos viste parándonos antes de tiempo y pensaste que iríamos a la parte trasera\ndel escenario?¡Estos dos deben haber ganado! ¿Algo así?",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Ambos saben quién ganó?",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"bg",file="ev_com_i06_01",sync=0,face=1,time=400,path=":ev/ev_com_i06/",set="ev_com_i06"},
{"text"},
text={
vo={
{"vo",file="man_skm_000002",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Sí, lo sabemos.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="man_skm_000003",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Al parecer Murata ganó.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="man_mrt_000002",ch="mrt"},
},
ja={
{
name={"Murata"},
"Aún no se ha anunciado, así que no vayas a decirle a nadie.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿De verdad? ¿Cuál premio ganó?",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="man_mrt_000003",ch="mrt"},
},
ja={
{
name={"Murata"},
"Según escuché, es posible que haya sido el Airain Phoque.Ningún japonés lo ha\nganado, así que podría captar bastante atención pública.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
name={"Naoya"},
"Usted es Kiyohiko Murata. No me extrañaría que reciba el Airain Phoque.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
vo={
{"vo",file="man_mrt_000004",ch="mrt"},
},
ja={
{
name={"Murata"},
"¿Eso crees? Me pones en una situación difícil diciéndome eso.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Por qué?",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="man_mrt_000005",ch="mrt"},
},
ja={
{
name={"Murata"},
"He estado pensando en retirar mi nominación al Airain Phoque.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Va a retirar su nominación?",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="man_mrt_000006",ch="mrt"},
},
ja={
{
name={"Murata"},
"Sí, la verdad es que quisiera ir por un premio mayor.",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
vo={
{"vo",file="man_skm_000004",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Ya dos japoneses han obtenido el Argent Daufin de Londres y el Platine Epaulard\nde Nueva York.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
vo={
{"vo",file="man_skm_000005",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Pero ninguno ha ganado el Or Baleine de París.¿A quién no le encantaría\nganarlo?",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
vo={
{"vo",file="man_mrt_000007",ch="mrt"},
},
ja={
{
name={"Murata"},
"Sí, por algo dicen también que el Or Baleine es el premio más puro, con menos\ntinte político.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Tinte político?",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
vo={
{"vo",file="man_skm_000006",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"No se cruzan tantos intereses, poniéndolo de manera simple. El Platine Epaulard\ny el Argent Daufin mueven mucho dinero, y a la vez intereses.Por eso se dice\nque tienen tinte político.",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
vo={
{"vo",file="man_mrt_000008",ch="mrt"},
},
ja={
{
name={"Murata"},
"En ese sentido no es difícil ver por qué Kenichiro Kusanagi ganó el Platine\nEpaulard, o Hakai Miyazaki el Argent Daufin...",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
vo={
{"vo",file="man_mrt_000009",ch="mrt"},
},
ja={
{
name={"Murata"},
"Desde hace tiempo Kusanagi ha tenido una fuerte conexión con la Fundación\nMoore, mientras que Miyazaki nació en Japón, pero ha vivido desde pequeño en\nGran Bretaña, y ha pasado su vida artística en Londres.",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
vo={
{"vo",file="man_skm_000007",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Cada uno representó muy bien a ambas ciudades como artista, se podría decir.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
vo={
{"vo",file="man_mrt_000010",ch="mrt"},
},
ja={
{
name={"Murata"},
"De igual forma, no cabe en duda que ambos han sido grandes genios.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
vo={
{"vo",file="man_skm_000008",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Murata, ya llevas más de diez años de haber abierto tu taller en el exterior,\n¿no?",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
vo={
{"vo",file="man_mrt_000011",ch="mrt"},
},
ja={
{
name={"Murata"},
"Sí, y me parece que he acumulado una buena porción de experiencia\ninternacional, pero mira nada más. Sigo sin poder salir del Airain Phoque.",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
vo={
{"vo",file="man_skm_000009",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"¿Pero qué andas diciendo? El solo ser premiado en la Exposición Moore es un\ngran logro. Solo han habido seis ganadores en estos sesenta años de su\nhistoria.",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
vo={
{"vo",file="man_mrt_000012",ch="mrt"},
},
ja={
{
name={"Murata"},
"Cincuenta y cuatro años sin ningún ganador japonés, hasta hace poco. Aunque\npodrías decir que eso prueba lo cerrado que ha sido el mundo artístico\njaponés.",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
"Pues, de que es verdad, es verdad...",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
vo={
{"vo",file="man_mrt_000013",ch="mrt"},
},
ja={
{
name={"Murata"},
"Por cierto, tú eres Naoya Kusanagi, ¿verdad?",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ah, sí...",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
vo={
{"vo",file="man_skm_000010",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Claro, ya me preguntaba por qué había un niño en la fila. Así que se trataba de\nKusanagi junior, eh. Eres famoso, ¿sabías?",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
vo={
{"vo",file="man_skm_000011",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Vi el cuadro que pintaste de niño, 'Fantasía de un día de cerezos'. Es un buen\ncuadro, no me parecio algo que pudiera pintar un crío.",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
name={"Naoya"},
"Muchas gracias.",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
vo={
{"vo",file="man_skm_000012",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Aunque la verdad no me pareció una obra digna de ser nominada por Moore...",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
vo={
{"vo",file="man_mrt_000014",ch="mrt"},
},
ja={
{
name={"Murata"},
"Han pasado años desde entonces, sus cuadros deben ser mucho mejores ahora.Y fue\nnominado de la misma manera que nosotros, así que debe ser un muy buen cuadro\nel que presentó.",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
vo={
{"vo",file="man_skm_000013",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Ah, claro, dos o tres años no son nada para nosotros, pero a su edad es\nbastante, eh.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
vo={
{"vo",file="man_mrt_000015",ch="mrt"},
},
ja={
{
name={"Murata"},
"Te equivocas, creo que fue hace seis años.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
vo={
{"vo",file="man_skm_000014",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"¿Eh? No me jodas, ¿tanto tiempo ha pasado?",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
vo={
{"vo",file="man_skm_000015",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Ya veo, sí. Obviamente sus cuadros deben ser completamente distintos ahora.",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
vo={
{"vo",file="man_mrt_000016",ch="mrt"},
},
ja={
{
name={"Murata"},
"¿Realmente lo será?... ¿Será un cuadro lo suficientemente bueno para ser\nnominado?",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
name={"Naoya"},
"Con esa intención lo pinté...",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
vo={
{"vo",file="man_skm_000016",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Uheeeh, se siente raro que alguien de esa edad hable de esa forma...Solo digo,\nen mi caso llevo más de diez años en esto.",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
vo={
{"vo",file="man_mrt_000017",ch="mrt"},
},
ja={
{
name={"Murata"},
"Seguramente su cuadro tiene tanto valor como toda tu experiencia artística.",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"bg",file="ev_com_i06_03",sync=0,face=1,time=400,path=":ev/ev_com_i06/",set="ev_com_i06"},
{"text"},
text={
vo={
{"vo",file="man_skm_000017",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Jaa... eso sería increíble. Aunque bueno, según he escuchado te dieron un\nentrenamiento bastante fuerte desde pequeño.",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
vo={
{"vo",file="man_mrt_000018",ch="mrt"},
},
ja={
{
name={"Murata"},
"'Fantasía de un día de cerezos' es famosa acá, pero en Nueva York la exposición\nde padre e hijo de Kenichiro Kusanagi salió incluso en las noticias. Parece\nque una señora compró tu cuadro por ochocientos mil yenes...",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
vo={
{"vo",file="man_skm_000018",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Ha sido la venta más cara para esa edad, al parecer. Todo un prodigio, sin duda\nalguna.",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
name={"Naoya"},
"Esa exposición fue de mi padre, sucede que mi obra fue presentada allí también\ny casualmente también subió de valor...",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
vo={
{"vo",file="man_mrt_000019",ch="mrt"},
},
ja={
{
name={"Murata"},
"Ojalá haya sido eso.",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"bg",file="ev_com_i06_04",sync=0,face=1,time=400,path=":ev/ev_com_i06/",set="ev_com_i06"},
{"text"},
text={
vo={
{"vo",file="man_skm_000019",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Me pondré a llorar si este muchachito me quita el premio.",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
vo={
{"vo",file="man_mrt_000020",ch="mrt"},
},
ja={
{
name={"Murata"},
"Pues llora tanto como quieras. Ninguno de nosotros te consolaremos.",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"bg",file="ev_com_i06_05",sync=0,face=1,time=400,path=":ev/ev_com_i06/",set="ev_com_i06"},
{"text"},
text={
vo={
{"vo",file="man_skm_000020",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Qué frío, eh. Demonios, claro, si ya tu tienes un premio asegurado.",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
vo={
{"vo",file="man_mrt_000021",ch="mrt"},
},
ja={
{
name={"Murata"},
"Por cierto, acaban de mencionar que hay dos ganadores de Japón, ¿cierto? Pues\nparece que el otro recibirá el Airain Otarie.",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"bg",file="ev_com_i06_01",sync=0,face=1,time=400,path=":ev/ev_com_i06/",set="ev_com_i06"},
{"text"},
text={
vo={
{"vo",file="man_skm_000021",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"El premio de mayor rango dentro de la categoría de cobre, eh.¿Quién fue?",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
vo={
{"vo",file="man_mrt_000022",ch="mrt"},
},
ja={
{
name={"Murata"},
"Pues, resulta que no se ha escapado información alguna al respecto.",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
vo={
{"vo",file="man_skm_000022",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"¿Por qué será eso? Ya a este punto alguno de la industria debería haberse\nenterado...",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
vo={
{"vo",file="man_mrt_000023",ch="mrt"},
},
ja={
{
name={"Murata"},
"Quizá aún no logran decidir.",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
vo={
{"vo",file="man_skm_000023",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"¿Llegado a este punto y no deciden aún? No puede ser.Ahhh, de igual manera\nespero ser el afortunado.",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
name={"Naoya"},
"Las probabilidades son altas para alguien como usted, señor Sakamoto.",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"bg",file="ev_com_i06_06",sync=0,face=1,time=400,path=":ev/ev_com_i06/",set="ev_com_i06"},
{"text"},
text={
vo={
{"vo",file="man_skm_000024",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Pero no he recibido notificación alguna...",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
vo={
{"vo",file="man_mrt_000024",ch="mrt"},
},
ja={
{
name={"Murata"},
"En fin, creo que deberíamos regresar ya. Ya es hora de que muestren nuestras\nobras.",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"bg",file="ev_com_i06_01",sync=0,face=1,time=400,path=":ev/ev_com_i06/",set="ev_com_i06"},
{"text"},
text={
vo={
{"vo",file="man_skm_000025",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Sí, tienes razón. Ya deben estar por terminar.",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Por terminar?",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
vo={
{"vo",file="man_skm_000026",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Ah, cosas nuestras. Demonios, ¿quién necesita una exhibición? Deberían entregar\nlos premios y ya.",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
vo={
{"vo",file="man_mrt_000025",ch="mrt"},
},
ja={
{
name={"Murata"},
"Vamos, no digas eso.Es la primera ceremonia de premiación en tres años, hay que\ndisfrutar el momento.",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"bg",file="ev_com_i06_03",sync=0,face=1,time=400,path=":ev/ev_com_i06/",set="ev_com_i06"},
{"text"},
text={
vo={
{"vo",file="man_skm_000027",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Pues bastante tienes por disfrutar tú que has ganado. En mi caso, creo que ni\nsiquiera debí haber venido.",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
vo={
{"vo",file="man_mrt_000026",ch="mrt"},
},
ja={
{
name={"Murata"},
"¿Por qué?",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"bg",file="ev_com_i06_05",sync=0,face=1,time=400,path=":ev/ev_com_i06/",set="ev_com_i06"},
{"text"},
text={
vo={
{"vo",file="man_skm_000028",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"El golpe será fuerte si no recibo el premio.",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"text"},
text={
vo={
{"vo",file="man_skm_000029",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Además que tenemos al Kusanagi junior en la competición. ¿Qué voy a hacer si\neste crío se lleva el premio?",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
vo={
{"vo",file="man_mrt_000027",ch="mrt"},
},
ja={
{
name={"Murata"},
"Eso dependerá de quien sea el mejor.",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"bg",file="ev_com_i06_06",sync=0,face=1,time=400,path=":ev/ev_com_i06/",set="ev_com_i06"},
{"text"},
text={
vo={
{"vo",file="man_skm_000030",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Qué deprimente esto.",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
vo={
{"vo",file="man_skm_000031",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Y además, el bufé del hotel en la fiesta posceremonia no es muy bueno.",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
vo={
{"vo",file="man_mrt_000028",ch="mrt"},
},
ja={
{
name={"Murata"},
"¿Ya estás en plan de fiesta?... Aunque bueno, no niego que todo lo del bufé me\nsabe a comida recalentada. Es difícil decisión.",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"bg",file="ev_com_i06_05",sync=0,face=1,time=400,path=":ev/ev_com_i06/",set="ev_com_i06"},
{"text"},
text={
vo={
{"vo",file="man_skm_000032",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Definitivamente. Vamos, ¿qué artista come en ese tipo de lugar? ¿Es que acaso\nnos creen animales capaces de comer cualquier cosa?",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
vo={
{"vo",file="man_mrt_000029",ch="mrt"},
},
ja={
{
name={"Murata"},
"Estás exagerando...",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"bg",file="ev_com_i06_07",sync=0,face=1,time=400,path=":ev/ev_com_i06/",set="ev_com_i06"},
{"text"},
text={
ja={
{
"Murata aplasta su cigarro en el cenicero.",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
vo={
{"vo",file="man_mrt_000030",ch="mrt"},
},
ja={
{
name={"Murata"},
"Pues bien, ¿vamos a ver quién se gana el Airain Otarie?",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
vo={
{"vo",file="man_skm_000033",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Sí, ya deben haber comenzado a exhibir las obras.",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
vo={
{"vo",file="man_mrt_000031",ch="mrt"},
},
ja={
{
name={"Murata"},
"Vamos entonces...",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
vo={
{"vo",file="man_mrt_000032",ch="mrt"},
},
ja={
{
name={"Murata"},
"Ah, lo olvidaba. Tengo algo que debo decirte, Naoya Kusanagi-kun.",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Sí?",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
vo={
{"vo",file="man_mrt_000033",ch="mrt"},
},
ja={
{
name={"Murata"},
"El señor Kenichiro me ayudó bastante en Nueva York.Fue un gran artista.",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
vo={
{"vo",file="man_mrt_000034",ch="mrt"},
},
ja={
{
name={"Murata"},
"Su muerte fue una gran perdida para la comunidad artística de Japón.",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
vo={
{"vo",file="man_skm_000034",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Eso cambiará si llega a surgir una nueva estrella.",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
vo={
{"vo",file="man_mrt_000035",ch="mrt"},
},
ja={
{
name={"Murata"},
"No hay artista actual que pueda superar a Kenichiro Kusanagi y a Hakai\nMiyazaki. El impacto de esos dos fue enorme.",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
vo={
{"vo",file="man_skm_000035",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Pues sí, ninguno de nosotros puede negar eso.",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
vo={
{"vo",file="man_mrt_000036",ch="mrt"},
},
ja={
{
name={"Murata"},
"Por eso pienso que quizá en unos años, serán artistas nuevos como tú los que\nempujarán la pintura japonesa.",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Yo? No lo creo, la verdad.",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
vo={
{"vo",file="man_mrt_000037",ch="mrt"},
},
ja={
{
name={"Murata"},
"Quién sabe...",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
vo={
{"vo",file="man_mrt_000038",ch="mrt"},
},
ja={
{
name={"Murata"},
"La Exposición Moore se rige por muchos intereses, sobre todo políticos. Hay la\nposibilidad de que estén buscando una nueva generación de artistas.",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"text"},
text={
ja={
{
name={"Naoya"},
"Imposible, y aun si fuera así no tengo casi experiencia real.",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
vo={
{"vo",file="man_mrt_000039",ch="mrt"},
},
ja={
{
name={"Murata"},
"Yo también espero que no sea así. Pondré todo mi esfuerzo para que tu\ngeneración no termine hundiendo a la nuestra.",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
ja={
{
name={"Naoya"},
"Eso es algo exagerado...",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
vo={
{"vo",file="man_mrt_000040",ch="mrt"},
},
ja={
{
name={"Murata"},
"¿Te parece? Yo también espero que termine solo en exageración...",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
vo={
{"vo",file="man_skm_000036",ch="skm"},
},
ja={
{
name={"Sakamoto"},
"Deberíamos ir ya.",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"text"},
text={
vo={
{"vo",file="man_mrt_000041",ch="mrt"},
},
ja={
{
name={"Murata"},
"Tienes razón.",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"text"},
text={
ja={
{
name={"Naoya"},
"Vayamos...",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"bgm",stop=1,time=1000},
{"excall",file="05_the_happy_prince_07_2"},
{"text"},
linkback="block_00352",
},
label = {
top={block="block_00000",label=1},
},
}
