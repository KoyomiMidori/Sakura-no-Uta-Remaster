astver = 2.0
astname = "ast"
ast = {
block_00000={
{"fg",mode=-2,sync=0},
{"bg",file="bg018f",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1b0100",face="b0005",head="mak_z1b",x=345,lv=4,id=6,sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",x=-345,lv=4,id=5,sync=0},
{"extrans",time=0},
{"text"},
text={
ja={
{
"Fui degradado de hombre ero-contaminado a protagonista animal violador\nero-contaminado.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Vaya que he evolucionado bastante en un día, eh.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_yum_000626",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Qué están haciendo?! ¡Toritani-senpai, ven rápido tú también! ¡Rápido, a los\nvestidores!”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Se escucha una voz desde lejos.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001326",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Supongo que ya gastamos mucho tiempo acá, deberíamos ir con las demás.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001327",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, cierto. Aún no he terminado de presentarme. Yo soy Makoto Toritani, la jefa\ndel club de arte del colegio Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0003",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000351",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“He escuchado acerca de ti. Yo soy Shizuku Natsume. Tal como lo mencionaste hace\nun momento, mi nombre artístico es Kuzuka Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0004",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001328",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, ¿vamos juntos entonces?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1d1000",face="d0004",head="shz_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000352",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, con todo gusto.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="bg017a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-570,lv=4,id=3,sync=0},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004i",head="yum_z1b",x=570,lv=4,id=4,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=0,lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm007"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000627",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Veamos, ¿qué traje de baño les quedará mejor a las dos? Jaa, jaa, jaa... *traga\nsaliva*.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000890",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yuumi-chan, elige el tuyo también, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000628",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, ¿yo? Ah, este está bien. Me iré por este.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0015",head="rna_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000294",ch="rna"},
},
ja={
{
name={"Rina"},
"“No lo tomes del carrito sin siquiera verlo...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0002",head="yum_z1b",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_yum_000629",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Encontré uno bueno en el carrito, no hay problema. Más importante que eso\nahora, Rina, ¡Rina, este traje de baño de corte alto tan peligrosamente\npegado y pequeño es perfecto para ti!”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0006",head="rna_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000295",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si tanto me lo recomiendas entonces póntelo tú.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000630",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Yo?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=0,lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000296",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, tú misma lo recomendaste, ¿no, Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0018",head="yum_z1b",x=570,lv=4,id=4},
{"fgact",ch="優美",act="いいえ",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_yum_000631",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Mmm, ¿entonces si me lo pongo tú también te lo pondrás? ¿Te lo pondrás? ¿Aun si\nse trata de este traje que parece hecho de hilos o que más bien es un simple\nhilo? ¿Aun así te lo pondrás? ¿Te lo pondrás por mí, Rina?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0015",head="rna_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000297",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Pero qué tan empeñada estás?...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="稟",mode=-1,lv=4,id=3},
{"fg",ch="真琴",size="z1",mx=-40,mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001329",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que es mejor uno blanco.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_yum_000632",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Has dado con un muy buen punto, Toritani-senpai. ¡Pero lamentablemente, la gran\nmayoría de los trajes de baño blancos no se traslucen al mojarse! ¡Los han\nhecho tan impenetrables que no se traslucen para nada! Así que me parece más\nrecomendable este traje de baño de hilo.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_001330",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, no me refería a eso... sino que parece que Kusanagi prefiere los trajes de\nbaño blancos.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0006",head="yum_z1a",x=570,lv=4,id=4},
{"fgact",ch="優美",act="びっくり",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0015",head="yum_z1a",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_yum_000633",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Jaa! ¿Kusanagi los prefiere blancos? ¡Pero qué novato, eh! Por no saber que no\nse traslucen aún al mojarse es que deliras sin control y te excitas, ¿verdad?\n¡Nada sorprendente viniendo de un virgen!”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no. Mi gusto por los trajes de baño blancos no es por esa razón tan\nsucia.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000634",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Entonces cuál es la razón?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm, porque parecen panties, ¿tal vez?...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0007",head="rna_z1d",x=0,lv=4,id=9},
{"fgact",ch="里奈",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0006",head="rna_z1d",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rna_000298",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Es bastante, suficientemente sucia esa razón!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, solo bromeaba. En primer lugar, eso de que me gustan los trajes de baño\nblancos es solo un invento.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",mode=-2},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000353",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, quizás simplemente fue pura casualidad que el traje de baño que yo llevaba\nen esa revista era blanco. Pero ¿qué trajes de baño te gustan entonces,\nNaoya?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm, cuáles me gustarán...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000635",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Kusanagi, apártate un momento!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="優美",size="z1",mx=40,mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=570,lv=4,id=4},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Uwaah!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0012",head="shz_z1b",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000354",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0013",head="yum_z1b",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000636",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿--?!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="里奈",size="z1",mx=-40,mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0013",head="rna_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000299",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? E-Esta chica.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_yum_000637",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Esta señorita es... será posible que...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001331",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. ¿Sorprendida?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_000638",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“P-Pues, obviamente...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0012",head="rna_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_rna_000300",ch="rna"},
},
ja={
{
name={"Rina"},
"“Había escuchado que la hermanita de Kei-senpai era una artista, pero, de verdad\nlo era... Y además, se trata de Kuzuka Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1d1000",face="d0003",head="shz_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000355",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Mucho gusto, soy Shizuku Natsume, la hermanita de Kei Natsume.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"excall",file="02_abend_09a",cond="f.makroute==1"},
{"excall",file="02_abend_09a",cond="f.rnaroute==1"},
