},
block_00085={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002367",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Tanto como para masturbarte pensando en él?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002451",ch="rna"},
},
ja={
{
name={"Rina"},
"“Q-Que alguien me guste, no implica que haga eso, ya te lo dije.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0009",head="yum_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002368",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Quieres decir que una cosa no tiene que ver con la otra? ¿Qué piensas al\nrespecto, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pueees, sí quisiera que lo hiciera pensando en mí, si es que realmente le\ngusto.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0006",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002452",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Q-Q-Qu, qué hay de ti entonces, senpai?!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo? ¡Recordando los besos de ayer me eché una corrida antes de dormir, y dos\nal despertarme!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002453",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ugh... ¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y... regresando al tema anterior... S-Sí, desde ayer no he podido verte a los\nojos...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002454",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, es que... me da algo de pena, ajaja.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002369",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Virgen después de todo, no esperaba menos.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0012",head="yum_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002370",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Déjame ponerlo de esta manera entonces, Rina. ¿No sentiste nada ayer?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0014",head="rna_z1d",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_002455",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Eeehhhh? ¿Q-Q-Qué quieres d-decir con, s-sentir?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0015",head="yum_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002371",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Un impulso por dentro que jamás habías sentido antes.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0014",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="うんうん",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_002456",ch="rna"},
},
ja={
{
name={"Rina"},
"“N-No tengo ningún impulso, ni nada de eso. Estoy completamente bien.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_rld_000047",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Pero el 'Jaa, jaa' de ayer fue muy diferente al de siempre. Más que 'Jaa, jaa',\nse escuchaba como 'ahhn'.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0006",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002457",ch="rna"},
},
ja={
{
name={"Rina"},
"“Espera, Ruriwo-san, ¿cómo es que también puedes escuchar todo lo que ocurre en\nmi habitación?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_rld_000048",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Las paredes son delgadas, ¿recuerdas? Escuché también algo parecido a un\nchapoteo. Un sonido húmedo.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0013",head="yum_z1a",x=345,lv=4,id=4},
{"fgact",ch="優美",act="びっくり",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002372",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Es... eso... cierto?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002458",ch="rna"},
},
ja={
{
name={"Rina"},
"“E-Es que, yo...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002459",ch="rna"},
},
ja={
{
name={"Rina"},
"“Después, de que pasara eso, yo...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿En fin, sí o no?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002460",ch="rna"},
},
ja={
{
name={"Rina"},
"“N-No sé si a eso se le puede llamar masturbarse o no. Pero, comencé a pensar en\nti, y...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0011",head="yum_z1a",x=345,lv=4,id=4},
{"fgact",ch="優美",act="びっくり",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002373",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0009",head="yum_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002374",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Iré a masturbarme!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Y-Yo también!”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0007",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002461",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Ustedes dos son unos idiotas!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0011",head="yum_z1a",x=345,lv=4,id=4},
{"fgact",ch="優美",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002375",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Es que, me imaginé el sonido con lo de los chapoteos, y...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Igual yo, si no me inclino un poco se verá lo de abajo.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0003",head="yum_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002376",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sale y vale, Kusanagi y yo regresaremos en 10 minutos.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No necesito tanto tiempo.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0015",head="yum_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002377",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vaya eyaculador precoz, eh. Aunque bueno, tengo que decir que con 10 minutos me\npuedo correr 10 veces.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0006",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002462",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Esperen, tontos!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002463",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kusanagi-san, p-por si no lo recuerdas, yo soy tu novia... N-No quiero que\nestés masturbándote una y otra vez por algo así...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Un hombre no puede masturbarse si tiene novia?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=345,lv=4,id=4},
{"fgact",ch="優美",act="うんうん",time=200,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",x=345,lv=4,id=4},
{"fgact",ch="優美",act="びっくり",time=300,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_yum_002378",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así es, así es. Si tienes novia no te puedes masturbar, idiota~ ¡Disfruta todo\nel resto de vida que te queda en sana abstinencia!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No podría aguantarlo!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0006",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002464",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡No digas eso!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002465",ch="rna"},
},
ja={
{
name={"Rina"},
"“P-Por favor, no digas eso. Y-Yo me encargaré, de ayudar, cuando no puedas\naguantar más... así que--”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0009",head="yum_z1a",x=345,lv=4,id=4},
{"fgact",ch="優美",act="びっくり",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002379",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0015",head="yum_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002380",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Uaah, malditos normies! ¡No los soporto!”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0018",head="yum_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002381",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Perdí mi tiempo viniendo acá! ¡Ruriwo-chan, vayamos al baño, te enseñaré como\nmasturbarte!”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"mwact",act="うなづく"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000049",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Bueno.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0006",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002466",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Espera un segundo!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002382",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo bromeaba. Y ya lo había notado antes, pero ¿no es raro que llames\nKusanagi-san a Kusanagi siendo él tu novio?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002467",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0003",head="yum_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002383",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si Kusanagi te llama Rina, ¿no deberías llamarlo Naoya-san a él?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002468",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿N-Naoya... san?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0004",head="yum_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002384",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es lo único que me quedaba por decir~ ¡Vale vale, Rurio-chan, vayamos a mi casa\na jugar Maryo Kart! Creo que Suzuna también está allá.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="里奈",mode=-1,lv=4,id=5},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0003",head="rur_z1i",x=-345,lv=4,id=5},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000050",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¡Vamos!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0003",head="yum_z1a",x=345,lv=4,id=4},
{"fgact",ch="優美",act="うなづく",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_yum_002385",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bueno bueno muchachos~, nos vemos~, disculpen la intromisión~ ¡Bien, vamos a\njugar!”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bgm",stop=1,time=1000},
{"se",file="se9004",id=1},
{"msgoff"},
{"fg",ch="優美",mx=40,mode=-1,lv=4,id=4,sync=0},
{"fg",ch="ルリヲ",mx=40,mode=-1,lv=4,id=5,sync=0},
{"extrans",time=500,sync=1},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Ambas se fueron de la azotea, hablando y divirtiéndose.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",lv=4,id=5},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
"Y entonces, quedamos los dos solos.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002469",ch="rna"},
},
ja={
{
name={"Rina"},
"“A-A qué habrán venido finalmente esas dos, ¿eh?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cambiando un poco de tema... ¿Tendré que abstenerme de masturbarme de ahora en\nadelante?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002470",ch="rna"},
},
ja={
{
name={"Rina"},
"“C-Claro que no. Puedes hacerlo cuando quieras.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Está bien, iré un momento al baño entonces!”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0009",head="rna_z1b",lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002471",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡E-Espera, espera un momento!”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2b0110",face="b0008",head="rna_z2b",lv=5,id=5},
{"fgact",ch="里奈",act="うなづく",lv=5,id=5},
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Rina agarra mi mano.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0110",face="b0011",head="rna_z2b",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002472",ch="rna"},
},
ja={
{
name={"Rina"},
"“No voy a permitir que lo hagas solo.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0110",face="b0009",head="rna_z2b",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002473",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿P-Por qué tanto silencio?!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No, bueno, solo que no sé qué debería responder...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0110",face="b0010",head="rna_z2b",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002474",ch="rna"},
},
ja={
{
name={"Rina"},
"“No hace falta que lo hagas...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0110",face="b0009j",head="rna_z2b",lv=5,id=5},
{"fgact",ch="里奈",act="うなづく",lv=5,id=5},
{"se",file="se9010",id=1,vol=50},
{"text"},
text={
ja={
{
"Rina jala mi brazo.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"bgm",stop=1,time=1000},
{"bg",time=300,sync=0,file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002475",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010i",head="rna_z2a",lv=5,id=5,sync=0},
{"extrans",time=500},
{"bgm",file="bgm103"},
{"text"},
text={
ja={
{
"Paso mis dedos sobre mis labios, intentando recordar la tierna sensación que en\nellos acabo de sentir.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Rina está frente a mí, viéndome a los ojos, con sus mejillas sonrojadas.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009i",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002476",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kusanagi-san... la forma en que te has comportado desde ayer...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quise dar la apariencia de tipo frío y calmado ante ti, Rina.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012i",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002477",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Pero mi propia lujuria me causó terror.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008i",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002478",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Tu... lujuria?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Me excité fuertemente cuando te besé ayer. Y estuve a punto de forzarte\na más...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si hubiese seguido... no me cabe duda alguna, te hubiera llevado a la cama a la\nfuerza...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quería darme ver como un hombre imperturbable, que a nada le temía. Pero cuando\nllegó el momento, el miedo me invadía... Sentí, que en cualquier momento\nterminaría tomando tu cuerpo a la fuerza...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010i",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002479",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por eso es que te tornaste distante de repente...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, exactamente... Perdóname...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0011i",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002480",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sabes algo? Ayer, por primera vez en mi vida, me masturbé. Creo.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009i",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002481",ch="rna"},
},
ja={
{
name={"Rina"},
"“No eres el único que estaba excitado, Kusanagi-san...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012i",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002482",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, lo olvidaba, no debo llamarte así...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008i",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002483",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿N-Naoya... san?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Ah, s-sí, dime.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009i",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002484",ch="rna"},
},
ja={
{
name={"Rina"},
"“No fuiste el único, Naoya-san. Yo también me excité cuando nos besamos.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rina...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0011i",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002485",ch="rna"},
},
ja={
{
name={"Rina"},
"“Naoya-san, no eres el único que deseaba eso. Yo también quería que me tomaras.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010i",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002486",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por eso es que ayer me masturbé. No podía aguantar las ganas...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002i",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002487",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me hace muy feliz saber que quieres tomar mi cuerpo. Tómame tanto como quieras,\nsi así lo deseas.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0004i",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002488",ch="rna"},
},
ja={
{
name={"Rina"},
"“Rina, es tuya...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Rina.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"se",file="se9010",vol=50,id=1},
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Jalo cariñosamente a Rina a mis brazos y le doy un suave beso.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002489",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mm.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010i",head="rna_z2a",lv=5,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya no podré echarme atrás... ¿Puedo... de verdad?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002i",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002490",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué clase de pregunta es esa? Te lo digo una vez más, yo soy tuya. Puedes\nhacer lo que quieras con mi cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0004i",head="rna_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002491",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nada me haría más feliz que complacerte, si es que es eso lo que necesitas.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡R-Rina!”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0013",head="rna_z2a",lv=5,id=5},
{"fgact",ch="里奈",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002492",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Ah, cierto! ¡D-Disculpa!”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Je?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"se",file="se9010",id=1,vol=50},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",lv=4,id=5},
{"text"},
text={
ja={
{
"Apenas intenté abrazarla de nuevo, Rina se escabulló de entre mis brazos.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa? ¿Ya... no quieres?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002493",ch="rna"},
},
ja={
{
name={"Rina"},
"“No es eso. Dame un momento.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"msgoff"},
{"fg",ch="里奈",time=1000,mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x2=0,x=500,lv=4,id=5},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Rina me deja y se dirige a la puerta de la azotea.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"excall",file="03_zypressen_12_2"},
