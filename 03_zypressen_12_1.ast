block_00054={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0014",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002438",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Y-Yuumi!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"¡Retiro lo dicho, de excelente no tiene nada!",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0009",head="rur_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000042",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Y entonces le pregunté a Yuumi-chan, Yuumi-chan, ¿qué es masturbación? Y\nentonces me dijo que te preguntara directamente.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0002",head="rur_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000043",ch="rld"},
},
ja={
{
name={"Rurio"},
"“Por eso vine al colegio. Y bien, y bien, Rina onee-chan, ¿qué es masturbación?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0007",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002439",ch="rna"},
},
ja={
{
name={"Rina"},
"“U-Una niña como tú no necesita saber qué es.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0004",head="rur_z1i",x=345,lv=4,id=6},
