linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0018",head="rna_z1a",x=-570,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002442",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué se supone que debes enseñarle?”",
{"rt2"},
},
},
