astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c06_01",path=":ev/ev_eye_c06/",set="ev_eye_c06"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_eye_c09_01",path=":ev/ev_eye_c09/",set="ev_eye_c09"},
{"ex",time=3000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",lv=4,id=9},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“H-Hola...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0004",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002421",ch="rna"},
},
ja={
{
name={"Rina"},
"“Senpai.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hoy tampoco vino Kawachino?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002422",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hoy tampoco vino.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"se",file="se9010",id=1},
{"cgact",stage="bg053",act="うなづく"},
{"text"},
text={
ja={
{
"Tomo asiento, un tanto distante de Rina.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Al notar eso, la cara de Rina toma una expresión de enfado, y le da palmaditas\nal banco, justo a su lado.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah, puedo?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0017",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002423",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si no es acá, me molestaré...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Bueno...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"se",file="se9004",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=100,file="zbg053a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=1000},
{"se",stop=1,id=1,time=500},
{"se",file="se9010",id=2},
{"cgact",stage="zbg053",y=100,act="うなづく"},
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2a0100",face="a0002",head="rna_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
"Me acerco, y tomo asiento a su lado.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Rina me observa con una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Pero sin querer, bajé mi mirada al hacer contacto visual.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0012",head="rna_z2a",lv=5,id=9},
{"fgact",ch="里奈",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002424",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿P-Pasa algo?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, n-no, no pasa nada...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0008",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002425",ch="rna"},
},
ja={
{
name={"Rina"},
"“P-Pero, no has hecho contacto visual alguno conmigo... Kusanagi-san, has estado\nalgo raro desde ayer.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no... no pasa nada...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Esta situación es idéntica a ayer. Y sin embargo, desde que besé a Rina en mi\ncasa he comenzado a sentirme nervioso estando a su lado.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Cada vez que pienso más en que debo ser yo quien debe llevarla de la mano y\nguiarla, mis gestos y acciones se vuelven más torpes.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0011",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002426",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿S-Será, que... hice, algo malo ayer? S-Si es por eso, yo--”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡P-Por supuesto que no!”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0009",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002427",ch="rna"},
},
ja={
{
name={"Rina"},
"“P-Pero te noto algo distante desde ayer, después de que nos besamos.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Es que--”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2a0100",face="a0010",head="rna_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002428",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿E-Estás, tal vez... arrepentido?...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"mwact",act="うなづく",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡D-De ninguna manera!”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_rld_000027",ch="rld"},
},
ja={
{
name={"???"},
"“Ohhh, conque así son las peleas de pareja.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5,sync=0},
{"extrans",time=500},
{"fg",ch="ルリヲ",size="z1",mx=40,mode=3,resize=1,path=":fg/rur/z1/",file="rur_z1i0000",face="i0001",head="rur_z1i",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="びっくり",size=5,lv=4,id=5},
{"bgm",file="bgm031"},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0013",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002429",ch="rna"},
},
ja={
{
name={"Rina"},
"“W-Waah.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0003",head="rur_z1i",x=345,lv=4,id=6},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000028",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Holis, soy yo, Ruriwo.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002430",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Q-Qué haces acá, Ruriwo-san?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0002",head="rur_z1i",x=345,lv=4,id=6},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000029",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Vine a pasar el rato.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0010",head="rur_z1i",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0001",head="rur_z1i",x=345,lv=4,id=6},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rld_000030",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Ayer en la noche me puse a pensar, ah, tan tarde y mi hermana aún no regresa.\nQuería averiguar qué pasaba, y llamé a Suzuna.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0002",head="rur_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000031",ch="rld"},
},
ja={
{
name={"Rurio"},
"“Y fue entonces que me enteré, Kusanagi-chan y Rina onee-chan son novios. Casi\nme caigo de la silla.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0003",head="rur_z1i",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0008",head="rur_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rld_000032",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¡Y entonces le dije que vendría hoy a Yumihari a verlos! Pero entonces Suzuna\nse molestó conmigo, y me dijo que no debía molestar a los tortolitos.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0009",head="rur_z1i",x=345,lv=4,id=6},
{"fgact",ch="ルリヲ",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000033",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Suzuna me puso los pelos de punta. Por eso vine hoy en secreto, sin que se\nenterara.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿C-Cómo es que la hermana de Kawachino sabe lo de nosotros?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0010",head="rur_z1i",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0015",head="rur_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rld_000034",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Al parecer lo dedujo al ver la manera en que Yuumi-chan se comportaba. No\nparaba de gritar 'Me quitaste a mi Rina, muérete Kusanagi', 'Vete al\ninfierno, Kusanagi' y 'Ojala se te seque el pe*e, Kusanagi'. Fue entonces que\nSuzuna se cansó y se enojó con ella.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Kawachino... ¿Has estado gritando todo eso en tu casa?...",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002431",ch="rna"},
},
ja={
{
name={"Rina"},
"“D-De igual forma, este no es lugar para que una niña venga a pasar el rato. No\npuedes venir acá como si nada, sin propósito alguno.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0001",head="rur_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000035",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Propósito sí tengo. Vine a preguntarte algo.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0015",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002432",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Preguntarme qué?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0010",head="rur_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000036",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Es que le pregunté a Suzuna, 'Suzuna, Suzuna, ¿por qué Rina onee-chan hacía\n'Jaa, jaa' estando sola?'”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0014",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002433",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Y q-q-qué respondió Suzuna-chan?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0002",head="rur_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000037",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Me dijo que las muchachas hacen eso cuando piensan en alguien por el que\nsienten algo.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002434",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, sí... e-eso, es correcto.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Excelente respuesta, Kawachino hermana.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0011",head="rur_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000038",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Pero el 'Jaa, jaa' de ayer se escuchó distinto. Sentí algo diferente.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0014",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
