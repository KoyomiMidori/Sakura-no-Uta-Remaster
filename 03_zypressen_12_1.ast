},
block_00047={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0001",head="rur_z1i",x=345,lv=4,id=6},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000039",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Y entonces, me encontré hace un ratito a Yuumi-chan en el camino, y le\npregunté. ¿Y sabes qué me dijo?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0009",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002436",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Q-Qué te dijo?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0002",head="rur_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000040",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Que solo sucedía que los sentimientos que tienes por esa persona son más\nfuertes ahora. Que no me preocupara.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
