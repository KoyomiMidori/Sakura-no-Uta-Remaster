},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0018",head="rna_z1a",x=-570,lv=4,id=5},
