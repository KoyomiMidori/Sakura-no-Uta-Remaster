{"text"},
text={
vo={
{"vo",file="fem_rna_002445",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Y tú por qué dices eso?!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0015",head="yum_z1a",x=570,lv=4,id=4},
{"fgact",ch="優美",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002364",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eh~, ¿que no es cierto? Si llegaste a los extremos de tomar esas fotos y aun\nasí no te has masturbado pensando en él es porque en realidad no te gusta\ntanto~”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0006",head="rna_z1a",x=-570,lv=4,id=5},
