{"vo",file="fem_rna_002437",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y-Yuumi...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
