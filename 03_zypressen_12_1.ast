block_00079={
{"fg",ch="ルリヲ",mode=-1,lv=4,id=6},
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0007",head="rna_z1a",x2=-570,x=-345,lv=4,id=5},
