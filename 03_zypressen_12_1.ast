block_00068={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",x=-570,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002443",ch="rna"},
},
ja={
{
name={"Rina"},
"“Además, y-yo no estaba masturbándome, ni nada de eso...”",
