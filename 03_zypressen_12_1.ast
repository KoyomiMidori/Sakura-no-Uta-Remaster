},
block_00069={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0008",head="yum_z1a",x=570,lv=4,id=4},
{"fgact",ch="優美",act="びっくり",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002362",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿No? Qué lástima.”",
{"rt2"},
