linknext="block_00060",
},
block_00060={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x2=-345,x=-570,lv=4,id=5},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0004",head="rur_z1i",x2=345,x=0,lv=4,id=6},
{"fg",ch="優美",size="z1",mx=40,mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0003",head="yum_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002358",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ruriwo-chan, si quieres saber qué es la masturbación, esta lesbiana que está\naquí te enseñara.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0007",head="rna_z1a",x=-570,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002440",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Y-Yuumi! ¡¿Qué crees que estás haciendo?!”",
{"rt2"},
