},
block_00062={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1i0000",face="i0001",head="rur_z1i",x=0,lv=4,id=6},
{"fgact",ch="ルリヲ",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rld_000045",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Ah, Yuumi-chan. Pero, cuando te pregunté hace un rato me dijiste que le\npreguntara a onee-chan.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=-570,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=570,lv=4,id=4},
{"fgact",ch="優美",act="うなづく",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0015",head="yum_z1a",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_yum_002359",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, en principio es tu hermana quien debería tomar responsabilidad y enseñarte\nlo que es. Pero, al parecer, esta abandonó su deber.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0016",head="yum_z1a",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="びっくり",lv=4,id=4},
},
vl02={
{"fgact",ch="優美",act="びっくり",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_yum_002360",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Así que pensé tomar el asunto en mis propias manos y enseñarte! ¡¿Qué es la\nmasturbación?! ¡¿Cómo masturbarse?! ¡¿Y cómo se siente masturbarse?! ¡Yo me\nocuparé de responder a todas esas preguntas y más!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0017",head="rna_z1a",x=-570,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002441",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Pero qué piensas hacer?!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0015",head="yum_z1a",x=570,lv=4,id=4},
{"fgact",ch="優美",act="いいえ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002361",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si tú no lo haces, no me queda de otra que hacerlo yo~”",
{"rt2"},
},
},
