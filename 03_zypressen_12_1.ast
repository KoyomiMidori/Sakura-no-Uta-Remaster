},
block_00070={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_yum_002363",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues Kusanagi, como bien sabrás, Rina me encanta, y siempre me masturbo\npensando en ella. Si no se masturba pensando en ti es porque no le gustas\ntanto como pensabas.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... ¿D-De verdad?”",
{"rt2"},
},
},
