astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c07_01",path=":ev/ev_eye_c07/",set="ev_eye_c07"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="zbluesky_winter",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Escucha... no tienes por qué obligarte a hacerlo.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_szd_001395",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“P-Pero, si consideramos que en piedra, papel y tijeras el perdedor le sigue al\nganador...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, si consideras ese orden, sí, pero...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero no tienes por qué forzarte a hacerlo, de verdad. Bueno, no lo niego, de\nque quiero ver quiero ver, pero...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_szd_001396",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Eso me haría una mentirosa!”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te veo como una mentirosa, la verdad...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_szd_001397",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero promesa es promesa.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿S-Supongo?...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_szd_001398",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“A-Así que, kuh～”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Shizuku baja su ropa interior, completamente sonrojada.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"No lo puedo negar. Ver a la normalmente inexpresiva Shizuku haciendo semejante\ncosa y con tanta pena es muy sucio, y me excita... pero...",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_szd_001399",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“M-Me he quitado mis pantis.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_szd_001400",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y-Y como lo prometí, me sentaré en ese banco... me sentaré, y...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_szd_001401",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me... abriré...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_szd_001402",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Me, abriré!”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Siendo sincero, pienso que no hace falta que te abras acá...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_szd_001403",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡N-No hay problema! S-Sé que, p-pase lo que pase... me protegerás... Nadie, va\na... vernos...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. No dejaré que nadie te vea.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_szd_001404",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“T-Todavía estamos, a plena luz del día, y en medio del patio del colegio, pero\naun así... S-Shizuku, se... abrirá...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh... E-Está bien...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Dios mío. ¿Cómo es que ha llegado a suceder esto?...",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Sería algo impensable de hacer, en un caso normal... Aunque bueno, una cosa\nllevó a la otra.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Todo comenzó cuando Shizuku vino al colegio Yumihari.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm011"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿T-Tú?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0301",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Ahí estaba la chica con la que me vi frecuentemente el invierno pasado.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿K-Kuzu?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",size=5,time=500,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001405",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Por qué estás como Kuzu?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0003",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001406",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me coloqué extensiones.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Extensiones?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1d0301",face="d0016",head="shz_z1d",lv=4,id=9},
{"fgact",ch="雫",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001407",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, fui con un estilista a que me las colocara. Quedaron muy bien, *seña de la\npaz*.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, está bien, pero... ¿Por qué convertirte de nuevo en Kuzu?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0010",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001408",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“De las varias veces que he venido, me di cuenta que de no disfrazarme con algo\npodría llamar mucho la atención...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Shizuku es una celebridad, tiene sentido. Va a llamar la atención si camina\nlibremente sin ninguna clase de disfraz. Lo sé, pero...",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tener a una muchacha vestida en ropa casual acá en el colegio ya llama la\natención de por sí, la verdad...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011j",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0016",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001409",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Además, ¿nunca se te ha apetecido hacer cosas sucias conmigo vestida como Kuzu?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Todo bajo la premisa de hacer cosas sucias?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001410",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No quieres?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No, bueno... sí quiero...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0016",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001411",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Nada mal entonces, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Eso crees?...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Guardo los pigmentos en mi mochila.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0013",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001412",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Mm? Naoya, ¿ya te vas?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Todos están con la presión de la Exposición Moore, y la verdad, no tengo\nmucho qué hacer acá en la sala.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001413",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No vas a estudiar?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo haré en casa.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí, Shizuku. ¿Por qué no vamos a mi apartamento?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0011",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0009j",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001414",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Eh? ¿C-Con qué r-razón, me--”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es lo que tú crees. No es para hacer cosas pervertidas, ni nada por el\nestilo. Solo que llevo tiempo sin ir al apartamento, y se me ocurrió que\ndebería ir a ver cómo está.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0010",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001415",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001416",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Yo, pensaba que... estando así vestida de Kuzu, te habían dado ganas de ir al\napartamento y cogerme allá. Total, si lo vas a hacer... sería mejor en el\nlugar de recuerdos para los dos...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué diablos? ¡¿Por qué tendría que tener tanto ahínco en hacerlo en un lugar\nen específico?!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0016",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001417",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Cómo no? Eres un pervertido...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo soy.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0009",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001418",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eso, o que quizás querrías hacer algo tan intenso y violento que ni en la\nresidencia Natsume se pueda hacer...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Veamos, en primer lugar no tengo ni siquiera la experiencia para hacer cosas\ntan intensas. Para alguien que apenas perdió la virginidad hace poco, solo\ncon hacerlo de manera normal es lo suficientemente difícil...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0016",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001419",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No, se supone que eres tú quien se dejará hacer. Y yo, quien haría.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué demonios?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0016",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001420",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“He estudiado mucho gracias al profesor Goglee, y créeme que puedo hacer de\ntodo. Puedo amarrarte con una cuerda y torturarte con cera derretida con\ncompleta facilidad...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, gracias!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0012",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0016",head="shz_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1d0301",face="d0016",head="shz_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001421",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No? Sé lo mucho que te gustan los juegos de humillación, mi pequeño pervertido\nNaoya. Solo dime cuando quieras, haré todo lo que quieras.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A mí no me gustan los juegos de humillación.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0012",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0016",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001422",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No te gustan? Pues, por alguna razón parecías estar disfrutando ayer cuando\nchupaba tu pe*e y jugaba con él...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ahhh, no es eso! ¡¡No tiene nada que ver con que me hayas humillado!!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0004",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001423",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y como podemos ver, a Naoya le encantan los juegos sexuales de humillación.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No vengas con esa conclusión ridícula! Y-Ya está, vámonos.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Me voy de la sala de arte junto con Shizuku.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg054a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
"Al salir, nos fuimos a la plaza central.",
{"rt2"},
},
},
},
labelcount=4,
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0012",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001424",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, nada. Solo que, me di cuenta que de acá se puede ver la iglesia...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001425",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Está repleta de gente como de costumbre.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Como era de costumbre, la iglesia estaba repleta de gente. Y gracias a eso,\nhabía menos gente en el patio que de lo normal.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La gente está tan concentrada allá que la plaza esta vacía. Así como está esto,\nquizás ni disfraz te hacía falta...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0009",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0016",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="ジャンプ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001426",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, hay poca gente acá. ¡Jaa! ¡¿Eso que has dicho, quiere decir que estás\npreparando algún juego sexual?!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y no vengas con esos comentarios al estilo de Sui, por Dios...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001427",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“La propia Sui tiene parte de mi ser, así que... quizás su personalidad se\nparezca un poco a la mía.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? S-Shizuku, ¿no me digas que... al recuperar por completo los sentimientos\nte convertirás en Sui?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001428",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eso no sucederá. Somos existencias cercanas, pero no iguales.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0013",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001429",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pareces estar algo aliviado.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues sí, un poco... No sé si pudiera convivir con esa personalidad tan\nexcéntrica...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0016",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001430",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo... Sui no podría jugar a la humillación sexual como lo hago yo contigo.\nPensé que era eso lo que te había aliviado.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué clase de razón para aliviarse es esa?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0002",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0004",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001431",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Quizás Sui pueda servir para ser la uke, pero no podría ser la seme contigo,\n¿sabes? Y sé que te gusta ser humillado...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Escucha muy bien, yo no disfruto siendo humillado! ¡¿Está bien?!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0016",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001432",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No? Ayer parecías estar disfrutándolo bastante mientras te observaba.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que no, que no es eso, demonios.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0301",face="a0017",head="shz_z2a",lv=5,id=9},
{"bgm",file="bgm031"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001433",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Vaya, ¿es eso así~?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué lo dices con esa voz monótona?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0005",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001434",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Con ninguna razón en particular, sí~”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Tanto con eso de los juegos, y la humillación. ¿No será que solo quieres\nhacerlo?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0002",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001435",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Por supuesto que no. En su perfil, Shizuku es una muchacha inexpresiva. No\ntiene interés en esa clase de juegos.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A-Ah, no?... ¿Quién era la que quería hacer la seña de la paz con las piernas\nabiertas?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0016",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0311",face="a0016",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001436",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eso era para tentarte, y hacerte ver mejores sueños eróticos.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no hacía falta de llegar al punto de abrir las piernas, digo yo. ¿No será\nque eres en realidad una maniática del SM?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0017",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001437",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Será eso verdad...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0005",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001438",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No me gusta la manera en que dices eso.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué no?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0016",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001439",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Bien, ¿por qué entonces no nos ponemos a prueba?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Ponernos a prueba en qué?!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0311",face="a0002",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001440",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hay un banco allá, algo oculto de las personas que pasan cerca.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo veo...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Era un banco rodeado por árboles, que no podrías ver de no echar un buen ojo.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0016",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001441",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Quien pierda en piedra, papel y tijeras expondrá sus genitales.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Por qué eso~?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0002",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001442",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y quien se pare, o se moje primero, pierde.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Perder?...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0311",face="a0016",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001443",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ahí veremos quién realmente es el maniático de los juegos SM.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Está bien que hagamos semejante competición?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0013",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001444",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Por qué no?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien por mí, quizás, pero tú eres una celebridad...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0012",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001445",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Sí? Tú también lo eres, al menos acá en la ciudad.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“L-Lo sé, pero no es lo mismo que un hombre muestre sus partes a que una mujer\nlo haga...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0009",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001446",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obviamente. Ah, demonios, s-se acabó este ridículo tema. Vámonos ya.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0016",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001447",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“La victoria es entonces mía por abandono (susurro).”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Shizuku me susurra.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0301",face="b0016",head="shz_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo es.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0003",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001448",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Si no participas la victoria sería mía por incomparecencia.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En mi diccionario no existe la palabra derrota.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001449",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No participar es lo mismo que una derrota, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jamás he perdido en competición alguna.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0015",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001450",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ugh... Veo que eres algo competitivo.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Algo no, bastante.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0011",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001451",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Sí?...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que lo soy. ¿Cómo crees que llegué a arrasar con todas esas\nexposiciones siendo apenas un niño? Me encanta conseguir el primer lugar.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora intento no mostrarme como tal, pero de niño aborrecía la derrota.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dejé de pintar para preservar el secreto que tú y yo sabemos, pero...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“También, aunque solo un poco, un poquito nada más porque... no quería competir\ny perder con los demás por no poder usar bien mi brazo.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0013",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001452",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo. Eso explicaría por qué a pesar de que por lo general te muestras\ncalmado y con reserva, te vuelves explosivo de vez en cuando...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Más que explosivo... sucede que me caliento fácilmente, solo eso.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Probablemente esa cualidad de justiciero que tengo viene en realidad de lo\nterco que soy al competir.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0016",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001453",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo. Es por eso que tomaste repentino interés en el juego.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal cual. Y no vuelvas a decir que he perdido, jamás. Este juego quedó\ninvalidado, no hubo nada en un principio.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0301",face="a0005",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001454_n",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Te equivocas.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Escucha, si sigues en ese plan harás que me decida a jugar en serio.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0311",face="a0016",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001455",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Muy bien por mí. En lo que a mí respecta, me siento feliz de haber conocido ese\naspecto tuyo.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ese aspecto mío?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0011",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0008",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001456",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“De que en realidad, te calientas fácilmente...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya sabes cómo soy, no es la gran cosa.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0003",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001457",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Quiero disfrutar tu lado terco también, así como ahora.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“*Tch*, te advierto algo, no doy un solo paso atrás en lo que a competiciones se\nrefiere. No vengas a llorar después.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0002",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001458",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Yo jamás lloraría por algo relacionado a ti. Tú y todo lo que tiene que ver\ncontigo son mi felicidad.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Si vienes, con esas cosas tan lindas... yo...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0016",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0311",face="a0016",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001459",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No es cuestión de lindo o no. Es la realidad. Bien, ¿por qué no me muestras\nentonces ese competitivo lado del cual tanto me presumes?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Las cosas están cambiando un poco comparado a lo que dijo al principio...",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aghhh, qué más da. ¡Bien, acepto ese reto!”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0005",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="ジャンプ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001460",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Ven con todo lo que tengas!”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0016",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001461",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡Piedra, papel, y tijera, uno, dos, tres!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Perdí...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0016",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001462",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Has perdido, y por ende eso te hace un pervertido amante de los juegos de\nhumillación.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera un momento, en ningún momento dijimos que decidiríamos eso con este\njuego.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0301",face="b0012",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001463",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Fuimos al lugar donde estaba el banco, rodeado por los árboles.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"msgoff"},
{"bg",file="zbluesky_winter",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=0,x=-960,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm104"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Expongo mis genitales acá y ya, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_szd_001464",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Mmmm, la verdad es que no me termina de convencer eso... Eres mío y de nadie\nmás, y la idea de que alguien más vea tus partes sagradas no me agrada mucho.\nNo me agrada mucho que digamos.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Te estás contradiciendo! Además, se supone que es poco probable que nos vean\nacá, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_szd_001465",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Poco probable, pero sigue habiendo la posibilidad... Alguien podría venir a\nsentarse acá.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo se atrevería a venir cuando ya hay alguien sentado acá?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_szd_001466",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Quizás, a espiarnos...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, no puedo negarlo. Con un poco de esfuerzo podrían espiarnos...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_001467",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Jaa?! ¿Te atreviste a participar en este juego aun sabiendo eso? Lo sabía,\neres un pervertido exhibicionista...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, diablos! ¡Se supone que estoy haciendo esto para probar lo contrario!”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_szd_001468",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Bueno...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“B-Bien, me desnudaré ahora...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_szd_001469",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Eh? Ah, sí... ¡Ah, no te preocupes! ¡Me encargaré de proteger tu zona inferior\nde la amenaza de cualquier mirada ajena!”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No sé muy bien si sentirme alegre o no por esas palabras...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"se",file="se0897s",id=1},
{"text"},
text={
ja={
{
"Me bajé el pantalón y los calzoncillos.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_szd_001470",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“... E-Estás, ahora... desnudo.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y-Y bien?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_szd_001471",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿B-Bien, qué?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No está erecto, ¿ves?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_szd_001472",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hmm, ciertamente. Aunque eso no quita que quizás reaccione con facilidad...\n*funifuni*.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡E-Espera! ¡N-No lo toques!”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_szd_001473",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Considerando el lugar, una persona normal sin gustos masoquistas no podría\nconseguir una erección aun siendo tocado, entre tantas distracciones.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Guh...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"mwact",act="うんうん",time=300},
{"text"},
text={
vo={
{"vo",file="fem_szd_001474",ch="szd"},
},
ja={
{
name={"Shizuku"},
"*funifuni*...",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_szd_001475",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Vaya, vaya, pero qué caliente gemido estoy escuchando... ¿Sientes que se te va\na parar?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Claro que...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_szd_001476",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, obviamente no. A una persona normal no se le pararía el pene acá, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Por supuesto...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_szd_001477",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Alguien se acerca...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_szd_001478",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Está caminando detrás de ti.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Créeme que... no voy, a reaccionar a esta situación...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_szd_001479",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No estoy fingiendo. ¿Escuchas las pisadas y las voces hablando?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Se acercan las pisadas y las voces... pero pasan de largo.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿S-Se fueron?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_szd_001480",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Se fueron.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“*Fiuu*... menos mal. Si alguien llega a descubrirme haciendo esto, empezaran a\nverme como un depravado...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_szd_001481",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No hace falta que te vean. El hecho de que estés acá con tu pe*e descubierto te\nhace ya un depravado.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Fuiste tú quien propuso hacer esto!”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_szd_001482",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, lo sé. Vaya, que no se para tu pene todavía.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te dije que no tengo esos gustos.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_szd_001483",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Será eso verdad?...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_szd_001484",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ngmmm... *rerorero*...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh... ¡¿ohh?!”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"cgdel",id=-1},
{"bg",file="ev_shz_h03_01",path=":ev/ev_shz_h03/",set="ev_shz_h03"},
{"text"},
text={
ja={
{
"Shizuku estaba ahora lamiendo mi miembro. Una viscosa, cálida sensación estaba\nahora rozando la superficie de mi erecto aparato reproductor.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_szd_001485",ch="szd"},
},
ja={
{
name={"Shizuku"},
"*chu*... *rerorero*... *shh*...",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hih, Shizuku... ¿P-Por qué estás haciendo esto justo ahora?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_szd_001486",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Si realmente no te gustaran los juegos pervertidos no hubieses reaccionado.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Que no?! ¡Obviamente que iba a reaccionar!”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"bg",file="ev_shz_h03_02",sync=0,face=1,time=400,path=":ev/ev_shz_h03/",set="ev_shz_h03"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001487",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Lo estás haciendo.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿C-Cómo podría aguantar las ganas cuando me atacas con la boca, justamente en\neste lugar?!”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_szd_001488",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Entonces sí eres un pervertido. Un pequeño pervertido que le encanta ser\nhumillado.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Que no!”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_szd_001489",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Intenta entonces no eyacular.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"bg",file="ev_shz_h03_03",sync=0,face=1,time=400,path=":ev/ev_shz_h03/",set="ev_shz_h03"},
{"text"},
text={
ja={
{
"Al decir eso, Shizuku comenzó a deslizar su pequeña lengua por todos los\nrincones de mi miembro.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="fem_szd_001490",ch="szd"},
},
ja={
{
name={"Shizuku"},
"*peropero*... *shh*, *chp*...",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Comenzando por el cuerpo, pasa a la cabeza, para luego cosquillear la punta con\nla punta de su lengua.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gwh...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"bg",file="ev_shz_h03_04",sync=0,face=1,time=400,path=":ev/ev_shz_h03/",set="ev_shz_h03"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001491",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*rerorero*... N-Ngh... *chp*, *chppp*... ¿Qué tal? ¿Crees poder aguantar?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿M-Me crees capaz de aguantar esto?... Ngghhh...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Tapo mi boca.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_szd_001492",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*rero*, *rero*... *splsh*, *chp*, *shh*... Jaa, jaa, Naoya... ¿Qué pasa? ¿Por\nqué estás cubriendo tu boca con tus manos?”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No me... kuh, preguntes, eso...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Si me descuido empezaré a soltar gemidos raros.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"No sé si verme así dejó a Shizuku satisfecha, pero esta comenzó a lamer con aún\nmás intensidad mi pe*e. Pasa su lengua hacia arriba y hacia abajo por el\nfrenillo, y cosquillea la base de la cabeza con la punta de su lengua.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh, kuh...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_szd_001493",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No me importaría, que gimieras más...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-Ni creas, que lo haré... a-ah, kuh...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="fem_szd_001494",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*shh*, *chu*, *chp*... *rerorero*, *puh*... Ah, está pasando gente caminando de\nnuevo~ *shrrrr*.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“U-Ughhh.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――¡*bikun*!",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"El placer corre poco a poco por mi miembro.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_szd_001495",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Apenas te dije que venía gente caminando... reaccionaste.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Claro que no. Fue porque pasaste la lengua de la base a la cabeza en una\nsentada...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="fem_szd_001496",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Sí? Ah, se están acercando bastante.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“U-Ughhh.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"Me tapo la boca con las manos.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_szd_001497",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Vayamos con una paja también.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿U-Una paja?! A-Auhh.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"bg",file="ev_shz_h03_05",sync=0,face=1,time=400,path=":ev/ev_shz_h03/",set="ev_shz_h03"},
{"text"},
text={
ja={
{
"――*sch*, *sch*...",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="fem_szd_001498",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Una buena paja con mi mano mojada, y... *rero*.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh... u-uhm...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Intento, con todas mis fuerzas, aguantar.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Shizuku masturba mi miembro con su mano a la vez que pasa su lengua por el\nfrenillo y la zona trasera de la corona del glande.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
