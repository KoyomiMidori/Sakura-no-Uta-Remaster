astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c05_01",path=":ev/ev_eye_c05/",set="ev_eye_c05"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"se",file="se1666",id=1,loop=1},
{"msgoff"},
{"bg",file="bluesky_winter",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Dos días después――",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg019a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1b0100",face="b0020",head="mak_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm006"},
{"fgact",ch="真琴",act="あくび",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003675",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuu...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Toritani suelta un pequeño bostezo dentro del solitario tren. Es raro verla\nhaciendo eso.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Toritani y yo estamos ahora viajando entre trenes para buscar esa brillante\narena blanca que la dueña encontró y que Toritani usó para 'La Luna y las\nEstrellas'.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Aún no sabemos el lugar exacto. Viajamos solo con el mensaje que la dueña le\nenvió a Toritani hace dos días y una postal de cuando la dueña estuvo en el\nlugar. Solo con esas dos cosas como pistas.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"El paisaje que se ve tras las ventanas está repleto de verde. Montañas y campos\nde cultivo es lo único que se ve.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"se",stop=1,id=1,time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No has estado durmiendo bien?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0009",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003676",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nm, no... Y además, me quede despierta toda la noche ayer...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si hubiera sido yo ya me estarías sermoneando, diciendo 'Escucha bien, quedarse\ndespierto trabajando toda la noche es lo menos eficaz que puede haber' o algo\nasí.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0017",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003677",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sigo pensando igual, así haya sido yo quien lo hiciera.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0011",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003678",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Solo que estuve hablando con mi madre.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Una persona inesperada surgió en la conversación.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Con la directora Toritani?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003679",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Pensé que sería buena idea tener la mayor cantidad de pistas posibles\nrespecto al lugar a donde vamos.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003680",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Le pregunté si no tuvo contacto con la dueña para la fecha en la cual esta me\nenvió esa arena... Y también, acerca de la forma de pensar de la dueña y sus\npeculiaridades.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Conseguiste algo útil?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0015",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0011",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003681",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No mucho. Pero...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Toritani susurra, mientras se queda viendo hacia afuera por la ventana.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003682",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me alegra haber podido hablar tanto con ella. Con mi madre.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003683",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"El silencio recae sobre los dos, escuchándose solo el sonido del tren\nmoviéndose dentro del, exceptuando a los dos, solitario vagón.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003684",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“También supe que tú y ella hablaron acerca de 'Las escaleras hacia la luna'.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Ese es el libro que Nei recibió de Toritani. Aquella noche en la fiesta, Nei me\nleyó lo que quedaba por leer de la historia.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003685",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“'Quizás el conejo solo estaba siendo tentado por la locura que inspiraba la\nluna, y en realidad solo deseaba dormir en brazos de esa persona a la que\ntanto quiere'.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que algo así dije aquella noche... Parece que la directora lo recordó muy\nbien.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003686",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tan insignificante resultó para ti eso que lo olvidaste, supongo.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhmmm. Tampoco es que lo pensé tanto al decirlo.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003687",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Quizás para ti no signifique mucho, pero yo no creo que pueda olvidar esas\npalabras.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú estás mucho más apegada a lo que es el conejo de luna que yo, ¿no? Es tu\nseudónimo, y la marca de tus productos, además.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003688",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esa solo fue idea de la dueña. Originalmente tenía pensado usar 'pica- pica'\ncomo nombre de marca. Y planeaba también usar otro seudónimo.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003689",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pica-pica significa urraca. Cuando la dueña se enteró del nombre, me dijo 'No\nvengas tú también a usar ese nombre'.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La temática que la directora Toritani usó en su pintura para engañarlos a todos\nfue una urraca. Y en su seudónimo también usa el carácter de garza.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y a partir de esa pintura, la dueña fabricó un jarrón.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"El símbolo de la urraca tiene muchos lazos con las mujeres de la familia\nToritani. Y no de los buenos.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Al principio no sucedió nada. Pero cuando entró Reika en la ecuación, las cosas\nse fueron directamente en un tobogán hacia el caos.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Yo también le hubiera pedido lo mismo de haber conocido toda la historia.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003690",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que a la dueña se le vino algo a la mente cuando me propuso el nombre de\n'conejo' en ese momento, aunque fue ayer que lo supe por parte de la\ndirectora.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué fue lo que se le ocurrió?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003691",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dentro del conejo (usagi) yace la garza (sagi).”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya entiendo. Por eso es que el nombre se lee como 'Usagiko' y no como 'Usako'.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003692",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La directora hizo un juego de palabras con su seudónimo de Seiro (青鷺),\nincluyendo tanto la palabra garza (鷺/sagi) como la palabra estafa\n(詐欺/sagi)... Por eso, la dueña quiso encerrar a la garza (sagi) en el\nconejo (usagi).”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con el deseo de que los estragos que había traído la urraca no llegaran a\nsalpicarte a ti también... ¿Tal vez?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003693",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Quién sabe? La directora dijo algo similar también, pero... en realidad, no sé\nsi la dueña tuvo esa intención al darme ese nombre.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003694",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y también me enteré de que la dueña tiene una percepción de los conejos muy\núnica.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003695",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Para ella, los conejos son blancos y lindos animalitos inofensivos. Siempre\npareciendo tener sueño, representando en sí la paz como tal.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003696",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quizás la dueña quiso dejar sobre mí esa moderna y personal visión suya.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre luciendo adormecidos. Una inofensiva personificación de la paz... Sí,\ndebo decir que es todo lo contrario a lo que eres.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003697",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Esa visión de los conejos es propia de la dueña. La mía no es tan tierna\ncomo la de ella.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003698",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Conoces la historia de Sakra y el conejo? Hace mucho, mucho tiempo, Sakra se\nhizo pasar por un anciano, y se apareció ante un chacal, un mono y un conejo,\nquienes se ofrecieron a ayudarlo.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003699",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El chacal y el mono consiguieron frutas y pescado para el anciano, pero el\nconejo no logro traer nada. Y por ende, no tuvo nada que darle al anciano.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003700",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso, el conejo le pidió al anciano que encendiera una fogata, a la cual se\nmetió, diciéndole a este 'Coma de mi carne, por favor'.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003701",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sakra, quien quedó conmovido por la acción del conejo, imprimió la silueta del\nconejo en la luna, a manera de dejar la marca de su noble actuar por la\neternidad... Y lo hizo plasmándolo negro y abrasado sobre ella.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003702",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... No soy capaz de actuar como ese conejo. No simpatizo con lo que hizo, ni\ntampoco me cautiva la historia. No tengo razón ni impulso alguno para hacer\nalgo así.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003703",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así que bueno, digamos que a lo sumo, soy una pequeña conejita fascinada con la\nluna, dando pequeños saltitos en el suelo tratando de alcanzarla, sin\nescalera alguna a la mano.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003704",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, no creas que estoy rebajándome ni menospreciándome. No vayas a\nmalinterpretar las cosas.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. No hay cosa más alejada de la personalidad de Makoto\nToritani que la palabra 'menosprecio'.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0004",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003705",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuh, obviamente.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Si Toritani quiere pretender ser ahora la muchacha que nada le importa, pues la\nacompañaré en ello. Toritani lo sabe, y aun así sigue hablando conmigo\nnormalmente.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Pretender estar de ánimos es, también, una forma de estarlo. De seguir\npretendiendo estarlo, en algún momento terminará volviéndose realidad.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"A veces, pretender que lo que los demás digan o hagan no nos importa puede\nconvertirse en la fuerza que necesitamos.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que hablaste de muchas cosas con la directora, eh.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003706",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, llevaba tiempo sin hacerlo... o más bien, tal vez esta fue la primera vez\nque hablé de tantos temas, y por tanto tiempo, con mi madre.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003707",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por cierto, ¿recuerdas la historia del cartero que te conté?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, la recuerdo. Lo de que yo me había convertido en el mediador entre la\ndirectora y tú.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003708",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Y de esa manera fue que el cartero se convirtió en el único ser capaz\nde ponerle fin al eterno ciclo de la cabra blanca y la cabra negra.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003709",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La directora dijo que eras justamente como el puente de urracas.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Aquello que se conoce en el folclor popular como el puente de urracas y el\ncartero de esa historia toman el mismo rol como mediadores. Comunicadores.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003710",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dijo también que desde el punto de vista de la comparativa transcultural, la\nurraca era bastante interesante.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003711",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oriente y Occidente... Sé que es una clasificación bastante tosca, pero ignora\neso... Bien, prosigo. Parece que la imagen y el significado simbólico\narraigado en los dos hemisferios son bastante distintas.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003712",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No pisó mucho en el asunto tampoco, pero cuando hablamos de urracas en Japón,\ndestaca la historia del puente de las urracas, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003713",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mientras que en Occidente... Pues, ¿no sabrás más tú que yo al respecto?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Respecto a la imagen general que se le tiene? Si es por eso, entonces es de\nprecaución... de alguien que sopla, que delata. ¿No crees?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003714",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Me parece que 'La urraca sobre el cadalso' de Pieter Brueghel\nrepresenta esa imagen muy claramente.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003715",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sin embargo, la urraca de Monet pareciera alejarse de ese clásico sentido\niconográfico que se tiene en Occidente.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás por eso mismo fue que resultó ideal como temática para la directora y su\nukiyo-e, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003716",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Aunque, parece que mantuvo fuertemente en mente una imagen en particular al\nmomento de plasmar la pintura de la urraca sobre la ukiyo-e.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La del puente de las urracas del que hablamos?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003717",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De una waka inspirada precisamente en esa temática. Es muy famosa, quizás la\nconozcas tú también. 'Kasasagi no wataseru hashi ni okushimo no shiroki wo\nmireba, yozofukenikeru' (Al ver la escarcha que cayó en ese puente de\nurracas, más noche se hizo la noche).”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es una waka?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003718",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eh, es un poema del Hyakunin Isshu. Lo tienes que conocer.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pueees, ¿tal, vez?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003719",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No te lo enseñaron en las clases de literatura clásica en la secundaria?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Quizás?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0020",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="ジャンプ",time=500,size=5,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003720",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bueno, no importa... *bostezo*.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Toritani vuelve a soltar un pequeño bostezo.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003721",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, voy a terminar durmiéndome si no hablo de algo, de lo que sea, así que\nsigue acompañándome en la conversación.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003722",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que hay varias interpretaciones para esa waka. La que mi madre tomó fue\naquella en la cual se asume la escarcha como alegoría de las estrellas de la\nVía Láctea.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"De vez en cuando aparece la palabra 'Madre' mezclada entre las palabras de\nToritani.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Quizás sea también por lo despistada que está por el sueño, pero igual puedo\npercibir la manera en que la actitud de Toritani con su madre se ha\nsuavizado, aún después de haber insistido todo este tiempo en llamarla\nsiempre por 'esa mujer' o 'Directora'.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Parece que la conversación hasta al amanecer que madre e hija tuvieron dio sus\nfrutos.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003723",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La urraca del ukiyo-e es una sola, y la pintura se desarrolla en el día, y no\nde noche... además, el paisaje no es de escarcha, sino de nieve...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003724",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Encima del puente que las urracas formaron extendiendo sus alas para cruzar la\nVía Láctea, las estrellas caen como si fueran escarcha... Ella dijo que creó\nla obra teniendo presente en todo momento esa imagen de invierno y color\nblanco en su mente.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003725",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Al escuchar eso de mi madre, lo primero que se me vino a la mente fue 'El\natrapapajaros'.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003726",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Los bancos de la Vía Láctea, donde las urracas caen como nieve... Esa blanca y\nradiante arena que se extiende allí... Se me hizo tan brillante como esa\nblanca escarcha que ocupó el cielo...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0020",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="ジャンプ",time=500,size=5,lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0019",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003727_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque, lo que el atrapapajaros tenía, en su poder, eran... *bostezo*...\ngansos... Vaya, que la imaginación, puede ser bastante imprecisa...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Las palabras de Toritani van alargándose cada vez más. Su cabeza se bambolea a\nlos lados, y sus parpados están por cerrarse, luciendo pesados.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003728",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El lugar, que Shizuru... que la dueña, encontró, es... seguramente, igual...\nCon bastante arena... tan blanca como la escarcha... como la nieve...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003729",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y por... eso, yo... tomé, esa imagen, y...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"bg",file="bg019a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0010",head="mak_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué no duermes un rato? Aún falta para llegar a la estación a la que\nvamos.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0009",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003730",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si te encargo con que me despiertes... no llegaremos nunca...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Diría que es al revés en este caso.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tanto la dueña como yo tenemos un pésimo sentido de orientación. Es más\nprobable que nos acerquemos al lugar correcto si me encargo yo de descifrar\nel mensaje y la postal que ella mandó.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0015",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003731",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero qué tonterías... Aunque, sí, tal vez, tengas razón...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Toritani, quien estaba cayéndose del sueño, asintió a mis palabras mucho más\nfácilmente de lo normal.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0010",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003732",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Lo siento, dormiré un rato... pero, este es mi viaje, así que... no es\njusto que ponga toda la responsabilidad sobre... ti... Asegúrate, de\ndespertarme, ¿sí?...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro, tranquila.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003733",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="真琴",my=40,mode=-1,lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Toritani dejó caer su cabeza sobre mi hombro, y comenzó a dormir, respirando\nsilenciosamente.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Es difícil creer que alguien tan sensible a los ojos de los demás como Toritani\nse duerma como si nada en un tren, independientemente de que solo estemos los\ndos... Uno o dos días sin dormir no son suficientes como para que suceda\nesto.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Aquel día había dicho también que no había dormido mucho. Seguramente se quedó\npensando todo ese tiempo respecto a la obra que crearía para la Exposición\nMoore.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Observo la malla de equipaje. Encima está el equipaje con todo el equipo para\nacampar que me traje de la casa de los Natsume.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Me lo traje considerando la posibilidad latente de que tengamos que dormir en\nmedio de la intemperie. ¿Será que de verdad llegaremos a necesitarlo?",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Probablemente sea imposible conseguir el lugar al cual Toritani desea llegar\nsolo en este fin de semana usando métodos convencionales.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Ojeo el mensaje de la dueña que Toritani me reenvió, además de la postal que\nenvió.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"'Me quedé dormida y me pasé de estación, así que me regresé y me bajé. Se podía\nver la luna, así que doblé a la derecha'...",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Quizás yo sí pueda ver ese camino que Toritani no logra ver.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",file="se1666",id=1,loop=1},
{"msgoff"},
{"bg",file="bluesky_winter",id=8,lv=8,rule=139,sync=1,vague=40,path=":cg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"bg",file="eveningsky_spring01",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Despierta...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"cgdel",id=-1},
{"se",stop=1,id=1,time=500},
{"msgoff"},
{"bg",y=-580,x=720,file="zbg019b",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0010",head="mak_z2b",lv=5,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0009",head="mak_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003734",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Nm, ¿qué...?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Mientras Toritani se frotaba los ojos al levantarse, le anuncié con una voz\ncalmada...",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nos pasamos de estación.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0017",head="mak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003735",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0013",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003736",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿¿Jaa?!!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bgm",file="bgm031"},
{"msgoff"},
{"bg",file="bg019b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="真琴",size="z1",my=40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0100",face="d0013",head="mak_z1d",lv=4,id=9},
{"se",file="se3130",id=1},
{"quake"},
{"text"},
text={
ja={
{
"Un instante después, Toritani abrió sus ojos por completo al captar la\nsituación y observó sus alrededores.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0110",face="d0021",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003737",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Es que acaso no dijiste que me despertarías?! ¡¡¿Qué haces quedándote dormido\ntú también?!!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cálmate, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0006",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003738",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡¿Crees que puedo calmar――?!!”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0008",head="mak_z1d",lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani se detiene justo antes de accionar su ametralladora de palabras. Me\nobserva fijamente a los ojos, como tratando de probarme.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0017",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003739",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi... ¿Esto también lo tenías planeado?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, tampoco es que he estado planeando todo a detalle...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, regresemos.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0009",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003740",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... bajémonos en la próxima estación y vayamos de vuelta. Dios santo... Todo\nsalió como lo escribió la dueña en su mensaje, y sin siquiera planificarlo...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Sin embargo, a medida que van pasando los minutos, nos vamos dando cuenta de lo\ninconveniente que pueden llegar a ser las rutas de tren en el interior.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg019b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003741",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por más que avanzamos no llegamos aún a la próxima estación... ¿No será que\neste tren es un expreso de los lentos, y pasamos la estación ya?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, lo más seguro es que haya bastante distancia entre las dos estaciones. Cada\nrecorrido toma alrededor de 20 minutos, tal vez.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0018",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0013",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
},
vl02={
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003742",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y dónde se supone que estamos ahora? ¿En qué prefectura y en qué línea? Ah...\nUwaah, estamos fuera de cobertura además...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, a veces los trenes que atraviesan las montañas no reciben bien las señales\ntelefónicas... Parece ser bastante pequeño, pero Japón es realmente grande--\nOh, está sonando el anuncio del tren.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="man_shr_000001",ch="shr"},
},
ja={
{
name={"Operador"},
"“Próxima estación～... ri～～... ri～～”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0009",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003743",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Se escucha tan bajo que no se entiende nada... En fin, bajémonos en la próxima\nestación.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"msgoff"},
{"bg",file="zeveningsky_spring01",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, Toritani. El próximo tren vendrá en 2 horas.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003744",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Hablas en serio?! ¡¿Es que acaso realmente estamos en Japón?! ¡¿En qué clase\nde tierra misteriosa y aislada estamos?!”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No crees que muchos por ahí podrían enfadarse de enterarse que alguien habla\nasí de su región solo por la poca cantidad de trenes que pasan?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003745",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uguh, me arrepiento de decir eso... Aunque, a fin de cuentas, supongo que solo\nnos queda... esperar.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal cual. Dicen que lo bueno viene para aquellos que saben esperar.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003746",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Siento que si sigo esperando aquí con toda tranquilidad contigo, me empezará a\ncrecer musgo por todo el cuerpo...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_picapica_12_2"},
{"text"},
linkback="block_00147",
},
label = {
top={block="block_00000",label=1},
},
}
