astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c05_01",path=":ev/ev_eye_c05/",set="ev_eye_c05"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bg003a",path=":bg/",sync=0},
{"extrans",time=1000},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Voy a la cocina y preparo algo de café.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Saco una taza del armario de tazas y utensilios afines. Mi mano se detiene\njusto antes de servir el café.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Esta taza es una de las que Toritani fabricó. Que la haya agarrado\ninconscientemente es prueba de lo práctica que se me hace.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Toritani.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Sin querer, recuerdo lo de ayer.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Lo de 'Olympia'. Lo de mi familia.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Y――",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Ella, como modelo de desnudo...",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"No, mejor dejemos de pensar eso.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Desde lo que sucedió ayer me he quedado todo este tiempo pensando.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"... Acerca del desnudo de Toritani.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... No puedo hacerle eso.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Se supone que debería pensar las cosas seriamente, así como Toritani lo está\nhaciendo.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"No, bueno, ayer estuve pensando seriamente respecto al asunto por un buen rato.\nPero, comencé a perder algo el control desde la medianoche.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Pero ya es de mañana, ¿sí? Ya no es de noche, ¿está bien?",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Debo pensar con seriedad... sin distracciones mundanas...",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
".........",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"bg",file="black",path=":bg/"},
{"fg",ch="真琴",size="z2",speed=120000,time=3000,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2b0100",face="b0001",head="mak_z2b",y2=-300,y=0,lv=5,id=9},
{"text"},
text={
ja={
{
"No puedo. Mientras más seriamente trato de pensarlo, más mi mente se\ndescontrola y se va en otra dirección.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Y no es por nada, estamos hablando de que la modelo sería Toritani. No una\nprofesional, o alguna estudiante de artes cualquiera que ejerza el oficio a\nmedio tiempo.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Si me llegaran a preguntar si me excitaría ver a Toritani desnuda, contestaría\nque por supuesto.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Toritani es linda. Y es una buena chica. Nos llevamos bien los dos, y puedo\nhablar con soltura y tranquilidad con ella.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Y es linda.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Y tiene buen cuerpo.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Toritani propuso, y con toda seriedad, fungir de modelo desnuda, para\nconfrontarme de una buena vez. Lo propuso, aunque sea como solo una idea,\npero lo propuso.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Toritani es sagaz, y alguien que se toma las cosas muy a la manera que las\npercibe.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Por lo general me muestro muy desinteresado por todo, así que mi insistencia\ncon el asunto de las pantaletas y el modelaje al desnudo probablemente le\nhizo creer que sería buena idea para atraer mi atención.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Y es justamente la idea de usar mis más bajos instintos lo que lo llevó a decir\nayer que eso sería 'injusto'.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"msgoff"},
{"bg",file="bg003a",path=":bg/",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"No logro organizar mis ideas bien.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Bueh, qué más da. Vayamos a preparar el desayuno primero.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Al servir el café en la taza y tomar un sorbo, comencé con los preparativos del\ndesayuno.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm024"},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0700",face="a0019",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001041",ch="ked"},
},
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Mientras llevaba el desayuno a la mesa, Kei apareció.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei, ¿ya despertaste?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"se",file="se9010",id=1},
{"fg",ch="圭",mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Kei no muestra ninguna reacción. Pasa de largo por la mesa, sin hacer más nada.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"bg",file="bg003a",path=":bg/",sync=0},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0010",head="kei_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="圭",act="うなづく",time=100,size=3,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="うなづく",time=100,size=3,lv=4,id=9},
},
vl02={
{"fgact",ch="圭",act="うなづく",time=100,size=5,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001042",ch="ked"},
},
ja={
{
name={"Kei"},
"*glup* *glup* *glup*",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Abre el refrigerador sin decir nada, y se toma de una sola sentada una cajita\nde leche completa, haciendo ruido al beber.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"se",file="se9002",id=1},
{"fg",ch="圭",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Y entonces, sin decir nada aún, se devuelve a la sala.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"No parecía estar ignorándome, sino más bien absorto y completamente\ndesconectado de lo que sucedía alrededor. La conciencia de Kei permanece\njunto a sus pinturas, aun cuando su cuerpo no lo está.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"bg",file="bg009a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Fui al atelier, a revisar si Kei había comido la cena.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Los platos de la cena estaban vacíos.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"La bolsa que contenía las rosquillas estaba aplastada, colocada cerca de los\nplatos.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Parece que se comió todo.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Un tanto aliviado ahora, tomo la bandeja con los platos y me marcho del\natelier.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"bg",file="black",path=":bg/"},
{"msgoff"},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"ex",time=1000,func="wait"},
{"bg",zoom=100,x=-80,y=-580,time=0,speed=1000,file="zbg004a",path=":bg/",z2=50,x2=0,y2=0,ax=1920,ay=1126,bx=-960,by=-586},
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0700",face="a0010",head="kei_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
"Al regresar al comedor, Kei estaba durmiendo, sentado frente a la mesa.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0700",face="a0010",head="kei_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, Kei.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"msgoff"},
{"cgact",stage="zbg006",y=150,act="いいえ",size=25,time=580,loop=-1},
{"fgact",ch="圭",act="いいえ",size=5,time=580,loop=-1,lv=5,id=9},
{"se",file="se9010",loop=1,id=1},
{"ex",time=3000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=-80,y=-580,file="zbg004a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0700",face="a0010",head="kei_z2a",lv=5,id=9,sync=0},
{"extrans",time=0},
{"fg",ch="圭",size="z2",time=500,mode=3,path=":fg/kei/z2/",file="kei_z2a0700",face="a0011",head="kei_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"ex",time=1000,func="wait"},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0700",face="a0010",head="kei_z2a",lv=5,id=9},
{"fgact",ch="圭",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001043",ch="ked"},
},
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Al moverlo de un lado a otro se despierta, pero rápidamente se tumba de nuevo a\nla mesa a dormir.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="man_ked_001044",ch="ked"},
},
ja={
{
name={"Kei"},
"“Guuh.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Es la misma imagen que se ve todos los días, sí, pero... ¿Realmente estará\nbien?",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
"En lo que iba a mitad de camino para ir al salón, veo dos siluetas que se me\nhacían conocidas. Son Rin y Toritani.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hola.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003599",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, buenos días.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",time=300,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001916",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oh, buenos días.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estaban hablando acá? ¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",time=200,size=5,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001917",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, sí...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Toritani se encoge de hombros, y le lanza una mirada a Rin.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0016",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001918",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Hablando del rey de Roma, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",time=400,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003600",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Verdad~?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, ¿qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003601",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Justamente estábamos hablando de ti, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De mí?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001919",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Rin-chan dice que estará ocupada con el paisaje que está pintando para la\nExposición Moore y quiere concentrarse, así que quizás sea difícil que pueda\nseguir ayudándote con tus estudios.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003602",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aun así, sigo preocupada de que estudies, Nao-kun... Pero, cuando mencioné\neso, Mako-chan dijo que ella se encargaría de ayudarte.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, esperen un momento, yo puedo estudiar por mi cuenta, así como todos los\ndemás.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001920",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por no hacerlo es que estamos ahora nosotras dos rompiéndonos la cabeza y\nbuscando una solución, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003603",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, es verdad.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"mwact",act="おじぎ"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“G-Gununuh...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Con las dos diciéndolo al unísono y presionándome, no tengo argumento alguno\npara replicarles.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003604",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Te esforzaste bastante durante las vacaciones de verano, así que ya has\nempezado a entender mucho más de geografía. Ya deberías estar en capacidad\npara graduarte, pero... las pruebas de ingreso a la universidad son otra\ncuestión.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Tranquilas! No hay ningún problema. No voy a darles más molestias ahora que\nestán ocupadas con la Exposición Moore y otras cosas más. Estudiaré por mi\ncuenta, creo que al menos debería poder hacer eso solo.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001921",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmm... ¿Qué crees que podríamos hacer, Rin-chan?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003605",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es todo un dilema...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienen ni una mínima pizca de confianza en mí...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001922",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tu comportamiento usual dice bastante en estos momentos. ¿Te sientes capaz de\nresistir la tentación de no gastar el tiempo con todos los aparatos de\nentretenimiento que hay en tu casa y poder estudiar solo?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, de que puedo, puedo!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003606",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, de ser así...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0002",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001923",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oh, Rin-chan, ¿se te ocurrió alguna buena idea?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"¿Es que planean seguir ignorando mis opiniones hasta el final?",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003607",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, aunque, bueno... solo si eso no te causa molestias, Mako-chan...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003608",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pensé que tal vez Nao-kun podría estudiar en Quimera.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En Quimera?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003609",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Dicen que los lugares predilectos para estudiar son siempre son las\nbibliotecas y los locales de café. ¿Qué les parece?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001924",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En mi caso no me molesta en lo absoluto.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es en serio?...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001925",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué? ¿Es que acaso no quieres?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, al contrario, si no te es molestia alguna me sería mucho mejor tener a\nalguien cerca.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0004",head="mak_z1d",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001926",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Decidido entonces. Kusanagi, ven siempre que tengas chance. La mitad del tiempo\ntendrás que estudiar por tu cuenta, pero debería resultarte más eficaz a que\nestudies solo en casa.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003610",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan, pongo a Nao-kun en tus manos.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001927",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tranquila, yo me encargo.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Rin y Toritani se dan un fuerte apretón de manos. De verdad que se la llevan\nbien, eh...",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_picapica_02_2"},
{"text"},
linkback="block_00097",
},
label = {
top={block="block_00000",label=1},
},
}
