astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"se",file="se1135",id=1},
{"bgm",file="bgm023"},
{"text"},
text={
ja={
{
"Jadeando y sin aire, Rin sube de nuevo por las escaleras.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="稟",size="z1",mx=40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うんうん",time=500,size=10,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001778",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaa, jaa, discúlpame, aun en pleno almuerzo...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, más que pleno almuerzo, diría que previo al almuerzo. En fin, siéntate.\nYa no queda mucho tiempo de receso.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001779",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0003",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rin se sienta a mi lado, jubilosa.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001780",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, ¿no has comido nada aún?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, conociéndote, pensé que probablemente regresarías con prisa, así que estuve\nesperándote.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001781",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Auuh, lo siento. De verdad, lo siento mucho.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tranquila, no te preocupes. Ah, estos enrollados de carne de gobou――”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"msgoff"},
{"fg",mode=-2},
{"bg",file="zbluesky_winter",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Comienzo a almorzar junto a Rin.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Deleito mi paladar, mientras intercambiamos los distintos contornos de nuestros\nalmuerzos.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"No se podía esperar menos de los platillos de Rin. Están jodidamente buenos.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está muy bueno esto.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001782",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, lo que preparaste está delicioso, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Vaciamos los obentou algo apresurados, pero aun así pudimos almorzar sin llegar\na perder tanta holgura en el tiempo.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues bien, ¿será que regresamos al salón ya?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001783",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, creo que es buena idea. Aunque quizás no hizo falta comer tan rápido,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, eso creo. Teníamos más tiempo de lo que pensábamos.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001784",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejeje, sí. Me divertí bastante.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"bgm",stop=1,time=500},
{"se",id=1,file="kazenari"},
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Esa fue una ráfaga de viento.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Era seguramente, el tipo de viento que se podría observar con regularidad en la\nazotea.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Pero, fue un viento que no llegó a venir ni una sola vez durante lo que ha\ntranscurrido del día.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Quizás por eso es que ella bajó la guardia. Posiblemente el hecho de que se\nquedara conversando de forma amena conmigo contribuyó a ello.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"El viento hace que la falda de Rin se suba.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Y entonces, mis ojos presencian una inimaginable vista.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"bg",file="ev_uni_c40_01",id=9,lv=9,time=500,path=":ev/ev_uni_c40/",set="ev_uni_c40"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001785",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001786",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿--?!”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"cgact",file=":ev/ev_uni_c40_01",id=9,lv=9,act="びっくり"},
{"se",file="se9033",id=1},
{"bgm",file="bgm031"},
{"text"},
text={
ja={
{
"Desesperada, Rin trató de tomar el borde de su falda y contenerla, pero quizás\nel mismo desespero se lo impidió. Y mientras tanto, todo lo que hay por\ndebajo de ella se ve expuesto.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Eh?!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001787",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Auuh.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"cgdel",id=-1},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0014",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"De una u otra forma, Rin logra sostener su falda y bajarla.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Esto...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Acabo de ver algo insólito.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fgact",ch="稟",act="いいえ",loop=6,size=10,time=200,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001788",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿M-M-M-Me vist-te?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fgact",ch="稟",act="停止",lv=4,id=9},
{"text"},
text={
ja={
{
"Si fuera en otro caso, estaría completamente pasmado del asombro en este\nmomento, pero fue tanta la agitación de Rin que estaba más bien calmado\nahora.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, digo, solo fue un instante... o, eso quisiera decir, pero...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0022",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",loop=6,size=15,time=120,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001789",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿L-L-Lo viste?!”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fgact",ch="稟",act="停止",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque no pude ver con tanto detalle lo que había debajo. Lo único, sí, es que\nno pude encontrar las pantaletas que deberían haber estado tras la falda...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0020j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001790",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uhh.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Rin se sonroja al límite, con una expresión tal que pareciera estar por romper\nen llanto.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Y entonces, baja la cabeza con gran ímpetu.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0022",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001791",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¡Ofrezco mis más sinceras disculpas por haberte mostrado algo tan vergonzoso y\nrepugnante!!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no, no fue nada repugnante, pero... ¿Por qué andas sin bragas, Rin? ¿Es,\nque acaso tienes esa clase de gustos...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001792",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¡No los tengo!!”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Entonces...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011j",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",loop=5,size=10,time=500,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009j",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001793",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Tengo que decir la razón? ¿Es que acaso tengo la obligación de dar una\nexplicación en estos momentos?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fgact",ch="稟",act="停止",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No exactamente, pero...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001794",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De qué forma interpretaste lo que acabas de ver entonces?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Se te olvidaron casualmente, o algo así...? Ya de cierta forma capté que no\ntienes esas inclinaciones. Digo, no creo que las tengas...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0006",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001795",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No tengo, no tengo esa clase de inclinaciones! A-Auuhhh... Pero, qué podría\ndecir en este caso... ¿De qué forma podría explicarlo?...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta realmente que te agobies tanto por explicarme...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0014",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001796",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Crees que lo que acaba de suceder puede dejarse pasar sin ninguna explicación?\n¡Se supone que normalmente esto es un asunto grave!”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, de que lo es lo es, pero...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001797",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Obviamente, no tengo ese tipo de inclinaciones, ni tampoco cometí eso con\nintención de mostrar nada.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso sí lo sé.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001798",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Simplemente no tuve tiempo...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En la mañana? Noté que saliste bastante temprano, pero tampoco como para no\ntener tiempo suficiente para ponerte algo de ropa interior, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0006",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001799",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡P-Por supuesto! ¡De ninguna forma olvidaría colocarme la ropa interior en las\nmañanas!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",loop=5,size=10,time=500,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001800",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... ehm... cómo podría ponerlo...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fgact",ch="稟",act="停止",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si no quieres explicarlo, no hace falta que lo hagas, eh.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001801",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡E-Esto! A-Al parecer, la parte inferior de mi cuerpo es algo floja...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La parte inferior de tu cuerpo... es floja?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001802",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah, no es que sea una depravada o una pervertida, ni nada de eso, creo! ¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, en realidad no lo había tomado de esa manera...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001803",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Normalmente, cuando dicen que alguien es flojo de la cintura para abajo, se\nrefieren a eso...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001804",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Escucha...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0110",face="a0009",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0010",head="rin_z2a",lv=5,id=9},
},
vl02={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0011j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001805",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Realmente he estado afligida por esto... ¿Cómo podría decirlo? Últimamente,\nrealmente desde hace muy poco... al, excitarme... me, mojo mucho, y...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"*traga saliva*...",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0014j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001806",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡N-No pongas esa cara, por favor!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, disculpa, a-ahora que lo recuerdo, creo que hace un tiempo las demás habían\nbromeado respecto a eso...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001807",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí... Lamentablemente, no es ninguna broma ni chiste. Hasta ahora nunca llegó a\nsucederme eso, pero últimamente he estado muy abrumada por eso.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011j",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001808",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Para ser sincera, con tan solo rozar nuestras manos un poco, siento que podría\nllegar a ensuciar mi ropa interior...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010j",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0009j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001809",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así que, y con mucha vergüenza lo digo, por acción de los besos de hace un\nmomento mi ropa interior terminó en un grave estado, y... pudo haber incluso\ncalado hasta mi falda, así que fui a limpiarlos al baño. En ese momento, me\nquité mi ropa interior, y...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0019",head="rin_z2a",lv=5,id=9},
},
vl02={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0011",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001810",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡R-Realmente quería cambiarme al uniforme de gimnasia y regresar a la azotea!\n¡De verdad que no quería caminar por allí y por allá sin nada de ropa\ninterior! P-Pero... el tiempo se iba acabando...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0015",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001811",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y no quería desperdiciar en lo mínimo el tiempo del receso del almuerzo que\npodría pasar contigo...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0009",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0011",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001812",ch="rnd"},
},
ja={
{
name={"Rin"},
"“C-Cualquiera quedaría desencantado, ¿verdad? Con una chica que acabe de esa\nforma solo por un beso...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, claro que no. Me pone feliz que te excites tanto solo por un beso.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0006",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005j",head="rin_z2a",lv=5,id=9},
},
vl02={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0015j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001813",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡P-Por supuesto que me excito! Pues, pues, es que... s-son los besos con mi\namado Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rin... y-ya veo...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0011j",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0009j",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001814",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿S-Sabes? Yo... siempre, todo este tiempo, he vivido pensando en ti,\nNao-kun... de besarnos de esa forma intensa, obviamente me excitaré.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, como hombre, jamás en mi vida me había sentido así de feliz como\nahora... de verdad que lo agradezco...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001815",ch="rnd"},
},
ja={
{
name={"Rin"},
"“G-Gracias a esa clase de comentarios bondadosos tuyos, creo que podré\nrecomponerme un poco...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, realmente no lo decía con ese propósito--”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"se",id=1,file="se1895"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, la campana.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001816",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, debemos apresurarnos.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pero antes de eso, ponte el uniforme de gimnasia por debajo!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009j",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001817",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡P-Por supuesto que lo haré! Así deba llegar tarde iré a ponérmelo. ¡No me los\npuse antes de venir a la azotea porque no quería desperdiciar ni un solo\nminuto del tiempo contigo, Nao-kun!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Realmente dice unas cosas que alegran, eh.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001818",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vamos, regresemos rápido al salón.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bluesky_winter",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Después de eso, una atmósfera algo incómoda se cernió entre los dos.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Estábamos algo distantes, o, cómo podría describirlo... Aunque, bueno, a pesar\nde haber sido un accidente, terminé viendo aquella parte del cuerpo que las\nmujeres menos desean mostrar a los demás. Era inevitable que sucediera esto.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Aunque...",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"*mira fijamente*...",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001819",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Mm?! Uhh.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Al sentir mi mirada, Rin se pone como un tomate y se encoge.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Lo mismo sucede tanto en clases, como en las horas de receso...",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"No encuentro forma de hablar normalmente con ella.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Al terminar las clases de la tarde, entro a la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="eveningsky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"ex",time=1000,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"se",id=1,file="se2308"},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu... qué incómodo fue eso...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001820",ch="rnd"},
},
ja={
{
name={"???"},
"“Y-Ya veo. Lo siento.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Waah.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Rin estaba parada justo detrás de mí.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001821",ch="rnd"},
},
ja={
{
name={"Rin"},
"“T-Tienes razón... Perdóname. Encima de haberte mostrado algo tan feo, estuve\ntodo este tiempo tomando una actitud fría...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada, no fue nada feo. Y además, sé que realmente no estás distante,\nsimplemente estás apenada...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001822",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero acabas de susurrar tus verdaderos sentimientos.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, es que... digo...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001823",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Perdón...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Y entonces, Rin se sienta cabizbaja, descorazonada.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Aun cuando realmente no tiene nada de qué desanimarse...",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Quieres irte ya?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001824",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todos están ahora concentrados en sus obras para presentar a la Exposición\nMoore. De ser así, entonces no hay problema alguno en que nosotros hagamos lo\nmismo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001825",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, ¿tú también presentarás una obra?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no, por los momentos, mi deber ahora es estudiar. No pintar. Pero en tu\ncaso, aplicarás a la Exposición Moore junto a todos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001826",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. parece que cualquiera puede aplicar.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, si vas a presentar una obra vas a hacerlo con toda la intención de\nganar, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001827",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, por supuesto, pero...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, hagámoslo en mi casa entonces. Allá hay casi tanto material e\ninstrumentos como hay aquí.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001828",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso lo sé, por supuesto. Pero ¿no te importa?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que me importe o no. Yo te enseñaré a pintar, y tú me ayudarás a\nestudiar. Se supone que eso habíamos prometido ya, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001829",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡S-Sí! T-Tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"msgoff"},
{"bg",file="zeveningsky_summer",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=0,x=-960,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Solo por si acaso, evitamos el portón frontal y salimos por el portón trasero.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Aunque bueno, ya el primer día de clases pasó hace un tiempo, así que no creo\nque vengan a perseguirme de nuevo, pero de igual forma, tomo mis\nprecauciones.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Últimamente me la he estado pasando todo el tiempo con Rin, y en caso de tener\nque huir, dudo que pueda hacerlo teniéndola a ella conmigo. Así que, al salir\npor el portón trasero, llegamos a aquel santuario.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, no he vuelto a venir con Rin acá desde aquel entonces.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001830",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿En el colegio Yumihari también hay esta clase de cosas?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, seguimos aún en terrenos del colegio, así que esto es como una especie de\nanexo del colegio Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001831",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Es muy viejo?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, parece que fue construido en el mismo año que se erigió este colegio.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001832",ch="rnd"},
},
ja={
{
name={"Rin"},
"¿Construyeron un templo al mismo tiempo que el colegio?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No conozco la historia en detalle, pero parece que hace bastante tiempo, toda\nesta colina era un templo. Aunque según, ya había decaído mucho antes de que\neste colegio fuera construido.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001833",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entonces fue una reconstrucción...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Rin observa con una expresión de curiosidad el Sessha.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oye, Rin.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001834",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sí? ¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es la gran cosa, pero ¿sabes qué es lo que se venera en este\nsantuario?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001835",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, no lo sé. Más bien, es hoy que me entero que había un santuario aquí.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Sí, me imagino...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001836",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué es lo que se venera acá?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Observa el interior del santuario.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-250,file="zbg063b",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001837",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto... Wah, tienen un enorme emaki como ofrecimiento. Hay una especie de barco\ndibujado, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese es el Barco del Tesoro.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001838",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Que esté el Barco del Tesoro significa que acá veneran a uno de los siete\nDioses de la fortuna?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, cualquiera pensaría eso. El Barco del Tesoro y los siete Dioses de la\nfortuna parecieran venir siempre juntos. Pero observa muy bien. ¿Ves a alguno\nde los siete Dioses montado sobre ese barco?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001839",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahora que lo dices, solo hay tesoros sobre el barco. No hay nadie a bordo. Y\nademás, hay algo escrito sobre este emaki...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nakakiyo no too no nefuri no, minamesame, naminorifune no oto no yokikana.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001840",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, lo he escuchado antes. Si no me equivoco... es un palíndromo muy famoso,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Es un palíndromo, que se lee igual comenzando desde principio o desde\nfin.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001841",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué tienen eso acá?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cambiaré un poco el tema. ¿Te diste cuenta de que hay un carácter escrito sobre\nla vela del Barco del Tesoro?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001842",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sobre la vela? Sí, está escrito 'baku' (獏), con letra grande.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Tiene 'baku' escrito.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Volviendo a tu pregunta de hace un momento, este poema palíndromo habla acerca\nde los 'sueños'.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuentan las tradiciones que en la noche del segundo día de año nuevo, al meter\nun dibujo del Barco del Tesoro con el 'baku' escrito y el poema palíndromo\ndebajo de la almohada al dormir, tendrás un plácido hatsuyume (primer sueño\ndel año).”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El Barco del Tesoro con el carácter de 'baku'. Un poema palíndromo que habla de\nlos sueños. En pocas palabras, en este templo se venera al dios de los\nsueños.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001843",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, ahora que lo recuerdo, la colina que está frente a la entrada principal del\ncolegio Yumihari se llama Yumenouki-saka (La colina donde flotan los sueños),\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que originalmente, todos los caminos que llevaban a esta colina eran\nllamados 'Yumenouki-saka'.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001844",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿En verdad?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y para agregar a eso, parece que el nombre que toma el colegio, Yumihari, era\nantes Yumehari. La hipótesis más común ahora es que la pronunciación se\ndegradó y pasó de Yumehari a Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001845",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entonces este colegio, toda esta colina como tal está relacionada en todos los\naspectos a los sueños, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y respecto a la respuesta a tu pregunta, parece que el dios que se venera en\neste templo se llama 'Hakuki'.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001846",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Hakuki? Jamás había oído de un dios llamado así.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Al parecer, Hakuki es un dios chino, así que su nombre no se conoce mucho\nen Japón.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, eso no implica que de ninguna forma haya sido transmitido a estas\ntierras. Al saber qué es lo que hace exactamente Hakuki como dios, podrás\nentender de qué forma se transmitió a Japón.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001847",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Será posible que ese dios llamado Hakuki come sueños?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así mismo. Parece que es un dios que traga sueños.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001848",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Claro, ya entiendo, en Japón sería el Baku entonces, ¿verdad? En pocas\npalabras, Hakuki vino de China y en Japón pasó a ser Baku.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, y ciertamente, según una hipótesis, Hakuki se transmitió de forma\nequivocada a Japón, y a partir de allí se empezó a decir que el Baku comía\nsueños.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001849",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Según una hipótesis?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, hay otra teoría. Esta dice que en principio, aquella criatura mítica\nconocida en China como Baku, no comía sueños. Parece que se alimentaba\nprincipalmente de latón, hierro y serpientes.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001850",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Su dieta es completamente distinta en ese caso.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, existe la leyenda en China que al dormir usando almohadas y\nfutones hechos con la piel del Baku, se pueden ahuyentar todo tipo de pestes.\nHay otras teorías que dicen que al llegar esa leyenda a Japón, se interpretó\ncomo que este 'comía sueños'.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001851",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No es algo poco común que este templo venere a Hakuki, siendo este un dios\nchino?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tal vez. Aunque aun en este templo, que en un principio veneraba a Hakuki,\ncon el largo paso de la historia llegó a ver a Hakuki y al Baku como la misma\ncosa. En pocas palabras, ahora es un templo que adora al Baku.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso, es que en los 'ema' (絵馬) ofrecidos a este templo, están dibujados\nel Barco del Tesoro con el carácter del Baku escrito.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Incluso algunas personas creen que el templo viene de la tradición de los siete\nDioses de la fortuna. Y diría que muy seguramente las personas mayores que\nvienen en año nuevo para el hatsuyume piensan eso.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001852",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Je, no sabía. Dijiste que este santuario ha estado aquí desde hace tiempo,\npero ¿cuánto tiempo en específico lleva acá?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No conozco la fecha en detalle, pero aún por estos rincones se conoce la\nleyenda de los cerezos milenarios. Parece que este santuario fue erigido casi\nen la misma época que surgió esa leyenda.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001853",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Los cerezos milenarios... eso es...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una leyenda que se ha transmitido por generaciones en esta región. Dice la\nleyenda que los sueños de las personas se transformaban en esas flores, para\nluego estas florecer.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001854",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Los sueños de las personas se transforman en flores? No sabía que se trataba\nde eso. Es algo hermosa esa leyenda, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ciertamente, eso de convertir los sueños de las personas en flores para\nluego emanarlos suena un tanto hermoso, pero también es algo aterrador...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Chupar los sueños de las personas, para luego convertirlos en flores. A mí\nparecer, se siente como una especie de maldición...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001855",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahora que lo pones de esa forma, quizás sea un poco espeluznante...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que la leyenda de los cerezos milenarios se originó entre el final de la\nera Heian y los inicios de la era Kamakura.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001856",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿H-Hace tanto tiempo?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una leyenda. Es, a final de cuentas, eso. No hay ni una sola prueba histórica\nal respecto.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La leyenda dice que, en este templo se veneraba a Hakuki, que esta colina se\nllamaba la colina de Yumehari, y que además existían los cerezos milenarios,\nlos cuales chupaban los sueños de las personas para poder florecer. Todo eso\nno es más que una simple leyenda.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001857",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así dice la leyenda... Ya veo, creo que ya entiendo entonces.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_uni_c24_01",path=":ev/ev_uni_c24/",set="ev_uni_c24",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001858",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, escuché que la pintura que realizamos sobre la iglesia tenía como temática\nlos cerezos milenarios.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, probablemente los cerezos que están sobre la iglesia son los cerezos\nmilenarios.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"Aunque ahora, la misma persona que diseñó ese mural murió ya, así que no hay\nforma de comprobar eso...",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001859",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tiene que ver con la historia por parte de la hermanita de Akashi-senpai,\n¿verdad? De que llegó a ver los cerezos milenarios.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, según, los vio hace 6 años desde ahora.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001860",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Hace 6 años?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001861",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Para ese entonces, yo estaba a punto de irme, pero seguía aún en Yumihari...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001862",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero nunca llegué a escuchar esos rumores.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, obviamente. No llegó a convertirse en rumor, así que nadie le creyó a la\nhermanita de Akashi, e incluso llegaron a tacharla de mentirosa. No había\nforma de que alguien se enterara, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001863",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, ahora que lo dices...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y la verdad, para ese entonces yo no conocía la leyenda de los cerezos\nmilenarios, ni casi nadie la conoce tampoco.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y menos aún, las leyendas relacionadas a esta colina...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001864",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque sabes bastante, ¿no, Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé tanto tampoco, pero hace un tiempo me vi obligado a investigar acerca de\nestas tierras, y en ese entonces aprendí más o menos todo eso.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001865",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo... ¿Cómo es en detalle la leyenda de los cerezos milenarios?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea, tampoco la conozco con tanta exactitud.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, Shizuku había dicho que los cerezos milenarios no\nflorecen por mil años, y que por eso le llaman 'cerezos milenarios'...",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Y, que hubo un genio que le dio forma a esos cerezos milenarios. Aquellos que\nse suponen que no debían florecer aún...",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001866",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sucede algo? ¿Se te vino algo a la mente?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, algo... En fin, cambiando de tema, jamás has venido a visitar este templo\nantes, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En ese caso, estás ahora aprovechando los servicios que este colegio te ofrece.\n¿No sería buena idea entonces que le hagas un ofrecimiento al templo?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por más decaído y viejo que este, es el templo que venera al dios protector de\nesta colina.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001867",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah, sí! Esto... limosna, limosna...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, no hace falta que hagas eso. Simplemente págale respetos al templo.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001868",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No podemos hacer solo eso. Toma, limosna, esta es tu parte, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Déjalo así. Después de todo, el dinero que quede acá entrará en las cuentas\nbancarias de la directiva del colegio.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001869",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Pero qué estás diciendo? La limosna no es para eso. Vamos, vamos, a dar\nnuestros ofrecimientos.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por Dios...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",mode=-2},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al decir eso, cada uno junta sus palmas.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Aunque cada año nuevo vengan a este templo numerosos fieles a rezar y pedir por\nun buen hatsuyume, casi nadie pone sus pies en este santuario en otros\nmomentos.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Son pocas las personas que conocen la razón por la cual este santuario fue\ntambién reconstruido en el mismo momento que la construcción del colegio\nYumihari.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"La reconstrucción ocurrió en la época del colegio Yumihari previa a la guerra.\nEn pocas palabras, por parte del antiguo conglomerado Nakamura.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Esta colina de Yumihari, así como la familia Nakamura, poseen una larga\nhistoria.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Hasta ese momento, yo tampoco conocía absolutamente nada acerca de las leyendas\nque giraban en torno a este templo, ni tampoco respecto a las tierras de la\ncolina de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"Ni tampoco, además, que todo eso tiene una profunda conexión con las personas\nque residen en la mansión Natsume...",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
{"bgm",file="bgm039"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000092",ch="knd"},
},
ja={
{
name={"Kana"},
"“Hola hola muchachos, pero qué tiempo sin verlos~”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gh...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="香奈",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mx=40,mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001870",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, hola, Nagayama-san.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=-345,lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000093",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero qué distante suena eso de Nagayama-san~ Vamos, llámame Kana- chan. Yo\ntambién te llamaré Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001871",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Necesitas algo?”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=-345,lv=4,id=9},
{"fgact",ch="香奈",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000094",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Pero qué estás diciendo~? Somos amigos de la infancia, no hace falta nada de\neso para poder vernos, ¿no? Vamos, hablemos~”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tengo prisa...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001872",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Tomo al instante la mano de Rin y comienzo a caminar.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",x=-345,lv=4,id=9},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000095",ch="knd"},
},
ja={
{
name={"Kana"},
"“Mmmm, tal como me lo imaginaba.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001873",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ignórala.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000096",ch="knd"},
},
ja={
{
name={"Kana"},
"“Naoya-kun, veo que tu brazo dominante cambió, ¿no? Aunque ya desde un principio\nme había parecido raro...”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No ha cambiado.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=-345,lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000097",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, sí cambió. Tu brazo dominante no es el izquierdo.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esos recuerdos tuyos están confusos.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=-345,lv=4,id=9},
{"fgact",ch="香奈",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000098",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pensé que dirías eso, así que revise con antemano las fotos en casa.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Fotos?”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=-345,lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000099",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, en toda excursión, festival de deportes y festival de culturas se toman\nfotografías, ¿no? Estuve reuniendo en secreto fotografías tuyas, Naoya-kun.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000100",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y entonces, me di cuenta. Me di cuenta de que tu brazo dominante era distinto\nal de ahora. Todo el tiempo, incluso para hacer los signos de paz, usabas tu\nbrazo derecho~”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un símbolo de la paz se puede hacer con cualquier brazo, así no sea el\ndominante.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",x=-345,lv=4,id=9},
{"fgact",ch="香奈",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000101",ch="knd"},
},
ja={
{
name={"Kana"},
"“No, nadie lo hace. Los humanos usan siempre su brazo dominante en situaciones\nde reacción inmediata.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000102",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y por eso es que incluso ahora, por un instante estuviste a punto de extender\ntu mano derecha, pero al final usaste la izquierda...”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001874",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso es todo lo que querías decir?”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=-345,lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000103",ch="knd"},
},
ja={
{
name={"Kana"},
"“Para nada, para nada. Solo estaba comenzando...”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me hagas repetírtelo una vez más, estoy con prisa.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0013",head="kan_z1a",x=-345,lv=4,id=9},
{"fgact",ch="香奈",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000104",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, Naoya-kun...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"fg",mode=-2},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Tomo la mano de Rin, sin decir nada.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"se",file="se1135",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg022b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Llegamos al edificio de mi apartamento, caminando con rapidez.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0012",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000105",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? Este edificio...”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De aquí en adelante es zona privada, te agradecería que no entres.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0013",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000106",ch="knd"},
},
ja={
{
name={"Kana"},
"“Wa, wawah, así que esta es la casa de Naoya-kun. Anotemos, anotemos.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tch...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"mwact",act="rl"},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001875",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Waah.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0012",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000107",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Oroh?”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
"Jalo fuertemente el brazo de Rin y nos montamos en el ascensor.",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001876",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, n-nos vemos, Kana-chan.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000108",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, hasta luego, Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
