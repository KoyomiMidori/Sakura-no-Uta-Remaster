astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg037a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2i0000",face="i0003",head="rin_z2i",lv=5,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=5,id=9},
{"bgm",file="bgm030"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003848",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Waah, qué cerezos tan hermosos, ¿no te parece?!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_szd_001065",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",mode=-2},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1i0000",face="i0001",head="aix_z1i",x=-345,lv=4,id=5},
{"fg",ch="健一郎",size="z1",mode=3,resize=1,path=":fg/ken/z1/",file="ken_z1b0000",face="b0002",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001159",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Esta es la colina Yumenouki. Aquí es donde trabajaba antes.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0002",head="aix_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000843",ch="aid"},
},
ja={
{
name={"Ai"},
"“Je, conque este es el colegio Yumihari...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0011",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001160",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Eh? Ai, ¿nunca has venido antes? Tú querías entrar al colegio Yumihari, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0010",head="aix_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000844",ch="aid"},
},
ja={
{
name={"Ai"},
"“Igualmente no podía venir... Esto es propiedad de la familia Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0002",head="ken_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_kid_001161",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lo es, sí. Pero eso no significa que estén las 24 horas vigilando.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0010",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001162",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Además, ni siquiera cuando yo trabajaba acá llegué a ver al propio presidente\nde la directiva, a Shoichi Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0002",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001163",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y sumado a eso, acá no vas a ver a casi ningún implicado en el asunto de\nnosotros y la familia. Puedes estar tranquila con eso.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000845",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿E-Eso crees?... La verdad es que yo me muero de terror...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0003",head="ken_z1b",x=345,lv=4,id=6},
{"fgact",ch="健一郎",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_kid_001164",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Qué raro verte así, eh. Un golpe de karate de los de siempre y asunto resuelto,\n¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="びっくり",time=100,size=7,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0015",head="aix_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000846",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Escucha, Kenichiro, obviamente yo no soy tan fuerte.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0002",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0006",head="ken_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_kid_001165",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿De verdad? Yo sí creo que lo eres, Ai. El puñetazo que me diste la primera vez\nque nos vimos dolió bastante.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="びっくり",time=100,size=7,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0011",head="aix_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000847",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Es que, ehm... de fuerte no tuvo nada... solo que... el lugar, donde lo\npropiné, ehm...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0002",head="ken_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_kid_001166",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Qué extraño verte así, eh. Aunque bueno, no tienes por qué ponerte tan\nnerviosa. No pasa nada con que entres al terreno del colegio.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_skd_000068",ch="skd"},
},
ja={
{
name={"???"},
"“*Fuh*, no puedo creer que hayas tenido las agallas de pisar territorio de la\nfamilia Nakamura, definitivamente...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0013",head="aix_z1i",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000848",ch="aid"},
},
ja={
{
name={"Ai"},
"“K-Kenichiro... d-detrás de ti...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0010",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001167",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, sí, ya sé. Saki, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Kenichiro volteo a ver a la persona que se había acercado.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",mode=-2},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000069",ch="skd"},
},
ja={
{
name={"Saki"},
"“La misma. Ya me parecía conocida esa cara que vi caminando por la colina. Jamás\npensé que llegarías a entrar al terreno de los Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="man_kid_001167b",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues fíjate que ya tengo un trato pactado con ellos, ¿no recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0011",head="sak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",lv=4,id=9},
},
vl02={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0008",head="sak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000070",ch="skd"},
},
ja={
{
name={"Saki"},
"“Que fue establecido como una deuda, ¿o se te olvidó? Se supone que habías ido a\nNueva York para pagarla... Si te llegan a ver merodeando por aquí, podrían\nacabar secuestrándote...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="man_kid_001168",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo... Saki... Aún después de todo no has parado de cuidar y preocuparte de\nmí, eh.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000071",ch="skd"},
},
ja={
{
name={"Saki"},
"“... De verdad que no has cambiado... Ni un poquito...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=-345,lv=4,id=5},
{"fg",ch="紗希",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x2=0,x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000849",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Estooo... K-Kenichiro... ¿Quién es esta señora?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0011",head="sak_z1d",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0014",head="sak_z1d",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000072",ch="skd"},
},
ja={
{
name={"Saki"},
"“Tú... Si no me falla la memoria, eres una de las Natsume...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000850",ch="aid"},
},
ja={
{
name={"Ai"},
"“S-Sí... me llamo Ai Natsume.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000073",ch="skd"},
},
ja={
{
name={"Saki"},
"“Ya veo. Pues entonces recuerda muy bien esto. Yo soy enemiga de ustedes.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000851",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Enemiga...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0011",head="sak_z1d",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000074",ch="skd"},
},
ja={
{
name={"Saki"},
"“Yo soy Saki Nakamura. Solo con el apellido basta para que entiendas, ¿no? Soy\nla esposa del hombre que ustedes tanto odian, Shoichi Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="man_kid_001169",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Enemigo de quién, por Dios? Si fuese así, no te hubieses tomado la molestia de\nvenir aquí y advertirnos.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0003",head="sak_z1d",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000075",ch="skd"},
},
ja={
{
name={"Saki"},
"“Creo haberme proclamado como enemiga tuya hace un buen tiempo...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="man_kid_001170",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tú lo dijiste, hace un buen tiempo. Ya se me olvidó.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="藍",mode=-1,lv=4,id=5},
{"fg",ch="紗希",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0003",head="sak_z1d",x2=345,x=0,lv=4,id=9},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0009",head="sak_z1d",x=0,lv=4,id=9},
{"fgact",ch="紗希",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000076",ch="skd"},
},
ja={
{
name={"Saki"},
"“Fuh... realmente no cambias nada...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="man_kid_001171",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y tú no has cambiado mucho tampoco, Saki. Sigues igual de hermosa que\nsiempre.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0003",head="sak_z1d",x=0,lv=4,id=9},
{"fgact",ch="紗希",act="うんうん",time=240,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0013",head="sak_z1d",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000077",ch="skd"},
},
ja={
{
name={"Saki"},
"“Sí, claro, claro. ¿Estás seguro de que puedes decir esa clase de cosas estando\nya casado con Mizuna-san?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="man_kid_001172",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Por qué no? Mizuna es más preciosa que tú.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0003",head="sak_z1d",x=0,lv=4,id=9},
{"fgact",ch="紗希",act="icon",lv=4,id=9,icon="icon05z1",x=40,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_skd_000078",ch="skd"},
},
ja={
{
name={"Saki"},
"“Kusanagi-kun... ¿Quieres que acabe con tu imagen pública?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_kid_001173",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué podría hacer la jefa de profesores del colegio Yumihari contra un artista\nde renombre internacional?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fgact",ch="紗希",act="停止",lv=4,id=9},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=0,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",x=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skd_000079",ch="skd"},
},
ja={
{
name={"Saki"},
"“Ah, respecto a eso, ya no soy jefa de profesores. Ahora soy subdirectora.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="man_kid_001174",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Es en serio? ¿Tan joven?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0011",head="sak_z1d",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000080",ch="skd"},
},
ja={
{
name={"Saki"},
"“Soy una Nakamura, ¿qué puedo decir?...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="man_kid_001175",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Mmmm. Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_kid_001176",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“En este momento no hay razón alguna para confrontación, Saki. ¿No podrías\nmostrarle a estas pequeñas los cerezos del lugar?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0008",head="sak_z1d",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000081",ch="skd"},
},
ja={
{
name={"Saki"},
"“No me costaría tanto hacerlo siempre y cuando no nos acompañes...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="man_kid_001177",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero soy yo quien está cuidando de ellas, obviamente tengo que estar. Ai es una\nniña todavía, además...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000082",ch="skd"},
},
ja={
{
name={"Saki"},
"“Yo me encargaré de cuidarlas. Ve y mata algo de tiempo en el café que hay\nbajando la colina, o donde sea.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001178",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Ehhh, ¿me van a dejar por fuera?!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0013",head="sak_z1d",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skd_000083",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Prefieres encontrarte entonces con Shoichi y poner en peligro\na estas muchachas?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="man_kid_001179",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“S-Si me dices eso...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"La mujer se llamaba Saki Nakamura.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Era una Nakamura, y ella misma decía que era nuestra enemiga. Pero era tan\namable y cariñosa que simplemente no lo parecía.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Era la jefa de profesores cuando Kenichiro-san trabajaba en el colegio\nYumihari, y parece que fue su superior.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Aunque fueron compañeros de clase en la universidad, según dijo.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_skd_000084",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Qué tal acá?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="man_kid_001180",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, el Templo Hakuki... Sí, los cerezos acá son realmente hermosos.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063e",path=":bg/",sync=0},
{"extrans",time=500},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1i0000",face="i0012",head="rin_z1i",x=-345,lv=4,id=5},
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003849",ch="rnd"},
},
ja={
{
name={"Rin"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Al ver el templo, Rin mostró una expresión de asombro.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003850",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kenichiro-san, ¿no te parece increíble? ¿No te parece increíble este lugar?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0006",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001181",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Increíble? No sabría decirte...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003851",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estos cerezos, realmente parecieran estar floreciendo sentimientos, ¿no lo ves?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0002",head="ken_z1b",x=345,lv=4,id=6},
{"fgact",ch="健一郎",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001182",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Sí? Pues bien que te haya gustado el lugar. Yo me iré a matar algo de tiempo\nal café de Sakuragahara, como Saki me lo sugirió.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_skd_000085",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿A cuál?",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001183",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“A Quimera. Llevo tiempo sin venir al país, y se me ocurrió ir a saludar a quien\ntú sabes.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_skd_000086",ch="skd"},
},
ja={
{
name={"Saki"},
"“Quimera, eh... No está mal, supongo...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0002",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001184",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así que te encargo a estas chiquillas.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_skd_000087",ch="skd"},
},
ja={
{
name={"Saki"},
"“No tienes que preocuparte por ellas. Dudo mucho que Shoichi Nakamura recuerde\ntodavía sus caras. No puedo decir lo mismo de la tuya, eso sí.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001185",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo. Pues te las encargo, entonces.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0008",head="rin_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003852",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kenichiro-san, ¿te vas?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=345,lv=4,id=6},
{"fgact",ch="健一郎",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001186",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vuelvo en un rato.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003853",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Está bien. Solo que quiero mirar los cerezos contigo.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0006",head="ken_z1b",x=345,lv=4,id=6},
{"fgact",ch="健一郎",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0009",head="ken_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_kid_001187",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Mmm, ¿mirar los cerezos contigo?... No sé si tenga la habilidad suficiente\npara eso...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_skd_000088",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿La habilidad suficiente? ¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0002",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0003",head="ken_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_kid_001188",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Justo como lo oíste. Bueno, cuida de las muchachas por mí, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="健一郎",mode=-1,lv=4,id=6},
{"bgm",stop=1,time=500},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Kenichiro regresó por el mismo camino por el cual habíamos\nvenido.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",x=345,lv=4,id=6},
{"bgm",file="bgm003"},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0010",head="rin_z1i",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0009",head="rin_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003854",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué lástima que se fuera. Quería jugar a adivinar qué sentimientos percibía de\ncada cerezo...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0014",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000089",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Sentimientos en los cerezos? Vaya que dices cosas fascinantes, eh... Aunque\nsí, ciertamente fue en este lugar donde se dice que nació la leyenda de\nHakuki.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0012",head="rin_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003855",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kenichiro-san también había hablado de eso. ¿Qué es la leyenda de Hakuki?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000090",ch="skd"},
},
ja={
{
name={"Saki"},
"“Una sacerdotisa que podía tragar sentimientos murió, y los sentimientos se\nconvirtieron en lluvia y cayeron sobre estas tierras, haciendo florecer estos\ncerezos, según dicen...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000091",ch="skd"},
},
ja={
{
name={"Saki"},
"“Tengo entendido que este templo fue construído justamente sobre el lugar donde\nla sacerdotisa murió.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003856",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mmm, ¿será por eso entonces? Los sentimientos más fuertes que he percibido\nvienen de estos cerezos.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0011",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000092",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Percibes sentimientos de estos cerezos?... Qué niña tan curiosa eres, eh...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="稟",mode=-1,lv=4,id=5},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0002",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000852",ch="aid"},
},
ja={
{
name={"Ai"},
"“Lo es, al parecer esta muchacha es la discípula de Kenichiro.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0007",head="sak_z1d",x=345,lv=4,id=6},
{"fgact",ch="紗希",act="びっくり",time=100,size=7,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000093",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Discípula? ¿La discípula de Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0001",head="aix_z1i",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000853",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0003",head="sak_z1d",x=345,lv=4,id=6},
{"fgact",ch="紗希",act="うんうん",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000094",ch="skd"},
},
ja={
{
name={"Saki"},
"“Jajajaja, ahora eso sí que es cómico. ¿Ese Kenichiro Kusanagi, ahora con una\ndiscípula? De verdad que no sé qué tiene en la cabeza ese hombre...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000854",ch="aid"},
},
ja={
{
name={"Ai"},
"“Saki-san, ¿eres cercana a Kenichiro?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000095",ch="skd"},
},
ja={
{
name={"Saki"},
"“Así como lo dije hace un rato, somos enemigos.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0005",head="aix_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000855",ch="aid"},
},
ja={
{
name={"Ai"},
"“No pareciera, la verdad. Más bien pareciera que dijeras eso por simple\namabilidad...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000856",ch="aid"},
},
ja={
{
name={"Ai"},
"“Como si intentarás hacer que te odiara...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0009",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0015",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000096",ch="skd"},
},
ja={
{
name={"Saki"},
"“Fuh, Mizuna era igual que tú. Todas las Natsume son así, muy perspicaces para\nsu edad...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0013",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000097",ch="skd"},
},
ja={
{
name={"Saki"},
"“Aunque no me hace mucha gracia eso, eh. No es buena idea que con esa edad te\ninmiscuyas mucho en asuntos de adultos. Deberías tomártelo a pecho, como lo\nharía un niño cualquiera.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0011",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000098",ch="skd"},
},
ja={
{
name={"Saki"},
"“Todos ustedes deberían odiarme... Por supuesto, Kenichiro Kusanagi también...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000857",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿No crees que Kenichiro quizás no piense así?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0003",head="sak_z1d",x=345,lv=4,id=6},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000099",ch="skd"},
},
ja={
{
name={"Saki"},
"“En realidad sí... Una vez incluso me agarró del cuello de la camisa... Me dijo\nque si yo fuera un hombre, me hubiese golpeado...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000858",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Sí?...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000100",ch="skd"},
},
ja={
{
name={"Saki"},
"“Sí, eso llegó a pasar...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0003",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000859",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aunque yo creo que todavía le agradas a Kenichiro, Saki-san.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000101",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Quién sabe?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0002",head="aix_z1i",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000860",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues yo solo dije lo que sentí, como un niño normal lo haría. Simplemente\nexpresé lo que se me vino a la mente.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0003",head="sak_z1d",x=345,lv=4,id=6},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000102",ch="skd"},
},
ja={
{
name={"Saki"},
"“Jaja... Un niño normal y cualquiera no diría eso.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000861",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eso cree?... Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0003",head="sak_z1d",x=345,lv=4,id=6},
{"fgact",ch="紗希",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000103",ch="skd"},
},
ja={
{
name={"Saki"},
"“Fufufu... Aunque debo decir que me gustan las niñas inteligentes.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0011",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000104",ch="skd"},
},
ja={
{
name={"Saki"},
"“Escuché hace un rato que querías ingresar a este colegio... ¿Es eso cierto?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0001",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="うなづく",lv=4,id=5},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0011",head="aix_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000862",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, sí... aunque bueno, ya sé que no es posible...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000105",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Por qué acá?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0011",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000863",ch="aid"},
},
ja={
{
name={"Ai"},
"“Es el colegio donde Mizuna nee-sama se graduó... y también, el lugar donde\nconoció a Kenichiro... Quizás por eso, supongo.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",x=345,lv=4,id=6},
{"fgact",ch="紗希",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000106",ch="skd"},
},
ja={
{
name={"Saki"},
"“Ya veo... Sí, ciertamente, la residencia Natsume nació gracias a que esos dos\nse conocieron...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000864",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero por ninguna razón debo ingresar a esta institución...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0014",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000107",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Y eso por qué?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0005",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000865",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tú misma lo dijiste, Saki-san... Porque somos enemigos...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",x=345,lv=4,id=6},
{"fgact",ch="紗希",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000108",ch="skd"},
},
ja={
{
name={"Saki"},
"“Ya veo... sí, ciertamente lo somos...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000109",ch="skd"},
},
ja={
{
name={"Saki"},
"“Aunque, ¿no se te hace interesante la idea de atreverte a ingresar a la guarida\ndel enemigo?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000866",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eso crees? Yo creo que sería bastante difícil.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000110",ch="skd"},
},
ja={
{
name={"Saki"},
"“Sí, lo sería... Tanto para ti, como para mí...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0010",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000867",ch="aid"},
},
ja={
{
name={"Ai"},
"“Entonces no hay manera de que pueda ingresar, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0011",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000111",ch="skd"},
},
ja={
{
name={"Saki"},
"“No niego que habrían muchas dificultades para ambas, pero imposible no es.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="びっくり",time=100,size=7,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000868",ch="aid"},
},
ja={
{
name={"Ai"},
"“P-Pero seguramente me reprobarán apenas vean mi nombre...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000112",ch="skd"},
},
ja={
{
name={"Saki"},
"“Esos son asuntos de adultos.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0011",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000869",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero por esos asuntos es que no tengo forma de ingresar, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0013",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000113",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿No te lo acabo de decir? Los niños no tienen por qué preocuparse por asuntos\nde adultos.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000114",ch="skd"},
},
ja={
{
name={"Saki"},
"“La única dificultad que tienes en esto es poner en orden lo que quieres hacer.\nEn lo que respecta al ambiente escolar, te puedo prometer que me encargaré de\nque puedas disfrutar de tu vida escolar como un estudiante cualquiera.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000870",ch="aid"},
},
ja={
{
name={"Ai"},
"“P-Pero...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000115",ch="skd"},
},
ja={
{
name={"Saki"},
"“Nada permanece igual para siempre... Puedes estar segura de que cuando\ningreses, muchas cosas habrán cambiado...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0005",head="sak_z1d",x=345,lv=4,id=6},
{"fgact",ch="紗希",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000116",ch="skd"},
},
ja={
{
name={"Saki"},
"“Yo misma me encargaré de cambiarlas... Haga lo que tenga que hacer...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0013",head="aix_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000871",ch="aid"},
},
ja={
{
name={"Ai"},
"“Saki... san, eso quiere decir que...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0003",head="sak_z1d",x=345,lv=4,id=6},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000117",ch="skd"},
},
ja={
{
name={"Saki"},
"“Fufufu, espero que mantengas eso en secreto. Se supone que somos enemigas,\n¿recuerdas? No es nada fácil meter al enemigo al colegio.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0003",head="aix_z1i",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000872",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0002",head="aix_z1i",x=-345,lv=4,id=5},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0003",head="sak_z1d",x=345,lv=4,id=6},
{"fgact",ch="紗希",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000118",ch="skd"},
},
ja={
{
name={"Saki"},
"“Linda sonrisa. Así es, Ai. Así de inocente debe ser una niña como tú.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000119",ch="skd"},
},
ja={
{
name={"Saki"},
"“¿Sabes?... Me he dado cuenta que a diferencia de Kusanagi-kun, la educación me\nsienta mejor... o al menos eso creo...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0001",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000873",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿La educación?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0011",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000120",ch="skd"},
},
ja={
{
name={"Saki"},
"“Ya han pasado 10 años desde que comencé a trabajar en este colegio... y aún me\nparece mentira que estudié junto a él...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0010",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0004",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000121",ch="skd"},
},
ja={
{
name={"Saki"},
"“En ese época tenía la ilusión de que quizás podría mirar el mismo horizonte que\nél podía ver... pero ahora no.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0011",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0001",head="sak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000122",ch="skd"},
},
ja={
{
name={"Saki"},
"“Su horizonte y el mío son completamente distintos. Y me siento orgullosa de\neso...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0005",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000123",ch="skd"},
},
ja={
{
name={"Saki"},
"“Y por eso mismo no hace falta que te ocupes de pensar en los ridículos asuntos\nde adultos. Ten por seguro que me encargaré de convertir a Yumihari en un\ncolegio al cual tú también puedas asistir...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=-345,lv=4,id=5},
{"fgact",ch="藍",act="うなづく",time=100,size=5,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000874",ch="aid"},
},
ja={
{
name={"Ai"},
"“S-Saki-san...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0003",head="sak_z1d",x=345,lv=4,id=6},
{"fgact",ch="紗希",act="うんうん",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0003",head="sak_z1d",x=345,lv=4,id=6},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_skd_000124",ch="skd"},
},
ja={
{
name={"Saki"},
"“Ajajaja, creo que hablé de más. Olvida lo que acabas de escuchar, realmente no\nfue nada.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0002",head="aix_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000875",ch="aid"},
},
ja={
{
name={"Ai"},
"“Yo... intentaré entrar a Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1d0000",face="d0002",head="sak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skd_000125",ch="skd"},
},
ja={
{
name={"Saki"},
"“Muy bien...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Mientras contemplaba la conversación de las dos, sentí por un instante que la\nsensación de los cerezos había cambiado.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Como si hubieran reaccionado a algo...",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="fem_szd_001066",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Y mientras veía los cerezos, Rin se acercó a hablarme.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0005",head="rin_z1i",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003857",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mmm, ¿qué habrá sido eso?... Justo ahora se sintió como si los sentimientos de\nlos cerezos se acentuaran...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"¿Habrá sentido Rin lo mismo que yo?...",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_szd_001067",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Cómo es que lo puedes sentir, Rin?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0008",head="rin_z1i",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003858",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Que cómo? Es difícil decirlo...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003859",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku-chan, Shizuku-chan. Siéntate aquí.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Al decir eso, Rin dio unas palmaditas sobre el lugar vacío a su lado.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_szd_001068",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Bueno...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"se",file="se9010",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-360,file="zbg063e",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2i0000",face="i0001",head="rin_z2i",lv=5,id=5,sync=0},
{"extrans",time=500},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0005",head="rin_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003860",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De qué manera las personas percibirán los sentimientos de los demás?\nNormalmente sería por la expresión de sus caras, o el tono de sus voces,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_szd_001069",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Tú no?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002",head="rin_z2i",lv=5,id=5},
{"fgact",ch="稟",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003861",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es. Yo los veo como colores.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_szd_001070",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Colores?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0001",head="rin_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003862",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Todo lo veo como colores.... no solo sentimientos, también sonidos. Por eso es\nque cuando escucho música puedo percibir todos los sentimientos del vocalista\na través de colores.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002",head="rin_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003863",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mis ojos lo perciben todo... como un rico gradiente de colores.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_szd_001071",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ojos... Rin, tus ojos son especiales.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0008",head="rin_z2i",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0003",head="rin_z2i",lv=5,id=5},
{"fgact",ch="稟",act="びっくり",time=100,size=7,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003864",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso crees? La verdad es que no lo sé... Ah, lo olvidaba. Shizuku-chan, hay\nalgo que quería ver contigo bajo estos cerezos.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002",head="rin_z2i",lv=5,id=5},
{"fgact",ch="稟",act="うなづく",lv=5,id=5},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Rin abrió un álbum.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_szd_001072",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Un álbum?”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002",head="rin_z2i",lv=5,id=5},
{"fgact",ch="稟",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003865",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Este álbum contiene varios de mis recuerdos. Y así como estos cerezos...\nbrillan con distintos colores...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0001",head="rin_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003866",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Dependiendo del momento, a veces cambian de color.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002",head="rin_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003867",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y por eso quería verlos debajo de estos cerezos.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Rin abre el álbum. Adentro habían fotos con su padre, y con su madre. Estaba\nrepleto de ese día a día que tanto amaba.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Yo soy Hakuki.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Puedo tragar los corazones de las personas.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Pero no puedo verlos como hermosos colores, como ella lo hace.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Y a pesar de eso, siento que pude ver un poco de esos colores. De la fuente de\nsus pinturas.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_szd_001073",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Quién es este niño?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0012j",head="rin_z2i",lv=5,id=5},
{"fgact",ch="稟",act="びっくり",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0010j",head="rin_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003868",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, ¿é-él? E-Esto...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Rin agacha la cabeza, avergonzada.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_szd_001074",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Siento que lo he visto en algún lugar...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002i",head="rin_z2i",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0003i",head="rin_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003869",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sí? Tal vez. Es el hijo de Kenichiro-san, se llama Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_szd_001075",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0016i",head="rin_z2i",lv=5,id=5},
{"fgact",ch="稟",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003870",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, Naoya Kusanagi. Es un artista con aires muy curiosos, completamente\ndistinto a Kenichiro-san.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_szd_001076",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Artista? ¿A esta edad?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002i",head="rin_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003871",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así lo veo yo, como un artista. Y de lo que tengo conocimiento, es el artista\ncon el color más misterioso que he percibido hasta ahora...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0005i",head="rin_z2i",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002i",head="rin_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003872",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pareciera estar bastante cerca a Kenichiro-san, pero también pareciera estar\nmuy alejado... Es alguien realmente extraño...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0003i",head="rin_z2i",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0018i",head="rin_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003873",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kenichiro-san cambia cuando toma un pincel en sus manos, ¿sabías? Su cuerpo\nempieza a desprender un increíble gradiente de colores...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0001i",head="rin_z2i",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002i",head="rin_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003874",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero Nao-kun es diferente. En todo momento brilla con un deslumbrante color...\nSiempre desprende colores, aun sin tener pincel alguno en sus manos. Es un\nartista que brilla siempre con una luz al estilo de los cerezos\ndispersándose.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0004i",head="rin_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003875",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y por eso lo veo a él como el 'artista de los cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002i",head="rin_z2i",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0018i",head="rin_z2i",lv=5,id=5},
},
vl02={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0004i",head="rin_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003876",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sabes qué me dijo Kenichiro-san cuando le conté eso? Pues entonces pintaré\nunos cerezos que ni en sus sueños pueda pintar él, y tomaré ese titulo para\nmí. Está algo loco, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0005i",head="rin_z2i",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002i",head="rin_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003877",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero la luz de Nao-kun pareciera estar dispersándose. Es como, transitoria...\nQuizás en eso también se parezca a los cerezos...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0003i",head="rin_z2i",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002i",head="rin_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003878",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Me pregunto qué clase de pinturas crea normalmente? Algún día me gustaría\npintar con él.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_szd_001077",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Algún día? ¿Por qué no ahora?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0001i",head="rin_z2i",lv=5,id=5},
{"fgact",ch="稟",act="うなづく",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002i",head="rin_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003879",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No creo que pueda hacerlo sin antes obtener bastante poder. De lo contrario,\npodría terminar perdiéndome a mí misma.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_szd_001078",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Vaya... Así de increíble es ese Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0004i",head="rin_z2i",lv=5,id=5},
{"fgact",ch="稟",act="うなづく",time=100,size=5,lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0016i",head="rin_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003880",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejejeje, Kenichiro-san dice que lo sobrestimo mucho. Pero me parece que solo\nson celos.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002i",head="rin_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003881",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Porque siempre estoy hablando bien de él.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_szd_001079b",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Cuando hablas de Naoya, el tono de tu voz cambia, Rin...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0012j",head="rin_z2i",lv=5,id=5},
{"fgact",ch="稟",act="びっくり",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0005j",head="rin_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003882",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿E-En serio?... No lo creo...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_szd_001080",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Mira... La sensación de los cerezos cambió...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0012j",head="rin_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003883",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Jaa?! T-Tienes razón. Los colores están cambiando...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="fem_szd_001081",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No puedo ver ningún color... pero creo que están reaccionando a tus\nsentimientos.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0001j",head="rin_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003884",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002",head="rin_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003885",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo, estos cerezos... los veo, como varios sentimientos brillando como\nlámparas... Como luces que se superponen, creando la luz de causalidad\nenlazada que produce a este mundo...”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0001",head="rin_z2i",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0016",head="rin_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003886",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun brilla con una luz de causalidad enlazada mucho más fuerte que los\ndemás. En eso es diferente a mí...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0003",head="rin_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003887",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quisiera que algún día, mi pintura y la suya se enlacen, y de la casualidad\nformada se plasme este mundo.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0004",head="rin_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003888",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero es por eso mismo que todavía no es el momento...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"La verdad es que aún no entiendo la razón por la cual Rin me mostró ese álbum.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"Quizás solo quería contarme lo que su intuición le dijo.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Y fue en eso que los colores de los sentimientos de Rin comenzaron a\ntransformar incluso mi propio corazón.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"Rin, como artista. Y Naoya Kusanagi, el muchacho del cual tanto me hablaba.\nHasta que en cierto momento, mi corazón comenzó a sentirse atraído por el\nmuchacho del cual solo había escuchado de su boca.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Probablemente fue la fuerte influencia de Rin lo que me hizo recuperar ese\nmismo corazón.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Pasaron los años.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Rin no había podido darle forma a los cerezos todavía. Pero gracias a esa\ncuriosa muchacha, yo estaba pasando poco a poco de ser la Hakuki sin corazón,\na una muchacha normal como los demás.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Todo hubiese salido bien de seguir las cosas así.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Pero sucedió 'eso'.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"bg",file="ev_uni_c35_01",path=":ev/ev_uni_c35/",set="ev_uni_c35"},
{"bgm",file="bgm026"},
{"ex",time=1500,func="wait"},
{"bg",file="ev_uni_c36_01",path=":ev/ev_uni_c36/",set="ev_uni_c36"},
{"ex",time=1500,func="wait"},
{"bg",file="ev_com_c08_02",path=":ev/ev_com_c08/",set="ev_com_c08"},
{"ex",time=1500,func="wait"},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Y desde entonces, Rin estuvo viviendo pensando que una muñeca era su madre.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Todos creían que lo débil de su mente la hizo así. Incluso el propio\nKenichiro...",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Pero Rin me dijo esto a mí.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003889",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si tan solo logro dar con la imagen, sea solo un pelo, un pedazo de uña, una\núnica célula.\nSolo con dar con eso, quizás pueda lograrlo...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003890",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Podré dibujar algo de la nada...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"¿Por qué? Le pregunté yo.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003891",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sabes? Mis sentimientos... cada vez que emiten colores... los cerezos de la\ncolina brillan...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"¿Los cerezos?",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003892",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, los cerezos de Yumihari... Probablemente son los cerezos milenarios...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003893",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Los cerezos que jamás florecen, están ahora... pidiendo mi poder...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Tampoco pude entender el significado de esas palabras.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Quizás Kenichiro sí hubiera podido entenderlas...",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"Pero Rin no le contó nada.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Rin llevaba siempre el álbum de su madre consigo, para poder sentirla siempre\ncerca.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"El padre de Rin, quien pensó que la razón por el extraño comportamiento de su\nhija era ese álbum, arrancó todas las fotos de su madre.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"A pesar de eso, Rin no se despegaba del álbum.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Ella podía sentir fotos que no habían adentro.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Y eso resultó, inevitablemente, en esa noche.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Era una noche de verano. Rin levantó su pincel.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Y puso pies sobre ese lugar.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"msgoff"},
{"ex",time=1000,func="wait"},
{"excall",file="03_andoe_04_4"},
{"text"},
linkback="block_00227",
},
label = {
top={block="block_00000",label=1},
},
}
