astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c08_01",path=":ev/ev_eye_c08/",set="ev_eye_c08"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_eye_c10_01",path=":ev/ev_eye_c10/",set="ev_eye_c10"},
{"ex",time=3000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="ev_uni_c28_01",path=":ev/ev_uni_c28/",set="ev_uni_c28"},
{"bgm",file="bgm019"},
{"text"},
text={
ja={
{
"El bosque de Zypressen.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Aquella noche, por alguna razón, Rina me pidió que viniera al parque del bosque\nde cipreses.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"No tengo cuchillo alguno en mi bolsillo.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Ese mismo cuchillo que hizo retorcer del miedo el rostro de aquella muchacha de\núltimo año.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Ya no tengo ninguno.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"La yo de hace años le tenía terror al parque de noche, y por eso no podía dejar\nde empuñar el cuchillo que cargaba en el bolsillo.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_yum_002869",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Las personas le temen a la noche...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Pero la noche no es solo terror.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Mientras contemplaba absorta la vista nocturna del lugar--",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Por un instante, mis ojos captaron algo blanco desaparecer dentro del bosque de\ncipreses.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Mi corazón dio un fuerte sobresalto.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Sentí algo de calor en mi mano apretada.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"¿Un fantasma?",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Obviamente no.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Ah, qué nostálgica esta sensación.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Aquel día, aparte de miedo, también sentí algo de placer. Muy probablemente.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Me doy cuenta de eso ahora.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg081c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0000",face="a0012",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001139",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vaya, no tardaste nada en encontrarme.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_yum_002870",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Estabas intentando esconderte?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0002",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001140",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, pensé en darte un susto.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="fem_yum_002871",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0008",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001141",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque ya no hay ningún juego aquí... No hay lugar alguno para esconderse...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_yum_002872",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y por qué no los cipreses?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0010",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001142",ch="rna"},
},
ja={
{
name={"Rina"},
"“Los cipreses no están para esconder a personas todavía con vida...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_yum_002873",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Sí?...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0001",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001143",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_yum_002874",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No entiendo muy bien por qué.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0002",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001144",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo supuse.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Al decir eso, Rina comenzó a caminar.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0008",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001145",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aquí es donde estaba aquel domo.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_yum_002875",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"No quedaba rastro alguno del domo. Solo había hierba.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0002",head="rna_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001146",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bastante que veíamos el cielo desde la cima del domo, ¿recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_yum_002876",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0003",head="rna_z1a",lv=4,id=9},
{"fgact",ch="里奈",act="うんうん",time=200,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001147",ch="rna"},
},
ja={
{
name={"Rina"},
"“Oye, oye... ¿Sabías que las estrellas también se pueden ver de esta forma?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"bg",time=500,sync=0,file="ev_uni_c28_01",path=":ev/ev_uni_c28/",set="ev_uni_c28"},
{"quake",size=5},
{"se",file="se_bafu",id=1},
{"text"},
text={
ja={
{
"Rina me tira al suelo.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_yum_002877",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“M-Me has tirado al suelo...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_rna_001148",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_rna_001149",ch="rna"},
},
ja={
{
name={"Rina"},
"“Las estrellas se pueden ver así también, tumbadas sobre el suelo.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_yum_002878",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Supongo que sí, pero solo puedo verte a ti ahora.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_rna_001150",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí? ¿Me hago a un lado?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_yum_002879",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No lo hagas...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_yum_002880",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No necesito las llamas azules del chotacabras ni las llamas rojas del\nescorpión.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_yum_002881",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No necesito hermosas estrellas brillando con culpa...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_rna_001151",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_yum_002882",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Siempre estuve viéndote a ti, Rina. Más que a las estrellas...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_rna_001152",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Incluso aquel día?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_yum_002883",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Incluso aquel día.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_rna_001153",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así que no escuchaste nada de lo que te estaba diciendo.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_yum_002884",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tus temas de conversación son siempre complicados...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_rna_001154",ch="rna"},
},
ja={
{
name={"Rina"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_yum_002885",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero... me gusta cuando hablas de temas complicados...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Le di un beso a Rina.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_rna_001155",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me has besado...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="fem_yum_002886",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_rna_001156",ch="rna"},
},
ja={
{
name={"Rina"},
"“Dios, ¿es que acaso la conversación y la atmósfera se prestaba para llegar a\neso?...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_yum_002887",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, creo. Al menos yo estoy excitada...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_rna_001157",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mmmm, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_yum_002888",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Pasa algo, Rina?... Pareces, estar de mal humor...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_rna_001158",ch="rna"},
},
ja={
{
name={"Rina"},
"“De mal humor, eh. Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_yum_002889",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿Por qué? ¿Es que hice algo?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_rna_001159",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Pin pon! ¡Pin pon!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_yum_002890",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_rna_001160",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es, es tu culpa, Yuumi... Eres la única capaz de agitar tanto mi pecho...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_yum_002891",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿P-Por qué?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_rna_001161",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues... quizás porque te ves demasiado tierna últimamente... ¿tal vez?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_yum_002892",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_rna_001162",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Tan linda que te has ganado la popularidad de todos.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_yum_002893",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“C-Claro que no, tampoco así. Solo que pensé que te causaría molestias que yo\ntrate de manera fría a todos, y por eso estoy intentando tratarlos algo\nmejor, a mi forma...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_rna_001163",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me alegra que te lleves bien con todos, pero... ¿Ah, Por qué será? Hay algo en\neso que no me gusta mucho.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_yum_002894",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina, no digas eso, yo... yo soy solo tuya. Todo lo hago solo porque quiero\ngustarte más.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_rna_001164",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo sé, lo sé.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_yum_002895",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero, jamás pensé que llegarías a decirme algo así...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_rna_001165",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Se te hace extraño?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_yum_002896",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí... bastante... Es casi como――”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_rna_001166",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Casi como?...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_yum_002897",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A la lejanía de la noche de otoño había un arroyo, repleto solo de guijarros.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_yum_002898",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y sobre él brillaba el sol, suave, suavemente.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_yum_002899",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero ese sol era como sílice, como el polvo de alguna atípica cosa.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_yum_002900",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y es por eso que brillaba suavemente, pero también soltando un leve sonido, así\ncomo shhh.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_yum_002901",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Una mariposa se posa sobre uno de los guijarros, efímera, pero con una clara\nsombra.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_yum_002902",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y entonces, la mariposa desapareció, y en el seco cauce comenzó a correr agua,\nasí como shhh, shhh...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_rna_001167",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso es de...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_yum_002903",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Chuuya Nakahara...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_rna_001168",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, lo sé. Bastantes veces he leído ya 'Poemas de días pasados'...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_rna_001169",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué lo tatareaste?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_yum_002904",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No lo hice con ningún propósito... Además, ni siquiera entiendo bien lo que se\ndice en el poema...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_rna_001170",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo tatareaste aun sin saber en lo absoluto de qué va...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_yum_002905",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_rna_001171",ch="rna"},
},
ja={
{
name={"Rina"},
"“Cuando lo leí me pareció que encajaba muy bien con alguien...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_yum_002906",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Hundo mi cara en el pecho de Rina.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Una noche de otoño.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"En algún lugar lejano.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Brilla el sol con suavidad, en medio de la noche...",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"'Ein Märchen' - Un cuento de hadas.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Esto es un cuento de hadas.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"De esa manera lo vi.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Las noches de otoño son distintas a las de verano.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Los tifones destrozan el verano y traen consigo los vientos de otoño.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Y es por eso que aquella noche de verano se esfumó a algún lugar.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Me aferré al pecho de Rina.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Comencé a temblar entre su piel.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Rina soltó una sonrisa un tanto apenada y me preguntó: '¿Qué sucede?'.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Todo es un cuento de hadas.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Único, y sin igual.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bgm",stop=1,time=2000},
{"bg",time=3000,file="black",path=":bg/"},
{"ex",time=2000,func="wait"},
{"bg",file="ev_com_e02_01",time=1500,sync=1,path=":ev/ev_com_e02/",set="ev_com_e02"},
{"bgm",file="bgm021"},
{"text"},
text={
ja={
{
"Pasó el tiempo.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"No he vuelto a tener aquel sueño desde ese día.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"¿Será, quizás, que ya de nada sirve?...",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Si esos sueños fueron obra de los cerezos milenarios, entonces,",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"¿Quizás esos sueños que por un milenio estuvieron durmiendo se pudrieron\ntodavía siendo solo unos capullos?",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"De ser así, entonces los cerezos milenarios no son la gran cosa...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_yum_002907",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tal vez un milenio fue demasiado...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Me causaba algo de curiosidad la Hakuki que apareció en mis sueños. Pero todo\nfue cuestión de un lejano pasado, o tal vez solo de un simple sueño,",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"así que el interés no fue mucho que digamos.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_yum_002908",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ahh, otoño~”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"El cielo de otoño se ve enorme.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Sus nubes huyen más y más a lo alto.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Viendo el cielo desde la azotea, me encontré a dos personas bajando la colina\nde Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_yum_002909",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Son Kusanagi-senpai y Rin-senpai...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"¿Estarán regresando juntos a casa?",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"¿O es que irán a proseguir con la obra para la Exposición Moore?",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"No lo sé. Mientras pienso todo esto los dos van bajando la colina, alejándose\ncada vez más.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_yum_002910",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Habrá sido esto lo mejor?...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_yum_002911",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿O tal vez no?...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bg",file="ev_com_e02_02",sync=0,face=1,time=400,path=":ev/ev_com_e02/",set="ev_com_e02"},
{"text"},
text={
ja={
{
"Tomo en mis manos la silueta de ambos.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"No había sensación alguna de los dos,",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"simplemente el doloroso apretón de mis uñas.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Recordé entonces las palabras de Rina.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_yum_002912",ch="yum"},
},
ja={
{
name={"Yuumi"},
"'Cuando lo leí me pareció que encajaba muy bien con alguien...'",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_yum_002913",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"bg",file="ev_com_e02_03",sync=0,face=1,time=400,path=":ev/ev_com_e02/",set="ev_com_e02"},
{"text"},
text={
ja={
{
"Al abrir mis manos ya no había nadie allí.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Desaparecieron de mis manos.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Lancé entonces un suspiro.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"bg",file="ev_com_e02_04",sync=0,face=1,time=400,path=":ev/ev_com_e02/",set="ev_com_e02"},
{"se",file="se9010",vol=30,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_002914",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y en altruista me convertí, pero no es mucho lo que pueda hacer igual.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_yum_002915",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Leer más libros que antes, tratar mejor a los demás.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_yum_002916",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Caminatas, a buen ritmo. Hacer trenzas de paja, con fervorosa devoción――”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_yum_002917",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Como un soldadito de juguete. Como si todos los días fueran domingo.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_yum_002918",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lentas caminatas entre el sol del templo, una sonrisa para cada conocido que me\nencuentro.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_yum_002919",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Una amistad con el viejito de los dulces, un momento para darle comida a las\npalomas.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_yum_002920",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y si se hace muy fuerte el sol, me doy un rato para reposar en la sombra, y\nobservar con tranquilidad la tierra, los árboles y las plantas.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_yum_002921",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fresco musgo, un día indescriptiblemente hermoso.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_yum_002922",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y por muy lento que caminen los visitantes, no me irrito ni un poco.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_yum_002923",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y es que la vida es realmente un sueño de un instante, efímera y bella como un\nglobo.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_yum_002924",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Que vuela al cielo, brilla y desaparece―― Eh, ¿cómo estás?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_yum_002925",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tiempo sin verte, ¿cómo has estado después de aquello? ¿Te parece si vamos por\nalgo de té?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_yum_002926",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Con entusiasmo nos metimos en una cafetería, pero vaya, que no había mucho de\nqué hablar tampoco.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_yum_002927",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo echar humo de nuestros cigarros, mientras allí estábamos. Para luego\narmarme de valor, y――”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_yum_002928",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Pero qué movida está la calle!―― Dale mis saludos a tu señora.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_yum_002929",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y hazme saber de ti cuando estés en el extranjero. Procura no beber mucho.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_yum_002930",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y así como carruajes, también pasan trenes. La vida es, realmente, como una\nnovia por casarse.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_yum_002931",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Que brilla, hermosa y tímida, con la cabeza echada hacia abajo, pero que quizás\nte crispe cuando hable.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_yum_002932",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero aun así, le da paz y serenidad al corazón de uno. La vida es, realmente,\ncomo una novia por casarse.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_yum_002933",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_yum_002934",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bien, damas y caballeros, sin excesivo júbilo, sin mucha tristeza, démonos las\nmanos, a buen ritmo.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_yum_002935",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y sepan que, al fin y al cabo, honestidad y rectitud es lo que nos falta.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_yum_002936",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así que señores, todos juntos―― Démonos las manos, a buen ritmo.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_yum_002937",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_yum_002938",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... Adiós, inútil...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bg",file="ev_com_e02_05",sync=0,face=1,time=400,path=":ev/ev_com_e02/",set="ev_com_e02"},
{"text"},
text={
ja={
{
"Lancé el libro desde la azotea.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"eval",exp="g.clear_mar=1"},
