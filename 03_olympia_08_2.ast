astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="black",path=":bg/"},
{"bgm",file="bgm026"},
{"text"},
text={
ja={
{
"Me descuidé demasiado.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"No pensé que las cosas terminarían de esta forma en el corto tiempo que estuve\nafuera...",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Le avisé a la enfermera que Rin había despertado, y me dijeron que esperara\nallí por un momento.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Seguramente la enfermera dijo eso sin pensarlo mucho. Y así como ella, yo\ntambién obedecí esa orden sin considerarlo tanto.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Pude haber regresado a la habitación de una vez.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Sin embargo, me quedé como un idiota esperando en el pasillo a que viniera el\ndoctor, despreocupadamente.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"No pensé que se aprovecharía del momento en que salí para entrar a la\nhabitación.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Definitivamente, bajé la guardia por completo.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Me vanaglorié.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Prometiendo que protegería a Rin. Y aun así...",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Para cuando había regresado a la habitación, ambas estaban paradas, inertes,\ncomo dos fantasmas.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg067a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡I-Imbécil! ¡¿Qué mierda estás haciendo?!”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000158",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Vaya? Regresaste rápido, Naoya-kun.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Q-Qué estabas...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003204",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo, yo, yo, yo...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“R-Rin.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"La sombra de Rin se agitó lentamente.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Me di cuenta al instante que Rin no lucía normal.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"se",file="se3130",id=1},
{"fg",mode=-2},
{"bg",y=30,speed=200,sync=0,file="zbg067a",path=":bg/",x2=0,y2=30,x=-200,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="香奈",size="z2",speed=200,sync=0,mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0100",face="a0002",head="kan_z2a",x2=200,x=0,lv=5,id=9},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Nagayama! ¡¿Qué le hiciste a Rin?!”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0016",head="kan_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000159",ch="knd"},
},
ja={
{
name={"Kana"},
"“Nada en especiaaal. Simplemente hablamos un poco de los viejos tiempos...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hablar... de los, viejos tiempos?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Al lado de la almohada de la cama de Rin, estaba tirada una copia impresa.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Ese artículo era...",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Nagayamaaaa! ¡Maldita!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_002320_n",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡IYaaAAAaaAhh!”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡R-Rin!”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg067a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",id=1,file="gatya"},
{"se",file="se0744s",id=2},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Guh...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Rin salió corriendo con fuerza.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Perdí un poco el equilibrio después de que chocara conmigo, y no pude\natraparla.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin! ¡Espera!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0015",head="kan_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000160",ch="knd"},
},
ja={
{
name={"Kana"},
"“Vaya, ¿qué le habrá pasado? Tan solo vine a expresarle mis palabras de\nagradecimiento, y de repente ahora se vuelve loquita. ¿Estará bien?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000161",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, ¿será esa sensación de culpabilidad de la que tanto ha huido hasta ahora?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ghh.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"bg",time=200,file="white",path=":bg/"},
{"bgm",file="bgm109"},
{"text"},
text={
ja={
{
"Tenía la cabeza en blanco ahora.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Jamás en vida llegué a pensar que eso que llaman 'ira' pudiera corroer de esta\nmanera todo mi ser...",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Lo único que pensé en ese momento, es que podría matarla ahora.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Y por eso es que levanté mi puño con una fuerza increíble, usando el impulso\nque la misma ira me daba.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg067a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0014",head="kan_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="香奈",act="いいえ",loop=-1,size=5,time=300,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000162",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? Esp--, s-soy una chica. N-Naoya-kun, mira nada más lo alto y grande que\neres. T-Tienes que estar mintiendo, ¿verdad? Ajaja, e-es, es una broma,\n¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fgact",ch="香奈",act="停止",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una broma? Fuiste tú quien hizo algo que ya pasó de ser una simple broma... ¿O\nno, Nagayama?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0014",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000163",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? ¿Espera, es en serio? ¿Eh? ¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="香奈",size="z2",mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0200",face="a0014",head="kan_z2a",lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
{"se",file="se3130",id=1},
{"text"},
text={
vo={
{"vo",file="fem_knd_000164",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿H-Hiiiii?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bgm",stop=1,time=500},
{"fg",mode=-2},
{"bg",rule=014,time=80,file="white",path=":bg/"},
{"quake"},
{"quake",mode="mw"},
{"se",id=1,file="honeore"},
{"text"},
text={
ja={
{
"Un sonido de algo resquebrajándose.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"El sonido de los huesos rompiéndose y la carne cortándose.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"No es el sonido de un golpe.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Simplemente el sonido de la carne resquebrajándose resuena en la habitación.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"bg",file="ev_uni_c44_01",path=":ev/ev_uni_c44/",set="ev_uni_c44"},
{"bgm",file="bgm028"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi brazo derecho no es más que una masa bruta de carne y hueso, Nagayama...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y es una basura tan inútil, que puedo destrozarlo con el concreto así como\nestoy haciendo ahora, sin ningún problema.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Su fuerza de agarre no llega ni a un tercio de lo que era...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Podría golpearte una y otra vez con los huesos de mis dedos, hasta que de la\nfractura compuesta de mi brazo sobresalgan los huesos. Luego podría volverte\nmierda la cara con ellos.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi brazo derecho solo sirve para eso...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg067a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0100",face="a0020",head="kan_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"fg",ch="香奈",my=40,mode=-1,lv=5,id=9},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000165",ch="knd"},
},
ja={
{
name={"Kana"},
"“H-Hiiiiiii...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Nagayama se desmorona en ese lugar.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Me duele el brazo derecho.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"No, ni siquiera siento los dedos.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Pero mejor así.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"El dolor me calmó un poco la ira.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Si no hubiera sido así...",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hubiera terminado matándote...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_knd_000166",ch="knd"},
},
ja={
{
name={"Kana"},
"“N-No digas... e-esas cosas, t-tan aterradoras, por favor...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Nagayama! ¡Si algo llega a sucederle a Rin, no te quepa la más mínima duda de\nque te mataré!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Que no se te olvide, Nagayama! ¡Te mataré, y lo digo en serio!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_knd_000167",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡S-Sí!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Aún tenía muchas cosas que quería decirle, pero no tengo tanto tiempo como para\neso.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Veo hacia afuera a través de la ventana.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Aún se puede ver a Rin corriendo a lo lejos.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tch.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué demonios estoy haciendo? Se supone que no solo protegería su cuerpo,\nsino también su corazón. ¡Se supone que esta vez sí la protegería como debe\nser! ¡¿O no?!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"No es momento de andar lamentándome.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"se",id=1,file="se1662"},
{"msgoff"},
{"bg",file="nightsky_summer",time=500,id=1,lv=5,path=":cg/"},
{"cgact",file="nightsky_summer",act="うなづく",id=1,lv=5},
{"ex",time=50,func="wait"},
{"text"},
text={
ja={
{
"Salto por la ventana.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"se",id=1,file="se3356"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Eran dos pisos.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Supongo que salté con mucha fuerza... Me dañé un poco los tobillos.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Diablos, ¿pero para qué se supone que entreno con regularidad?... ¡Vaya pedazo\nde chatarra que tengo por cuerpo, maldita sea!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"se",file="se0744",id=1},
{"text"},
text={
ja={
{
"Salgo corriendo.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Un fuerte dolor corre por mis tobillos, pero no puedo prestarle atención a eso\nahora.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Persigo a Rin.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"se",stop=1,time=500,id=1},
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="znightsky_summer",speed=300000,time=500,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=-540,x=-960,y=-540,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se0744",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Al haber saltado de la ventana, pude alcanzarla rápidamente.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Sin embargo, no sé si es que Rin no escucha mi voz, pero no se detiene.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Me puedo imaginar fácilmente lo que Nagayama le dijo.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Y también en qué estado se encuentra Rin ahora...",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Para ser sincero, ya había previsto que Rin reaccionaría de esta manera.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Y por eso, pensé en hacerle recordar la verdad a cuentagotas, lentamente.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Lo que Sui estaba buscando era nada más ni nada menos que las memorias de Rin.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Los recuerdos que Rin había perdido.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"No sé por qué esa muñeca estaba buscando los recuerdos de Rin.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"O tal vez debería asumir que fue el espíritu de la madre de Rin lo que provocó\neso.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Aunque probablemente no es eso.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Todo esto es también parte de lo que produjo la deformidad que nació aquel día.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Milagros. A veces eso dicen las personas cuando un sentimiento, una idea que no\ndebería tener posibilidad alguna de realizarse, florece.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Y ciertamente, quizás eso sea producto de un milagro.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Sin embargo, los milagros no son más que deformidades.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Los milagros que nacen de deformidades traen siempre, y con seguridad,\nrepercusiones consigo.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Probablemente Sui nació de allí.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si no hubiera tratado de permanecer junto a Rin... quizás...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Quizás, hubiera sido así.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Si no hubiera recuperado mi vínculo con ella, entonces quizás no hubiera\nsucedido eso.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Sin embargo, por capricho propio, quise recuperar de nuevo nuestros lazos.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Los lazos que quedaron truncados desde aquel día.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Quise más de ella, quise pedir más de lo que éramos en ese entonces.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Si yo realmente fuera un buen tipo, y hubiera pensado verdaderamente en Rin,\nhubiese seguido manteniendo la distancia entre los dos como estuve haciéndolo\nhasta hace poco.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Quizás pude haber continuado con esa bondadosa mentira.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Sin embargo, no pude hacerlo.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"No pude engañarla con esa bondadosa mentira.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Y por eso...",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Simplemente seguí persiguiendo a Rin.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"A Rin, quien seguía corriendo.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Simplemente permanecí siguiéndola.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Para protegerla.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Para no perderla de vista.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Rin, quien comenzó corriendo, se cansó y ahora comienza a caminar.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Apenas comienza a caminar, yo también camino.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Rin percibió mi presencia.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Y al hacerlo, empezó a correr de nuevo.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Apenas comienza a correr, yo también corro.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Apenas comienza a caminar, yo también camino.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Estuvimos simplemente repitiendo ese ciclo, una y otra vez.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"Rin finalmente se cansa, y se detiene.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"cgdel",id=-1},
{"bg",file="ev_uni_c45_04",path=":ev/ev_uni_c45/",set="ev_uni_c45"},
{"bgm",file="bgm105"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003206",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Yo maté a mamá!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por supuesto que no, demonios!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003207",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero... ¡Pero estaba escrito que el fuego comenzó desde mi habitación!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Te equivocas!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003208",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No solo eso! ¡También hice inútil tu brazo, Nao-kun!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No fuiste tú! ¡Eso fue mi propia voluntad!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003209",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sé que dices eso por bondad, pero no, no es así. ¡Fue por mi culpa!”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Si así no lo pienso yo, entonces no lo es!”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003210",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tu mano derecha no es solo tuya, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003211",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hace un tiempo Kei-kun se enojó contigo, ¿recuerdas? ¡De por qué dejaste de\npintar!”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003212",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No solo Kei-kun, Mako-chan tampoco está de acuerdo con que hayas dejado de\npintar. ¡Todos amaban las obras que tu mano derecha producía!”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun así, eso no tiene nada que ver. ¡Si no pinto es por mi propia voluntad y\ndecisión!”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003213",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso también es mentira.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003214",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No pintaste para que yo no recordara nada, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003215",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De enterarse alguien que no puedes usar tu mano derecha, entonces esa persona\ntrataría de dar con esa causa. Pero, si decías que fue por voluntad propia\nque dejaste de pintar, entonces no habría necesidad de indagar en esa causa.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡T-Te equivocas!”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003216",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si yo hubiera recordado bien ese accidente y lo que sucedió, entonces no\nhubieras tenido la necesidad de dejar de pintar. Por ser débil, por no poder\naceptar ese incendio, es que dejaste de pintar. Pensando en mí.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Que no, te equivocas!”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No fue tu debilidad lo que hizo que perdieras la memoria!”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003217",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Por supuesto que sí! ¡Por no aceptar la realidad, comencé a ver a una muñeca\ncomo si fuera mi propia madre!”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003218",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Mi débil corazón hizo que me mintiera a mí misma e hiciera sufrir a las\npersonas a mi alrededor!”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No!”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"La realidad es otra.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Rin no asesinó a su madre.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Eso no fue más que un desafortunado accidente.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Sin embargo, no había caso alguno que tratara de explicarle eso detalladamente.\nNo de mi boca, ahora.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Lo único que pude hacer fue decir 'No', 'Te equivocas'.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Me pareció inútil tratar de convencerla con palabras.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Me pareció que probablemente, cualquier palabra que le diera se escucharía como\nuna mentira para ella.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Y con mucha razón, puesto que hasta ahora el padre de Rin y yo hemos estado\nmintiéndole. Con esa bondadosa mentira.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"¿Podría alguien creer las palabras de esas dos personas ya a este punto?",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"De que no fue culpa de nadie que la casa de Rin se quemara. Fue simplemente una\nserie de desafortunadas casualidades.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"De que ciertamente Rin llegó a confundir a esa muñeca con su madre, pero que\neso no fue producto de la debilidad de su corazón.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"De que todos los infortunios, y toda la bondad acumulada hasta ahora es lo que\nllevó a esta situación. A la peor de todas las situaciones.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"No, seguramente por saber que se trató de un acto de bondad, es que Rin no\nlogra creer en eso.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003219",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Te despojé de tu mano derecha, te despojé de la pintura, e hice sufrir a papá.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003220",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Todo por lo débil que fui.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003221",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estuve odiando a mi papá todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003222",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por haber creado ese falso recuerdo, diciendo que él me había robado a mamá...\n¡Por no aceptar la realidad, la realidad de que fui yo misma quien mató a\nmamá!”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"se",file="se0744s",id=1},
{"msgoff"},
{"bg",file="nightsky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Rin comienza a correr de nuevo.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Cubierta en sudor. Como si estuviera forcejeando, luchando.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Simplemente sigue corriendo.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Ya no habían más palabras entre los dos.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"En medio del silencio, Rin corre, y yo la sigo.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Y entonces, llegamos a aquel lugar.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"cgdel",id=-1},
{"excall",file="03_olympia_08_3"},
{"text"},
linkback="block_00167",
},
label = {
top={block="block_00000",label=1},
},
}
