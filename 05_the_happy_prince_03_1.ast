astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"bg",file="ev_eye_c13_01",path=":ev/ev_eye_c13/",set="ev_eye_c13"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_summer",sync=1,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm109"},
{"quake"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004035",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Kei! ¡¿Por qué estás tan empapado?!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Toritani grita sorprendida al ver a la persona que había entrado a la sala del\nclub de arte.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0009",head="kei_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Kei estaba empapado, de pies a cabeza. Las gotas de agua que caían de su cuerpo\nestaban formando un charco en el suelo.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0016",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001213",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, lo siento, lo siento, intenté despertarme, y...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004036",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Pero por qué echándote agua encima?...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0009",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001214",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, lo siento, ya lo limpio...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004037",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No me refiero a eso... ¡¡Ah!!”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"bg",time=300,sync=0,file="black",path=":bg/"},
{"se",file="se_bafu",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡E-Eh, Kei!”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="man_ked_001215",ch="ked"},
},
ja={
{
name={"Kei"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"El cuerpo de Kei se tambalea.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Se resbaló con el charco que él mismo formó, y estaba a punto de caer al piso.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",mode=-2},
{"bg",speed=300,sync=0,file="zbg049a",path=":bg/",x2=-200,y2=0,x=0,y=0,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="圭",size="z2",speed=300,sync=0,mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0009",head="kei_z2a",x2=-200,x=0,lv=5,id=9},
{"quake",mode="mw"},
{"se",id=1,file="se3356"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡Mm!!”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"De milagro alcancé a sostenerlo del hombro.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0016",head="kei_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001216",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, Naoya... lo siento.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué te dije yo ayer?...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0009",head="kei_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001217",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tienes razón? Escucha, yo no estoy--”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"quake",mode="mw"},
{"fg",ch="圭",my=40,mode=-1,lv=5,id=9},
{"se",file="se2766",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿--?!”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Mi hombro se sintió, de repente, mucho más pesado.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="man_ked_001218",ch="ked"},
},
ja={
{
name={"Kei"},
"“......”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Kei estaba dormido, apoyado de mi hombro.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está dormido...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0200",face="d0009",head="mak_z1d",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0015",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004038",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿D-Dormido, estando parado?... ¿Q-Qué está pasando?... Menos mal que se resbaló\nacá en la sala.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, de ocurrir en las escaleras hubiese sido fatal.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0011",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004039",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me da escalofríos de solo pensarlo.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun en ese estado está viniendo al colegio en motocicleta. Un día de estos va a\nmatarse de verdad.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0013",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004040",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿En motocicleta? ¡¿K-Kei está viniendo en motocicleta, en ese estado?!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo más seguro.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0005",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0018",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004041",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿E-Es en serio?... N-No lo puedo creer...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0005",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004042",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“I-Iré de inmediato a contarle a la profesora Ai y pedirle que le prohíba venir\nen motocicleta al colegio...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No creo que Kei le preste mucha atención a lo que diga Ai.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0006",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004043",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Pues haré que la obedezca! ¡Así tenga que molerlo a golpes!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Siempre que sale Kei en el tema de conversación tus palabras toman\nintensidad, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0008",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0005",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004044",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Porque este muchacho tiene mucha más locura que los demás! ¡Podría terminar\nmatándose de verdad!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0006",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004045",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Y alguien tiene que pararlo!”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"La voz de Toritani estaba algo temblorosa.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"No era la misma persona de siempre.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, sí... Pero no te preocupes, le pediré a Ai que le permita a Kei\nausentarse del colegio por una semana.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0013",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004046",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Ausentarse del colegio?!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Si no tiene que venir, tampoco tendrá que montarse en esa motocicleta, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Incluso Akashi pudo graduarse. Seguramente el colegio tendrá algo de\nconsideración con él también...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Viendo la manera en que se tambaleó hace un rato, temo que pueda terminar\nmuriéndose en cualquier momento.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Convenceré a Ai, no te preocupes.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así podrás sentirte un poco más tranquila, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0009",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004047",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“P-Pues... sí.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues ya está. Este idiota quiere rebasar un poco su propio límite. No, bueno...\nno diría 'un poco' en este caso, pero igual...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dejemos que haga lo que quiere hacer hasta que termine, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0008",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004048",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bueno... está bien. Si tanto insistes...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, llevemos a este tonto a la enfermería. Lleva un buen tiempo sin\nacostarse a dormir, es buena oportunidad. Pongámoslo sobre una cama.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0012",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0001",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004049",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, sí, bueno.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Al levantar a Kei, Toritani acarició su cabello.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zoom=100,speed=200000,file="zbg046a",path=":bg/",z2=50,x2="@",y2="@",x=-300,y=100,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2b0200",face="b0011",head="mak_z2b",x=-400,lv=5,id=9,sync=0},
{"extrans",time=500},
{"se",file="se9012",loop=1,id=1},
{"cgact",stage="zbg046",act="びっくり",size=2,time=500,loop=-1,sync=0},
{"fgact",ch="真琴",act="びっくり",size=2,loop=-1,time=350,sync=0,lv=5,id=9},
{"text"},
text={
ja={
{
"Fuimos a la enfermería, en completo silencio los dos.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004050",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Ni Toritani ni yo intentamos decir algo. No pude decir nada.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"A cada rato se me viene a la mente la expresión que tomó Toritani en ese\nmomento. Esos ojos, esos labios temblorosos que vi de cerca.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Esa intensa tensión que sentí de esa Toritani, ya no estaba ahí.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"¿Por qué será?",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Siento que esa tensión que Toritani dejó ir está todavía dentro de mí, junto a\nun extraño eco.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bgm",stop=1,time=1000},
{"se",stop=1,time=500,id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="zbluesky_summer",speed=300000,rule="083r",sync=1,vague=40,id=1,lv=5,path=":cg/",x2=-960,y2=-540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm029"},
{"text"},
text={
ja={
{
"Aún después de llevarlo a la enfermería, Kei siguió durmiendo.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"No podíamos ponerlo a dormir con la ropa mojada, así que lo cambiamos con la\nropa seca que la doctora encargada nos ofreció.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"No había más ropa alrededor, así que Kei estaba ahora durmiendo vestido en un\nuniforme de chica.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Hace poco había llevado su uniforme de gimnasia a casa. Yo igual.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Y a pesar de que sus tallas son casi iguales, no podíamos darle el traje de\ngimnasia de Toritani.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Dejamos su ropa mojada tendida cerca de la ventana. Seguramente secará rápido\ncon el calor del verano.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Toritani se quedó al lado de Kei todo el rato. Sentada en una silla, cuidaba\nsilenciosamente de él mientras dormía tranquilamente.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004051",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya puedes irte, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004052",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Yo lo cuidaré mientras tanto...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004053",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oye, Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004054",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... No, nada...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Sé lo que quieres decir.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que por qué, aun a pesar de todo el esfuerzo de Kei, no pinto, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004055",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, bueno...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero también debo tener mis razones... Pensaste eso también, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004056",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también pienso lo mismo, la verdad. ¿Qué tantas de esas razones podrían\nvaler tanto como para tener que verlo así?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004057",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Anoche hablé con él...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si se hubiese desmayado sin haber hablado con él, quizá no hubiese pensado\neso...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero hablamos, y cuando le pregunté por qué está pintando con tanta\ndesesperación...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me dijo... que era para alcanzar el mismo lugar donde estoy yo...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es un idiota...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nadie está corriendo delante de él...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si donde está él me puede ver adelante... es simplemente porque estoy atrasado\nunas cuantas vueltas...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese lugar donde Kei dice que estoy yo, está muy por detrás de él. Y aun así...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004058",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sakura Nanasouzu...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tú también saliendo con ese nombre?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_mkd_004059",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si esos cuadros no existieran, quizá Kei no se hubiese presionado tanto a sí\nmismo ahora...",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh, ¿cómo es que todos andan con la misma falsa idea en la cabeza?...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Falsificaciones, eso es lo que son.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Al decir eso, me fui de la enfermería.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,time=1500,vague=40},
{"text"},
text={
ja={
{
"Y estaba ahora solo en la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Estaba echándole una ojeada al cuaderno de dibujo que Kei estuvo llenando hasta\nhace poco.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es obvio quién realmente está adelante...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Parece que estaba bosquejando de nuevo.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Aun a pesar de todo el tiempo que estaba invirtiendo en su propia obra, todavía\nbuscaba, hambriento, asimilar artísticamente los varios fenómenos del mundo.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"El cuaderno de dibujo mostraba los paisajes cambiantes, desde otoño y poco a\npoco hacia invierno.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"En sus bosquejos había una increíble precisión, inimaginable delicadeza y\nbelleza en el dibujo.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Una textura que podrías sentir con el tacto... Aun siendo en escala de grises,\npodías sentir como los colores salían del dibujo.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Casi, como un dibujo que podría materializarse en cualquier momento.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Los dibujos que siempre se me vienen a la mente son aquellos de Kei.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"No sé qué gran talento llegó a ver el viejo en el pasado.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Pero dudo que haya sido algo superior a esto.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"se",file="se9010",vol=60,id=1},
{"text"},
text={
ja={
{
"Tomo un cuaderno de dibujo en blanco.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"se",file="se9048",vol=60,id=1},
{"text"},
text={
ja={
{
"Y comienzo a bosquejar rápidamente lo que tenía frente a mis ojos.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Mesas, sillas, bustos.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Cosas que he pintado cientos, miles, decenas de miles de veces.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Tengo la seguridad de que nadie, a esta edad, ha practicado tantas veces\nbosquejos como yo.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Y aun después de dejar pintar, o no, incluso ahora no dejo de dibujar, todos\nlos días.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Siempre practico.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Pero aun así...",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"se",file="se9046",vol=60,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Mis dibujos con lápiz―― No alcanzaban a conseguir las matices y tonalidades\nque habían en los de Kei.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Mi dibujo era solo un dibujo. Nada más que eso.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Solo líneas de color plomo describiendo el mundo.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Vuelvo a abrir el cuaderno de dibujo de Kei.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este tipo está esperándome...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y a pesar de eso, yo...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"msgoff"},
{"bg",file="eveningsky_spring01",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Salgo del colegio por el portón trasero.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Si bien termina siendo un rodeo, es mi camino de vuelta a casa predilecto por\nestas semanas.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="香奈",size="z2",zoom=70,mx=-40,mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0200",face="a0004",head="kan_z2a",x=-650,y=-140,lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"se",file="se9012",id=1,loop=1},
{"msgoff"},
{"bg",zoom=80,x=-130,y=100,speed=60000,file="zbg015b",path=":bg/",z2=50,x2=0,y2=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="香奈",size="z2",zoom=100,speed=10000,mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0013",head="kan_z2a",x2=-650,y2=-140,z2=70,x=-1400,y=60,lv=5,id=9,sync=0},
{"extrans",time=0},
{"bgm",file="bgm004"},
{"cgact",stage="zbg015",act="びっくり",size=2,time=500,loop=-1,sync=0},
{"fgact",ch="香奈",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000334",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡E-Espera un momento, por favor!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="香奈",mode=-1,lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuántas veces vamos con lo mismo? Ya molestas, Nagayama.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="香奈",size="z2",speed=2000,mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0002",head="kan_z2a",x2=-1400,y2=60,x=-400,y=0,lv=5,id=9},
{"fgact",ch="香奈",act="びっくり",size=2,loop=-1,time=350,sync=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0003",head="kan_z2a",x=-400,y=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000335",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿En serio? Sí, bueno, es normal que te sientas así, Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_knd_000336",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero no dejaré de seguirte.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Diablos... ¿Cuántas veces tengo que decir lo mismo?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0005",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000337",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ya te dije que no creo en esas tonterías.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0002",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000338",ch="knd"},
},
ja={
{
name={"Kana"},
"“Estoy segura de que esa obra fue creada por Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh... ¿Otra vez con el Sakura Nanasouzu?...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0004",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000339",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, esa obra marca el regreso de Naoya Kusanagi al arte, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Para ser sincero, la primera vez que la escuché decir eso me puse nervioso.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Pensé que era una detective o una espía, o algo así, y la jalé a un lugar\noculto.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Y bastante se alteró aquella vez, sí...",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Pero esta mujer no tenía prueba concreta alguna consigo.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Según ella, esos cuadros no eran de Kenichiro Kusanagi, sino de Naoya Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"'Así me parece, es la única posibilidad.'",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Esa es su única razón.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Desde entonces se me ha hecho tan ridículo esto que simplemente le sigo la\ncorriente y ya.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0001",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000340",ch="knd"},
},
ja={
{
name={"Kana"},
"“Cómo ha bajado la temperatura, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, han pasado tantas semanas que ya las otras muchachas se han calmado. la\núnica que se ha empeñado en seguirme hasta ahora eres tú.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0012",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0002",head="kan_z2a",x=-400,y=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000341",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Sí? Bueno, tal vez sea así.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0003",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000342",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Cómo está tu relación con Rin-chan?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? ¿Rin? ¿Por qué me estás preguntando por Rin?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_knd_000343",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ya te lo había dicho, ¿no? Estuve en el mismo colegio que tú y Rin-chan, en el\nmismo salón.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me importa. La verdad es que no recuerdo nada de lo que me dices.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0016",head="kan_z2a",x=-400,y=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000344",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿De verdad? ¿Y cómo te va entonces con la jefa del club de arte de Yumihari?\nParece que ha estado muy empeñada en hacerte pintar de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Es que también sabes de Toritani?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0004",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0002",head="kan_z2a",x=-400,y=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000345",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí. También sé de Rina Hikawa-chan. Y de Yuumi Kawachino-chan. Sé muchas cosas.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué has estado investigando a las mujeres del club de arte?...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0016",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000346",ch="knd"},
},
ja={
{
name={"Kana"},
"“A la sombra de todo crimen hay mujeres y dinero. No soy especialista en dinero,\nasí que he estado investigando principalmente a las chicas.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nadie ha cometido crimen alguno...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0009",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0015",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"fgact",ch="香奈",act="ジャンプ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000347",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿En seriooo? Si esa obra es falsificada, y tú la pintaste, eso de por sí sería\nun gran crimen.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te lo he dicho, son todas ideas tuyas...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0005",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000348",ch="knd"},
},
ja={
{
name={"Kana"},
"“Eso no es cierto. Es la verdad.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dónde están las pruebas?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0018",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000349",ch="knd"},
},
ja={
{
name={"Kana"},
"“No hay pruebas. Así lo creo yo, y por ende es verdad.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que puedes afirmarlo con tanta confianza?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Esta conversación es realmente absurda...",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya vienen los exámenes de la universidad, ¿hasta cuándo piensas seguir con esta\nidiotez?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0012",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000350",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Idiotez?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, idiotez. Supongamos que llegaras a descubrir que yo soy el autor de esos\ncuadros. ¿Que harías en ese caso?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0005",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000351",ch="knd"},
},
ja={
{
name={"Kana"},
"“Te preguntaría por qué decidiste regresar al mundo del arte con esa obra.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni en tus sueños creas que te lo diré.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_knd_000352",ch="knd"},
},
ja={
{
name={"Kana"},
"“Yo misma lo averiguaré, no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y que harás al saberlo?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_knd_000353",ch="knd"},
},
ja={
{
name={"Kana"},
"“Podré salir adelante.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tú, salir adelante? No sé de qué me hablas...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0006",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0018",head="kan_z2a",x=-400,y=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000354",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí... los genios imbéciles como tú nacidos con talento bajo el brazo jamás\nentenderían a mediocres como yo...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A veces se te salen las malas palabras.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0003",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000355",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? ¿En serio? Debes haber escuchado mal.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no escuché mal... Deja de hacerte la mosquita muerta, ya se me hace\nrepulsivo...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0004",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000356",ch="knd"},
},
ja={
{
name={"Kana"},
"“No estoy fingiendo nada. Así soy yo.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah, sí? Bueno...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"se",stop=1,id=1,time=500},
{"se",file="se9041",id=2,vol=40,loop=1},
{"bg",zoom=100,x=-160,y=200,speed=10000,time=0,file="zbg015b",path=":bg/",z2=80,x2=-130,y2=100,ax=1920,ay=1126,bx=-960,by=-586},
{"cgact",stage="zbg015",act="びっくり",size=2,time=300,loop=-1,sync=0},
{"fg",ch="香奈",mode=-1,lv=5,id=9},
{"text"},
text={
ja={
{
"Acelero mis pasos.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0013",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"fgact",ch="香奈",act="びっくり",size=2,loop=-1,time=300,sync=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000357",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, vamos, no camines tan rápido, por favor.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú... ¿pintas?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0012",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000358",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? ¿No te lo había dicho?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No recuerdo haber escuchado al respecto.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0001",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000359",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí pinto, y siempre. Todo, todo el tiempo.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te gusta pintar?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0018",head="kan_z2a",x=-400,y=0,lv=5,id=9},
},
vl02={
{"fgact",ch="香奈",act="いいえ",lv=5,id=9},
},
vl03={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0010",head="kan_z2a",x=-400,y=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000360",ch="knd"},
},
ja={
{
name={"Kana"},
"“... Me encantaba... no, todavía me gusta. Pero ahora es más dolor que alegría.\nMe encanta, pero hay dolor...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0002",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0004",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000361",ch="knd"},
},
ja={
{
name={"Kana"},
"“Aunque Kana es toda una pequeña masoquista, así que el dolor suele convertirse\nen placer, aja.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?... Pues qué bueno.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0005",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000362",ch="knd"},
},
ja={
{
name={"Kana"},
"“Además, nada bueno se crea sin algo de dolor...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Nada bueno sale sin algo de dolor...",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Tiene algo de razón...",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me has estado siguiendo con tanta insistencia que procuré investigarte a ti\ntambién.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0003",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"fgact",ch="香奈",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0004",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000363",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? ¿Te has interesado en Kana? ¡Qué felicidad escuchar eso!”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Bueno, en realidad fue Shizuku quien me contó, por alguna razón...",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al parecer trabajas de idol underground o algo así, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0003",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0010",head="kan_z2a",x=-400,y=0,lv=5,id=9},
},
vl02={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0002",head="kan_z2a",x=-400,y=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000364",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, pensé que quizá eso me daría más impacto como pintora...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Como pintora? ¿Ese es tu trabajo principal?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0008",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0015",head="kan_z2a",x=-400,y=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000365",ch="knd"},
},
ja={
{
name={"Kana"},
"“Por supuesto. Alguien mediocre como yo jamás podría llegar a ser número uno\ncomo idol.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa forma de pensar... también suena algo mediocre.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0004",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"fgact",ch="香奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000366",ch="knd"},
},
ja={
{
name={"Kana"},
"“Aja, para personas como tú, quizás.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que personas distintas a mí pensarían también lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0006",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0002",head="kan_z2a",x=-400,y=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000367",ch="knd"},
},
ja={
{
name={"Kana"},
"“El mundo no funciona así. Nadie tiene ojos para el talento mediocre. Por eso es\nimportante ser excéntrico.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"No es algo completamente fuera de lugar.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Aún antes de su debut, Oscar Wilde era ya famoso en Londres por su excéntrica\nmanera de vestir y actuar.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Fue conocido primero por su excentricidad que por sus novelas. Fue después que\nfinalmente pudo llegar a crear su primera obra.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Hay ejemplos así, donde la fama viene primero por excentricidad.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Aunque, fue Rin, fanática de Wilde, quien me contó eso...",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0001",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000368",ch="knd"},
},
ja={
{
name={"Kana"},
"“No importa que sea por disgusto... siempre y cuando pueda tener la atención de\nlos demás... De esa manera, lograré que vean mis obras también.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Pero personas así no son de mi tipo, en absoluto.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si tanto tiempo libre tienes deberías invertirlo dibujando, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0005",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000369",ch="knd"},
},
ja={
{
name={"Kana"},
"“Lo hago. Solo duermo tres horas al día.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues deja de usar tu tiempo persiguiéndome y duerme más.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0004",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"fgact",ch="香奈",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000370",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ajajaja, si tan solo fuese tan fácil no me esforzaría tanto en esto.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te esforzarías? Todo esto que haces es esfuerzo perdido.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0006",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000371",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ya te lo dije, alguien como tú no podría entenderlo.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, no entiendo absolutamente nada de gente como tú.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Persiguiéndome a donde vaya y afirmando, sin prueba alguna, de que Sakura\nNanasouzu es obra mía.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tan tonta puedes ser?...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0018",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000372",ch="knd"},
},
ja={
{
name={"Kana"},
"“Justamente por ser tonta es que puedo afirmarlo tajantemente.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por ser tonta es que puedes afirmarlo? Es decir, ¿sin idea alguna?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0006",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0018",head="kan_z2a",x=-400,y=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000373",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Sin idea alguna? La cuestión no es esa...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál es la cuestión entonces?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_knd_000374",ch="knd"},
},
ja={
{
name={"Kana"},
"“Mi propia idiotez...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces no tienes consciencia de nada más que tu idiotez?...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_knd_000375",ch="knd"},
},
ja={
{
name={"Kana"},
"“Por supuesto... Aún sabiendo que no tengo ni una pizca de talento, insisto en\nseguir pintando...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="香奈",size="z2",mode=3,path=":fg/kan/z2/",file="kan_z2a0200",face="a0003",head="kan_z2a",x=-400,y=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000376",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y probablemente es esa idiotez la que me impide renunciar de una vez a esto.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué me estás hablando? No me refiero a eso...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"se",stop=1,id=2,time=500},
{"bgm",stop=1,time=300},
{"msgoff"},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm105"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000377",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Yo sé identificar lo auténtico!”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Nagayama sigue hablando, ignorando mis palabras.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="fem_knd_000378",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y también sé identificar la basura, la chatarra.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="fem_knd_000379",ch="knd"},
},
ja={
{
name={"Kana"},
"“El mundo está lleno de chatarra.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0018",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000380",ch="knd"},
},
ja={
{
name={"Kana"},
"“Es muy escaso lo auténtico en este mundo.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000381",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero aun así soy capaz de distinguir lo auténtico de la basura.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0009",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000382",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y por eso mismo... también sé muy bien quién soy...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_knd_000383",ch="knd"},
},
ja={
{
name={"Kana"},
"“Conozco mi nivel...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="fem_knd_000384",ch="knd"},
},
ja={
{
name={"Kana"},
"“'De dónde vengo, adónde voy'... Aun siendo una mediocre, sé muy bien eso...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0010",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000385",ch="knd"},
},
ja={
{
name={"Kana"},
"“Solo ellos... solo los genios pueden preguntarse '¿quién soy?'...”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="fem_knd_000386",ch="knd"},
},
ja={
{
name={"Kana"},
"“Los mediocres descubren fácilmente de dónde vienen, y adónde deben ir.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0008",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000387",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pues siendo tan normales y ordinarios, es muy fácil saber adónde irán...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_knd_000388",ch="knd"},
},
ja={
{
name={"Kana"},
"“Por eso es que no podemos preguntarnos, '¿De dónde venimos? ¿Quiénes somos?\n¿Adónde vamos?'...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="fem_knd_000389",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pues ya sabemos muy bien de dónde venimos, quiénes somos... y adónde iremos...”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0009",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000390",ch="knd"},
},
ja={
{
name={"Kana"},
"“Lo sé... lo sé muy bien, pero...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0018",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000391",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero quiero ir al lugar que deseo ir.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0005",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000392",ch="knd"},
},
ja={
{
name={"Kana"},
"“Yo también quiero preguntarme a mí misma de dónde vengo, adónde debo ir, y\nquién soy...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000393",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡La luna no es solo de ustedes!”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La luna no es solo de ustedes...”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"La luna es una metáfora de los sueños. La metáfora para el mundo actual son los\nseis peniques.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"La obra de Maugham.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"El terreno de los sueños solo es accesible para los genios. Y es de la mano de\nellos que los sueños son reflejados en el mundo.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"No sé quién es esta mujer, pero... me hizo entrar en cuenta.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
"Sí... El destino de los mediocres. El destino de los genios.",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
"Hay una obra muy famosa creada por el pintor Gauguin.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Una que se dice fue creada como una obra póstuma, con el fin de suicidarse.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
"La visión religiosa de Gauguin era extremadamente panteísta, aunque también\nbudista.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"Entre sus trabajos hay un escrito llamado 'La Iglesia Católica y los Tiempos\nModernos', donde critica fuertemente a la iglesia cristiana, y donde afirma\nfirmemente que el Dios cristiano 'debe ser asesinado, para que no vuelva a\nnacer jamás'.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"Y por otro lado, pone mucha importancia en el Dios como símbolo del misterio.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"Entre sus escritos se pueden conseguir los siguientes extractos.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"'Misterios inconmensurables han sido, son, y seguirán siendo como son,\ninconmesurables.'",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"'Dios no pertenece al científico ni al lógico; pertenece a los poetas, al reino\nde los sueños. Él es el símbolo de la belleza, la belleza misma.'",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"'Definirlo, o rezarle, es limitarlo.'",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
"Esa visión religiosa la tuvo antes de irse a Tahiti, y al llegar allá se\nfortaleció aún más.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"Gauguin, quien no creía en la visión cristiana de prohibir el suicidio, intentó\nalcanzar una muerte placentera entre la desesperanza.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
"Y de ahí que estando abatido al borde del abismo, intentó dejar su obra\npóstuma. Su magnus opus.",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
"'¿De dónde venimos? ¿Quiénes somos? ¿Adónde vamos?'",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"Era una pregunta seductora, filosófica, religiosa y a la vez artística.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"Aunque esa pregunta no se la puede hacer cualquiera.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
"Quizá el ser genio fue lo que le permitió preguntarse eso.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"Se marchó sin fin hacia el sur, huyendo de Francia.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"Él mismo se hizo llamar 'Oviri salvaje'.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
"Pero a final de cuentas era un hombre occidental, y no un 'Oviri salvaje' de la\nisla del sur, Tahiti.",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
"Él intentó conseguirse un paraíso en la naturaleza.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
"Intentó huir del marco de la civilización occidental hacia más allá del sur,\nintentando encontrar el núcleo de su arte.",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
"Pero lo que encontró fue la muerte en medio de la más grande desesperanza.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
"Aunque, a pesar de eso, vio algo dulce y encantador en esa desesperanza y\nmuerte.",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"Por eso es que las pinturas de Gauguin son amadas aún hasta el día de hoy.",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
"Sí, no logró dar con su paraíso en las tierras del sur.",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
"Pero por no haberlo encontrado es que siguió buscando, y pudo producir todas\nesas obras.",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
"Gauguin pasó su vida buscando producir pinturas con colores que crearan\nmelodías musicales.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"Su último destino fue la pequeña isla del sur, Hiva-Oa.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
"Allí pasó dos años de su vida.",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
"Y allí falleció.",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"Sin embargo, en sus últimas obras se cruzaban con mucha más fuerza la realidad\ncon los sueños, contemplaciones con memorias, y la muerte con la vida.",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
"Poco antes de morir, produjo un breve escrito llamado 'El Imperio de la\nMuerte'.",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
"Ahí se hablaba de un ángel y de un anciano con un reloj de arena, el infinito y\nDios. Y de cómo su vida como una obra imperfecta cobró valor gracias a esos\núltimos dos.",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
"Las pinturas de Gauguin se vendieron a precio de regalo. Sin embargo, jamás\ndudó de estar en lo correcto, aún hasta el momento de su muerte.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"Él mismo estaba consciente de que sus preguntas eran más importantes que todo,\ny de que sus obras dejarían su huella en la historia.",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya veo, así que puedes percibir lo auténtico...",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
"Considerando que acertó diciendo que yo soy el autor de Sakura Nanasouzu, no\nsería absurdo pensarlo.",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué ven tus ojos aquí entonces?”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0012",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000394",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eso es un cuaderno de dibujo?”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, mi cuaderno...”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Tomo el cuaderno de dibujo en blanco y comienzo a esbozar.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"Procuro dibujar el panorama que se extiende ante mis ojos.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
"Hay un árbol de olivo dulce ahí. Pintemos ese.",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
"Tiene un aspecto fresco y colorido. Debe oler muy bien.",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
"Respiro profundo y comienzo a dibujar.",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
"Con mi mano izquierda.",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
"Uso toda la fuerza que tengo para lograr un esbozo.",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
"Nagayama se me queda viendo fijamente. Observa, sin emitir ni una sola palabra.",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="05_the_happy_prince_03_2"},
{"text"},
linkback="block_00299",
},
label = {
top={block="block_00000",label=1},
},
}
