astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo II"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"extrans",time=2000},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000635",ch="rna"},
},
ja={
{
name={"Rina"},
"“Creo que es la primera vez que observo con tanta atención el Templo Hakuki...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000477",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Parece que el primer santuario fue construido en los inicios de la Era\nKamakura. Este fue construido en algún momento desde la Era Meiji. Según he\nescuchado, era tan grande el templo en la antigüedad que toda la colina\nservía como parte de su terreno.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000478",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Escuché que los derechos de propiedad del terreno le han pertenecido desde hace\nmuchísimo tiempo a la antigua familia Nakamura. Es por eso que hasta hace un\ntiempo, el colegio Yumihari le perteneció a ellos.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0005",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000636",ch="rna"},
},
ja={
{
name={"Rina"},
"“Dicen que la casa Nakamura se ha mantenido desde tiempos antiguos, ¿será eso\nverdad?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000479",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué lo preguntas?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0005",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000637",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es que me da la impresión de que la familia que apareció en mi sueño era del\n'clan Nakamura'.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="du",lv=4,id=6},
{"text"},
delay={
vl02={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000480",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo. Sí, he escuchado rumores al respecto. De que la familia Nakamura es,\nsupuestamente, una casa de bastante antigüedad, habiendo sobrevivido desde\nlos tiempos de la Era Kamakura...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0013",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000638",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Desde la Era Kamakura? ¿Tanto tiempo?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000481",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Solo son rumores, no sé si son verdad o no. Además, dicen que los Nakamura\nentraron en un terrible declive hace unas cuantas décadas.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000639",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿En declive?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0009",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000482",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, al parecer metieron sus narices en un conflicto de yakuzas, causaron muchos\nproblemas, y su número de integrantes se fue reduciendo drásticamente.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0011",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000483",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aunque parece que aún tienen una corporación en sus manos... ¿Cómo era que se\nllamaba? ¿Farmaceútica Nakamura, era?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000484",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En fin, es difícil de creer que una familia que haya caído en declive en tan\npoco tiempo haya sobrevivido por todo un milenio.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000640",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hummm. Por cierto, en el colegio hay algunos Nakamura también, ¿será que tienen\nque ver algo con esa familia?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000485",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Nakamura? Es uno de los 10 apellidos más frecuentes en Japón.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000641",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ahora que lo dices, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000486",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué no vamos mejor a ver el interior del santuario?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000642",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=-300,speed=100000,file="zbg063b",path=":bg/",x2=150,y2=-300,x=-150,ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Yuumi y yo le damos un vistazo al interior del santuario.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"He vivido por bastante tiempo en Yumihari, pero es la primera vez que\ninspecciono con tanta atención el Templo Hakuki.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="fem_rna_000643",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tienen un enorme emaki acá adentro. ¿Qué será esto? Hay un barco dibujado...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_yum_000487",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Probablemente es el Barco del Tesoro.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_rna_000644",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿El Barco del Tesoro? ¿Ese donde van montados los siete Dioses de la Fortuna?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="fem_yum_000488",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Observa bien, no hay nadie a bordo del barco. Lee también las inscripciones del\nemaki.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_rna_000645",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿L-Las inscripciones? A-A ver... La caligrafía es tan intrincada que me cuesta\nleerla...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_rna_000646",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nakaki yo no, too no nefuri no minamesame, naminorifune no oto no yoki kana.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_yum_000489",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lee ahora desde el final al principio.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_rna_000647",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Desde el final al principio? Ehm...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_rna_000648",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nakaki yo no, too no nefuri no minamesame, naminorifune no oto no yoki kana.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_rna_000649",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Pero qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"msgoff"},
{"cgdel",lv=1,id=5,rule="cinema",time=400,sync=0},
{"fg",mode=-2,sync=0},
{"bg",file="bg063b",path=":bg/",sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0001",head="rna_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000490",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es un palíndromo.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000650",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Palíndromo? ¿Esas frases que se leen igual por adelante y por atrás?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000491",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. Está muy bien hecho, ¿no crees? Y nadie sabe quién es el autor, lo cual es\nimpactante.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="du",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0110",face="b0005",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000651",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jee... Me pregunto qué significará...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000492",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ni idea, no sé mucho al respecto. El poema de por sí es bastante misterioso, y\nse le han dado muchísimas interpretaciones.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000493",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Lo único que se puede decir que es cierto de este poema palíndromo es que habla\nde los sueños.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000652",ch="rna"},
},
ja={
{
name={"Rina"},
"“Los sueños... Ahora que observo con cuidado, la vela de este barco tiene 'Baku'\n(獏) escrito.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000494",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, lo tiene. Por cierto, existe la leyenda de que al dormir con un dibujo del\nBarco del Tesoro y este poema palíndromo debajo de la almohada, tendrás un\nexcelente primer sueño al iniciar el año nuevo.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0002",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000653",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vaya que sabes, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0011",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000495",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A-Algo.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Por alguna razón, Yuumi apartó su mirada de mí.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000496",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En fin, de todo lo que has visto sabrás ya que el Templo Hakuki es un templo\ndonde se venera al dios de los sueños.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000654",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y cabe agregar además que la colina que llega hasta acá se llama Yumenouki.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000497",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tal como lo dije hace un momento, toda esta colina fue alguna vez un templo,\nasí que aún quedan nombres por allí y por allá referentes a los sueños.\nRecuerda cómo se llama esta ciudad.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000655",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Esta ciudad? ¿Te refieres a Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000498",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El nombre de la ciudad Yumihari vino directamente del nombre de esta colina,\nYumihari.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000499",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Encima de eso, parece que esta región se llamaba anteriormente Yumehari. La\nteoría más común que hay al respecto es que Yumihari surgió como una forma\nalterada de Yumehari.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000656",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Yumehari?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000500",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, Yumehari (夢張り). La parte de 'hari' usa el mismo kanji que la frase\n'llenar con agua' (水を張る).”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0005",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000657",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y-Ya veo... Pero, se supone que en este templo se adora al Baku, ¿no? ¿Por qué\nentonces su nombre oficial es Templo Hakuki? Pudieron haberle llamado Templo\nBaku, así como todos lo llaman.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000501",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hakuki es un dios de China. Su nombre no se conoce casi en Japón, pero es una\nbestia divina que come sueños.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000502",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Este llegó y se adentró en la cultura japonesa, pero no como Hakuki, sino\nmezclándose con el Baku, el cual era ya una criatura mitológica acá en Japón.\nOriginalmente, en China, el Baku come realmente latón, hierro y víboras.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000503",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Supongo que en un principio se veneraba a Hakuki, pero luego pasó a adorarse al\nBaku, el cual era mucho más familiar para los japoneses.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000504",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y de hecho, el culto al Baku tomó fuerza desde la Era Muramachi, y para la Era\nEdo se había ya propagado entre la gente común. Aunque ahora en la actualidad\nno se conoce para nada.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000505",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sin embargo, se dice que la tradición del Hatsuyume, o el primer sueño del año,\nes en realidad un vestigio de lo que fue el culto al Baku.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0001",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0009",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000658",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo... Todo coincide tan perfectamente con los sueños que tuve que se hace\ncasi tétrico...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000506",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ciertamente. Pero, hay buena probabilidad de que ya hayas conocido todo eso en\nprincipio.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0005",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000659",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000507",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Parte de la cultura de la región de Yumihari ha salido en varios libros con\ndibujos para niños, así que quizás alguna vez te llegaron a leer algo al\nrespecto.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000660",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque no tengo ningún recuerdo de ello.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000508",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué habrá sido ese sueño entonces?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000661",ch="rna"},
},
ja={
{
name={"Rina"},
"“No tengo idea...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0003",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000509",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Quizás eras tú en alguna vida pasada.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000662",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uwaah... De verdad no quisiera terminar convirtiéndome en la típica chica\nmisteriosa que no para de hablar de ese tipo de cosas fantasiosas.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0002",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000510",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿No? Así lo fueras seguirías gustándome.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000663",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, entiendo, claro...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000511",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero también están los cerezos que vimos aquel día, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000664",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, eso... Kusanagi-senpai había dicho que simplemente fue un engaño de nuestra\nvista...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000512",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿De verdad crees que la vista nos engañó a los tres, al mismo tiempo?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000665",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, la verdad es que no sé...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0120",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000513",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Quizás la leyenda de los cerezos milenarios sea cierta.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0009",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000666",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sería algo espeluznante si lo fuera...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000514",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Espeluznante? ¿Por qué, si te puede conceder cualquier deseo?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000667",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, sí, ciertamente suena muy bonita la historia de las flores que resuenan y\nnacen con los sentimientos y deseos de las personas, pero ahora que vi esos\nsueños, me da algo de miedo...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0011",head="rna_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000668",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quizás, los sentimientos que florecen y despiden los cerezos milenarios, son...\ntal como senpai los describió. Me da esa sensación.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0008",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000515",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Como Kusanagi los describió? ¿Te refieres a que es en realidad una maldición?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0100",face="a0005",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000669",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Tratándose de senpai, tal vez él sí ha llegado a ver los cerezos milenarios\nalguna vez, ¿no te parece?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0012",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000516",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué lo piensas?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0012",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0011",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000670",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no, tampoco es que tenga prueba o base alguna para decirlo...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0100",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000671",ch="rna"},
},
ja={
{
name={"Rina"},
"“Flores, que le dan forma a los deseos de las personas...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Veo hacia arriba, y observo los árboles de cerezo.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Lo único que había allí era un frondoso verde.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bgm",stop=1,time=2000},
