astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bgm",file="bgm038"},
{"bg",file="ev_txt_c11_01",time=2000,path=":ev/ev_txt_c11/",set="ev_txt_c11"},
{"text"},
text={
ja={
{
"　　　　　　　　　　　　　――ZYPRESSEN Ⅱ――",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg081g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_yum_001335",ch="yum"},
},
ja={
{
"Al llegar al parque, Hikawa-san estaba sentada encima del domo.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_rna_001401",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi... ven...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1i0000",face="i0013",head="yum_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001336",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Hasta allá?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_rna_001402",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, ven y siéntate conmigo.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",lv=4,id=9},
{"fgact",ch="優美",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001337",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"msgoff"},
{"fg",ch="優美",speed=300,mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x2=0,x=100,lv=4,id=9},
{"quake"},
{"quake",mode="mw"},
{"se",id=1,file="se_punch2"},
{"ex",time=1000,func="wait"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001403",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Q-Qué pasa? ¿Por qué estas golpeando el juego?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0011",head="yum_z1i",x=100,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001338",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No, no pasa nada, Hikawa-san... solo que, había, un mosquito parado sobre el\njuego.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_rna_001404",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿S-Sí?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0002",head="yum_z1i",x=100,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=100,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_yum_001339",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No. Sí. No te preocupes. Si lo haces te mataré.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_rna_001405",ch="rna"},
},
ja={
{
name={"Rina"},
"“N-No entiendo muy bien lo que sucede, pero está bien...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_yum_001340",ch="yum"},
},
ja={
{
"Si llega a darse cuenta, este genial momento llegará a su fin.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_yum_001341",ch="yum"},
},
ja={
{
"Y es que, debido a la intrincada forma que tenía el juego que golpeé, me\nfracturé el meñique.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_yum_001342",ch="yum"},
},
ja={
{
"Hikawa-san es muy buena, la conozco. Seguramente se alarmará y llamará a una\nambulancia, o a quién sabe.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_yum_001343",ch="yum"},
},
ja={
{
"Además, algo de dolor es mejor para saborear esta felicidad. Si no fuera por el\ndolor, la incertidumbre de si esto es un sueño o no me carcomería.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="fem_yum_001344",ch="yum"},
},
ja={
{
"Un poco de dolor a cambio de una gran alegría.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_yum_001345",ch="yum"},
},
ja={
{
"Esa forma de vivir me luce mejor.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0009",head="yum_z1i",x=100,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001346",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“O-Oye, Hikawa-san.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_rna_001406",ch="rna"},
},
ja={
{
name={"Rina"},
"“Dime.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0011",head="yum_z1i",x=100,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001347",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Lo de sentarme contigo significa que... puedo sentarme a tu lado?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="fem_rna_001407",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0002",head="yum_z1i",x=100,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001348",ch="yum"},
},
ja={
{
"Hikawa-san me sonríe tiernamente.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_yum_001349",ch="yum"},
},
ja={
{
"Tanta era la felicidad que me dieron ganas de dar otro golpe con mi dedo ya\nfracturado, pero podría terminar desmayándome del dolor, así que decidí no\nhacerlo.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",file="se9004",id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_001350",ch="yum"},
},
ja={
{
"Trepo el domo.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_yum_001351",ch="yum"},
},
ja={
{
"Ni siquiera el dolor de mi meñique fracturado me molestaba ahora. Subí al tope\ndel domo con alegría, como si estuviera subiendo a los cielos.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_yum_001352",ch="yum"},
},
ja={
{
"El parque estaba sobre una colina.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_yum_001353",ch="yum"},
},
ja={
{
"En medio de todos los destruidos juegos del parque estaba el domo, situado en\nla parte más alta de la colina, como si fuera un devastado trono.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_yum_001354",ch="yum"},
},
ja={
{
"Me siento justo al lado de Hikawa-san.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"bg",file="ev_com_d01_01",path=":ev/ev_com_d01/",set="ev_com_d01"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001408",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Está bien tu mano?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_yum_001355",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Está bien.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_yum_001356",ch="yum"},
},
ja={
{
"A diferencia de ayer, hoy pude ver a Hikawa-san de cerca, a la luz de la luna.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_yum_001357",ch="yum"},
},
ja={
{
"Se veía realmente, verdaderamente preciosa.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_yum_001358",ch="yum"},
},
ja={
{
"En lo que me quedo viéndole ardientemente, nuestros ojos se cruzaron de nuevo.\nY entonces, me sonrió hermosamente.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_yum_001359",ch="yum"},
},
ja={
{
"Mi pecho se sobresaltó.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_rna_001409",ch="rna"},
},
ja={
{
name={"Rina"},
"“Parece que hoy si puedo sonreír. ¿O quizás me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_yum_001360",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? P-Puedes sonreír siempre que quieras, no me importa...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"bg",file="ev_com_d01_02",sync=0,face=1,time=400,path=":ev/ev_com_d01/",set="ev_com_d01"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001410",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero aquel día pateaste el escritorio...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_yum_001361",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Es que...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"bg",file="ev_com_d01_03",sync=0,face=1,time=400,path=":ev/ev_com_d01/",set="ev_com_d01"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001411",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, bueno, supongo que es difícil saber cómo actuar cuando alguien te sonríe de\nla nada. No puedo negar que lo hice sin realmente pensarlo...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_yum_001362",ch="yum"},
},
ja={
{
"Si pateé el escritorio aquel día, fue por todos esos pensamientos sucios que\ntuve al ver tu sonrisa.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_yum_001363",ch="yum"},
},
ja={
{
"Hikawa-san está sonriendo como si nada, sin conocer en absoluto mis ocultos\ndeseos.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_yum_001364",ch="yum"},
},
ja={
{
"Y está ahora viendo las estrellas.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_yum_001365",ch="yum"},
},
ja={
{
"¿Debería aprovechar y acercármele un poco más?",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_rna_001412",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sabes?...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_yum_001366",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? L-Lo siento--”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_rna_001413",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_yum_001367",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿Qué ibas a decir?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_rna_001414",ch="rna"},
},
ja={
{
name={"Rina"},
"“Cuando te vi subiendo hasta acá parecías estar de buenos ánimos, así que te\nllamé por tu nombre.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_yum_001368",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh?　A-Ahora que lo dices, ¿me llamaste Yuumi hace un rato?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_rna_001415",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque pensé por un momento que te molestarías bastante si te llamaba por tu\nnombre...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_yum_001369",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“C-Claro que no. No tengo problema alguno con que lo hagas.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_rna_001416",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad? No tienes que llamarme por mi apellido tampoco entonces.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_yum_001370",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Prefiero dejarlo así. No sé por qué, pero siento que el Hikawa-san encaja más\ncon tu imagen...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_rna_001417",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eso crees? A mi no me parece, la verdad...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="fem_yum_001371",ch="yum"},
},
ja={
{
"Para mí, Hikawa-san es 'Hikawa-san'.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_yum_001372",ch="yum"},
},
ja={
{
"Siempre me ha parecido que un honorífico en su apellido se ajustaba\nperfectamente a la elegante y hermosa imagen que tuve de ella la primera vez\nque la vi.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"bg",file="ev_com_d01_04",sync=0,face=1,time=400,path=":ev/ev_com_d01/",set="ev_com_d01"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001373",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿No dibujarás hoy?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_rna_001418",ch="rna"},
},
ja={
{
name={"Rina"},
"“No. Hoy... descansaré un poco de dibujar...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_yum_001374",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Está bien...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bg",file="ev_com_d01_03",sync=0,face=1,time=400,path=":ev/ev_com_d01/",set="ev_com_d01"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001375",ch="yum"},
},
ja={
{
"Un breve silencio se impuso.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_yum_001376",ch="yum"},
},
ja={
{
"Hikawa-san no para de ver las estrellas.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_yum_001377",ch="yum"},
},
ja={
{
"Y yo la veo a ella.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_rna_001419",ch="rna"},
},
ja={
{
name={"Rina"},
"“Las estrellas están hermosas hoy, ¿no crees?...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_yum_001378",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_yum_001379",ch="yum"},
},
ja={
{
"Las estrellas brillan hoy más de lo usual porque buena parte de la luna está\noculta. Eso es todo.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_yum_001380",ch="yum"},
},
ja={
{
"En el momento en que la luna recupere su brillo original, las estrellas\nvolverán a ser solo tenues destellos de luz.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"bg",file="ev_com_d01_05",sync=0,face=1,time=400,path=":ev/ev_com_d01/",set="ev_com_d01"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001420",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Ah, una llama roja!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_yum_001381",ch="yum"},
},
ja={
{
"Hikawa-san alza su dedo, señalando al sur del cielo veraniego.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_yum_001382",ch="yum"},
},
ja={
{
"No había ninguna llama allí.\nSolo una estrella.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_yum_001383",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Te refieres a Antares?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"bg",file="ev_com_d01_03",sync=0,face=1,time=400,path=":ev/ev_com_d01/",set="ev_com_d01"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001421",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Es una de las estrellas que compone la constelación de Escorpio.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_yum_001384",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué le llaman llama roja?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_rna_001422",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por un deseo de inmolación... O así va la historia, supongo.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_yum_001385",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Un deseo de inmolación?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bg",file="ev_com_d01_06",sync=0,face=1,time=400,path=":ev/ev_com_d01/",set="ev_com_d01"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001423",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hace mucho tiempo, en las planicies de Badrah, vivía un escorpión que se\nalimentaba de pequeños insectos y otros animalitos. Un día, una comadreja lo\nencontró y se lo quiso comer.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_rna_001424",ch="rna"},
},
ja={
{
name={"Rina"},
"“El escorpión intentó huir con desesperación, pero al final, acorralado, cayó en\nun pozo. A pesar de sus esfuerzos, no pudo salir y empezó a ahogarse.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_rna_001425",ch="rna"},
},
ja={
{
name={"Rina"},
"“En ese momento, se puso a rezar esto.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_rna_001426",ch="rna"},
},
ja={
{
name={"Rina"},
"'¿Cuántas vidas de insectos habré tomado hasta ahora para subsistir? Y, ahora,\nal perseguirme la comadreja, he querido escapar, sin lograr siquiera salvar\nmi propia vida'",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_rna_001427",ch="rna"},
},
ja={
{
name={"Rina"},
"'¿Por qué no habré dejado que me capturara sin resistir? Quizá así ella hubiera\npodido vivir un día más. Dios mío, mira mi corazón,--'",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_rna_001428",ch="rna"},
},
ja={
{
name={"Rina"},
"'Y no permitas que mi próxima vida se derroche de este modo. Haz que mi cuerpo\nsea útil a los demás.'",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_rna_001429",ch="rna"},
},
ja={
{
name={"Rina"},
"“Al decir esto, el escorpión vio que su cuerpo comenzaba a arder con una hermosa\nllama roja que iluminaba la oscuridad de la noche.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_rna_001430",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esa llama que aún sigue ardiendo es ese escorpión.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_yum_001386",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Je? ¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_yum_001387",ch="yum"},
},
ja={
{
"Al verme desconcertada, Hikawa-san se apresuró a explicarme.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"bg",file="ev_com_d01_07",sync=0,face=1,time=400,path=":ev/ev_com_d01/",set="ev_com_d01"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001431",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, lo siento. Es el relato del fuego del escorpión, de 'El tren nocturno de la\nVía Láctea'. Me encanta esa parte...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_yum_001388",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Esa obra no era de Hayao Miyazaki?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_rna_001432",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nada más acertaste en el kanji de 'Miya'. Es Kenji Miyazawa.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_yum_001389",ch="yum"},
},
ja={
{
"¿No que sí es lo mismo?\nDe mi parte no lo sé, la verdad.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"bg",file="ev_com_d01_03",sync=0,face=1,time=400,path=":ev/ev_com_d01/",set="ev_com_d01"},
{"text"},
text={
vo={
{"vo",file="fem_rna_001433",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kenji Miyazawa escribió otra historia similar, llamada 'La estrella\nchotacabras'. La historia habla de cómo el propio chotacabras se convirtió en\nuna hermosa luz, azul como la de una llama de fósforo, y se volvió la\nestrella chotacabras.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_yum_001390",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No la conocía...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_rna_001434",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pienso que Miyazawa se inspiró en Gogh.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_rna_001435",ch="rna"},
},
ja={
{
name={"Rina"},
"“Entre sus obras hay una colección de poemas llamada 'Primavera y Caos'. En\nellos aparece varias veces la palabra 'Zypressen', la cual significa 'ciprés'\nen alemán.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_rna_001436",ch="rna"},
},
ja={
{
name={"Rina"},
"“Zypressen, hacen fila en primavera.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_rna_001437",ch="rna"},
},
ja={
{
name={"Rina"},
"“Zypressen, silencioso se mece.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_rna_001438",ch="rna"},
},
ja={
{
name={"Rina"},
"“Zypressen, finalmente negro, llueve entonces fuego de las nubes.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_rna_001439",ch="rna"},
},
ja={
{
name={"Rina"},
"“El ciprés descrito en ese poema es, probablemente, el de Gogh...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_yum_001391",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ayer estuviste hablando de Gogh también, ahora que lo recuerdo.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_rna_001440",ch="rna"},
},
ja={
{
name={"Rina"},
"“Gogh pintó un cuadro poco antes de morir, meses antes de intentar suicidarse.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_rna_001441",ch="rna"},
},
ja={
{
name={"Rina"},
"“El nombre de esa obra es 'Camino con ciprés bajo el cielo estrellado'.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_rna_001442",ch="rna"},
},
ja={
{
name={"Rina"},
"“En ella está pintada un enorme ciprés que alcanza los cielos, como si fuera una\nllamarada negra. Y a su lado, un sendero.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_rna_001443",ch="rna"},
},
ja={
{
name={"Rina"},
"“Al lado izquierdo del cielo de la noche está una estrella, tenue, sin vida. Y\nal otro lado está la luna, delgada y fina, como si alguien o algo hubiera\nrecortado un pedazo del cielo. Entre ellas dos se impone el negro ciprés,\nseparándolas.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_rna_001444",ch="rna"},
},
ja={
{
name={"Rina"},
"“La temática hace alusión a la muerte, de una manera simbólica...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_rna_001445",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quizás a Miyazawa le pareció que los cipreses, o Zypressen, eran como negras\nllamaradas que alcanzaban incluso el propio cielo...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_rna_001446",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tantas historias de seres que se vuelven llamas en el cielo de la noche y\nbrillan por la eternidad... Quizá entonces los cipreses son el fuego negro de\nlos cielos.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_rna_001447",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así como la roja llama del escorpión, y la azul llama del chotacabras... los\ncipreses son la llama negra.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_yum_001392",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ehm... ¿Esa es la razón por la cual vienes a pintar aquí de noche?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_rna_001448",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, eh, es por eso en parte, pero... ah, lo olvidaba, debo tomarme ya la\nmedicina.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_yum_001393",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿La medicina?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_rna_001449",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, disculpa.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_yum_001394",ch="yum"},
},
ja={
{
"Hikawa-san saca unas pastillas de un blíster, dándome la espalda para\nocultarlas.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_yum_001395",ch="yum"},
},
ja={
{
"Pero no quise perderme ni uno solo de sus gestos ni movimientos, así que me\narrimé a verla a escondidas.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_yum_001396",ch="yum"},
},
ja={
{
"Me grabé en la cabeza el nombre que estaba escrito en el blíster. 'UFT Sunfural\nS'.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_rna_001450",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Podemos vernos de nuevo mañana?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_yum_001397",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“C-Claro...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_yum_001398",ch="yum"},
},
ja={
{
"El nombre de su medicina no se despegó ni un momento de mi mente.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_yum_001399",ch="yum"},
},
ja={
{
"¿Por qué?... Es como si ya supiera para qué sirve ese medicamento.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"bg",file="ev_txt_c06_01",time=2000,path=":ev/ev_txt_c06/",set="ev_txt_c06"},
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　　――Símbolos y Muerte――",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_yum_001400",ch="yum"},
},
ja={
{
"Aquella noche, me puse a investigar acerca de esa medicina.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_yum_001401",ch="yum"},
},
ja={
{
"Y entonces, descubrí su secreto.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_yum_001402",ch="yum"},
},
ja={
{
"La razón por la cual evita la luz del sol.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_yum_001403",ch="yum"},
},
ja={
{
"La razón por la cual mencionaba insinuantemente la muerte.\nO más bien, por qué prefiere las obras en las que se acepta.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_yum_001404",ch="yum"},
},
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　　　Gogh　y los cipreses.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_yum_001405",ch="yum"},
},
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　Kenji Miyazawa,　el escorpión,　la estrella chotacabras.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_yum_001406",ch="yum"},
},
ja={
{
"Obras que siendo símbolos de la muerte, son muestras de una alegre aceptación\npor ella.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_yum_001407",ch="yum"},
},
ja={
{
"Ella eligió ese estilo de obras,\nintentando huir de todo lo terrible del mundo real,\nusando el poder que se esconde en ese mundo de fantasía.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_yum_001408",ch="yum"},
},
ja={
{
"Ella evita en lo posible la luz del sol,\nprefiriendo el brillo de la luna, jugando sola en las noches,\nentre los cipreses y los juegos del parque.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_yum_001409",ch="yum"},
},
ja={
{
"Y es que,\nel hecho de que su belleza...\nestuviera tan cercana a la muerte...",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_yum_001410",ch="yum"},
},
ja={
{
"El hecho de que ella fuera como la luna, como una llama azul brillante,\nde que su vida solo naciera de la luz reflejada del exterior,\ny de que todo su cuerpo estuviera hundido en la oscuridad de la muerte...",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_yum_001411",ch="yum"},
},
ja={
{
"Todo eso era ella. Ella era una composición de todas esas metáforas.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_yum_001412",ch="yum"},
},
ja={
{
"　　　　　　　La medicina que controlaba eso que le robaba la vida.",
{"rt2"},
"　　　　　　　　　　　　　Su nombre era　“UFT Sunfural S”.",
{"rt2"},
"　　　　　　　　　　　Uno de sus efectos secundarios era fotosensibilidad.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_yum_001413",ch="yum"},
},
ja={
{
"Su sombrilla blanca, su vestido blanco.\nQue solo jugara ahí de noche, su frágil hermosura, su actitud,\nnada de eso era coincidencia. Era todo necesario.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_yum_001414",ch="yum"},
},
ja={
{
"Dentro de ella residía un terrible mal.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_yum_001415",ch="yum"},
},
ja={
{
"Y a la vez, el miedo llevó a su mente a necesitar arte en el se gozara de la\nmuerte.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_yum_001416",ch="yum"},
},
ja={
{
"El día siguiente estaba ella allí, riendo como siempre.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_yum_001417",ch="yum"},
},
ja={
{
"Estaba sonriendo con ternura, rodeada de varias personas.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_yum_001418",ch="yum"},
},
ja={
{
"En mi caso, ya no podía verla como la misma chica elegante de siempre. Su forma delicada de hablar, su calmada actitud, su pulcritud, todo eso lo veía ahora\ncomo una especie de naturaleza nerviosa, desarrollada instintivamente para\nresistir su enfermedad.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_yum_001419",ch="yum"},
},
ja={
{
"Su belleza se balanceaba sobre ese peligroso, inestable pilar.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_yum_001420",ch="yum"},
},
ja={
{
"Nuestros ojos se volvieron a cruzar.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_yum_001421",ch="yum"},
},
ja={
{
"Pero esta vez Hikawa-san no me sonrió.\nAl mostrar una mirada algo triste, apartó su vista.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_yum_001422",ch="yum"},
},
ja={
{
"'¿Qué demonios le pasa? ¿Por qué puso esa cara?' dijo alguien a mi lado.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_yum_001423",ch="yum"},
},
ja={
{
"Sin ganas de reclamarle a esa persona, me fui.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_yum_001424",ch="yum"},
},
ja={
{
"Estaba enamorada de ella.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_yum_001425",ch="yum"},
},
ja={
{
"Y ahora que descubrí la razón de su belleza, me enamoré aún más.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_yum_001426",ch="yum"},
},
ja={
{
"La muchacha que vive con la Muerte a sus espaldas.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_yum_001427",ch="yum"},
},
ja={
{
"Era eso lo que la hacía hermosa.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_yum_001428",ch="yum"},
},
ja={
{
"Soy una mosca.\nUna mosca, probablemente atraída por el hedor a muerte que ella despedía.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_yum_001429",ch="yum"},
},
ja={
{
"¿León, yo? Eso es creerme demasiado.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_yum_001430",ch="yum"},
},
ja={
{
"No soy cazadora. Soy observadora, que ve cómo otros son cazados.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_yum_001431",ch="yum"},
},
ja={
{
"Y por eso es que deposité mis huevos en su hermoso cuerpo.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_yum_001432",ch="yum"},
},
ja={
{
"Deliré, imaginando mis huevos naciendo por todo su hermoso cadáver.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_yum_001433",ch="yum"},
},
ja={
{
"Mi mente era la de un parásito.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_yum_001434",ch="yum"},
},
ja={
{
"Aun sabiendo que ella intentaba asimilar la muerte,\nnunca me preocupé por darle ánimos.\nLo único que hice fue enamorarme aún más de ella.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_yum_001435",ch="yum"},
},
ja={
{
"Un gusano, eso es lo que soy.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"bg",file="ev_txt_c03_01",time=2000,path=":ev/ev_txt_c03/",set="ev_txt_c03"},
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　　――El artista de los cerezos――",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_yum_001436",ch="yum"},
},
ja={
{
"Tengo que hablar ahora de ese condenado. Del artista de los cerezos.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_yum_001437",ch="yum"},
},
ja={
{
"Las obras del joven artista de los cerezos evocaban también a la muerte.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_yum_001438",ch="yum"},
},
ja={
{
"Al principio solo era un presentimiento, pero después pasó a ser certeza.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_yum_001439",ch="yum"},
},
ja={
{
"Porque topé con ese cuadro de cerezos del centro comunitario.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_yum_001440",ch="yum"},
},
ja={
{
"Pintado con dolor y tristeza hacia un ser querido.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_yum_001441",ch="yum"},
},
ja={
{
"Que su nombre fuera 'Fantasía de un día de cerezos' insinuaba mucho.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_yum_001442",ch="yum"},
},
ja={
{
"Pintada a imagen de Nakahara y su 'Fantasía de un día de primavera'.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_yum_001443",ch="yum"},
},
ja={
{
" ",
{"rt2"},
"　　　　　　En el momento en que nuestros amados mueren, la vida debemos quitarnos.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_yum_001444",ch="yum"},
},
ja={
{
" ",
{"rt2"},
"　　　　　　En el momento en que nuestros amados mueren, ninguna otra\nalternativa tenemos.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_yum_001445",ch="yum"},
},
ja={
{
"Con esta famosa frase comienza el poema que Chuuya compuso, según, dolido por\nla muerte de su hijo.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_yum_001446",ch="yum"},
},
ja={
{
"No sé por qué el artista de los cerezos se inspiró en el poema de Nakahara.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_yum_001447",ch="yum"},
},
ja={
{
"Pero como en el de Chuuya, podía sentir la tristeza de perder a un ser amado.\nEse dolor plasmado en el cuadro, por medio del óleo que lo cubría.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_yum_001448",ch="yum"},
},
ja={
{
"Que apenas al ver por primera vez la obra de Hikawa-san, él notó el aire de\nmuerte que había en ella.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"text"},
text={
ja={
{
"No me gusta mucho ese ciprés.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_rna_001451",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Quién eres?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"excall",file="03_zypressen_02_5"},
{"text"},
linkback="block_00168",
},
label = {
top={block="block_00000",label=1},
},
}
