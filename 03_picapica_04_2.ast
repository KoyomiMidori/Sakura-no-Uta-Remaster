astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"se",id=1,file="se2308"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
"Abro la puerta de la sala de arte. No puedo evitar venir a ver cómo están las\ncosas...",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003648",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh, Rin. ¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003649",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estaba preparando unas cuantas cosas. Estoy por salir.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003650",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así que terminaste viniendo de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sin querer.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003651",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jeje, pero fue justo como lo pensaba.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo tenías todo previsto ya?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"msgoff"},
{"se",file="se9012",id=1},
{"fg",ch="稟",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="稟",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003652",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Nao-kun, escucha...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Rin se acerca a mí y me susurra suavemente al oído.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003653",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ve al desván un momento. Sin hacer mucho ruido.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg051a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"bgm",file="bgm011"},
{"text"},
text={
ja={
{
"No tenía razón alguna para decir que no. Así que vine, tal como me dijo. Y vean\ncon lo que me encuentro...",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"bg",file="ev_com_b03_01",path=":ev/ev_com_b03/",set="ev_com_b03"},
{"text"},
text={
ja={
{
"Está bien dormida, eh...",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Estoy tratando de acercarme sin hacer sentir tanto mi presencia. Pensando en la\nmanera de ser de Toritani, juraba que se despertaría de inmediato, pero...",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oye.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Trato de despertarla.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002319",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm... zzz, zzz...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Me arrodillo al lado de Toritani, y muevo lenta y suavemente uno de sus\nhombros. No pareciera que fuera a despertarse pronto.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002320",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Zzz... zzz...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Vaya que está durmiendo profundamente.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Es realmente raro ver la cara de Toritani al dormir, considerando que ni\nsiquiera sé en qué momento del día duerme.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Aunque, verla ahora así, durmiendo tan indefensa en este lugar, es la prueba\nfehaciente de que está trabajando demasiado.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002321",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Toritani se da la vuelta. Tal vez lo duro del suelo no le deja dormir con\ncomodidad.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Aunque...",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Cada vez que Toritani se mueve, poco a poco su falda va subiéndose.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Sus esbeltas piernas relucen al aire... Sinceramente, esta vista es mortal.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Ah, demonios. Me quedé viendo demasiado.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Quedarme viendo con ojos lujuriosos a una chica dormida me pone en el mismo\npuesto que a Thomas.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Aunque tampoco puedo dejarla durmiendo acá en el desván e irme de la sala de\narte como si nada...",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Bien.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"¿Será que mato algo de tiempo en la sala?",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Decidido por unanimidad. Párate. No verás la falda. No verás lo que hay tras\nesa falda.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Quiero ver, por supuesto. Pero debo hacerlo con su consentimiento.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"No es momento para quedarme embobado viendo esa falda que poco a poco y a paso\nseguro va subiéndose.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"¡Ponte de pie, Naoya! ¡¡Tú puedes!!",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Le meto fuerza a la rodilla que tenía ahora sobre el suelo. Bien, excelente,\nsolo párate ahora...!",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Uooh?!”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"se",file="se9010",vol=40,id=1},
{"bg",file="ev_com_b03_02",path=":ev/ev_com_b03/",set="ev_com_b03"},
{"text"},
text={
ja={
{
"Justo en el instante en que traté de pararme mi cuerpo se echó hacia un lado.\nAl fijarme lo que sucedía, Toritani estaba agarrando el borde de mi camisa.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oye.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002322",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Zzz... kuuh...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ooyeee.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002323",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ngh... zzz...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hola?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002324",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Zzz... Zzz...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Traté de zafarme de la mano de Toritani que sostenía mi camisa, pero me\nretraje.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"... Vaya sueño que se está echando.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Su cara adormecida es realmente pacífica. Por lo general siempre se la pasa con\nel ceño fruncido, así que no puedo evitar pensar eso aún más ahora.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhhmuh...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"En conclusión, basta con que no vea a Toritani y ya.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"¿Ya qué? ¿Será que la recuesto sobre mis piernas? Podría ser una solución\nfactible, de lograr que se levante con eso.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Aunque, personalmente, soy más de que me dejen recostarme sobre las piernas que\nofrecer mis piernas para recostar a alguien.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Moriría por ver la sorprendida cara de Toritani al verse recostada sobre mis\npiernas, pero no es bueno tocar a una chica dormida. Mejor dejémoslo así.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Aparto mi mirada lo más posible, sacando a Toritani de mi rango de visión.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Sin embargo, ese negro uniforme y la seductora línea de sus encantadoras\npiernas se aparecen en las esquinas de mi campo visual... ¡No, detente! ¡No\ndebes ver!",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"¿Por qué no le arreglo la falda y ya? Si le arreglo la falda sin tocar su\ncuerpo, entonces estaría respetando los límites permisibles, ¿no es así?",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"B-Bien, vamos...",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"se",file="se9010",vol=50,id=1},
{"bg",file="ev_com_b03_03",path=":ev/ev_com_b03/",set="ev_com_b03"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002325",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ngh...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Su falda estaba tan subida que no pude evitar asombrarme. Es increíble. Esto es\nmucho más de lo que me imaginaba.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
"¡No, detente ya! ¡Debo apartar mi mirada AHORA MISMO!",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002326",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm... fuh...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Ah, espera, si sigues dando tantas vueltas, ¡ahh! ¡¿Es que acaso eres una\nniña?! ¡¡¿¿Eres una nena de preescolar en su siesta después del almuerzo??!!",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"Esto es en serio. Si sigue así, las pantaletas de Toritani que tanto he dicho\nque quiero ver se ve-- ¡No, ya no solo sus pantaletas, incluso su vientre\npodría llegarse a ver!",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“――Eh... ¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"bg",file="ev_com_b03_04",path=":ev/ev_com_b03/",set="ev_com_b03"},
{"text"},
text={
ja={
{
"Hay una especie de cosa negra en la parte que estaba oculta por la falda...\n¿Qué es esto...?",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Ese algo que está cerca de la articulación del muslo de Toritani... Parece una\nespecie de patrón, o una serie de letras...",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"¿Letras?",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002327",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Toritani le da media vuelta a su cuerpo. Ese fue el golpe final.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Gracias a la falda fija por la región de su cadera no se pueden ver sus\npantaletas. Sin embargo, sus muslos se ven completamente expuestos, y sobre\nellos――",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bgm",stop=1,time=1000},
{"se",file="se9010",id=1,vol=50},
{"bg",file="ev_com_b03_05",sync=1,path=":ev/ev_com_b03/",set="ev_com_b03"},
{"ex",time=400,func="wait"},
{"bg",file="zev_com_b03_05",x=-550,y=-200,time=200,sync=1,path=":ev/ev_com_b03/",set="ev_com_b03",ax=1920,ay=1080,bx=-960,by=-540},
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",id=2,file="se2362"},
{"ex",time=200,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"text"},
text={
ja={
{
"'Solo para uso personal y exclusivo de Naoya-kun (corazón)'",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"bgm",file="bgm031"},
{"msgoff"},
{"bg",file="bg051a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=200},
{"se",file="se2766",id=1},
{"quake",mode="mw"},
{"quake"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡¡¿¿¿Gyaaaaaaaaaaaahhhhhh???!!!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"cgact",stage="bg051",act="いいえ"},
{"fg",ch="真琴",size="z2",my=40,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2b0100",face="b0014",head="mak_z2b",lv=5,id=9},
{"se",file="se3130",id=1},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0014",head="mak_z2a",lv=5,id=9},
},
vl02={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0014",head="mak_z2b",lv=5,id=9},
},
vl03={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0014",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002328",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Eh, qué pasa?! ¿¿¿¿Qué pasa, qué pasa????”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Toritani se levanta de un salto rápidamente ante mi grito con ojos soñolientos.\nTodavía recién levantada, Toritani no logra entender por completo la\nsituación.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿¿¿Pero qué demonios es eso???”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0014h",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002329",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¡¿Kyaaah?!”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"se",file="se9010",id=1},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0018h",head="mak_z1d",lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani se baja de nuevo la falda que tenía subida.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"La manera en que apretuja su falda hacia abajo y se ruboriza como un tomate se\nme hace inesperadamente tierna.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"No, de inesperado no tiene nada. Toritani es linda, lo es. No, espera, espera,\ncon toda claridad estoy alterado en este momento.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0014h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0007h",head="mak_z1d",lv=4,id=9},
},
vl02={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002330",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿V-Viste algo? ¿O no? ¡Dependiendo de lo que respondas podrías ser c- castigado\ncon una s-sesión de tortura!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡No he visto nada!! ¡¡Quería ver, pero no vi nada!! ¡¡Pero vi!!”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0014h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0014h",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002331",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿C-Cuál de las dos?! ¡¡¿¿Espera, es que acaso viste algo??!!”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Siento que no debería decirlo yo...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0013h",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0006h",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002332",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Jaa?! ¡Tú, voltea hacia el otro lado!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Obedezco su orden y le doy la espalda.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"se",file="se0897s",id=1},
{"mwact",act="いいえ"},
{"text"},
text={
ja={
{
"Siento cómo Toritani se levanta la falda a mis espaldas. Solo el sonido de la\ntela moviéndose me pone muy intranquilo.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002333",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡¡¡Gyaaaaah!!!!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"En contraste con el tierno chillido de hace un momento, un fuerte y salvaje\ngrito sale ahora de la boca de Toritani.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002334",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡¡RIN-CHAN!!!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"se",file="se3130",id=1},
{"quake"},
{"text"},
text={
ja={
{
"Toritani baja del desván casi saltando y sale disparada de la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Ahh, así que era una broma de Rin... Aunque, me sorprende que se haya dado\ncuenta de inmediato que se trataba de la letra de Rin...",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Excelente observadora que es Toritani. Ahora que lo recuerdo, ambas me habían\ndicho que discutían en medio de clases intercambiándose sus cuadernos.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"No, no es momento de ponerme a pensar en eso.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"se",file="se9012",id=1},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Salí de inmediato de la sala para perseguir a Toritani.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"se",stop=1,time=500,id=1},
{"bgm",stop=1,time=1000},
{"msgoff"},
{"ex",time=1000,func="wait"},
{"bg",file="bluesky_summer",time=2000,id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002335",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡De verdad que... ahhh, rayos!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Salgo por el portón frontal del colegio, y me dirijo al templo Hakuki.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Rin-chan comentó que tal vez elegiría ese lugar para pintar su paisaje.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"se",file="se0110",id=1,loop=1},
{"cgdel",id=-1},
{"bg",y=-240,speed=300,sync=0,file="zbg063a",path=":bg/",x2=200,y2=-240,x=0,ax=1920,ay=1080,bx=-960,by=-540},
{"fg",ch="稟",size="z2",speed=300,sync=0,mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",x2=200,x=0,lv=5,id=9},
{"quake"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002336",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡Rin-chan!!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Agarro el brazo de Rin-chan, quien estaba parada en la entrada del templo. A\nlos pies de Rin-chan estaban los instrumentos de pintura, aún guardados.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Me pareció raro que alguien tan dedicada y diligente como ella estuviera acá\nparada sin hacer nada. Sin embargo, no es momento para pensar en eso.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003654",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Nao-kun te vio? ¿Se te aceleró el pecho cuando lo hizo?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002337",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Escucha...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Había tan poca maldad en la actitud de Rin-chan, que al ver sus ojos, tan\ninocentes como los de una niña, terminé vaciándome de toda la furia con la\nque había venido.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"No es nada de qué sorprenderse.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Aunque no sepa la verdadera razón por la cual hizo esa broma, no hay manera de\nque Rin-chan pueda tener alguna mala intención.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002338",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Escúchame, ¿sí?...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Comienzo a hablar como si tratara de explicarle algo a una niña pequeña.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002339",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No puedes hacer ese tipo de cosas, así sea en broma.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003655",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No fue ninguna broma. Lo hice con toda seriedad.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002340",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eh...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Creo que me quedé algo atolondrada.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"se",stop=1,id=1,time=5000},
{"se",file="se9010",id=2,vol=50},
{"msgoff"},
{"bg",file="bg063a",path=":bg/",sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm029"},
{"text"},
text={
ja={
{
"Rin-chan escurre su brazo de mi mano.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"No deja de sonreír. Con ojos cariñosos y una suave voz, Rin-chan comienza a\nhablar.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003656",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan, ¿recuerdas lo que hablamos esta mañana?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002341",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esta mañana...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Lo recuerdo.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Al ir a limpiar la sala de arte por la mañana, Rin-chan me dijo que ella\nlimpiaría la sala por mí.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bg",file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002342",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero no es obligación tuya que limpies, y yo solo lo hago por gusto, así\nque...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003657",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, lo sé, y por eso me gustaría hacerlo yo también. Quisiera limpiar la sala\nde arte de manera espontánea y con gusto, sin que nadie me lo ordene.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003658",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan, no hace falta que limpiemos juntas, ¿verdad? Así que me gustaría que\nme cedieras el turno de hoy.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002343",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh... D-De ser así...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003659",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Así que date por vencida esta vez y ve a hacer alguna otra cosa, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002344",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Disculpa que te ponga a hacer esto.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003660",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No tienes nada de qué disculparte. En estos momentos me haría más feliz un\n'gracias' que un 'disculpa'.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002345",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, eso fue...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003661",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso fue?...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002346",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi dijo algo parecido hace un tiempo... Por más tiempo que hayan estado\nseparados, esa clase de coincidencias demuestra que realmente son amigos de\nla infancia.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003662",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso crees?... Yo creo que más bien Nao-kun y yo no nos parecemos para nada.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002347",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“S-Sí, en eso tienes razón, pero a veces, en ciertos momentos... percibo una\nespecie de, conexión entre los dos.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003663",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002348",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003664",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me das mucha envidia. Me da envidia que hayas podido pasar todos estos 3 años\njunto a Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002349",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Rin-chan... Escucha bien, Kusanagi y yo somos como chicle pegado a un zapato,\nasí no lo queramos terminamos siempre juntos. Pero solo eso, 3 años juntos\nsin que sucediera realmente nada.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002350",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por casualidad quedamos en la misma clase, y por la misma casualidad de manera\nseguida por estos 3 años. Así que no hay nada, absolutamente nada de lo que\ndebas preocuparte, Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002351",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Puedes quedarte tranquila de que no hay nada entre los dos. Solo, he estado\npasando por algunas dificultades... y parece que ha venido dándose cuenta de\neso, pero solo por ahora, así que pronto él...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003665",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Está bien, entiendo. Gracias, Mako-chan.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002352",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? Ah, no hay de qué...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003666",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creo que ya entendí lo que sientes, Mako-chan. Yo me encargaré de limpiar, así\nque sal y haz cualquier otra cosa que quieras hacer.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002353",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003667",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nos vemos después, ¿está bien?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"cgdel",id=-1},
{"bg",file="white",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063a",path=":bg/",sync=0},
{"extrans",time=500},
{"se",id=1,file="kazenari"},
{"text"},
text={
ja={
{
"*zaa*――",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"El viento sopla. Parpadeo.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Frente a mí, Rin-chan seguía aún sonriendo.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Rin Misakura... Una chica tan hermosa como un hada, quien llegó junto a la\nprimavera.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Cualquiera quedaría embelesado con ella. No lo digo solo por decirlo, pues yo\nsoy una de esas personas.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003668",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan... Eres demasiado amable, siempre atenta conmigo y sin pensarlo...\nno, a veces lo haces de manera consciente también.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003669",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y no solo te preocupas por mí, sino por muchas otras cosas también. Como\nresultado, terminas poniéndote siempre de último lugar en tus prioridades.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003670",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero odio que trates de ser amable conmigo en esto también.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Pude entender al instante lo que quería decir con 'esto'. Y por eso es que no\nfui capaz de responder.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003671",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan, así como me quieres a mí y a Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003672",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No. Así como me quieres a mí y a Kusanagi-kun... Yo también los quiero a los\ndos.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003673",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Deseo que los dos sean felices.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002354",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Rin-cha--”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003674",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y, por otro lado, me irrita también un poquito que me hagas esto.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Me quedo sin palabras.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Rin-chan se veía preciosa y tierna inclinando su cabeza hacia un lado. Y por\neso es que me da algo de miedo...",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003675",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan, duele bastante cuando tu oponente te deja agonizando. Y aunque no lo\nparezca, soy de las que prefiere resolver las cosas a la fuerza de ser\nnecesario. Me harías un gran favor si me das la última puñalada y acabas con\nmi sufrimiento.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002355",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Esa forma en que lo dices...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Jamás me había sentido tan incómoda.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Rin-chan lo sabía todo ya... No sé cómo expresar muy bien esto, pero si tuviera\nque usar la expresión que encuentro más cercana, diría que me siento\navergonzada de mí misma.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Rin-chan sonríe de manera radiante. Con la sonrisa de un ángel. Y se sabe que\nen la Biblia, los ángeles pueden traer consigo masacre y milagros a la vez.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003676",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Entendiste cómo me siento?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002356",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Sí, lo entiendo.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003677",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso me alegra.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Lenta y delicadamente, la sonrisa de Rin-chan tomó una expresión suave.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Suave, como las nubes de primavera. Algo dulce, pero efímero, como un algodón\nde azúcar que se derrite al meterlo a la boca... Su sonrisa me genera esa\nimpresión tan fuera de lugar.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002357",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003678",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Rin-chan baja su mirada lentamente.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Pero, solo dura unos segundos así, y luego――",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Justamente después, Rin-chan volvió a subir la cara. Allí estaba la misma\nRin-chan de siempre.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003679",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Bien, me voy ya, ¿está bien?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"msgoff"},
{"fg",ch="稟",size="z1",time=500,mode=3,path=":fg/rin/z1/",file="rin_z1c0100",face="c0001",head="rin_z1c",lv=4,id=9},
{"ex",time=100,func="wait"},
{"se",file="se9004",id=1},
{"fg",ch="稟",sync=1,mx=-40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Rin-chan toma sus instrumentos de pintura y se devuelve al colegio.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Contemplé en silencio su espalda alejarse. En el cielo se veía la pequeña y\nblanca luna de mediodía.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
