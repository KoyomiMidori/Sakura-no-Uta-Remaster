astver = 2.0
astname = "ast"
ast = {
block_00000={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="bluesky_summer",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"text"},
text={
ja={
{
"Después de comer algo rápido, me dirijo a la sala de arte.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Casi todos los miembros del club estaban en la sala, muy seguramente por el\ncampamento de mañana.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Exceptuando a una sola persona...",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0100",face="a0017",head="kei_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=345,lv=4,id=6,sync=0},
{"extrans"},
{"bgm",file="bgm106"},
{"text"},
text={
vo={
{"vo",file="man_ked_000985",ch="ked"},
},
ja={
{
name={"Kei"},
"“Oye, Naoya, ¿no vas al campamento?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, pues, no...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001421",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Toritani me observa.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0006",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001422",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hoy es el último día. Aún puedes comprar tu boleto.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, lo siento. Parece que no podré ir.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"bg",file="black",path=":bg/"},
{"se",file="se9012",id=1},
{"text"},
text={
ja={
{
"Me voy de la sala de arte al cuarto de preparativos.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Quería confirmarlo una última vez.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"se",stop=1,time=500,id=1},
{"bg",file="bg051a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
vo={
{"vo",file="fem_yum_000695",ch="yum"},
},
ja={
{
name={"???"},
"“Si es por todo ese montón de cosas, ya no está.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Escucho la voz de Kawachino detrás de mí.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso parece, eh.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000696",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Akashi-senpai se lo llevó todo. Probablemente, a la iglesia.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, seguramente.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000697",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quién diría que tú también lo sabes, Kawachino...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000698",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Según vi, tú también parecías estar investigando algo, así que yo también me\npuse a investigar...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tenías que ponerte a investigar tú también algo que estoy investigando\nyo?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0018",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000699",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, pues...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000700",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Odio este club de arte...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000701",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Los lazos que hay entre las personas de este club son muy fuertes... Por eso es\nque odio este club de arte.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0006",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000702",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En especial, ustedes...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En especial nosotros, qué?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
"Las palabras de Kawachino se detuvieron allí.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_yum_000703",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero irán todos de campamento ahora, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0001",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000704",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú también entrarás ahora dentro de esos lazos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000705",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues, así será, supongo...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0015",head="yum_z1a",lv=4,id=9},
{"fgact",ch="優美",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0001",head="yum_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_yum_000706",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jaa... Aunque no puedo aguantar ya las ganas de ir. Es maravilloso poder ir al\ncampamento sin Akashi-senpai ni tú. Podre además estar con Rina todo lo que\nquiera...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál es el problema entonces? Si tantas ganas tienes.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0017",head="yum_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0100",face="a0011",head="yum_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_yum_000707",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Son esas ansias lo que me molesta... Aunque, alguien tan torpe como tú\nprobablemente no lo entienda...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="優美",size="z2",my=40,mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2a0100",face="a0006",head="yum_z2a",lv=5,id=9},
{"se",file="se3130",id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_000708",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Idiota! ¡Realmente los odio a ustedes!”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No nos odies tanto...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="優美",mode=3,path=":fg/yum/z2/",file="yum_z2a0100",face="a0005",head="yum_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000709",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eso es porque lo único que hacen son cosas que se ganan el odio de los demás.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Algo tan feo hice como para que me odiaras?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0110",face="b0015",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000710",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Por eso te digo que eres torpe...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Habla claramente. No te puedo escuchar.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0006",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000711",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Es que acaso no conoces las palabras amor y odio? ¡Lo único que deberías hacer\nson cosas sin importancia! ¿Por qué tienes que ir haciendo siempre aquello\nque le llama más la atención a los demás?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir... con eso de cosas que llaman la atención?...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0005",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000712",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No importa. Solo me hablaba a mí misma. En fin, te aborrezco. Procura no\nolvidar justamente eso, por favor.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu, pero qué lío...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0011",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000713",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya lo sé bien... Sé que tienes innumerables pasados como el que tuviste conmigo\ny Rina...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000714",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Por andar así como ahora, siempre, metiendo tus narices en todas partes... Es\nde esperar que termines así, al estar haciendo solo eso desde el pasado hasta\nel día de hoy...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm... ¿Puedes decirme de qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0018",head="yum_z1b",lv=4,id=9},
{"fgact",ch="優美",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000715",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No hace falta, no te preocupes. Lo repetiré una vez más, solo hablaba sola.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_rna_000329",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi, respecto a lo de mañana~”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0003",head="yum_z1b",lv=4,id=9},
{"fgact",ch="優美",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_yum_000716",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, y-ya voy, espera un momento. Iré en un abrir y cerrar de ojos por ti, Rina.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"msgoff"},
{"fg",ch="優美",speed=500,mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0004",head="yum_z1b",x2=0,x=-210,lv=4,id=9},
{"se",file="se9010",vol=40,id=1},
{"ex",time=400,func="wait"},
{"fgact",ch="優美",act="うなづく",lv=4,id=9},
{"text"},
text={
ja={
{
"Kawachino elige unos cuantos materiales para pintar en óleo que estaban en el\ncuarto de preparativos.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0100",face="b0005",head="yum_z1b",x=-210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000717",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bien, Kusanagi-san. Espero que puedas pasártela muy, pero muy bien con\nAkashi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pasármela bien con Akashi?... ¿Pero qué clase de juego de penitencia es ese?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1b0110",face="b0017",head="yum_z1b",x=-210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000718",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tú mismo estás deseando ese juego, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="優美",mx=-40,mode=-1,lv=4,id=9},
{"se",file="se9012",id=1},
{"text"},
text={
ja={
{
"Después de eso, Kawachino salió del cuarto de preparativos.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu... ¿Por qué será que soy tan odiado ahora?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000930",ch="rnd"},
},
ja={
{
name={"???"},
"“¿No querrás decir más bien apreciado?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000931",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo siento. Se podría decir que estuve escuchando a escondidas.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no es de muy buen gusto eso, eh.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000932",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero, al escuchar eso de amor y odio no podía entrar, aunque quisiera\nhacerlo...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es así?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000933",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es así.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000934",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creo que eso es lo más o menos piensan todos de ti en este momento,\nKusanagi-kun... Lo que Yuumi-chan dijo...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué estás diciendo? Estamos hablando de eso de amor y odio. Ninguno de los\nmuchachos tiene tanto interés por mí.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000935",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, ojala fuera así... Oye, Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000936",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Podrías darme un permiso?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="稟",size="z2",my=40,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"se",file="se9010",vol=40,id=1},
{"text"},
text={
ja={
{
"Me aparto del lugar donde estaba parado. Rin se acercó y comenzó a buscar algo\nen el estante del lugar donde estaba parado.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="稟",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0004",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000937",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejeje. ¿Quizás debí haberme parado a tu lado sin decir nada?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="稟",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0001",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000938",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tal como lo dijo Kawachino-san... Kusanagi-kun, siempre andas metiéndote en\nvarios asuntos, y tienes muchos pasados encima que ninguno de nosotros\nconocemos. Todos se han dado cuenta de eso...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, pero nadie realmente tiene tanto interés en mi pasado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="稟",mode=3,path=":fg/rin/z2/",file="rin_z2a0110",face="a0003",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000939",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo lo tengo.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="稟",size="z1",my=40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1b0100",face="b0004",head="rin_z1b",lv=4,id=9},
{"se",file="se9010",vol=40,id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000940",ch="rnd"},
},
ja={
{
name={"Rin"},
"“O, tal vez no~”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Era una broma?...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000941",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto que no. Lo dije en serio. Aunque, lo de 'yo' quizás sea mentira...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000942",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No solo soy yo... probablemente.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué viene esa forma de hablar?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000943",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo han pasado unos pocos meses desde que regresé... Pero, ya sé más o menos\nqué piensan y sienten todos acerca de ti, y además, me enteré de que\nprobablemente cada uno de todos llegó a experimentar algo en el pasado...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, ya estás pensando demasiado... No tengo nada que ver con Kawachino ni con\nThomas, más bien fue hace poco que los conocí por primera vez.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000944",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mmmm. ¿Entonces con los demás sí?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, tampoco. Pues, por ejemplo, fue al entrar a este colegio que conocí a\nToritani.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000945",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo. Aunque no pareciera...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no, lo mismo con Akashi... No todos son viejos conocidos míos.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="ジャンプ",time=400,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000946",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo... sí, tal vez. Bien...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios... ¿Pero qué está pasando? Hasta tú estás en actitud hostil conmigo\nhoy, Rin.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0015",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000947",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues, ¿no crees que es inevitable eso~? Por haber arruinado el campamento~”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El campamento no lo ha arruinado nadie, simplemente sucede que no iré.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000948",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No crees que no ir no es ya suficiente para arruinarlo?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0003",head="rin_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0001",head="rin_z1b",lv=4,id=9},
{"fgact",ch="稟",act="ジャンプ",time=400,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000949",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pueees, ¿quién sabe? Bien. Creo que ya está todo...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueh, sea lo que sea, realmente me siento mal con ustedes por no acompañarlos\nal campamento...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000950",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No te preocupes. Todos entienden lo que sucede. Y por entenderlo que están tan\nenojados.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Rin me sonríe suavemente.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"¿Por qué me sonríes en este preciso momento?",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0015",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000951",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, siempre has sido muy bueno con los demás desde hace tiempo... Y eso no\ncambia aún... no, más bien está empeorando.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Empeorando?...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000952",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Bueno, me iré ya. Te deseo lo mejor. Nosotros también nos esforzaremos bastante\nen el campamento...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="bluesky_summer",id=1,lv=1,rule=139,vague=40,path=":cg/"},
{"ex",time=1000,func="wait"},
{"bg",file="eveningsky_winter",id=2,lv=2,path=":cg/"},
{"ex",time=1000,func="wait"},
{"bg",file="nightsky_summer",id=3,lv=3,path=":cg/"},
{"ex",time=500,func="wait"},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
"La cena termina.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Hoy me fui por algo menos elaborado y preparé puerco salteado. Una simple\nmezcla de puerco y vegetales salteados en caldo de sopa china.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Serví 1 sopa, plato principal y 2 acompañamientos, pero supongo que no fue\nsuficiente...",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"El arroz se esfumó más rápido de lo normal.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hubo mucha variedad en los platillos tampoco... Quizás hubiera sido buena\nidea preparar más de lo normal...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"cgdel",id=-1},
{"bg",file="bg003c",path=":bg/"},
{"se",id=1,file="se3344"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000380",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Estás muy atento a la hora hoy.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000381",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Siempre estás inquieto, aunque tu intranquilidad de hoy no es la misma de\nsiempre.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estoy inquieto todo el tiempo.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000382",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me respondas con esa cara tan verdaderamente extrañada... Y bien, ¿qué\nsucede?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0003",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000383",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Te ayudo entonces con el camuflaje?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Camuflaje? ¿Camuflaje para qué?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000384",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Estás esperando a que Nee-san se duerma, ¿verdad? Para salir...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0012",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000385",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Por qué te sorprendes tanto?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, solo que no pensé que estuviera tan inquieto hoy como para que se notara\ntanto...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0004",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000386",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Si siempre estás tan inquieto como un animalito pequeño, entonces se podría\ndecir que hoy estás tan inquieto como un anciano a punto de morir...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡En ese caso no debería estar inquieto, sino temblequeando!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0016",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000387",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“También le dicen así.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es que también le digan así, es que nada más le llaman así.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000388",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Entonces es así. Estabas temblequeando tanto como un anciano a punto de morir.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo estoy haciendo...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000389",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_szd_000390",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Vas a hacer algo esta noche, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, sí... tal vez...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000391",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Otra vez Akashi-san?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no exactamente otra vez. La vez pasada simplemente estuvo ayudándome.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0005",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000392",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Así que ahora irás a ayudar a Akashi-san?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, tampoco es exactamente así...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y es que, esto es también un problema que debo resolver yo...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000393",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0310",face="a0004",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000394",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Yo me encargaré de lo demás, así que puedes irte con toda tranquilidad, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Encargarte de lo demás?... ¿Qué planeas hacer?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0003",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000395",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Si nee-san llega a darse cuenta de que no estás en tu habitación, entonces le\ndiré lo siguiente: 'Estuvo en mi habitación'.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Hacer eso sería peor! ¡Ai me va a matar! ¡¿Además, que piensas hacer si te\ndice 'haz que salga de la habitación' entonces?!”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0004",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000396",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Debido a unas ciertas circunstancias vergonzosas, huyó. Diré eso.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te estarías encargando de nada haciendo eso. ¡Lo único que harías es\nempeorar las cosas!”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0016",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000397",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tal vez, pero... Es también un hecho que eso sería mucho más divertido de ver...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No necesito diversión alguna en este caso!”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0012",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000398",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No pongas esa cara de desconcierto! ¡No necesito esa clase de diversión!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000399",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero si de verdad llegara a suceder algo así de interesante y divertido, no se\ndará cuenta de que saliste a hacer algo en el colegio...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh... Q-Quizás tengas razón, pero... ¡No! ¡Simplemente dile que fui a ver cómo\nestaba mi casa y ya!”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000400",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, tienes razón. Le diré eso...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1d0300",face="d0004",head="shz_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000401",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya estuvo en mi habitación, pero debido a unas ciertas circunstancias\nvergonzosas, fue a ver cómo estaba su casa. Le diré eso...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que incluyas la primera parte...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="雫",size="z2",my=40,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0300",face="a0002",head="shz_z2a",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_szd_000402",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“En fin, toma esto...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="雫",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0003",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000403",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Onigiris y té.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, la razón por la cual el arroz se acabó tan rápido fue entonces...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="雫",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0008",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0002",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000404",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No tienen muy buena apariencia, pero hazte la vista gorda ante ello. Los hice\nde la forma más delicada que pude. Y, respecto al té, hoy será una noche\ncaliente, así que pensé que sería bueno tenerlo frío, por lo que lo metí en\nun termo grande... Es pesado, pero tiene bastante adentro...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="雫",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0005",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000405",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me parece que en este caso no es 'lo siento'. Es 'gracias', ¿no, Naoya?...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="雫",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0003",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000406",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Dejando atrás la broma de hace un momento, procuraré hacer unas cuantas cosas\npara que Nee-san no se dé cuenta.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="雫",mode=3,path=":fg/shz/z2/",file="shz_z2b0300",face="b0004",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000407",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Que te vaya bien entonces.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"bg",file="nightsky_summer",id=9,lv=9,rule="083r",sync=1,vague=40,path=":cg/"},
{"text"},
text={
ja={
{
"Salí por la puerta de la cocina y hago correr mi bicicleta.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Hay bastante distancia de acá al colegio en bicicleta, pero no es nada que no\npueda recorrer.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Tomé el obentou y el té que Shizuku me preparó, y lo metí en la cesta de la\nbicicleta, para luego salir pedaleando fuertemente.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",file="bg038c",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"No me tomó mucho tiempo. Después de todo, está dentro de la misma ciudad.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Camino la colina que sube hacia el colegio mientras empujaba la bicicleta.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Ahora que lo recuerdo, también hay varias personas que vienen al colegio en\nbicicleta...",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta colina es terrible para el corazón...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"msgoff"},
{"bg",file="znightsky_summer",id=9,lv=9,speed=240000,sync=1,path=":cg/",x2=0,y2=540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, veamos...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Es bastante obvio, pero el portón del colegio está rígidamente cerrado.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Los muros del colegio Yumihari no son tan altos. Supongo que ese es mi único\nconsuelo... Aunque aun así, no es una altura que se pueda escalar.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Apoyo la bicicleta contra la pared.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que con esto podré lograr algo...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Me paro sobre la bicicleta y salto la pared.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"El cielo de la noche está elevado a lo más alto.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Son pocas las oportunidades de ver el cielo nocturno en este lugar tan amplio y\nlibre de iluminación externa.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"El colegio Yumihari está construido sobre un lugar remoto, alejado de todo el\nresto de la ciudad. La colina de Yumihari es una especie de bosque, rodeado\ncasi por completo de árboles.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se podrían observar los astros acá, eh...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Desde la oscuridad de la superficie terrestre se podían observar con bastante\nclaridad las estrellas en el cielo.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Gracias a esta misma oscuridad es que cualquier cosa ligeramente brillante se\nnota fácilmente en la superficie.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Camino lentamente, acercándome a la luz.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"cgdel",id=-1},
{"bg",zone="0x000000",file="bg057g",path=":bg/"},
{"text"},
text={
ja={
{
"Akashi estaba frente a la iglesia, en pleno verano, con una estufa encendida.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Hay cinta de enmascarar pegada sobre una innumerable cantidad de lugares en la\npared de la iglesia. Esa película sirve para cubrir, de antemano, aquellos\nlugares que no se desea manchar ni pintar.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Y también hay una rejilla de líneas verticales y horizontales dibujadas,\nperpendiculares entre sí, como si fueran puntadas.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Seguramente las trazó con un tiralíneas, aquel instrumento usado en\narquitectura y albañilería.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"En cada uno de los puntos donde las líneas se intersectan, hay también trozos\nde cinta pegados, cada una con un pequeño número escrito.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Ya veo, así que tiene todo preparado hasta el más mínimo detalle...",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No puedes encender la estufa en un lugar donde llame menos la atención?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"msgoff"},
{"fg",ch="明石",size="z1",time=1000,mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"ex",time=500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057g",path=":bg/",sync=0},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="man_wtd_000361",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Requiero una distancia sutilmente ideal. Es lo de menos si llama la atención o\nno.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“The Last Leaf... 'La última hoja' ¿Es que acaso pretendes jugar a ser O. Henry?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000362",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Eres idiota? ¿Qué ganaría pintando hojas secas?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé. Si tu plan fuera pintar hojas secas, entonces no hubieras comprado\nesos uwabaki tan extraños.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parecen haber sido reunidos tomando muy en cuenta la coloración. Los colores\ncoincidieron perfectamente cuando los vi mientras observaba la paleta de\ncolores. Awabenifuji, Wakatakeiro...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué bueno que los pudieras conseguir, ¿no? A pesar de haber sido por mera\ncasualidad.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000363",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ni en broma fue por casualidad. Así como los ves, estuve 3 años enteros\nbuscando por todo Japón por ellos...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo que sí...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000364",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Aunque bien que te diste cuenta, eh... De que ejecutaría este plan hoy...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es fácil darse cuenta cuando un tipo insensato hace cosas insensatas...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000365",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Insensato? Hmph, ¿y qué si lo soy? ¿Sabías, Kusanagi? Existen 2 tipos de\npersonas insensatas.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que lo sé. En primer lugar, sería terrible que hubieran tantos tipos de\npersonas insensatas.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De entre las personas insensatas, solo hay villanos, o aliados de la justicia.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000366",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Y es que son los aliados de la justicia quienes persiguen y logran aquella\njusticia inalcanzable dentro del sentido común. ¿Y bien? ¿Cómo te enteraste\nde mi plan?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fui a ver al padre Masada. El padre que está hospitalizado en ese hospital.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"excall",file="02_abend_13_2"},
{"text"},
linkback="block_00206",
},
label = {
top={block="block_00000",label=1},
},
}
