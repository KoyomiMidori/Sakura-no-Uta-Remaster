astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="eveningsky_spring01",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"se",file="se9010",id=1},
{"bgm",file="bgm031"},
{"mwact",act="おじぎ"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mierda... pero qué pared tan alta...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Por una cierta razón, estoy ahora escalando una de las paredes del colegio\nYumihari.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Normalmente esto solo lo haría para huir de Toritani.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Aunque en realidad, no estoy huyendo de ella.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Hoy asistí al club, y además le impartí sus lecciones a Rin.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"En principio, sería inimaginable que saliera del colegio escalando las paredes,\ncomo un ladrón, pero...",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pensé que llegaría a ser rodeado por esa cantidad de chicas...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Lo que Rin decía no era nada exagerado.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Jamás llegué a imaginarme que ese montón de mujeres llegaría a actuar de manera\ntan directa.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La influencia de los medios me pone los pelos de puntaaa.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Son capaces de convertir a una persona anónima, común y corriente en una\ncelebridad de la noche a la mañana.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"En fin, me daba un gran fastidio responder a todas las preguntas de ese montón\nde chicas, así que huí corriendo.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Confiaba en que nadie podría alcanzarme si corría con todas mis fuerzas, pero\nen la entrada principal habían aún más chicas esperando para emboscarme.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aun siendo en broma, no debí haber dicho jamás eso de que quería que me\nadularan, eh...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Al por fin escalar la pared con toda dificultad, caminé a lo largo de la pared\nde una casa y llegué a la vía de la calle.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"cgact",stage="bg015",stime="b",act="うなづく"},
{"se",file="se_hand_pan1",vol=50,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, vaya, vaya, no debería tener de qué preocuparme ya estando acá...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"bgm",stop=1,time=1000},
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000001",ch="knd"},
},
ja={
{
name={"???"},
"“¡Ah~! ¡Ah~! ¡Kusanagi-kuuun!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Justo en el instante en que aterricé de la pared al suelo, alguien me llama.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"bg",file="ev_com_c01_01",path=":ev/ev_com_c01/",set="ev_com_c01"},
{"bgm",file="bgm005"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Quién eres?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"user",mode="conf",ch="香奈"},
{"mwact",act="うんうん",time=800},
{"text"},
text={
vo={
{"vo",file="fem_knd_000002",ch="knd"},
},
ja={
{
name={"Kana"},
"“Jaa, jaa, jaa, t-tiempo sin vernos, soy yo, Kana Nagayama. ¡¿Q-Qué casualidad,\nno?! ¡Encontrarnos, en este lugar!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pero ¿por qué andas jadeando de esa manera y recubierta en sudor?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"bg",file="ev_com_c01_02",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000003",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? E-Eso no es cierto. Así es, no es cierto. Y por otro lado, ¿por qué me\ntratas de 'tú'? Tengo un nombre con todas las de la ley, y es Kana Nagayama.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"¿Kana Nagayama?",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién eres?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"bg",file="ev_com_c01_03",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000004",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Q-Que quién soy? Qué cruel... ¿No recuerdas que estuvimos juntos durante la\nprimaria y la secundaria? Varias veces tocamos incluso en el mismo salón.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"bg",file="ev_com_c01_01",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000005",ch="knd"},
},
ja={
{
name={"Kana"},
"“Claro que sí. Y hoy, de repente, mientras pasaba acá casualmente te encontré,\nKusanagi-kun. ¡De veras que la casualidad es increíble! ¡¿No crees?!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Pasaste casualmente por acá, eh...",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"¿Por qué alguien que estaba pasando solo casualmente por acá está jadeando?",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Y en primer lugar, no comentó absolutamente nada respecto a como salté de la\npared...",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Pero hay bastante distancia del portón de Yumihari hasta acá, ¿no?...\n¿No estarás bastante cansada ahora?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000006",ch="knd"},
},
ja={
{
name={"Kana"},
"“No, para nada. ¡Vine sin ningún problema!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Casualmente... eh.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"bg",file="ev_com_c01_04",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000007",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Mmm?!”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Así que era una de las tantas mujeres que estaba esperándome en el portón del\ncolegio. Aunque parece que fue la única que corrió hasta acá\npersiguiéndome...",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"bg",file="ev_com_c01_05",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000008",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, esto, digo... ehm, sí, eso. Kusanagi-kun, ¡volviste a pintar de nuevo,\n¿verdad?!”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Volver a pintar de nuevo?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_knd_000009",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, quedé totalmente asombrada. Siempre me han gustado todas tus pinturas, así\nque me sentí muy mal cuando supe que habías dejado de pintar.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé qué clase de malentendido estás teniendo ahora, pero... no es así.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_knd_000010",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Lo vi todo en la TV! Fue increíble. En el instante que lo vi, pensé, 'Ah, solo\nKusanagi-kun podría hacer esto'. ¡Nadie más podría hacer algo parecido,\n¿verdad?! No podía esperar menos de ti, fue verdaderamente increíble.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"¿Es que estás hablando del mural de la iglesia?... Eso no lo hice yo, lo hizo\nAkashi.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"¿A qué viene eso de 'no podía esperar menos de ti'?",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_knd_000011",ch="knd"},
},
ja={
{
name={"Kana"},
"“No he podido evitar sentirme orgullosa y jactarme de eso en mi colegio. A todos\nles digo 'Ah, él es mi amigo. Estuvimos en el mismo colegio todo este\ntiempo'.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"No sé si realmente estuvimos o no en el mismo colegio, pero la verdad es que no\nrecuerdo casi nada de ti.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"bg",file="ev_com_c01_03",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000012",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero ¿por qué dejaste de pintar de repente?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no importa ahora...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_knd_000013",ch="knd"},
},
ja={
{
name={"Kana"},
"“En ese entonces escuché rumores de que habías sufrido un accidente...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_knd_000014",ch="knd"},
},
ja={
{
name={"Kana"},
"“No sé realmente si fue por un accidente que dejaste de pintar, pero...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_knd_000015",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero, si de verdad dejaste de hacerlo por una razón tan absurda, entonces la\npersona que causó ese accidente debería pagar varias decenas, cientos, miles\nde millones en compensación.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"bg",file="ev_com_c01_06",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000016",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Fue culpa de alguien en carro? ¿Quedaste con alguna secuela? Ahora que lo\nrecuerdo, en esa época te ausentaste del colegio por varias semanas...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_knd_000017",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y por cierto, en esa misma época...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"bgm",stop=1,time=500},
{"se",file="se3130",id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡C-Calláte!”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"bg",file="ev_com_c01_03",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"bgm",file="bgm026"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000018",ch="knd"},
},
ja={
{
name={"Kana"},
"“Fueh--”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-Ni te atrevas a decir ni una vez más eso que acabas de decir.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Razón absurda?! ¡¿Qué demonios sabes tú de mí?! ¡No sé si de verdad somos\nviejos conocidos o no, pero no vengas a balbucear estupideces con esa cara de\n'yo lo sé todo'!”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"bg",file="ev_com_c01_07",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000019",ch="knd"},
},
ja={
{
name={"Kana"},
"“K-Kusanagi-kun...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé de qué manera pienses de mí, pero en lo que a mí concierne no te recuerdo\npara nada. Sinceramente, eres una molestia. ¡Deja de andar siguiéndome por\nahí!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"¿Una vieja conocida?",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Maldita sea, me hizo ahora recordar cosas que no debería recordar...",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hazte a un lado, no tengo nada que hablar contigo...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Trato de irme de ese lugar.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_knd_000020",ch="knd"},
},
ja={
{
name={"Kana"},
"“K-Kusanagi-kuun...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bg",file="ev_com_c01_08",sync=0,face=1,time=400,path=":ev/ev_com_c01/",set="ev_com_c01"},
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"bgm",file="bgm007"},
{"quake",size=4,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000021",ch="knd"},
},
ja={
{
name={"Kana"},
"“L-Lo sientooo... No pensé que llegarías a enfadarte tanto, pero no tenías por\nqué gritarme así, y más cuando nos encontramos ahora tras tanto tiempo...\n*uuhh*, *uuhh*.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_knd_000022",ch="knd"},
},
ja={
{
name={"Kana"},
"“Kusanagi-kun, siempre me gustaste, y simplemente quería expresar lo mucho que\nme lamentaba todo, y ciertamente no sé mucho respecto al accidente, pero me\nsentí tan frustrada por ese accidente que robó de tu talento, y,\nKusanagi-kun, Kusanagi-kun... Ueeehn.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qu--”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"msgoff"},
{"bg",file="zeveningsky_spring01",id=9,lv=9,speed=180000,time=500,sync=1,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"La muchacha que se hizo llamar Nagayama cayó sentada sobre el suelo en medio de\nla vía, y comenzó a llorar fuertemente.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Las amas de casa que venían regresando de compras y los empleados que venían de\nvuelta de sus trabajos se me quedaron viendo fijamente.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“D-Disculpa, creo que me sobrepasé con mis palabras. N-No llores, por favor.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_knd_000023",ch="knd"},
},
ja={
{
name={"Kana"},
"“Es que, es que, no creo poder recuperarme ahora que me dijiste eso. Ueeehn.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que no podrás recuperarte? Ah, en fin, vamos, párate.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000024",ch="knd"},
},
ja={
{
name={"Kana"},
"“No puedo paraaarme.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no eres ninguna niña.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000025",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Ueeehn! ¡Qué malo eres! De verdad no puedo paraaarme.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, lo siento, lo siento. ¿Qué debería hacer entonces?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_knd_000026",ch="knd"},
},
ja={
{
name={"Kana"},
"“Cárgame.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cargarte?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_knd_000027",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí. Kana está muy triste ahora y no puede levantarse, así que cárgame.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿C-Cargarte?...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_szd_000424",ch="szd"},
},
ja={
{
name={"???"},
"“Entre primera y segunda clase, diría...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_knd_000028",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0013",head="kan_z1a",x=-345,lv=4,id=5,sync=0},
{"extrans",time=500},
{"fg",ch="雫",size="z1",mx=40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"bgm",file="bgm024"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0011",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000029",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Q-Quién eres?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000425",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Soy Shizuku Natsume.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0016",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000426",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me parece fantástico que puedas llorar sin usar colirio. Esa técnica es tan\nimpecable que no pareciera venir de una novata.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0015",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000427",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Nagayama-san, debes tener un orgullo realmente grande. Y gracias a ese inflado\norgullo, con solo imaginarte por un momento 'soy patética', puedes forzar las\nlágrimas afuera con facilidad. La gran mayoría de las actrices de primera\nclase dominan esa técnica.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0013",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000030",ch="knd"},
},
ja={
{
name={"Kana"},
"“T-Tú, será posible que... ¿Eres la actriz Kuzuka Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000428",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ese es otro de mis nombres.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0012",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000031",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ahora que lo pienso... Kuzuka Kusanagi comparte el mismo apellido. ¿Es que\nacaso eres familia de Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, Kuzuka Kusanagi es su nombre artístico. Su verdadero nombre es Shizuku\nNatsume.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000032",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ya veo, eso quiere decir que los dos solo son extraños.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tampoco somos extraños, la verdad...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0005",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000033",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y bien, ¿qué relación tienen entonces?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no sabría muy bien cómo responder a esa pregunta...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000034",ch="knd"},
},
ja={
{
name={"Kana"},
"“Es un tipo de relación tal que no puedes explicar, ¿es así?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000035",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Y bien? Kuzuka Kusanagi-san, a tu manera de ver, ¿por qué estoy entre primera\ny segunda clase?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0016",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0004",head="shz_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000429",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, respecto a eso. ¡Si una persona que hasta hace un momento estaba inundando\nsu cara en lágrimas comenzara a hablar con tanta calma como lo haces ahora,\nsería muy obvio que se trata de una actuación!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0011",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000036",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Mm!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0015",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000430",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pudiste haber mantenido tu rostro lloroso, pero aun así, en el instante en que\nme viste me lanzaste una mirada completamente hostil... Te faltó poner más\natención a tu actuación.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000037",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ya veo... En pocas palabras, me llevaste a una trampa...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000431",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Se podría decir que sí.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000038",ch="knd"},
},
ja={
{
name={"Kana"},
"“Mmm, nada que no podría esperarse de la mujer que ascendió en el mundo del arte\ny el entretenimiento en tan poco tiempo. Eres toda una experta engañando a\nlas personas, eh.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1d1000",face="d0016",head="shz_z1d",x=345,lv=4,id=6},
{"fgact",ch="雫",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000432",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ejem.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="香奈",act="うんうん",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000039",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Por qué pones esa cara de satisfacción?! ¡Estoy siendo irónica! ¡Acabo de\nlanzar un comentario irónico!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000433",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿De verdad? Eso es una pena.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000040",ch="knd"},
},
ja={
{
name={"Kana"},
"“Tch.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0008",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000041",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ehm...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Se vuelve hacia mí con una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="雫",mode=-1,lv=4,id=6},
{"fg",ch="香奈",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0008",head="kan_z1a",x2=-345,x=0,lv=4,id=5},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=0,lv=4,id=5},
{"fgact",ch="香奈",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000042",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ejejeje, lo siento por todo, ¿sí, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0002",head="kan_z1a",x=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0009",head="kan_z1a",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000043",ch="knd"},
},
ja={
{
name={"Kana"},
"“Parece que nuestro preciado reencuentro terminó de una forma un tanto rara\ngracias a la intrusión de 'alguien'.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Más bien me salvé gracias a Shizuku.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",x=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=0,lv=4,id=5},
{"fgact",ch="香奈",act="いいえ",lv=4,id=5},
},
vl02={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0002",head="kan_z1a",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000044",ch="knd"},
},
ja={
{
name={"Kana"},
"“Aunque, Kusanagi-kun... no, Naoya-kun. Siempre me has gustado mucho, así que\nestoy feliz de que hayamos podido reencontrarnos. Solo no olvides eso.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_szd_000434",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=0,lv=4,id=5},
{"fgact",ch="香奈",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000045",ch="knd"},
},
ja={
{
name={"Kana"},
"“Bien, espero que podamos vernos de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"se",file="se9004",id=1},
{"fg",ch="香奈",mx=-40,mode=-1,lv=4,id=5},
{"text"},
text={
ja={
{
"Al decir eso, Kana Nagayama se fue.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“M-Me salvé...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0008",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000435",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Esa muchacha es bastante dura de lidiar...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dura de lidiar?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0010",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000436",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Esa muchacha va en serio.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Va en serio? ¿En serio qué?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0011",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000437",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Cuando dice que gusta de ti.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que gusta de mí? No, no puede ser. Es otra más entre los idiotas que quedaron\ncautivados por lo que vieron en la tele, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0009",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000438",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Solo por si acaso, esa chica también pertenece a la misma industria que yo.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A la misma industria?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000439",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aunque, parece estar trabajando como idol indie. La he visto en los anuarios de\narte y entretenimiento.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Idol indie? ¿Pero qué rayos? ¿No es eso lo mismo a ser una idol\nautoproclamada?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0009",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000440",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Tal vez. Sin embargo, parece tener bastantes agallas. Podría llegar a resultar\nser muy tediosa de lidiar.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no sé si es una idol indie o no, pero no creo que nada tedioso ocurra,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="雫",size="z2",my=40,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a1000",face="a0005",head="shz_z2a",lv=5,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_szd_000441",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Shizuku me observa.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa?...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1000",face="a0017",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000442",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Veo que tanto padre como hijo son muy complacientes a la hora de observar a las\nmujeres...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Q-Qué rayos dices?!”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1000",face="a0015",head="shz_z2a",lv=5,id=6},
{"fgact",ch="雫",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000443",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Fuh, de igual forma, esa chica me llama la atención. Sea para bien o para mal,\nparece que es cierto lo de que le gustas...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual forma, ¿qué tanto se podrían complicar las cosas? Aun si esa mujer\ntiene sentimientos por mí, basta con que yo la ignore y ya.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1000",face="a0001",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000444",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Es todo así de simple?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y es que no lo es?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1000",face="a0009",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000445",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Esa muchacha, mencionó algo de ese accidente...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Igual, no debería conocer los detalles en concreto. Simplemente sufrí de un\naccidente y estuve hospitalizado, ya...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a1010",face="a0017",head="shz_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="びっくり",size=8,time=150,lv=5,id=6},
},
vl02={
{"fgact",ch="雫",act="びっくり",size=8,time=150,lv=5,id=6},
},
vl03={
{"fgact",ch="雫",act="びっくり",size=8,time=150,lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000446",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y POR ESO, si bajas la guardia las cosas podrían ponerse muy feas.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Shizuku insiste con un tono fuerte. No tengo manera de replicar ante lo que\ndice.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“U-Umuh...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"se",file="se9010",vol=50,id=1},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b1000",face="b0011",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000447",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y por otro lado, vi la TV.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La TV? ¿Qué viste?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0008",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000448",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“'Las huellas de los cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, la obra póstuma de Kenichiro Kusanagi... Te interesa también, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0011",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000449",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Me interesa.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0009",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000450",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Por ejemplo, el motivo de esa obra. ¿Estará inspirada en los cerezos\nmilenarios?...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, quién sabe. No hay forma de preguntarle ya estando muerto, pero al menos\nAkashi debió haber pensado lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0011",head="shz_z1b",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0010",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000451",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo... sí, supongo.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede con eso?”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0017",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000452",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Shizuku no sabe nada. Pero si volteas el nombre, las cosas cambian.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Eso significa que--”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0011",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000453",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“La chica con el nombre al revés se muere por ti, y está dispuesta a\nentregártelo todo. Aunque bueno, parece que la rechazaron...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué estás hablando? ¡En primer lugar, en ningún momento la he rechazado!”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000454_n",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“En fin, ella posee un poder de bastante valor. Me parece que lo sabes, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente, el poder de la sacerdotisa tragasueños es así... Y bien, ¿qué\nquiere decir entonces la sacerdotisa tragasueños al respecto?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0010",head="shz_z1b",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0008",head="shz_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000455",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“La imitación es solo imitación de no haber espíritu allí... Sin embargo, de\nhaber espíritu, entonces la imitación deja de ser imitación...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué significa eso?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000456",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Sabes por qué a los cerezos milenarios se les llaman así?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque están desde hace mil años sobre la cima de la colina de Yumihari, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0015",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000457",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No, los cerezos milenarios son aquellos cerezos que no florecen por mil años.\nEn un principio, la leyenda habla de como lo que era un bosque de cerezos\nseco floreció.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso está completamente fuera de lugar entonces. Los cerezos florecen sobre la\ncolina de Yumihari cada año.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0009",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0010",head="shz_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000458",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No, no está fuera de lugar. Hay una persona que le dio forma a aquello que no\nfloreció durante mil años.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0011",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000459",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hace mil años lo hizo una persona... y hace unos pocos años, lo hizo otra...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hace unos pocos años... lo hizo una persona?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0010",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000460",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Un genio dibujó los cerezos de la leyenda, y las convirtió en realidad.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera, no estarás tratando de hablar de Kenichiro Kusanagi y sugerir\nque 'Las huellas de los cerezos' tiene ese poder, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0008",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0011",head="shz_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000461",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No creo que 'Las huellas de los cerezos' tenga ese poder, en un principio. Sin\nembargo, sí tiene suficiente como para despertar de nuevo a aquellos cerezos\nmilenarios que fueron pintados hace unos años...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces, los cerezos milenarios que fueron pintados hace unos años son--”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0013",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000462",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"bgm",stop=1,time=500},
{"fg",mode=-2},
{"se",file="se0744s",id=1},
{"text"},
text={
ja={
{
"A mitad de mis palabras, Shizuku echó a correr.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"se",file="se3130",id=1},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001165",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Wah, oh.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Shizuku se lanza sobre Rin y la abraza.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0004",head="shz_z1a",x=-345,lv=4,id=5},
{"bgm",file="bgm031"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000463",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin, bienvenida de vuelta.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001166",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, pero ¿por qué bienvenida?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0003",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000464",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Hoy también vendrás a la casa Natsume?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001167",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Sí, si no es una molestia para todos me gustaría ir, pero ¿no les causa\nproblemas que vaya todos los días?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0004",head="shz_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000465",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No es ninguna molestia. Eres completamente bienvenida, Rin. Y me harás muy\nfeliz a mí también.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku anda igual de encariñada contigo como siempre, Rin.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001168",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, y es que Shizuku-chan es muy cariñosa.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cariñosa, eh...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Aunque esa supuestamente cariñosa Shizuku confrontó con bastante severidad a la\nmujer de hace un rato...",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Vienes hoy también a donde los Natsume?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001169",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si no es una molestia, me encantaría.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Bien, en fin, vayamos a comprar los ingredientes y vayamos a casa. Aún\ntengo muchas cosas que aprender en la cocina de ti, Rin. Y cuando terminemos,\nayúdame con los estudios.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001170",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, de ser así entonces me encantaría que me enseñes más acerca de pintura a mí\ntambién.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro, no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000466",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Muy bien, vayamos entonces.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"msgoff"},
{"bg",file="eveningsky_spring01",id=8,lv=8,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"bg",file="nightsky_spring",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"Después de comer, estudiamos los dos juntos.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Aunque, más que estudiar, en realidad me estuvo ayudando a estudiar...",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Y después, tal como lo prometí, procedí a darle unas lecciones en pintura a Rin\nhasta que llegara la hora en la que tuviera que regresar.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg009c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"ex",time=500,func="wait"},
{"se",id=1,file="se2580"},
{"msgoff"},
{"bg",file="bg009a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, entra.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001171",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="man_ked_001028",ch="ked"},
},
ja={
{
name={"???"},
"“ZZZ...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm? ¿Hay alguien allí?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="man_ked_001029",ch="ked"},
},
ja={
{
name={"???"},
"“Ya... no puedo comer más...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001172",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kei-kun...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Al abrir la puerta del almacén hecho atelier, vimos a Kei dormido sobre el\nlienzo.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Alrededor de Kei estaban dispersos un montón de borradores amasados tornados\ncompletamente negros.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001173",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La Exposición Moore está cerca.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001174",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿La Exposición Moore? ¿Esa exposición de arte famosa por ser la más grande del\nmundo?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, todos los años, los integrantes del club de arte de Yumihari aplican a esa\nexposición. El patrón usual es que aplican, fallan, para luego concentrarse\nen los exámenes de ingreso de la universidad.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001175",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kei-kun estaba elaborando la obra a presentar en esa exposición, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aunque es bien raro que esté tan indeciso en la estructura de la obra. Por\nlo general siempre hace un boceto rápido y se pone a pensar en la estructura\nmientras va coloreando...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001176",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así de serio va esta vez, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece. Hay incluso algunos días que se queda pintando hasta que amanece.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque no estaría mal que usara un poco de esa determinación en los estudios...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, vamos a despertarlo.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001177",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, espera un momento, por favor.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001178",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Dejemos las lecciones de hoy para otro día. No quiero interrumpir todo el\nesfuerzo que Kei-kun ha puesto hasta ahora.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay problema alguno con que pinten varias personas acá adentro, y además, si\nva a dormir es mejor mandarlo a su habitación, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0010",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001179",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Conociendo a Kei-kun, probablemente vuelva a pintar de nuevo al despertarlo.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, es posible, pero...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0011",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001180",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kei-kun está en un nivel muy distinto al mío, así que quisiera que se\nconcentrara solo.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, pero de ser así, no podré darte más lecciones hasta que termine la\nExposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0008",head="rin_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001181",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo... Ah, si es por eso, ¿qué tal si vamos a mi casa?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si solo trabajamos hasta los bocetos, podría ser. Pero no te recomendaría\ntrabajar con pintura en óleo en un apartamento normal. El olor es terrible, y\nlo es más aún recoger todo al final.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001182",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entiendo... Pero, si es hasta el boceto, entonces puedes enseñarme en mi casa,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Antes de ir con bocetos, en tu caso es importante desarrollar las básicas de\ndibujo y diseño, así que podemos hacer bastante en tu casa.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero hay problemas de por medio, ¿no? Eres una muchacha en plena edad, no\nestaría del todo bien que alguien como yo fuera al apartamento donde vives\nsola.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",size=10,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001183",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jeje, dices eso aun cuando no tienes ninguna intención de hacerme nada.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nadie sabe eso. A los hombres les explota el deseo sexual de repente en\ncualquier momento. Y recuerda nada más que según Kawachino, yo soy un\nacosador-senpai.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001184",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero no hay problema. Las paredes del apartamento donde vivo son delgadas, así\nque de gritar solo un poco el casero entraría rápidamente.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Eso quiere decir que estás completamente protegida contra cualquier\nposible crimen.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001185",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, así que no hay problema alguno con que me enseñes en mi casa.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien. Sigamos con las lecciones en tu casa entonces.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ya es tarde, así que otro día.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001186",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tienes razón. Sigamos cuando ambos tengamos tiempo.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tiempo, eh. Si es así entonces mañana ambos estamos libres del colegio, así que\npodría ser mañana, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0013",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001187",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, de verdad.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001188",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uwaah, eso me pone feliz. Bien, entonces mañana te esperaré con los\npreparativos de la comida listos.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes por qué preocuparte tanto por esos detalles. En fin, quedamos\nentonces para mañana.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001189",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"Rin sonrió alegremente.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Rin sonríe siempre de una manera muy alegre y radiante.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Esta sonrisa de ella siempre pone feliz a las personas alrededor.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Supongo que por eso que Shizuku se encariñó tanto con ella...",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"bg",file="bg001d",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
"Llevé a Rin hasta las afueras de la entrada de la casa, y al tratar de\nregresar, escucho una voz viniendo de la casa.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_001030",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Esto es grave! ¡Naoya!”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? Vas a causarle molestias a los vecinos gritando así.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
vo={
{"vo",file="man_ked_001031",ch="ked"},
},
ja={
{
name={"Kei"},
"“Eso no importa ahora, esto es grave. ¡Las noticias, ven a ver las noticias!”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Las noticias?”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"bg",file="black",path=":bg/"},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
vo={
{"vo",file="man_cst_000001",ch="cst"},
},
ja={
{
name={"Presentador de noticias"},
"“Respecto a la publicación póstuma de la obra del señor Kenichiro Kusanagi, la\nFarmaceútica Nakamura ha comentado...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1b0300",face="b0006",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001032_n",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Ves?! Parece que la Farmaceútica Nakamura tenía en su poder varias obras de\nKenichiro Kusanagi. Al parecer 'Cerezos recostados' era parte de una serie de\n7 obras, y han tenido las demás en su posesión todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ya veo...”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0016",head="kei_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0005",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001033",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Ya veo?! Naoya, son las obras de Kenichiro Kusanagi. ¡Las obras de tu padre!”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, pero ya abandoné el derecho a herencia. Así que sea lo que sea, no tiene\nnada que ver conmigo.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0009",head="kei_z1b",lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0006",head="kei_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001034",ch="ked"},
},
ja={
{
name={"Kei"},
"“P-Pero es la Farmaceútica Nakamura. Se trata de esa familia Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tienes razón. Aunque bueno, no hay nada de que preocuparse, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0006",head="kei_z1b",x2=0,x=-345,lv=4,id=9},
{"fg",ch="藍",size="z1",mx=40,mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000608",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vamos, déjalo así. La familia Nakamura no tiene nada que ver con nosotros.\nNosotros pertenecemos a la familia Natsume...”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0015",head="aix_z1e",x=345,lv=4,id=6},
{"fgact",ch="藍",act="うんうん",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000609",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y además, esas noticias las pasaron a primera hora de la mañana. Ya es\ndemasiado tarde como para venir a reaccionar ahora y armar un escándalo.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0007",head="kei_z1b",x=-345,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001035",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, has estado demasiado metido en tu obra... Vaya que has estado bien\nalejado de lo que pasa en el mundo exterior.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1b0300",face="b0004",head="kei_z1b",x=-345,lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001036",ch="ked"},
},
ja={
{
name={"Kei"},
"“P-Pero Naoya, tú tamb--”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, está bien, no vengas con reclamos ahora, ¿sí? Voy a dormirme ya.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0015",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000610",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tal como lo dice Naoya, vas a molestar a los vecinos, así que no te pongas a\npelear en medio de la noche. Ve y duérmete ya, no quiero que despilfarres la\nelectricidad.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0017",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000611",ch="aid"},
},
ja={
{
name={"Ai"},
"“La tarifa de la luz del atelier ha venido terriblemente alta últimamente...”",
{"rt2"},
},
},
},
linkback="block_00264",
