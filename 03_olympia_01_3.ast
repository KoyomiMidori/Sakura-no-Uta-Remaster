{"text"},
text={
vo={
{"vo",file="man_ked_001037",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que me apropiaré del baño por los momentos.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Kei no parecía estar totalmente convencido al respecto, pero sea lo que sea, ya\nese tema no tiene nada que ver con nosotros.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"En fin, después de eso, entré a bañarme, me cepillé, y me dormí.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
