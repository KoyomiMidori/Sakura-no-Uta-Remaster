astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="eveningsky_spring01",id=8,lv=8,rule=139,sync=1,vague=40,path=":cg/"},
{"ex",time=500,func="wait"},
{"bg",file="nightsky_summer",id=9,lv=9,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm010"},
{"se",id=1,file="se2225"},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002634",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Muchas gracias por venir.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"El último cliente paga la cuenta y se va.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Al ver que no habían más clientes, Toritani colocó el letrero de 'Cerrado'\nsobre la perilla de la puerta y cierra las cortinas de las ventanas.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Todos los empleados de medio tiempo se fueron ya. Por lo general todos se\nmarchan 30 minutos antes de cerrar la tienda.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Al cerrar la caja y acomodar el local para cerrar, Toritani me trae una pasta\nnapolitana recién preparada.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"se",file="se_koton",id=1},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002635",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Toma, esto es también en agradecimiento por haber reparado el aire\nacondicionado, así que come sin reservas. ¿O quizás hubieras preferido un\ngyuudon?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues un platillo como este luce más apegado a la imagen de un local de café.\nNo está mal.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Me como lentamente la caliente y humeante pasta napolitana. Está deliciosa.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"El café que vino de extra también tiene un aroma distinto. No es de las típicas\nmuestras de café de siempre. Toritani me está dando un lujo esta noche.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Más vale que le advierta después de que no tome el dinero para mi paga de su\npropio salario.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002636",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Disculpa por todo el escándalo. ¿Pudiste avanzar un poco con los estudios?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, los libros de texto que me recomendaste explican todo de manera muy fácil\nde entender. Me han ayudado bastante.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0003",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002637",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me alegro. Si llegas a encontrarte con alguna parte que no entiendas, te puedo\nprestar mis apuntes. No dudes en pedírmelos cuando los necesites.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, gracias.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, cierto. Se me había olvidado por completo con lo del asunto del aire\nacondicionado. A final de cuentas, ¿para qué fue que me mandaste en esa\nmisión?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002638",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh, eso. Te asigné esa misión para que las chicas de los otros colegios no te\npersiguieran.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Para que no me persiguieran? ¿De qué rayos estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002639",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Creo que ya te lo dije la vez pasada, pero eres ahora una celebridad. Volvieron\na transmitir otro nuevo programa especial acerca de ti en la TV, así que\nahora son más.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me estás diciendo que escalé paredes y me abrí camino por senderos no\nrecorridos, cuidando de no terminar incurriendo en ningún crimen, solo para\nevitar cruzarme con un grupo de mujeres que ni siquiera sé si existen o\nno?...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0005",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002640",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Que si existen o no?... Muchacho, realmente existen. Y si no me crees, sal\nmañana por el portón frontal después de clases.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Todo por evitarme un grupo de personas que no sé si realmente existen o no?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002641",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te estoy diciendo que sí existen.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002642",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dejando eso de lado, Kusanagi, tengo algo que preguntarte. ¿Puedo?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué? ¿Pantis?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002643",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Tengo que admitir que me irrita un poco que lo adivines tan rápidamente...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002644",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es solo una simple y duda que tengo respecto a eso. Kusanagi, ¿simplemente te\nbasta con ver pantis y ya?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De ninguna forma. ¿Qué me crees que soy?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0017",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002645",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Un amante de las pantis?...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes un enorme malentendido respecto a mí. Por supuesto que me gustan las\npantis, pero no es que me gustan todas a diestra y siniestra.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi amor por las pantis no es equitativo y uniforme, y por lo tanto mi\nobsesión por ellas está en un terreno totalmente distinto al de los\nfetichismos.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0012",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002646",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No entiendo muy bien aún, pero, por ejemplo, ¿no sirve de nada con que te\nmuestre unas pantis recién lavadas?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me vas a mostrar tus pantis recién lavadas?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0018",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0005",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002647",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No te las mostraré. Contesta mi pregunta.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, veamos... Creo que las pantis recién lavadas no despiertan mucho\nmi interés. Aunque me enciendes el moe viéndote hablar de tus pantis\nrecién lavadas con tanta pena.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008h",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002648",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿D-De qué estás hablando?...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las pantis no son más que materia.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0005h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002649",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No son un objeto?...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no realmente. Para ser francos, las pantis...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0017h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002650",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¿Para ser francos, las pantis?...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0910",face="a0017h",head="mak_z2a",lv=5,id=9},
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",id=1,file="se2362"},
{"ex",time=200,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Son pantis solo desde el momento en que son usadas!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La delgada tela de las prendas femeninas se ajusta al cuerpo curvado de las\nmujeres, y se impregna con su olor... Son esos factores lo que hacen de las\npantis, pantis.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y sobre todo eso, la chica que use esas pantis debe mostrar vergüenza, o de\nlo contrario nada de lo anterior serviría de algo.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En pocas palabras, lo importante y primordial es la vergüenza. ¿Te quedó claro?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0015",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002651",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Creo que acabo de aprender algo realmente absurdo y ridículo...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0012",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002652",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y bien, supongamos el caso en el cual no lleve pantis. ¿Qué sucedería?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué dices?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002653",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya te dije, solo suponiendo... ¿Que pasaría, si yo no llevara pantis?...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002654",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No podrías ver mis pantis... ¿Qué sucedería entonces?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani... eso sería un problema. Estás hablando de algo en una dimensión\ntotalmente distinta.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002655",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sí? Puedes tomarlo como un ejercicio mental, si quieres.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002656",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No tienes forma de saber qué sucede debajo de mi falda, si llevo pantis o\nno, a menos que la levante, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso son las pantis de Schrödinger?...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Al ver de reojo su expresión, me doy cuenta que Toritani mantiene la calma en\nsu rostro. Toritani no es capaz de hacer una actuación tan perfecta.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás hablando muy tranquilamente del tema, lo cual significa que las llevas\npuestas.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0017",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002657",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Que no es obvio?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002658",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero podría suceder que no. No tienes forma de saber hasta que me levante la\nfalda.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002659",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quizás esto esté un poco alejado de la definición rigurosa del principio de\nSchrödinger, pero supongo que sirve como ejemplo para el entendimiento\ngeneral.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, supongo.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0011",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0005",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002660",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Bien, suponiendo, solo suponiendo que...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002661",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Que me quite mis pantis y te las dé...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Lo harás?!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0007",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002662",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡¡N-No!!!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0005",head="mak_z2d",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0011",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002663",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jamás, nunca, lo haría. Pe, pero si fuera así, ¿qué harías?... ¡E-Es solo un\nexperimento mental!”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eso no es ningún experimento mental!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0005",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002664",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No me importa! ¡Si puedes contestar la pregunta entonces hazlo!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... si llegarás a quitarte las pantis y dármelas...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0008",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002665",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Entonces?...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Algo se podría salir de control.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0009",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002666",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De qué manera... podrían salirse las cosas de control?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es algo que pueda decir.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0005",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002667",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué es?... Me causa curiosidad...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay forma de saberlo exactamente. A menos que lo hagamos de verdad.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0017",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002668",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Créeme que no lo haré.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé... Pero te causa curiosidad, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Apuesto a que te mueres tanto por saber que solo podrás dormir de noche ahora.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0018",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002669",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me basta y me sobra con dormir en la noche.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002670",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En fin, ya entendí en buena parte la manera en que ves las pantis.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002671",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Se me hacía totalmente incomprensible, así que estoy un tanto más aliviada\nahora. Gracias.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente eres bien dedicada para todo, eh...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0012",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002672",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Así te parece? ¿No es eso lo normal?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0017",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002673",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sabes? Se me llegó a ocurrir que quizás, con la capacidad imaginativa que\ntienes, podrías dibujarme desnuda aun teniendo la ropa puesta. ¿No crees?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me estás pidiendo, en pocas palabras, que vea a través de tu ropa?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0026",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002674",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso mismo.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es ridículo.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0012",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002675",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Te parece?...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Tienes que estar tomándome el pelo! ¡En primer lugar, si lo hacemos de esa\nforma no te dará vergüenza alguna!”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0013",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002676",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Lo único que quieres es verme avergonzada?!”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡Se podría decir que sí!!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0005",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002677",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡H-Hace poco me dijiste que simplemente querías ver mis pantis!!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Recuerdo lo que hablamos frente al mural.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Quiero ver tus pantis, eso es verdad! ¡¡Y también quiero que te las quites\ny me las des!! ¡¡¡Y me muero por verte tu cara bañada en vergüenza!!!”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0010h",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002678",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡-----!!”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0005h",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0011h",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002679",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“N-No digas esa clase de cosas con tanto empeño... Realmente eres un\ndesvergonzado... D-Dios... ¿Es que acaso se volvió a dañar el aire\nacondicionado?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Toritani se da aire rápidamente con la mano para refrescar su sonrojada cara.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002680",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Déjame decirte que una vez participé en una sesión de pintura al desnudo...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Lo has hecho?!”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0009",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002681",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“S-Sí, aunque fue cuando era aún una niña...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡¡¿¿Cuando eras una niña??!!!”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Después de mostrar una cara de suspicacia, Toritani se da cuenta súbitamente\ndel otro significado oculto tras sus palabras.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0013",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0005",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002682",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡N-No es lo que piensas! ¡Era yo la que estaba dibujando a la modelo!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, vaya... me asustaste por un momento...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0015",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002683",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuiste tú quien me asustó a mí...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002684",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, olvidemos por un momento lo de si dibujar un desnudo es una labor\nmecánica o no. Hace un tiempo mencionaste que al momento de dibujar a una\nmodelo desnuda te ocupabas tanto que se te hacía imposible sentir algo al\nverlas.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues ciertamente es así.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0011",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002685",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entonces...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002686",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Q-Quiero decir...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002687",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Supongamos... solo suponiendo... que yo modelara desnuda...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera un momento.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0017",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002688",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso significa que realmente te desnudarás esta vez?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0010",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0005",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002689",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡N-No seas tan explícito al decirlo! ¡Realmente no tienes vergüenza ni pena\nalguna! ¿No te lo mencioné ya cuando estuvimos frente al cuadro de 'Olympia'?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí... pero...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"msgoff"},
{"bg",file="bg002c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Lo que ocurrió aquella vez frente a 'Olympia' me ha dejado un pequeño gusto\namargo dentro de mí.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"La propuesta de Toritani iba en serio. Y por eso es que debo darle respuesta a\nesa determinación suya.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Supongo que este es el momento para hacerlo.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002690",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Disculpa por lo de aquella vez. He estado reflexionando acerca de lo que\nhice.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Vaya.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002691",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fui tan severa al momento de ofrecerte desnudarme para que pintaras, y... Me\npareció que era injusto poner las cosas de manera que no pudieras rechazar la\noferta, así que luego me retracté, pero...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"V-Vaya.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002692",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ehm, pensé que si lo proponía de una manera más casual y ligera... te darían\nganas, de hacerlo...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"... Parece que entre todo esto, Toritani es la que terminó cediendo.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Probablemente Toritani llegó a la conclusión de que yo no sabría cómo\nreaccionar ante una propuesta demasiado seria, así que seguramente por eso\nestá proponiéndolo de nuevo, pero con más ligereza ahora.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Aunque...",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"¿Ganas de hacerlo? Por supuesto que las tengo, solo con escuchar eso ahora. En\nun instante mi cabeza se llenó de ideas lascivas.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"¿Es que acaso Toritani entenderá bien lo que está diciendo?... Sí, ella sabe en\nlo que se está metiendo.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Al dibujar un desnudo no hay realmente tiempo de excitarse con el modelo de\ndibujo, tal como Toritani lo dice. La labor te mantiene ocupado durante todo\nel proceso, así que no hay realmente tiempo ni atención como para ver al\nmodelo con esos ojos.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"No sería descabellado decir que hacer un dibujo al desnudo es un combate uno a\nuno entre el pintor y el modelo.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Sin embargo, eso ocurre en el caso de que la modelo sea una profesional, o una\nsimple desconocida.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"msgoff"},
{"bg",file="zbg031a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Sin querer, me quedo viendo fijamente el cuerpo de Toritani.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0017",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002693",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué pasa?... N-No te me quedes viendo fijamente... Demonio depravado...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes buen cuerpo, ¿cómo no podría hacerlo? Tú también lo sabes, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0010",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002694",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo sé, pero, ah, ¡r-rayos!...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0011",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002695",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por más que trate de agradecerte de alguna manera, nunca aceptas mis muestras\nde gratitud...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002696",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Además, lo de mostrarte mis pantis frente al mural fue para compensarte por\nhaberte golpeado...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0010",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002697",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si hay algo más que pueda hacer para pagarte de vuelta, preferiría esa otra\nalternativa, pero... por ahora, no sé qué clase de cosas quisieras pedirme...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0009",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002698",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero parece que has querido ver mis pantis...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0011",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002699",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mis pantis, y además...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002700",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... E-Está también, lo de... modelar desnuda...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002701",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y por eso, yo también quisiera decidir lo que haré de una buena vez, y...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0005",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0008",head="mak_z2d",lv=5,id=9},
},
vl02={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0011",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002702",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡E-En fin! Sé muy bien lo preciado que es para ti la pintura, y sé que aun ante\nuna modelo desnuda, no serías capaz de, esto...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0009",head="mak_z2d",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0018",head="mak_z2d",lv=5,id=9},
},
vl02={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0011",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002703",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De sentir algún deseo, sexual, A-A, así que... si, es, así... entonces, digo...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0010",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002704",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A-Aunque todavía no sé si realmente lo hare en serio o no, pero...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0010",head="mak_z2d",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso está fuera de lugar.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0008",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002705",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eh--”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi objetivo es otro.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0009",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002706",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Objetivo?...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que yo busco no es dibujarte desnuda, sino verte en una pose vergonzosa.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y si el objetivo es distinto, la premisa también lo es.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0018",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002707",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡V-Vienes a decir eso ahora, c-cuando trato de literalmente poner mi piel por\nti!...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"bgm",stop=1,time=300},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0910",face="a0018",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya te lo he dicho, basta ya con eso.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002708",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eh.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"bgm",file="bgm029"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes por qué empeñarte tanto en hacer eso.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002709",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002710",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Yo solo...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes por qué sacrificarte solo por mí, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002711",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002712",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No... no se trata de eso, en lo absoluto... No estás entendiendo nada...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Toritani se muerde ligeramente los labios, y baja la cabeza.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fgact",ch="真琴",act="いいえ",size=2,lv=4,id=9},
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Sus finos dedos agarran ligeramente su falda.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002713",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es frustrante...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002714",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En ningún momento he podido olvidar cómo te veías en aquel momento...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="zev_com_a34_01",x=440,y=540,path=":ev/ev_com_a34/",set="ev_com_a34",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002715",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El Kusanagi que vi cuando estábamos pintando 'Las huellas de los cerezos'...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002716",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te divertías tanto...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002717",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Era tanta tu emoción...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002718",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y... yo también me divertí bastante...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002719",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo... solo por eso es que quisiera ver de nuevo a ese Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"msgoff"},
{"se",file="se9012",id=1},
{"fg",ch="真琴",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="真琴",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Me paro de la silla y me le acerco.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Toritani levantó su cara. Me reclama con una mirada grave.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0007",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0008",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002720",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quiero verte de nuevo divirtiéndote creando algo, como aquella vez. Excitado,\nfeliz... ¡Solo eso!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Toritani se aferra a mí.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0009",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002721",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Es que acaso no soy suficiente para ti?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0008",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002722",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Es que acaso no soy lo suficientemente emocionante para ti?!”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0019",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002723",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Es que acaso no eres capaz de divertirte conmigo?!”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡E-Espera un segundo...!”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Agarro los hombros de Toritani, quien había tomado el cuello de mi camisa\nreclamándome con un rostro afligido y desesperado, y la separo de mí.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0009",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002724",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¡Mm!”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Toritani sale de su frenesí y se da cuenta de lo que estuvo diciendo. Su cara,\nsonrojada por un instante, se torna inmediatamente pálida.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"se",file="se9010",id=1},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0900",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani retrocede solo un paso, y su delgado cuerpo se aleja de mis manos.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002725",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“L-Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Toritani, confusa y sin saber qué hacer, estaba ahora de muy bajos ánimos.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te preocupes. Sé qué estabas tratando de decirme... No hubo ningún\nmalentendido.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_com_a34_01",path=":ev/ev_com_a34/",set="ev_com_a34",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Aquel día. Cuando estuve pintando 'Las huellas de los cerezos'.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Estaba muy emocionado. Y sobre todo, me estaba divirtiendo.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Aquel día disfrutamos, en medio de ese bullicio festivo, el placer de la\ncreación como nunca antes lo habíamos hecho.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Toritani está hablando de esa 'emoción' y 'diversión'. Eso lo entiendo\nperfectamente.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0011",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002726",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero... así que...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Sin embargo, la manera en que Toritani lo dijo se presta a malentendidos. Eso\nes, también, un hecho.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Toritani.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fgact",ch="真琴",act="びっくり",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002727",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Uh.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Toritani, quien estaba abrazando su cuerpo con uno de sus brazos mientras\napartaba su vista, da un pequeño salto, temblando.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Relájate un poco. Estás siendo demasiado severa contigo misma.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002728",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Quieres un café? Te lo prepararé. Voy a tomar prestado los instrumentos de la\ncocina, ¿no hay problema?",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002729",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, está bien...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",mode=-2},
{"bg",speed=240000,file="zbg031a",path=":bg/",x2=0,y2=0,x=-960,y=0,ax=1920,ay=1126,bx=-960,by=-586},
{"text"},
text={
ja={
{
"Al entrar a la barra busco los recipientes de muestras de café que Toritani\nsiempre me sirve. Tenían etiquetas pegadas, así que pude encontrarlos\nfácilmente.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002730",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, deja de andar parada ahí tan pensante y siéntate acá. Aunque bueno, no\nsoy quien para decir esto.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002731",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=500,y=40,file="zbg031a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",file="zchair1",id=3,lv=3,zoom=70,x=310,y=10,path=":cg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"se",file="se3214",vol=30,id=1},
{"text"},
text={
ja={
{
"Toritani se sienta lentamente en uno de los asientos frente a la barra.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Molí los granos en el molinillo, puse a hervir el agua, y ahora pongo el café a\nhervirse.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Toritani me observa ensimismada mientras preparo el café.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0027",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002732",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Realmente sabes hacer de todo, Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tanto, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"se",file="se9025",vol=30,id=1},
{"text"},
text={
ja={
{
"Una vez se termina de colar suficiente café para una persona, lo sirvo en una\ntaza y se la doy a Toritani.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"se",stop=1,time=500,id=1},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0028",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002733",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Está rico.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Al tomar un sorbo de café, una expresión de alivio se cierne en el rostro de\nToritani.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Toritani va tomando el café lenta, lentamente. Sin decir nada, me sirvo ahora\nuna taza para mí.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Al terminar de beberse la taza de café, Toritani recuperó por completo la\ncalma.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002734",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Parece que volví a meter la pata de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. Creo que te lo dije ya hace poco, pero me pareces linda\ncuando te pones mansa. Te me haces moe.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0017",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002735",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De nuevo con eso...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto no se lo digo a cualquiera.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Toritani me ve de debajo con su mirada alzada inquisitivamente.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Estando yo parado y ella sentada, su expresión siguiéndome con los ojos un\ntanto alzados se me hizo muy tierna.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0009",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002736",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, de verdad.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002737",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"La poca tensión que quedaba sobre los hombros de Toritani se va aligerando.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0028",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002738",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias, por todo.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay de qué. No es ninguna molestia.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fgact",ch="真琴",act="うなづく",lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002739",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque últimamente te veo siempre muy mansa o muy alterada, así que no tienen\ntanto valor.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El poder destructivo de ese lado tuyo está en que no se muestra casi. O como le\nllaman por ahí, la 'brecha moe'.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0016",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"fgact",ch="真琴",act="うなづく",size=6,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002740",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Toritani sonríe con un rostro un tanto apenado.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Al bajar un poco la mirada, observa su taza ahora vacía, y luego abre\nligeramente su boca.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0027",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002741",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sabes...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002742",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si estoy así de desesperada ahora, no es por ti, sino por mí... Es por mí que\nquiero verte de nuevo así...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0011",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002743",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esto solo es un capricho. Por capricho terminé desesperándome y pidiéndote\nhacer eso y... terminé metiendo la pata.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002744",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso es que esto no es ningún sacrificio por nadie, y tampoco tienes que\npreocuparte por mí. Simplemente piensa que soy una muchacha ridícula haciendo\nidioteces y ya.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso es que yo siempre soy caprichoso. Haciendo lo que me da la gana.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0028",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002745",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... Así es. Tienes razón. Siempre... haces lo que quieres, sin nada que te\nrestrinja.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oye.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002746",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hacemos la sesión de dibujo al desnudo mañana?”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0012",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002747",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0004",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"fgact",ch="真琴",act="うなづく",size=6,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002748",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jeje.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Con una cara totalmente despreocupada ahora, Toritani se ríe, visiblemente\nentretenida.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"Y entonces, sonrió frente a mí, imponente y con una expresión algo retadora.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0016",head="mak_z2d",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002749",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si no tienes problema con que lleve puesto mi uniforme colegial, entonces no me\nimportaría.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Toritani está tratando de comportarse como la chica a la que aspira\nconvertirse. Y por eso, es que decidí tomarle la palabra y acceder.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué dices--?”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0028",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002750",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Con ese poder imaginativo que tienes no habrá problema alguno, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no me importaría, pero...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002751",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No hay problema entonces, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En cierta forma, me parece que hacerlo de esa forma será más vergonzoso.\n¿Realmente no te importa?”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0900",face="d0016",head="mak_z2d",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002752",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Para nada.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"bg",file="reco",id=9,lv=9,path=":sys/"},
{"text"},
text={
ja={
{
"Toritani se río, sin tratar de contestarme realmente.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"Bien, no importa.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"Si es por eso, entonces vamos a probarle en su propia cara que resultará mucho,\nmucho más vergonzoso que la dibuje con la ropa puesta.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"cgdel",id=-1},
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_picapica_06_1"},
{"text"},
linkback="block_00258",
},
label = {
top={block="block_00000",label=1},
},
}
