{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000608",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Podrías levantarte ya, Akashi-senpai?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="man_wtd_000102",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Hmmm.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="man_wtd_000103",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ah~, ya no puedo comer más~”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que anda teniendo un sueño de lo más tranquilo...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0010",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000609",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Qué palabras tan comunes está usando mientras duerme, debe estar teniendo un\nsueño bastante pegajoso...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="man_wtd_000104",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ajajajaja, nooo. Mi ○○○○○ no cabe en esa boquita tan pequeña~”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0210",face="a0005",head="yum_z1a",lv=4,id=9},
{"fgact",ch="優美",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000093",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Funnuh!”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"se",id=1,file="se2192"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000105",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Guhaa!”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0017",head="yum_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_000094",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No permitiré esa clase de vulgaridades frente a Rina...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_com_a26_01base",id=1,lv=1,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_yumi",id=2,lv=2,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_kei",id=5,lv=5,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_makoto",id=6,lv=6,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_naoya",id=7,lv=7,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"extrans",time=500},
{"bg",file="ev_com_a26_icon_akashi06",id=8,lv=8,x=-10,y=-10,time=100,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",x2=0,y2=0},
{"text"},
text={
vo={
{"vo",file="man_wtd_000106",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"evset",file="ev_com_a26_01",set="ev_com_a26",path=":ev/ev_com_a26/"},
{"cgdel",id=8,lv=8,time=400},
{"bg",file="ev_com_a26_icon_akashi01",id=3,lv=3,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_akashi02",id=4,lv=4,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"extrans",time=300},
{"cgact",file=":cg/cg_ev_com_a26/ev_com_a26_icon_akashi01",id=3,lv=3,act="浮遊",loop=-1,size=6,time=300},
{"cgact",file=":cg/cg_ev_com_a26/ev_com_a26_icon_akashi02",id=4,lv=4,act="いいえ",loop=-1,size=3,time=1500},
{"text"},
text={
vo={
{"vo",file="man_wtd_000107",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Qué rayos es esto? ¿Qué sucede? ¿Por qué~, por qué estoy ahora amarrado de\nrepente cuando hace un momento estaba rodeado por chicas hermosas?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"cgdel",id=3,lv=3,time=400},
{"cgdel",id=4,lv=4,time=400},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente estaba teniendo esa clase de sueño. Aun en esta situación...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000610",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien~, Akashi-senpai~ ¿Por qué será que estás amarrado, eh?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="man_wtd_000108",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Eh? ¡Ah, sí! ¡P-Porque soy increíblemente bello! ¡¿Estoy en lo correcto?!”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000611",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué rayos estás diciendo?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"bg",file="ev_com_a26_icon_akashi01",id=3,lv=3,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_akashi02",id=4,lv=4,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"extrans",time=300},
{"cgact",file=":cg/cg_ev_com_a26/ev_com_a26_icon_akashi01",id=3,lv=3,act="浮遊",loop=-1,size=12,time=150},
{"cgact",file=":cg/cg_ev_com_a26/ev_com_a26_icon_akashi02",id=4,lv=4,act="いいえ",loop=-1,size=6,time=225},
{"text"},
text={
vo={
{"vo",file="man_wtd_000109",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡EL LÍBIDOOO DE LAS CIENTOS DE MILLONES DE MUJERES DE TODO EL PAÍS QUE QUIEREN\nVER CÓMO SOY AZOTADO Y TORTURADOOOO ME COLOCÓ EN ESTE ESTADOOOO!”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"evset",file="ev_com_a26_02",set="ev_com_a26",path=":ev/ev_com_a26/"},
{"se",id=1,file="se2192"},
{"cgdel",id=1,lv=1,time=400},
{"cgdel",id=2,lv=2,time=400},
{"cgdel",id=3,lv=3,time=400},
{"cgdel",id=4,lv=4,time=400},
{"bg",file="ev_com_a26_02base",id=1,lv=1,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"extrans",time=200},
{"bg",file="ev_com_a26_icon_akashi03",id=3,lv=3,x=-10,y=10,time=100,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",x2=0,y2=0},
{"bg",file="ev_com_a26_icon_akashi04",id=4,lv=4,x=10,y=10,time=100,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",x2=0,y2=0},
{"text"},
text={
vo={
{"vo",file="fem_yum_000095",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Touh!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"cgdel",id=1,lv=1,time=400},
{"cgdel",id=3,lv=3,time=400},
{"cgdel",id=4,lv=4,time=400},
{"bg",file="ev_com_a26_01base",id=1,lv=1,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_yumi",id=2,lv=2,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"extrans",time=300},
{"text"},
text={
vo={
{"vo",file="man_wtd_000110",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eso dolió.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es sorprendente que puedas lanzar chistes aun en esta situación.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="man_wtd_000111",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Oh, pero si es Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, soy Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="man_wtd_000112",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No sé muy bien por qué, pero mi cuerpo y alma están atrapados bajo la condición\nde mi propio ser.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En cierta forma, me sorprende que puedas elaborar esa frase tan difícil...\nAunque bueno, supongo que la estarás usando sin saber qué significa.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="man_wtd_000113",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Claro que sé qué significa. ¡Significa que es verdaderamente lamentable que\nhaya perdido mi libertad! ¡Dejando eso de lado, libérame ya! ¡Esta es una\norden!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No quiero.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"bg",file="ev_com_a26_icon_akashi01",id=3,lv=3,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_akashi02",id=4,lv=4,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"extrans",time=300},
{"cgact",file=":cg/cg_ev_com_a26/ev_com_a26_icon_akashi01",id=3,lv=3,act="浮遊",loop=-1,size=12,time=150},
{"cgact",file=":cg/cg_ev_com_a26/ev_com_a26_icon_akashi02",id=4,lv=4,act="いいえ",loop=-1,size=6,time=225},
{"text"},
text={
vo={
{"vo",file="man_wtd_000114",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Nooo~! ¡Desamarra esto, por favooorrr! ¡Preocúpate pronto por mi libertad, por\nfavoooor, duele bastanteee, dueleeee, muchooo, duele muchooo, libérame\nyaaaaaaaaaa!”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienes ni pena ni pudor alguno, eh...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_rna_000061",ch="rna"},
},
ja={
{
name={"Rina"},
"“V-Veo que es una persona bastante asombrosa.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"cgdel",id=3,lv=3,time=400},
{"cgdel",id=4,lv=4,time=400},
{"text"},
text={
vo={
{"vo",file="man_wtd_000115",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Oh~, ¿pero qué es esto? Pero si es la muchachita que se me estaba acercando\nhace un rato con un traje de baño bastante pegadito y ecchi~. Vaya, pero no\nsolo sale en mis sueños sino también en la realidad, nya~”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"se",id=1,file="se2192"},
{"cgdel",id=1,lv=1,time=400},
{"cgdel",id=2,lv=2,time=400},
{"bg",file="ev_com_a26_02base",id=1,lv=1,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"extrans",time=200},
{"bg",file="ev_com_a26_icon_akashi03",id=3,lv=3,x=-10,y=10,time=100,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",x2=0,y2=0},
{"bg",file="ev_com_a26_icon_akashi04",id=4,lv=4,x=10,y=10,time=100,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",x2=0,y2=0},
{"text"},
text={
vo={
{"vo",file="fem_yum_000095",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Touh!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"cgdel",id=-1},
{"bg",file="ev_com_a26_03",sync=0,face=1,time=400,path=":ev/ev_com_a26/",set="ev_com_a26"},
{"se",id=1,file="se0001_z"},
{"text"},
delay={
vl01={
