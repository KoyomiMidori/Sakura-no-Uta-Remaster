},
vl03={
{"bg",file="ev_com_a26_02",sync=0,face=1,time=400,path=":ev/ev_com_a26/",set="ev_com_a26"},
},
},
text={
vo={
{"vo",file="fem_yum_000096",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Tei! ¡Jaa! ¡Touh! Y, ¡Toyaaaa!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="man_wtd_000116",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Gyan! ¡Gyan! ¡Gyan! ¡Duele! ¡Eso duele!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
delay={
vl01={
{"bg",file="ev_com_a26_03",sync=0,face=1,time=400,path=":ev/ev_com_a26/",set="ev_com_a26"},
{"se",id=1,file="se2192"},
},
},
text={
vo={
{"vo",file="fem_yum_000097",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No pararé este ataque mientras puedas seguir sintiendo dolor! ¡Jaa!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"bg",file="black",path=":bg/"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Akashi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0009",head="kei_z2a",lv=5,id=9},
{"fgact",ch="圭",act="おじぎ",lv=5,id=9},
{"fgact",ch="圭",act="icon",lv=5,id=9,icon="icon04z2",x=65,y=-525},
{"text"},
text={
vo={
{"vo",file="man_ked_000719",ch="ked"},
},
ja={
{
name={"Kei"},
"“Qué escenario tan brutal y cruel. Está echando sangre en todas las\ndirecciones...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Akashi... Cada vez me da más pena.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Sin embargo, hay que ver que Kawachino no tiene piedad alguna en lo que\nconcierne a Hikawa, eh.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_com_a26_01base",id=1,lv=1,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_yumi",id=2,lv=2,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_kei",id=5,lv=5,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_makoto",id=6,lv=6,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_naoya",id=7,lv=7,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya mala suerte que tienes, Akashi. Que haya entrado ahora esta nueva tan\nviolenta...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_wtd_000118",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Eh, Kusanagi, esa no me parecen las palabras que diría alguien que está ahora\nobservando mientra come senbei...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres un poco de senbei?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"bg",file="ev_com_a26_icon_akashi01",id=3,lv=3,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_akashi02",id=4,lv=4,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"extrans",time=300},
{"cgact",file=":cg/cg_ev_com_a26/ev_com_a26_icon_akashi01",id=3,lv=3,act="浮遊",loop=-1,size=6,time=300},
{"cgact",file=":cg/cg_ev_com_a26/ev_com_a26_icon_akashi02",id=4,lv=4,act="いいえ",loop=-1,size=3,time=1500},
{"text"},
text={
vo={
{"vo",file="man_wtd_000119",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Sí quiero, sí quiero!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"cgdel",id=3,lv=3,time=400},
{"cgdel",id=4,lv=4,time=400},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000612",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡De ninguna manera puede comer!! ¡Dale después de que termine el\ninterrogatorio!”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Después de que termine?... ¿Te parece que esto conserva aún su forma original\ncomo ser vivo? ¿Y, se supone que esto era un interrogatorio?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_wtd_000120",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Qué quieres decir con interrogatorio?! ¡Kusanagi! ¡Tú sabías algo, ¿no?!”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sabía.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"bg",file="ev_com_a26_icon_akashi01",id=3,lv=3,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_akashi02",id=4,lv=4,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"extrans",time=300},
{"cgact",file=":cg/cg_ev_com_a26/ev_com_a26_icon_akashi01",id=3,lv=3,act="浮遊",loop=-1,size=12,time=150},
{"cgact",file=":cg/cg_ev_com_a26/ev_com_a26_icon_akashi02",id=4,lv=4,act="いいえ",loop=-1,size=6,time=225},
{"text"},
text={
vo={
{"vo",file="man_wtd_000121",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Quééé? Maldito, ¿sabías que Toritani iba a medio matarme? ¡Me engañaste, eh,\nKusanagi! ¡Los únicos que pueden traicionarme son Lü Bu, Gongsun Yuan y Liu\nBei!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"cgdel",id=3,lv=3,time=400},
{"cgdel",id=4,lv=4,time=400},
{"text"},
text={
ja={
{
"¿Quién demonios se supone que eres tú?... ¿Y desde qué punto de vista histórico\nse supone que vas a ser traicionado...?",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000613",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya, senpai. Estuviste haciendo 'eso', así que debiste por lo menos haber\nsabido lo que te pasaría si yo llegara a enterarme, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="man_wtd_000122",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Mm~? ¿¿Hacer 'eso'??”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="man_wtd_000123",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Te refieres a ese artístico ventilador gigante para levantar faldas que\nconstruí en la sala de arte, nya? ¿O te refieres a esa obra de arte con esa\ncaliente estufa que le daría ganas a cualquiera de desnudarse, nya~?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"quake",mode="mw"},
{"se",id=1,file="se2869"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000614",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Estuviste haciendo eso también?!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"mwact",act="いいえ"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000124",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Kusanagiii, ayúdameeee... No sé por qué, pero desde hace un buen rato he estado\nsiendo golpeado únicamente por chicas.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad que no sé muy bien, ¿pero no es todo culpa tuya?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="man_ked_000720",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Y bien, qué fue lo que hizo Akashi-senpai?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000615",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Esto!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="man_ked_000721",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uwaah, qué es esto...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una factura por 600 pares de uwabaki?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000616",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Así es! ¡Solo con esto se fueron 60000 yenes!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="man_wtd_000125",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Aun así, logré que me bajaran bastante el precio. Originalmente cada par\ncostaba 1000 yenes.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te dieron demasiado descuento. Cada par sale entonces en 100 yenes.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_rna_000062",ch="rna"},
},
ja={
{
name={"Rina"},
"“Más que descuento, seguramente eran productos defectuosos o para desechar... A\njuzgar por este precio.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para qué demonios compraste todo esto...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="man_wtd_000126",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“T-Todo esto es para ganar dinero~”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Para ganar dinero? No hay manera alguna de ganar dinero con uwabakis.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="man_wtd_000127",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“En realidad sí. ¿No sabes que hay muchas personas en la sociedad con gustos\nalgo desviados que le encantan esta clase de cosas? ¡Y para buena suerte,\neste año hay bastantes chicas acá!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_wtd_000128",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Si nuestras hermosas chicas del club de arte se los ponen por unos días verán!\n¡Ah, verán como enigmáticamente los uwabaki que cuestan 100 yenes ahora se\nvenden por 10000 yenes!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo único que estás tratando de hacer es comercializar prendas usadas por\nmujeres a pervertidos...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000617",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Je. ¿Planeabas hacer que lleváramos esos uwabaki para que tomaran nuestro olor\ny luego venderlos?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="man_wtd_000129",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Una fortuna fácil!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000618",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero qué ridiculeces estás diciendo, las tallas son completamente distintas...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="man_wtd_000130",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Tallas?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000619",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay que ver que te esforzaste bastante para conseguir estos colores tan raros,\neh.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_rna_000063",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué colores habían?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000620",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Algo así como un rosado desteñido, ¿tal vez? Aunque también había verde\ndesteñido...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="man_wtd_000131",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Llamalo rosado claro! ¡El rosado claro aviva la lujuria de las personas!”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000621",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Vaya, así que de eso se trata? Disculpe mi malentendido. ¿No le gustaría\nentonces probar usted mismo esos uwabaki olorosos que tanto le encantarían a\naquellas personas con gustos desviados?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="man_wtd_000132",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"cgdel",id=-1},
{"se",file="se3130",vol=50,id=1},
{"bg",time=500,file="black",path=":bg/"},
{"evset",file="ev_com_a26_04",set="ev_com_a26",path=":ev/ev_com_a26/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="ev_com_a26_04base",id=1,lv=1,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_akashi02",id=2,lv=2,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_fg_akashi",id=3,lv=3,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_yumi",id=4,lv=4,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_akashi07",id=5,lv=5,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_kei",id=6,lv=6,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_makoto",id=7,lv=7,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"bg",file="ev_com_a26_icon_naoya",id=8,lv=8,path=":cg/cg_ev_com_a26/",set="cg_ev_com_a26",sync=0},
{"extrans",time=500},
{"cgact",file=":cg/cg_ev_com_a26/ev_com_a26_icon_akashi02",id=2,lv=2,act="いいえ",loop=-1,size=6,time=100},
{"cgact",file=":cg/cg_ev_com_a26/ev_com_a26_icon_akashi07",id=5,lv=5,act="いいえ",loop=-1,size=3,time=100},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000133",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡GYAAAAAAAAAAAAAAHHHH! ¡HUELE HORRIBLEEEEEEEE!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000622",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jojojojo, ¿qué tal el olor de los uwabaki de alumnos deportistas? Había\nescuchado que dentro de todo el cargamento también habían algunos de antaño\nde hace más de 10 años que fueron desenterrados de la sala del club de Rugby.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="man_wtd_000134",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Huele mal, o más bien, no puedo respirar! ¡No puedo respirar, o más bien!\n¡Huele mal! ¡¿Oh Dios mío, es que acaso me has abandonadoOoOo?! ¡Suplico por\ntu ayudaaAAaAA!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues obviamente que si huele mal tampoco podrá respirar... ¿Estás segura de\nque no se va a morir?”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Akashi tiene la cabeza envuelta con una bolsa de basura completamente llena con\nlos viejos uwabaki de los alumnos.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Debe oler terrible también, pero normalmente cualquiera se quedaría sin oxigeno\nsi le pusieran una bolsa de basura en la cabeza. Fuera de todo chiste, podría\nmorir...",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"bgm",stop=1,time=30},
{"quake",mode="mw"},
{"cgdel",id=2,lv=2,time=400},
{"cgdel",id=5,lv=5,time=400},
{"text"},
text={
vo={
{"vo",file="man_wtd_000135",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“NUOOOOOOHHHH, ¡¿creen que yo, alguien como yo, morirá con algo tan patético\ncomo el mal olor masculinooooo?!...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qu--?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"se",file="se9029",loop=1,id=1},
{"cgact",file=":cg/cg_ev_com_a26/ev_com_a26_fg_akashi",id=3,lv=3,act="びっくり",loop=-1,size=4,time=100},
{"bgm",file="bgm008"},
{"text"},
text={
ja={
{
"Se escucha un sonido parecido al de una aspiradora, un rugiente sonido de\naspiración se escucha viniendo de Akashi.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Y junto a ese sonido, el pecho de Akashi se infla bastante, dando la sensación\nde que explotará en cualquier momento. Mientras que, en cambio, la bolsa va\nencogiéndose cada vez más...",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Este tipo está aspirando todo el aire de la bolsa?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="man_ked_000722",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Q-Qué piensa hacer?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Muchachos, contengan la respiración! ¡Este tipo planea hacer explotar la bolsa\nde basura!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000623",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿E-Es eso posible?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me extrañaría que lo hiciera. No subestimes a Akashi. ¡Cuando de verdad está\ndeterminado a hacer algo lo hace!”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"se",stop=1,time=500,id=1},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000136",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡BUHAAAAAAA!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Akashi suelta en un respiro todo el aire.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"La bolsa de basura se expande rápidamente.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"cgdel",id=-1},
{"bg",rule=105,time=100,file="black",path=":bg/"},
{"bg",rule=105,time=100,file="white",path=":bg/"},
{"se",id=1,file="se3313"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"¿Qué clase de fuerza de voluntad tiene este tipo?",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Obviamente la bolsa de basura no se rompió, pero todo el aire que Akashi soltó\nde un solo golpe hizo que la bolsa se deslizara de su cabeza, y también...",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0013",head="mak_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000624",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qu--? ¿Por qué? ¿Por qué la cuerda que estaba amarrando a Akashi-senpai se...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La cuerda se rompió cuando su pecho se infló de esa manera tan anormal.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",my=40,mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"se",file="se3130",id=1},
{"text"},
text={
vo={
{"vo",file="man_wtd_000137",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Kukukuh... ¡Mi fuerza mental es incomparable!”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000625",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Kyaah!”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_rna_000064",ch="rna"},
},
ja={
{
name={"Rina"},
"“U-Uwah, qué mal huele.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_yum_000098",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Nuh...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Akashi riega el contenido de la bolsa de basura que estaba a sus pies por todo\nel suelo. Incluso Toritani no pudo evitar sobresaltarse, sin poder hacer\nnada.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bgm",stop=1,time=100},
{"bgm",file="bgm015"},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000138",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Adiós! ¡Muchachos de Kuroneko Yamato!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000626",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡K-Kei! Se fue por allí... ¡Atrapa a Akashi-senpai!”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"se",file="se9023",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=0,speed=200,file="zbg049a",path=":bg/",x2=200,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=100},
{"fg",ch="明石",size="z2",speed=800,mode=3,resize=1,path=":fg/aka/z2/",file="aka_z2a0000",face="a0001",head="aka_z2a",x2=-680,x=680,lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"ex",time=200,func="wait"},
{"se",file="se3130",id=1},
{"fg",ch="圭",size="z2",speed=500,sync=0,mx=1280,mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0007",head="kei_z2a",x=500,lv=5,id=6},
{"fg",ch="明石",speed=500,mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0001",head="aka_z2a",x2=680,x=-500,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000723",ch="ked"},
},
ja={
{
name={"Kei"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="明石",size="z2",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0002",head="aka_z2a",x=-500,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000139",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“No soy tan torpe como para dejarme atrapar por alguien como Kei.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0006",head="kei_z2a",x=500,lv=5,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000724",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué dices~?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="明石",size="z2",mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0007",head="aka_z2a",x=-500,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000140",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Ah, un Hiraga Gennai volador!”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0014",head="kei_z2a",x=500,lv=5,id=6},
{"fgact",ch="圭",act="いいえ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000725",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Qué? ¿Hiragana genmai?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"¿Qué clase de reacción de comedia es esa?",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"se",file="se9003",id=1},
{"fg",ch="明石",speed=500,mx=1280,mode=-1,lv=5,id=9},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0007",head="kei_z2a",x=500,lv=5,id=6},
{"fgact",ch="圭",act="びっくり",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000726",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ah!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000141",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Jajajajajaja. ¡GOODBYE! ¡BYE! ¡DAZAI!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Tal como Akashi lo proclamó, Kei no pudo atraparlo.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Después de haber evadido a Kei, Akashi se dirigió de una sola vez a la salida.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"se",id=1,file="se2308"},
{"text"},
text={
ja={
{
"En el instante en que Akashi giró con dirección hacia la salida, la puerta se\nabrió.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bg",x=-960,speed=1000,time=0,sync=0,file="zbg049a",path=":bg/",x2=0,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="稟",size="z2",time=1000,sync=0,mx=1280,mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0200",face="a0001",head="rin_z2a",x=500,lv=5,id=6},
{"fg",ch="明石",size="z2",speed=1000,mode=3,path=":fg/aka/z2/",file="aka_z2a0000",face="a0001",head="aka_z2a",x2=0,x=-500,lv=5,id=9},
{"text"},
text={
ja={
{
"Y allí estaba parada Rin Misakura.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin! ¡Cuidado! ¡Esquívalo!”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0200",face="a0012",head="rin_z2a",x=500,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000332",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"bg",time=100,sync=0,file="black",path=":bg/"},
{"bg",lv=8,id=8,file="line2",time=400,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"text"},
text={
vo={
{"vo",file="man_wtd_000142",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Apartense, apartense! ¡Richard Matheson! Voy como ¡EL! ¡DIABLO! ¡SOBRE!\n¡RUEDAS!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Akashi se acerca.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"Aunque quiera hacerlo, no hay manera de que pueda detenerse.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Si por lo menos Rin pudiera esquivarlo...",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Rin!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"En ese instante en el que grité, el cuerpo de Rin pareció estar agachándose, y\nentonces――",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"bgm",stop=1,time=500},
{"cgdel",lv=8,id=8,time=400},
{"se",file="se2271",id=1},
{"bg",rule="106r",time=200,file="white",path=":bg/"},
{"text"},
text={
ja={
{
"Sus pies flotan en el aire.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Todos dudamos de nuestros propios ojos al ver ese panorama. Akashi estaba\nvolando por el aire.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Una joven muchacha hizo que un hombre de gran tamaño diera una vuelta por el\naire.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"se",id=1,file="se3356"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_wtd_000143",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Higii!”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"A pesar de haber dado una vuelta, solo un pequeño sonido de impacto resonó\nalrededor.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Seguramente le jaló de la mano al instante para evitar que se hiriera.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm037"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000627",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Eh! ¡Rin-chan!”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué fue ese ippon seoi?...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="man_ked_000727",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Tienes experiencia en artes marciales?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0008",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000333",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no, no. No soy ninguna experta en artes marciales. Solo que he estado\npracticando judo todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000628",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El judo es un arte marcial...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0012",head="rin_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0008",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000334",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero tampoco lo he practicado tanto. Solo he estado entrenando desde\nsecundaria hasta que fui transferida a Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="man_ked_000728",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero si esa técnica fue impresionante...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000335",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo fue pura casualidad. El oponente era de gran tamaño, y venía con bastante\naceleración además.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"¿Rin comenzó a practicar judo desde aquel entonces?",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0010",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0009",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000336",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Dejando eso de lado, lo siento tanto. Fue todo tan rápido que terminé\nlanzándote. ¿No tienes ninguna herida?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, ya tenía mucho más daño encima antes de que lo lanzaras...”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"bg",file="reco",id=9,lv=9,path=":sys/"},
{"text"},
text={
ja={
{
"Ese día estuvimos ocupados limpiando los zapatos y la sala, así que no pudimos\nhacer las actividades usuales del club.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Por otro lado, nunca me imaginé que esa aparentemente frágil Rin practicara\njudo... ¿Qué la habrá hecho cambiar de esa manera?",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Aunque bueno, de igual manera, es un alivio que no haya ocurrido ningún\naccidente.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="01_fruhlingsbeginn_03_5"},
{"text"},
linkback="block_00147",
},
label = {
top={block="block_00000",label=1},
},
}
