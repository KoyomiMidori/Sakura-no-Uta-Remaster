astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c05_01",path=":ev/ev_eye_c05/",set="ev_eye_c05"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bg005a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm023"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhmmm...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"No sé si fue por haberme quedado pensando en varias cosas o si fue algo más,\npero me desperté algo temprano. ¿Será esto el preludio a alguna catástrofe?",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Ya es la hora en la que Toritani se dirige al colegio.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"... Hagamos el desayuno y salgamos.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"se",file="se9012",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg015a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",sync=1,vague=40},
{"ex",time=500,func="wait"},
{"bg",sync=1,file="bg038a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"ex",time=500,func="wait"},
{"bg",sync=1,file="bg060a",path=":bg/"},
{"se",stop=1,time=500,id=1},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Al terminar de comer y llegar al horno escalonado, Toritani estaba observando\nuna de sus creaciones de práctica con un rostro grave.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te gustó?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002101",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Para nada, no quedó nada bien.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A mí me parece que quedó bien hecha, la verdad...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002102",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No llega a lo que estoy buscando. No sirve de nada esto.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No será más bien que estás haciéndote muchas expectativas?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0027",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002103",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No se trata de eso.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002104",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estoy apostándolo todo a la Exposición Moore de este año. Estoy decidida a\nganar algún premio, de cualquier manera.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tú?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002105",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuh, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002106",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sin embargo, en el mundo hay brechas en el talento que no pueden ser cerradas,\npor más que uno lo intente. Tú muy bien lo sabes, ¿no es así, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002107",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y la suerte influye también. Por eso es que tomaré la mejor vía.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La mejor vía...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002108",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. La mejor vía para mí. Me esforzaré hasta más no poder y probaré todas las\nideas que se me ocurran. Y por eso lo digo, esto no sirve. Aún no he probado\ntodo lo que puedo probar, ni he puesto todo el esfuerzo que podría poner.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"fg",ch="真琴",mode=-1,lv=4,id=9},
{"se",file="se2735_n",vol=60,id=1},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"Toritani levanta hacia arriba sus manos y estrella su creación de prueba contra\nel suelo.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"De alguna forma, me pareció que esa era la manera única de Toritani de\ndespedirse de su obra, y también una declaración por su parte de que está\ndispuesta a avanzar a mayores niveles de perfección.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg048g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
"La primera clase de la tarde se suspendió, declarándose como hora para estudio\nindividual.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Al echar un vistazo a la azotea, se veía algo de humo elevándose sobre ella.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Me escapo del salón.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000,sync=1},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"bgm",file="bgm002"},
{"text"},
text={
vo={
{"vo",file="fem_htd_000099",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Otra vez tú?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Suspendieron la clase y la declararon como hora de estudio individual, así que\naproveché para venir.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000100",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Justo como la vez pasada, no parecía tener la más mínima intención de\nreprocharme por haber escapado de clases. Aun tratándose de un alumno de su\npropio colegio.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Esta mujer botó a los Nakamura a patadas fuera del colegio Yumihari. No cabe\nduda de que es una mujer de gran carácter.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Recuerdo a aquellas personas que, de la misma manera, pelearon sin retroceder\ncontra la familia Nakamura.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Kotoko Natsume y Kenichiro Kusanagi. Ambos se enfrentaron a la familia\nNakamura, muy conocida por estos lares. Y lo hicieron de todas las maneras\nposibles.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Y lo que resultó de ese conflicto fue la actual mansión Natsume.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Esta mujer también peleó con los Nakamura, y logró liberar a este colegio de\nsus manos.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Posteriormente se divorció y retornó a su viejo apellido. Toritani.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Tomó la custodia de su verdadera hija, y dejó a Kei al cuidado de los Natsume.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"No dejó a Kei en la casa de los Nakamura. Pero tampoco lo aceptó como un hijo\nde los Toritani.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"No sé qué clase de plan tuvo esta mujer en su mente.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Recuerdo las palabras de Toritani.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"bg",file="ev_com_b02_06",path=":ev/ev_com_b02/",set="ev_com_b02",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002038",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, ¿sabes algo? Hubo un tiempo en el cual deseaba poder vivir con ellos\ndos, juntos por siempre. No te miento.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"De niña, Toritani quería vivir junto a Kei.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"No solo eso. Quiso llevar una vida junto a Kei, y junto a esta señora.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"Sin embargo, ese deseo no llegó a cumplirse. Y muy contrario a eso, ahora los\ntres viven separados, cada quien por su lado.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Toritani dijo que aun así no le importaba, puesto que Kei Natsume era feliz\nasí.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Prefiere mantener a salvo la feliz vida de Kei como un Natsume que satisfacer\nsu propia necesidad emocional.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"...",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Ella me pidió que no me acercara más a la directora. Dijo que estaba harta de\nque esta siguiera usando al club de arte.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Entiendo que Toritani sea cautelosa ante la directora.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"No quiero tirar por el caño su fuerte advertencia. Sin embargo, no me parece\nque la directora sea tan peligrosa como ella lo dice.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"... Y además, hay algo que me causa curiosidad.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000101",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Qué sucede? ¿Por qué tan absorto?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estuve pensando respecto a lo que usted hizo la vez pasada.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000102",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ah, eso... eso fue--”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue solo una finta, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Aquel día, antes de que Toritani me sacara de la azotea, los labios de la\ndirectora se movieron ligeramente, todavía con su cigarro en la boca. Sin\nembargo, eso solo fue una simple finta. Un insinuante engaño.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que hizo como tal no tuvo ningún sentido. Simplemente movió sus labios.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000103",ch="htd"},
},
ja={
{
name={"Directora"},
"“... ¿Es que acaso puedes leer los labios?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no en realidad. Simplemente, y de alguna forma, me pareció que usted estaba\ntratando de probarme. En parte eso. Lo demás fue por mera intuición.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0011",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000104",ch="htd"},
},
ja={
{
name={"Directora"},
"“Intuición, eh.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Y para agregar... digamos que tengo algo de experiencia en esa clase de\njuegos... Me dio la sensación de que terminaría cayendo en alguna trampa si\ntrataba de buscarle mucho sentido a ese gesto.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000105",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Una sonrisa se forma en los labios de la directora.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estoy en lo correcto?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000106",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pues sí, digamos que casi en lo correcto.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Esto era lo que me causaba curiosidad. La razón por la cual me hizo ese\nengañoso gesto.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0011",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0010",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000107",ch="htd"},
},
ja={
{
name={"Directora"},
"“Me parece que hice algo insinuante. Sin embargo, no lo hice con ninguna gran\nrazón. Ni siquiera buscaba probarte.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0002",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000108",ch="htd"},
},
ja={
{
name={"Directora"},
"“Si de igual forma necesitas una, digamos que simplemente quise jugar contigo un\npoco. Y me divertiste más de lo que esperaba.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0001",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000109",ch="htd"},
},
ja={
{
name={"Directora"},
"“Y me recordaste también al pasado, en parte.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Señora directora, usted conoce a Kenichiro Kusanagi, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000110",ch="htd"},
},
ja={
{
name={"Directora"},
"“Por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0010",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000111",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Solo querías saber eso?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000112",ch="htd"},
},
ja={
{
name={"Directora"},
"“Vaya, pero qué seco. ¿No quieres escuchar algunas de las historias de tu padre?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tiene caso alguno que las escuche.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000113",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese hombre, muy seguramente no la odiaba a usted.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000114",ch="htd"},
},
ja={
{
name={"Directora"},
"“... Quién sabe.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, probablemente.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"De igual forma, el único que conocía esa verdad está hecho cenizas ya.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="紗希",size="z2",mode=3,resize=1,path=":fg/sak/z2/",file="sak_z2a0000",face="a0002",head="sak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000115",ch="htd"},
},
ja={
{
name={"Directora"},
"“Por cierto, ¿viste las noticias de hace unos días?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0001",head="sak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000116",ch="htd"},
},
ja={
{
name={"Directora"},
"“Parece que fueron presentadas las 7 obras ocultas de Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, hace poco lo mencionaron.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0002",head="sak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0010",head="sak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000117",ch="htd"},
},
ja={
{
name={"Directora"},
"“Parece que la Farmacéutica Nakamura las tenía en su posesión, ¿no es así?. La\nmisma Farmacéutica se pronunció, declarando que 'siempre han mantenido una\nprofunda y muy cordial relación con el señor Kenichiro Kusanagi'...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0003",head="sak_z2a",lv=5,id=9},
{"fgact",ch="紗希",act="うなづく",time=100,size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000118",ch="htd"},
},
ja={
{
name={"Directora"},
"“Una profunda, y cordial relación, eh... Me van a matar de la risa.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me parece tan equivocado lo de 'profunda relación'. Ciertamente fue una\nrelación muy enmarañada.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0010",face="a0001",head="sak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0010",face="a0010",head="sak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000119",ch="htd"},
},
ja={
{
name={"Directora"},
"“Seguramente aprovecharon la oportunidad después de que presenté el mural en el\ncolegio. De verdad que vinieron justamente en el mejor momento, eh.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0010",face="a0011",head="sak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000120",ch="htd"},
},
ja={
{
name={"Directora"},
"“Si es que verdaderamente son reales esas obras, eso sí...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues lo deben ser, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0010",face="a0010",head="sak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0010",face="a0001",head="sak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000121",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Eso crees?... Aunque bueno, nada que tenga que ver conmigo ya, supongo.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"La directora observa el reloj en su muñeca.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000122",ch="htd"},
},
ja={
{
name={"Directora"},
"“Bien, hasta aquí por hoy. Quizás no lo parezca, pero estoy realmente ocupada.\nTengo muchos asuntos fastidiosos por atender.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues para estar tan ocupada, parece tener tiempo suficiente como para observar\nel mural desde la azotea.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000123",ch="htd"},
},
ja={
{
name={"Directora"},
"“Es mi precioso rato de relajación. En nuestras vidas todos necesitamos al menos\nun momento para parar y fumar un cigarro, así como ahora.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000124",ch="htd"},
},
ja={
{
name={"Directora"},
"“Nos vemos de nuevo en otra oportunidad.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"se",file="se9004",id=1},
{"fg",ch="紗希",mx=40,mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"La directora se va.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"se",id=1,file="se1895"},
{"text"},
text={
ja={
{
"Y la campana suena.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Parece que ya terminaron las clases...",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Al parecer, no todo fue altercados entre ese hombre y la directora...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"De ser así, ¿cuál habrá sido la razón de la directora para despedir a Kenichiro\nKusanagi?",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pensándolo de manera lógica, no hay forma de que Kenichiro Kusanagi haya sido\ndespedido solo porque sí, pero...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Quizás era lo más conveniente para él. O tal vez fue algún trato entre los\ndos...",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual forma, no puedo bajar la guardia con alguien que se la llevaba bien\ncon Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Kenichiro Kusanagi fue un artista reconocido a nivel mundial, y a la vez, un\nestafador con bastante popularidad en ese mundo.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"A su alrededor siempre habían un montón de zorros astutos y maliciosos.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Siento ese mismo olor venir de la directora.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"El apellido 'Toritani' no llegó a decirme nada, pero igualmente no puedo\ndistraerme mucho. No cuando se trata de los Nakamura.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"bg",time=300,file="black",path=":bg/"},
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=350},
{"ex",time=350,func="wait"},
{"bg",time=300,file="black",path=":bg/"},
{"cgdel",id=-1},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me gustaría para nada ver de nuevo a ese viejo tampoco...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Fridmann había mencionado algo así antes: En lo que concierne al mundo del\narte, que le vendan una imitación o que compre una obra verdadera depende\ntodo de su habilidad. Seguramente 'él' tenía la consciencia suficiente como\npara saber de que así es ese mundo.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Aunque no sé realmente...",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"ex",time=500,func="wait"},
{"msgoff"},
{"colortone",style="reset"},
{"bg",file="bg048e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
"Al terminar la tutoría se acaban las clases por hoy y comienza la hora de las\nactividades extracurriculares.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Veamos, ¿qué hago ahora?... Aunque vaya a la sala de arte seguramente no habrá\nnadie, ni siquiera Rin.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"¿Será que voy a ver cómo anda Toritani?",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Comienzo a caminar sin rumbo alguno, pero me detengo frente al asiento de\nToritani.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Fumuh.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Se puede ver muy bien el mural desde acá, eh. Y también las personas enfrente\ncontemplándolo.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Es fácil que me pillen cuando me escapo de clases para ir a ver el mural desde\nacá. Esto lo explica todo.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Frente al mural están abarrotados estudiantes. Se han venido tomando las\nmedidas necesarias para que las personas ajenas a la institución no entren.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Gracias a eso, aquellas personas que no llevan uniforme resaltan bastante....\nEsa debe ser la directora.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Desde la ventana, veo a la directora, quien estaba frente al mural. No logro\ndistinguir bien su cara, pero está hablando con alguien.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"La persona con la cual conversa no es una estudiante, ni tampoco parece tener\naires de profesora. Es muy joven como para ser parte de la directiva.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"La mujer con quien habla parece ser una persona de bastante habilidad. No logro\nver su cara bien, pero puedo imaginarme eso a partir de su manera de caminar\ny sus gestos.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Despues de hablar un rato frente al mural, la directora y su acompañante se van\ncaminando al estacionamiento.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Ya veo, ciertamente parece estar bastante ocupada.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"bgm",stop=1,time=1500},
{"se",stop=1,id=-1,time=1500},
{"vostop",stop=1,time=1500},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1500,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",x=-200,y=-520,file="zbg057a",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"bg",file="fg_saki01",id=4,lv=4,y=-280,path=":cg/",ax=1035,ay=904,bx=-75,by=-364,sync=0},
{"bg",lv=5,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm109"},
{"text"},
text={
vo={
{"vo",file="fem_htd_000125",ch="htd"},
},
ja={
{
name={"Directora"},
"“Aunque debo decir que eres realmente insistente, eh.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_obs_000001",ch="obs"},
},
ja={
{
name={"???"},
"“Muchísimas gracias.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"La mujer baja ligeramente su cabeza, sin quitarse en ningún momento la sonrisa\nde la cara. En el cuello de su traje brilla la chapa de abogado.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_obs_000002",ch="obs"},
},
ja={
{
name={"Abogada"},
"“Así como usted, yo también trato de hacer mi trabajo lo mejor posible. Mi\nclienta no me permitirá regresar con las manos vacías después de solo unos\npocos encuentros con usted.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Observo su cara.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Sí, ciertamente... Si realmente está trabajando para esa mujer, entonces\nseguramente no puede regresar desvergonzadamente con las manos vacías.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"... Creo que es momento de hacer mi jugada.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"cgact",file="fg_saki01",id=4,lv=4,act="おじぎ",size=5,y=-280},
{"text"},
text={
vo={
{"vo",file="fem_htd_000126",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ahh, ahora que lo recuerdo.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Comienzo a sacar el tema de manera sobria, como si no fuera nada.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_obs_000003",ch="obs"},
},
ja={
{
name={"Abogada"},
"“¿Sí? Dígame.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_htd_000127",ch="htd"},
},
ja={
{
name={"Directora"},
"“No tiene relación directa con el trabajo, pero hay un lugar al cual quisiera\nque me acompañaras. No tiene por qué ser hoy, podría ser mañana o pasado,\nmientras yo tenga tiempo.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_obs_000004",ch="obs"},
},
ja={
{
name={"Abogada"},
"“¿Un lugar... al cual quiere que la acompañe?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"cgact",file="fg_saki01",id=4,lv=4,act="うなづく",size=5,y=-280},
{"text"},
text={
vo={
{"vo",file="fem_htd_000128",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí. Seguramente te interesará a ti también.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"cgdel",id=-1},
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
