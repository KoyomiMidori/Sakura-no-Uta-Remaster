astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="zeveningsky_summer",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm009"},
{"text"},
text={
ja={
{
"Después de calmarse, limpié muy minuciosamente sus muslos y genitales.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Mientras que con una expresión de pena, ella...",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_szd_001650",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Perdóname... parece que realmente sí soy una pervertida a la que le encantan\nlos juegos de humillación...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Se disculpó una y otra vez diciendo lo mismo.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"No veo necesidad alguna de que se disculpe... Aunque, al parecer está ahora\npensando que me ha metido en un gran meollo, y estaba algo triste ahora.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Qué cosas...",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"La verdad es que después de haber podido presenciar algo tan maravilloso, me\nsiento muy afortunado...",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Pero tuvimos suerte de que no nos descubrieran. Y no creo que volvamos a\nintentar algo tan peligroso...",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Aunque, no puedo negar que esta descomunal sesión de sexo me dio un placer\nigual de descomunal.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Sin ropa interior alguna, y a la vez poniendo mucho cuidado en procurar que su\nfalda no se levantara, Shizuku y yo llegamos a mi apartamento en\nSakuragahara.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"cgdel",id=-1},
{"bgm",file="bgm009"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg021b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011",head="shz_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001651",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Fuh... a salvo, por fin...”",
{"rt2"},
},
},
},
labelcount=2,
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Nerviosa de andar por ahí sin pantis?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0003",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001652",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, algo. Aunque es más la felicidad de saber que me protegiste.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? A mí me pareció ver a una pequeña pervertida excitada de andar sin\nropa interior.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0005",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001653",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Te equivocas.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Shizuku niega con fuerza.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001654",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“De lo que hicimos hoy, me di cuenta de algo.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008j",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001655",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ciertamente soy una pervertida amante de los juegos de humillación, pero a\nfinal de cuentas, simplemente me gusta que juegues conmigo.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0010j",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001656",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Puedo ser una pervertida capaz de hacer lo que sea, donde sea, siempre y cuando\nseas tú quien me toque y me humille...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿D-De verdad?...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008j",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001657",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“De verdad...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja, pues, creo que podríamos hablar adentro y no acá... ¿Quieres algo de\nté?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011j",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",time=600,size=10,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001658",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Más que té, hay algo que deseo y quisiera pedirte.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Algo que deseas?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008j",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001659",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"bgm",stop=1,time=500},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0301",face="a0010j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Shizuku levantó su falda.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0009j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",loop=6,time=800,size=10,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0015j",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001660",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“C-Creo que mi mano no fue suficiente... Quiero que me metas tu pene... aquí, y\nya...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fgact",ch="雫",act="停止",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A-Aquí, y ya?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0011j",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0008j",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001661",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“La verdad es que quería que me penetraras en el colegio... pero, era muy\nposible que nos descubrieran, y...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0009j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001662",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Si eso llegara a suceder, podría causarte muchos problemas...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0010j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",loop=6,time=800,size=10,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001663",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“A-Así que, mi vag*na... ha estado, muy caliente, desde que salimos del banco...\ny no ha parado, de soltar sucios jugos...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fgact",ch="雫",act="停止",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0009j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うんうん",time=800,size=10,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0015j",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001664",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Jaa, jaa... ya no puedo más. No aguantaré hasta la habitación...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0011j",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0019j",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001665",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Mi coño, no aguanta más... Te lo ruego, por favor... dámelo acá.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Con la cara completamente enrojecida y a punto de llorar, Shizuku me ruega.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Viéndola rogar así le prende fuego una vez más a mi lado sádico...",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué es lo que quieres que te dé?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0011j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",time=600,size=10,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0009j",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001666",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Eh? P-Pues, quiero que me des... tú... ehm... esto...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una orden para ti, pequeña pervertida Shizuku. Quiero que me digas claramente\nqué quieres y dónde lo quieres.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0020j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",time=800,size=15,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001667",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Uhh... qué malo eres conmigo, Naoya...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0011j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="いいえ",time=600,size=10,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001668",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Uhhhh...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Así como lo hizo hace un rato, Shizuku abre su mojado co*o con sus dedos.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Es la misma pose que hace al abrirse.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0015j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うんうん",time=800,size=10,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001669",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Jaa, jaa... m-mi mojado, co*o... no para de palpitar, queriendo tener tu pe*e\nadentro... Naoya, por favor, métemelo.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aquí, en la entrada? No hay mucha libertad de elegir la posición acá.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0009j",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001670",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No me importa la posición, siempre y cuando pueda tener tu pene adentro.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Pues entonces tendremos que hacerlo de perrito, ¿no te importa?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0015j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",time=800,size=15,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001671",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, está bien acá... Penetra duro, mi co*o, d-de perrito... y hazme sentir muy\nbien, te lo ruego...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te lo meteré tanto como quieras, si así me lo pides...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0009j",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001672",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoyaaa...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",file="se0897s",id=1},
{"text"},
text={
ja={
{
"Levanto la falda de Shizuku y le quito su vestido.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Sus pechos y genitales salieron al aire.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Le daré cariño a tus pechos también...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Masajeo los pezones de Shizuku con mis dedos.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001673",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hiiinn...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Shizuku ya tenía el historial de haberse corrido por sus pechos. Y sus pezones\nestaban ahora hinchados, sensibles ante cualquier mínimo toque.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Sobo sus pechos con un brazo, y con el otro abro su trasero.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"El interior de sus nalgas estaba completamente mojado, y sus jugos estaban\nahora cayendo ahora hasta sus muslos.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Pongo mi miembro sobre la entrada de su vagina.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Después de lo que sucedió en el banco, sus genitales estaban ahora relajados,\nfácilmente accesibles.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku... voy a meterlo...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_szd_001674",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“S-Sí... quiero, tu pene... yaaa...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bgm",stop=1,time=1000},
{"bg",file="ev_shz_h05_01",path=":ev/ev_shz_h05/",set="ev_shz_h05"},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
"――¡*zum*!",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001675",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“... HiigiiIIihhh... ¡¡¿Ah, ah, ahh, auuhh?!!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Al apenas entrar mi miembro Shizuku dobló su espalda y comenzó a jadear.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"bg",file="ev_shz_h05_02",sync=0,face=1,time=400,path=":ev/ev_shz_h05/",set="ev_shz_h05"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001676",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“C-Creo, q-que... me corrí, un poco... apenas... lo metiste...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿S-Sí?... E-Estás bien mojada, apretada, y caliente, adentro...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_szd_001677",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Mi coñito, se contentó tanto de tenerte adentro, que comenzó a apretarse\nsolito... Naoya, ¿no te duele que te... apriete, tanto?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obvio que no... Se siente, tan bien... adentro, y... ya mi cabeza, está en...\nblanco... kuhh...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"No pude contenerme, y atornillé mi miembro entero en Shizuku.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001678",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Higiih... A-Ah... ¡¡NgaaaAAAHhhh!! I-Increíble, Naoya... tu pe*e, está\nllegando... a lo más, profu... ndo.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Al penetrar hasta el fondo, una cálida, viscosa sensación envuelve mi miembro.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Aun después de lo mucho que jugué con su co*o en el colegio, este estaba mojado\ny caliente hasta lo más profundo, como si apenas acabara de estimularlo.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Sin duda alguna, ha estado esperando con ansias, todo este tiempo, por mi pe*e.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_szd_001679",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ahhh... ¡¿Ahh?! ¡¿Hahiiiih?! A-Ahhh, no, no, creo, que ya no puedo máaas...\nnguh...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_szd_001680",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Jaa, jaa, tu pe*e, tu pe*e... Hauuuhhh, no, no puedo más con estooo...\n¡¡¡¿¿HahiiiiiIiiIihhh??!!! ¡¡Kwaaaagh!!”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"bg",file="ev_shz_h05_01",sync=0,face=1,time=400,path=":ev/ev_shz_h05/",set="ev_shz_h05"},
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"――*bikun*, *bikun*",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿¿Shizuku??”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Me doy cuenta de que Shizuku estaba temblando ligera, pero rápidamente.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?... No me digas, que ya te corriste.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bg",file="ev_shz_h05_02",sync=0,face=1,time=400,path=":ev/ev_shz_h05/",set="ev_shz_h05"},
{"text"},
text={
ja={
{
"Shizuku asintió, visiblemente apenada.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_szd_001681",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Estuve todo este tiempo esperando a tenerte adentro... y cuando entraste...\nJaa, jaa... t-tu pene, me golpeó en lo más profundo... y apenas llegó a mi\nútero, no pude aguantar más y me vine.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_szd_001682",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“D-Definitivamente, no aguanto nada...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Había algo particularmente tierno en la apenada forma en que Shizuku se\ndisculpó, y sentí un fuerte corrientazo de placer.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"No pude resistirme a dejar a Shizuku así. Tome su culo y le di una repentina,\nfuerte estocada.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"――¡*Zupaaa*!",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001683",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Haiiih?! Ah, ah, ahh... a-apenas, acabo de corrermeee... Si me das, tan\nduro... Jaa, jaa... v-voy a correrme, una, y otra vez máaas... ¡¿Haiiiih?!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Ignoro sus súplicas y ensarto mi miembro en su vag*na.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Al mover con fuerza mis caderas y acelerar sus movimientos, estas chocan con\nlas nalgas de Shizuku, haciéndolas moverse como gelatina.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Era tanta la fuerza que el sonido producido era similar al de unas nalgadas.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"――¡Paf! ¡Paf! ¡¡Paf!!",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001684",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¡¿Haiih, haiih, ah, hyah?! Ahk, kuh, ngh, kuh, kufuh... !! Ah, está tocándome\ntanto adentro, se siente tan bieeen... ¡¿Kwaaaah?!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Shizuku apretó sus dientes, intentando resistir las olas de placer.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Pero viéndola así acabó con mi razón. Golpeo con más fuerza mis caderas,\nestimulándola más al fondo, donde más lo siente.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_szd_001685",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hyahn, fuhyaah, hyah, ah, ahh, ahn, ahn... ah, ahk, kuh, Jaa, jaa, jaa... No,\nse siente, tan bien, al fondooo... higiiih.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_szd_001686",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No, noo, ño, ya, no puedo aguantar máaas... mee, vengo... me vengo, me vengo...\n¡Me corro! ¡Me corro! ¡¡¡Me coorroooo!!!”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"――¡*bikun*, *bikun*, *biku*, *bikun*!",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"bg",file="ev_shz_h05_01",sync=0,face=1,time=400,path=":ev/ev_shz_h05/",set="ev_shz_h05"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001687",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hahiiiihhh... me vengo... vengo, vengo... ¡Me corro! ¡Me estoy corriendooo!\n¡¡¡Auuhh, qué bien see sienteee!!!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Jaa, jaa, jaa, jaa!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"No le doy descanso a mis caderas.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"bg",file="ev_shz_h05_02",sync=0,face=1,time=400,path=":ev/ev_shz_h05/",set="ev_shz_h05"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001688",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Haiih, ya me acabo de correer... y aun así, no te detienees... Ah, ahhh, pero,\nse siente tan... haih, se siente tan bieeen.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_szd_001689",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hahiiih, el placer no se acabaaaa... Naoya, se siente tan bieeen... Me siento\ntan feliz, teniendo tu pe*e entrando y saliendo de mi co*o... ¡Kufuuuuh!”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Las palabras de Shizuku eran corriente para mi cerebro. Guiado por mis\ninstintos más primales, seguí follando a Shizuku a lo más profundo de su\nmojado, viscoso co*o.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"――¡¡*shup*, *shup*, *shup*... !!",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_szd_001690",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Haiih, ¿ah? ¡¿Ahiiih?! Kuhaah, ahn, ahn, ah, ahk... ah, ngh, nmmm, ngh, kuh...\n¡¿Jaa, jaa, ahnnn?!”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"La Shizuku de las revistas es hermosa, pura.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Esa misma Shizuku está ahora sudando, con su cuerpo enrojecido, moviendo sus\ncaderas lascivamente. La línea de su espalda se me hacía algo sensual.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_szd_001691",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No, no, nooo, voy a venirme de nuevooo. Nooo, ño, más, ¡N- NaoyaaaAAaaAhhh!”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_szd_001692",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No puedo parar de correrme, no se detiene. Haiih, no, no, viene fuerte ahora...\nme, vengo... vengo, me vengo... ¡Me vengo! ¡Me corro! ¡¡¡Me corrooooo!!!”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001693",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“HigyaaaAAAaAAhhh... Ngh, ngh, ngmmm, ngaAAaAaaAhhhhh, ¡¡¡Me\nvengoooooooooooooooo!!!...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"El cuerpo de Shizuku convulsiona violentamente. Pero ni siquiera eso me hace\ndetener mis movimientos.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"bg",file="ev_shz_h05_02",sync=0,face=1,time=400,path=":ev/ev_shz_h05/",set="ev_shz_h05"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001694",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hauuh, viene de nuevooo. Otra vez, vieneee... no, no para, tan rico... no he\nparado de corrermeee... higiih.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_szd_001695",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ahhh, q-qué feliz soyyy... Jaa, jaa, jaa...... Estás, batiendo tan bien, mi\nco*ooo... ngh, estás, dándome tan durooo.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"――*shub*, *shub*, *shub*",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Un lascivo sonido, como el que haría una esponja empapada en loción al pisarla\nfuertemente, resuena alrededor.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Shizuku susurra entre sus jadeos y con jugos chorreando de su co*o.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"La violenta inserción de mi pe*e hace que el hueco de su vag*na esté a punto de\nverse.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001696",ch="szd"},
},
ja={
{
