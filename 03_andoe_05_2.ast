},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que te corres fácilmente, Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_szd_001727",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“S-Sí... soy una niña pervertida de uso exclusivo para ti... Solo basta que me\nhagas cosas sucias... para venirme, en cuestión de segundos...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajaja... ¿Cómo es que puedes decir cosas tan tiernas?...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Abrazo a Shizuku.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"――*biku*... *bikun*... *bikun+... *biku*, *biku*...",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Al pasar los pequeños temblores, Shizuku cayó exhausta.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"La tomé en mis brazos.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"scene",file="scene13"},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Unos minutos después, esta finalmente se calmó.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg021b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0501",face="b0008j",head="shz_z1b",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás bien ya?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0501",face="b0010j",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001728",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí... Naoyaaa...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0501",face="b0009j",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001729",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Perdóname por ser tan pervertida, ¿sí?...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No digas tonterías.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0501",face="b0002j",head="shz_z2b",lv=5,id=9},
{"se",file="se9010",vol=60,id=1},
{"text"},
text={
ja={
{
"Envuelvo la cabeza de Shizuku en mis brazos.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa es la mejor recompensa que podría recibir...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0501",face="b0003j",head="shz_z2b",lv=5,id=9},
{"fgact",ch="雫",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001730",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoyaaa...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Shizuku hunde su cara en mis brazos.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
