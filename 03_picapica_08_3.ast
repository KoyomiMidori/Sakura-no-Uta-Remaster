astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Quimera cierra sus puertas por hoy.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Después de terminar de limpiar y contar el dinero de la caja, Toritani subió al\nsegundo piso para cambiarse.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Mientras tanto, me encargo de mover las mesas y cerrar las cortinas del local.\nCon esto está todo listo para esta noche.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003204",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, gracias. Me ahorraste el trabajo.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Toritani, quien regresó ahora vestida en su uniforme del colegio, se dio cuenta\nde que los preparativos estaban ya listos, y me agradece.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que decidiste venir en uniforme.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003205",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, uniforme. El traje formal de un estudiante es su uniforme, y además...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0004",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003206",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Para una chica joven, el uniforme escolar es su ropa de combate, ¿no crees?\nNada mejor que un uniforme para elevar el espíritu de lucha. Y bueno, me\ngusta el diseño también.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así te parece?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003207",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es así.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Toritani mira de reojo el reloj del local. Faltan 5 minutos para la hora\nacordada.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003208",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sabes? Cuando hablé con la dueña y le conté lo del jarrón de la urraca, me\ndijo 'Disculpa que te dejara la limpieza final a ti'.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003209",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Le dije que no se preocupara. Más bien me sentí agradecida. Me dio la única\noportunidad que tendré de poder intervenir en este caso.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En este caso...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Este caso involucra, en parte, al problema entre Kirino Onda y Reika Honma, y\ntambién a la serie de disputas que han ocurrido entre Reika Honma y la\nfamilia Toritani.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003210",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hasta el día de hoy, Reika ha hecho de todo solo por hacernos sufrir, y no ha\nescatimado a la hora de ir por lo que quiere. Fueran cuales fueran las\nconsecuencias.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003211",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Para Reika, tanto las pinturas de Kei como el jarrón de la urraca han sido\nsiempre suyas... y de la familia Nakamura. Le parece completamente\ninaceptable que estén en manos de la familia Toritani.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está enloquecida.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003212",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Totalmente. Pero Reika siempre ha vivido siguiéndose por esos preceptos.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003213",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... No tengo forma de predecir lo que implicará para Reika lo que estoy a punto\nde hacerle.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003214",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero de igual forma, haré las cosas de la mejor manera que pueda. En\nla medida de mi posibilidades.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003215",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi. Gracias.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003216",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si no me hubieras propuesto usar los jarrones de la Luna y las Estrellas, no se\nme hubiera ocurrido lo que estoy a punto de hacer ahora.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuiste tú quien decidió al final usar los jarrones que tanto odias. Yo\nsimplemente propuse lo que se me vino a la mente.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0022",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003217",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Después de haber negociado con Suetake-san por mí?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Toritani se ríe suavemente.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003218",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bueh, está bien. Dejemos las cosas así.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="真琴",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Las agujas del reloj estaban por marcar la hora del encuentro.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Lo que le propuse a Toritani fue usar los jarrones de la Luna y las Estrellas\npara poner a la abogada de nuestro lado. Y a manera de tomar responsabilidad\npor la idea, yo mismo conduje la negociación con Suetake.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Los resultados no estuvieron mal. Lo qué pensé en hacer lo hice ya.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Lo que Toritani tratará de hacer con Reika ahora es, según dice ella, la mejor\nopción que puede tomar en este caso. La solución que ella misma ideó.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003219",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Esto no perjudicará de ninguna manera a lo que ya has hecho por mí, ni a lo que\nla directora Toritani planea hacer. No te preocupes.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni hace falta que me lo digas. Ya lo sabía.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003220",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Gracias.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Las buenas intenciones pueden, a veces, traer resultados catastróficos. Aun\nsabiendo eso, Toritani decidió tomar lo que ella considera el camino del\nbien. Su mejor camino.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003221",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Un breve silencio se cierne sobre los dos. Un rato después, Toritani me\npregunta en voz baja.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0009",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003222",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sabe Kei... de esto?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Absolutamente nada. Lo único que se la pasa haciendo es pintar. Solo eso.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003223",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo... Está bien, entonces.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0011",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003224",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No hay necesidad de que él sepa nada de esto.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"se",id=1,file="se2225"},
{"bgm",file="bgm109"},
{"text"},
text={
ja={
{
"Reika lanza una mirada suspicaz a las cajas que estaban dispuestas frente a la\nmesa.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="麗華",size="z1",mode=3,resize=1,path=":fg/rei/z1/",file="rei_z1a0010",face="a0011",head="rei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000027",ch="rik"},
},
ja={
{
name={"Reika"},
"“¿Qué se supone que es esto? ¿Aun ahora sigues pensando en hacer algo?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="麗華",mode=-1,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani mueve la cabeza a los lados sin decir nada, y nos disponemos los dos a\nabrir las cajas.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"No perdí de vista la manera en que Suetake tuvo que contener el asombro al ver\nlos jarrones de la Luna y las Estrellas.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Al ver los tres jarrones de Toritani y el jarrón de la urraca, el ceño de Reika\nse fue frunciendo aún más.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003225",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te daré el jarrón de la urraca. Pero antes de eso, hay algo que quisiera\npreguntar.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"bg",time=500,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Y entonces, Toritani comenzó a contar lo que tenía que decir, tranquilamente.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"La apuesta era ver si Reika escucharía hasta el final o no. Sin embargo, esta\nescuchó, con un silencio muy poco característico de ella, lo que Toritani\ntenía por decirle.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Quizás Suetake le dijo algo antes de venir que favoreciera a esto.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Toritani explicó todo lo que ocurrió en el proceso de fabricación del jarrón de\nla urraca, detalladamente.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"La falsificación de documentos por parte de la directora, y la fabricación del\njarrón por parte de la dueña...",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"La explicación, la cual involucró mostrar también el recorte de la revista y\nlos dos cuadernos japoneses, pareció formar una única y gran historia, que\nllegó a parecerme convincente incluso a mí. Aun a pesar de conocerla ya.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Después de explicar eso, Toritani cambió el tema de conversación a los cuatro\njarrones de la Luna y las Estrellas.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Esta mostró la foto del jarrón de 'Luna' mostrada en el Catálogo Uji. Explicó\nclaramente su demanda en el mercado de artes, y con mucha calma explayó el\ngran valor artístico que se ha ganado.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Hubieron momentos en los cuales Suetake se acercó a Reika y le explicó,\nsusurrándole directamente al oído, lo tan valiosos que son los jarrones de\nToritani.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003226",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y como puedes ver... en la parte de las alas del jarrón de la urraca se utiliza\nuna coloración a base de nanopartículas metálicas, las cuales comenzaron a\nusarse a partir del siglo XXI.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003227",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Preparé esto con antelación para demostrar, de manera precisa y clara, que el\njarrón de la urraca creado por Shizuru Toritani es, sin duda alguna, una obra\nfalsa.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003228",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Con esto termina mi explicación.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003229",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“'Una imagen de un paisaje de nieve y una urraca', y 'La Luna y las Estrellas'.\nLa razón por la cual traje estas dos obras hoy es porque quiero que elijas\nentre una de las dos.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003230",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya expliqué absolutamente todo lo que podía explicar. Aceptaré tu elección, sea\ncual sea.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
ja={
{
"Al terminar de contar todo, Toritani hizo una delicada reverencia bajando la\ncabeza.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=800000,file="zbg031a",path=":bg/",x2=220,y2=0,x=-220,y=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="麗華",size="z2",mode=3,resize=1,path=":fg/rei/z2/",file="rei_z2a0000",face="a0001",head="rei_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rik_000028",ch="rik"},
},
ja={
{
name={"Reika"},
"“―――”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Toritani cerró la boca, y el silencio invadió a Quimera.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"En la expresión de quien observaba fijamente los jarrones yacía un espeluznante\nsilencio.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0010",head="rei_z2a",lv=5,id=9},
{"fg",ch="麗華",time=700,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0010",head="rei_z2a",y2=0,y=30,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0002",head="rei_z2a",y=30,lv=5,id=9},
{"fg",ch="麗華",time=200,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0002",head="rei_z2a",y2=30,y=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rik_000029",ch="rik"},
},
ja={
{
name={"Reika"},
"“... Me has dejado pasmada.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Después de ese largo, largo silencio, Reika soltó un aliento similar a un\nsuspiro y comenzó a hablar.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0009",head="rei_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rik_000030",ch="rik"},
},
ja={
{
name={"Reika"},
"“La verdad es que quisiera felicitarte por haber llegado a investigar y\naveriguar todo eso, pero...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="麗華",size="z2",speed=200,id=9,lv=5,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0003",head="rei_z2a",x=0,y=0},
{"fg",ch="麗華",time=200,id=9,lv=5,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0003",head="rei_z2a",y2="0,50,20,40,20,30,20,20,20,70,40,60,40,50",x=0,y=60},
{"quake",mode="mw"},
{"text"},
delay={
vl01={
{"fgact",ch="麗華",act="いいえ",size=1,time=50,loop=20,id=9,lv=5},
},
vl02={
{"fg",ch="麗華",size="z2",id=9,lv=5,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0007",head="rei_z2a",x=0,y=60},
{"fg",ch="麗華",mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0007",head="rei_z2a",y2=60,x=0,y=0,lv=5,id=9},
{"fgact",ch="麗華",act="いいえ",size=0.3,time=50,loop=-1,id=9,lv=5},
},
},
text={
vo={
{"vo",file="fem_rik_000031",ch="rik"},
},
ja={
{
name={"Reika"},
"“¡¡AJA, AJAJAJA, JAJAJAJA, perdiste tu tiempo!!”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bgm",file="bgm032"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zoom=50,file="zbg031a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="麗華",size="z2",zoom=103,mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0005",head="rei_z2a",x=-330,y=80,lv=5,id=9,sync=0},
{"bg",file="fg_mak_back_bokashi",x=100,y=750,zoom=80,id=10,lv=10,path=":cg/",ax=1055,ay=1650,bx=-95,by=-1110,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Toritani apenas movió sus cejas ante el repentino ataque de carcajadas de\nReika. Nadie aquí se inmutó... Para ser sinceros, yo sí me asusté bastante.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Toritani parece haber asumido con mucha calma los violentos cambios de humor de\nReika. Seguramente desde hace tiempo ha sido del tipo de persona cuyo estado\nde animo explota frecuentemente, así como lo está haciendo ahora.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="麗華",size="z2",zoom=103,mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0007",head="rei_z2a",x=-330,y=80,lv=5,id=9,sync=0},
{"fg",ch="麗華",zoom=110,speed=300,mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0007",head="rei_z2a",x2=-330,z2=103,x=-220,y=80,lv=5,id=9,sync=0},
{"fg",ch="麗華",speed=150,mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0007",head="rei_z2a",y2="80,85",x=-220,y=95,lv=5,id=9,zoom=110,sync=0},
{"extrans",time=0},
{"text"},
delay={
vl01={
{"fg",ch="麗華",time=400,mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0007",head="rei_z2a",y2=95,x=-220,y=75,lv=5,id=9,zoom=110},
},
vl02={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0013",head="rei_z2a",x=-220,y=75,lv=5,id=9,zoom=110},
{"fg",ch="麗華",time=200,mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0013",head="rei_z2a",y2="75,90",x=-220,y=88,lv=5,id=9,zoom=110},
},
vl03={
{"fg",ch="麗華",time=200,mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0013",head="rei_z2a",y2=88,x=-220,y=118,lv=5,id=9,zoom=110},
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0003",head="rei_z2a",x=-220,y=118,lv=5,id=9,zoom=110},
},
vl04={
{"fg",ch="麗華",time=200,mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0003",head="rei_z2a",y2="118,128",x=-220,y=85,lv=5,id=9,zoom=110},
},
vl05={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0007",head="rei_z2a",x=-220,y=85,lv=5,id=9,zoom=110},
},
},
text={
vo={
{"vo",file="fem_rik_000032",ch="rik"},
},
ja={
{
name={"Reika"},
"“Aun no puedo creer que trajeras estos jarrones de chatarra acá a montar\nsemejante escena de teatro. Pero lo hiciste.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="麗華",size="z2",zoom=110,mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0003",head="rei_z2a",x=-220,y=85,lv=5,id=9,sync=0},
{"fg",ch="麗華",zoom=115,time=1000,mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0003",head="rei_z2a",x2=-220,y2=85,z2=110,x=-110,y=130,lv=5,id=9,sync=0},
{"fgact",ch="麗華",act="うんうん",size=20,time=250,lv=5,id=9,sync=0},
{"extrans",time=0},
{"text"},
delay={
vl01={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0002",head="rei_z2a",x=-110,y=130,lv=5,id=9,zoom=115},
},
vl02={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0005",head="rei_z2a",x=-110,y=130,lv=5,id=9,zoom=115},
},
vl03={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0010",head="rei_z2a",x=-110,y=130,lv=5,id=9,zoom=115},
},
vl05={
{"fg",ch="麗華",size="z2",sync=0,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0006",head="rei_z2a",x=-110,y=130,lv=5,id=9,zoom=115},
{"fg",ch="麗華",zoom=117,time=200,sync=0,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0006",head="rei_z2a",x2=-110,z2=115,x=-30,y=130,lv=5,id=9},
{"fg",ch="麗華",time=200,sync=0,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0006",head="rei_z2a",y2=130,x=-30,y=130,lv=5,id=9,zoom=117},
{"quake",mode="mw"},
},
},
text={
vo={
{"vo",file="fem_rik_000033",ch="rik"},
},
ja={
{
name={"Reika"},
"“Si buscabas engañar a alguien, elegiste a la persona menos indicada. Estoy\nconsciente ya de todo lo que estás tramando. ¡Sea lo que sea que tengas que\nhacer, no estás dispuesta a soltar el jarrón de la urraca, ¿verdad?! ¡¡¡Pero\ncréeme cuando te digo que a mí NO me engañarás!!!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"cgdel",id=-1},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=300},
{"text"},
text={
vo={
{"vo",file="fem_obs_000054",ch="obs"},
},
ja={
{
name={"Suetake"},
"“R-Reika-sama... Decir que la serie de jarrones de la Luna y las Estrellas\nson chatarras es---”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"quake",mode="mw"},
{"bg",zoom=95,speed=100,file="zbg031a",path=":bg/",x2=260,y2=-100,x=210,y=-100,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="麗華",size="z2",zoom=95,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0006",head="rei_z2a",y=-15,lv=5,id=9,sync=0},
{"fg",ch="麗華",speed=100,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0006",head="rei_z2a",x2=-50,x=0,y=-15,lv=5,id=9,zoom=95,sync=0},
{"quake"},
{"extrans",time=0},
{"text"},
delay={
vl01={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0005",head="rei_z2a",x=0,y=-15,lv=5,id=9,zoom=95},
},
},
text={
vo={
{"vo",file="fem_rik_000034",ch="rik"},
},
ja={
{
name={"Reika"},
"“¡¡CÁLLATE!! ¡Suetake, ¿quién te crees para venir a discutirme?!”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_obs_000055",ch="obs"},
},
ja={
{
name={"Suetake"},
"“... D-Disculpe la intromisión.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0009",head="rei_z2a",x=0,y=-15,lv=5,id=9,zoom=95},
{"fgact",ch="麗華",act="いいえ",size=10,time=200,lv=5,id=9},
{"text"},
text={
ja={
{
"Reika mueve su cabeza a los lados, expresando su exasperación.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0008",head="rei_z2a",x=0,y=-15,lv=5,id=9,zoom=95},
{"text"},
delay={
vl01={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0011",head="rei_z2a",x=0,y=-15,lv=5,id=9,zoom=95},
},
},
text={
vo={
{"vo",file="fem_rik_000035",ch="rik"},
},
ja={
{
name={"Reika"},
"“Dios santo... Nunca deja de sorprenderme la codicia de los Toritani.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"se",file="se9080",id=1},
{"fgact",ch="麗華",act="うなづく",lv=5,id=9},
{"fg",ch="麗華",my=40,mode=-1,lv=5,id=9},
{"bg",file="rei2_10",zoom=65,x=178,y=400,id=9,lv=9,time=300,path=":cg/",y2=420,ax=1611,ay=1500,bx=-651,by=-960},
{"text"},
delay={
vl01={
{"cgdel",id=9,time=300,sync=0,lv=9},
{"bg",file="rei2_05",zoom=65,x=178,y=400,id=9,lv=9,time=300,path=":cg/",ax=1611,ay=1500,bx=-651,by=-960},
},
vl02={
{"cgdel",id=9,time=300,sync=0,lv=9},
{"bg",file="zbg031a",zoom=105,time=0,speed=200,id=2,lv=2,sync=0,path=":bg/",z2=95,x2=210,y2=-100,x=210,y=-50,ax=1920,ay=1126,bx=-960,by=-586},
{"bg",file="rei2_06",zoom=85,x=233,y=650,id=9,lv=9,speed=200,time=0,sync=0,path=":cg/",z2=80,x2=220,y2=800,ax=1611,ay=1500,bx=-651,by=-960},
{"se",file="se1894",sync=0,vol=50,id=1},
{"quake"},
},
vl03={
{"cgdel",id=9,time=300,sync=0,lv=9},
{"bg",file="rei2_07",zoom=85,x=233,y=650,id=9,lv=9,time=300,path=":cg/",ax=1611,ay=1500,bx=-651,by=-960},
},
},
text={
vo={
{"vo",file="fem_rik_000036",ch="rik"},
},
ja={
{
name={"Reika"},
"“¡¡Mis ojos son capaces de ver dónde hay una verdadera obra maestra!! ¡¡¡No\nimporta qué tanta palabrería traigas, no puedes engañar a alguien con la\nsensibilidad artística que tengo yo!!! ¡¡¡Tonta, tonta!!!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"cgdel",id=9,time=0,sync=0,lv=9},
{"cgdel",id=2,time=0,sync=0,lv=2},
{"se",file="se9010",sync=0,vol=70,id=1},
{"bg",file="zbg031a",zoom=107,time=0,speed=300,id=2,lv=2,sync=0,path=":bg/",z2=105,x2=210,y2=-50,x=210,y=-50,ax=1920,ay=1126,bx=-960,by=-586},
{"bg",file="rei2_02",zoom=87,x=233,y=650,id=9,lv=9,time=0,path=":cg/",z2=85,ax=1611,ay=1500,bx=-651,by=-960},
{"bg",file="rei2_02",zoom=87,x=237,y=680,id=9,lv=9,speed=300,time=0,path=":cg/",z2=85,x2=233,y2=650,ax=1611,ay=1500,bx=-651,by=-960},
{"text"},
delay={
vl01={
{"cgdel",id=9,time=300,sync=0,lv=9},
{"bg",file="rei2_05",zoom=87,x=237,y=680,id=9,lv=9,time=300,path=":cg/",ax=1611,ay=1500,bx=-651,by=-960},
},
vl02={
{"cgdel",id=9,time=300,sync=0,lv=9},
{"bg",file="rei2_04",zoom=87,x=237,y=680,id=9,lv=9,time=0,path=":cg/",ax=1611,ay=1500,bx=-651,by=-960},
},
vl03={
{"bg",file="zbg031a",zoom=110,time=0,speed=5000,id=2,lv=2,sync=0,path=":bg/",z2=107,x2=210,y2=-50,x=210,y=0,ax=1920,ay=1126,bx=-960,by=-586},
{"bg",file="rei2_04",zoom=90,x=245,y=700,id=9,lv=9,speed=5000,time=0,path=":cg/",z2=87,x2=237,y2=680,ax=1611,ay=1500,bx=-651,by=-960},
{"se",file="se1437",vol=50,id=1},
},
vl04={
{"bg",file="rei2_04",zoom=80,x=215,y=750,id=9,lv=9,time=300,path=":cg/",y2=700,ax=1611,ay=1500,bx=-651,by=-960},
{"cgdel",id=9,time=300,sync=0,lv=9},
{"bg",file="zbg031a",zoom=100,time=0,speed=300,id=2,lv=2,sync=0,path=":bg/",z2=105,x2=210,y2=150,x=210,y=0,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="麗華",size="z2",zoom=110,time=300,mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0006",head="rei_z2a",y2=300,y=50,lv=5,id=9},
{"se",file="se3356",id=1},
{"quake"},
},
},
text={
vo={
{"vo",file="fem_rik_000037",ch="rik"},
},
ja={
{
name={"Reika"},
"“¡¡Madre, hija, prima, todas son unas idiotas!! ¡¡Puros idiotas, idiotas, idiotas,\npuros idiotas en esa familia!!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0009",head="rei_z2a",y=50,lv=5,id=9,zoom=110,sync=0},
{"fgact",ch="麗華",act="いいえ",speed=200,lv=5,id=9,sync=0},
{"extrans",time=0},
{"text"},
delay={
vl01={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0008",head="rei_z2a",y=50,lv=5,id=9,zoom=110},
{"fg",ch="麗華",time=700,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0008",head="rei_z2a",y2=50,y=35,lv=5,id=9,zoom=110},
},
vl02={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0005",head="rei_z2a",y=35,lv=5,id=9,zoom=110},
{"fg",ch="麗華",time=200,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0005",head="rei_z2a",y2=35,y=50,lv=5,id=9,zoom=110},
},
},
text={
vo={
{"vo",file="fem_rik_000038",ch="rik"},
},
ja={
{
name={"Reika"},
"“¡¡Ahh, qué pena por ti, onii-sama!! ¡¡Debe ser una agonía para ti saber que le\ndiste la preciada sangre de los Nakamura a esta muchachita!!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bg",zoom=80,speed=800,file="zbg031a",path=":bg/",z2=100,x2=210,y2=0,x=-190,y=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="麗華",size="z2",time=200,mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0005",head="rei_z2a",y2="50,60,54,64,58,66",y=60,lv=5,id=9,sync=0},
{"fg",ch="麗華",zoom=107,time=600,mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0005",head="rei_z2a",x2="0,-100",z2="110,105",x=-50,y=60,lv=5,id=9,sync=0},
{"bg",file="fg_mak_back_bokashi",x=380,y=740,zoom=82,id=8,lv=8,speed=800,path=":cg/",z2=100,x2=1280,y2=950,ax=1055,ay=1650,bx=-95,by=-1110,sync=0},
{"extrans",time=0},
{"text"},
delay={
vl01={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0004",head="rei_z2a",x=-50,y=60,lv=5,id=9,zoom=107},
},
vl02={
{"fg",ch="麗華",time=700,mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0004",head="rei_z2a",y2="60,50,62",x=-50,y=60,lv=5,id=9,zoom=107},
},
vl03={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0010",face="a0002",head="rei_z2a",x=-50,y=60,lv=5,id=9,zoom=107},
},
},
text={
vo={
{"vo",file="fem_rik_000039",ch="rik"},
},
ja={
{
name={"Reika"},
"“¡Makoto Toritani! ¡Realmente eres una jovencita asquerosa! ¡No sabes lo mucho\nque me encantaría sacar toda la sangre que tienes, retirar todos los genes de\nonii-sama y llenarte de nuevo con la sangre de un perro callejero, pero\nagradece que no lo haré ahora!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0010",head="rei_z2a",x=-50,y=60,lv=5,id=9,zoom=107},
{"text"},
delay={
vl01={
{"fg",ch="麗華",size="z2",mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0011",head="rei_z2a",x=-50,y=60,lv=5,id=9,zoom=107},
},
},
text={
vo={
{"vo",file="fem_rik_000040",ch="rik"},
},
ja={
{
name={"Reika"},
"“Esta noche, el jarrón de la urraca regresará por fin a su dueña original, a\nmí... Y pasado mañana, los cuadros de Kei que ustedes, la familia Toritani\nrobaron, regresarán a nosotros.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"se",file="se9080",id=1},
{"bg",zoom=75,speed=300,file="zbg031a",path=":bg/",z2=80,x2=-190,y2=0,x=-390,y=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",file="fg_mak_back_bokashi",x=150,y=680,zoom=70,id=8,lv=8,speed=300,path=":cg/",z2=82,x2=380,y2=740,ax=1055,ay=1650,bx=-95,by=-1110,sync=0},
{"fg",ch="麗華",size="z2",id=9,lv=9,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0005",head="rei_z2a",sync=0},
{"fg",ch="麗華",zoom=137,xsp=300,ysp=150,zsp=300,id=9,lv=9,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0005",head="rei_z2a",x2=-50,y2="50,240",z2=107,x=0,y=230,sync=0},
{"extrans",time=0},
{"text"},
delay={
vl01={
{"fg",ch="麗華",zoom=140,xsp=1000,ysp=400,zsp=1000,id=9,lv=9,mode=3,path=":fg/rei/z2/",file="rei_z2a0000",face="a0005",head="rei_z2a",x2=0,y2=230,z2=137,x=50,y=280},
{"fg",ch="麗華",time=1000,id=9,lv=9,mode=-1},
{"se",file="se9012",id=2,vol=50},
},
},
text={
vo={
{"vo",file="fem_rik_000041",ch="rik"},
},
ja={
{
name={"Reika"},
"“¡¡No sabes el júbilo que siento de poder finalmente cortar todos los lazos con\nustedes!!”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"cgdel",id=-1},
{"se",stop=1,time=500,id=1},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rik_000042",ch="rik"},
},
ja={
{
name={"Reika"},
"“Vamos, Suetake, prepara todo ya.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_obs_000056",ch="obs"},
},
ja={
{
name={"Suetake"},
"“Entendido... Bien. Toritani-sama, ¿podría firmar aquí?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003231",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Toritani ojeó cuidadosamente los documentos que Suetake le dio. Al terminar, me\npasó los documentos a mí sin decir nada.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"En los documentos se reconocía como verdadero el jarrón de la urraca, y\nseñalaba que la familia Toritani procedería a abandonar todos los derechos\nque tenía sobre el jarrón.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Sin decir nada, le regresé los documentos a Toritani. Toritani firmó\nsilenciosamente los documentos y se los dio a Suetake.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Recuerdo de nuevo las palabras de Fridmann.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"bg",time=500,file="black",path=":bg/"},
{"fg",mode=-2,sync=0},
{"colortone",style="gray"},
{"bg",file="bg033e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="フリッドマン",size="z1",mode=3,resize=1,path=":fg/fri/z1/",file="fri_z1a0000",face="a0001",head="fri_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_frd_000151a",ch="frd"},
},
ja={
{
"En lo que concierne al mundo del arte, que le vendan una imitación o que compre\nuna obra verdadera depende todo de su habilidad.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"bg",time=500,file="black",path=":bg/"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",style="reset"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",id=1,file="se2225"},
{"text"},
text={
ja={
{
"Reika salió triunfante, con el jarrón de la urraca en sus brazos.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"Todos la vimos salir en silencio, sin decir absolutamente nada. Y tal cual la\nfábula del rey desnudo, la emperatriz se marchó junto a su nuevo traje.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003232",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"bgm",file="bgm110",time=1000},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003233",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Se acabó todo...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, excelente trabajo. Lo hiciste muy bien. Y tampoco había nada en los\ndocumentos que nos pudiera poner en desventaja.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003234",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las personas solo creen en aquello en lo que quieren creer. Reika es un ejemplo\nextremista de ello, pero a final de cuentas, todos somos así.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003235",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Después de bajar la mirada como si estuviera pensando en algo, Toritani la\nlevantó de repente. Me ve, y luego sonrió un poco.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0029",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003236",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Creo que no hice las cosas tan mal esta noche. O por lo menos, no le causé\nmolestias a nadie, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tan mal? Eso es poco...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Toritani respondió con honestidad y convicción. Incluso ante una mujer de la\ncalaña de Reika.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Seguramente Toritani diría esto.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"'Nada de esto fue por querer evitar dejar en ridículo a Reika'.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Si me tomé el trabajo de preparar todos estos jarrones y explicar todo de cabo\na rabo, fue por mí. Por nadie más'... Seguramente eso diría.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hoy me mostraste la belleza que hay en la esencia de Makoto Toritani. Eso es\nbastante ganancia para mí.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0010",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003237",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... y vienes a decir eso ahora con esa cara tan seria...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Toritani se encogió ligeramente de hombros después de mostrarse un tanto\nexasperada.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003238",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque bueno, lo tomaré como un cumplido.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hazlo. O me moriré de la pena.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0001",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003239",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo haré...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0011h",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003240",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De lo contrario, moriré yo también de la vergüenza.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_picapica_09_1"},
{"text"},
linkback="block_00114",
},
label = {
top={block="block_00000",label=1},
},
}
