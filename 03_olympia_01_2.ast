linknext="block_00302",
},
block_00302={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0011",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
