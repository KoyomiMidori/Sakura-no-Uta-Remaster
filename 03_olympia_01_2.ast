linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso es que tenemos que irnos ya.”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
