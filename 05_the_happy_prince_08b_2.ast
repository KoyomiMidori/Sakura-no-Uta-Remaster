astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"msgoff"},
{"bg",file="znightsky_winter",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001457",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ejejeje... a dormir juntos.”",
{"rt2"},
},
},
},
labelcount=2,
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_aid_001458",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ven, Naoya, acercate un poco más...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Ai jaló de mis mangas.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Siento sus pequeñas manos.Sin poder aguantar más, me monté sobre ella.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai--”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Y nos volvemos a besar.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_aid_001459",ch="aid"},
},
ja={
{
name={"Ai"},
"“Mmm... *chu*, *chu*... *chrrr*... ah... *shrrr*...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Nuestras lenguas bailan juntas violentamente.\nCalientes, tiernas.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_aid_001460",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pwaah... Jaa, jaa, jaa... Jaaa...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai... ¿No te importa?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="fem_aid_001461",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jeje, no hace falta que me pidas permiso para eso.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_aid_001462",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aunque a juzgar por lo que veo, más que pedir permiso, quieres saber qué\ntienes que hacer, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="fem_aid_001463",ch="aid"},
},
ja={
{
name={"Ai"},
"“No siempre el hombre tiene que llevar la delantera...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ugh...",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Ai metio su mano entre mi camisa, tocando directamente mi piel.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_aid_001464",ch="aid"},
},
ja={
{
name={"Ai"},
"Wah... i-increíble... Tu cuerpo es realmente musculoso...",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"P-Pues sí...",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="fem_aid_001465",ch="aid"},
},
ja={
{
name={"Ai"},
"Ya veo. La verdad es que pensaba en hacerte pasar un buen rato, pero a juzgar\npor esta sensación, seré yo la que disfrutará más.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿D-De qué estás hablando?",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_aid_001466",ch="aid"},
},
ja={
{
name={"Ai"},
"Eres guapo, Naoya.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Eh?",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="fem_aid_001467",ch="aid"},
},
ja={
{
name={"Ai"},
"Eres apuesto de cara, y musculoso... Y tienes una personalidad masculina...\nComo tu hermana... me alegra, saber que te transformaste en semejante hombre.\nAdemás...",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Ai extiende su mano hacia mis partes privadas.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"Ugh...",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_aid_001468",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Eh?",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Q-Qué?... ¿Por qué la vocecilla rara después de tocarme allí abajo?...",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_aid_001469",ch="aid"},
},
ja={
{
name={"Ai"},
"Ah, es que... pensé, en decir... que habías crecido acá también, pero...\nrealmente, es mucho más grande de lo que pensaba... M-Me sorprendí...",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Y-Y qué quieres que haga? Ugh...",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Ai me acaricia por encima del pantalón.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_aid_001470",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Qué tal? ¿Así se hace?",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ah, pues... sí, pero...",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_aid_001471",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Pero?",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"Es algo, desesperante... Kuh.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_aid_001472",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Te desespera que lo haga sobre el pantalón?",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"Esto...",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Mientras me trababa en mi respuesta, Ai llevó su mano sobre mi cremallera.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_aid_001473",ch="aid"},
},
ja={
{
name={"Ai"},
"Bueno... ehm... la cremallera...Hmmm, ¿cómo funciona esto? ¿Uhm? A ver...",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_aid_001474",ch="aid"},
},
ja={
{
name={"Ai"},
"Ey, ¡no lo sé!",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"cgdel",id=-1},
{"bg",file="ev_aix_h01_01",path=":ev/ev_aix_h01/",set="ev_aix_h01"},
{"text"},
text={
ja={
{
"Ai retira el futon y se queda con la mirada fija sobre mis partes íntimas.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"---",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Mi pantalón está hecho una tienda de campaña.Es realmente vergonzoso que se me\nqueden viendo en este estado.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_aid_001475",ch="aid"},
},
ja={
{
name={"Ai"},
"I-Impresionante... Quiero decir, eh...¡Ey!",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Ai lo deja todo a la suerte y pone su mano sobre la cremallera.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Probablemente no se le ocurrió nada que decir.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"se",file="se9010",id=1},
{"bg",file="ev_aix_h01_02",path=":ev/ev_aix_h01/",set="ev_aix_h01"},
{"text"},
text={
ja={
{
"Al bajar la cremallera, una tienda de campaña aún más grande se produce de mis\ncalzoncillos.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_aid_001476",ch="aid"},
},
ja={
{
name={"Ai"},
"Ajajaja... veo, que usas bóxers.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, uso bóxers... Digo, son cómodos, y... ehm... ugh...",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"se",file="se9010",vol=50,id=1},
{"bg",file="ev_aix_h01_03",path=":ev/ev_aix_h01/",set="ev_aix_h01"},
{"text"},
text={
ja={
{
"Ai me acaricia cariñosamente por encima de mis calzoncillos.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_aid_001477",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Qué tal? ¿Se siente mejor que con el pantalón?",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"S-Sí... Siento más tu mano ahora... kuh.Aunque, todavía siento la tela de por\nmedio...",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"Creo yo, quizá, que todavía... podemos dejarlo todo en una simple broma...",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_aid_001478",ch="aid"},
},
ja={
{
name={"Ai"},
"Ya veo... sí, todavía podríamos dejarlo todo, en una broma...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí... así es.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_aid_001479",ch="aid"},
},
ja={
{
name={"Ai"},
"Idiota... ¿De verdad crees eso? Un beso a los labios es lo mismo que un beso\nacá.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Eh?",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"se",file="se_zubon_out_long",id=1,vol=50},
{"text"},
text={
ja={
{
"Apenas dijo eso Ai bajó mi ropa interior.Sin obstáculo alguno, mi miembro salió\ndisparado.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"se",stop=1,id=1,time=500},
{"se",file="se9010",id=2,vol=70},
{"bg",file="ev_aix_h01_04",path=":ev/ev_aix_h01/",set="ev_aix_h01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001480",ch="aid"},
},
ja={
{
name={"Ai"},
"Ah...",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Ai se queda con los ojos fijos en mi miembro.O más bien pareciera estar\nparalizada.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Sí, es lo más obvio de hacer teniendo semejante cosa repentinamente frente a la\ncara...",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_aid_001481",ch="aid"},
},
ja={
{
name={"Ai"},
"--～",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"bg",file="ev_aix_h01_05",sync=0,face=1,time=400,path=":ev/ev_aix_h01/",set="ev_aix_h01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001482",ch="aid"},
},
ja={
{
name={"Ai"},
"*chu*...",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"Kuh...",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bg",file="ev_aix_h01_04",sync=0,face=1,time=400,path=":ev/ev_aix_h01/",set="ev_aix_h01"},
{"text"},
text={
ja={
{
"Una indescriptible sensación llega a mis partes inferiores.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Acabo de... sentir algo cálido y tierno sobre mi miembro.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Así pareció, y así se sintió...",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Eso quiere decir que... ¿Ai, besó mi miembro?",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_aid_001483",ch="aid"},
},
ja={
{
name={"Ai"},
"Te besé acá... Ya, no hay manera de dejarlo como una broma.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"S-Sí...",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
delay={
vl01={
{"bg",file="ev_aix_h01_05",sync=0,face=1,time=400,path=":ev/ev_aix_h01/",set="ev_aix_h01"},
},
},
text={
vo={
{"vo",file="fem_aid_001484",ch="aid"},
},
ja={
{
name={"Ai"},
"Así que, no te preocupes más... Solo, déjate, *chu*... *chu*, *chu*...",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Ai siguió besando mi miembro.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_aid_001485",ch="aid"},
},
ja={
{
name={"Ai"},
"Mm... *chu*... *chu*, *chu*...",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"Kuh, ah, ahhh...",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_aid_001486",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Se siente bien, Naoya? De ser así...",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bg",file="ev_aix_h01_06",sync=0,face=1,time=400,path=":ev/ev_aix_h01/",set="ev_aix_h01"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡¿--?!",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Una cálida sensación envuelve mis zonas inferiores.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Uwaaah!",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_aid_001487",ch="aid"},
},
ja={
{
name={"Ai"},
"*rero*... ngghh... *chu*, *chu*, *chu*... *rero*... *chu*, *chu*...\n*rerurero*... *shpp*...",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"A-Ai...",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_aid_001488",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Qué tal está? *rero*... *rerarero*... *chu*... ¿Se siente, bien, Naoya?...\n*rerorera*...",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"S-Sí... m-muy, bieeen... Kwah.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"N-No puedo... Se siente, demasiado bien...",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_aid_001489",ch="aid"},
},
ja={
{
name={"Ai"},
"Me alegra saberlo... Déjate llevar por el placer... No pienses en nada...\n*chu*, *shrrr*... *chu*.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"B-Bueno...",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Ai abre grandemente su boca y se traga mi miembro.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"bg",file="ev_aix_h01_07",sync=0,face=1,time=400,path=":ev/ev_aix_h01/",set="ev_aix_h01"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"～～～～～～～～～～～～",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_aid_001490",ch="aid"},
},
ja={
{
name={"Ai"},
"*shpp*... *shpp*... *shpp*, *shpp*... *chu*, *schmuch*... *chup*... *chup*...",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Ai está tragándose mi miembro.No lo puedo creer. La misma Ai que he venido\nconociendo, está...",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"El exceso de placer y lo poco real que se percibía esto me hizo sentir como si\nmi cabeza estuviera aturdida...",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_aid_001491",ch="aid"},
},
ja={
{
name={"Ai"},
"Mm... ngh... *rero*... Naoya... ¿Cómo está? *chup*... *shpp*... *shpp*...\n*chu[, *chu*, *chu*... Se siente más cálido, que hasta ahora, ¿verdad?\n*kuchuu*... *chup*... *chup*...",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ah, i-increíble... Se siente, bien... pero... tan bien, que... y-ya... me,\nvengo...",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"D-Deberías, apartar tu boca... de lo contrario...",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_aid_001492",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Ya... te vienes? *chu*... *chup*... *rerorero*... *chup*, *chup*...\n*rerorero*...",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Aún a pesar de lo que dije, Ai no dejó de mover su lengua.Más bien comenzó a\nmoverla con más ímpetu.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"N-No... Ai, si sigues... si, sigues haciendo eso... me iré, en tu boca...",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_aid_001493",ch="aid"},
},
ja={
{
name={"Ai"},
"Está bien... No te preocupes, por eso... Naoya... *chu*, *chup*...\n*rerorero*... *rerurero*... *chup*...",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"A-Ah, n-no, puedo más. A-Ai, ya me vengo--",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bg",id=9,lv=9,sync=1,time=500,file="white",path=":bg/"},
{"bg",id=9,lv=9,sync=1,time=500,alpha=0,file="white",path=":bg/"},
{"bg",id=9,lv=9,sync=1,time=1000,alpha=255,file="white",path=":bg/"},
{"cgdel",id=9,lv=9},
{"bg",file="ev_aix_h01_08",sync=1,time=1000,vague=100,path=":ev/ev_aix_h01/",set="ev_aix_h01"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"---",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"La parte inferior de mi cuerpo tiembla fuertemente.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Y con el temblor, el placer alcanzaba su punto máximo.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Sin poder aguantar más, llegué a mi clímax...",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_aid_001494",ch="aid"},
},
ja={
{
name={"Ai"},
"Nmm... kuh... *koku*... *kokukoku*... ngh.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"Uh, uhh... uh... Jaa, jaa, jaa... ¡¿A-Ai?!",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"se",file="se9010",vol=70,id=1},
{"bg",file="ev_aix_h01_09",path=":ev/ev_aix_h01/",set="ev_aix_h01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001495",ch="aid"},
},
ja={
{
name={"Ai"},
"De todas las revistas y libros que he leído... pensé que sabría a algo, pero...\nes difícil degustarlo estando tan concentrada...",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿T-Te lo tragaste?",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_aid_001496",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí... eso, hice. Aunque, no importa. Se sintió bien, ¿verdad?",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, pero...",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_aid_001497",ch="aid"},
},
ja={
{
name={"Ai"},
"Así está bien entonces.¿Y? ¿Acabamos ya?",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"N-No. Quiero...",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"Quiero verte, desnuda...",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_aid_001498",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Quieres verme desnuda?... Eso parece algo que diría un niño...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"E-Es que...",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Sí, habían mejores palabras para eso, como 'seguir hasta el final', o algo\nasí.Pero no se me ocurrió más nada.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_aid_001499",ch="aid"},
},
ja={
{
name={"Ai"},
"Está bien. Ah, pero hay algo que quiero pedirte.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",file="se9010",id=1,vol=70},
{"text"},
text={
ja={
{
"Al decir eso, Ai se tumbó de nuevo sobre el futon.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_aid_001500",ch="aid"},
},
ja={
{
name={"Ai"},
"Desnúdame tú... Así podré sentirme más tranquila.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"B-Bueno...",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"bg",file="ev_aix_h02_01",path=":ev/ev_aix_h02/",set="ev_aix_h02"},
{"text"},
text={
ja={
{
"Ai está acostada frente a mí.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Esa misma Ai con quien tanto tiempo he compartido.La Ai que he tratado como a\nuna hermana...",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Pongo mis manos sobre su falda.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Y la levanto.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"se",file="se0897s",vol=50,id=1},
{"bg",file="ev_aix_h02_02",path=":ev/ev_aix_h02/",set="ev_aix_h02"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"--",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Exponiendo su ropa interior.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_aid_001501",ch="aid"},
},
ja={
{
name={"Ai"},
"O-Oye... Naoya... ¿P-Puedo decirte algo?",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Eh? ¿Qué pasa?",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_aid_001502",ch="aid"},
},
ja={
{
name={"Ai"},
"Quiero decir... ehm... Quieres desnudarme, ¿verdad?",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"S-Sí... claro...",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_aid_001503",ch="aid"},
},
ja={
{
name={"Ai"},
"D-De ser así, no hacía falta que levantaras mi falda, ¿no?No podrás quitármela\nasí.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ah, c-claro... Ahora que lo mencionas...",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_aid_001504",ch="aid"},
},
ja={
{
name={"Ai"},
"C-Cuando me levantas la falda... siento, como si estuvieras jugándome una\nbroma... Se siente, extraño... A-Aunque bueno, si eso quieres hacer, no\nimporta...",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"excall",label="flagon",cond="f.aix==1"},
{"excall",label="flagoff",cond="f.aix==0"},
{"text"},
text={
ja={
{
name={"Naoya"},
"No... No es que quería hacer esto como tal... Aunque ahora que recuerdo, ya\nhabía visto anteriormente lo que esta falda oculta.",
{"rt2"},
},
},
},
labelcount=3,
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_aid_001505",ch="aid"},
},
ja={
{
name={"Ai"},
"E-Eso es... porque... no querías salir...",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"Porque me empujaste la cabeza allí adentro...",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_aid_001506",ch="aid"},
},
ja={
{
name={"Ai"},
"Lo sé, pero... Ehm... En fin, ¿podrías dejar de levantarla?",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ah, bueno...",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Pongo mis ojos de nuevo sobre la ropa interior de Ai.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Pantis blancos. Se sienten menos infantiles que la vez pasada.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Pero aun viendo esto, todavía no puedo creer lo que sucede.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"excall",label="join"},
{"text"},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"No... No es que quería hacer esto como tal...",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Pongo mis ojos de nuevo sobre la ropa interior de Ai.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Pantis blancos.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Aun viendo esto, todavía no puedo creer lo que sucede.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"excall",label="join"},
{"text"},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_aid_001507",ch="aid"},
},
ja={
{
name={"Ai"},
"O-Oye... Naoya...",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Ah, no es nada, lo siento!",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Regreso la falda de Ai a su posición normal.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"se",file="se0897s",vol=50,id=1},
{"bg",file="ev_aix_h02_01",path=":ev/ev_aix_h02/",set="ev_aix_h02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"Eh... Cómo, puedo sacar esta falda...",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_aid_001508",ch="aid"},
},
ja={
{
name={"Ai"},
"Hay una cremallera al lado. Si la bajas podrás quitar la falda fácilmente.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"Y-Ya veo...",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Pongo mi mano sobre la cremallera de la falda.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Es una cremallera pequeña, que raramente se ve en la ropa de hombre.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"se",file="se9010",vol=100,id=1},
{"text"},
text={
ja={
{
"Al bajarla, la falda se aflojó.Ai procedió a levantar su cadera, a lo que\nfinalmente pude quitarle la falda.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"se",file="se0897s",vol=50,id=1},
{"bg",file="ev_aix_h02_03",path=":ev/ev_aix_h02/",set="ev_aix_h02"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001509",ch="aid"},
},
ja={
{
name={"Ai"},
"Veo que te cuesta lidiar incluso con faldas.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"Es que no hay ninguna ropa de hombre que tenga una cremallera a los lados.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_aid_001510",ch="aid"},
},
ja={
{
name={"Ai"},
"A este ritmo, creo que te costará quitarme el sujetador también...",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"No hay problema con el sujetador. Es como un gancho, ¿no? Lo he leído en\nmangas, creo que sé cómo hacerlo.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_aid_001511",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Sí? Pero ya lo desenganché.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Eh? ¿En serio? Pero en ningún momento pareciste hacerlo.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_aid_001512",ch="aid"},
},
ja={
{
name={"Ai"},
"Porque estoy acostumbrada a hacerlo. ¿Querías hacerlo tú mismo? Si es así me lo\npondré de nuevo.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ah, no, está bien... Más bien me has ayudado.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_aid_001513",ch="aid"},
},
ja={
{
name={"Ai"},
"Ya veo. Bueno, ¿podrías ahora...desabotonar mi camisa?",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"S-Sí...",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"El temblor de mis manos no me dejaba hacerlo bien, pero de alguna manera logré\ndesabotonar su camisa. Botón por botón.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"se",file="se9010",id=1},
{"bg",file="ev_aix_h02_04",path=":ev/ev_aix_h02/",set="ev_aix_h02"},
{"text"},
text={
ja={
{
"Una vez abrí todos los botones, pude ver el sujetador que llevaba adentro.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_aid_001514",ch="aid"},
},
ja={
{
name={"Ai"},
"Qué bueno, son el mismo conjunto.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Eh? ¿Has llegado a llevar conjuntos distintos?",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_aid_001515",ch="aid"},
},
ja={
{
name={"Ai"},
"Ah, no, por lo general es siempre el mismo... Solo que, no pensé que terminaría\nhaciendo esto... y había olvidado qué ropa interior llevaba encima.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿En serio?... Aunque, ahora que lo dices, creo que yo tampoco recuerdo bien qué\ncalzoncillo me pongo siempre en las mañanas.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_aid_001516",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí, aunque es un conjunto que me gusta...Me da pena mostrártelo por primera\nvez, pero qué bueno que fue uno de mi agrado.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"Entiendo...",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_aid_001517",ch="aid"},
},
ja={
{
name={"Ai"},
"Tengo que pasar la camisa y el sostén por mis brazos para quitármelos, ¿me das\nun momento?",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ah, sí...",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"se",file="se2016",vol=50,id=1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Al decir eso, Ai, todavía tumbada en la cama, se quitó su camisa y su sujetador\ncon bastante facilidad.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"se",stop=1,time=500,id=1},
{"bg",file="ev_aix_h02_05",path=":ev/ev_aix_h02/",set="ev_aix_h02"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001518",ch="aid"},
},
ja={
{
name={"Ai"},
"Creo que ya lo sabes, pero... mis pechos son pequeños...",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, bueno, me lo imagino...",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_aid_001519",ch="aid"},
},
ja={
{
name={"Ai"},
"Sé que has visto muchos cuerpos femeninos... Tengo bastante pena ahora...",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Muchos cuerpos femeninos? Estás hablando de pintar desnudos, ¿no? No es lo\nmismo a una pintura convencional.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_aid_001520",ch="aid"},
},
ja={
{
name={"Ai"},
"Pero... ¿Las modelos que se prestan para eso, tienen buenas proporciones,\nverdad?",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"No realmente. Hay toda una variedad de cuerpos entre los modelos. Más bien es\nraro encontrar un cuerpo esbelto y equilibrado como el tuyo.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_aid_001521",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Te parece? Bueno, supongo que será también consideración de tu parte...",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Puedo apartar tus manos?",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_aid_001522",ch="aid"},
},
ja={
{
name={"Ai"},
"S-Sí...",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Tomé las manos de Ai que cubrían sus pechos y las dejé delicadamente sobre el\nfuton.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"bg",file="ev_aix_h02_06",sync=0,face=1,time=400,path=":ev/ev_aix_h02/",set="ev_aix_h02"},
{"text"},
text={
ja={
{
"Sus pechos eran pequeños, sí, pero tenían buena forma.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"En particular, la punta de sus pechos estaba algo rosada, como si se tratase de\nuna pintura clásica.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"bg",file="ev_aix_h02_07",sync=0,face=1,time=400,path=":ev/ev_aix_h02/",set="ev_aix_h02"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_001523",ch="aid"},
},
ja={
{
name={"Ai"},
"Ngh... ¡Kuh...!",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Toqué ligeramente los pechos de Ai.A lo cual sus hombros temblaron fuertemente.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Te dolió?",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_aid_001524",ch="aid"},
},
ja={
{
name={"Ai"},
"Ah, no, no duele para nada... Solo que, nadie jamás había tocado mis pechos\nantes, y... me estremecí un poco...",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya veo... ¿Debería acariciarlos lentamente entonces?",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_aid_001525",ch="aid"},
},
ja={
{
name={"Ai"},
"N-No deberías pedirme permiso una y otra vez, para eso... digo yo.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"Bueno...",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Tomo los pequeños pechos de Ai en mis manos.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_aid_001526",ch="aid"},
},
ja={
{
name={"Ai"},
"Kuh... ¡¿Kuuhn...?! Ah, ngh... fuh, fuh... ahnn.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Su respiración se agita un poco.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"Qué suaves...",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_aid_001527",ch="aid"},
},
ja={
{
name={"Ai"},
"S-Sí... Son pequeños, pero suaves, ¿verdad? Kuhhn, auh, ngh, mmm... ah, ngh,\nah... ¡¡Ngh...!!",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Paso mis labios por la zona colorada en la punta de su pecho.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_aid_001528",ch="aid"},
},
ja={
{
name={"Ai"},
"¡Nguh, ahaah...!",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"bg",file="ev_aix_h02_08",sync=0,face=1,time=400,path=":ev/ev_aix_h02/",set="ev_aix_h02"},
{"text"},
text={
ja={
{
"Los hombros de Ai se contraen con más fuerza que hace un rato.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"Muevo alrededor esa pequeña y rosada protuberancia con mi boca.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_aid_001529",ch="aid"},
},
ja={
{
name={"Ai"},
"Kuh... Na, Naoya... Me da, cosquillas... con la, boca... Auh... ngh... ahnnn.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿No te gusta?",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_aid_001530",ch="aid"},
},
ja={
{
name={"Ai"},
"No es que no me guste... pero... kuh... se siente, algo raro... es como...\nhauh... Uhmmm...",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"De tanto jugar con el pequeño bulto, este comenzó a endurecerse poco a poco.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"La puntita... está dura, y erecta...",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_aid_001531",ch="aid"},
},
ja={
{
name={"Ai"},
"S-Sí... Creo que... es que estoy disfrutándolo... creo... kuh.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"La respiración de Ai se entrecorta.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"bg",file="ev_aix_h02_09",sync=0,face=1,time=400,path=":ev/ev_aix_h02/",set="ev_aix_h02"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001532",ch="aid"},
},
ja={
{
name={"Ai"},
"Fwah... auh... ah, ahn, Jaa, jaa... ahh... ngh... auh... ¡¡Jaa, jaa, fwah,\naAaah!!",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"se",file="se9010",vol=80,id=1},
{"text"},
text={
ja={
{
"Ai hunde sus manos fuertemente en las sábanas.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Estaba dejándose llevar poco a poco por el placer.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Con mi lengua todavía deslizándose por su pecho, llevé mi mano hacia sus partes\ninferiores.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_aid_001533",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Eh? N--",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"quake",size=5,mode="mw"},
{"bg",file="ev_aix_h02_10",sync=0,face=1,time=400,path=":ev/ev_aix_h02/",set="ev_aix_h02"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001534",ch="aid"},
},
ja={
{
name={"Ai"},
"¡¿Hyauun?!",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Mis dedos tocaron sus partes más íntimas.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Y en ese preciso instante, Ai dobló fuertemente su espalda.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Sentí algo caliente en la punta de mis dedos.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"Está... mojado.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"La zona de la entrepierna de su ropa interior estaba cada vez más mojada.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Sigo tocando el centro de la zona mojada con mis dedos, buscando relajarla.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_aid_001535",ch="aid"},
},
ja={
{
name={"Ai"},
"A-Auh... N-Naoya... Hiin... a-auh... no, ahí, n-- Nguuhhh.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Te duele?",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Ai mueve su cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
vo={
{"vo",file="fem_aid_001536",ch="aid"},
},
ja={
{
name={"Ai"},
"No duele, pero... auh... c-cuando me... tocas ahí... es tan fuerte, el\nplacer... q-que yo... no sé, qué hacer... kuuhn.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Ai mueve sus caderas, retorciéndose del placer.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Sigo masajeando suavemente, rozando la zona de la entrepierna.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_aid_001537",ch="aid"},
},
ja={
{
name={"Ai"},
"Ngwaah, n-no... E-En serio... A-Ahn, Jaaa... kuhn... s-se siente, muy bien...\nkufuh.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Y en concordancia con las palabras de Ai, sus pantis fueron mojándose cada vez\nmás, hasta el punto en que con solo tocar un poco un viscoso líquido se\nadhería a mi dedo...",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Puedo quitártelo?",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="fem_aid_001538",ch="aid"},
},
ja={
{
name={"Ai"},
"Ah, sí...",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Al poner mis manos sobre sus pantis, Ai elevó un poco sus caderas.Al bajárselos\nhasta la rodilla, Ai me hizo el favor de quitárselos ella misma.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"se",file="se9010",vol=80,id=1},
{"bg",file="ev_aix_h02_11",path=":ev/ev_aix_h02/",set="ev_aix_h02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"No pensé que pudiera mojarse tanto esta parte...",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="fem_aid_001539",ch="aid"},
},
ja={
{
name={"Ai"},
"Jaa, jaa, jaa... Sí... Yo tampoco, he quedado asombrada.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_aid_001540",ch="aid"},
},
ja={
{
name={"Ai"},
"Pero, tú tocándome... Era natural que terminara así.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ai...",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Abro un poco las piernas de Ai y meto mi mano entre ellas.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"Apenas mis dedos tocaron su zona íntima, se escuchó algo así como 'chu'.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"Deslizo mi dedo sobre sus delicadas partes.Bañada en fluidos vaginales, era una\nsensación resbalosa.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_aid_001541",ch="aid"},
},
ja={
{
name={"Ai"},
"Kuuhn... Jaa, jaa, ah, ahh... Nkuh.. Jaa, jaa, N-Naoya, si sigues... Kuuhhn.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Si sigo, qué?",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_aid_001542",ch="aid"},
},
ja={
{
name={"Ai"},
"E-Estoy... por venirme... Kwah, kuhn... Jaa, jaa, si sigueees...",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya veo... Pues entonces...",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Sigo moviendo mis dedos.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"bg",file="ev_aix_h02_12",sync=0,face=1,time=400,path=":ev/ev_aix_h02/",set="ev_aix_h02"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001543",ch="aid"},
},
ja={
{
name={"Ai"},
"Ah, kyah... espera... par--, ngh... ahh, no, no, N-Naoyaaa... ¡¡Kuhhhhhh!!",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Fluidos vaginales son disparados de su vagina a la vez que suelta indecentes\ngemidos.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="fem_aid_001544",ch="aid"},
},
ja={
{
name={"Ai"},
"Kwyaah... n-no, no... P-Para, no... A-Ah, si sigues haciendo esooo... me,\nvendréee.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"El cuerpo de Ai tiembla y se retuerce, mientras esta jadea.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
vo={
{"vo",file="fem_aid_001545",ch="aid"},
},
ja={
{
name={"Ai"},
"A-Ahnn... nooo... ya, nooo, ahhh, ahaah... no... se... se siente... tan\nbieeen... ¡¡Higuh!!",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"Y en el instante en que jalé de su clítoris, el cuerpo de Ai se dobló como un\narco.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001546",ch="aid"},
},
ja={
{
name={"Ai"},
"Guh... Nghhh... ¡¡Ahhh~~~~~~~~~!!",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
"Su esbelta cadera se eleva en un salto y comienza a temblar.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001547",ch="aid"},
},
ja={
{
name={"Ai"},
"No, no puedo más, Naoya, me vengo... me vengo, vengo... ¡Me vengo! Ah~~, ah~~,\nno, ¡¡me vengo!!",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
vo={
{"vo",file="fem_aid_001548",ch="aid"},
},
ja={
{
name={"Ai"},
"Ngh... ¡¡Nnnnnnnnnnnngh!!",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"bg",id=9,lv=9,sync=1,time=1000,file="white",path=":bg/"},
{"cgdel",id=9,lv=9},
{"bg",file="ev_aix_h02_13",sync=1,time=1000,vague=100,path=":ev/ev_aix_h02/",set="ev_aix_h02"},
{"text"},
text={
ja={
{
"Con sus caderas al aire, Ai se retorció una y otra vez.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="fem_aid_001549",ch="aid"},
},
ja={
{
name={"Ai"},
"Kufuh... Haahh... Haaaaaah, kuh... Jaa, jaa, jaa... Me vine... Naoya... Me\nvine...",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí. No pensé que podría hacerte correr con mi mano.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="fem_aid_001550",ch="aid"},
},
ja={
{
name={"Ai"},
"Jaa, jaa... Qué falta de delicadeza, en esas palabras... Aunque, fue genial...\nPensé, que me, desmayaría.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Sí?... Qué bueno.",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"Ai va recuperando poco a poco la respiración, tan agitada hace pocos momentos.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="fem_aid_001551",ch="aid"},
},
ja={
{
name={"Ai"},
"Jaa, jaa... fuh... ¿Por qué pareces estar tan orgulloso de lo que hiciste?\nCielos...",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
name={"Naoya"},
"No, bueno, es que ha sido mi primera vez. Estoy algo alegre.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
vo={
{"vo",file="fem_aid_001552",ch="aid"},
},
ja={
{
name={"Ai"},
"Cielo santo, era normal que terminara así... De solo pensar que estabas\ntocándome de esa forma...",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ai... ¿Puedo... meterlo, ya?",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
vo={
{"vo",file="fem_aid_001553",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Que si puedes? Ya me vine una vez. Si sigues tocándome no sucederá nada bueno.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Si?... Bueno... entonces...",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
vo={
{"vo",file="fem_aid_001554",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí...",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="fem_aid_001555",ch="aid"},
},
ja={
{
name={"Ai"},
"Pero, antes de eso... ¿Podrías quitarte la ropa tú también?",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
vo={
{"vo",file="fem_aid_001556",ch="aid"},
},
ja={
{
name={"Ai"},
"De lo contrario no podre sentir tu calor...",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
name={"Naoya"},
"Está bien...",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",file="se0897s",id=1},
{"text"},
text={
ja={
{
"Me quito toda la ropa.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
"Luego, abro las piernas de Ai y hundo mis caderas entre ellas.",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"bg",file="ev_aix_h03_01",path=":ev/ev_aix_h03/",set="ev_aix_h03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001557",ch="aid"},
},
ja={
{
name={"Ai"},
"...... Ngh.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"Kuh...",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"Busco dónde entrar, pero no sé dónde debería ingresar.Al poner presión sobre la\nzona que creí que era, mi miembro termina deslizándose fuera.",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
name={"Naoya"},
"... Eh, esto.",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
vo={
{"vo",file="fem_aid_001558",ch="aid"},
},
ja={
{
name={"Ai"},
"... Creo, que es un poquito más abajo... A-Acá... kuh.",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
"Con la mirada apartada vergonzosamente,Ai guió mi miembro con sus dedos.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"Empujo con la punta la zona que Ai me indicó.Al hacerlo... fue hundiéndose\nadentro, lentamente.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"bg",file="ev_aix_h03_02",sync=0,face=1,time=400,path=":ev/ev_aix_h03/",set="ev_aix_h03"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001559",ch="aid"},
},
ja={
{
name={"Ai"},
"Hyaaaiihh... Ah... ahnnn... ¡¡¿---?!!",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
"Ai suelta un doloroso gemido.",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"Siento algo cerrándose, o más bien presionando.La presión para ella debe ser\nterriblemente fuerte...",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"Jaa, jaa... Jaa, jaa...",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
vo={
{"vo",file="fem_aid_001560",ch="aid"},
},
ja={
{
name={"Ai"},
"¿E-Entró...?",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
name={"Naoya"},
"... Sí, aunque solo la punta... Pero entró.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
vo={
{"vo",file="fem_aid_001561",ch="aid"},
},
ja={
{
name={"Ai"},
"Ya veo... Tendré que aguantar... un poco más, entonces.",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Quieres que lo saque?",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
vo={
{"vo",file="fem_aid_001562",ch="aid"},
},
ja={
{
name={"Ai"},
"¿Pero qué estás diciendo? Estoy bien.Además, no duele tanto... sí.",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
name={"Naoya"},
"Bueno... Entonces... ¿Podrías relajarte un poco?",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
vo={
{"vo",file="fem_aid_001563",ch="aid"},
},
ja={
{
name={"Ai"},
"Está... bien.",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001564",ch="aid"},
},
ja={
{
name={"Ai"},
"Nkyaahh... Ngh, ¡¡¿A-AhAahh...?!!",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
"Mi verga entra poco a poco en ella.Los dolorosos gemidos de Ai van haciéndose\nmás fuertes.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"La sensación de constricción no ha cambiado. Probablemente esta misma presión\nes lo que le causa el dolor a ella.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
vo={
{"vo",file="fem_aid_001565",ch="aid"},
},
ja={
{
name={"Ai"},
"Se me escaparon un poco los gemidos... pero estoy bien... Te lo ruego... no te\npreocupes por mí, y hazlo hasta el final...",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
name={"Naoya"},
"Está bien.",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001566",ch="aid"},
},
ja={
{
name={"Ai"},
"¡¿Hyuuuh?!",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
"Pongo más de mi peso sobre ella, hasta que finalmente mi miembro llega, junto\ncon una viscosa sensación, hasta donde podía llegar.",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"bg",file="ev_aix_h03_03",sync=0,face=1,time=400,path=":ev/ev_aix_h03/",set="ev_aix_h03"},
{"text"},
text={
ja={
{
name={"Naoya"},
"Entró... todo.",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
vo={
{"vo",file="fem_aid_001567",ch="aid"},
},
ja={
{
name={"Ai"},
"Jaa, jaa, Jaa, ¿de verdad? Ya, veo... Sí, qué bueno...",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"se",file="se9010",vol=80,id=1},
{"text"},
text={
ja={
{
"Ai me abraza.",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Ai?",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
vo={
{"vo",file="fem_aid_001568",ch="aid"},
},
ja={
{
name={"Ai"},
"Por fin nos unimos en cuerpo... Se siente, algo raro.",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
name={"Naoya"},
"Lo mismo siento yo.",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
vo={
{"vo",file="fem_aid_001569",ch="aid"},
},
ja={
{
name={"Ai"},
"Quién diría que acabaríamos haciendo el amor...",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí...",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
ja={
{
"Todavía aferrada a mí, Ai acaricia mi cabeza como lo hace siempre.",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
name={"Naoya"},
"... Ai... ¿puedo, moverme?",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
vo={
{"vo",file="fem_aid_001570",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí, claro...",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
name={"Naoya"},
"Bueno, aquí voy...",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
vo={
{"vo",file="fem_aid_001571",ch="aid"},
},
ja={
{
name={"Ai"},
"S-Sí...",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
"Lenta y cuidadosamente... muevo mis caderas.",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
"Ya no está la fuerte sensación de presión de hace un momento.¿Será que su\nvagina se adaptó con tan solo dejar mi miembro adentro un rato?",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
vo={
{"vo",file="fem_aid_001572",ch="aid"},
},
ja={
{
name={"Ai"},
"Kuh... ngh, ngh, muh, kuh... ?!",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
name={"Naoya"},
"Kuh... Ai... tu cuerpo, se siente muy bien...",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"bg",file="ev_aix_h03_04",sync=0,face=1,time=400,path=":ev/ev_aix_h03/",set="ev_aix_h03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001573",ch="aid"},
},
ja={
{
name={"Ai"},
"S-Sí... Yo también... te siento, dentro de mí... Y además, ya no duele casi...\nNgh, kuh.",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
"Sus palabras estaban algo entrecortadas, pero el tono de su voz no parecía ser\nsolo de dolor.",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Sí? ¿Crees que pueda moverme un poco más?",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
vo={
{"vo",file="fem_aid_001574",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí, no hay problema... Muéve... te... Kufuh... Estoy, bien... No duele... al\ncontrario... fuhn, ah, ah...",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"text"},
text={
ja={
{
"Un húmedo sonido se escucha venir de la zona de unión entre nuestros genitales.",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
ja={
{
"El sonido se intensifica al acelerar el movimiento de mis caderas, al igual que\nlos dulces gemidos de Ai.",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
ja={
{
"Acelero un poco más mis caderas.",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"bg",file="ev_aix_h03_05",sync=0,face=1,time=400,path=":ev/ev_aix_h03/",set="ev_aix_h03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001575",ch="aid"},
},
ja={
{
name={"Ai"},
"A-Auh... ngh, ah, ah... fuhn... ngh... ah, increíble, Naoya... Ahora, se siente\nbien... kuh.",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
ja={
{
"La magnitud de los sonidos viscosos se acentúa.El apretado interior de Ai\nestaba ahora más holgado.",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"text"},
text={
ja={
{
"Ya se fue la sensación de presión de hace un rato.Creo que ya puedo moverme un\npoco más.",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
"Aceleré aún más mis movimientos.",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"bg",file="ev_aix_h03_06",sync=0,face=1,time=400,path=":ev/ev_aix_h03/",set="ev_aix_h03"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001576",ch="aid"},
},
ja={
{
name={"Ai"},
"¡¿Hyuh?! Hiih, ah, ahh, ahn... ¡Tan, rápido, de... repente, iiihhh!",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
ja={
{
"El tono de Ai es distinto al que había tenido hasta ahora.Dolor... no parece\nser.",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
ja={
{
name={"Naoya"},
"Avísame si llega a dolerte... Jaa, jaa.",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"bg",file="ev_aix_h03_07",sync=0,face=1,time=400,path=":ev/ev_aix_h03/",set="ev_aix_h03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001577",ch="aid"},
},
ja={
{
name={"Ai"},
"Hyauh, hyan, ah, n-no, duele, pero, hya, hyah, no... Naoyaa... e-está\nsintiéndose... realmente, bien...",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
ja={
{
"La fuerte constricción de hace un momento había cedido por completo. El\ninterior de Ai estaba ahora cálido, viscoso y tierno.",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
ja={
{
name={"Naoya"},
"Kuh... Esto es demasiado... Ai... Se siente realmente bien adentro...",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
"Su mojada cavidad estaba realmente caliente, y la moderada constricción que\nofrecía se sentía muy bien.",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
vo={
{"vo",file="fem_aid_001578",ch="aid"},
},
ja={
{
name={"Ai"},
"Hiih, ah, ahh... Jaa, fuh, Jaa... ah, ah, ahhnnn, ahn, ahn, ¡ah, ah, ahh!",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
vo={
{"vo",file="fem_aid_001579",ch="aid"},
},
ja={
{
name={"Ai"},
"Auh... T-Te siento... dentro de mí, Naoya... Está, cada vez más grande...\n¡¿Kuh?!",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
ja={
{
name={"Naoya"},
"A-Ai... se siente bien... Se siente... muy bien, dentro de ti...",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"text"},
text={
vo={
{"vo",file="fem_aid_001580",ch="aid"},
},
ja={
{
name={"Ai"},
"¿D-De verdad?... Qué, bueno... kuh... Y-Yo también... me siento, muy bieeen...\nBastante... kuh...",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
ja={
{
"La vagina de Ai estaba caliente y resbaladiza adentro, y ya podía mover mi pene\ncon libertad adentro y afuera.",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
ja={
{
"Era tan intenso el placer que si me descuidaba podría venirme en cualquier\nmomento.",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"se",file="se9010",vol=80,id=1},
{"text"},
text={
ja={
{
"Ai me abrazó fuertemente.Nuestras pieles, bañadas en sudor, se adherían entre\nsí y se rozaban.",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Ai?",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"bg",file="ev_aix_h03_08",sync=0,face=1,time=400,path=":ev/ev_aix_h03/",set="ev_aix_h03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001581",ch="aid"},
},
ja={
{
name={"Ai"},
"Así... Al juntar nuestros cuerpos... siento que de verdad... estamos haciendo\nel amor... hauf.",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
ja={
{
name={"Naoya"},
"Jaa, jaa, sí...",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
vo={
{"vo",file="fem_aid_001582",ch="aid"},
},
ja={
{
name={"Ai"},
"Jaa, jaa, ahn... kuh... Se siente bien, abrazarnos así... El calor, de tu piel,\nse siente realmente bien...",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, y además... puedo sentir también tu respiración...",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
ja={
{
"Al hundir mi cara en su clavícula puedo sentir la respiración de Ai en mi oído.",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"text"},
text={
vo={
{"vo",file="fem_aid_001583",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí... yo también puedo... escuchar, tu respiración... Estás, muy excitado...\nJaa, jaa, aunque, yo también...",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
ja={
{
name={"Naoya"},
"Jaa, jaa, jaa... Sí... así es.",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
vo={
{"vo",file="fem_aid_001584",ch="aid"},
},
ja={
{
name={"Ai"},
"Tu calor... tu respiración... Sentir todo eso, me pone feliz... tan, tan\nfeliz... Yo... Jaa, jaa... hyan... Naoyaa... se siente, tan bien...",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
ja={
{
"Al parecer ya no siente casi dolor.",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
ja={
{
"Acelero violentamente mis caderas.",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001585",ch="aid"},
},
ja={
{
name={"Ai"},
"Auh, ah, ah, ah, ahh... ahn, ahn, ahn... a-ahaah, fuh, Jaa... ¡Aaahhh!",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"text"},
text={
ja={
{
"Cada vez que llegó hasta el fondo, la espalda de Ai se dobla como un arco.",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"bg",file="ev_aix_h03_09",sync=0,face=1,time=400,path=":ev/ev_aix_h03/",set="ev_aix_h03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001586",ch="aid"},
},
ja={
{
name={"Ai"},
"Jaa, jaa, jaa, haaah... ngah, ngaahhh, Naoya, aaa.... NaoyaaaAa... es,\nasombroso... Ngah, ¡NgaaAAhh!",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"text"},
text={
vo={
{"vo",file="fem_aid_001587",ch="aid"},
},
ja={
{
name={"Ai"},
"Hawaaahhn... Ah, a-ahí, ah, ah, ahí, ahí... No, está tan fuerte... ngh...\nngh... ngah... nmm, ahh... ¡No, no puedo má--!",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"text"},
text={
ja={
{
"Ai estaba ahora aferrándose a mí no solo con sus brazos, sino con sus piernas\ntambién.",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"text"},
text={
ja={
{
"Parece que está sintiéndome con todo su cuerpo.",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"text"},
text={
ja={
{
name={"Naoya"},
"Jaa, jaa, jaa, jaa... A-Ai...",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"text"},
text={
vo={
{"vo",file="fem_aid_001588",ch="aid"},
},
ja={
{
name={"Ai"},
"Dame... más fuerte, Naoya. Naoyaaaa, ngaahhh... Haahhh, Jaa, jaa, haaaahhh...",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Ya, no te duele?",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"text"},
text={
vo={
{"vo",file="fem_aid_001589",ch="aid"},
},
ja={
{
name={"Ai"},
"A-Así es... Ya, no duele... Se siente, muy bien... poder, tenerte, y\nsentirte... ngaahh.",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"text"},
text={
ja={
{
"Ai estaba claramente gozando del mismo, o incluso más placer de cuando se vino\ncon mis dedos.",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"text"},
text={
vo={
{"vo",file="fem_aid_001590",ch="aid"},
},
ja={
{
name={"Ai"},
"Qué alegría... poder, disfrutarlo tanto... en mi primera vez, contigo, Naoya...\nAh, ahh... ahh, aih... aih, ih, ih, ih...!",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"text"},
text={
vo={
{"vo",file="fem_aid_001591",ch="aid"},
},
ja={
{
name={"Ai"},
"Lo estoy... disfrutando... Naoyaa... Hwaaah.",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"text"},
text={
ja={
{
"Ai está moviendo sus caderas contra las mías.",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"text"},
text={
ja={
{
"El placer se magnifica.",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"text"},
text={
ja={
{
name={"Naoya"},
"S-Si te mueves tú también... no, no... no voy a, poder aguantar...",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"text"},
text={
vo={
{"vo",file="fem_aid_001592",ch="aid"},
},
ja={
{
name={"Ai"},
"Ngh, ngh, es que... yo también, lo disfruto... Yo también, quiero moverme...\nQuiero, sentirte... Ngah, ah, ah, ah, ah... ¡Ahí, a-ah, ahí, ahí!",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"text"},
text={
ja={
{
name={"Naoya"},
"N-No puedo más... si sigues así... me correré, adentro...",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"text"},
text={
vo={
{"vo",file="fem_aid_001593",ch="aid"},
},
ja={
{
name={"Ai"},
"Está bien... Naoyaaa... vente, dentro de mí... Ngh.... ¡¿AAAaaaAhhh?!",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"text"},
text={
ja={
{
name={"Naoya"},
"E-Está bien... Seguiré, hasta el final, eh... Hasta, el final...",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"text"},
text={
vo={
{"vo",file="fem_aid_001594",ch="aid"},
},
ja={
{
name={"Ai"},
"Sí...",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"se",file="se9010",vol=60,id=1},
{"text"},
text={
ja={
{
"Ai me abraza fuertemente y sonríe.",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"text"},
text={
ja={
{
"Al ver esa sonrisa, perdí el control y comencé a mover fuertemente mis caderas.",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"text"},
text={
ja={
{
"Ai me está recibiendo.",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"text"},
text={
ja={
{
"Está tomándome dentro de ella.",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"text"},
text={
ja={
{
"Solo ella... ha acogido mi todo... Solo ella, ha aceptado mi lado débil...Por\neso es que...",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"text"},
text={
ja={
{
"――¡*shhh! ¡*shhh*! ¡*shhh*! ¡¡*shhh*!!",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001595",ch="aid"},
},
ja={
{
name={"Ai"},
"Ahy, ah, ahh... ahn, ahn, ah, ahh, hgah, guh, kuh... ¡¡¡A-Ahhhh!!",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"text"},
text={
ja={
{
"Muevo mis caderas como si no hubiese un mañana, mi pene roza con los interiores\nde Ai y el placer era tal que mi cabeza parecía derretirse.",
{"rt2"},
},
},
},
linkback="block_00378",
linknext="block_00380",
},
block_00380={
{"text"},
text={
ja={
{
"En cualquier momento me iba a correr.",
{"rt2"},
},
},
},
linkback="block_00379",
linknext="block_00381",
},
block_00381={
{"text"},
text={
ja={
{
"Pero aun así, quería estar un poco más con ella... Unido a ella...",
{"rt2"},
},
},
},
linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"text"},
text={
ja={
{
"Quería sentir más a Ai.",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
{"text"},
text={
ja={
{
name={"Naoya"},
"... Jaa, jaa, jaa, jaa, jaaaaa... ¡Kuh!",
{"rt2"},
},
},
},
linkback="block_00382",
linknext="block_00384",
},
block_00384={
{"text"},
text={
vo={
{"vo",file="fem_aid_001596",ch="aid"},
},
ja={
{
name={"Ai"},
"¡Ah, ah, ahhh! N-No, ahí... si sigues moviéndote así... a-ah... a-ahi, no... me\nvoy a... ¡¡¡A-Ahhhhh!!!",
{"rt2"},
},
},
},
linkback="block_00383",
linknext="block_00385",
},
block_00385={
{"text"},
text={
ja={
{
"Ai también está disfrutando de mí.",
{"rt2"},
},
},
},
linkback="block_00384",
linknext="block_00386",
},
block_00386={
{"text"},
text={
ja={
{
"Quería aguantar hasta el final, pero... ya estaba llegando a mi límite.",
{"rt2"},
},
},
},
linkback="block_00385",
linknext="block_00387",
},
block_00387={
{"text"},
text={
ja={
{
name={"Naoya"},
"Jaa, jaa, jaa, jaa... N-No puedo más... Aiii... No, aguanto más... De verdad,\nvoy a correrme... adentro.",
{"rt2"},
},
},
},
linkback="block_00386",
linknext="block_00388",
},
block_00388={
{"text"},
text={
vo={
{"vo",file="fem_aid_001597",ch="aid"},
},
ja={
{
name={"Ai"},
"Ahn, ahn, ah, ah, ahh... ¡Está bien, Naoya! ¡Vente, vente dentro de mí!",
{"rt2"},
},
},
},
linkback="block_00387",
linknext="block_00389",
},
block_00389={
{"text"},
text={
ja={
{
"Ai me abraza.Fuertemente, como para no dejarme ir.",
{"rt2"},
},
},
},
linkback="block_00388",
linknext="block_00390",
},
block_00390={
{"text"},
text={
ja={
{
name={"Naoya"},
"N-No puedo más... Ya, no... Kwaaah... ¡¡M-Me corrooo!!",
{"rt2"},
},
},
},
linkback="block_00389",
linknext="block_00391",
},
block_00391={
{"text"},
text={
ja={
{
"Sentí una fuerte palpitación adentro.",
{"rt2"},
},
},
},
linkback="block_00390",
linknext="block_00392",
},
block_00392={
{"text"},
text={
ja={
{
"Al momento siento un fuerte corrientazo de placer pasar por mi cuerpo, y me\ncorro dentro de ella.",
{"rt2"},
},
},
},
linkback="block_00391",
linknext="block_00393",
},
block_00393={
{"bg",id=9,lv=9,sync=1,time=500,file="white",path=":bg/"},
{"bg",id=9,lv=9,sync=1,time=500,alpha=0,file="white",path=":bg/"},
{"bg",id=9,lv=9,sync=1,time=1000,alpha=255,file="white",path=":bg/"},
{"cgdel",id=9,lv=9},
{"bg",file="ev_aix_h03_10",sync=1,time=1000,vague=100,path=":ev/ev_aix_h03/",set="ev_aix_h03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001598",ch="aid"},
},
ja={
{
name={"Ai"},
"Hyaaaaaahhhh...... ¡¡¡¡AaaAaaaaAhhh!!!!",
{"rt2"},
},
},
},
linkback="block_00392",
linknext="block_00394",
},
block_00394={
{"text"},
text={
ja={
{
"Apenas eyaculo, Ai lanza un salvaje y erótico grito, y su cuerpo se estremece.",
{"rt2"},
},
},
},
linkback="block_00393",
linknext="block_00395",
},
block_00395={
{"text"},
text={
ja={
{
"Su vagina se contrae y aprieta mi miembro.",
{"rt2"},
},
},
},
linkback="block_00394",
linknext="block_00396",
},
block_00396={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡¡¿Kuhhhh?!!",
{"rt2"},
},
},
},
linkback="block_00395",
linknext="block_00397",
},
block_00397={
{"text"},
text={
ja={
{
"El placer que tan fuertemente me había invadido estaba bombeándose ahora en los\nrecién descubiertos interiores de Ai.",
{"rt2"},
},
},
},
linkback="block_00396",
linknext="block_00398",
},
block_00398={
{"text"},
text={
ja={
{
"Mi cabeza se tiñe de blanco. El placer lo deja todo en blanco.",
{"rt2"},
},
},
},
linkback="block_00397",
linknext="block_00399",
},
block_00399={
{"flash",time=800,alpha=150,loop=1,color="ffffff"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"Ugh... ¡¡Kwaaahhh...!!",
{"rt2"},
},
},
},
linkback="block_00398",
linknext="block_00400",
},
block_00400={
{"text"},
text={
ja={
{
"Siento cómo bombeo mi hombría dentro de Ai.",
{"rt2"},
},
},
},
linkback="block_00399",
linknext="block_00401",
},
block_00401={
{"text"},
text={
ja={
{
"Mi pulsante miembro expulsa cada vez más semen, llenando su vientre.",
{"rt2"},
},
},
},
linkback="block_00400",
linknext="block_00402",
},
block_00402={
{"bg",file="ev_aix_h03_11",sync=0,face=1,time=400,path=":ev/ev_aix_h03/",set="ev_aix_h03"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001599",ch="aid"},
},
ja={
{
name={"Ai"},
"Jaa, jaa, jaa, jaa, jaa... N-Naoya... ¿Te, viniste?",
{"rt2"},
},
},
},
linkback="block_00401",
linknext="block_00403",
},
block_00403={
{"text"},
text={
ja={
{
name={"Naoya"},
"S-Sí... fue, espectacular...",
{"rt2"},
},
},
},
linkback="block_00402",
linknext="block_00404",
},
block_00404={
{"text"},
text={
vo={
{"vo",file="fem_aid_001600",ch="aid"},
},
ja={
{
name={"Ai"},
"Ya veo... Qué bueno... Yo también, lo disfruté...",
{"rt2"},
},
},
},
linkback="block_00403",
linknext="block_00405",
},
block_00405={
{"se",file="se9010",vol=60,id=1},
{"text"},
text={
ja={
{
"Ai vuelve a abrazarme con fuerza.",
{"rt2"},
},
},
},
linkback="block_00404",
linknext="block_00406",
},
block_00406={
{"text"},
text={
vo={
{"vo",file="fem_aid_001601",ch="aid"},
},
ja={
{
name={"Ai"},
"Déjame hacer esto por un ratito más...",
{"rt2"},
},
},
},
linkback="block_00405",
linknext="block_00407",
},
block_00407={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, yo también... preferiría estar así, un rato más...",
{"rt2"},
},
},
},
linkback="block_00406",
linknext="block_00408",
},
block_00408={
{"msgoff"},
{"bg",file="znightsky_winter",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=-540,x=-960,y=-540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"La noche sigue en marcha.",
{"rt2"},
},
},
},
linkback="block_00407",
linknext="block_00409",
},
block_00409={
{"text"},
text={
ja={
{
"Esta oscura, oscura noche.",
{"rt2"},
},
},
},
linkback="block_00408",
linknext="block_00410",
},
block_00410={
{"text"},
text={
ja={
{
"Esta noche, de metálicos sonidos que parecieran congelarlo todo.",
{"rt2"},
},
},
},
linkback="block_00409",
linknext="block_00411",
},
block_00411={
{"text"},
text={
ja={
{
"Me aferré a Ai.",
{"rt2"},
},
},
},
linkback="block_00410",
linknext="block_00412",
},
block_00412={
{"text"},
text={
ja={
{
"La abracé, con fuerza... Intentando aguantar...",
{"rt2"},
},
},
},
