astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c07_01",path=":ev/ev_eye_c07/",set="ev_eye_c07"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_winter",sync=1,id=1,lv=5,path=":cg/"},
{"se",id=1,file="se1532"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya amaneció...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"se",stop=1,time=500,id=1},
{"fg",ch="雫",size="z1",my=40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",lv=4,id=9},
{"bgm",file="bgm031"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000802",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hora de levantarse~”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Mm! ¡¿Pero qu--?!”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000803",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Buenos días.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué haces en mi habitación?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000804",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Vine a despertarte.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tú, con lo mucho que te cuesta levantarte temprano? Déjame adivinar, no\ndormiste nada después de eso, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000805",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Respuesta correcta... así es.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué no duermes? Trasnocharse no es bueno para el cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0011i",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000806",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Es que... ¿cómo podría dormir después de lo que pasó?...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No pudiste dormir? ¿E-Es algún efecto secundario de haber tragado sueños?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"bgm",stop=1,time=1000},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0100",face="a0005i",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0008i",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000807",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No... no es eso.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué es entonces?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0009i",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"bgm",file="bgm029"},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0011j",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000808",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pues... s-si recuerdas, anoche sucedieron muchas cosas. Entre ellas, mi\nconfesión... y tu respuesta...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, sí, no niego que mucho pasó anoche, pero... siendo hoy día de semana,\nambos tenemos que ir al colegio. Por eso cuando te calmaste me prometiste que\nte dormirías rápido, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000809",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, y así hice. Regresé a mi cuarto, me metí a mi futón y cerré los ojos...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0011j",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000810",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero... no pude dormir...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0008j",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0010j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000811",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Cada vez que recuerdo lo que me dijiste, yo... m-mi pecho, se acelera...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0012j",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0009j",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000812",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Waah... j-justamente ahora acabo de recordarlo, y mi pulso está bastante\nacelerado...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Deja de recordar lo que dije ayer! L-La manera en que hice esa confesión fue\nalgo vergonzosa.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0005j",head="shz_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0002j",head="shz_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000813",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“De vergonzoso no tiene nada. Fue una confesión hermosa y totalmente galante.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, si te gustó mi confesión, supongo que no hay problema... aunque,\npersonalmente siento que mis palabras estaban algo pasadas de tono...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0004j",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000814",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Era el momento para eso... Fueron justamente esas palabras las que más me\ncautivaron...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0100",face="b0003j",head="shz_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000815",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me sentí muy alegre.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Shizuku sonríe, sonrojada y con los ojos humedecidos.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Jamás había visto una sonrisa así en ella.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Estoy sonrojándome yo también.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001j",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000816",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Justo al voltear, le doy un pequeño beso a Shizuku.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0012j",head="shz_z2a",lv=5,id=9,sync=0},
{"extrans",time=300},
{"fgact",ch="雫",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000817",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0001j",head="shz_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000818",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“M-Me han besado...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A esto le llaman beso francés, creo.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0008j",head="shz_z2a",lv=5,id=9},
{"fgact",ch="雫",act="びっくり",time=100,size=7,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000819",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, creo. No está tan mal, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0011j",head="shz_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0100",face="a0009j",head="shz_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000820",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“M-Me cuesta un poco... responder a esa pregunta.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Shizuku roza suavemente sus labios con su dedo índice.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0100",face="a0009j",head="shz_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, es hora de levantarse. Tengo que preparar el desayuno de todos.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000821",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hoy vine a despertarte, porque... quería, confirmar...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Confirmar?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0011",head="shz_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0008",head="shz_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_000822",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Desde aquel día, comencé a tener sueños de mi cuenta... y por eso, quería\nconfirmar que lo de anoche, no fue todo un sueño como tal...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Sucedió en medio de la noche, así que tiene sentido.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0010",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000823",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No he dormido nada tampoco, así que... podría ser, que esté todavía soñando...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si esto es un sueño, no despertarás jamás de él.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000824",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Jamás despertaré de este sueño?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. No dejaré que lo hagas.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0100",face="b0012",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000825",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo... que fue algo ridículo eso, sí. ¿Por qué será? Intento decir cosas buenas\npero no lo logro...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Fuerzo una sonrisa y salgo al pasillo.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"se",file="se9010",id=1},
{"mwact",act="おじぎ"},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmph, hmph.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003993",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gruñes como un viejo al sentarte.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ¿será porque mi edad mental es bastante avanzada?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003994",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Qué tonterías dices... Y bien, ¿has avanzado con la obra?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Con la obra?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003995",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Tu obra para la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0110",face="a0001",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"se",file="se3214",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Toritani se sentó frente a mí.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Alguien se va a sentar ahí.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0017",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0026",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003996",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Libraré el espacio cuando venga. ¿Y? ¿Has avanzado?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No he hecho nada.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0005",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003997",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué? Si no comienzas ya no podrás presentarla a tiempo.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que no te dije ya que no tengo intención alguna de presentar?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0018",head="mak_z2d",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0005",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003998",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dios santo, mira nada más a Kei. Él sí está esforzándose, trasnochándose todos\nlos días.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece... Nunca duerme en su habitación, y aun cuando intento despertarlo\nno se levanta.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0011",head="mak_z2d",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0009",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003999",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y se duerme en clase además... A este paso, me pregunto si podrá graduarse.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo idea.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"bgm",stop=1,time=1000},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0006",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004000",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kei está esforzándose bastante.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sé.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bgm",file="bgm003"},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0005",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004001",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Que lo sabes? ¡¿Sabes acaso por qué Kei está esforzándose tanto?!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"Le lanzo una fuerte mirada a Toritani.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0006",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",time=100,size=7,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004002",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué?...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo lo que me quieres decir. Pero no voy a presentar nada.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No voy a pintar cuando no puedo hacerlo, y tampoco habiendo necesidad alguna de\nque lo haga.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0018",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0005",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004003",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“*Fiuu*... Por más que insistas no servirá de nada. ¿Eso quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Básicamente...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004004",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por cierto, han habido muchas noticias acerca de la Farmaceútica Nakamura, ¿te\nenteraste? Parece que tienen en su poder obras desconocidas de Kenichiro\nKusanagi.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea de eso.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004005",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que son obras nunca publicadas. Son seis cuadros que componen una serie\ncompleta junto a 'Cerezos recostados'.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No hay fotos de los cuadros?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004006",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Obvio que las hay.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo estás contando como si no las hubieses visto aún.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0002",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004007",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Parece que harán una exposición para presentarlas, no planeo ver las fotos\nhasta observar los cuadros en persona. Me parece un desperdicio verlos\nprimero en fotos.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, bueno...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0001",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004008",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y sabes? El año pasado, poco antes de que terminara el año, llegué a ver al\ndueño de la tienda de arte de Sakuragahara preparando seis enormes lienzos.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Je~, ¿de verdad?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0002",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0012",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004009",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, y no eran de tamaño convencional. Cada uno era más o menos del tamaño de un\nbiombo. Fui y le pregunté al señor, ¿para qué son esos lienzos?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y entonces?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0004",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
},
vl02={
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
},
vl03={
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
},
vl04={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0017",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004010",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Muy alegremente me dijo 'Es, un, secre, ti, to ♪'. No sabía que ese señor\npodía tomar un tono tan femenino.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Q-Qué repugnante se escucha eso...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004011",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y fue entonces que recordé que era justamente el mismo tamaño de 'Cerezos\nrecostados'...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Je~, ¿de verdad? Aunque tampoco es tan raro ver lienzos de tal tamaño, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0017",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004012",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, el señor dijo que llevaba años sin preparar lienzos así, y que había\npasado algo de trabajo.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“H-Heeh...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Toritani sigue hablando, mientras me escudriña con su mirada.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0005",head="mak_z2d",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0001",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004013",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo un profesional usaría ese tamaño de lienzo, ¿no crees? Aunque es curioso,\nno he escuchado de ningún artista profesional acá en Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás haya alguno y no te hayas enterado. Ah, tal vez se haya mudado acá\nterminando el año pasado.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0017",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004014",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hmmmph.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"La mirada de Toritani me penetra aún más que antes.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004015",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Qué más da. En fin, en estos días iré a ver las misteriosas seis obras.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0005",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004016",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E iré a revisar unas cuantas cosas.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A-A revisar qué?...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004017",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque sí, al parecer tienen la firma y el sello de Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿N-No es acaso obvio? Son sus obras.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0026",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004018",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Será verdad eso?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0005",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004019",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Puede que quede o no satisfecha con el acabado, te lo advierto, eh!”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Satisfecha d-de qué? Si vas a decir eso díselo al difunto, no a mí.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0006",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004020",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque... puede ser que termines convenciéndome a mí... pero no creo que a Kei\nlo haga...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡B-Basta ya! Fue Kenichiro Kusanagi quien creó esas obras, ¿por qué tengo yo\nque ganar el buen visto de ustedes por una obra que no es mía?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0018",head="mak_z2d",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0005",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004021",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué no te lo preguntas a ti mismo? Te lo dice la misma que descubrió el\nplan de Akashi-senpai y dio con la verdad. Tonta no soy.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ah, ¿sí?...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0018",head="mak_z2b",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0005",head="mak_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004022",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“*Fiuu*, es increíble que todavía intentes hacerte el tonto.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué insistencia, diablos. Tengo muchas circunstancias pesando sobre mi espalda,\npor Dios. ¡Deja ya de seguir con tus estúpidas averiguaciones!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="真琴",size="z1",my=40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1b0100",face="b0018",head="mak_z1b",lv=4,id=9},
{"se",file="se3214",id=1},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0017",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_004023",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, sí, está bien. Tratándose de ti, probablemente tenías razones de fuerza\nmayor. En fin, qué importa.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"se",file="se1279",id=1},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0001",head="mak_z1b",x2=0,x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mx=40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003697",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, Mako-chan, buenos días.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Buenos días.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004024",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, sí. ¿Cómo vas tu, Rin-chan?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003698",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Yo?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=-345,lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004025",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, ¿cómo vas con tu cuadro?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003699",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, mi cuadro. Pues, he estado pintando, sí.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004026",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Rin-chan, estabas en la sala de arte practicando, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003700",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004027",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Y así como puedes ver, todos los miembros del club de arte están esforzándose!\n¡Excepto por ti, claro!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuántas veces tengo que decirte que yo no pertenezco al club de arte?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="真琴",mode=-1,lv=4,id=9},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x2=345,x=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, Rin, ¿terminaste el cuadro con el que estuvimos practicando durante\nlas vacaciones de verano?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003701",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, logré terminarlo.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, iré entonces a verlo después de clases.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003702",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues como tu supuesto instructor debería hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=0,lv=4,id=6},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",time=100,size=5,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003703",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué bueno. La verdad es que cuando comienzo a pintar empiezo a sentirme\ndesorientada, y me quedo sin saber como seguir, ajaja.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Se siente desorientada cuando comienza a pintar, eh...",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Para alguien que apenas se adentra en el mundo de la pintura, es algo normal\nsentirse así.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Sus cuadros son normales, y su acercamiento al momento de pintar también.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Rin es, definitivamente, una muchacha normal.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"De ser así, ¿con qué intención Kenichiro Kusanagi me contó todo eso?...",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"¿Me estaba mintiendo?",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"¿Se equivocó de persona?",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"¿O es que después de eso algo le sucedió a Rin?",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"¿O es que acaso Rin ha estado actuando todo este tiempo?",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"No, no creo que sea eso...",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Rin no sería capaz de hacer algo así.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Rin es una muchacha amable y de buen corazón.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Convertirse en la aprendiz de Kenichiro Kusanagi... eso implica...",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"fg",mode=-2,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004028",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿En qué piensas, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004029",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tengo que decirlo, a veces pones una cara que da terror.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo estaba pensando en algo.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004030",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues no es muy delicado de tu parte quedartele viendo a Rin-chan en silencio\ncon esa cara solo porque necesitas pensar.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
},
vl02={
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003704",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, a mí se me aceleró el pecho cuando me vio de esa manera. Nada mal, nada\nmal.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_004031",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estoy más que segura que no se te aceleró precisamente por felicidad.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003705",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejejeje, sí, bueno, pensé que en cualquier momento me regañaría.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Claro que no, no puse esa cara, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_004032",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí la tenías. ¿Es que andas metido en otro problema ahora?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no, nada de eso.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_004033",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa, Dios sabrá. No te creo en absoluto cuando me dices eso.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003706",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues sí, Nao-kun no es de muy confiar cuando se trata de esas cuestiones.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no, no pasa nada. L-Lo único que me preocupa ahora, es... ahhh, ehm,\nm-mis calificaciones, supongo.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003707",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso es algo muy serio.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, ya va a comenzar la clase. ¿Por qué no regresas a tu asiento,\nToritani? La dueña del asiento que estás ocupando está esperando.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_jka_000054",ch="jka"},
},
ja={
{
name={"Alumna A"},
"“E-Esto...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0013",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0013",head="mak_z1a",x2=-345,x=-210,lv=4,id=5},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=-210,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_004034",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? Ah, d-disculpa por tomar tu asiento, perdóname.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",x=-210,lv=4,id=5},
{"fgact",ch="真琴",act="うんうん",lv=4,id=5},
{"text"},
text={
ja={
{
"Toritani se disculpó varias veces con la muchacha que ocupaba el asiento frente\nal mío.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"¿A dónde se fue esa actitud imponente de hace rato, eh?...",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="zbluesky_winter",speed=300000,rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las nubes se ven cada vez más altas...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Aún hace algo de calor como para llamarle otoño, pero el verano está alejándose\nya.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Los cúmulos han comenzado a desaparecer del cielo, y ahora se pueden ver nubes\nmás altas, como los los cirros y los cirrocúmulos.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Esas dos son las nubes más altas que se pueden ver en el cielo.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Y son también señal de la transición de las estaciones.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Dónde está tu cuadro?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003708",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Esto, acá está!”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rin monta un lienzo sobre el caballete.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003709",ch="rnd"},
},
ja={
{
name={"Rin"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Rin tenía los ojos cerrados, tal vez por nervios.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Reviso su cuadro.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmph...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Diseño.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Uso de colores.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Composición y estructura.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Todo era normal. Común y corriente.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Un cuadro nada mal, aunque nada particularmente extraordinario como para\nalguien que pinta por primera vez.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmmmm.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003710",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿T-Tiene algo malo?...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es eso. Sí, bueno, nada fuera de lo común para alguien que comienza.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0009",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003711",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad?...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Créeme. Solo por si no lo recuerdas, desde muy pequeño me han estado\neducando en el arte de las pinturas, tengo base para decirlo.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003712",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Pinturas, no. Materialización.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Tiene a Dios dentro de sí.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Sus manos producían milagros.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Así elogiaba Kenichiro Kusanagi las pinturas de Rin. Pero, lo que tengo frente\na mis ojos ahora no se acerca ni un poco a eso...",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La muchacha maldecida por la belleza...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="びっくり",time=100,size=7,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003713",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es nada. Hablaba solo, sí.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, ya este cuadro está bien como está. Vayamos ahora con el siguiente.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=0,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003714",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"bgm",stop=1,time=500},
{"cgact",stage="bg049",act="rl"},
{"se",id=1,file="se2790"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003715",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Se escucha algo cayéndose.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"Sobre el suelo estaba tirado el coleto que estaba parado sobre la pared cercana\na la entrada.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Y tras esa puerta estaba.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"se",file="se1279",id=1},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="雫",size="z1",mx=40,mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0008",head="shz_z1b",x=345,lv=4,id=6},
{"bgm",file="bgm011"},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003716",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Shizuku-chan!”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué haces acá, Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0011",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",time=100,size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000826",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“E-Esto, yo...”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Moviéndose nerviosamente, Shizuku nos observa a Rin y a mí alternadamente,",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003717",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Rin se queda viendo fijamente la cara de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y? ¿Es que viniste a pasar el rato al club de arte de Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0012",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0008",head="shz_z1b",x=345,lv=4,id=6},
},
vl02={
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000827",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Shizuku contesta a mi pregunta, con un tono de voz aplacado.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003718",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Por alguna razón, Rin estaba ahora viéndome fijamente a mí.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué? ¿Por qué me ves tanto a la cara?”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003719",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no... no es por nada en particular.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Rin asiente, sin saber por qué.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003720",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ya ves qué? ¿Te diste cuenta de algo?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003721",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no es nada grave, realmente... Ah, cierto. Llevo un tiempo ya pensando en\nesto, desde que terminé el cuadro...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003722",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Creo que de ahora en adelante preferiría pintar sola.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Sola?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-345,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003723",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Ya aprendí las básicas, y creo que ya no hace falta que gastes más de tu\ntiempo en mí... O al menos, eso he estado pensando.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso crees? Ciertamente te enseñé ya las básicas, pero igual...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0001",head="rin_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003724",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku-chan.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000828",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="稟",speed=800,mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0001",head="rin_z1b",x2=-345,x=-210,lv=4,id=9},
{"text"},
delay={
[800]={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"se",file="se9010",id=1},
},
},
text={
ja={
{
"Rin se acerca lentamente a Shizuku. Y entonces, toma sus manos.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0002",head="rin_z1b",x=-210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003725",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Cuánto tiempo. Me alegra verte.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000829",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin. A mí también.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0016",head="rin_z1b",x=-210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003726",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ehm, Shizuku-chan, tengo una advertencia para ti.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0008",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000830",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Una advertencia?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0002",head="rin_z1b",x=-210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003727",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Una advertencia muy, muy seria.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0016",head="rin_z1b",x=-210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003728",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sabes? Nao-kun es muy, muy amable con los demás. Y por eso mismo hay muchas\nchicas enamoradas de él.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0004",head="rin_z1b",x=-210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003729",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo que todas lo ocultan, por timidez o vergüenza...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0001",head="rin_z1b",x=-210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003730",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero, estoy segura de que los sentimientos de todas y cada una de ellas son\nreales...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0002",head="rin_z1b",x=-210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003731",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No han pasado ni 6 meses desde que regresé a Yumihari... pero si hay algo que\nveo todos los días y de lo que me he dado cuenta, es eso.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0005",head="rin_z1b",x=-210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003732",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y no solo eso. Nao-kun se ha vuelto algo famoso, así que ahora una cantidad\ninnumerable de muchachas están tras él.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000831",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Naoya es muy popular con las chicas.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0004",head="rin_z1b",x=-210,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003733",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Definitivamente.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0100",face="b0005",head="rin_z1b",x=-210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003734",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por eso debes procurar espabilarte y no quedarte atrás, Shizuku-chan.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0012",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000832",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003735",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Q-Qué?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-210,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=-210,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003736",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Usa el tiempo que tendrás ahora para concentrarte en tu propia obra, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, espera, ya dije que no voy a presentar nada en la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-210,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-210,lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",x=-210,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003737",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo... Pues, entonces úsalo para estudiar en casa. No te has preparado para\nlos exámenes de la universidad, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh... no lo puedo negar...”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003738",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Hay algo que no entiendas?”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Más que algo, diría que casi todo...”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-210,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=-210,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003739",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sí? Creo que podría ayudarte entonces. Quizás no lo parezca, pero mis\ncalificaciones son buenas.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"La misma muchacha que ha tenido las mejores calificaciones del colegio en estos\núltimos años, superando incluso al genio Hirose, viene a decirme que 'quizás\nno lo parezca'.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, cuando no sepa hacer algo te consultaré.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-210,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003740",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, cuando quieras...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0005",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000833",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hoy podría ser un buen día.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-210,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003741",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Hoy?”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000834",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, hoy.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-210,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-210,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003742",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues no me importaría. Shizuku-chan, ¿quieres estudiar con nosotros?”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000835",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, quisiera que me ayudaras a mí también.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-210,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-210,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003743",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Te ayudaré en lo que pueda. Aunque no sé si pueda cubrir todo el contenido que\nven en San Ruan.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000836",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eres inteligente, Rin. No habrá problema.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0004",head="rin_z1a",x=-210,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",time=100,size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=-210,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003744",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, no tanto tampoco. Aunque, a diferencia de cierta personita, yo sí he\nestado estudiando y preparándome desde el primer año, así que tal vez pueda\nayudarte sin tanto inconveniente.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"¿Sin tanto inconveniente? ¿Qué inconveniente va a tener la número uno\nconsecutiva de la lista de honor?",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000837",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Te importa si estudiamos en la residencia Natsume?”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-210,lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003745",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Para nada. Además, siendo Kootoha puedo regresar a mi casa caminando.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué? ¿Es que de verdad vamos a tener una sesión de estudio?”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-210,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=-210,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003746",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es. En parte es para agradecer que me enseñaras a pintar, Nao-kun. Así que\nahora pienso ser tu tutora de aquí a que comiencen los exámenes de la\nuniversidad.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uheeh...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"bg",file="bluesky_winter",id=8,lv=8,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"bg",file="eveningsky_winter",id=9,lv=9,sync=1,path=":cg/"},
{"ex",time=1000,func="wait"},
{"bgm",file="bgm009"},
{"text"},
text={
ja={
{
"Al terminar las clases y revisar el cuadro de Rin, me fui de vuelta junto a\nellas a la residencia Natsume.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
"Shizuku, Rin y yo salimos juntos del colegio.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"Era la primera vez que regresaba con este grupo, pero... no se sentía raro en\nabsoluto.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"Rin y Shizuku hablaban sin reserva, como si fuesen viejas conocidas. Y en mi\ncaso, pude mezclarme en la conversación sin problema alguno.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"cgdel",id=-1},
{"se",file="se9008",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0003",head="rin_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003747",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Je~, ¡así que esta es tu habitación en la casa Natsume, Nao-kun!”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003748",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es una buena habitación.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo es. Tanto que no he regresado a mi propio apartamento.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0002",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000838",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Puedes quedarte para siempre acá, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tampoco para siempre, digo yo... de vez en cuando tengo que regresar al\napartamento.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003749",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, las casas se deterioran cuando nadie vive en ellas.”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Exactamente.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003750",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Bueno, ¿comenzamos ya con la sesión de estudio?”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? Apenas llegamos... ¿Por qué no descansamos un rato antes de comenzar?...”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0018",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003751",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Vinimos a tu habitación para estudiar, Nao-kun. El descanso lo podemos dejar\npara cuando terminemos.”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000839",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hmph, listo. Terminé el Standby.”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Tan rápido?!”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003752",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo también terminé.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Tan rápido?!”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003753",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nosotras estuvimos preparando todo mientras hablábamos, pero no me parece\nhaberte visto haciendo algo, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhmmm, creo que de verdad las reuniones de estudio contigo no son nada\nsencillas, Rin.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003754",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si tus calificaciones subieran con sesiones sencillas de esa manera las haría,\npero en lo que concierne a los estudios no es nada bueno mimarte mucho,\nNao-kun. De eso me di cuenta en las lecciones de verano.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
name={"Naoya"},
"“U-Ugh... La buena y amable Rin que yo conozco ya no está...”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0010",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0016",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003755",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, sí, bueno. Comencemos con la sesión de estudio.”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueee... no.”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Umuh...”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
"Me pusieron a resolver problemas de años pasados para ver si había aprendido\nalgo, pero los resultados no fueron buenos.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0017",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003756",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estas calificaciones no te ayudarán mucho en el examen nacional.”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
"Para sociales, que no se me da tan bien, intentamos enfocarnos en la parte\nética y dejar afuera geografía.",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0010",head="shz_z1a",x=345,lv=4,id=6},
{"fgact",ch="雫",act="おじぎ",lv=4,id=6},
{"text"},
delay={
[1500]={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0005",head="shz_z1a",x=345,lv=4,id=6},
{"fgact",ch="雫",act="びっくり",lv=4,id=6},
},
},
text={
ja={
{
"La parte de ética tiene muchos aspectos de la historia del arte occidental.",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0010",head="shz_z1a",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
delay={
[1000]={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0008",head="shz_z1a",x=345,lv=4,id=6},
{"fgact",ch="雫",act="びっくり",lv=4,id=6},
},
},
text={
ja={
{
"Y a pesar de eso, no pude alcanzar una buena puntuación.",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0100",face="a0010",head="shz_z1a",x=345,lv=4,id=6},
{"fgact",ch="雫",act="浮遊",loop=-1,size=7,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003757",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En inglés tampoco mejoraste mucho.”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm, he estado aprobando la clase usando lo básico que aprendí estando en Nueva\nYork de niño... aunque probablemente mi vocabulario no sea nada suficiente\npara los exámenes de ingreso.”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0005",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003758",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aparentemente. Aunque pareces ser capaz de entender intuitivamente las\nconstrucciones gramáticas, por lo que si amplías tu vocabulario probablemente\npodrás incrementar bastante tu puntuación.”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003759",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y bueno, memorizar es muy importante para los exámenes de la universidad. Solo\nnecesitas esforzarte.”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo necesito esforzarme... sí, es tal cual como lo dices...”",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"fgact",ch="雫",act="停止",lv=4,id=6},
{"fg",ch="雫",my=40,mode=-1,lv=4,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Lentamente...",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
"De esa forma cayó Shizuku sobre Rin.",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"fg",mode=-2},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0013",head="rin_z2a",lv=5,id=5},
{"fgact",ch="稟",act="うなづく",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003760",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿S-Shizuku-chan? ¿E-Estás bien?”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, probablemente se...”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
vo={
{"vo",file="fem_szd_000840",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003761",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Su respiración, ¿está durmiendo?”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece.”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0015",head="rin_z2a",lv=5,id=5},
{"fgact",ch="稟",act="おじぎ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003762",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me asusté. Pensé que se había desmayado.”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No durmió muy bien anoche.”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003763",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, fue por algo que sucedió.”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003764",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Algo que sucedió? ¿Qué sucedió?”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, nada serio...”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",lv=5,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="おじぎ",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003765",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nada serio, eh... Hmmmph.”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
{"se",file="se9010",vol=60,id=1},
{"text"},
text={
ja={
{
"Rin acaricia la cabeza de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003766",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El cabello de Shizuku-chan es tan suave y sedoso...”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003767",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Por qué será?... A pesar de que apenas nos conocimos... se siente como si\nfuéramos viejas amigas.”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003768",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es extraño.”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, quizás así de bien se llevan las dos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=5},
{"fgact",ch="稟",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003769",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tal vez. Quiero mucho a Shizuku-chan, para decir la verdad.”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003770",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A pesar de que casi no he hablado con ella... la quiero mucho, muchísimo...”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=5},
{"fgact",ch="稟",act="うなづく",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003771",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Así que estaré siempre de su lado. No olvides nunca eso, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿D-De qué me estás hablando?...”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"bgm",file="bgm003"},
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003772",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku-chan y tú tienen una relación, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿J-Jaa?”",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003773",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No... no te equivocas. A-Así es...”",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
{"fgact",ch="稟",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003774",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me lo imaginé.”",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo te enteraste?”",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003775",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Quizás fue mi sexto sentido de chica... no lo sé...”",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003776",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo que, en el momento en que los vi a los dos juntos hoy, se me ocurrió.”",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
ja={
{
"¿Solo con vernos juntos se dio cuenta?... Qué perspicacia, demonios.",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003777",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo... sí, me lo imaginaba. Los dos están en una relación...”",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003778",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es extraño.”",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003779",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Debería estar ya muriéndome de la envidia, y de la frustración.”",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0015",head="rin_z2a",lv=5,id=5},
},
vl02={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003780",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No estoy dispuesta a responderle a alguien con tan poca delicadeza como para\npreguntar '¿por qué?' en esta situación. Definitivamente eres torpe para\nestas cosas, Nao-kun. Aun con lo espabilado que eres para lo demás.”",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, tenía que preguntar, ¿no?... Luego de que me dijeras eso...”",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0018",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003781",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Menos aun le responderé a alguien con las agallas de decir 'tenía que hacerlo'.”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
ja={
{
name={"Naoya"},
"“J-Jaa...”",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0010",head="rin_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003782",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero sí, es realmente extraño. No sé por qué... se supone que debería sentirme\nmal, y celosa... pero...”",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003783",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por alguna razón, con Shizuku-chan no pienso eso.”",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003784",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Algo dentro de mí me dice que no podría haber una chica más indicada para ti\nque Shizuku... ¿Por qué será?”",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003785",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No sé por qué, pero creo que así de grande es mi amor por ella.”",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0017",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003786",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así que, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0016",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003787",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si llegas a sacarle una sola lágrima a Shizuku-chan me enojaré bastante.”",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por supuesto que no! ¡¿Cómo crees que podría hacerla llorar?!”",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=5},
{"fgact",ch="稟",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003788",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya lo sé.”",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"text"},
text={
ja={
{
"Rin respondió eso con una sonrisa. Aunque sus ojos se veían algo húmedos.",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003789",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque, hay algo que siempre he querido decir.”",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003790",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Cuida bastante de Shizuku-chan, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto. Así lo haré.”",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
{"fgact",ch="稟",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003791",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es una promesa...”",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"text"},
text={
ja={
{
"Rin acaricia amorosamente la cabeza de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0012",head="rin_z2a",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003792",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué pequeña es. Envidio tanto su figura tan delgada...”",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada, para nada. Nada podría envidiar una mujer más que una figura tetona\ncomo la tuya.”",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003793",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hay que ser muy carente de delicadeza como para llamarle 'tetona' a alguien,\nNao-kun.”",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No puedo alegar nada a mi defensa...”",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003794",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me hubiese gustado nacer con una figura tan esbelta y delicada como esta.”",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0001",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003795",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tan delgada, que sientes que podrías quebrarla de solo abrazarla... y tan\ncálida...”",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0015",head="rin_z2a",lv=5,id=5},
{"fgact",ch="稟",act="いいえ",time=400,size=50,lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0005",head="rin_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003796",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué envidia, qué envidia. ¡Así que esta hermosura es toda tuya!”",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hables de ella como si fuera una cosa.”",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0018",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003797",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tch, me alegro de que los dos estén saliendo, pero siento que salí perdiendo\npor partida doble.”",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003798",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tan pequeña, tan linda... ¿Por qué tuve que conocerla apenas ahora?...”",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0008",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003799",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me hubiese gustado conocerla antes, mucho antes...”",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003800",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así mi amor por ella pudiera haber sido mucho, mucho más grande...”",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"text"},
text={
ja={
{
"Sí la conoces. Desde hace bastante tiempo...",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"text"},
text={
ja={
{
"Solo que perdiste esos recuerdos.",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"text"},
text={
ja={
{
"Por acción de los cerezos milenarios...",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"text"},
text={
ja={
{
"Rin preparó la cena de los Natsume ese día.",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"text"},
text={
ja={
{
"Su comida estaba tan deliciosa como siempre.",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"text"},
text={
ja={
{
"Estudiosa, hermosa, y sabe además cocinar... Rin definitivamente será una buena\nesposa...",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"text"},
text={
ja={
{
"Se me pasó eso por la cabeza después de comer.",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"bgm",stop=1,time=1000},
{"excall",file="03_andoe_03_2"},
{"text"},
linkback="block_00378",
},
label = {
top={block="block_00000",label=1},
},
}
