astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg025a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"se",file="se9010",vol=70,id=1},
{"bgm",file="bgm031"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001260",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué tal?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que qué tal?... ¿Por qué llevas un traje de baño debajo?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0016",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001261",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es lo más natural, ¿no? La forma en la que me has venido enseñando es tocando\nmi propio cuerpo mientras observo el mapa anatómico, así que la mejor manera\nde exponer mi piel frente a otra persona sin sentir tanta vergüenza es en\ntraje de baño.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001262",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La verdad es que pensé en ponerme los leggings del uniforme de gimnasia, pero\nla camisa es muy holgada, y además ya te había mostrado una vez este traje de\nbaño, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Caí por completo.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Inflé mis expectativas sin ningún sentido.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Y terminé con un gran y gordo malentendido.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0013",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001263",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No es nada... jajajaja...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001264",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pensé que... por lo menos te reirías, y lo hice...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Acabo de reírme, ¿no?... Aunque fue una risa seca...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0010",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001265",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, u-una sonrisa seca... P-Pues, sí. En un principio, no hay forma de que\ntú quieras verme en ropa interior... Supongo que tampoco causa risa esto\nentonces.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Aah? No, por supuesto que quiero verte en ropa interior. ¿Sucede algo con eso?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0014",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001266",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¡¿EHhhhhHH?!”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Rin se quedó paralizada.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué te quedas tiesa? Es absurdo que pienses que no quiero ver tu ropa\ninterior.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001267",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Ehhh? ¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡La razón por la cual mi risa estaba seca es porque me hice muchas\nexpectativas! ¡Por hacerme esperanzas es que al final terminé soltando una\nrisa seca! ¡¿Te quedó claro?!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0008",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001268",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡S-Sí!”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Deja de andar diciendo disparates y comencemos de una vez con la práctica de\ndibujo. Demonios, tanto inflar mis esperanzas para esto.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001269",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, esto...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Rin está algo desconcertada ante mi tan directa opinión.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Aunque bueno, es lo mejor ser lo más sincero posible al decir esta clase de\ncosas.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Emitir una opinión directa y concisa evita malentendidos, y además, hace\ndifícil que surja algún problema.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Incluso Rin procurará de ahora en adelante, y seguramente, cuidarse un poco más\nde mí después de la manera tan directa con la que le hablé.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Realmente estoy hasta el tope nada más tratando de mantener la cordura.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001270",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, ¿hubiera sido mejor que viniera en ropa interior?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡N-No! ¡No es eso!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0014",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"fgact",ch="稟",act="icon",lv=4,id=9,icon="icon09z1",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001271",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿No?!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, digo, es cierto, pero no es eso!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001272",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿A qué te refieres con que es cierto pero no es eso?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Rin me observa con un rostro angustiado.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Esa expresión es también muy...",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
"¡Espera, no, no pienses en eso!",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No está bueno que te pongas ropa interior solo por hacerme alegrar! ¡No hay\nnada bueno en eso, nada, nada! ¡Y por eso no lo debes hacer! ¡¿Entendiste?!”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001273",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? E-Esto... ¿Q-Quieres decir que no puedo hacerlo?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Así es, nada de ropa interior!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Siento que no estoy explicándome bien. En fin, no me queda más que calmarme y\nexplicar todo de cero.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡S-Solo lo diré una vez, así que escucha bien!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal como lo dije, he participado ya en varias sesiones de dibujo al desnudo, y\nen esos casos el desnudo de la mujer no era más que un objeto artístico para\nmí.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, eso no significa que cualquier mujer sea para mí solo un objeto de\ndibujo.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los dos somos amigos de la infancia, pero ya ha pasado una gran cantidad de\ntiempo desde esa época. Creciste y te convertiste en una hermosa chica.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nadie podría negar eso.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que, para decir la verdad, no podría ver tu desnudo de la misma forma que\nlas otras. Al igual que tu cuerpo en ropa interior... Ambos son especiales.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001274",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Es, eso significa... esto...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Odio darle tanto rodeo a las cosas. Así que te lo diré de una vez. No puedo ver\ntu cuerpo con absoluta calma. En cualquier momento está propenso a ser objeto\nde mi deseo.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001275",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿M-Mi cuerpo... es tu... objeto de deseo?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. Sería completamente distinto a los demás desnudos que he visto. Eso\nde verte como un doctor era una gran mentira. Verte en ropa interior es algo\ntotalmente distinto y especial.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001276",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Q-Quieres decir que verme así te pondría feliz, Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí, así es! ¡Me pondría feliz! Si pudiera verte en paños menores me pondría\nfeliz, y si pudiera dibujarte desnuda no podría evitar saltar en una pata.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001277",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿D-Dibujarme, desnuda? Esto... ya veo.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Me entendiste?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001278",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Qué alivio. Fuh.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001279",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Quieres que me ponga en ropa interior?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿P O R Q U É?!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001280",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pero eso te pondría feliz, ¿no, Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Me pondría feliz, pero no! ¡No puedes andar en ropa interior!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0013",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0014",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001281",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No puedo llevar ropa interior? ¿Eh, quieres decir entonces que debo ir\ndesnuda? ¡¿Me estás proponiendo dibujarme desnuda?!”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, demonios! ¡No es cuestión de si te desnudas o no! ¡Y además, ahora mismo\nte enseñaré acerca de la estructura de la parte inferior del cuerpo! ¿Sabes\nlo que eso implica?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001282",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿S-Será que, me pedirás que haga 'esa' pose?...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Así es! ¡También hay que hacer 'esa' pose!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0014",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",time=200,size=20,loop=7,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001283",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿D-D-D-D-D-D-Desnuda?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No! ¡Sería todo un gran y enorme lío si hicieras esa pose desnuda!”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0022",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001284",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entonces quieres que me preparé mentalmente para hacer esa pose desnuda...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"mwact",act="いいえ"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, no, si te quitaras toda la ropa ya ni podría enseñarte! ¡Las cosas\nterminarían de una forma completamente distinta!”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001285",ch="rnd"},
},
ja={
{
name={"Rin"},
"“T-Tienes razón... ¿Entonces en ropa interior?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Que no! ¡¿Por qué vuelves ahí?!”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0019",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001286",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿P-Por qué no entiendes?! ¡¿Que no está ya lo suficientemente claro?!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bgm",stop=1,time=500},
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0800",face="a0007",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1,vol=70},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001287",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¡E-Es que!! ¡No tengo forma de entender lo que verdaderamente no entiendo!”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Rin levanta su voz.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"bgm",file="bgm106"},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0010",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001288",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Perdona por alterarme así... pero, de verdad no lo sé.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001289",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Incluso ahora, estoy tratando de conversar de manera normal, pero realmente no\nsé si de verdad estoy logrando hacerlo contigo, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás hablando normal ahora, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0010",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001290",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo estoy haciéndote creer eso. Y con bastante esfuerzo...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001291",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y es que... no lo sé. No tengo manera de saberlo...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De saber?...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0010",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001292",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Siempre... durante este largo tiempo, estuve pensando en ti, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001293",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por esa razón es que seguí escribiéndote cartas, aunque no viniera ninguna\nrespuesta...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001294",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por dentro creía que me habías comenzado a odiar.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0010",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001295",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Todo, todo este tiempo, estuve viviendo, pensando que me odiabas...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no――”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001296",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, eso lo sé. Después de regresar a esta ciudad y reencontrarme contigo...\nentendí muchas cosas.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001297",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero aun así, aún hay muchas otras que no entiendo. Entre ellas, lo que\nrepresento yo para ti...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0010",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001298",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Una amiga de la infancia como aquel entonces? ¿O quizás solo una molestia\nahora? ¿O una amiga, o una compañera de clases?... No lo sé.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001299",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo siento tanto. Solo con tratarte de manera normal todo el tiempo es\nsuficiente para llevarme al límite. Y por eso, cuando suceden estas cosas, me\naltero, y pierdo toda la compostura.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001300",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si fuera con otro chico normal, podría hacerme la idea de que tenga interés en\nmi ropa interior.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0010",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001301",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero, no sé si realmente tú me puedes ver con esos ojos... En primer lugar, no\nsé siquiera qué represento para ti, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001302",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así que, lo siento. Cuando me dijiste lo de la mirada de doctor hace un\nmomento, pensé 'Ah, ya veo', y me puse un poquito maliciosa.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001303",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aún sabiendo que tenía mi traje de baño debajo, decidí hacer que me quitaras la\nropa como lo haría una pareja, pensando nada más '¿Será que se alterará un\npoco?'...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0010",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001304",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No podía creer que de verdad fueras capaz de verme con esos ojos, Nao- kun.\nEstaba absoluta, completamente convencida de que eso era imposible...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001305",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y por eso, quizás, es que ya sin darme cuenta, terminé haciéndote esa maldad...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ahh, demonios, esta tonta!”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0020",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001306",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Es muy cruel que me digas eso! Aunque no lo creas, aun siendo una tonta, me\npreocupé y pensé en esto.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No es eso! Tú tienes encanto, y yo realmente no puedo verte tampoco con tanta\ncalma...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001307",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Déjame disculparme por haber ignorado tus cartas. De verdad, lo siento\nbastante.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001308",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, ya está bien... Ya, eso debería estar solucionado.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0008",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001309",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Todo el tiempo que estuve afuera y que no recibía respuesta alguna, pensé,\n'¿será que, tal vez?'... Y al regresar acá, y volverte a ver, lo confirmé.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001310",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Siempre haces cosas que al momento no tienen ningún sentido aparente, pero que\nal ver después y pensar, realmente sí tenían un propósito. Lo mencioné ayer,\n¿no, Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0010",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001311",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hay una razón por la cual, por cosa extraña, no respondiste ni me mandaste\nninguna carta. No es por ningún juego, ni tampoco por fastidio...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, ahí te equivocas. De verdad que no hay razón alguna. Realmente fue pereza\nde mi parte...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001312",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto que diré es solo a manera de ejemplo. Solo un ejemplo... Ehm, supongamos\nque me desnudo acá.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0810",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001313",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Supongamos que sea una orden tuya, Nao-kun. Si necesitaras que yo me quite toda\nla ropa para poder enseñarme, entonces yo cumpliría esa orden.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Por qué?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0002",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001314",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Porque eres fiel y honesto, Nao-kun. Por eso, es que si de verdad no hubiera\nsentido alguno en hacer eso, no me lo pedirías. Nunca haces nada sin sentido\nalguno. Y si eso implica lastimar a alguien, menos aún...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me estás sobreestimando mucho... eso no es cierto.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001315",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mientes. Desde hace tiempo has sido un mal mentiroso, Nao-kun, y por eso es\nfácil darse cuenta cuando lo haces.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué sabes eso?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001316",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo sé... Y es que, siempre te he estado observando, desde que éramos niños,\nNao-kun...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0003",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001317",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por eso es que puedo preguntarte sin tapujo alguno. Acerca de qué ropa conviene\nmejor a la hora de las prácticas de dibujo.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Demonios, si sigues diciendo esas tonterías, podría terminar pidiéndote que\nte desnudes.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001318",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Confío en ti, y si esa es tu orden, lo haré, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Confías demasiado... tonta.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0800",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001319",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es que, soy una tonta...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tienes de tonta?...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, demonios, entiendo. ¡Está bien!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, de ser así, entonces mi orden para ti es――”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"fg",mode=-2},
{"bg",file="ev_com_c03_01",rule=139,vague=40,path=":ev/ev_com_c03/",set="ev_com_c03"},
{"bgm",file="bgm007"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001320",ch="rnd"},
},
ja={
{
name={"Rin"},
"“La tela de este traje de baño es particularmente gruesa, y cubre bastante, así\nque funciona bien, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues comparado con los demás, sí...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"En lo que a mí respecta, este traje de baño ya es lo suficientemente excitante.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001321",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así que no hay problema con que haga poses atrevidas, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Que sí! ¡Que sí lo hay!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"bg",file="ev_com_c03_02",sync=0,face=1,time=400,path=":ev/ev_com_c03/",set="ev_com_c03"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001322",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿D-De verdad? Ya veo. Está bien, me reservaré un poco más. Debo\ncomportarme, debo comportarme...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, respecto al punto de juntura de las piernas...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"bg",file="ev_com_c03_03",sync=0,face=1,time=400,path=":ev/ev_com_c03/",set="ev_com_c03"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001323",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Ya entiendo...",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Por culpa mía al haber ignorado sus cartas todo este tiempo, es que la\nautoestima de Rin se vino por el piso...",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"No, no es exactamente eso.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Por más que yo no la halague ni le dé cumplidos, todas las demás personas sí lo\nhabrán hecho seguramente.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"En lo que a su cara respecta, no se queda atrás ante una celebridad como lo es\nShizuku.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Es buena en los estudios y en los deportes.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Es seria, comprometida, responsable.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Es sociable, y sabe bromear, tanto de manera elegante como picante.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"La popularidad que tuvo durante el primer período era absolutamente enorme.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"La razón por la cual su popularidad se ha apaciguado ahora, es porque\nsimplemente casi todos los hombres se le confesaron y fueron rechazados ya.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Bajo esa situación, no hay necesidad ni manera alguna de que su autoestima\nbaje... O al menos debería ser así, pero la realidad es distinta.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Y a pesar de todo, probablemente, Rin tiene la autoestima baja solo ante mí.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Por ser yo, quien la conoce desde hace tiempo. Por ser yo, quien la conoce\ndesde aquella época en la cual no era tan hábil ni perfecta como ahora.\nCuando ni siquiera podía montarse en un columpio...",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Y, aun siendo tan grandes amigos, por haber sido yo justamente quien cortó todo\ntipo de comunicación con ella...",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"Es solo ante mí que Rin, pase todo el tiempo que pase, no logra tener confianza\nen sí...",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Y por eso...",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bg",file="ev_com_c03_04",path=":ev/ev_com_c03/",set="ev_com_c03"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001324",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, primero comenzamos con la pelvis, pero, de esta línea del bikini a la\ningle...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Guh.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"A pesar de estar en traje de baño, Rin comenzó de repente a inspeccionar su\npropio cuerpo con las piernas abiertas.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"¿S-Será por eso que es capaz de hacer este tipo de poses... con toda calma?",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"¿Por tener una autoestima muy baja frente a mí?",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"No, no, ciertamente está en traje de baño, y la tela es relativamente amplia,\npero aun así, esa pose es un tanto...",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Ehm... ¿Rin-san?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bg",file="ev_com_c03_05",sync=0,face=1,time=400,path=":ev/ev_com_c03/",set="ev_com_c03"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001325",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sí? Ah, ¿q-quizás es un poco indebido esto? ¿Esta pose no está bien?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah, no, para nada! ¡Claro que puedes quedarte así, oh sí!”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Se me escapan unas palabras extrañamente articuladas.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
"¡Pero qu--! ¡¿Por qué no haces que se detenga?! ¡Obviamente que esa pose no\nestá bien! ¡¿No?!",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, en la articulación de la cadera la zona interior es importante... sí, sí.\n¿Seguimos entonces con esa misma pose~?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bg",file="ev_com_c03_06",sync=0,face=1,time=400,path=":ev/ev_com_c03/",set="ev_com_c03"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001326",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué alivio. Sinceramente, no hay otra pose que pueda tomar para que me revises,\nasí que me pone tranquila saber que puedo seguir así.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, es verdad.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"¡Eh! ¡Espera un momento! ¡¿Pero qué estoy haciendo?!",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"bg",file="ev_com_c03_04",sync=0,face=1,time=400,path=":ev/ev_com_c03/",set="ev_com_c03"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001327",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hay un tendón acá, ¿verdad? Este músculo es... le llaman el músculo sartorio,\n¿cierto?...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bg",file="zev_com_c03_04",zoom=70,x=70,y=-210,speed=500,time=0,sync=0,z2=50,path=":ev/ev_com_c03/",set="ev_com_c03",x2=0,y2=0,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se9031",id=1},
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sí, muéstrame mejor.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001328",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Acá.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"bg",file="zev_com_c03_04",zoom=80,x=70,y=-320,speed=500,time=0,sync=0,z2=70,path=":ev/ev_com_c03/",set="ev_com_c03",x2=70,y2=-210,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se9031",id=1},
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sí, muéstrame mejor.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001329",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No lo ves? Este.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"bg",file="zev_com_c03_04",zoom=100,x=70,y=-540,speed=500,time=0,sync=0,z2=80,path=":ev/ev_com_c03/",set="ev_com_c03",x2=70,y2=-320,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se9031",id=1},
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sí, muéstrame mejor.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001330",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Aún no lo puedes ver? E-Esto... ehm... e-esta parte...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Con la cara totalmente sonrojada, Rin abre aún más sus piernas.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"se",file="se9031",id=1},
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sí, muéstrame mejor.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Rin abre sus piernas hasta más no poder, casi insinuando '¿Aun así no puedes\nver?'.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Examino muy bien con mis ojos esa parte.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Tan fijamente que podría abrir un hueco con mi mirada.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"......",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"se",file="se3130",vol=50,id=1},
{"bg",file="zev_com_c03_07",zoom=50,x=0,y=0,speed=200,time=0,z2=100,path=":ev/ev_com_c03/",set="ev_com_c03",x2=70,y2=-540,ax=1920,ay=1080,bx=-960,by=-540},
{"quake"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
"¡Esto no está bien! ¡Esto no está nada bien!",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"No, espera, espera, este proceso es esencial en el proceso de enseñanza.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"¡No, no, no es cuestión de si es esencial o no! ¡A nivel ético, a nivel moral,\nno, está, bien!",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"¿De qué manera debería enseñarle entonces?",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"El método de tocar el cuerpo, examinar los lugares y las funciones de los\nmúsculos y enseñar la manera de dibujarlos es correcta.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Y en realidad, yo también tomé las mismas poses y practiqué inspeccionando mis\nmúsculos cuando papá me enseñó.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Por cierto, papá tomó también las mismas poses, así que la práctica como tal se\nprestó para una vista bastante ridícula...",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"¿Debería tomar yo entonces la misma pose?",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"¿DE ESO SE TRATA REALMENTE EL PROBLEMA?",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001331",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Abriendo tanto las piernas... s-se forma una concavidad acá, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"bg",file="zev_com_c03_07",zoom=70,x=70,y=-210,speed=500,time=0,sync=0,z2=50,path=":ev/ev_com_c03/",set="ev_com_c03",x2=0,y2=0,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se9031",id=1},
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sí, muéstrame mejor.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001332",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Esto, no puedes verla? Aun cuando estoy abriendo tanto las piernas...”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"bg",file="zev_com_c03_07",zoom=100,x=70,y=-540,speed=500,time=0,sync=0,z2=70,path=":ev/ev_com_c03/",set="ev_com_c03",x2=70,y2=-210,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se9031",id=1},
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sí, muéstrame mejor.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001333",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿A-Aún no puedes verla? Esta concavidad acá. U-Uhh... s-si abro más las\npiernas, se me acalambrarán.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"bgm",stop=1,time=500},
{"se",file="se9031",id=1},
{"mwact",act="うんうん"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sí, mues――”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"bg",file="ev_com_c03_05",sync=0,face=1,time=400,path=":ev/ev_com_c03/",set="ev_com_c03"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001334",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿S-Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mue――”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001335",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Ehh? ¿Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=-200,y=-580,file="zbg025a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"bgm",file="bgm012"},
{"se",file="se3130",id=1},
{"quake",mode="mw"},
{"quake"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mu―― ¡WaaAaaahhh! ¡Gugyaaaaahhhh!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Me tumbo en el suelo.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001336",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué sucede? ¡Nao-kun! ¡¿Estás bien?!”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"cgact",stage="zbg025",act="いいえ",loop=-1,time=500,size=100},
{"quake"},
{"quake",mode="mw"},
{"se",file="se3130",id=1},
{"text"},
delay={
[300]={
{"se",file="se3130",id=2},
},
},
text={
ja={
{
name={"Naoya"},
"“¡Gugyaaaah! ¡Ah! ¡Aaahh! ¡Hiiin!”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"msgoff"},
{"bg",file="zbluesky_winter",id=9,lv=9,speed=180000,time=500,sync=1,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"¿Será esto un castigo del Cielo? No, seguramente fue una advertencia del mismo.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Mientras veía la zona de los genitales de Rin, mis propios genitales se fueron\nhinchando cada vez más.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"Si fuera un pantalón holgado, no hubiera habido problema alguno.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Sin embargo, hoy vine con ropa casual. Y para más colmo, en jeans.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"se",file="se1437",id=1},
{"text"},
text={
ja={
{
"Una fuerte constricción ataca mis partes hinchadas.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Aunque, si solo fuera eso, no hubiera lanzado ningún chillido.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"No cabe duda que de ser ese el caso, hubiera simplemente ajustado la posición\nde mis partes para que no doliera más, para luego seguir observando la zona\ngenital de Rin, ocultando mi cosa hinchada con una cara de yo no sé nada.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Sin embargo, Dios realmente existe.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Estuvo aquí.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Dios preparó un castigo con todas las de la ley para los pecadores como yo.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Me es algo penoso decir esto, pero mi 'cosa' tiene algo de piel cubriéndola.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Tanto la piel como los vellos se enredaron alrededor de mi cosa erecta.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Los vellos se enredan intrincadamente dentro de los ya apretados jeans y\nalrededor de mi cosa hinchada. Estaba tan congestionada, que sentía que los\nvellos terminarían arrancándome todo.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"El terrible dolor de sentir como mis vellos son arrancados de un solo golpe\nmientras otros más envuelven y aprietan mi cosa como si fueran hilos.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Sinceramente, no puedo mantener la calma en esta situación.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Lancé un agudo chillido.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"ex",time=500,func="wait"},
{"excall",file="03_olympia_02_3"},
{"text"},
linkback="block_00215",
},
label = {
top={block="block_00000",label=1},
},
}
