astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"bg",file="ev_eye_c14_01",path=":ev/ev_eye_c14/",set="ev_eye_c14"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="bluesky_spring",time=1500,sync=1,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Estaba por comenzar marzo, y la entrega de reportes de planes a futuro de los\nestudiantes llega a su fin. El ajetreo en la sala de profesores aumenta a\nmedida que se acerca la graduación.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Graduación.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Hace varios años, cierta estrella de rock se preguntaba '¿Y qué demonios\ncambiará al graduarme?'",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Todo va a cambiar para ustedes. ¿No es acaso obvio?",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Sea cuales sean sus planes futuros, después de graduarse todo cambia. Ya no\nllevarán uniforme, ni tendrán que venir todas las mañanas acá.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Por un largo tiempo lo interpreté de esa forma, pero al parecer lo que\nrealmente quiso preguntar esa persona fue '¿Qué descubrimos al graduarnos?'.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"cgdel",id=-1},
{"bg",file="ev_com_j01_01",path=":ev/ev_com_j01/",set="ev_com_j01"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"El humo del cigarro se esfuma en la inmensidad del cielo.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"El invierno llegaba a su fin.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Eran los últimos días de febrero y marzo se acercaba.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Febrero es un mes extraño.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Los primeros diez días se sienten como los más fríos del año. Los siguientes\ndiez días no cambia mucho eso.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Pero en sus últimos días, el cielo se despeja y los mediodías se hacen cálidos.\nLa llegada de marzo desplaza el frío cielo de invierno y trae un agradable\ncalor consigo.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Aunque ese frío de invierno regresa apenas cae el sol...",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"De esa forma se comporta el cielo en esta época.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fiuu... Qué bueno este cigarro...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Desde la azotea puedo ver a los estudiantes de tercer año dirigiéndose a la\nsala de profesores.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"No logro alcanzar a ver la expresión en sus caras, pero van trotando,\nvisiblemente alegres.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Universidad, instituto, trabajo. A lo que hayan aspirado, deben haber recibido\nbuenas noticias.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué inmenso se ve el cielo...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Este edificio está situado sobre la colina de Yumihari. Y aun estando acá, el\ncielo se hace enorme.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"La enormidad del cielo no cambia, por más alto que sea el edificio donde estés.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Obvio, lo es. Misterioso, también.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"No he tenido a ningún estudiante venir llorando a reportarse conmigo.\nLa ceremonia de graduación era algo sin importancia para mí.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Si bien soy profesor, es como si no lo fuese.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Soy parte del colegio, pero es como si no lo fuese.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Estando en esta ambigua posición, veo cada año el mismo panorama, desde el\nmismo lugar. Indiferente, sin relevancia particular.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Cada año cierta cantidad de estudiantes se gradúan, y cierta cantidad de\nestudiantes entran.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Y por más que termine la ceremonia, si nada cambia nada se descubre.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"El humo se esfuma en el cielo.\nUn débil viento se lo lleva, desapareciéndolo rápidamente de mi vista.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"se",id=1,file="odoor"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000001",ch="skr"},
},
ja={
{
name={"???"},
"“¡Profesor Kusanagi! ¡¿Otra vez fumando acá?!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Se escucha el estruendoso sonido de la puerta metálica abriéndose, y junto a él\nuna tierna voz quejándose.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ah, sí... Perdón, perdón...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Volteo, procurando inmediatamente mostrar una apenada sonrisa y una disculpa.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"msgoff"},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="桜子",size="z1",mx=40,mode=3,resize=1,path=":fg/sku/z1/",file="sku_z1a0200",face="a0013",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000002",ch="skr"},
},
ja={
{
name={"???"},
"“Dios mío, que una estudiante del comité de moral y disciplina amoneste a un\nprofesor es absurdo...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón. Me muero de la vergüenza.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0005",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000003",ch="skr"},
},
ja={
{
name={"???"},
"“¡No venga con eso ahora! ¡Esa actitud da muy mal ejemplo a los estudiantes!”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero por acá casi no circulan alumnos...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0004",head="sku_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0011",head="sku_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000004",ch="skr"},
},
ja={
{
name={"???"},
"“¡Ese no es el problema! Además, este colegio tiene una sala de fumadores. Si va\na fumar, hágalo allá.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, pues, sí. Mejor allí...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0004",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000005",ch="skr"},
},
ja={
{
name={"???"},
"“¿Mejor allí? ¡Es justamente allí donde normalmente debería fumar!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Créeme que lo siento. Procuraré hacerlo eso de ahora en adelante.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Obviamente estoy mintiendo.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Fumar en la sala de fumadores es un dolor de cabeza.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Ir allá implica encontrarme con los otros profesores que llevan más tiempo acá.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Además, fui estudiante de este colegio. Encima de eso, entre ellos hay algunos\nque se llevaron una mala impresión de mí cuando era alumno.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"En particular, hay unos cuantos que todavía están molestos conmigo por lo del\nmural.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"No lo niego, fui algo rebelde en ese momento... supongo, pero igual, tampoco\ndeberían arrastrar ese rencor por tanto tiempo.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Sea lo que sea, si no fuese por la directora Toritani, un idiota descuidado\ncomo yo no hubiese podido ingresar a trabajar como profesor... a tiempo\nparcial, pero profesor después de todo.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"En conclusión, mi relación con los otros profesores mayores no es muy buena. Y\nestar en la misma sala de fumadores con ellos es incómodo.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Cabe destacar además que la jerarquía entre profesores se manifiesta con\nfacilidad en la sala de fumadores.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Podría decir que es el lugar que menos me gusta de este colegio.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0013",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000006",ch="skr"},
},
ja={
{
name={"???"},
"“Fiuu, qué mentira.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000007",ch="skr"},
},
ja={
{
name={"???"},
"“Planea fumar de nuevo acá, ¿no, profesor Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm, así es. Agradecería que en ese momento me perdones la ofensa así como hoy,\nSakizaki-kun.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0009",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000008",ch="skr"},
},
ja={
{
name={"Sakizaki"},
"“Definitivamente usted es de lo peor como profesor.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uhm, definitivamente. El peor profesor.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0011",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000009",ch="skr"},
},
ja={
{
name={"Sakizaki"},
"“A este paso acabarán despidiéndole.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sería terrible si eso sucediera.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0001",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000010",ch="skr"},
},
ja={
{
name={"Sakizaki"},
"“Habla usted como si no fuese asunto suyo.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te creas. Incluso un tipo como yo tiene mucho de qué preocuparse.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_skr_000011",ch="skr"},
},
ja={
{
name={"Sakizaki"},
"“Pues no parece estar tan preocupado...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Digamos que no soy muy expresivo con mis preocupaciones.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0011",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000012",ch="skr"},
},
ja={
{
name={"Sakizaki"},
"“La verdad es que sí lo parece...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"msgoff"},
{"se",file="se9012",id=1},
{"fg",ch="桜子",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="桜子",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/sku/z2/",file="sku_z2a0210",face="a0011",head="sku_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Sakizaki-kun se para a mi lado, malhumorada.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Su primer nombre es Sakurako. Su nombre completo es realmente elegante. Es una\nalumna muy responsable, perteneciente al comité de disciplina y moral. A\npartir del próximo año fiscal comienza su tercer año.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Con frecuencia me encuentra fumando acá en la azotea en mi intento de alejarme\nde los otros profesores. Pero aun así no ha hecho más que amonestarme.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Si los profesores se enteran se armará un gran lío.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hasta qué hora piensas quedarte acá?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0001",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000013",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Hasta que usted termine de fumar ese cigarro.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tranquila, no lo dejaré tirado por ahí.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0004",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000014",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Si llega a hacer eso le contaré a los otros profesores y haré que lo despidan.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uweeh, qué miedo, qué miedo.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0002",head="sku_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0003",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000015",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Es broma, en parte.\nSe meterá en problemas si algún otro profesor o alumno lo descubre,\ny estoy vigilando por su bien.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, agradezco el gesto, pero... no creo que llegue a cometer semejante\ndescuido.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0002",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000016",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Sabe cuántas veces lo he descubierto yo?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes toda la razón...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0009",head="sku_z2b",lv=5,id=9},
{"fgact",ch="桜子",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000017",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Fiuu, usted nunca intenta llevarme la contraria. Siempre está de acuerdo con lo\nque digo...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, sucede que siempre dices lo correcto, Sakizaki-kun.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0001",head="sku_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000018",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Eso le parece?...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí me parece...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Tomo una buena bocanada de humo del cigarro, y lo aplasto en mi cenicero\nportátil.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_skr_000019",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Hasta cuándo piensa quedarse en este colegio, profesor?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues ni idea. Hasta que me despidan, supongo.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_skr_000020",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Seguirá el año que viene?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aún no he recibido carta de despido alguna, así que no hay problema por eso,\ncreo.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0008",head="sku_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000021",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Escuché de los otros profesores que su situación cambiaría el próximo año\nfiscal, o algo así. ¿Es cierto?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Hablas en serio? Me acabo de enterar, qué miedo.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0001",head="sku_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000022",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Los escuché charlando de manera amena al respecto, así que pensé que usted\nsabría...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé nada de eso, nada. ¿Y bien? ¿Qué harán conmigo?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0001",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000023",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No me pregunte eso a mí, solo soy una simple alumna. Yo tampoco sé y por eso\nvine a preguntarle.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces lo del despido lo escuchaste de los otros profesores?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0010",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000024",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No lo escuché de manera directa, simplemente los oí hablando. Mencionaron algo\nde usted y el año que viene...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué harán conmigo el año que viene?!”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0005",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000025",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Y-Ya se lo dije, una simple alumna como yo no podría enterarse de eso.\nPregúntele a los otros profesores.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A los otros profesores...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0008",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000026",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_skr_000027",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Profesor Kusanagi, ¿todavía no se lleva bien con los profesores?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada, nos llevamos excelentemente bien. ¡El colegio Yumihari está repleto\nde buenas personas!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0013",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000028",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Y aun así no tiene el valor de preguntarles usted mismo?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Qué vergüenza.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Será entonces que emitirán la carta de despido en un par de días?... Se supone\nque los despidos son a comienzos de marzo, ¿por qué no me han dicho nada aún?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0008",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000029",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Yo no sé...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Va a ser todo un problema si me despiden. ¿Es que me tocará buscar empleo de\nnuevo, con esta edad?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0001",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000030",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Usted es profesor a tiempo parcial, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tiempo parcial. Podrías decir que es un trabajo a medio tiempo. La paga es\npor hora, y me permiten tomar otros trabajos.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_skr_000031",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Hay otra categoría aparte de tiempo parcial, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, la de tiempo completo. Entras como empleado formal a contrato. No es tan\nbuena como la de empleado permanente, pero tiene sus beneficios.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_skr_000032",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Por ejemplo?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Veamos, soy profesor de arte, así que me dejarían usar la sala de arte a mi\ngusto. Podría fumar y comer butadon a mi gusto en la sala de preparativos.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0011",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000033",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Por qué butadon?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada particularmente especial. Solo que comer butadon a escondidas en la sala\nde arte es parte de mi imagen de un profesor a tiempo parcial.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0005",head="sku_z2b",lv=5,id=9},
{"fgact",ch="桜子",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0013",head="sku_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000034",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Y de dónde viene esa imagen? Usted no hace esas cosas, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aparte de profesor también fui alumno de este colegio. Digamos que tuve muchas\nvivencias acá.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0002",head="sku_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000035",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“He escuchado que usted se graduó de una universidad nacional.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, de Geidai. La número uno de arte en el país.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0001",head="sku_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000036",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Entrar a esa universidad es bastante difícil, he oído. ¿Cómo es que terminó de\nprofesor a tiempo parcial con ese currículo?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, ni idea. Tanto esfuerzo que invertí buscando empleo, ¿cómo habré\nterminado así?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_skr_000037",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Tanto así se esforzó?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, apliqué a unas dos compañías.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0005",head="sku_z2b",lv=5,id=9},
{"fgact",ch="桜子",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000038",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡No le veo nada de esfuerzo a eso!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es que los entrevistadores son siempre arrogantes. Son expertos en quebrar la\nmotivación de la gente.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0004",head="sku_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000039",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Pues creo que su motivación se quebró un tanto muy rápido!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo niego.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0009",head="sku_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000040",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Siempre usted y su modestia, profesor Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Molestia? ¿Molesté a alguien?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0005",head="sku_z2b",lv=5,id=9},
{"fgact",ch="桜子",act="うんうん",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2b0200",face="b0008",head="sku_z2b",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000041",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Modestia! Siempre ocultando sus cualidades.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te parece?... La verdad es que no intento ocultar nada. Además, ¿a quién\npodría interesarle detalles sobre mí?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0002",head="sku_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0003",head="sku_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000042",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿Ah, sí?!¡Así que nadie se interesa por usted, eh!”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Vaya énfasis que ha puesto en algo tan negativo.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0002",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000043",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Que se haya graduado de una universidad de artes significa que puede dar clases\nformales de arte, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué te refieres con formales? Si es por dar clases en un colegio sí puedo\nhacerlo.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0001",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000044",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Con formales me refiero a clases de pintura para aquellos estudiantes que\naspiran a universidades de artes.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En ese caso no puedo.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0005",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0011",head="sku_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000045",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿P-Por qué? Es usted un profesor de artes, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual manera no te conviene ir a una universidad de artes.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0005",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000046",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿Por qué?! ¡Mis calificaciones en arte siempre han sido cinco!”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo sé. Yo también te he colocado un cinco anteriormente.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000047",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Por qué no entonces?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Comienzas el tercer año el próximo año, ¿cierto? No te alcanzará el tiempo.\nPara entrar a una universidad de artes necesitas prepararte desde primer año.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0007",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="びっくり",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0200",face="a0008",head="sku_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000048",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Desde primer año? ¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Personas como tú que pintan bien no se dan cuenta. Mejor ejemplo sería una\nuniversidad de música, tal vez. ¿Quién en su sano juicio intentaría entrar a\nuna por cuenta propia solo porque le gusta la música?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las universidades de artes son iguales, necesitas cierta preparación. Por lo\ngeneral de dos a tres años, según dicen.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0009",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000049",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“N-No sabía...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay un estilo de pintura apropiado para esos exámenes de ingreso. Eres buena\npintando, sí, pero no aprobarás el examen solo pintando lo que te dé la gana.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0005",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000050",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“N-No hay forma de saberlo a menos que lo intente.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todos los que aspiran a entrar a una universidad de artes son buenos pintando.\nSobresalir entre esa multitud es difícil estudiando por cuenta propia.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0008",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000051",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque tus calificaciones son buenas, podrías cubrir la parte práctica con eso.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0005",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000052",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pues entonces--”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues entonces ve a una escuela preparatoria de artes, como debe ser. No pongas\ntodas tus esperanzas en un simple profesor.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y además, es importante elegir una buena escuela. Tienes Suibata, Shinbi,\nOchabi... Son las típicas a elegir.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En conclusión, a una universidad de artes solo pueden entrar personas que hayan\nestudiado previamente en escuelas de ese tipo.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0009",head="sku_z2a",lv=5,id=9},
{"fgact",ch="桜子",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000053",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual forma, no pidas mucho de un instructor a tiempo parcial como yo...\nAdemás, podría acabar en la calle pronto...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="桜子",size="z2",mode=3,path=":fg/sku/z2/",file="sku_z2a0210",face="a0013",head="sku_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000054",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Realmente habla como si no fuese asunto suyo...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te creas, esto me tiene alterado.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="桜子",size="z1",mode=3,resize=1,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000055",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ahora que lo recuerdo, el colegio Yumihari no tiene club de arte, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0010",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000056",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“He escuchado que este colegio ha egresado a numerosos artistas, tales como\nKenichiro Kusanagi, fallecido hace diez años, y Rin Misakura, quien ha estado\ntrabajando internacionalmente...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0002",head="sku_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000057",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿No conoce a ninguno de los dos, profesor Kusanagi? A Kenichiro Kusanagi, por\nejemplo.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, creo saber de él tanto como sabría cualquier otra persona...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0009",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0002",head="sku_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000058",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Vaya... Teniendo el mismo apellido se me ocurrió que quizá habría algo, aunque\nsupongo que tener el mismo apellido no quiere decir que tengan relación\nalguna.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"En ningún momento he dicho que no tengo relación con él...",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000059",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ahora que lo pienso, ¿no tiene usted la misma edad que Rin Misakura?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea. Tal vez.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000060",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Llegó a conocerla?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estoy muy seguro... ¿Conocida, ella? No lo sé...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0007",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000061",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Eh? ¿Es que sí se conocían?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizá.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000062",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡P-Pues entonces--!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sakizaku-kun, ¿conoces a Kiyokazu Sato? Sección cuatro.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0009",head="sku_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0013",head="sku_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000063",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Sato? ¿Kiyokazu? ¿Q-Quién es?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No conoces a Kiyokazu Sato de la sección cuatro. ¿No quiere eso acaso decir que\nser del mismo año no implica conocerlos a todos, Sakizaki-kun?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0008",head="sku_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000064",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ah, conque a eso se refiere... P-Pero, Rin Misakura es famosa. Sato es una\npersona común y corriente, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nadie conocía a Rin Misakura cuando estudiaba acá. Fue al ganar el Platine\nÉpaulard que se volvió famosa.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0003",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000065",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ya veo. Increíble, solo dos han logrado conseguir ese gran premio, y sin\nembargo ella lo logro mientras estudiaba acá.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ahora que lo recuerdo lo ganó estando todavía acá...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000066",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Los genios verdaderamente existen.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. El mundo está lleno de genios, muy por encima de nosotros.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0008",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000067",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“... Creo que me hice demasiadas expectativas.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acerca de?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0002",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000068",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“La verdad es que hace poco descubrí al artista Kenichiro Kusanagi, y fue ahí\nque me enteré que Rin Misakura se graduó en este colegio.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? ¿No lo sabías?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0010",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000069",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Habiéndose graduado de esa famosa universidad en Londres y de aquella eminente\nescuela de posgrado en Estados Unidos, no creo que nadie le preste atención a\nsu colegio acá en Japón.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0002",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000070",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Nadie se imaginaría que tal estrella se graduó acá.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo... Así que ni los propios alumnos de Yumihari conocen su pasado acá...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0001",head="sku_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0002",head="sku_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000071",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Yo sí conocía las obras de Kenichiro Kusanagi. El famoso 'Cerezos recostados',\npor ejemplo. Apareció frecuentemente en la tele cuando murió, yo todavía\nsiendo niña. Aunque parece que toda la fama en el mundo del arte la tiene Rin\nMisakura ahora.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las revistas de arte comparan a los dos con frecuencia, aunque no ves nada de\neso en la televisión. Quizá eso dé la impresión de que Kenichiro Kusanagi ha\nsido olvidado...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0007",head="sku_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0010",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000072",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Ah, en serio? Jamás he comprado una revista de artes...\nYa veo, también existe esa clase de medio...”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad es que últimamente no se diferencian mucho de revistas de\nsubcultura...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000073",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Lo que quiero decir es que, Yumihari ha egresado a dos artistas de renombre\ninternacional y a pesar de eso no tiene club de arte.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0010",head="sku_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000074",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Eso es lo que no entiendo. Ah, aunque sí hay rama de música, de donde han\nsalido muchos músicos famosos. Por eso tenía la imagen de que Yumihari era\nfamosa por la música.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tiene sentido, la sección de música posee un gran legado. Aunque sí, Yumihari\nno tiene sección de arte, así que no es extraño que ningún joven acá sepa qué\nha sucedido...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"msgoff"},
{"fg",mode=-2},
{"bg",file="zbluesky_spring",speed=240000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Yumihari ya no tiene club de arte.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"Ese que tantas vivencias me dio con Kei, Toritani, Hikawa, Kawachino, Akashi y\nThomas, y con la ahora famosa Rin Misakura.\nEse club de arte donde pasé tanto tiempo con todos, ya no existe.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Según parece, después de graduarnos, Hikawa y Kawachino se encargaron de él.\nEl logro de Rin hizo que el número de aspirantes al club sobrepasara los cien, o\nalgo así.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"Aunque el club perdió su gloria apenas entré como profesor. El último miembro\ndel club se graduó, y el club quedó abandonado.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Wakata se fue del colegio al mismo tiempo que yo ingresé a trabajar en él.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Parece que un contacto le consiguió un trabajo de profesor formal en un colegio\nen otra región.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Mientras él salía, yo entraba, y no pude despedirme.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"Después de mi graduación no volví al colegio, así que la ceremonia fue la\núltima vez que nos vimos.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"En cualquier momento podré verlo, pensé, y no se me ocurrió que sería la última\nvez que lo vería.\nEs algo irritante eso.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Tuve que llegar a esta edad para darme cuenta que las despedidas ocurren sin\nfecha fija.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Apenas te das cuenta la distancia te aparta del otro, y de un día a otro ya no\ncaen las llamadas a su celular.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Me ha pasado una y otra vez.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"Lo mismo ocurrió con Wakata. Cambió su número de celular y no me avisó. Me\nsorprendí cuando lo llamé días después de transferirse y atendió un\ndesconocido.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Debí haberle pedido que me contara más de sus historias con Kenichiro\nKusanagi...",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="fem_skr_000075",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Su cigarro... se apagó.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"mwact",act="びっくり",size=5},
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¡Uwah! Auch, auch.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0009",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000076",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Fuh, hasta usted pone esas caras.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Esas caras? ¿De qué hablas? ¿Cara guapa, quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0013h",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000077",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿E-Es que no le da pena decir esa clase de cosas?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La pena se te va cuando envejeces.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0008h",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000078",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Usted no ha envejecido tanto...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo que no...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"De tanto pasar mis días entre jóvenes, a veces me siento como un Taro Urashima.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Mientras que los estudiantes alrededor permanecen jóvenes... solo yo envejezco.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Todos se gradúan y emprenden sus propios caminos.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Es como si todos me estuviesen dejando atrás.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre damos la misma clase todos los años, supongo que lo sabrás.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000079",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Sí, así parece.”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mientras que ustedes se gradúan, nosotros hacemos lo mismo cada año. Quizá por\neso me siento más viejo de lo que soy...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque supongo que a tus ojos sí soy uno, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0011h",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0010h",head="sku_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000080",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“P-Por supuesto que no. Usted todavía luce joven, o al menos eso pienso yo. Casi\ncomo un universitario.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uwaah... tampoco me gusta tanto eso. Hay que tener cara de idiota como para\naparentar ser más joven de lo que se es.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001",head="sku_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000081",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, da la impresión de que nunca sufres de estrés...\nBueno, no niego que realmente no tengo estrés alguno ahora.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000082",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Sin duda alguna. De lo que he observado, usted y el estrés no tienen nada que\nver uno con el otro.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, también es porque soy profesor de tiempo parcial. No tengo esa\nconvicción que tendría uno normal, busques donde busques.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0009",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000083",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pero podrían despedirlo...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eso me está matando del miedo! Ahora que me he enterado de eso, tiemblo de\nterror.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0013",head="sku_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001",head="sku_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000084",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Es eso cierto? Usted siempre lo ve todo como si no fuese asunto propio, o al\nmenos así pareciera.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no. Yo también lucho con el día a día. La vida se hace tan difícil\nque todo lo demás pierde interés.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0005",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000085",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Usted será profesor de tiempo parcial, pero sigue siendo un educador. No se\natreva a volver a decir algo tan patético frente a un alumno.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues dentro de poco podría ser solo un viejo desempleado.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0009",head="sku_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000086",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Realmente le preocupa tanto? La verdad es que no pareciera...”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es eso. Solo que no suelo mostrar mucho mis emociones.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001",head="sku_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000087",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“... A veces lo encuentro mirando a lo lejos, profesor.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A lo lejos?”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0008",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000088",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Sí, pareciera estar observando algún lugar lejano, distinto a este.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Algún lugar lejano, distinto a este...”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000089",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Sí.\n¿Será que dije algo fuera de lugar?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué lo dices?”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
vo={
{"vo",file="fem_skr_000090",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Estaba usted sonriendo...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sonriendo? ¿Yo? Pues supongo que sí habrá estado fuera de lugar el comentario.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000091",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿A qué viene eso ahora?!”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, bueno, se acabó la charla. El profesor Kusanagi debe regresar a la sala\nde profesores.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000092",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Mentiroso.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es mentira.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000093",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Profesor, usted nunca va a la sala de profesores. Además, siempre que sus\nclases terminan usted o viene acá a fumar, o regresa a su casa.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, sí...”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"Sakizaki-kun es perspicaz.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"La 'sonrisa' que ella mencionó era en realidad una sonrisa amarga.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"Un lugar lejano, distinto a este...",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"msgoff"},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Esos días que viví con Kei Natsume.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
delay={
[500]={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",x2=0,x=1500,lv=4,id=9},
},
[1000]={
{"fg",ch="真琴",size="z1",mx=-1280,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1b0100",face="b0005",head="mak_z1b",lv=4,id=9},
},
[1500]={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0009",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
},
},
text={
ja={
{
"También estaban Toritani y Akashi.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0200",face="b0004",head="rna_z1b",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0210",face="b0004",head="yum_z1b",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
[200]={
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
},
},
text={
ja={
{
"Vino Hikawa, y con ella Kawachino.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Y Rin regresó también a la ciudad.",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"fg",ch="トーマス",size="z1",sync=1,mx=-40,mode=3,resize=1,path=":fg/tho/z1/",file="tho_z1a0200",face="a0001",head="tho_z1a",x=-900,lv=4,id=10},
{"text"},
delay={
[500]={
{"fg",ch="トーマス",mode=3,path=":fg/tho/z1/",file="tho_z1a0200",face="a0001",head="tho_z1a",x2=-900,x=-1500,lv=4,id=10},
},
},
text={
ja={
{
"También estaba Thomas. Sí, al que nadie le prestaba atención.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"Esos tiempos fueron divertidos.",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"cgdel",id=-1},
{"fg",mode=-2,sync=0},
{"bg",file="ev_com_a34_01",path=":ev/ev_com_a34/",set="ev_com_a34",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Aquella noche de verano.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
"Terminamos el mural.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"Aquel mismo mural que fue herencia de Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"Lo terminamos, aun cargando con el riesgo de ser expulsados.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
"Después de eso, todos intentamos presentar algo en la Exposición Moore.",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
"Yo aparentaba desinterés, pero por dentro estaba divirtiéndome como nunca. Cada\ndía era de alegría.",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Hasta ese día.",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
"El tiempo se congeló dentro de mí cuando él murió.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
"Por eso Rin siguió caminando adelante.",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"Más allá de ese lugar donde yo me detuve.",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
"Pincel en mano, siguió pintando, como si llevase ahora la voluntad de Kei.\nY ahora se convirtió en algo mucho más grande que el mismísimo Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
"Kei, su muerte. Yo, mi brazo.",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
"Pareciera intentar compensar por todo eso con su actividad artística.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"Probablemente esa fue la manera que eligió de asumir su cruz.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
"Aquí estoy.",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
"Siempre acá, detenido.",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"Y mientras yo he seguido sin dar un paso, todos los demás han labrado sus\nsenderos.",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"bg",file="zbluesky_spring",speed=240000,id=1,lv=5,path=":cg/",x2=0,y2=-540,x=-960,y=-540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Rin Misakura.\nShizuku Natsume.",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
"Makoto Toritani.",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
"Rina Hikawa.\nYuumi Kawachino.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"Wataru Akashi.",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"Thomas...",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
"Todos los miembros del club de arte se han ido de la ciudad.",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
"Al darme cuenta, era yo el único en permanecer todavía en Yumihari.",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
"Acá, de donde todos emprendieron la marcha y se alejaron.",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
"Quizá, he estado contemplando desde acá algo muy lejano, fuera de mi alcance.",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
"Esos lejanos recuerdos...",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"Y quién diría que uno de mis alumnos lo descubriría tan fácilmente.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
"Es simplemente patético.",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, bueno, cerraré la puerta. Vamos, vamos.”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0007",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0011h",head="sku_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000094",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Wah, oig--, no me toque. ¡Esto es acoso sexual!”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me crees capaz de hacer algo así con una niñita?”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0005h",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000095",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0004h",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000096",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Está bien. Le informaré al profesor consejero que usted estuvo fumando en la\nazotea durante el receso del mediodía.”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué?!”",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"msgoff"},
{"bg",file="bluesky_spring",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Así como ven, sigo todavía acá.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
"La universidad me quedaba en la capital, pero no tenía dinero para la\nresidencia, así que me tomaba todos los días dos horas solo de ida para ir.",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
"Los viajes eran muy largos, así que me gradué sin conseguir ni un solo amigo. Y\nahora estoy subsistiendo acá en Yumihari como profesor a tiempo parcial.",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
ja={
{
"Estaría mintiendo si digo que no tengo preocupaciones.",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"text"},
text={
ja={
{
"Aunque debo decir que mi día a día es bastante tranquilo.",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"text"},
text={
ja={
{
"Obviamente no estoy casado.",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
"En realidad, todavía no he logrado conseguir una novia.",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
"¡Un soltero sin ataduras!",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
"Ahorros, tengo.",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
ja={
{
"Aunque es porque tuve que vender el apartamento. No podía aguantar el enorme\nimpuesto predial anual.",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
"Si bien viví varios años de mi vida ahí, no podía costear el impuesto predial\nde ese lugar con mi salario como instructor a tiempo parcial.",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
"Pasé el dinero a mi cuenta de ahorros, así que en ahorros tengo un poco más que\notros tipos de mi edad.",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
ja={
{
"Pero los impuestos del año siguiente a la venta del apartamento me vinieron\ncomo un baño de agua fría.",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
"Si bien vendí mi única propiedad, el dinero obtenido también es considerado\ncomo ingreso.",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
ja={
{
"Los impuestos de este país son una locura. No tengo otra forma de describirlo.",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
"Según me enteré, no hubiese sido tan grande la suma de haber consultado con un\nasesor de impuestos... Pero eso no lo sabía...",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
ja={
{
"Aunque debo considerarme afortunado. A pesar de la vida que llevo, tengo\nahorros.",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="06_vl_01_2"},
{"text"},
linkback="block_00317",
},
label = {
top={block="block_00000",label=1},
},
}
