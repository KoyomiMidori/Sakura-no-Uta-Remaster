astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_aid_000876",ch="aid"},
},
ja={
{
name={"???"},
"“¡¿Qué diablos estás haciendo?!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000326",ch="knd"},
},
ja={
{
name={"Kana"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_aid_000877",ch="aid"},
},
ja={
{
name={"???"},
"“¿Haciendo llorar a una alumna de otro colegio en tan concurrido lugar? ¿Pero\nqué demonios hiciste, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa voz... Ai.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0005",head="aix_z1e",x=-345,lv=4,id=5},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0005",head="kan_z1a",lv=4,id=9},
{"fg",ch="香奈",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0005",head="kan_z1a",x2=0,x=345,lv=4,id=9},
{"bgm",file="bgm039"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000327",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Q-Quién eres tú?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000878",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ese uniforme, ¿eres del colegio Sakuragahara? Soy profesora del colegio\nYumihari.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"¿Colegio Sakuragahara? Ese es el colegio público que está cerca de casa.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0013",head="kan_z1a",x=345,lv=4,id=9},
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000328",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿P-Profesora de Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0006",head="aix_z1f",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0018",head="aix_z1f",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000879",ch="aid"},
},
ja={
{
name={"Ai"},
"“Veo que hay problema entre los dos, ¿podrían venir conmigo a la sala de\nprofesores? Siendo de otro colegio quizás no estés enterada, pero este\nmuchacho, Kusanagi, ha estado causando muchos problemas últimamente...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0014",head="kan_z1a",x=345,lv=4,id=9},
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
},
vl02={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0011",head="kan_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000329",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, n-no, Kusanagi-kun no ha hecho nada malo... y, esto, no es la gran cosa...\neh, esto...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0005",head="aix_z1f",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000880",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Si no es la gran cosa entonces por qué estás llorando en este lugar tan\nconcurrido? Ven, vamos a la sala de profesores. Te prometo que no pasará nada\nmalo.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",x=345,lv=4,id=9},
},
vl02={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=345,lv=4,id=9},
{"fgact",ch="香奈",act="うんうん",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000330",ch="knd"},
},
ja={
{
name={"Kana"},
"“E-Esto... Aahhh, sucede que me tropecé, y Kusanagi-kun me vio y no sabía qué\nhacer... ajajaja.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, u-uhm... s-sí... ¿supongo?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0006",head="aix_z1f",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000881",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ohhh, ¿llorabas porque te tropezaste? Estaba convencida de que era otra\nfechoría más de este muchacho.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fgact",ch="香奈",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",x=345,lv=4,id=9},
{"fgact",ch="香奈",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000331",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ajajaja, n-no, para nada. No es nada grave, ¿verdaad, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues, sí... supongo.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0018",head="aix_z1f",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000882",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Entonces sí te tropezaste? ¿Quieres ir a la enfermería? La enfermería de\nYumihari está cerca.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0013",head="kan_z1a",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="香奈",act="いいえ",lv=4,id=9},
},
vl02={
{"fgact",ch="香奈",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_knd_000332",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Ah, no hace falta, estoy bien! ¡Bien, me iré ya!”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"se",file="se0744s",id=1},
{"fg",ch="香奈",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"La muchacha que se hacía llamar Nagayama se fue corriendo, como si huyera de\nalgo.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000333",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Ah, nos vemos de nuevo, Kusanagi-kuuuun!”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Esta volteó antes de irse, despidiéndose en voz alta.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hay con esa muchacha?...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Nagayama, dijo que se llamaba... Para nada recuerdo su cara...",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"bgm",stop=1,time=500},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",x=-345,lv=4,id=5},
{"fg",ch="藍",speed=500,mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",x2=-345,x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000883",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ujum... caso resuelto, parece...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1g0000",face="g0001",head="aix_z1g",x=0,lv=4,id=5},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Ai comenzó a caminar.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Espera, Ai.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"se",stop=1,time=500,id=1},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=0,lv=4,id=5},
{"bgm",file="bgm023"},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000884",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué? ¡¿Y cuántas veces te tengo que decir que fuera de la casa soy 'profesora\nNatsume'?!”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, cierto, lo siento. Bueno, profesora Natsume, ¿por qué vino acá?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000885",ch="aid"},
},
ja={
{
name={"Ai"},
"“Porque te vi caminando sobre las cercas de la zona residencial, desde el\npasillo.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, vaya, ¿es que viniste solo para reprocharme por trepar las paredes de casas\najenas? Debes saber que tuve una buena razón para eso.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_aid_000886",ch="aid"},
},
ja={
{
name={"Ai"},
"“No aceleres las conclusiones. Si es por eso no habría venido hasta acá,\nsimplemente me hubiera bastado regañarte en casa, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces por qué...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000887",ch="aid"},
},
ja={
{
name={"Ai"},
"“Porque te vi en problemas. ¿Qué otra razón podría haber?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Ai se detiene y dirige su mirada a la colina de Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_aid_000888",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tu popularidad ha explotado desde que presentaron ese mural. Ser famoso no es\nmalo, pero me puse a pensar que quizá tú no deseabas esta situación.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Viniste a ayudarme?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0008",head="aix_z1e",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000889",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Fue mucha intromisión de mi parte?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, en absoluto. La verdad es que no supe qué hacer cuando comenzó a llorar en\nmedio de la calle.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=0,lv=4,id=5},
{"fgact",ch="藍",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000890",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿En serio? Qué bueno entonces.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_aid_000891",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pensé que alguien más vendría a ayudarte, pero... supongo que nadie se dio\ncuenta.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Alguien más? ¿Quiénes?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",x=0,lv=4,id=5},
{"fgact",ch="藍",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000892",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues, ¿quién sabe? En fin, me alegra saber que te sirvió mi ayuda.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000893",ch="aid"},
},
ja={
{
name={"Ai"},
"“Creo que me iré de vuelta al colegio ya.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien. Gracias, me salvaste de esa.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, sí. Hoy prepararé lo que quieras de cenar, como muestra de agradecimiento.\n¿Qué quieres comer?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_aid_000894",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me gusta todo lo que preparas, no tengo ningún preferido en particular.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí? Lo digo porque pensaba ir de compras hoy al super...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000895",ch="aid"},
},
ja={
{
name={"Ai"},
"“De compras, eh...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya no queda casi nada en el refrigerador. Así que pensé en hacer las\ncompras de la semana.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000896",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Las compras de la semana? Somos muchos en la casa, seguramente va a ser mucho\npeso para ti.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tanto. Aunque me da algo de pena montarme en el tren uniformado y con la\nbolsa de compras llena de comestibles.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fgact",ch="藍",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000897",ch="aid"},
},
ja={
{
name={"Ai"},
"“Huummm. Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000898",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kusanagi, ¿podrías esperarme un momento acá?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Esperarte? ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000899",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya no me queda casi trabajo por hoy, así que pensé en acompañarte a comprar.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Acompañarme?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",x=0,lv=4,id=5},
{"fgact",ch="藍",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000900",ch="aid"},
},
ja={
{
name={"Ai"},
"“Obviamente. ¿Quién más va a hacer las compras?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, un par de manos extras no me caerían mal...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_aid_000901",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bien, volveré entonces a la sala de profesores a arreglar lo que falta y\nvuelvo. Espérame un momento.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Espero acá?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fgact",ch="藍",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000902",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, si vuelves al colegio vas a meterte en aprietos de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón... sobre todo la entrada, era un desastre... Bien, esperaré acá\nentonces.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=0,lv=4,id=5},
{"fgact",ch="藍",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_aid_000903",ch="aid"},
},
ja={
{
name={"Ai"},
"“Uhm, así es mejor. Espérame un momento entonces.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"se",file="se0744s",id=1},
{"fg",ch="藍",mode=-1,lv=4,id=5},
{"text"},
text={
ja={
{
"Ai se va corriendo hacia la colina de Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera un momento, ¿se supone que Ai siempre viene en motocicleta, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="eveningsky_spring01",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"se",file="se9005",id=1},
{"text"},
text={
ja={
{
"Ai vuelve junto al sonido de un estruendoso rugido.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Y ahí estaba la motocicleta. Mach, se llama el modelo, y si bien dicen que es\nrápida, es también una motocicleta realmente extraña.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No me digas que... debo montarme detrás.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"cgdel",id=-1},
{"bg",file="ev_com_i01_07",path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000904",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Quieres montarte?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me niego rotundamente.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="ev_com_i01_01",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000905",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jaja, solo bromeaba. Lo sé, esta moto da miedo cuando no estás aún\nacostumbrada a ella...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, fue terrible...”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"bg",file="ev_com_i01_02",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000906",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aunque en mi caso la primera vez que me monté en ella me divertí como nunca,\nrecuerdo...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo no? Eras tú la que iba manejando.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bg",file="ev_com_i01_01",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000907",ch="aid"},
},
ja={
{
name={"Ai"},
"“Te equivocas, mi primera vez fue también en el asiento trasero.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"bg",file="ev_com_i01_02",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000908",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, bueno. Fue con una de mis personas favoritas, así que supongo que también\nestaba muy feliz.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, ¿esa moto te la dieron?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bg",file="ev_com_i01_03",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000909",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, me la dieron. Podrías decir que también es parte de la herencia de\nKenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Esta es la motocicleta del viejo?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_aid_000910",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿No sabías? Kenichiro-san ha andado en esta motocicleta desde que yo era una\nniña.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo dices en serio?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"bg",file="ev_com_i01_04",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000911",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Jamás lo viste con ella?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El viejo que yo conocí jamás llegó a montarse en una moto, de lo que recuerdo.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"bg",file="ev_com_i01_03",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000912",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ahora que lo dices, creo que dejó de montarla cuando naciste por lo ruidosa que\nera.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dejó de montarla por mí? ¿Era él capaz de semejante consideración?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"bg",file="ev_com_i01_01",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000913",ch="aid"},
},
ja={
{
name={"Ai"},
"“No, fue Mizuna-san, Mizuna nee-san quien se quejó. Siempre solía venir a la\nresidencia Natsume en esta moto, pero Mizuna nee-sama la odiaba.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"No es de sorprenderse, considerando lo estruendosa que es...",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"bg",file="ev_com_i01_02",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000914",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y además, no hay que negar que es algo peligrosa. Supongo que eso le preocupaba\ntambién.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo mencionas, creo que en Nueva York él montaba un scooter. ¿Es\ntambién por eso?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"bg",file="ev_com_i01_05",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000915",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Un scooter?... Definitivamente tu interés por las motocicletas es cero,\nNaoya...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, en serio, me parece que era un scooter... ¿Me equivoco?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_aid_000916",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ese no es el problema, la cuestión es... bah, bueno, supongo que no tiene mucha\nimportancia tampoco...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No entiendo.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_aid_000917",ch="aid"},
},
ja={
{
name={"Ai"},
"“De lo que me dices, es posible que ya hayas visto varias veces esta moto. Solo\nque no lo recuerdas...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? Ahora que dices eso, estás comenzando a convencerme...”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"La motocicleta del viejo...",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Es extraño, ahora que me lo menciona siento que sí la he visto.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"bg",file="ev_com_i01_03",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000918",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bueno, vámonos ya.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_aid_000919",ch="aid"},
},
ja={
{
name={"Ai"},
"“Caminando, por supuesto. Llevaré la motocicleta empujándola.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Vas a llevarla empujándola? El supermercado queda algo lejos.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"bg",file="ev_com_i01_01",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000920",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fufufu, no te preocupes, no en vano entreno constantemente.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"bg",file="ev_com_i01_03",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000921",ch="aid"},
},
ja={
{
name={"Ai"},
"“No es la primera vez que me toca llevarla empujando. A veces se apaga a medio\ncamino y debo empujarla hasta la casa.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué motocicleta tan problemática.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"bg",file="ev_com_i01_02",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000922",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tiene sus años, sí. Aunque, ese aspecto se disfruta también.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No le veo la lógica a eso...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Comenzamos a caminar hacia el supermercado.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, Ai, ¿querías al viejo?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"bg",file="ev_com_i01_04",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000923",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Mm? Esa pregunta fue repentina, eh. ¿Por qué lo dices?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, pues es que dijiste que era una de tus personas favoritas.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"bg",file="ev_com_i01_05",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"bgm",file="bgm029"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000924",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, eso. Pues sí... sí, lo quería mucho.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"bg",file="ev_com_i01_01",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000925",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aunque si es por eso también quise mucho a la abuela Natsume, y también te\nquiero mucho a ti.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... así que lo decías en ese sentido. Cielos, pensé que era amor\nromántico o algo así.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"bg",file="ev_com_i01_02",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000926",ch="aid"},
},
ja={
{
name={"Ai"},
"“Amor romántico... ya veo. Ciertamente, 'querer mucho' se puede interpretar de\nesa manera.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_aid_000927",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero apenas lo conocí Kenichiro ya estaba enamorado de Mizuna nee-sama...\nCreo que no hubo oportunidad alguna para desarrollar esos sentimientos.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres decir que si él y mi madre no se hubiesen unido en relación tal vez sí\nse habrían desarrollado?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"bg",file="ev_com_i01_01",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000928",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jaja, vaya, qué insistencia.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ah, no... no es eso...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bg",file="ev_com_i01_02",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000929",ch="aid"},
},
ja={
{
name={"Ai"},
"“No lo sé, la verdad. Tal vez sí, tal vez no...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_aid_000930",ch="aid"},
},
ja={
{
name={"Ai"},
"“De igual forma, ya Kenichiro no está... Sintiera o no algo por él, ya eso no\nimporta.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, sí, tienes razón.\nPero...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_aid_000931",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kenichiro-san era alguien con un misterioso encanto. Su popularidad con las\nmujeres no era nada de sorprenderse...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No había mujer alguna que hablara mal de él...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"bg",file="ev_com_i01_05",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000932",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Otra vez ese cuento? Sí, bueno, el estilo de vida de Kenichiro-san era\nfascinante, pero más fascinante aún era su amor incondicional por una sola\nmujer. Ninguna mujer podría hablar mal de un hombre así.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Amor incondicional, eh... ahora que lo mencionas, recuerdo haber escuchado\nvarias veces las historias de amor que tuvo con mi madre.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bg",file="ev_com_i01_03",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000933",ch="aid"},
},
ja={
{
name={"Ai"},
"“Uhm, Kenichiro-san nunca llegó a ponerle un solo ojo a ninguna otra mujer. Aun\ndespués de que Mizuna nee-sama falleciera...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"bg",file="ev_com_i01_02",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000934",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y así tan fuerte era su lealtad como su terquedad. Tanto Kenichiro, como la\nabuela Kotoko...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_aid_000935",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aunque fue esa terquedad la que nos salvo a nosotras...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esos dos estaban algo locos. Ese grado de terquedad no era nada normal.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bg",file="ev_com_i01_03",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000936",ch="aid"},
},
ja={
{
name={"Ai"},
"“Lo mismo podría decirse de ti, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo? Por supuesto que no. Soy un hombre de carácter muy flexible.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"bg",file="ev_com_i01_05",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000937",ch="aid"},
},
ja={
{
name={"Ai"},
"“Carácter flexible, eh...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? ¿Por qué esa risita?...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"bg",file="ev_com_i01_07",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000938",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Te enteraste? Parece que la familia Nakamura tenía en su posesión cuadros\njamás publicados de Kenichiro.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, según parece...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_aid_000939",ch="aid"},
},
ja={
{
name={"Ai"},
"“Según parece...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Ai examina mi expresión.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Aparento normalidad de comienzo a fin.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"bg",file="ev_com_i01_01",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
ja={
{
"Al verme haciendo eso, Ai se ríe.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"bg",file="ev_com_i01_05",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000940",ch="aid"},
},
ja={
{
name={"Ai"},
"“No, no es nada. No es nada...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"bg",file="ev_com_i01_02",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000941",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero ¿sabes, Naoya? Hay muchos factores que coinciden... Y todos los Natsume\nestán en conflicto ahora en cómo lidiar con esa realidad.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_aid_000942",ch="aid"},
},
ja={
{
name={"Ai"},
"“Si Shizuku está ahora trabajando de artista mientras estudia es, seguramente,\npor eso...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Es que lo está haciendo por algo?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bg",file="ev_com_i01_03",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000943",ch="aid"},
},
ja={
{
name={"Ai"},
"“Quién sabe. Lo único que puedo decir, es que ella jamás trabajaría en eso por\nbeneficio propio.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_aid_000944",ch="aid"},
},
ja={
{
name={"Ai"},
"“Esa muchacha no tiene sed de dinero, ni tampoco de fama. A mi parecer, entró al\nmundo artístico con alguna razón en mente...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Con alguna razón en mente...",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"bg",file="ev_com_i01_07",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000945",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero el más afectado, quizá, fue Kei.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kei?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_aid_000946",ch="aid"},
},
ja={
{
name={"Ai"},
"“La expresión en su cara cambió desde que vio los seis cuadros del Sakura\nNanasouzu... Llevo un buen tiempo viviendo con Kei, y es primera vez que lo\nveo así.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_aid_000947",ch="aid"},
},
ja={
{
name={"Ai"},
"“Quizás tenga aires de tonto, pero en lo que concierne a la pintura es\nextremadamente agudo... Probablemente percibió algo al ver esos cuadros.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué habrá sido eso?...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_aid_000948",ch="aid"},
},
ja={
{
name={"Ai"},
"“El retorno de Kenichiro-san, su lucha con la enfermedad, el regreso de Shizuku\na la familia Natsume. Y encima de eso, las obras no publicadas que la familia\nNakamura dice tener...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hablas de eso como si todo estuviera conectado.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bg",file="ev_com_i01_08",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000949",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, bueno. Aunque, procuraré mantener en secreto todo lo que pienso al\nrespecto.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bg",file="ev_com_i01_07",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000950",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero ¿podrá hacer Kei lo mismo? No lo sé...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_aid_000951",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kei también es portador del apellido Natsume. Quizás su actitud despreocupada\nno lo diga, pero ha pasado por bastante trabajo. Así que por más que algo\nocupe su mente, no lo dirá.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_aid_000952",ch="aid"},
},
ja={
{
name={"Ai"},
"“Lo mostrará con acciones.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Con acciones.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bg",file="ev_com_i01_03",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000953",ch="aid"},
},
ja={
{
name={"Ai"},
"“Falta poco para la Exposición Moore, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"bg",file="ev_com_i01_07",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000954",ch="aid"},
},
ja={
{
name={"Ai"},
"“Es seguro que Kei creará una obra maestra para ti.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Para mí?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_aid_000955",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, para ti.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero yo no voy a presentar nada.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"bg",file="ev_com_i01_03",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000956",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues me pregunto qué hará Kei entonces...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Simplemente seguirá pintando sin preocuparse por mí, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_aid_000957",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Te parece? Tal vez llegue a pintar algo, pero a mi parecer, esperará.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Esperar? ¿A quién?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_aid_000958",ch="aid"},
},
ja={
{
name={"Ai"},
"“A que vengas.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A que yo venga?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"bg",file="ev_com_i01_08",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000959",ch="aid"},
},
ja={
{
name={"Ai"},
"“Algo me da esa sensación. Así que, quizá en ese sentido tienes aún bastante\ntiempo para pensar...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_aid_000960",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues él te esperará, por siempre...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por siempre...”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es como...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"bg",file="ev_com_i01_04",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000961",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Como?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El Príncipe le dijo a la pequeña Golondrina, 'Tienes que irte a Egipto'.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_aid_000962",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Y eso? ¿El príncipe feliz?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, qué sorpresa que lo adivinaras.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"bg",file="ev_com_i01_03",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000963",ch="aid"},
},
ja={
{
name={"Ai"},
"“Soy profesora de lenguaje, obviamente la conozco.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"bg",file="ev_com_i01_08",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000964",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aunque si es por eso la continuación decía así...”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_aid_000965",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y aun así, la pequeña Golondrina dijo, 'me quedaré contigo por siempre'.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si yo fuera el Príncipe obligaría a la Golondrina a irse a Egipto.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tiene alas para ello, no la dejaría morirse de frío aquí...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"bg",file="ev_com_i01_07",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000966",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, pero probablemente Kei decidirá, con esa misma terquedad, quedarse. Como la\npequeña Golondrina del príncipe feliz.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las obras de Wilde tienen en general un carácter homosexual. Me da algo de\nasco. No voy a permitir eso.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"bg",file="ev_com_i01_01",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000967",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿En serio? Es una pena. Yo sí apoyaría una relación entre los dos.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Bwh! ¡¿P-Pero qué mierda estás diciendo?!”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="fem_aid_000968",ch="aid"},
},
ja={
{
name={"Ai"},
"“Solo bromeaba.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo... Fue tan repentino que no pude evitar asustarme...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"bg",file="ev_com_i01_07",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000969",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero debes saber que Kei te quiere mucho, Naoya...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no, thank you.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"bg",file="ev_com_i01_01",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000970",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo, pues entonces no debo preocuparme de que vengan algún día a decirme que\nquieren casarse. Qué alivio, qué alivio.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Obviamente no!”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_aid_000971",ch="aid"},
},
ja={
{
name={"Ai"},
"“De igual forma falta ya poco para la Exposición Moore, ¿cierto? Debería\nprepararles algo nutritivo a los dos de vez en cuando...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Algo nutritivo? Hum, ¿qué será bueno?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"bg",file="ev_com_i01_04",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000972",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Arroz frito?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Arroz frito?! ¿N-Nutritivo eso?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"bg",file="ev_com_i01_07",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000973",ch="aid"},
},
ja={
{
name={"Ai"},
"“Uhm, tal vez no tanto... aunque, siempre que Kenichiro-san se encerraba a\ntrabajar lo único que comía era eso. Según él, la combinación de vegetales y\ncarne en un solo plato era perfecta.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese idiota, no tenía ni idea de lo que decía... Con lo poco que sabía\ncocinar...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"bg",file="ev_com_i01_03",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000974",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿En serio? ¿Kenichiro-san no sabía cocinar?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, era el típico hombre de Showa. No sabía encargarse de las labores de la\ncasa.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"bg",file="ev_com_i01_07",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000975",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vaya... hablaba con tanta confianza que me tragaba todo lo que decía...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así era ese idiota. Yo mismo me pregunto, ¿cómo podía hablar con tanta\nconfianza sin base?...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás estando ocupado arroz frito era la opción más fácil de preparar, pero\neso tiene mucha grasa y sal. Su valor nutritivo no es precisamente alto.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"bg",file="ev_com_i01_03",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000976",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, ciertamente. Kenichiro siempre me decía, el secreto del arroz frito no es\nintentar simplemente saltear el arroz, sino intentar freírlo en abundante\naceite.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"Siempre le decía, eh...",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Ya veo. Finalmente entiendo por qué a pesar de no saber cocinar bien, el arroz\nfrito de Ai es tan extrañamente delicioso...",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"El arroz frito chino es un platillo muy particular.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Comparado con otros platos, requiere mucho calor y aceite.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Ni siquiera yo sé prepararlo bien aún.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero sí, con lo ocupado que está ahora, probablemente a Kei le encante un plato\nde arroz frito.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"bg",file="ev_com_i01_01",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000977",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eso crees? Pues haré arroz frito entonces.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo me encargaré del an entonces. Tú encárgate del arroz frito.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"bg",file="ev_com_i01_04",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000978",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿An?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es mejor un arroz frito con ankake. Tiene vegetales, y se puede comer\nfácilmente.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"bg",file="ev_com_i01_07",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000979",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo, qué buena idea, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nada de qué sorprenderse. Mi nivel está por encima del viejo.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"bg",file="ev_com_i01_05",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000980",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Otra vez sacas a Kenichiro-san? De verdad que ustedes dos jamás han podido\napagar su rivalidad...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está en la sangre, supongo. A ninguno de los dos le gustaba perder con el otro.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"bg",file="ev_com_i01_02",sync=0,face=1,time=400,path=":ev/ev_com_i01/",set="ev_com_i01"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000981",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ciertamente. Padre e hijo, siempre queriendo ganar, siempre tercos.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tomaré eso como un cumplido.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Fuimos al supermercado y compramos provisiones para hoy y unos días más.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Y así como suena, varios días de provisiones para la familia Natsume es una\ncarga enorme, pero...",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"excall",file="05_the_happy_prince_01_3"},
{"text"},
linkback="block_00231",
},
label = {
top={block="block_00000",label=1},
},
}
