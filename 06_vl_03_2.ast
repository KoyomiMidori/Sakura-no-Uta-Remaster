astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"msgoff"},
{"bg",file="bluesky_winter",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm005"},
{"text"},
text={
vo={
{"vo",file="fem_skr_000188",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Quiero revivir el club de arte.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Estaba comiendo pan francés en la azotea como de costumbre, cuando Sakizaki-kun\nmencionó repentinamente eso.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="桜子",size="z1",mode=3,resize=1,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah, sí?...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0011",head="sku_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0005",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000189",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿Ah, sí?! ¿Me está escuchando bien? No hay club de arte en este colegio,\n¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no, no hay...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0003",head="sku_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000190",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Por eso quiero crear un club de arte.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, ya veo.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0011",head="sku_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0006",head="sku_z1a",lv=4,id=9},
{"fgact",ch="桜子",act="うんうん",lv=4,id=9},
},
vl02={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000191",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡No quiero un 'ya veo' por respuesta! ¡Quiero que usted sea el supervisor!”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaaa?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_skr_000192",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Digo, usted es el único profesor de arte en este colegio, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000193",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Pues entonces--!”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera, los profesores de tiempo parcial no tenemos la autoridad para\ntrabajar como supervisores.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0005",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000194",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Entonces al menos ayúdeme enseñándome a pintar.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué viene esto de la noche a la mañana?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0008",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000195",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“E-Es que... Q-Quiero, hacerlo...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"La fuerza en sus palabras se debilitó al final. ¿Por qué será?",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿No estarás ocultandome algo, Sakizaki-kun?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="桜子",size="z1",ex01="b0099",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001",head="sku_z1b",lv=4,id=9},
{"fgact",ch="桜子",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_skr_000196",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡Y-Yo, no!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Vuelvo mi mirada a las escaleras.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=80,x=-960,zone="0x000000",file="zbg053a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="奈津子",size="z2",mode=3,resize=1,path=":fg/nat/z2/",file="nat_z2a0200",face="a0001",head="nat_z2a",lv=5,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"se",file="se9010",vol=50,id=1},
{"fgact",ch="奈津子",act="びっくり",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fgact",ch="奈津子",act="いいえ",lv=5,id=9},
{"text"},
text={
ja={
{
"Se veía la silueta de alguien temblando.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si bien te sugerí esta mañana que hicieras algo emocionante, no me parece muy\nbien que le pidas el favor a alguien más para que lo haga por ti.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_skr_000197",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ah, n-no, de verdad yo...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"se",file="se0744",vol=50,id=1},
{"msgoff"},
{"cgdel",lv=1,id=5,rule="cinema",time=400,sync=0},
{"fg",mode=-2,sync=0},
{"bg",file="bg053a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="桜子",size="z1",ex01="b0099",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001",head="sku_z1b",x=-345,lv=4,id=5,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"La silueta aparece de las escaleras y viene corriendo hacia acá.\nEra una cara conocida.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"se",stop=1,time=500,id=1},
{"fg",ch="奈津子",size="z1",mx=40,mode=3,resize=1,path=":fg/nat/z1/",file="nat_z1a0200",face="a0009",head="nat_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000046",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¡L-Lo siento mucho!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh... Kuriyama-kun, ¿pintar es lo que quieres hacer?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0008",head="nat_z1a",x=345,lv=4,id=6},
{"fgact",ch="奈津子",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000047",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¡Ah, s-sí!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0008",head="sku_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000198",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“N-No es lo que usted cree. Kuriyama-san no tenía miedo de hablarle a usted,\nsolo que yo también quiero pintar...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, creo que ya sé qué fue lo que pasó. Me puedo imaginar también lo que\nhablaron ustedes dos.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, Sakizaki-kun, si no mal recuerdo tú pertenecías al club de atletismo,\n¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0001",head="sku_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000199",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ah, abandoné el club el año pasado.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Abandonaste el club? Recuerdo bien que tenías muy buenos números, ¿no te\nhabían llamado también para los juegos preuniversitarios?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0008",head="sku_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0010",head="sku_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_skr_000200",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Eso fue hasta el año pasado... Ahora no estoy involucrada en ningún club...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que abandonaste el club por ahora...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0008",head="sku_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000201b",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Después de los preuniversitarios me lastimé el pie... y desde entonces, no he\npodido correr...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Ahora que lo menciona, fue por esa época que ella comenzó a venir a la azotea,\nme parece...",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"¿Será que su herida y el hecho de que comenzará a venir acá tienen alguna\nrelación?...",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0210",face="a0001",head="sku_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000202",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Siempre me he concentrado en clubes de deporte, y desde hace tiempo me ha\nfascinado la pintura...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Todo este tiempo ha estado en clubes de deporte.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Sí, con razón siempre está tan llena de energía. Ya me parecía que no es una\nmuchacha de letras.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_rld_000098",ch="rld"},
},
ja={
{
name={"???"},
"“¿Por qué no entonces?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"se",file="se9004",id=1},
{"fg",mode=-2},
{"fg",ch="ルリヲ",size="z1",mode=3,resize=1,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=-345,lv=4,id=5},
{"fg",ch="鈴菜",size="z1",mode=3,resize=1,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ruriwo, Suzuna, ¿qué hacen aquí?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=-345,lv=4,id=5},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000099",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Estábamos visitando el colegio. Y nos pareció divertido, así que subimos a la\nazotea.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues me sorprende que dieras con la entrada, eh. La única entrada que hay es\npor las escaleras de emergencia.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_snd_000063",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Mi hermana solía hablar bastante de esta azotea.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0009",head="rur_z1c",x=-345,lv=4,id=5},
{"fgact",ch="ルリヲ",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000100",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Ruriwo tenía planeado pintar también el próximo año al ingresar.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0009",head="suz_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000064",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Pero no hay ningún club de arte ahora, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Cerró hace unos cuantos años.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fgact",ch="鈴菜",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000065",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Pero hay varios estudiantes que quieren participar en él, me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De igual forma el colegio no va a permitirlo a menos que cumplan con el número\nmínimo de integrantes...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001",head="sku_z1b",x=-570,lv=4,id=3},
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x2=-345,x=0,lv=4,id=5},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x=345,lv=4,id=6},
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x2=345,x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skr_000203",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“El mínimo establecido son cinco personas, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y un profesor encargado. Que por cierto, siendo profesor a tiempo parcial, yo no\npuedo asumir esa labor.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0021",head="rur_z1c",x=0,lv=4,id=5},
{"fgact",ch="ルリヲ",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000101",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Por qué esperar que el colegio nos dé permiso? Si se quiere se hace, esa es\nuna de las grandes premisas del arte.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x=570,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000066",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Una de las premisas del arte?...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=0,lv=4,id=5},
{"fgact",ch="ルリヲ",act="うんうん",time=350,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000102",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Así es, así es. Haremos lo que queramos hacer. ¿Verdad, Kusanagi-chan?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo no conozco ninguna premisa de ese estilo...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero puede que tengas razón en lo que dices.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0021",head="rur_z1c",x=0,lv=4,id=5},
{"fgact",ch="ルリヲ",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000103",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Verdad~? Ruriwo siempre tiene la razón en lo que dice.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, Sakizaki-kun y Kuriyama-kun, ambas quieren entrar al club de arte,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="鈴菜",mode=-1,lv=4,id=6},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",x=570,lv=4,id=4},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000048",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“S-Sí.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fui yo además quien te sugirió buscar algo que te emocionara...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0022",head="rur_z1c",x=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=0,lv=4,id=5},
{"fgact",ch="ルリヲ",act="びっくり",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000104",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Algo que emocione? Genial, genial. A Ruriwo le encanta eso.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé si seguiré acá después de abril, pero haré todo lo que pueda por ustedes.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000204",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Todo... lo que pueda?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me moveré para facilitarles la aceptación de la solicitud de club.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_skr_000205",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿No entrará como nuestro profesor guía?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0008",head="rur_z1c",x=0,lv=4,id=5},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000105",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Yo también me pregunto lo mismo. Ruriwo quiere tener a Kusanagi-chan como\nprofesor.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="奈津子",mode=-1,lv=4,id=4},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=0,lv=4,id=5},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=570,lv=4,id=4},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_snd_000067",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Sí, a mí también me encantaría.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya se los dije, soy profesor a tiempo parcial. Son muchas las restricciones que\ntengo encima.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En primer lugar, para servirles como profesor guía ustedes deben solicitar\nautorización de uso de la sala de arte. Y luego deben solicitarme formalmente\na mí.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",x=-570,lv=4,id=3},
{"fgact",ch="桜子",act="おじぎ",lv=4,id=3},
{"se",file="se2497",id=1},
{"text"},
text={
vo={
{"vo",file="fem_skr_000206",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Tome. Esta es la autorización para usar la sala de arte después de clases.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"En este colegio, todo aquel grupo que no sea reconocido como club debe pedir\nautorización para usar los salones.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Esta muchacha preparó todo eso antes de hablar conmigo...",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sakizaki-kun, qué dinamismo el tuyo...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0010",head="sku_z1b",x=-570,lv=4,id=3},
{"fgact",ch="桜子",act="いいえ",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_skr_000207",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Para nada. No se compara al de los antiguos senpais del club de arte. Si la\nmemoria no me falla, entre ellos estaba Makoto Toritani, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo es que sabes el nombre de Toritani?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0001",head="rur_z1c",x=0,lv=4,id=5},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000106",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Ah, yo le conté ayer.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Después de vernos?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000107",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Sí, le escribí por celular.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0003",head="sku_z1b",x=-570,lv=4,id=3},
{"fgact",ch="桜子",act="うなづく",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000208",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ruriwo-san me contó bastante de todos los logros alcanzados por los senpais.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Logros alcanzados... Diría más bien que problemas ocasionados...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000209",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pero fue ese dinamismo lo que le dio vida a la milagrosa obra de 'Las huellas\nde los cerezos', ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no lo niego...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0003",head="sku_z1b",x=-570,lv=4,id=3},
{"fgact",ch="桜子",act="うんうん",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000210",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Además, fueron los primeros en ser condecorados como estudiantes en la\nExposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0002",head="sku_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000211",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Me contaron que Toritani-san se encargó de mover el club desde su primer año\npara lograr eso.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues más que el dinamismo de Toritani, fue la genialidad de Rin Misakura lo que\nlogró eso.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_skr_000212",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ah, sí, ciertamente la carrera profesional de Misakura-san demostró su\ngenialidad.\nPero escuché que hubo otro galardonado más.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0008",head="rur_z1c",x=0,lv=4,id=5},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0008",head="suz_z1c",x=570,lv=4,id=4},
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0008",head="sku_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000213",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿P-Pasa algo?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no pasa nada. Sí, hubo otro galardonado.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0003",head="sku_z1a",x=-570,lv=4,id=3},
{"fgact",ch="桜子",act="うんうん",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_skr_000214",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿No es eso increíble? Es un logro enorme que hayan habido dos galardonados.\nNingún adolescente ha ganado algo antes en la Exposición Moore, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="ルリヲ",mode=-1,lv=4,id=5},
{"fg",ch="鈴菜",mode=-1,lv=4,id=4},
{"fg",ch="桜子",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x2=-570,x=-345,lv=4,id=3},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0005",head="nat_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",x=345,lv=4,id=6},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_ntd_000049",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“De hecho, ningún otro japonés ha ganado el premio desde entonces. Más que un\nlogro, yo creo que fue un milagro.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente...”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
"Ruriwo y Suzuna habían bajado sus cabezas.\nProbablemente no les contaron lo que sucedió con la persona que ganó ese premio.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Seguramente no se lo pensaron bien, mencionaron lo de los dos galardonados.\nComenzó la incesante ronda de preguntas de Sakizaki-kun y no supieron qué\ndecir respecto a Kei.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Acoto que eso no fue milagro, ni tampoco un logro excepcional.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0007",head="sku_z1a",x=-345,lv=4,id=3},
{"fgact",ch="桜子",act="びっくり",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000215",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Eh? ¿Cómo no? Ambos fueron los primeros adolescentes en la historia en ganar\nese premio.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No. Kei Natsume estaba destinado a ganar ese premio, y lo ganó.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000216",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Estaba destinado a ganar, y ganó.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000050",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Increíble...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo era. Era increíble...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0008",head="sku_z1a",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000217",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Era? ¿Por qué habla en tiempo pasado?...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque ya no pintará más. Por eso hablo en pasado.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",x=-345,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000218",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Lo dice... en el sentido de que abandonó la pintura?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_rld_000108",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Kusanagi-chan...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Ruriwo, visiblemente preocupada, intenta hablarme.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Giro mi cabeza a los lados.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",mode=-2},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",x=-345,lv=4,id=5},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mejor enfocarnos en el hoy que en el ayer. Sakizaki-kun se tomó la molestia de\nconseguir la autorización.\n¿Quieren pintar hoy después de clases?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0003",head="sku_z1a",x=-345,lv=4,id=5},
{"fgact",ch="桜子",act="うなづく",lv=4,id=5},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",x=345,lv=4,id=6},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skr_000219",ch="skr"},
{"vo",file="fem_ntd_000051",ch="ntd"},
},
ja={
{
name={"Sakurako y Natsuko"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",mode=-2},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=-345,lv=4,id=5},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000068",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Nos podrías enseñar a nosotras también?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, aunque solo les puedo enseñar las básicas.\nHe decidido no aceptar ningún aprendiz.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0013",head="rur_z1c",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0017",head="rur_z1c",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000109",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Vamos, nadie ha pedido ser tu aprendiz, Kusanagi-chan.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ajajaja, solo bromeaba. Pues bueno, vengan todas a la sala de arte después de\nclases.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=-345,lv=4,id=5},
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x2=-345,x=-210,lv=4,id=5},
{"fg",ch="ルリヲ",speed=150,mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",y2="0,10",x=-210,y=0,lv=4,id=5},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0003",head="suz_z1c",x=345,lv=4,id=6},
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0003",head="suz_z1c",x2=345,x=210,lv=4,id=6},
{"fg",ch="鈴菜",speed=150,mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0003",head="suz_z1c",y2="0,10",x=210,y=0,lv=4,id=6},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0003",head="sku_z1a",x=-680,lv=4,id=1},
{"fg",ch="桜子",speed=150,mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0003",head="sku_z1a",y2="0,10",x=-680,y=0,lv=4,id=1},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",x=680,lv=4,id=2},
{"fg",ch="奈津子",speed=150,mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",y2="0,10",x=680,y=0,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_skr_000220",ch="skr"},
{"vo",file="fem_ntd_000052",ch="ntd"},
{"vo",file="fem_rld_000110",ch="rld"},
{"vo",file="fem_snd_000069",ch="snd"},
},
ja={
{
name={"Todas"},
"“¡¡Entendido!!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bluesky_winter",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"La tarde llegó rápidamente.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"El cambio ha sido increíble, y hasta yo me sorprendo.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Ya he usado esta sala de arte una y otra vez para dar clases.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Enseñar acá es parte de mi día a día...\nPero aun así...",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=-345,lv=4,id=5},
{"fgact",ch="ルリヲ",act="うんうん",lv=4,id=5},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x=345,lv=4,id=6},
{"bgm",file="bgm041"},
{"text"},
text={
vo={
{"vo",file="fem_rld_000111",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“La pintura de oleo es genial, oh sí.\nMucho mejor que la acuarela.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0008",head="suz_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000070",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿En serio? La verdad es que no logro entender por qué...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0019",head="rur_z1c",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000112",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Según dicen, puedes corregir todo lo que quieras. Pero la acuarela no, lo cual\nes muy fastidioso.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Completamente distintas, ¿verdad? Aunque veo que terminaron rápido con la parte\nde carboncillo.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=-345,lv=4,id=5},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000071",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Es el resultado de haber observado a nuestras hermanas pintar todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya, pues les hubiese salido mejor que les enseñaran ellas. En particular\nHikawa, ella pinta mucho mejor que yo.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0021",head="rur_z1c",x=-345,lv=4,id=5},
{"fgact",ch="ルリヲ",act="うんうん",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000113",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Rina onee-chan me dijo que tomara clases contigo. Mencionó que eres bueno\nexplicando, y que aprendiera contigo todo lo que no le enseñaste.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué diablos?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"¿Qué demonios le pasa? ¿Todavía está enfadada conmigo por no haberle enseñado\ntodo lo que yo sabía?",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Si no seguí enseñándole más es porque comenzó a decir que se convertiría en mi\naprendiz.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"... ¿Eh?",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Ah, ahora que lo recuerdo...",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="鈴菜",mode=-1,lv=4,id=6},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0016",head="rur_z1c",x=-345,lv=4,id=5},
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0016",head="rur_z1c",x2=-345,x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000114",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Fuoh? Kusanagi-chan, ¿te sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, solo que me acabo de acordar de algo.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_rld_000115",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es la gran cosa... Solo una tontería. Ella solía llamarse a sí misma\n'hermanita autoproclamada'...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fgact",ch="ルリヲ",act="ジャンプ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0008",head="rur_z1c",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000116",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¡Ah, eso, eso! ¿De dónde le salió eso? Siempre ha sido un misterio para mí~\n¿Por qué hermanita autoproclamada?”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, la culpa de eso la tuve yo... Lo había olvidado por completo hasta ahora.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0008",head="rur_z1c",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000117",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Y yo quiero saber esa razón, vamos.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ruriwo, tu pincel está chorreando.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0016",head="rur_z1c",x=0,lv=4,id=5},
{"fgact",ch="ルリヲ",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0012",head="rur_z1c",x=0,lv=4,id=5},
{"fgact",ch="ルリヲ",act="ジャンプ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rld_000118",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Eh? ¡Fwaaah! ¡Wah! ¡Q-Qué desastre!”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si te cayó en la ropa puedes limpiarlo con aguarrás.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0008",head="rur_z1c",x=0,lv=4,id=5},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rld_000119",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Está bien. Iré un momento a la sala de preparativos.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"se",file="se9023",id=1},
{"fg",ch="ルリヲ",mx=40,mode=-1,lv=4,id=5},
{"text"},
text={
ja={
{
"Ruriwo corre a la sala de preparativos para limpiar la pintura que había caído\nen su ropa.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"No fue sino hasta el día de hoy que lo recordé.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Aun en esos tiempos, cuando las veía todos los días por el club, no llegué a\nrecordarlo ni una sola vez.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Ya veo...",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Vaya maldad que le hice a Hikawa. Qué pena.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000072",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Kusanagi-sama, se le ve feliz...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_snd_000073",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Llevaba tiempo sin verle con esa cara tan feliz. Yo también me siento alegre\nahora.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Por qué? Yo no estoy poniendo esa cara.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fgact",ch="鈴菜",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000074",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Está bien, no importa. Ruriwo y yo siempre hemos gustado de usted... Verlo así\nde feliz también nos alegra a nosotras.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“L-Lo que intentas decir no es cierto. Todos los días me divierto.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0018",head="suz_z1c",lv=4,id=6},
{"fgact",ch="鈴菜",act="うんうん",time=200,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_snd_000075",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Está bien, entiendo.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dios mío...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",mode=-2},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0013",head="sku_z1a",x=-345,lv=4,id=5},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_skr_000221",ch="skr"},
},
ja={
{
name={"Sakurako"},
"*mira fijamente*...",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa, Sakizaki-kun?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0004",head="sku_z1a",x=-345,lv=4,id=5},
{"fgact",ch="桜子",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0008",head="sku_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_skr_000222",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Nada, solo que usted nunca ha mostrado esa cara al hablar conmigo.\nNo es justo.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es justo? ¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0004",head="sku_z1a",x=-345,lv=4,id=5},
{"fgact",ch="桜子",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000223",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“No es nada.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",x=345,lv=4,id=6},
{"fgact",ch="奈津子",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000053",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Jejeje...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Kuriyama-kun! ¡¿Por qué te ríes?!”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x=-345,lv=4,id=5},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",x=345,lv=4,id=6},
{"fgact",ch="奈津子",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000054",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“No es nada, solo que, realmente todas lo quieren mucho.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000055",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Aunque supongo que será su personalidad.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, ya basta de hablar de mí. ¡Ustedes todavía no terminan su boceto,\nconcéntrense!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0013",head="sku_z1a",x=-345,lv=4,id=5},
{"fgact",ch="桜子",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000224",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Hmph, así que con nosotras no quiere charlar.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No es eso!”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="桜子",speed=500,mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0013",head="sku_z1a",x2=-345,x=-680,lv=4,id=5},
{"fg",ch="奈津子",speed=500,mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x2=345,x=-210,lv=4,id=6},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",x=210,lv=4,id=8},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=680,lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=210,lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_rld_000120",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Kusanagi-chan es realmente popular. Aunque así ha sido desde hace tiempo.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Ruriwo, quien acababa de regresar, mencionó algo que hubiese preferido no\ndijera.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",x=-680,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000225",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Desde hace tiempo?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0009",head="suz_z1c",x=680,lv=4,id=2},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0011",head="suz_z1c",x=680,lv=4,id=2},
},
},
text={
vo={
{"vo",file="fem_snd_000076",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Así es. Kusanagi-sama siempre ha sido muy querido por todas, desde hace años. O\ndigamos más bien, era popular entre las damas.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Yo no soy popular con nadie!”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0004",head="rur_z1c",x=210,lv=4,id=8},
{"fgact",ch="ルリヲ",act="いいえ",lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_rld_000121",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Mentiroso. Eras súper popular. Rina onee-chan se moría por ti.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo le agradaba como amigo, nada más ni nada menos.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=210,lv=4,id=8},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0017",head="suz_z1c",x=680,lv=4,id=2},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0013",head="suz_z1c",x=680,lv=4,id=2},
},
},
text={
vo={
{"vo",file="fem_snd_000077",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Jaa, ¿como amigos? Ya veo, ya veo. Creo entender ahora por qué onee-sama se\nirritaba tanto al verlo a usted.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=680,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000078",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Aunque no lo crea, Yuumi onee-sama lo quería mucho a usted.\nCreo que fue la excepción en lo que al sexo opuesto concierne.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No digas tonterías, Kawachino me odiaba con toda su alma.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0015",head="suz_z1c",x=680,lv=4,id=2},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0018",head="suz_z1c",x=680,lv=4,id=2},
},
},
text={
vo={
{"vo",file="fem_snd_000079",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Ya veo, ahora sale con eso.\nMe hubiese gustado que onee-sama le propinara un cuchillazo cuando estaba acá.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué?!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0007",head="sku_z1a",x=-680,lv=4,id=5},
{"fgact",ch="桜子",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000226",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Tan popular era el profesor con las chicas?...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x=-210,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000056",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Ahora que lo pienso, tiene sentido. Crecer y volverte adulto no te hace guapo\nde la noche a la mañana...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",x=-680,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_skr_000227",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pero la personalidad cambia cuando te vuelves adulto, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="奈津子",mode=-1,lv=4,id=6},
{"fg",ch="桜子",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",x2=-680,x=-570,lv=4,id=5},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=210,lv=4,id=8},
{"fg",ch="ルリヲ",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x2=210,x=0,lv=4,id=8},
{"fg",ch="鈴菜",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0018",head="suz_z1c",x2=680,x=570,lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=0,lv=4,id=8},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_rld_000122",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“En el caso de Kusanagi-chan, no ha cambiado nada. Siempre se muestra frío, pero\ncuando llega el momento se enciende en llamas.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0015",head="suz_z1c",x=570,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000080",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Yuumi onee-sama siempre se quejaba con nosotras, y cada vez que lo hacía\nterminaba explicándonos el proceso de creación de 'Las huellas de los\ncerezos'.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=0,lv=4,id=8},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0018",head="suz_z1c",x=570,lv=4,id=2},
{"fgact",ch="鈴菜",act="うなづく",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000081",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Aunque lo que ella decía que era una queja sonaba más a orgullo. Siempre\nhablaba de lo galante y genial que era Kusanagi-sama.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, no sé si lo saben, pero fue un tipo llamado Akashi el que hizo todo\neso.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0011",head="suz_z1c",x=570,lv=4,id=2},
{"fgact",ch="鈴菜",act="うんうん",lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=570,lv=4,id=2},
},
},
text={
vo={
{"vo",file="fem_snd_000082",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Ya lo ve? En estos momentos usted habla como si no fuese asunto suyo.\nYo nunca dije que onee-sama hablaba solo de usted. Solo mencioné lo que\ndijo respecto a usted.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Guh...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",x=570,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000083",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Además, fue mucho antes de eso que onee-sama comenzó a respetarlo a usted...\nSegún contó, fue después de la orquesta de cerezos y cipreses.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La orquesta de cerezos y cipreses...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0010",head="suz_z1c",x=570,lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000084",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Si no sabe de lo que hablo, tiene toda la libertad de ignorarlo. No se\npreocupe.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí tengo conocimiento de eso...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",x=570,lv=4,id=2},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0010",head="sku_z1a",x=-570,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0001",head="sku_z1a",x=-570,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_skr_000228",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Veo al profesor ahora y jamás me imaginaría que hizo todo eso... Siempre parece\nestar sin energía, como un muerto...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=0,lv=4,id=8},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=8},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=0,lv=4,id=8},
},
},
text={
vo={
{"vo",file="fem_rld_000123",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Él ha sido así desde hace tiempo. No sabe realmente cómo dárselas del tipo\nfrío, pareciendo más bien un muerto, siempre desanimado. Según me contaron,\nesa muchacha llamada Toritani le decía eso todo el tiempo.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no, el profesor Kusanagi nunca ha sido así de flojo. Esa era solo mi forma\nde mostrar cordialidad con los demás.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",mode=-2},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",lv=4,id=6},
{"fgact",ch="奈津子",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000057",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Jejeje.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Kuriyama-kun! ¡¿Por qué te ríes ahora?!”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",lv=4,id=6},
{"fgact",ch="奈津子",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000058",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“No es nada, es que se nota que todas lo quieren tanto.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A-A qué viene eso ahora?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0011",head="sku_z1a",x=-570,lv=4,id=3},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",lv=4,id=6},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_skr_000229",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Hmph, ¿por qué no se casa de una buena vez entonces?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Ahora venimos con eso?!”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0005",head="sku_z1b",x=-570,lv=4,id=3},
{"fgact",ch="桜子",act="いいえ",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000230",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿O es que quiere seguir disfrutando de esta vida? ¿Por eso es que sigue sin\ncasarse? ¿Para jugar con los corazones de las chicas?””",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿De qué estás hablando ahora?!”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0004",head="sku_z1b",x=-570,lv=4,id=3},
{"fgact",ch="桜子",act="うんうん",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0009",head="sku_z1b",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_skr_000231",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pues que usted ha sido popular con las mujeres desde hace tiempo. Las enamora.\nY al parecer eso no ha cambiado.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=570,lv=4,id=4},
{"fgact",ch="ルリヲ",act="うんうん",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rld_000124",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Si es por eso no hay peligro. Kusanagi-chan es virgen.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Q--?! ¡¿Pero qu--?! ¡¿Q-Qué, qué clase de cosas vienes a decir ahora?!”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=570,lv=4,id=4},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0007",head="sku_z1b",x=-570,lv=4,id=3},
{"fgact",ch="桜子",act="びっくり",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000232",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0007",head="nat_z1a",lv=4,id=6},
{"fgact",ch="奈津子",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ntd_000059",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¿Eh? ¿V-Virgen?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Y-Y-Yo no soy virgen.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0001",head="nat_z1a",lv=4,id=6},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",x=570,lv=4,id=4},
{"fgact",ch="ルリヲ",act="いいえ",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rld_000125",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Ah, no? De lo que Ruriwo sabe, nunca has tenido novia. Siempre has estado solo,\n¿o no?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0007",head="sku_z1b",x=-570,lv=4,id=3},
{"fgact",ch="桜子",act="びっくり",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000233",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿E-Es eso verdad?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=570,lv=4,id=4},
{"fgact",ch="ルリヲ",act="うなづく",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rld_000126",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Así es. Estando en Yumihari nunca tuvo novia, onee-chan me lo confirmó. Y\nrespecto a su época de universitario, el mismo Kusanagi-chan me contó que su\nuniversidad quedaba tan lejos que nunca tuvo tiempo para eso.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Kuh... Ahora es que vengo a recordar que dije eso.\nBajé la guardia.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="奈津子",mode=-1,lv=4,id=6},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000085",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Después de aquella vez, Ruriwo-san le ha preguntado lo mismo a Kusanagi- sama,\npero la respuesta ha sido siempre no.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0008",head="sku_z1b",x=-570,lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0013",head="sku_z1b",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_skr_000234",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Pero podría simplemente estar mintiendo... A un hombre que mantiene varias\nrelaciones siempre le convendrá decir que no tiene novia...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡E-El profesor Kusanagi no incurriría en semejantes infidelidades!”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0007",head="sku_z1b",x=-570,lv=4,id=3},
{"fgact",ch="桜子",act="びっくり",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000235",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿E-Eso quiere decir que es verdad lo de que nunca ha tenido novia?”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"Sakizaki-kun me pregunta eso con una expresión de sincera sorpresa.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí, sí tuve. Tuve una novia, pero nunca se lo conté a Ruriwo y Suzuna. Me daba\npena, sí.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001",head="sku_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000236",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Y ahora?”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ahora estoy soltero...”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",x=570,lv=4,id=4},
{"fgact",ch="ルリヲ",act="うんうん",lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rld_000127",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Pues entonces cuéntanos cómo se llamaba tu novia.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Ehm... ella se... se llamaba...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0018",head="suz_z1c",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000086",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“No se le dan bien las mentiras...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No es eso...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0009",head="rur_z1c",x=570,lv=4,id=4},
{"fgact",ch="ルリヲ",act="いいえ",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_rld_000128",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Claro que sí. Kusanagi-chan es virgen.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0007h",head="sku_z1b",x=-570,lv=4,id=3},
{"fgact",ch="桜子",act="いいえ",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0013h",head="sku_z1b",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_skr_000237",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Eh? ¿Ehhh? ¿El profesor? ¿El profesor es virgen, d-de verdad?”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“C-Claro que no...”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0016",head="rur_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rld_000129",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“¿Entonces perdiste la virginidad en algún local de esos?”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Me crees capaz de ir a un lugar tan aterrador como un prostíbulo?...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000087",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“¿Entonces cuál era el nombre de su novia?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0009",head="rur_z1c",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0018",head="rur_z1c",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_rld_000130",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Si llegas a admitir que no tuviste novia, acabarás como un mentiroso.\nKusanagi-chan, ¿no te parece eso indebido como profesor?”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No estoy mintiendo.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0001h",head="sku_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000238",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Entonces?”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Todas mis novias... han estado... detrás de una pantalla...”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0018",head="suz_z1c",lv=4,id=2},
{"fgact",ch="鈴菜",act="うなづく",lv=4,id=2},
{"text"},
text={
vo={
{"vo",file="fem_snd_000088",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Ya vieron.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=570,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_rld_000131",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Kusanagi-chan es mucho más serio y honesto de lo que parece.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1b0200",face="b0008h",head="sku_z1b",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000239",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Serio y honesto...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, ¿qué tanto tienen que hablar de mí? ¿Cómo terminamos en este meollo?”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0002",head="suz_z1c",lv=4,id=2},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=570,lv=4,id=4},
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0003",head="sku_z1a",x=-570,lv=4,id=3},
{"fgact",ch="桜子",act="びっくり",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000240",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ajajaja...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sakizaki-kun! ¡¿Por qué te ríes?!”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fgact",ch="桜子",act="うんうん",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_skr_000241",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“Ah, no, l-lo siento... Solo que, repentinamente me sentí feliz... y no pude\nevitarlo...”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Por qué te alegra mi virginidad?!”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0003",head="sku_z1a",x=-570,lv=4,id=3},
{"fgact",ch="桜子",act="うんうん",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000242",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡P-Perdóneme!”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿T-Te estás burlando de mí? S-Siempre es lo mismo con todos...”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0002",head="sku_z1a",x=-570,lv=4,id=3},
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0017",head="suz_z1c",lv=4,id=2},
{"fgact",ch="鈴菜",act="おじぎ",lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0011",head="suz_z1c",lv=4,id=2},
},
},
text={
vo={
{"vo",file="fem_snd_000089",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Jaa, esa parte torpe suya no ha cambiado para nada. Creo que ahora soy yo quien\ndesea asesinarle.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tienen que decirme esa clase de cosas?”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0001",head="suz_z1c",lv=4,id=2},
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0003",head="rur_z1c",x=570,lv=4,id=4},
{"fgact",ch="ルリヲ",act="うんうん",time=300,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="ルリヲ",size="z1",mode=3,path=":fg/rur/z1/",file="rur_z1c0200",face="c0002",head="rur_z1c",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_rld_000132",ch="rld"},
},
ja={
{
name={"Ruriwo"},
"“Vamos, vamos, esa es parte de tu bondad. Y gracias a eso todas nosotras tenemos\noportunidad todavía.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Oportunidad? ¿Oportunidad de qué?”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="ルリヲ",mode=-1,lv=4,id=4},
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0002",head="nat_z1a",x=570,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1a0200",face="a0003",head="nat_z1a",x=570,lv=4,id=4},
{"fgact",ch="奈津子",act="うなづく",lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_ntd_000060",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“Oportunidad... Sí, ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0007",head="sku_z1a",x=-570,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000243",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¡¿D-De qué te ríes, Kuriyama-san?!”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0210",face="b0007",head="nat_z1b",x=570,lv=4,id=4},
{"fgact",ch="奈津子",act="びっくり",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="奈津子",size="z1",mode=3,path=":fg/nat/z1/",file="nat_z1b0210",face="b0002h",head="nat_z1b",x=570,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_ntd_000061",ch="ntd"},
},
ja={
{
name={"Natsuko"},
"“¡P-Perdón!\nE-Es que tú también pareces estar muy alegre de escuchar eso...”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"fg",ch="桜子",size="z1",mode=3,path=":fg/sku/z1/",file="sku_z1a0200",face="a0008h",head="sku_z1a",x=-570,lv=4,id=3},
{"fgact",ch="桜子",act="びっくり",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_skr_000244",ch="skr"},
},
ja={
{
name={"Sakurako"},
"“¿Eh? Y-Yo n--”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0006",head="suz_z1c",lv=4,id=2},
{"fgact",ch="鈴菜",act="ジャンプ",lv=4,id=2},
{"text"},
delay={
vl01={
{"fg",ch="鈴菜",size="z1",mode=3,path=":fg/suz/z1/",file="suz_z1c0200",face="c0005",head="suz_z1c",lv=4,id=2},
},
},
text={
vo={
{"vo",file="fem_snd_000090",ch="snd"},
},
ja={
{
name={"Suzuna"},
"“Ah~, acabemos con este tema de una buena vez y ayúdeme con esto. No tengo idea\nde cómo usar los colores acá.”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah~, sí, sí, está bien. Acá tienes que...”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"bg",file="bluesky_winter",id=8,lv=8,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"bg",file="eveningsky_spring01",id=9,lv=9,sync=1,path=":cg/"},
{"ex",time=500,func="wait"},
{"text"},
text={
ja={
{
"Comencé recordando a Hikawa.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"Cipreses y cerezos, eh...",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"Fue de ahí que recordé por qué se hacía llamar 'hermanita autoproclamada'.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
"También recordé a Toritani.\nSiempre me decía que parecía un muerto, fastidiado y somnoliento.",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
"Y también a Kawachino.\nSiempre la veía molesta conmigo, y ahora que percibí algo similar en Suzuna,\nsiento que debería cuidarme...",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
"El olor de la pintura, y el aguarrás.",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
"El seco aire de la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
"No sé por qué, pero se me hace nostálgico.",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
