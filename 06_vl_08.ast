astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo VI"},
{"bg",file="ev_eye_c14_01",path=":ev/ev_eye_c14/",set="ev_eye_c14"},
{"ex",time=1000,func="wait"},
{"bg",time=3000,file="ev_eye_c15_01",path=":ev/ev_eye_c15/",set="ev_eye_c15"},
{"ex",time=4000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",y=-400,speed=300,file="zbg005e",path=":bg/",x2=960,y2=-586,x=960,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"quake"},
{"extrans",time=100},
{"bgm",file="bgm003"},
{"se",file="se3130",vol=50,id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿--?! ¡Ai!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ai? ¿Estás ahí, Ai?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"El mismo lugar de siempre. El mismo panorama de siempre.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Obviamente nadie respondió a mi llamado.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa,\n¿qué diablos estoy haciendo?...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tch...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Me pongo en posición fetal.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"No puedo creer que soñé con que Ai regresaba...",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Cómo me he ablandado...",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Vaya cuerda de cosas vergonzosas que dije ayer.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Qué bueno que fue solo un sueño.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"se",file="se9010",id=1},
{"msgoff"},
{"bg",file="bg005e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Me levanto.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Me siento mejor de lo que esperaba.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Probablemente vomité tanto ayer que no quedó suficiente alcohol en mi cuerpo\ncomo para una resaca.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi clase de hoy es a partir de la tercera hora, así que...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo que puedo ir con calma.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"se",file="se9026",id=1,loop=1},
{"text"},
text={
ja={
{
"Apenas intento cambiarme suena mi celular.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué número es este?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Era un número que no conocía.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Muy pocas veces recibo llamadas en mi celular.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Y menos de números desconocidos.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Número equivocado?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"se",stop=1,id=1,time=500},
{"se",file="se3434",id=2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hola?...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¡Ah, sí!”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿N-Notificación oficial?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",file="se9004",vol=40,id=1},
{"msgoff"},
{"bg",file="zbluesky_winter",speed=300000,rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/",x2=960,y2=0,x=-960,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo sabía, esto no iba a terminar bien...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Sentía el peso de mis pies entre cada paso subiendo la colina de Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya el consejero Murayama me odiaba. Y ahora que pisoteé su honor, era de\nesperarse...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, con la mala situación del país y ahora desempleado... Cómo duele esto.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"La verdad es que no había descartado la posibilidad de despido.\nPero ayudé al consejero Inoue, y pensé que lo más seguro sería que me dejaran seguir.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es terrible...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Cada vez se acerca más el portón del colegio.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"cgdel",id=-1},
{"bg",file="black",path=":bg/"},
{"se",id=1,file="se2924"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Naoya Kusanagi. He llegado.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_htd_000397",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pasa...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"msgoff"},
{"bg",file="bg059a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000398",ch="htd"},
},
ja={
{
name={"Directora"},
"“Debe haber sido todo un lío lo de anteayer. Buen trabajo.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, bueno... Sé que no pedí su permiso...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000399",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Y por qué necesitarías mi autorización? El consejero Inoue te la dio. Era\nobvio que también me llegaría la información a mí.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000400",ch="htd"},
},
ja={
{
name={"Directora"},
"“Además, el mismo señor Fridmann se movió también. Era obvio que algo\nsucedería.\nHe escuchado bastante de su buen olfato para el arte.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, pues entonces...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000401",ch="htd"},
},
ja={
{
name={"Directora"},
"“Aunque debo cumplir con decirte que el consejero Murayama está enfurecido.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? L-Lo sabía...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000402",ch="htd"},
},
ja={
{
name={"Directora"},
"“El consejero Inoue se llevó todo el crédito de lo que él planeó.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0004",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000403",ch="htd"},
},
ja={
{
name={"Directora"},
"“Estaba muy molesto. Despidan a ese mocoso, estuvo diciendo.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ehm... Respecto, a lo de hoy...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000404",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ah, sí. Tal como te comuniqué por teléfono, se trata de una notificación\noficial.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso quiere decir que...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000405",ch="htd"},
},
ja={
{
name={"Directora"},
"“La notificación debió haberse realizado antes de marzo, pero el incidente del\ngraffiti no lo permitió.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Antes de marzo? Eso quiere decir que los rumores son ciertos...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000406",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Rumores? ¿Qué rumores?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"bg",file="ev_com_j11_01",path=":ev/ev_com_j11/",set="ev_com_j11"},
{"text"},
text={
vo={
{"vo",file="fem_htd_000407",ch="htd"},
},
ja={
{
name={"Directora"},
"“Bueno, tratándose de una promesa, ya había sido decidido hace un buen\ntiempo...\nEstoy pensando en nombrarte como profesor a tiempo completo a partir\nde próximo año fiscal. Es decir, como empleado oficial.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"De ninguna forma esperaba escuchar eso.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Profesor a tiempo completo.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Es decir, ¿empleado oficial?",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Profesor a tiempo completo?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_htd_000408",ch="htd"},
},
ja={
{
name={"Directora"},
"“Tomaste la prueba de aptitud para colegios privados cuando eras profesor a\ntiempo parcial, y aprobaste.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_htd_000409",ch="htd"},
},
ja={
{
name={"Directora"},
"“Y ahora tendrás más estabilidad, económica y personal. No es mala oportunidad,\naunque todo queda en tus manos...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mala?! ¡Es una excelente oportunidad!\nP-Pero ¿por qué ahora?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Además, no he dado resultados en particular como profesor...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_htd_000410",ch="htd"},
},
ja={
{
name={"Directora"},
"“Poniendo a un lado tus méritos, es absurdo que sigamos tanto tiempo sin un\nprofesor oficial de arte. No en vano Yumihari ha egresado a muchos artistas.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_htd_000411",ch="htd"},
},
ja={
{
name={"Directora"},
"“El hecho de que no hayamos tenido un profesor oficial de arte hasta ahora es un\nproblema en sí.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_htd_000412",ch="htd"},
},
ja={
{
name={"Directora"},
"“Aunque, debo decir que fue difícil.\nEl consejero Murayama te tiene un fuerte rencor. Se opuso con furia...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_htd_000413",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pero es una promesa.\nNo es algo que pueda dejar de hacer solo por complacer a la directiva.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Disculpe... ¿De qué promesa habla?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_htd_000414",ch="htd"},
},
ja={
{
name={"Directora"},
"“No tengo más nada que explicar.\nPor ahora, quisiera una respuesta inmediata.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, acepto. Permítame tomar el cargo.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_htd_000415",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pues bueno, ¿podrías llenar estos documentos?\nLa verdad es que debieron haberse entregado hace varias semanas.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Entendido...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"se",file="se9048",vol=30,id=1},
{"text"},
text={
ja={
{
"Firmo todos los documentos sobre la mesa de la directora.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"bg",file="bg059a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000416",ch="htd"},
},
ja={
{
name={"Directora"},
"“Excelente. A partir del próximo año fiscal serás profesor oficial de\narte.\nTendrás los mismos privilegios que los otros profesores.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0003",head="sak_z1a",lv=4,id=9},
{"fgact",ch="紗希",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000417",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Qué tal? ¿No te gustaría revivir el club de arte?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se supone que son los estudiantes los que deben hacer eso, ¿no?\nNo los profesores.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000418",ch="htd"},
},
ja={
{
name={"Directora"},
"“Supongo. En fin, agradezco que aceptaras la posición, y te doy la bienvenida.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Muchas gracias a usted. Trabajaré duro.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Bajo mi cabeza en reverencia.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bgm",stop=1,time=1000},
{"se",file="se9012",id=1},
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"bg",file="bluesky_winter",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Bajo la colina de Yumenouki. Los capullos de cerezos estaban comenzando a\naparecer.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Están floreciendo rápido este año.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_aid_001676",ch="aid"},
},
ja={
{
name={"???"},
"“Así parece. Me pregunto cómo serán los cerezos de este año.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="zev_com_j12_01",id=9,lv=9,y=180,speed=60000,time=2000,sync=0,path=":ev/ev_com_j12/",set="ev_com_j12",y2=0,ax=1920,ay=1080,bx=-960,by=-540},
{"bg",file="zev_com_j12_02",id=8,lv=8,y=180,speed=60000,time=2000,sync=1,path=":ev/ev_com_j12/",set="ev_com_j12",y2=0,ax=1920,ay=1080,bx=-960,by=-540},
{"evset",file="ev_com_j12_01",set="ev_com_j12",path=":ev/ev_com_j12/"},
{"bgm",file="bgm022"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"cgdel",id=9,lv=5,time=400},
{"evset",file="ev_com_j12_02",set="ev_com_j12",path=":ev/ev_com_j12/"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001677",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, Ai. Profesora Ai.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_aid_001678",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vas de regreso, ¿verdad?\nYo también. Vamos, a casa.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Regresar?...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"bg",file="ev_com_j12_02",path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001679",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, a nuestra casa.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A la residencia Natsume?\nP-Pero se supone que habías sido transferida a la escuela hermana de Yumihari, y...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"bg",file="ev_com_j12_03",sync=0,face=1,time=400,path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001680",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fuh, el hábito de saltarse las explicaciones de la directora no ha cambiado.\n¿No te ha dicho nada?...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Absolutamente nada. Solo me acaban de notificar que me contratarán\noficialmente...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"bg",file="ev_com_j12_04",sync=0,face=1,time=400,path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001681",ch="aid"},
},
ja={
{
name={"Ai"},
"“Cielo santo, ¿se fue a la conclusión sin explicar nada? ¡Qué malvada es la\ndirectora Toritani!”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_aid_001682",ch="aid"},
},
ja={
{
name={"Ai"},
"“En primer lugar, no fui transferida a la escuela hermana de Yumihari. Me\nmandaron.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te mandaron?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_aid_001683",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así es. Ocurrió un pequeño problema allá, y me eligieron a mí para ir a\nresolverlo.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué tú?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"bg",file="ev_com_j12_05",sync=0,face=1,time=400,path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001684",ch="aid"},
},
ja={
{
name={"Ai"},
"“El problema ocurrió en un colegio de chicas, y necesitaban a una profesora\njoven como yo. Fue todo un lío.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_aid_001685",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y teniendo esa carga encima, le exigí a la directora Toritani que me prometiera\nalgo.\nQue de resolverlo todo te promovería a profesor oficial.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_aid_001686",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y por eso les pedí que te hicieran tomar la prueba de aptitud.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Por eso me obligaron a tomar la prueba siendo todavía empleado a medio\ntiempo.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eso quiere decir que la promesa... fue entre tú y la directora?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_aid_001687",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así es. Era demasiado cruel que te mantuvieran como profesor de tiempo parcial.\nYumihari ha estado escatimando su presupuesto de recursos humanos desde que\npasó a manos de los inversionistas. Wakata-san sufrió con eso también.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bg",file="ev_com_j12_01",sync=0,face=1,time=400,path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001688",ch="aid"},
},
ja={
{
name={"Ai"},
"“Nunca pude hacer nada por ti, Naoya.\nMás bien eras tú el que siempre me ayudaba a mí...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_aid_001689",ch="aid"},
},
ja={
{
name={"Ai"},
"“Además, lo de Shizuku... Supongo que ya no habrá problema en decirlo. Fuiste tú\nquien la salvó de los Nakamura, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_aid_001690",ch="aid"},
},
ja={
{
name={"Ai"},
"“A cambio de toda esa gran fortuna...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esas fueron... circunstancias forzosas...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_aid_001691",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kei estaba frustrado. Se supone que éramos nosotros, su familia, quienes debían\nayudarle. Y sin embargo, una vez más, un Kusanagi nos salvó...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_aid_001692",ch="aid"},
},
ja={
{
name={"Ai"},
"“Para Kei, los Kusanagi eran como héroes.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_aid_001693",ch="aid"},
},
ja={
{
name={"Ai"},
"“Tú, su rival. Y Kenichiro-san, su modelo a seguir.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kenichiro? ¿Kei llegó a conocer a Kenichiro?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_aid_001694",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jamás. Pero su motocicleta era de Kenichiro-san, al igual que mi Mach III.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_aid_001695",ch="aid"},
},
ja={
{
name={"Ai"},
"“La Mach III la usaba en Japón. La Vespa, en Nueva York.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_aid_001696",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kenichiro-san me la dejó cuando regresó... aunque Kei insistió en que quería\nusarla.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_aid_001697",ch="aid"},
},
ja={
{
name={"Ai"},
"“La Mach III es una motocicleta problemática, pero esa Vespa también.\nEra muy peligroso, y me opuse, pero...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_aid_001698",ch="aid"},
},
ja={
{
name={"Ai"},
"“Para Kei, Kenichiro-san fue un gran modelo a seguir.\nAunque nunca llegó a demostrarlo públicamente...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sabía que la Mach III era de Kenichiro, pero no que la Vespa también...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_aid_001699",ch="aid"},
},
ja={
{
name={"Ai"},
"“La cual estás montando ahora, puedo ver.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Es una motocicleta vieja, y requiere bastante mantenimiento.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bg",file="ev_com_j12_06",sync=0,face=1,time=400,path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001700",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así es. Kei también se quejaba de eso.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bg",file="ev_com_j12_01",sync=0,face=1,time=400,path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001701",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kei quería mucho a los Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_aid_001702",ch="aid"},
},
ja={
{
name={"Ai"},
"“No, no solo Kei. Shizuku también, e incluso yo...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"bg",file="ev_com_j12_02",sync=0,face=1,time=400,path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001703",ch="aid"},
},
ja={
{
name={"Ai"},
"“Todos queremos a Kenichiro Kusanagi y a Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"bg",file="ev_com_j12_01",sync=0,face=1,time=400,path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001704",ch="aid"},
},
ja={
{
name={"Ai"},
"“No es que pueda pagar todos los favores que nos has hecho con esto, pero\nprocuré que la directora cumpliera su promesa.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_aid_001705",ch="aid"},
},
ja={
{
name={"Ai"},
"“Si bien tuve que pasar un año entero allá, definitivamente valió la pena.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Conque esa era la razón...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_aid_001706",ch="aid"},
},
ja={
{
name={"Ai"},
"“Fue por eso que tuve que alejarme de la ciudad.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"bg",file="ev_com_j12_02",sync=0,face=1,time=400,path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001707",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y ya regresé.\nHe vuelto, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bienvenida de vuelta, Ai.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_aid_001708",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jejeje... Es algo penoso esto, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me parece...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_aid_001709",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bien, ¿regresamos? Tenemos mucho que contarnos.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_aid_001710",ch="aid"},
},
ja={
{
name={"Ai"},
"“La residencia Natsume... Solo ha pasado un año, pero la nostalgia es\nfuerte.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo también. Siento que he estado viviendo solo desde años.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_aid_001711",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vaya, qué lindo eres diciendo eso. ¿Me extrañaste?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... ya viste lo de ayer, ¿no? Si es que no fue un sueño...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_aid_001712",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, estabas llorando.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡F-Fue por el vómito!”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_aid_001713",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, sí.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_aid_001714",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué tiene de malo? Probablemente soy la única que puede ver ese lado tuyo.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡P-Por supuesto! ¡Y déjame acotar, es muy raro que me veas así!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_aid_001715",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vives siempre aguantando mucho, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_aid_001716",ch="aid"},
},
ja={
{
name={"Ai"},
"“Deberías llorar más. Y dejarte consentir más por mí.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-E-Eso, yo...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_aid_001717",ch="aid"},
},
ja={
{
name={"Ai"},
"“En nuestra situación actual es difícil llamarle a esto familia. Pero eso no\nquita que seamos los dos últimos de la familia Natsume.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"bg",file="ev_com_j12_07",sync=0,face=1,time=400,path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001718",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya no quiero que sigas intentando cargar con el peso de todo...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_aid_001719",ch="aid"},
},
ja={
{
name={"Ai"},
"“Quizá no lo parezca, pero puedo ser un gran apoyo para ti.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"bg",file="ev_com_j12_02",sync=0,face=1,time=400,path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001720",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así es. Seguiré cuidándote como tu hermana, hasta que te cases.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sigues siendo una onee-chan de aspecto muy infantil...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"bg",file="ev_com_j12_08",sync=0,face=1,time=400,path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001721",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Qué acabas de decir?!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bg",file="ev_com_j12_09",sync=0,face=1,time=400,path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001722",ch="aid"},
},
ja={
{
name={"Ai"},
"“Aunque, bueno...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_aid_001723",ch="aid"},
},
ja={
{
name={"Ai"},
"“S-Sí, con la edad que tengo, más bien me alegra que me digan que parezco\njoven...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="fem_aid_001724",ch="aid"},
},
ja={
{
name={"Ai"},
"“En fin, cuidaré de ti hasta tu matrimonio.\nY como profesora también te serviré de senpai.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bg",file="ev_com_j12_01",sync=0,face=1,time=400,path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
vo={
{"vo",file="fem_aid_001725",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bueno, ¿regresamos?\nA nuestra casa...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, vamos...",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"bg",file="ev_com_j12_10",path=":ev/ev_com_j12/",set="ev_com_j12"},
{"text"},
text={
ja={
{
"Los cerezos todavía no pasaban de ser capullos.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Se puede sentir la primavera viniendo, pero falta un poquito más.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Bajamos juntos la colina de Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Se puede ver toda la ciudad de Yumihari desde acá.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Todavía hay luz alrededor,",
{"rt2"},
"pero en unas pocas horas se pondrá el sol.",
{"rt2"},
"Y cuando llegue la noche, faroles y bombillas iluminarán la ciudad.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Las noches de Yumihari son tan hermosas como las flores de cerezos cayendo.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Seguramente entre cada pétalo, entre cada luz,\nhay la vida de una persona.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Los pétalos en sí son hermosos.\nPero son más hermosos cuando se juntan muchos.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Como las luces de causalidad de cada uno.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"La causalidad de una infinidad de vidas brilla en el paisaje.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Nuestra casa también es una de esas luces.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"La residencia Natsume.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"En ella están contenidos los sentimientos y el pasado de muchas personas.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Kotoko Natsume.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Mizuna Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Shizuku Natsume.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Kei Natsume.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Y...",
{"rt2"},
"Ai Natsume.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Y Naoya Kusanagi también.",
{"rt2"},
"Yo soy uno más.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Muchas cosas han sucedido en esa residencia.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Muchos recuerdos se produjeron en ella.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Buenos,\ny malos.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"De todo hay contenido allí.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Y por eso vamos de vuelta allá.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"No estoy estancado.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Ni tampoco he dejado de caminar.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Simplemente he estado labrando mi sendero acá.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Pienso eso, y veo al cielo.\n'Tranquilo, que no hemos dejado de caminar', dice Ai.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Caminaremos juntos, de ahora en adelante.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Juntos, sin prisa...",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Por este camino sin fin.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Seguimos caminando, a nuestro paso.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Ai se vuelve a verme,",
{"rt2"},
"y me ilumina con una gran sonrisa.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　Y entonces, casi imperceptible, se escuchó",
{"txruby",text="Sakura no Uta"},
" el poema de los cerezos",
{"txruby"},
".",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"eval",exp="g.clear_6=1"},
{"bgm",stop=1,time=8000},
{"se",stop=1,id=-1,time=8000},
{"vostop",stop=1,time=8000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=8000,file="white",path=":bg/"},
{"cacheclear"},
{"ex",time=0,func="wait"},
{"movie",file="ed2"},
{"bgm",stop=1,time=3000},
{"se",stop=1,id=-1,time=3000},
{"vostop",stop=1,time=3000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=3000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"タイトル"},
{"text"},
linkback="block_00197",
},
label = {
top={block="block_00000",label=1},
},
}
