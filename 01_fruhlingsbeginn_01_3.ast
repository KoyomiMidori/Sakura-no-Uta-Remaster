astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=120000,file="zbg040k",path=":bg/",x2=620,y2=-270,x=170,y=-270,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Mientras subía por la colina Yumenouki que llevaba al colegio, pude ver a\nmuchos estudiantes nuevos envueltos en nuevos uniformes y llevando bolsos\nnuevos.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"¿Será que están llenos de esperanza? Puedo ver sonrisas en varios de ellos.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Aunque, no puedo recordar ya la manera en que me sentía yo la primera vez que\nme paré frente al portón del colegio.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Probablemente no era muy distinto a ahora.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuaahhh...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Suelto un largo bostezo y subo lentamente las escaleras.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000017",ch="rnd"},
},
ja={
{
name={"???"},
"“Has llegado temprano.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg040a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"En el radiante aire de primavera se sintió, por un instante, algo de tensión.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Por supuesto, eso no es más que un malentendido.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Los alumnos que van al colegio siguen su camino, igual que hasta ahora.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"No es el aire lo que está tenso, soy yo.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000018",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Buenos días.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Suelto un raro saludo.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0010",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000019",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, ¿será que te has olvidado de mí? Yo vivía en el mismo vecindario que tú\nantes de mudarme, Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sí me acuerdo de ti. No hay problema.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento por lo de ayer. Me alteré un poco, y terminé ignorándote y huyendo...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000020",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, está bien... no tienes de qué preocuparte... Yo también tomé una actitud\nmuy confianzuda, a pesar de llevar tanto tiempo sin vernos...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, eso es lo normal. Lo que no es normal fue lo que hice yo.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0009",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000021",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Eso se debe también seguramente a lo de tu padre.... Ah, me enteré lo de tu\npadre por las noticias.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Él no tiene nada que ver. Ese no es el problema...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000022",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, por otro lado, ¿cómo has estado tú?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0003",head="rin_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0004",head="rin_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000023",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estuve bien todo este tiempo. Estar bien y saludable es lo único que puedo\nhacer bien.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, me alegro...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0002",head="rin_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0009",head="rin_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000024",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Aunque me sorprendí bastante. No pensé que llegaría a estar en el mismo\ncolegio, y además en el mismo salón que tú...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te habías dado cuenta ya?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0003",head="rin_z1b",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0004",head="rin_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000025",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto. En el momento en que entré al salón me di cuenta. Pero por culpa\nde eso me agité... Jaja.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, todos se rieron de ti...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000026",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Qué pena. Aunque también estaba nerviosa, así que mi primer saludo terminó de\nesa manera...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tampoco así. Todos estaban alegres...”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うんうん",size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000027",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, eso es porque todos los muchachos del salón son muy buenas personas.\nIncluso desde el primer día me ayudaron y apoyaron.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"La primera conversación que tuve con ella después de años.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Una conversación rara, torpe e incómoda.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Pero bastaron solo unos minutos de palabras para que empezara a sentir como\npoco a poco ese aire incómodo iba apaciguándose.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"No puedo quedarme siempre anclado al mismo problema.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Así es...",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Debo tratar de avanzar, en lo que pueda, hacia adelante...",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Porque Rin ha vuelto de nuevo a estas tierras...",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No. Rin, aún no te lo he dicho.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000028",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Q-Qué?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bienvenida de vuelta...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000029",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuiste tú la que dijo 'Ya regresé' apenas nos vimos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000030",ch="rnd"},
},
ja={
{
name={"Rin"},
"“C-Ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para 'Ya regresé' siempre debe haber un 'Bienvenido de vuelta', ¿no, Rin?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000031",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡S-Sí!”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Rin responde enérgicamente.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Quizás estos reencuentros no son tan malos después de todo...",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Eso pensé en este momento.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no hay nada que hacer parados acá.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Trato de subir una vez más las escaleras de la colina de Yumenouki, donde me\nhabía quedado parado.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0200",face="a0013",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000032",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡E-Esto! ¡Kusanagi-kun!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0200",face="a0002",head="rin_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000033",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya regresé...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0200",face="a0004",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=5,id=9},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000034",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ya regresé!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Los alumnos que subían por la colina voltearon a vernos.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Así de fuerte fue la voz de Rin.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Sin querer, se me escapó una sonrisa irónica.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Idiota, estás hablando muy fuerte...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0200",face="a0003",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0210",face="a0002",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000035",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajaja, lo siento. Me sentí algo feliz.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Rin sonríe, un tanto apenada.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bgm",stop=1,time=500},
{"fg",mode=-2},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000001",ch="rna"},
},
ja={
{
name={"???"},
"“¡Uwaan! ¡¿Aún desde mi primer día como nueva alumna debo presenciar esta clase\nde escenas?!”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Nueva alumna?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Nueva alumna. Sin embargo, esa voz se me hace familiar... Aunque el nivel de\nentusiasmo en su voz es algo distinto.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"bg",file="ev_com_a14_01",path=":ev/ev_com_a14/",set="ev_com_a14"},
{"bgm",file="bgm014"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rina Hikawa... Ahora que lo recuerdo, entrabas este año, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"user",mode="conf",ch="里奈"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000002",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, buenos días. Dejando eso de lado, siento como en mi primer día en Yumihari\nme han mostrado lo que significa la diferencia de escalones en las escaleras\nde la adultez, ehhh.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_rna_000003",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y ahora llevas una super hermosa novia que jamás había visto antes,\nKusanagi-san...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por qué concluyes eso...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_rna_000004",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mmm, ¿estuviste tratando de esconder a tu novia de tu hermanita? Qué frío de\ncorazón eres, eh. Yo no soy una hermanita tan poco tolerante.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000036",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¡K-Kusanagi-kun, ¿tenías una hermanita?!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, cálmate, Rin. Ella se llama Rina Hikawa. Para comenzar, su apellido es\ndistinto.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000037",ch="rnd"},
},
ja={
{
name={"Rin"},
"“C-Ciertamente. Pero tu padre estuvo soltero por un largo tiempo, así que,\nesto... creí que eso también...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, las revistas semanales llegaron a reportar varias veces las llamativas\nrelaciones de Kenichiro Kusanagi con las mujeres. Leyendo eso nadie se\nsorprendería si de verdad yo tuviera una hermanita de otra madre.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bg",file="ev_com_a14_02",sync=0,face=1,time=400,path=":ev/ev_com_a14/",set="ev_com_a14"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000005",ch="rna"},
},
ja={
{
name={"Rina"},
"“Esa hermanita de otra madre es Rina Hikawa.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni siquiera llegaste a conocer a Kenichiro... ¿Cómo vas a decir que eres mi\nhermanita de otra madre?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"bg",file="ev_com_a14_03",sync=0,face=1,time=400,path=":ev/ev_com_a14/",set="ev_com_a14"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000006",ch="rna"},
},
ja={
{
name={"Rina"},
"“Solo bromeaba. Traté de llamar la atención un poco frente a tu novia.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000038",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Llamar la atención?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"bg",file="ev_com_a14_04",sync=0,face=1,time=400,path=":ev/ev_com_a14/",set="ev_com_a14"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000007",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, digamos, no soy su verdadera hermanita. Soy su hermanita mental, o algo\nasí... En fin, esa clase de vergonzosa posición.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000039",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Llamar la atención frente a su novia... Hmmm.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Rin se puso a pensar por un momento. Y entonces...",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000040",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así que eres su hermanita mental. Sí, suena bien.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"bg",file="ev_com_a14_05",sync=0,face=1,time=400,path=":ev/ev_com_a14/",set="ev_com_a14"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué parte de eso suena bien?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000041",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es que a mí también me encantaría construir una relación tan encantadora y\nespecial como esa.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una hermanita mental no tiene nada de especial ni encantadora. Si te lo piensas\nbien, está más bien de locos eso...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"bg",file="ev_com_a14_01",sync=0,face=1,time=400,path=":ev/ev_com_a14/",set="ev_com_a14"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000008",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uh... ciertamente es así, pero la forma en que lo dices me lastima, eh. En\nprincipio, fue por culpa de Kusanagi-senpai que terminé en esta posición.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo? ¿Acaso hice algo?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"bg",file="ev_com_a14_01",sync=0,face=1,time=400,path=":ev/ev_com_a14/",set="ev_com_a14"},
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000009",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, sí, está bien, no es nada. La verdad es que no tengo muchas expectativas de\nti, Kusanagi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_rna_000010",ch="rna"},
},
ja={
{
name={"Rina"},
"“El interés que has tenido por mí ha sido terriblemente bajo desde hace tiempo.\nEs como para ponerse a suspirar.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000042",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jaja, Kusanagi-kun siempre es así. Pero no te preocupes, su nivel de interés\npor mí también es muy bajo...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, r-realmente no es así...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000043",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Al verlos a ustedes dos ahora, realmente me dio la impresión de que tienen una\nrelación especial. Al menos en mi caso, jamás tuve ninguna relación de ese\nestilo con él, fuera 'mental' o no...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"bg",file="ev_com_a14_05",sync=0,face=1,time=400,path=":ev/ev_com_a14/",set="ev_com_a14"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000011",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? Pero tú...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000044",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, te equivocas. No soy su novia, ¿verdad, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Sí... Así es.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000045",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Ves? Kusanagi-kun y yo no tenemos ninguna relación especial. Así que,\nHikawa-san, no tienes por qué tratar de llamar tanto la atención. Kusanagi-\nkun y yo solo nos conocemos desde hace tiempo.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_rna_000012",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Se conocen desde hace tiempo?... ¿A eso no le llaman normalmente amigos de la\ninfancia?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000046",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, ciertamente. Yo también quisiera salir y decir '¡Somos eso que llaman\namigos de la infancia!', pero... parece que tampoco fuimos eso...\ncreo... ¿no, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg040a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Por qué? Normalmente nos dirían amigos de la infancia a nosotros, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0017",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0015",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0016",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000047",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Será realmente así? ¿Habré sido yo realmente una amiga de la infancia para ti?\n¿No será que fui yo la verdadera amiga de la infancia mental para ti? No me\nmolestaría admitir que soy yo la única que se denomina así.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0016",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000048",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero nunca llegaste a contestar ninguna de las tantas cartas que te mandé.\nNunca llegaste a contactarme. ¿No es eso acaso una muestra de que eso es lo\núnico que represento para ti, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uh... E-Eso...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0017",head="rin_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000049",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Más que amigos de la infancia, parecemos más simples conocidos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ahora que lo dices de esa manera...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0004",head="rin_z1b",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000050",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, solo somos conocidos♪.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no quise decir eso... sino que...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0002",head="rin_z1b",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000051",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jeje.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0200",face="d0004",head="rin_z1d",lv=4,id=9},
{"fgact",ch="稟",act="icon",lv=4,id=9,icon="icon15z1",x=40,y=-550},
{"fgact",ch="稟",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000052",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Jeje, es raro verte tan inquieto, Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fgact",ch="稟",act="停止",lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000053",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo bromeaba.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Siento que acaba de ser bastante irónica, con una sonrisa...",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Pero... Veo que Rin no ha cambiado.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Estuve ignorando sus cartas todo este tiempo. Estuve ignorando, todo este\ntiempo, las palabras que ella trató de hacerme llegar una y otra vez...",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Esa ligera broma irónica es poca retribución para lo que le hice.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"En principio, esto debió haber dejado una gran mancha en nuestra relación. Pero\nRin...",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Lo dejó todo atrás como si fuera una simple broma mientras se reía.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Los 6 años que estuve ignorándola...",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000054",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pusiste una cara de aprietos de nuevo, Kusanagi-kun. No tienes por qué\ninquietarte tanto tampoco.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero, aun así...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0016",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_000055",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Claro que no. El asunto de las cartas ya fue saldado con mostrarme tu cara en\naprietos. El hecho de que te sientas apenado significa que, después de todo,\nte preocupaste un poco por mí...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000056",ch="rnd"},
},
ja={
{
name={"Rin"},
"“... Incluso con solo eso me siento feliz... creo.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1d0200",face="d0001",head="rna_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000057",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hikawa-san, mi nombre es Rin Misakura. Estuve todo este tiempo viviendo lejos\nde acá, pero ayer me transferí al colegio Yumihari como estudiante de tercer\naño.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0016",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0018",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0016",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000058",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Como puedes ver, no tengo ningún tipo de relación especial con Kusanagi-kun.\n¡Aunque! Pensé que nos llevábamos tan bien que podríamos llamarnos amigos de\nla infancia.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0015",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000059",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero ahora que lo pienso, quizás fui solo yo la que se apegó. Desde hace\nbastante tiempo he sido siempre muy buena en equivocarme y malentender las\ncosas.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, eso no es verdad.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000060",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kusanagi-kun dice eso para no hacerme quedar mal, pero en realidad, desde\npequeña siempre he sido una muchacha muy descuidada y que no sabe discernir\nel ambiente a su alrededor.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0012",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000013",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad?...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0010",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うんうん",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000061",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, por eso es que aun habiendo deseado tanto este reencuentro, me puse más\nbien nerviosa y no sabía cómo actuar. No tengo ningún remedio, soy\nterriblemente mala tomando distancia apropiadamente con los demás, y además\nmis habilidades comunicativas son pésimas.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0200",face="d0001",head="rna_z1d",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0200",face="d0011",head="rna_z1d",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0200",face="d0001",head="rna_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_000014",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por supuesto que no. Ustedes dos se veían muy naturales, como si se vieran\ntodos los días... Por eso pensé que los dos estaban saliendo.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0016",head="rin_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000062",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Gracias, es todo un honor que me digas eso. Kusanagi-kun sigue siendo tan\npopular con las chicas como siempre, ¿no? Me parece encantador que nos hayas\nmalinterpretado de esa manera, aunque sea por un instante.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no soy popular con las chicas. Más bien, a juzgar por la situación de ayer,\ntú parecías ser mucho más popular con los hombres, Rin. Y tus habilidades de\ncomunicación son bastante altas.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000063",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso crees? Solo trato de siempre tener en mente que soy fatal comunicándome,\nasí que vivo siempre con mucha prudencia en lo que a eso respecta. Las\npersonas torpes tenemos que esforzarnos a nuestra propia manera.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0012",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000015",ch="rna"},
},
ja={
{
name={"Rina"},
"“Misakura-senpai, si eres de tercer año, ¿entonces eso quiere decir que estás en\nel mismo año que Kusanagi-senpai?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0016",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000064",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, y tuve la suerte también de tocar en el mismo salón que él. Quisiera, tal\nvez, aprovechar la oportunidad y mejorar un poco nuestras raras e incómodas\nconversaciones.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0200",face="b0013",head="rna_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0002",head="rna_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_000016",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso no es cierto, Misakura-senpai. Realmente hablas con bastante naturalidad.\nNo solamente con senpai, sino también conmigo...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000065",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso crees? Me alegra que me digas eso, Hikawa-san.\nPero el hecho de que pueda hablar con tanta naturalidad no es por mí,\nsino porque tú eres una persona con la que se puede hablar fácilmente.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0013",head="rna_z1b",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0015",head="rna_z1b",x=345,lv=4,id=6},
},
vl02={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0011",head="rna_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_000017",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eso no es cierto. Aunque bueno, desde pequeña he sido siempre buena sonriendo,\npero son esas características sonrisas japonesas usadas para pasar el rato.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000066",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mmm, a mi no me parece que sea así... Tienes un particular aire a tu alrededor\nque hace bastante fácil romper el hielo. Y además, parecieras tener muchos\namigos.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0200",face="b0013",head="rna_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0200",face="b0002",head="rna_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_000018",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Parezco tener muchos amigos?... Ah, no, en realidad puedo contar fácilmente\ncon los dedos las personas con las que realmente llevo una relación cercana.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0200",face="d0012",head="rin_z1d",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0200",face="d0004",head="rin_z1d",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000067",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿En serio? De verdad no pareciera que fuera así. Ah, cierto. Hikawa-san, si no\nes molestia, ¿podrías contarme acerca de ti también?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0003",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000019",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me llamo Rina Hikawa, y entré este año al colegio Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0002",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0016",head="rna_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_000020",ch="rna"},
},
ja={
{
name={"Rina"},
"“Conozco a Kusanagi-senpai desde hace 6 años, y nos la hemos llevado muy bien\ndesde ese momento, y fue en parte bromeando, o quizás también por como\nsucedieron las cosas, que terminé en este puesto de hermanita mental.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0012",head="rin_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0011",head="rin_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000068",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿6 años? Ya veo. 6 años... Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0013",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000021",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sucede algo?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0013",head="rin_z1b",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0011",head="rin_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000069",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no es nada realmente serio. Solo que fueron hace 6 años cuando yo me mudé\nde esta ciudad...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0012",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000022",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0003",head="rin_z1b",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0002",head="rin_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000070",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Sí, así es! ¿Así que quizás viniste tomando el lugar que dejé libre, Rina-\nchan? Como la amiga de la infancia de Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0012",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000023",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así parece.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0013",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000071",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, lo hice de nuevo. Quizás fue un poco atrevido llamarte Rina-chan.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0003",head="rna_z1a",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000024",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jeje, eso no es cierto. No me importa que me llames así tampoco.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000072",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejeje, perdóname, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0004",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000025",ch="rna"},
},
ja={
{
name={"Rina"},
"“Rin-senpai, eres una persona algo misteriosa.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000073",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso crees? Pero es que me sentí feliz.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0200",face="b0013",head="rna_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000026",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Feliz?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000074",ch="rnd"},
},
ja={
{
name={"Rin"},
"“De que conoces una parte de Kusanagi-kun que yo no conozco...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0012",head="rna_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000027",ch="rna"},
},
ja={
{
name={"Rina"},
"“Misakura-senpai, tú conoces toda una época de Kusanagi-senpai que yo no\nconozco...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000075",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo que pensé... que se siente un tanto bien eso.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0004",head="rna_z1b",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000028",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, entiendo cómo te sientes.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うんうん",size=5,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000076",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, ¿pudiste entender lo que siento?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0002",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000029",ch="rna"},
},
ja={
{
name={"Rina"},
"“Probablemente estoy sintiendo lo mismo en este momento...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000077",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. ¿Sabes? Me alegro de poder haberte conocido, Rina-chan. Espero que podamos\nllevarnos bien de ahora en adelante.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0200",face="d0002",head="rna_z1d",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000030",ch="rna"},
},
ja={
{
name={"Rina"},
"“Claro, igualmente.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"¿Qué está sucediendo? Siento que están simpatizando en algo...",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Pareciera que estuvieran compartiendo los mismos sentimientos e ideas.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé muy bien por qué, pero según puedo ver se volvieron amigas. Aunque no\ntengo ni la más mínima idea de la razón.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0017",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000031",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No sabes... la razón?”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no logro entender muy bien por qué simpatizaron tanto.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0016",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000078",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajaja... Bueno, Kusanagi-kun es así.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",mode=-2},
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2b0210",face="b0011",head="rna_z2b",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0210",face="b0015",head="rna_z2b",lv=5,id=6},
},
vl02={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0200",face="b0008",head="rna_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_000032",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo, Kusanagi-senpai, así que tenías a una persona tan encantadora en tu\nvida. Ya había sentido un poco de su sombra en ti, pero... realmente, sí se\ntrataba de una persona maravillosa.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Por alguna razón, Hikawa susurra eso un tanto triste.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0200",face="b0015",head="rna_z2b",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2b0210",face="b0002",head="rna_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_000033",ch="rna"},
},
ja={
{
name={"Rina"},
"“Del tema de cómo me hago llamar a mí misma tu hermanita mental. Aunque bueno,\ntal como lo dice Misakura-senpai, ambos nos llevamos tan bien como si\nfuéramos hermanos.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"excall",label="flagon02",cond="g.rinclear==1&&g.makclear==1"},
{"excall",label="flagoff02"},
{"text"},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"select",label="label03",text="select"},
{"select",label="label04",exp="f.rna=f.rna+1",text="select"},
{"select",name="select01_01_2",mode="sys"},
{"text"},
select={
ja={
"¿Y por qué te haces llamar entonces mi hermanita mental?",
"Nos la llevamos tan bien como si fuéramos hermanos.",
{"rt2"},
},
},
labelcount=1,
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y por qué te haces llamar entonces mi hermanita mental?”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"excall",label="join2"},
{"text"},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nos la llevamos tan bien como si fuéramos hermanos, eh. Bueh, no puedo negar\nque de alguna forma u otra hemos estado juntos durante todo este tiempo.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"excall",label="join2"},
{"text"},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",mode=-2},
{"se",file="se9021",id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"¡¡Kikiki~!!",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"El rechinante sonido de unos frenos resuena alrededor.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_rna_000034",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah... Es el sonido de los frenos de una motocicleta.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este sonido...”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_ked_000430",ch="ked"},
},
ja={
{
name={"???"},
"“¡Ujajajajaja! ¡¡Es inevitable!! ¡¡Parece que no quiere frenar!!”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa... ¿Por qué tanto escándalo desde la mañana?...”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1d0200",face="d0016",head="rna_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000035",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es sin duda una aparición bastante escandalosa y llamativa.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_000079",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Alguien está haciendo su aparición con ese sonido?”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Hay humo saliendo del estacionamiento de bicicletas ubicado en la parte trasera\nde la puerta frontal.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Y entonces se escucha esa única y despreocupada voz.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="man_ked_000431",vol=30,ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajajajajaja, por eso es que los frenos de tambor no sirven. Basta con que les\nentre un poco de agua para que resbalen y pierdan el agarre.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0009",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000036",ch="rna"},
},
ja={
{
name={"Rina"},
"“Veo que aún sigue igual de despreocupado y alegre como siempre.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí... Ese idiota, parece que no puede quedarse sin destruir nada al momento de\nfrenar la motocicleta.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000080",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto... ¿Alguien acaba de llegar?”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mx=40,mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000432",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ohh! Pero si es Naoya.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No puedes quedarte tranquilo sin tener que doblar la pared del estacionamiento\nde bicicletas cada vez que aparcas la motocicleta?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000433",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero qué malo eres. No creas que choco siempre con la pared por querer hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? Pensé que era una costumbre tuya.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0008",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000434",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Me crees capaz de tener esa clase de costumbres? ¡Esa motocicleta es vieja, y\npor eso es difícil controlarla! Aunque le haga el mantenimiento necesario,\nbasta con un pequeño cambio en el clima para que empiece a fallar.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Igual que tu cerebro, eh.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000435",ch="ked"},
},
ja={
{
name={"Kei"},
"“Mi cerebro no falla con los cambios del clima.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Entonces tu cara sí?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0022",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000436",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Mi cara y el clima no tienen ninguna relación!”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0022",head="kei_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000081",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es un amigo tuyo, ¿no, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000082",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Según vi ayer también en el salón, parecen ser muy buenos amigos.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000437",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Ah?!”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0015",head="kei_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000438",ch="ked"},
},
ja={
{
name={"Kei"},
"“E-Eh, Naoya...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"se",file="se9004",id=1},
{"fg",mode=-2},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0015",head="kei_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
"Kei se acerca a mí, sin decir una sola palabra.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Su mirada es distinta a la de hace un momento.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fgact",ch="圭",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ogh?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Y ahora, me agarra el cuello.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",mode=-2,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",lv=4,id=6,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="man_ked_000439",ch="ked"},
},
ja={
{
name={"Kei"},
"“E-Esa chica es... Esa, la chica con la cual te reencontraste ayer tan\nemotivamente...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Kei mira a Rin mientras me mantiene agarrado.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa ahora? ¿Viste a Rin y te excitaste por ser un lolipedo?”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
vo={
{"vo",file="man_ked_000440",ch="ked"},
},
ja={
{
name={"Kei"},
"“Escucha, vea por donde la veas, la chica que tenemos enfrente es una mujer\nadulta. ¿Por qué se supone entonces que soy un lolipedo?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, justamente por ser un lolipedo pensé que te habías decepcionado al ver a\nRin crecida. Y entre tanta ira terminaste abrazándome.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="man_ked_000441",ch="ked"},
},
ja={
{
name={"Kei"},
"“Naoya... La verdad es que ya no sé por dónde rayos debería comenzar a\nreplicarte a eso...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"ex",time=0,func="wait"},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0008",head="rin_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000083",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, ¿Kusanagi-kun? ¿Podrías presentarme a tu amigo?”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no hay problema. Es sin duda alguna un tipo bien raro, pero en el fondo es\nun lolipedo y alguien bastante insignificante. Se llama Kei Natsume.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"quake",mode="mw"},
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0008",head="rin_z1a",x2=0,x=345,lv=4,id=6},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0022",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000442",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Imbécil, qué manera de presentarme es esa!”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues es el resultado de tratar de explicar de la manera más suave posible la\nimpactante realidad de que eres un ped*filo... ¿Algún problema?”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="icon",lv=4,id=5,icon="icon05z1",x=40,y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_000443",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No hay más que problemas en eso! ¡En primer lugar, ¿en qué momento se supone\nque me convertí en un ped*filo?!”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fgact",ch="圭",act="停止",lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No acabas de enojarte como un loco al ver cómo Rin había crecido?...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うんうん",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000084",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajaja, Kusanagi-kun, no sé realmente de qué están hablando, pero no es bueno\nque le tomes tanto el pelo a tus amigos. No hay nadie capaz de enfadarse por\nel hecho de que yo haya crecido...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, es verdad! Quedó encantado al ver las fotos de cuando eras una niña. Y\nahora que te vio crecida se enojó de repente...”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うんうん",size=5,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000085",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, ¿de verdad? Según me han dicho, yo era muy linda cuando era una niña,\nasí que eso me alegra.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000444",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No, no, esa manera de explicar lo que sucedió se presta a muchos\nmalentendidos, no es cierto! ¡Aún ahora eres bastante linda! ¡Puedes sentirte\nsegura de eso!”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0016",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000086",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tranquilo, lo entiendo perfectamente. Kusanagi-kun ha sido siempre bastante\nbueno en tomarle el pelo a los demás desde que era un niño, así que ya estoy\nacostumbrada a este tipo de escenas.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000087",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Natsume-kun, veo que Kusanagi-kun te ha abierto bastante su corazón. El\nKusanagi-kun de hace tiempo no tenía muchas personas a su alrededor con los\nque pudiera bromear de esa manera.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000445",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uhh.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué te estás sorprendiendo?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0011",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000446",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué significa esto?! ¡Naoya!”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿De qué hablas?!”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000447",ch="ked"},
},
ja={
{
name={"Kei"},
"“Esta muchacha es bastante inteligente, su manera de pensar es flexible, y es\namable y gentil. ¡¿Es que acaso no es demasiado perfecta?!”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000088",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? E-Esto, m-me están sobreestimando demasiado. No sé por qué piensan eso de\nmí...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="うんうん",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_ked_000448",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Mira nada más! ¡Esta atractiva humildad, esta sencillez! ¡¿Estuviste ignorando\ntodo este tiempo las cartas de esta chica tan buena?!”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, se podría decir que sí.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"fgact",ch="稟",act="icon",lv=4,id=6,icon="icon18z1",x=-150,y=-550},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000089",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y-Ya les dije, me están sobreestimando demasiado. Poniendo eso de lado,\nNatsume-kun, ¿me permites un momento?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000449",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Rin se pone de frente con Kei.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Y entonces, junto con una sonrisa――",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000090",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me presento de nuevo, me llamo Rin Misakura. Viví en esta ciudad hasta hace 6\naños. Y fui, además, la amiga de la infancia de Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"Solo en el instante en que Rin usó la palabra 'amiga de la infancia', volteó su\nmirada hacia mí.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Por supuesto, yo asentí con la cabeza.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"Rin es, con toda seguridad, mi amiga de la infancia.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000091",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por eso es que espero poder llevármela bien de nuevo con todos en esta ciudad.\nAsí que, es un placer conocerte.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
"Rin hace una reverencia, bajando bastante la cabeza.",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
"Es raro ver a alguien en estos tiempos que saludé de manera tan cortés y formal\na sus compañeros del mismo año y a sus kouhai.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000450",ch="ked"},
},
ja={
{
name={"Kei"},
"“I-Igualmente.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
"Cualquiera se quedaría sorprendido, pero seguramente nadie se sentiría ofendido\npor esa manera de actuar.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"Después de todo, a Rin no le gustó que Kei y yo discutiéramos acerca de ella.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"Por eso es que, con tal de parar la conversación, realizó ese saludo tan\nformal.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"Esa manera de actuar es bastante típica de Rin.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000092",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Debo ir a la sala de profesores, ¿les importa si me voy ya?”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, está bien. Nos vemos en un rato.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000093",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Sí, nos vemos en el salón!”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"se",file="se9004",id=1},
{"msgoff"},
{"fg",ch="稟",sync=1,mx=40,mode=-1,lv=4,id=6},
{"text"},
text={
ja={
{
"Ella es realmente recta y cortés.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"No ha cambiado ni un poquito...",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000451",ch="ked"},
},
ja={
{
name={"Kei"},
"“... Demonios, Naoya, realmente eres bastante malo.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué te refieres?”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0015",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000037",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ciertamente. No sabía que conocieras a una persona tan encantadora...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es muy encantadora?”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000452",ch="ked"},
},
ja={
{
name={"Kei"},
"“Claro que lo es. Es perfecta en todo.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Perfecta...”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"Rin es tan educada, hábil y cortés que se le podría llamar perfecta. Pero es\ntambién del tipo de persona cuyas partes torpes son realmente torpes.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
"No hay ningún factor que pueda negar la afirmación de Hikawa de que Rin es 'tan\nencantadora', pero...",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0008",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000453",ch="ked"},
},
ja={
{
name={"Kei"},
"“Después de ver esto, quedé como un simple tonto.”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ahh... Te refieres a eso...”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál es el problema entonces? Igualmente eres un tonto.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",x=-345,lv=4,id=5},
{"fgact",ch="圭",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000454",ch="ked"},
},
ja={
{
name={"Kei"},
"“Realmente siempre hablas más de la cuenta, eh...”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0200",face="d0011",head="rna_z1d",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0200",face="d0017",head="rna_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_000038",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si tan solo Kusanagi-senpai tuviera aunque sea la mitad de la clara amabilidad\nde Misakura-senpai...”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es eso de clara amabilidad?”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0016",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0003",head="rna_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rna_000039",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Quién sabe? Vamos, ¿hay algún problema acaso? Basta con que aquellos que\npuedan entender tu incomprensible amabilidad puedan entenderla. O debería\ndecirle mejor, tu espíritu de autosacrificio.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué es ese espíritu de autosacrificio?”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0002",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000040",ch="rna"},
},
ja={
{
name={"Rina"},
"“En fin, vayamos ya a nuestros salones. Llegaremos tarde.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000455",ch="ked"},
},
ja={
{
name={"Kei"},
"“Tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
"Conversé con Rin después de tanto tiempo.",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"El largo, largo tiempo que estuvo detenido para los dos.",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
"Ese tiempo comienza a moverse de nuevo, a partir de ahora.",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
"Tanto las cosas buenas como las malas... Todas comienzan a moverse de nuevo.",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"ex",time=1000,func="wait"},
{"excall",file="01_fruhlingsbeginn_01_4"},
{"text"},
linkback="block_00284",
},
label = {
top={block="block_00000",label=1},
flagon02={block="block_00176",label=1},
flagoff02={block="block_00177",label=1},
label03={block="block_00177",label=1},
label04={block="block_00179",label=1},
join2={block="block_00181",label=1},
},
}
