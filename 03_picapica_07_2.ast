astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"se",id=1,file="gatya"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg059c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"bgm",file="bgm108"},
{"text"},
text={
vo={
{"vo",file="fem_htd_000196",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ah... Así que eran ustedes.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003036",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A juzgar por esa forma de hablar, ya llevaba un buen rato esperándonos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_htd_000197",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pues pensé que en algún momento vendrían.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000198",ch="htd"},
},
ja={
{
name={"Directora"},
"“Aunque no pensé que vendrían tantos, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",mode=-1,lv=4,id=6},
{"fg",ch="霧乃",size="z1",mode=3,resize=1,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000064",ch="krd"},
},
ja={
{
name={"Kirino"},
"“D-Disculpe... señora Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000199",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ya no soy señora de nadie. Si te cuesta llamarme por mi nombre, puedes llamarme\ndirectora.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="霧乃",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_krd_000065",ch="krd"},
},
ja={
{
name={"Kirino"},
"“E-Está bien.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="霧乃",mode=-1,lv=4,id=6},
{"fg",ch="紗希",time=500,mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",x2=-345,x=0,lv=4,id=5},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000200",ch="htd"},
},
ja={
{
name={"Directora"},
"“Veamos entonces...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"La directora nos ve a todos, y sonríe.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000201",ch="htd"},
},
ja={
{
name={"Directora"},
"“Para ser sincera, yo tampoco manejo por completo todo el trasfondo de este\nasunto. Sin embargo, si todos los que estamos acá aportamos la información\nque tenemos, entonces creo que podríamos esclarecer enteramente lo que\nsucede. ¿Qué les parece?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003037",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, supongo.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Toritani muestra aprobación ante las palabras de la directora, con una\nexpresión un tanto amarga en su rostro.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0002",head="sak_z1b",x=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1b0000",face="b0009",head="sak_z1b",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000202",ch="htd"},
},
ja={
{
name={"Directora"},
"“Y sí, antes de comenzar...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"se",file="se9012",id=1},
{"fg",mode=-2},
{"bg",x=400,file="zbg059c",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="紗希",size="z2",mode=3,resize=1,path=":fg/sak/z2/",file="sak_z2a0000",face="a0005",head="sak_z2a",x=-210,lv=5,id=7},
{"fg",ch="霧乃",size="z2",mode=3,resize=1,path=":fg/kir/z2/",file="kir_z2a0000",face="a0008",head="kir_z2a",x=345,lv=5,id=6},
{"fg",ch="霧乃",speed=500,mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0008",head="kir_z2a",x2=345,x=500,lv=5,id=6},
{"se",stop=1,id=1,time=500},
{"text"},
text={
ja={
{
"La directora se acerca apresuradamente a Kirino-san. Avasallada por el ímpetu\nde la directora, esta retrocede un paso.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="紗希",speed=600,mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0005",head="sak_z2a",x2=-210,x=0,lv=5,id=7},
{"se",file="se9010",id=2},
{"text"},
text={
ja={
{
"La directora tomó fuertemente del cuello de la blusa de Kirino-san.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0001",head="kir_z2a",x=500,lv=5,id=6},
{"fgact",ch="霧乃",act="びっくり",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000066",ch="krd"},
},
ja={
{
name={"Kirino"},
"“¡Mm!!”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0009",head="sak_z2a",x=0,lv=5,id=7},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0008",head="sak_z2a",x=0,lv=5,id=7},
},
},
text={
vo={
{"vo",file="fem_htd_000203",ch="htd"},
},
ja={
{
name={"Directora"},
"“... Tanto que te insistí que no te convenía regresar. Pero qué mujer...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0009",head="kir_z2a",x=500,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000067",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Eh, e-es--, lo, siento much--”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0009",head="kir_z2a",x=500,lv=5,id=6},
{"fgact",ch="霧乃",act="うなづく",lv=5,id=6},
{"text"},
text={
ja={
{
"Kirino-san cerró fuertemente sus ojos, pensando que la directora la golpearía.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="紗希",speed=500,mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0008",head="sak_z2a",x2=0,x=-210,lv=5,id=7},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Sin embargo, esta desabotonó con un movimiento inesperadamente suave la blusa\nde Kirino-san... y sacó un pequeño aparato.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg059c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=6,sync=0},
{"extrans",time=500},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003038",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Toritani, a quien tenía al lado, relaja por completo sus hombros junto a un\nrespiro de alivio.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pensabas que la golpearía?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005",head="mak_z1d",lv=4,id=6},
{"text"},
text={
ja={
{
"Toritani pone una expresión de descontento ante mi pregunta.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003039",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nunca se sabe lo que podría pasar, ¿no?... Además, la relación entre ellas dos\nes complicada... Y por otro lado, Kusanagi, ¿desde qué momento te diste\ncuenta de 'eso'?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Lo que la directora sacó de la ropa de Kirino-san fue un pequeño micrófono\noculto. No era ningún modelo de alta gama, sino de aquellos que se consiguen\nfácilmente en Internet.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm? Ah, el micrófono oculto. Todo este tiempo ha estado nerviosa, y con las\nmanos puestas sobre su pecho, así que pensé que quizás se trataba de eso.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003040",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Yo también me di cuenta de que estaba haciendo eso, pero... Es realmente\nasombroso que hayas llegado a la conclusión de que era un micrófono, sin\nsiquiera saber de quién se trata la persona que ha estado amenazando a\nKirino-san.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kirino-san dijo que vino para engañarte y usarte, ¿no? Así que bueno, por eso\nimaginé que existía la posibilidad de que la persona tras todo esto está\ndeseosa de saber lo que está pasando.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y en base a lo que Kirino-san dijo, parece que se trata de una persona\nextraordinariamente egocéntrica, así que me dio la sensación de que tal vez\nsería del tipo que le encanta escuchar a escondidas a los demás.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="真琴",mode=-1,lv=4,id=6},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"fg",ch="霧乃",size="z1",mode=3,resize=1,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",x=345,lv=4,id=6},
{"fgact",ch="霧乃",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_krd_000068",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Esto, esto solo---, l-lo siento...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Kirino-san ve con una expresión de miedo a la directora y luego al micrófono.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_htd_000204",ch="htd"},
},
ja={
{
name={"Directora"},
"“No tienes por qué disculparte. No estoy enojada.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="紗希",act="うなづく",lv=4,id=5},
{"se",file="se_pechi",id=1},
{"text"},
text={
ja={
{
"La directora pone el micrófono en el suelo, y lo aplasta con su tacón.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",x=345,lv=4,id=6},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0010",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000205",ch="htd"},
},
ja={
{
name={"Directora"},
"“No sé si lo hizo para disfrutar espiando nuestra conversación o para conseguir\npruebas que le dieran alguna ventaja, pero... Esto es justamente el tipo de\ncosas que a ella se le ocurriría, y de muy mal gusto, diría.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="霧乃",mode=-1,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003041",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Directora, usted conoce a la persona que ha estado amenazando a Kirino-san,\n¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0002",head="sak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="紗希",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000206",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Mm? Sí, ya he tratado varias veces con su abogada y representante legal.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Disculpe, ¿se trata de la abogada que vino con usted la vez pasada a Quimera?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000207",ch="htd"},
},
ja={
{
name={"Directora"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y la persona con la cual estuvo también hablando frente al mural.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000208",ch="htd"},
},
ja={
{
name={"Directora"},
"“En ese momento solo estábamos platicando. Aunque, vaya que lo recuerdas, eh.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo las vi por casualidad, pero me llamó algo la atención, así que bueno...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",mode=-2},
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es la misma persona que estaba conduciendo el vehículo en el cual se montó al\nsalir de repente y apresuradamente de Quimera cuando le serví el café, ¿no,\nKirino-san?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
delay={
vl01={
{"fgact",ch="霧乃",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_krd_000069",ch="krd"},
},
ja={
{
name={"Kirino"},
"“S-Sí... así es.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="霧乃",mode=-1,lv=4,id=6},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003042",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En pocas palabras, ya la negociación había comenzado, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_htd_000209",ch="htd"},
},
ja={
{
name={"Directora"},
"“Tal cual.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_htd_000210",ch="htd"},
},
ja={
{
name={"Directora"},
"“Me tomé la molestia de preguntarle varias cosas a la abogada, de manera de\ntener información suficiente para organizar una discusión y llegar a un\narreglo fuera de la corte.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_htd_000211",ch="htd"},
},
ja={
{
name={"Directora"},
"“Por eso es que sé también que te metiste en un problema con ella hace poco.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003043",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Espera, no estarás hablando de lo que ocurrió en la escuela dominical, ¿o sí?...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, eso del problema en la escuela dominical... ¿Hablan del asunto del\ngolpe que te dieron en la escuela dominical? De lo que estuviste\ndisculpándote con Komaki y Kosachi.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003044",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003045",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No pretendo dar un acto revelador acá ni nada parecido, pero para decir la\nverdad, la persona que me cacheteó aquel día era una vieja conocida... No,\nmejor digo las cosas como son. Una familiar mía.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003046",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es una familiar del lado de los Nakamura, así que en realidad no es ninguna\nfamiliar ni nada parecido, y llevaba ya 10 años sin verla, así que ni ella ni\nyo nos dimos cuenta al principio.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003047",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso es nos sorprendimos bastante cuando ambas nos dimos cuenta de quién era\nla otra.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000212",ch="htd"},
},
ja={
{
name={"Directora"},
"“Es de imaginarse. Desde que me divorcié-- no, ya desde mucho antes que eso,\nmadre e hija hemos sido tratadas de enemigas naturales por parte de ella...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oigan, sé que ambas parecen saber de quién se trata, ¿pero podrían decirme\nquién rayos es?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003048",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, cierto... parece que eres el único acá un poco confundido al respecto.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, no, bueno, es que entre tanto escuchar me llamó la atención.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003049",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“La mujer que causó el escándalo conmigo en la escuela dominical, y que trama\nahora usar a la madre de Kei, Kirino-san, para obtener todas las pinturas de\nKei es... Reika Honma.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003050",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Su nombre de soltera es Reika Nakamura. La hermana menor de Shoichi Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Nakamura...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"No pensé que llegaría a escuchar ese apellido acá.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000213",ch="htd"},
},
ja={
{
name={"Directora"},
"“Honma es uno de los miembros de la directiva del colegio Yumihari. Parece que\nse casó con Reika después de ingresar a la directiva.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000214",ch="htd"},
},
ja={
{
name={"Directora"},
"“Reika Honma-- o si la llamamos por su apellido de soltera, Reika Nakamura. Una\nintegrante más de la familia Nakamura, con un extraordinariamente inflado e\ninjustificado orgullo.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0010",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000215",ch="htd"},
},
ja={
{
name={"Directora"},
"“No hace falta explicar el fuerte odio que siente por mí, después de yo haber\nensuciado el nombre de la familia Nakamura y de su actual jefe. Odio que, por\nsupuesto, siente también por Makoto, siendo ella mi hija.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_krd_000070",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Pero Makoto-san también posee la sangre de los Nakamura, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000216",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, bueno... En fin, es un hecho que Reika nos ha odiado a mí y a mi hija\nfuertemente aun antes de que yo me divorciara de su hermano.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="霧乃",mode=-1,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0018",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003051_n",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... Reika nunca se cansaba de decirme cosas.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0009",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000217",ch="htd"},
},
ja={
{
name={"Directora"},
"“Yo también fui atormentada hasta más no poder por Reika cuando pertenecía a los\nNakamura. Fue realmente terrible. Su manera de molestar y acosar era bastante\nfuerte, aun para tratarse de mi cuñada.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",mode=-2},
{"ex",time=0,func="wait"},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Seguramente esa mujer se cree el centro del universo, y no tiene ninguna duda\nal respecto. La conversación prosigue a medida que vamos intercambiando las\npiezas de información que cada quien maneja.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Fue en marzo que el hijo de Reika le causó esa grave herida a Nei. Fue una\nherida severa, que requería de rehabilitación, tal como me lo imaginé cuando\nconocí a Nei.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"El hijo de Reika también sufrió una leve herida, aunque nada más allá de un\nrasguño.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Reika tomó esa pequeña herida como excusa para solicitarle una disculpa formal\ny una enorme cantidad de dinero a Kirino-san.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Siendo madre soltera y sin tener a ningún familiar o amigo a quien recurrir,\nKirino-san no puede pagar esa suma.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Reika es la clase de persona que disfruta hasta la médula abusar y acosar a los\ndébiles, y al parecer, después de amenazar y abusar de Kirino-san, estaba\npensando en usarla como una especie de esclava entre ella y las madres de los\notros niños, quienes actúan como sus seguidoras. Todo a cambio de eximirle\ndel pago del dinero.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"ex",time=0,func="wait"},
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003052",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Reika llegó a decirte todo eso, Kirino-san?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",x=-345,lv=4,id=5},
{"fgact",ch="霧乃",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_krd_000071",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Sí... Y por otro lado, Nei asiste a otro colegio, pero según lo que escuché de\nalguien que conocí en la escuela dominical...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_krd_000072",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Parece que hay una especie de sistema de castas implantado en el colegio al\ncual asiste el hijo de Honma-san, conformado por todo el círculo de madres.\nCada cierto tiempo eligen a personas para ser explotadas de una forma\nterrible, casi como esclavas. Tal como lo hicieron conmigo...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="霧乃",mode=-1,lv=4,id=5},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000218",ch="htd"},
},
ja={
{
name={"Directora"},
"“Parece que Reika ha tenido trabajando a esa abogada para que borre todas las\npruebas de eso, y además para hacer llegar sus amenazas.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003053",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Todo eso se lo dijo la abogada?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000219",ch="htd"},
},
ja={
{
name={"Directora"},
"“Para nada. Fui yo quien investigó todo eso, ¿no es lo obvio? Ella también tiene\nel deber de confidencialidad. En ningún momento puede revelar más información\nde la necesaria.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0010",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000220",ch="htd"},
},
ja={
{
name={"Directora"},
"“Aun por muy harta que pueda estar de trabajar como la abogada exclusiva de\nReika, eh...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003054",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Reika planeaba en un principio usar a Kirino-san como su propia esclava. ¿En\nqué momento pasó de eso a querer robar los cuadros de Kei?”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_krd_000073",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Según lo que dijo Honma-san, parece que en un principio le pareció haber\nescuchado mi nombre en algún lado. Y después de investigar bien, se dio\ncuenta de que yo era la madre de Kei...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0004",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0011",head="sak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000221",ch="htd"},
},
ja={
{
name={"Directora"},
"“'Se supone que Kei es hijo de los Nakamura, y aun así tú te lo llevaste junto a\ntodas sus pinturas'. Eso fue lo que me dijo Reika cuando registré a Kei en la\nfamilia Natsume.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“'Te lo llevaste'... No pareciera ser la forma en la que uno se referiría a una\npersona.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0004",head="sak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000222",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, para Reika, las pinturas son dinero, así que vio a Kei como una especie de\nmáquina para hacer dinero. Jamás se cansó de hostigarme, acusándome de\nllevarme de la familia Nakamura a ese gallinita de los huevos de oro.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003055",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No sabía, que habían hablado de eso...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000223",ch="htd"},
},
ja={
{
name={"Directora"},
"“... Son cosas que pasaron hace mucho tiempo.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0010",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000224",ch="htd"},
},
ja={
{
name={"Directora"},
"“El contacto por parte de esa abogada comenzó a eso de principios de verano...\nsi no me equivoco. Fue una especie de ligero golpe previo a las discusiones\nfuera de corte. Aunque de igual manera no llegué a atender sus peticiones de\ndiscusión en ningún momento.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003056",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y fue entre eso que llegué a meterme en problemas con Reika en la escuela\ndominical, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000225",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ahora que el odio por nosotras de Reika se ha avivado aún más, no es de\nsorprenderse que comience a tramar en cualquier momento en usar la\nnegociación respecto a los cuadros de Kei para hacernos sufrir a nosotras\ndos, madre y hija.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",mode=-2},
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_krd_000074",ch="krd"},
},
ja={
{
name={"Kirino"},
"“'Aunque no pueda recuperar los cuadros de Kei, si puedo hacer que Makoto-san se\nponga de mi lado y logro que madre e hija se confronten entre si de una\nmanera cruel y horrenda... Solo de imaginármelo me siento extasiada'... Eso\nfue lo que dijo...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0010",face="a0011",head="sak_z1a",x=-345,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0018",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003057",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_htd_000226",ch="htd"},
},
ja={
{
name={"Directora"},
"“Vaya... ya veo.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Recuperar los cuadros de Kei...",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Esa mujer se cree con derecho de hacer eso sin razón alguna, solo por el mero\nhecho de ser una Nakamura.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000227",ch="htd"},
},
ja={
{
name={"Directora"},
"“Bien, creo que ya todos tienen una idea de lo que está pasando, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Todos asentimos.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0009",head="sak_z1a",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000228",ch="htd"},
},
ja={
{
name={"Directora"},
"“Aunque, por otra parte... Kirino-san.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="紗希",time=450,mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0009",head="sak_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",x=345,lv=4,id=6},
{"fgact",ch="霧乃",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000075",ch="krd"},
},
ja={
{
name={"Kirino"},
"... Ugh.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Kirino-san tiembla ante el sobrio y tranquilo llamado de la directora.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000229_n",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Por qué volviste? Te di suficiente dinero y te saqué de esta ciudad para que\nescaparas de las manos de Shoichi Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_htd_000230",ch="htd"},
},
ja={
{
name={"Directora"},
"“Para ese entonces aún eras joven, seguramente no tenías la suficiente\nsabiduría. Pero con la edad que tienes ahora, deberías tener ya un mínimo de\ncriterio al momento de hacer las cosas. ¿No es así?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="霧乃",act="いいえ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_krd_000076",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Lo siento... señora... perdón, Saki-sama. Después de todo lo que hizo por mí,\nyo... realmente, estoy avergonzada con usted...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_krd_000077_n",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Pero de verdad, sucedieron tantas cosas, y... Aun con Nei en mi vientre, gasté\ntodos mis ahorros... Me sentía tan sola, y...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_krd_000078",ch="krd"},
},
ja={
{
name={"Kirino"},
"“De verdad, de verdad, lo siento... perdóneme... lo, siento...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0009",head="sak_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_htd_000231",ch="htd"},
},
ja={
{
name={"Directora"},
"“... Lo mismo hiciste cuando diste a luz a Kei. Llorar y disculparte sin parar.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fgact",ch="霧乃",act="いいえ",size=2,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000079",ch="krd"},
},
ja={
{
name={"Kirino"},
"“... Lo... siento.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000232",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Es que acaso estás conforme con eso?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000080",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Y-Yo...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000081",ch="krd"},
},
ja={
{
name={"Kirino"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",x=345,lv=4,id=6},
{"fgact",ch="霧乃",act="おじぎ",size=3,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000082",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Discúlpeme...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_htd_000233",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Es esa tu respuesta?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_krd_000083",ch="krd"},
},
ja={
{
name={"Kirino"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Kirino-san se queda cabizbaja y sin decir nada, temblando.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_htd_000234",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Crees que tu hija estaría conforme con eso?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",x=345,lv=4,id=6},
{"fgact",ch="霧乃",act="びっくり",size=3,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000084",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Y-Yo...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_htd_000235",ch="htd"},
},
ja={
{
name={"Directora"},
"“Estás bastante equivocada.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",x=345,lv=4,id=6},
{"fgact",ch="霧乃",act="びっくり",size=3,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000085",ch="krd"},
},
ja={
{
name={"Kirino"},
"“... Uh.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
delay={
vl01={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_krd_000086",ch="krd"},
},
ja={
{
name={"Kirino"},
"“L-Lo sé. Soy una mala persona que todo lo hace mal... Una mujer terrible...\nUna buena para nada...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0004",head="sak_z1a",x=-345,lv=4,id=9},
{"fgact",ch="紗希",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000236",ch="htd"},
},
ja={
{
name={"Directora"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000237",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ese no es tu error. Deja de intentar consolarte tratando de reducirte a ti\nmisma como persona, sin prueba alguna.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000087",ch="krd"},
},
ja={
{
name={"Kirino"},
"“... Uh...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_htd_000238",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Qué es lo que de verdad debes decir? Vamos, dilo.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",x=345,lv=4,id=6},
{"fgact",ch="霧乃",act="おじぎ",size=3,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000088",ch="krd"},
},
ja={
{
name={"Kirino"},
"“... Yo...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000089",ch="krd"},
},
ja={
{
name={"Kirino"},
"“He estado pensando bastante por mi cuenta... Pero, hablé con la abogada, y me\ndijo que no hay ninguna otra manera de proceder... Y por eso es que...\nnecesito, a como dé lugar... los cuadros de Kei...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"bgm",stop=1,time=500},
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0008",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0009",head="sak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000239",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ya veo. Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0002",head="kir_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_krd_000090",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Eh... E-Entonces--”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=600,file="zbg059c",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="紗希",size="z2",mode=3,resize=1,path=":fg/sak/z2/",file="sak_z2a0000",face="a0004",head="sak_z2a",x=-345,lv=5,id=5,sync=0},
{"fg",ch="霧乃",size="z2",mode=3,resize=1,path=":fg/kir/z2/",file="kir_z2a0000",face="a0002",head="kir_z2a",x=345,lv=5,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm105"},
{"text"},
text={
vo={
{"vo",file="fem_htd_000240",ch="htd"},
},
ja={
{
name={"Directora"},
"“Parece que de verdad no entiendes, ni has entendido nada.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0001",head="kir_z2a",x=345,lv=5,id=6},
{"fgact",ch="霧乃",act="びっくり",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000091",ch="krd"},
},
ja={
{
name={"Kirino"},
"“... Uh.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0008",head="sak_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000241",ch="htd"},
},
ja={
{
name={"Directora"},
"“Puede que seas tú quien haya dado a luz a Kei. Pero Kei no es de tu posesión.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0004",head="sak_z2a",x=-345,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000242",ch="htd"},
},
ja={
{
name={"Directora"},
"“Y por eso mismo, las pinturas de Kei no son tuyas. Por supuesto, tampoco son\nmías.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0008",head="sak_z2a",x=-345,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000243",ch="htd"},
},
ja={
{
name={"Directora"},
"“Yo simplemente estoy resguardándolas. La casa de los Toritani no es más que un\nlugar para administrar y resguardar sus cuadros. Planeo devolverle a Kei\ntodos sus cuadros resguardados ahora en la casa Toritani cuando se vuelva\nmayor de edad.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0005",head="sak_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000244",ch="htd"},
},
ja={
{
name={"Directora"},
"“Estoy cuidando de los cuadros de Kei para evitar que los Nakamura le traigan\nproblemas a Kei y a los Natsume, o saquen alguna falsa acusación en torno a\nsus cuadros. Solo eso.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fgact",ch="紗希",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000245",ch="htd"},
},
ja={
{
name={"Directora"},
"“Y lo hago porque soy yo quien se encargará de batallar con esa familia.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0005",head="sak_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000246",ch="htd"},
},
ja={
{
name={"Directora"},
"“Bien. Te daré un último empujoncito. Lo que debes decir acá, y ahora, no es\n'Deme los cuadros de Kei, por favor'.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_htd_000247",ch="htd"},
},
ja={
{
name={"Directora"},
"“Es 'Présteme dinero, por favor'. ¿No es así?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fgact",ch="霧乃",act="びっくり",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0009",head="kir_z2a",x=345,lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_krd_000092",ch="krd"},
},
ja={
{
name={"Kirino"},
"“¡Mm!! P-Pero... eso...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"La directora ignora las palabras de Kirino-san, y prosigue con las suyas.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_htd_000248",ch="htd"},
},
ja={
{
name={"Directora"},
"“Y no dinero para pagarle a Reika. Dinero para darle a tu hija la rehabilitación\nque necesita.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0009",head="sak_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000249",ch="htd"},
},
ja={
{
name={"Directora"},
"“... No hay nada en lo que yo pueda simpatizar contigo. Contigo y con esa vida\nque has llevado, esa vida de solo llorar y pedir disculpas.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0008",head="sak_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000250",ch="htd"},
},
ja={
{
name={"Directora"},
"“Pero aun sabiendo eso, quiero preguntarte esto.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_htd_000251",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Piensas quedarte sin hacer nada, únicamente llorando y viendo cómo tus hijos\nsufren por tu culpa?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_krd_000093",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Uh... uhhh...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0004",head="sak_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000252",ch="htd"},
},
ja={
{
name={"Directora"},
"“Yo lo protegeré.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0005",head="sak_z2a",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000253",ch="htd"},
},
ja={
{
name={"Directora"},
"“Compartamos o no la misma sangre, yo decidí hacerlo mi hijo, y por eso lo\nprotegeré. A mi manera.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg059c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003058",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Toritani está observando fijamente la conversación entre Kirino-san y la\ndirectora.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Con sus puños apretados, olvidando incluso respirar y parpadear, para no pasar\npor alto ni una sola palabra――",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="真琴",mode=-1,lv=4,id=6},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0000",face="a0005",head="sak_z1a",x=-345,lv=4,id=5},
{"fg",ch="霧乃",size="z1",mode=3,resize=1,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
"La directora observa fijamente a Kirino-san a la cara. En su mirada no hay\nninguna intención de recriminar, ni tampoco algún sentimiento de desprecio.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_htd_000254",ch="htd"},
},
ja={
{
name={"Directora"},
"“¿Qué harás tú? Decide. Usa tus propias palabras, y di lo que realmente deseas.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fgact",ch="霧乃",act="おじぎ",size=3,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000094",ch="krd"},
},
ja={
{
name={"Kirino"},
"“... Uh... *uuh*... uh...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="霧乃",my=40,mode=-1,lv=4,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Kirino-san se pone de cuclillas. De su empequeñecido cuerpo solo se pueden\nescuchar sollozos. Todos nos quedamos en silencio.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"10 minutos, 20 minutos... Nos quedamos en silencio, a pesar del tiempo,\nesperando a que Kirino-san comenzara a hablar.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",mode=-2,sync=0},
{"bg",y=-580,file="zbg059c",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="霧乃",size="z2",mode=3,resize=1,path=":fg/kir/z2/",file="kir_z2a0000",face="a0009",head="kir_z2a",x=345,lv=5,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_krd_000095",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Ayúdeme...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Cubierta en lágrimas, una tenue y ronca voz se escapa de los labios de la\ntemblante Kirino-san, junto a una silbante respiración.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0008",head="kir_z2a",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000096",ch="krd"},
},
ja={
{
name={"Kirino"},
"“No importa lo que suceda conmigo... Salve a mi hija... Salve a Nei, por\nfavor...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="霧乃",size="z2",mode=3,path=":fg/kir/z2/",file="kir_z2a0000",face="a0009",head="kir_z2a",x=345,lv=5,id=6},
{"fgact",ch="霧乃",act="いいえ",size=3,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000097",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Ella solo tiene 5 años aún... Sería... sería demasiado cruel para ella que\npierda la habilidad para caminar bien...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="紗希",size="z2",mode=3,resize=1,path=":fg/sak/z2/",file="sak_z2a0000",face="a0001",head="sak_z2a",x=-345,lv=5,id=5},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"La directora se acerca a Kirino-san y se arrodilla frente a ella, poniendo sus\nmanos sobre sus frágiles hombros, tratando de consolarla.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0003",head="sak_z2a",x=-345,lv=5,id=5},
{"fgact",ch="紗希",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000255",ch="htd"},
},
ja={
{
name={"Directora"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0005",head="sak_z2a",x=-345,lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="紗希",size="z2",mode=3,path=":fg/sak/z2/",file="sak_z2a0000",face="a0001",head="sak_z2a",x=-345,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_htd_000256",ch="htd"},
},
ja={
{
name={"Directora"},
"“Te prestaré el dinero, y ganaré a como dé lugar en esa negociación. Si llega a\nsuceder algo, ven y habla conmigo lo más rápido posible.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_htd_000257",ch="htd"},
},
ja={
{
name={"Directora"},
"“Te puedo ayudar en muchas cosas, y de ser necesario, te puedo asignar un\nguardaespaldas.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_krd_000098",ch="krd"},
},
ja={
{
name={"Kirino"},
"“G-Gracias... Muchas, gracias... Uh, uuhhh...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",mode=-2,sync=0},
{"bg",file="bg059c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003059",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si es necesario proteger a Kirino-san y a su hija de Reika hasta que terminen\nlas negociaciones, entonces yo me encargaré de eso.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera un segundo. ¿Qué vas a hacer con la Exposición Moore?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003060",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No pasa nada. Puedo seguir elaborando mi obra mientras protejo a Kirino- san y\na su hija. Le pediré el favor a Shizuru-sa... A la dueña de Quimera...\nPodrían vivir por ese tiempo en Quimera, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No. Si es por eso entonces esconderlas en mi casa sería la mejor opción para\nque no las encuentren.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003061",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eh, pero... eso--”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No insistas. Nuestra señora directora está siempre ocupada, y por lo general no\nsuele estar en casa. Aun asignándole un guardaespaldas, no es buena idea\nocultarlas a las dos en la casa Toritani.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú también estás bastante ocupada, y es poco realista la idea de que intentes\nfaltar al colegio para protegerlas a las dos. La mejor opción es esconderlas\nen mi casa. Es el lugar que menos relación tiene con todas ustedes... ¿No es\nasí, señora directora?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="真琴",mode=-1,lv=4,id=6},
{"fg",ch="紗希",size="z1",mode=3,resize=1,path=":fg/sak/z1/",file="sak_z1a0010",face="a0001",head="sak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000258",ch="htd"},
},
ja={
{
name={"Directora"},
"“... Si no te importa, pues debo decir que esa propuesta me sería de bastante\nayuda.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay problema.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="紗希",mode=-1,lv=4,id=5},
{"fg",ch="霧乃",size="z1",mode=3,resize=1,path=":fg/kir/z1/",file="kir_z1a0000",face="a0001",head="kir_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",lv=4,id=6},
{"fgact",ch="霧乃",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_krd_000099",ch="krd"},
},
ja={
{
name={"Kirino"},
"“E-Esto... Lo siento...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No se disculpe más, por favor. Además, por una pequeña casualidad su hija y yo\nnos conocemos.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0007",head="kir_z1a",lv=4,id=6},
{"fgact",ch="霧乃",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_krd_000100",ch="krd"},
},
ja={
{
name={"Kirino"},
"“¿E-Eh?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Kirino-san no para de parpadear, aún con un rostro de asombro. La directora\ntambién está algo sorprendida.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Parece que Toritani lo sabía ya. Aunque era de imaginarse.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No la conozco muy bien a usted, pero quiero proteger a su hija... A Nei.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso, se lo pido. Use mi casa, por favor.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por otro lado, hasta ahora lo único que le he dado a Nei han sido caramelos...\nCuando tenga tiempo dígame cuáles son los verdaderos platillos favoritos de\nNei.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0002",head="kir_z1a",lv=4,id=6},
{"fgact",ch="霧乃",act="うなづく",lv=4,id=6},
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0009",head="kir_z1a",lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="霧乃",act="うなづく",lv=4,id=6},
},
vl02={
{"fgact",ch="霧乃",act="いいえ",size=3,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_krd_000101",ch="krd"},
},
ja={
{
name={"Kirino"},
"“Claro... sí... está, bien... lo siento... no, gracias, muchísimas gracias...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg059c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=1000},
{"se",vol=40,id=1,file="se1599"},
{"fg",ch="紗希",size="z1",mx=-40,mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
"La directora salió de la habitación de descanso anexa a su oficina.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Entró para dejar reposando a Kirino-san, quien estaba exhausta después de la\ncontinua serie de ataques de nervios y estrés.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"En lo que respecta a Nei, parece que la directora envió a alguien a buscarla en\nel momento en que le dijimos que iríamos a su oficina.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"La directora recibió la notificación en su teléfono de que Nei estaba a salvo.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_htd_000259",ch="htd"},
},
ja={
{
name={"Directora"},
"“La niña viene en camino en un vehículo que mandé. Hoy las dejaré a las dos\ndurmiendo acá, así que váyanse ya.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien. Estamos a la orden para venir en cualquier momento. Solo llámenos si\nnos necesita.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fgact",ch="紗希",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000260",ch="htd"},
},
ja={
{
name={"Directora"},
"“Sí, gracias. Y disculpen las molestias.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, regresemos ya. Mañana tenemos clases, y debes estar cansada también,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003062",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Sí.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Toritani lanza un respiro, y recupera la compostura. Seguramente quiere\nquedarse para cuidar de Kirino-san y Nei.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003063",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me retiro entonces, con permiso. Cuide de Onda-san, por favor.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0002",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000261",ch="htd"},
},
ja={
{
name={"Directora"},
"“No tienes qué preocuparte tanto, yo me encargaré de todo. Tranquila.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="紗希",size="z1",mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_htd_000262",ch="htd"},
},
ja={
{
name={"Directora"},
"“Ah, y algo más.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",x=345,lv=4,id=6},
{"fg",ch="紗希",speed=1000,mode=3,path=":fg/sak/z1/",file="sak_z1a0000",face="a0001",head="sak_z1a",x2=-345,x=-100,lv=4,id=5},
{"text"},
delay={
[1300]={
{"fgact",ch="紗希",act="うなづく",time=300,lv=4,id=5},
{"se",file="se9010",id=1},
},
},
text={
ja={
{
"La directora se acerca a Toritani, y le da un papel enrollado. Después de\nvacilar por un instante, Toritani tomó el papel en silencio.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_htd_000263",ch="htd"},
},
ja={
{
name={"Directora"},
"“Es muy raro de ti que sigas estancada todavía allí, eh.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"La directora le dice eso a Toritani al cruzarse, y esta baja la cabeza sin\ndecir nada. Era difícil ver su cara oculta por el cabello desde donde estaba.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"msgoff"},
{"bg",file="znightsky_summer",speed=300000,time=2000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm029"},
{"text"},
text={
ja={
{
"Vamos bajando la colina de Yumenouki en medio de la noche. Toritani ha estado\nen silencio todo este tiempo desde que salimos de la oficina de la directora.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué fue lo que te dio la directora?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003064",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Toritani abre el papel enrollado, sin decir nada. El dibujo plasmado sobre ese\npapel, tan largo como un pergamino colgante, llega a mis ojos.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es... ¿Una escalera?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"se",file="se0897s",vol=50,id=1},
{"text"},
text={
ja={
{
"Toritani asiente, todavía en silencio, y me da a agarrar un extremo del\npergamino mientras va desenrollándolo.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"El dibujo supera fácilmente los 2 metros.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"El pergamino fue creado uniendo varias hojas de papel de construcción, como las\nque se emplean en la primaria, con goma para pegar o algo parecido, logrando\neste largo.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Había una escalera dibujada, extendiéndose de manera recta y atravesando el\ncielo de la noche.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"En el extremo que tenía en mis manos estaba dibujada una pequeña parte del\ntecho de una vieja mansión europea.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"La escalera parte de ese techo, y se va extendiendo de forma recta hacia el\ncielo. Larga, bastante larga la escalera, esta atraviesa con contundencia el\ncielo nocturno, del cual no se veían casi estrellas.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Y entonces, mi mirada llega al extremo superior que Toritani sostenía en sus\nmanos.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"En la cima de la escalera, no había nada.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"No es que no había nada desde un principio. El extremo del pergamino estaba\ncortado de manera bastante delicada, con una tijera o algo así.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg038c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003065",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Sabes? Este dibujo lo pintó Kei hace bastante tiempo.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003066",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es un dibujo de aquella época en la que él y yo aún vivíamos en la casa de los\nNakamura...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003067",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Originalmente, estas escaleras llegaban hasta la luna.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003068",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fui yo quien dibujó la luna. Y Kei dibujó las escaleras, de manera que llegaran\na ella.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003069",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kei unió todas las hojas de papel de construcción que tenía, y creó esa larga,\nlarga escalera...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003070",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero esa luna ya no está.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003071",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Porque yo misma la tiré con mis propias manos.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003072",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“De pequeña, era una niña tonta, que lloraba y pataleaba pidiendo la luna.\nPero... sí. Desde aquel día, decidí que dejaría de perseguirla.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003073",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y para eso, corté con tijera la obra que Kei y yo elaboramos.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003074",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tratando de convencerme a mí misma que no importara cuán larga fuera la\nescalera que me dibujaran, todo era una mera ilusión. Tratando de convencerme\nque mis manos no podrían llegar hasta esa luna que yo tanto quería...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003075",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“En ese momento llegué incluso a cercenar los buenos sentimientos de Kei, todo\npara darle fin a mi deseo. Y aun así.. sí, es exactamente tal como lo dice la\ndirectora.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003076",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Una parte de mi corazón está aún estancada en ese lugar, en ese momento.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003077",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Qué pena doy, ¿no?... De verdad...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="真琴",mode=-1,lv=4,id=6},
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Toritani comenzó a enrollar de nuevo el dibujo de la escalera.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Enrollo el dibujo junto a Toritani, avanzando hacia adelante.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"Y finalmente, despego mis manos del dibujo. Mi distancia con Toritani era ahora\ninfinitamente corta.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Toritani, ahora cerca de mí y viéndome desde abajo, se encogió de hombros y se\nrió.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003078",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Desde hace tiempo siempre dice las cosas de esa manera. Más que estricta, es\ndel tipo que te empuja al abismo buscando que te valgas por ti mismo. Con\nfrialdad...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0028",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003079",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero, como cosa rara, sus palabras de hace un rato no me causaron ningún\nshock como hubiera sucedido en el pasado.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0004",head="mak_z2a",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_003080",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sentí incluso que, de alguna forma, intentó decirme que mantuviera mis pies\nfirmes sobre el suelo. Pero... esas palabras de aliento fueron demasiado\ntorpes. ¿No te parece?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Todo el estrés había desaparecido del rostro de Toritani, y su sonrisa debajo\nde la noche se veía bastante suave.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003081",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dicen que los niños crecen y maduran, así sus padres los dejen solos, y\nrealmente es cierto. Ah, aunque supongo que es raro que lo diga yo, siendo la\nniña en este caso.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pienso igual. Los niños maduran solos, aunque sus padres no estén para ellos.\nPero, aun no teniéndolos con nosotros, estarán siempre en algún rincón de\nnuestro corazón o de nuestra cabeza. Lo queramos o no.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0028",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003082",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aun no teniéndolos con nosotros, estarán siempre en algún rincón de nuestro\ncorazón o de nuestra cabeza... Sí...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0012",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003083",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Habías dicho que la razón por la cual descubriste que Kirino-san era la madre\nde Kei se parecía a la mía. Pero ¿no será que en realidad hay algo más\ntambién?”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003084",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué piensas eso?”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, bueno, me dio esa sensación.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0025",head="mak_z2a",lv=5,id=6},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003085",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te dio esa sensación, eh...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque bueno, para ser un poco más preciso, pensé eso cuando vi tu expresión y\ntu manera de hablar. Pensé que, tal vez se trataba de algo que no querías\ncontarle.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0027",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003086",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí... estás, en gran parte, en lo correcto.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0026",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003087",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aquel día que conocí a Kirino-san... El perfil de su rostro mientras estaba\nfuera de sí, estupefacta en la parada de buses, se parecía a aquel que tenía\nKei hace bastante tiempo.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003088",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hace tiempo, lo único de lo que hablábamos los dos eran de cosas deprimentes y\ntristes. Aunque es realmente difícil imaginarse eso ahora, supongo.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003089",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sería terrible hablarle a una madre de la época más oscura de su hijo, ¿no\ncrees?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Eres muy bondadosa.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0011",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003090",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No tanto, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003091",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... No te llego ni a los talones en eso.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
