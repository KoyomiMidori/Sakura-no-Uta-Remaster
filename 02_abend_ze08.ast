},
},
text={
vo={
{"vo",file="fem_yum_000523",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues, ahora que te has enterado de mis verdaderas intenciones pensé que no me\nquedaba más que violarte aquí y ahora.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000680",ch="rna"},
},
ja={
{
name={"Rina"},
"“Deja de revelar intenciones tan peligrosas con tanta ligereza.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
