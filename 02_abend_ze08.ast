block_00018={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0006",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000679",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Eso es lo que quiero saber yo!”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0015",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
