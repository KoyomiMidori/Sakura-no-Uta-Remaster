{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000711",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, ¿eh? No, no es eso.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"No se sintió como si hubiera recordado algo.",
{"rt2"},
