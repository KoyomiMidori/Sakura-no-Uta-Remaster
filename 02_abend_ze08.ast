},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_yum_000559",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0010",head="rna_z1d",lv=4,id=5},
{"text"},
delay={
