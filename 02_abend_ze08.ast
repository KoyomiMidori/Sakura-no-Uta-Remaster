},
},
text={
vo={
{"vo",file="fem_rna_000678",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Espera! ¿Por qué, te estás, bajando, las pantis, justo ahora?”",
{"rt2"},
},
},
},
