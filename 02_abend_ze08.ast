text={
vo={
{"vo",file="fem_rna_000672",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿Ah?!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Me despierto.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Me parece haber visto algo.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Fue un sueño. Me dio toda la sensación de haber tenido un sueño, pero no logro\nrecordar lo que vi.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1d0000",face="d0009",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000673",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fuu...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Me limpio el sudor...",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Me siento sin fuerzas, sin ganas de hacer nada.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0011",head="rna_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_000674",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué estará pasando conmigo?...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_yum_000517",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero qué carita tan hermosa tienes durmiendo...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
