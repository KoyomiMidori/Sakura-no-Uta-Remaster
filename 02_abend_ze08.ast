{"text"},
text={
vo={
{"vo",file="fem_yum_000519",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No me queda otra opción más que violarte!”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",mode=-2},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0007",head="rna_z1e",x=-345,lv=4,id=5},
