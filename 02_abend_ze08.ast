{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0006",head="rna_z1e",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000676",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Esa tampoco es una opción válida! ¡¿Qué haces susurrando semejantes locuras\nmientras duermo?!”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0008",head="yum_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000520",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vaya, pero qué pena, Rinita, ¿acaso estabas despierta? No habrás escuchado lo\nque acabo de decir, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0010",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000677",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Considerando la situación, no te parece lógico pensar que sí te escuché?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"se",id=1,file="se2016"},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0010",head="yum_z1a",x=345,lv=4,id=6},
