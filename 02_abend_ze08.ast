},
},
text={
vo={
{"vo",file="fem_rna_000710",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no... no sucede nada...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Sentí como si algo llenara por completo mi cabeza... ¿Qué se supone que es\nesto...?",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_yum_000560",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Recordaste algo?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0100",face="d0012",head="rna_z1d",lv=4,id=5},
{"text"},
delay={
