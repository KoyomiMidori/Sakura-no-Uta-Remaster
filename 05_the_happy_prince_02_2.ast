astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"bgm",file="bgm030"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003981",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Q-Qué tal?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Veo el cuadro de Rin.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Su obra finalmente culminada.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Mi impresión... normal. Común y corriente.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No está mal. Lo has hecho bien para haber comenzado a pintar hace medio año.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003982",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no al nivel para ir a una universidad de artes, pero no está mal para ser\nsolo un pasatiempo. Lo has hecho bien.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003983",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Está difícil que pueda ir a una universidad de artes entonces, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, universidades de artes hay varias. Pero que puedas vivir de eso, es otra\ncuestión...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si bien es importante entrenamiento desde la infancia, el factor decisivo es el\ntalento. Pintores talentosos pintan bien, los no tan talentosos no tan bien.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La proporción de aspirantes y admitidos está por encima de veinte veces en la\nmás prestigiosa, la universidad de artes de Tokio (Geidai). Solo cincuenta\nadmitidos en pintura de óleo, en otras especialidades apenas llegan a veinte.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es normal fallar una, dos e incluso tres veces.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O eso dicen, pero los talentosos sí entran. Si apenas entran cincuenta, ya no\npuedes llamar a eso examen de ingreso, es simple competición.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahí los ves, esos que en la infancia eran elogiados una y otra vez por ser\nbuenos pintando, con confianza absoluta en sus habilidades.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todos ellos practican sin descanso sus cuadros de ingreso en las academias\npreparatorias, para luego reunirse de a miles en un mismo lugar a pintar. Al\nfinal, solo entran unas pocas decenas.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dirán que Toudai es difícil, pero allá no tienen estos números tan\ndesproporcionados.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003984",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, probablemente. Aun en Ciencias III el número de aceptados es el doble.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"No sé qué significa Ciencias III, pero no sabía que habían otros lugares donde\nel número de aceptados fuera menor a cien...",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003985",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Y tal vez tú sí puedas, Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Imposible, no es. Tendría que intentarlo para saber. Aunque por todos lados hay\nmucha gente talentosa, no sería fácil.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003986",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Has presentado en muchas exposiciones, ¿verdad? Supongo que conocerás a algunas\nde esas personas talentosas.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Conocerlos, eh...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Solo apareció un nombre en mi cabeza. La opción obvia, por supuesto.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"De lo que recuerdo, no hay nadie más...",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Desde pequeño he estado moviéndome por aquello que podríamos llamar la tierra\nsagrada del arte.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Por eso las exposiciones de Japón tienen cierto aire pueblerino para mí.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"El mismo viejo intentó hacerme ir a la universidad en el extranjero. Y es que\nsus conexiones más talentosas eran de afuera, además de que el arte japonés\nno tiene mucha popularidad.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Así entres en la universidad más prestigiosa de Japón, las puertas a la fama\ninternacional no se te abrirán tan fácilmente.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"El arte en este país está muy cerrado.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"La proporción de galardonados japoneses en la Exposición Moore es la prueba de\neso.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"No hubo ninguno antes de Kenichiro, y los que vinieron después los puedes\ncontar con una sola mano. Y sin embargo, las universidades extranjeras logran\nobtener galardones todos los años.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Además, todos los años siempre sale alguien en primer lugar.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no se me ocurren muchos nombres... Aunque sí recuerdo a algunos con\ntalento para el dibujo...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003987",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Y Kei-kun?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Kei? No lo sé.... En primer lugar, sus pinturas no serían tan bien vistas en\nuna universidad de artes.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003988",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿En serio? Tan bueno que es.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es un genio en el dibujo y las representaciones, el problema es su\npersonalidad. Es muy egocéntrico...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No creo que tenga mucho chance en otras, aunque en una tan peculiar como la de\nartes de Tokio tal vez sí. Siempre y cuando consiga un profesor que le gusten\nsus cuadros.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003989",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Siendo tan difícil de ingresar debe ser una institución élite, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La universidad de artes de Tokio? Pues, en artes aplicadas nunca les faltan\nlas ofertas de trabajo. Aunque, en lo que concierne a bellas artes no brillan\nmucho...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003990",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Bellas artes?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bellas artes. También le puedes llamar artes puras. Pintura, escultura y\neso.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003991",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sus artistas de bellas artes han podido llegar al podio internacional?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues digamos que con esa intención se creó esa universidad...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque los resultados no se acercan mucho a ese ideal...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero bueno, no es nada que tenga que ver con nosotros.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003992",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿No piensas aplicar a una universidad de artes, Nao-kun?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si estuviera aplicando a una no estaría usando mi tiempo de esta manera, ¿no\ncrees?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003993",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo, no tendrías tiempo para ayudarme con mi pintura.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Exactamente.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, no más charla. Hora de volver a casa y estudiar.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",lv=4,id=9},
},
vl02={
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003994",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, tienes razón. Gracias por haberme ayudado todo este tiempo.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te preocupes, solo tuve que enseñarte lo básico, no fue difícil. Si fuese\npara aplicar a una universidad de artes ahí sí me hubiese puesto más serio.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que tú has pasado más trabajo ayudándome a intentar subir mis\ncalificaciones.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003995",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pues parece que han subido, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, estoy estudiando todo lo que pueda. Quizá pueda hacer un gran cambio\nde seguir así.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003996",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Aplicar conmigo a la misma universidad, por ejemplo?!”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No... tampoco tanto...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Estás en el top 100 nacional de calificaciones en el modelo de prueba del\nexamen nacional...",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"¿Cómo demonios podría aplicar a la misma universidad que tú?",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Desde hace poco he comenzado a participar en los modelos de prueba del examen\nnacional. De ahí entendí con claridad la monstruosidad de las calificaciones\nde Rin Misakura.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Ni siquiera en el mejor colegio de la provincia podrías conseguir a alguien con\ntan buenas calificaciones.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya se acerca la Exposición Moore, eh...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003997",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ciertamente. Han pasado los meses y ya se siente como invierno.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué estarán pintando los muchachos?...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003998",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Parece que Rina-chan no presentará nada...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. No creo que Makoto esté muy feliz con eso.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003999",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Al parecer Yuumi-chan sí lo hará.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, de que puede presentar puede. Aunque probablemente le devolverán el\ncuadro en un abrir y cerrar de ojos.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004000",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿En serio?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El número de obras presentadas en la Exposición Moore es enorme, según he\nescuchado la primera selección termina siempre muy rápido.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004001",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Según, una vez llegas a la sexta selección, el tiempo de devolución se alarga\nbastante.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004002",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Sexta selección?! ¿T-Tantas?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si incluyes la última son ocho. Si cuentas la nominación para cada premio, hay\notra más. Aunque bueno, no creo que haya ningún artista en este país que\npueda llegar hasta ahí.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004003",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No hay nadie en el país...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto. Es la gran Exposición Moore. Su prestigio internacional es\nincomparable.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg077a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"La Exposición Moore tiene ocho selecciones.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"La anormal cantidad de selecciones se debe a que hay varias fundaciones y\nempresas involucradas.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Y por ser tantas, los resultados de la octava y última selección donde se\ndebaten los premios mayores, el 'Platine Épaulard', 'Or Baleine' y 'Argent\nDaufin', se publican al iniciar el año nuevo.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Por lo tanto, se hacen varias ceremonias de condecoración.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Los nombres de los premios cambian dependiendo del género. Si nos limitamos a\nla sección de pintura, los nombres se basan en animales del océano Atlántico.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"'Airain Loutre', solo tres lugares a nivel mundial. Hace tres años ganaron tres\njaponeses.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"'Airain Phoque', solo dos lugares. No ha habido ningún ganador japonés.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"'Airain Otarie', solo un lugar. Hace seis años hubo un ganador japonés.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"'Argent Daufin', solo un lugar. Hace cinco años hubo un ganador japonés.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"'Or Baleine', solo un lugar. No ha habido ningún ganador japonés.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"'Platine Épaulard', solo un lugar. Hace seis años hubo un ganador japonés.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"El ganador del premio mayor, el 'Platine Épaulard', fue Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Cada uno de los premios se distingue por las universidades, fundaciones y\nempresas que lo patrocinan, por lo que no hay un premio mayor como tal.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"En particular para el 'Platine Épaulard', 'Or Baleine' y 'Argent Daufin', los\ncuales tienen casi la misma relevancia.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Se dice que la diferencia está en su división regional. Nueva York, Londres y\nParís.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Originalmente, el premio de la serie de Londres, el 'Argent Daufin', era\nconsiderado como el premio de más autoridad.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"La razón es obvia. Tienen el Royal College of Arts y la Universidad de Artes de\nLondres, junto a sus seis instituciones, de las más prestigiosas en el mundo.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Sin embargo después de los años noventa, el 'Platine Épaulard' de la serie de\nNueva York comenzó a tomar fuerza.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Esto resalta también el hecho de que sea el centro comercial del mundo (por\ncierto, se dice que la razón por la cual Londres, y no París, tiene más\nautoridad, es por su mercado de bolsa)",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Y es que la Fundación Moore construyó muy bien la noción del arte como\ninversión.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"En Estados Unidos el arte ya era visto como una forma de inversión, pero esa\nnoción se transformó fuertemente con la intervención por parte de los grandes\nbancos de negocios.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Y esta transformación se aceleró aún más tras la integración de la ingeniería\nfinanciera.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"La Exposición Moore es y ha sido una exposición de impacto internacional, pero\nno se basa solamente en valores artísticos.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Se podría decir que es su gran efecto económico y político lo que ha\ngarantizado, antes y ahora, la fuerte presencia del arte.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"El premio de Kenichiro fue un gran logro para Japón. Pero el premio no llegó a\nsus manos solo por su valor artístico.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Dicen que fue también una estrategia para integrar a Tokio, megalópolis\ninternacional número uno en PIB per cápita y en población, al mercado\nartístico.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Sin embargo, el arte de Japón no logró integrarse a esa corriente, y dejó ir el\ntriplete de 'Airain Phoque', 'Airain Otarie' y el 'Platine Épaulard' en\nShanghai, China.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Algunos señalaron que el arte japonés se aisló internacionalmente, basándose en\nque no hubieron más galardonados.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Hoy en día, el arte es solo un engranaje más de la economía mundial.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Y por ende, muchas pretensiones se cruzan allí.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"La gran potencia oriental que menos ha podido leer esas pretensiones... Esa es\nla imagen que tiene el mundo artístico respecto a Japón.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004004",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ahora que lo recuerdo, la Exposición Moore solo realiza ceremonias en el país\ncorrespondiente para el Airain Loutre, el Airain Phoque y el Airain Otarie,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, y además solo lo hacen cuando hay galardonados pertenecientes a ese país.\nHace tres años los hubo acá, y salió en la televisión.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004005",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Las ceremonias para los otros tres premios se realizan en Nueva York, Lóndres y\nParís, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, obviamente. Cada uno de esos países tiene su cuota de autoridad...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004006",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Increíble, definitivamente es una exposición internacional. Mientras más\nescucho de ellos, más pienso eso.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No en vano son los premios artísticos de mayor impacto en el planeta.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004007",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Premios que Mako-chan está intentando alcanzar.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Aunque ciertamente inalcanzables para ella, lamentablemente...",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004008",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por cierto, parece que Mako-chan aplicará para cerámica.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Alfarería?... ¿Es que acaso piensa aplicar a la escuela de artesanía de\nGeidai?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004009",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, le pregunté y me dijo que no iría a una universidad de artes.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh, ¿tanto esfuerzo puesto en esta época en arte y no piensa aplicar a una\nuniversidad de artes?... Jejeje, sus buenas calificaciones se irán al piso,\nseguramente.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004010",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, al contrario. Su puntuación estándar superó los 70 puntos en el modelo de\nexamen que hizo hace dos domingos en su instituto preparatorio.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"¡¿K H É É É?!",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_004011",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y en el modelo hecho en el colegio obtuvo más de 80. Todavía tiene mejores\ncalificaciones que tú, Nao-kun.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"P-Por cosas como esa es que las odio. ¿Es que realmente son de este planeta?",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"¿Setenta? ¿Ochenta? Solo he visto esos números en ancianos con esas edades...\nEs otro mundo para mí.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que ustedes tienen algún superpoder que les permite obtener excelentes\ncalificaciones o qué diablos?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_rnd_004012",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Claro que no. Solo que hemos estudiado con constancia desde pequeñas.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Todos aquellos con buenas calificaciones dicen eso, siempre. Por eso los odio\ntambién.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"A final de cuentas, hoy también decidí pegarme al escritorio y estudiar.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="nightsky_spring",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm010"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Al ver el reloj, me di cuenta que ya había pasado de la una.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que me iré a dormir ya.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Por más esfuerzo que intente poner, necesito al menos cinco horas de sueño.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Menos que eso y mi eficiencia podría verse lastimada.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Santo cielo, la última vez que dediqué tanto tiempo a algo fue de niño, cuando\ntodavía pintaba...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, esto está mejor que eso...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"En esa época solía dedicar absolutamente todo mi tiempo a pintar. Día tras día,\ndiseñar, diseñar, diseñar.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Aquellos que me vieron pensarían que era un niño prodigio. Pero ninguna persona\nnormal dedica tanto tiempo a pintar con esa edad.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Y además, bajo la educación del viejo. Obviamente pintaba cosas que un niño\nnormal jamás podría pintar.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora que lo recuerdo, el muchacho que me encontré hoy en la biblioteca dijo\nalgo al respecto...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tipos como tú se crían de manera distinta a los demás, eh...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Si bien lo negué en ese momento, en lo que al arte concierne es completamente\ncierto.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Tuve una infancia nada normal.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Giro a ver el patio.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todavía esta encendida la luz del taller...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"¿Todavía? Llevo un buen tiempo sin ver esa luz apagada de noche.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí que se está esforzando Kei...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Fui a la cocina por algo de beber.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"se",file="se9002",id=1},
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",y=-540,x=-960,zone="0x000000",file="zbg003d",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,time=500,id=1},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0701",face="a0001",head="kei_z2a",lv=5,id=9},
{"fgact",ch="圭",act="いいえ",loop=-1,time=500,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001154",ch="ked"},
},
ja={
{
name={"???"},
"“Ohm... gwah... ahm, ahm...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"En el rincón de la cocina había una desagradable sombra negra retorciéndose.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Quién está ahí?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Enciendo la luz.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004d",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",id=1,file="se2580"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_001155",ch="ked"},
},
ja={
{
name={"???"},
"“¡¿Gwahm?!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"La sombra me ve.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¡Ah! ¡¿Kei?!”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"bgm",file="bgm108"},
{"fg",ch="圭",size="z1",my=40,mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0701",face="a0017",head="kei_z1a",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0002",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001156",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ohhh, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Y estaba allí Kei.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“K-Kei, tú... ¿Tanto te ha crecido el cabello?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0015",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001157",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Me ha crecido el cabello? Ah, ahora que lo mencionas, sí, tal vez.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Y apestas además! ¡¿Te has estado bañando?!”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001158",ch="ked"},
},
ja={
{
name={"Kei"},
"“Claro.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuándo?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0009",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001159",ch="ked"},
},
ja={
{
name={"Kei"},
"“Hace tres días, creo...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tres días sin bañarse no bastan para oler así.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0015",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001160",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿No?... Pero me he bañado tres veces antes de dormir...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tres veces?... Espera, ¿cuándo fue la última vez que dormiste?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0016",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001161",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Cuándo habrá sido? No lo sé, no recuerdo...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“M-Muchacho...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"El tiempo de práctica de alguien que busca dominar un campo especializado es\nanormal.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Muy pocos podrían invertir diez horas todos los días, por varios meses,\npracticando una sola cosa.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Pero para pintores y músicos, para aquellos que realmente buscan perfeccionar\nsu técnica, es algo normal.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Tres horas de sueño y quizá media hora en comidas. Lo demás va para practicar.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Eso es lo que debe aguantar un especialista de cualquier campo.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Aunque lo de Kei es algo que está en un nivel totalmente distinto.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Llevo días sin verte en el colegio...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0010",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001162",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí he ido, lo suficiente para poder graduarme.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En serio? No te veo en estado de poder hacer cuentas ahora, con ese aspecto.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0015",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001163",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Te parece?...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dime algo, ¿qué tanto estás durmiendo últimamente?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0016",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0002",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001164",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué tanto duermo? No lo sé... me despierto y ya. Pero procuro dormir en\nclases.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuándo es la última vez que regresaste a tu habitación?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0015",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0004",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001165",ch="ked"},
},
ja={
{
name={"Kei"},
"“Vamos, Naoya, ¿qué importa eso?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dime la verdad, no has tenido tiempo de acostarte y dormir como debe ser,\n¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0018",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0017",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001166",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ehhh, pues, tal vez. Pero tú también has pasado por lo mismo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo digo justamente por haber experimentado lo mismo. Estás trabajando por\nencima de tu límite.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0001",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001167",ch="ked"},
},
ja={
{
name={"Kei"},
"“Claro que no. Si sobrepasara mi límite, ya me hubiese desmayado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad piensas que crearás algo bueno con ese régimen de trabajo? Dormir\nbien es esencial para la creatividad.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0002",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001168",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Quién puede asegurar eso? A mí sí me parece que esto funciona.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001169",ch="ked"},
},
ja={
{
name={"Kei"},
"“Con una siesta de 15 minutos siento que el sueño se va. Te ha pasado también,\n¿verdad, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sé a lo que te refieres. Pero no haciéndolo por más de un mes.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0018",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001170",ch="ked"},
},
ja={
{
name={"Kei"},
"“No llevo tanto tiempo haciéndolo...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya han pasado más de dos meses desde que terminaron las vacaciones de verano...\nEstás muy mal si has venido siguiendo ese ritmo de vida desde entonces.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0010",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001171",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Sí?... Bueh, sí, tienes razón. Además, quedan solo 183 horas para la fecha\nlímite de presentación...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no estoy hablando de la fecha límite de la exposición--”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0015",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001172",ch="ked"},
},
ja={
{
name={"Kei"},
"“No hay problema. Estaré bien.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"bgm",stop=1,time=300},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0701",face="a0015",head="kei_z2a",lv=5,id=9},
{"se",file="se3130",id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Bien de qué?!”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0701",face="a0016",head="kei_z2a",lv=5,id=9},
{"bgm",file="bgm022"},
{"text"},
text={
vo={
{"vo",file="man_ked_001173",ch="ked"},
},
ja={
{
name={"Kei"},
"“Yo solo sé pintar, no tiene nada de malo que invierta todo mi tiempo en eso.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Esa no es la cuestión--!”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="man_ked_001174",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, lo es. Conozco muy bien la inmensidad de tu genialidad, ¿sabes?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿D-De qué me estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0701",face="a0010",head="kei_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001175",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Acaso no entiendes?... Si no corro con todas mis fuerzas, no podré alcanzarte.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Con todas tus fuerzas?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fgact",ch="圭",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0701",face="a0015",head="kei_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001176",ch="ked"},
},
ja={
{
name={"Kei"},
"“Así es. Sí hago lo mismo de siempre, no te alcanzaré. Si no corro con toda mi\nalma, jamás podré llegar a donde estás.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Pero qué estás diciendo? ¿Que no me vas a alcanzar? P-Pero si yo estoy--”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estancado...”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0701",face="a0003",head="kei_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="うんうん",lv=5,id=9},
},
vl02={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0701",face="a0019",head="kei_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001177",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ajaja. Debería darte pena mentir de esa forma... Naoya...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0701",face="a0001",head="kei_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001178",ch="ked"},
},
ja={
{
name={"Kei"},
"“Soy un idiota, sí. Pero tengo muy buen ojo para la pintura.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Kei dirige la mirada a la ventana.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Había una tenue luz blanca entrando por ella.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"¿Será que hoy se puede ver la luna?",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0701",face="a0015",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001179",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sé muy bien... lo que significa esa obra...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0002",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001180",ch="ked"},
},
ja={
{
name={"Kei"},
"“Tu padre debe haberse contentado mucho cuando la vio, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿D-De qué estás hablando?...”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="man_ked_001181",ch="ked"},
},
ja={
{
name={"Kei"},
"“Es divertido ver cuadros, ¿verdad? A pesar de ser solo dibujos, te comunican\nmuchas cosas...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0010",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001182",ch="ked"},
},
ja={
{
name={"Kei"},
"“Si bien no tuve nada que ver con esos cuadros, todos tus sentimientos al\npintarlos, y los sentimientos de Kenichiro-san al verlos...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0002",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001183",ch="ked"},
},
ja={
{
name={"Kei"},
"“Todo eso, pude captarlo...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0010",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001184",ch="ked"},
},
ja={
{
name={"Kei"},
"“No sabes lo frustrado que me sentí. 'Maldita sea, conque así se conectan dos\ngenios', pensé.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="man_ked_001185",ch="ked"},
},
ja={
{
name={"Kei"},
"“No necesitan palabras, tienen algo por encima de eso para comunicarse.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dos genios, conectándose? ¿Qué diablos estás diciendo?...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0001",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001186",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Que qué digo?... No me mientas. Naoya Kusanagi dejó a Kenichiro Kusanagi\nboquiabierto al mostrarle esos cuadros, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"No puedo seguir ocultándolo.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"Está hablando justamente de esa obra.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te refieres a los seis cuadros del Sakura Nanasouzu?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0015",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001187",ch="ked"},
},
ja={
{
name={"Kei"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues estás muy confundido entonces. Esos cuadros no se hicieron con la técnica\ndebida. ¡Son solo falsificaciones, producidas de una manera muy artificial!”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001188",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Falsificaciones?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, solo son imitaciones.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0003",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0014",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001189",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Imitaciones? ¿Tan idiota eres, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿P-Por qué idiota? Es la verdad.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0005",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001190",ch="ked"},
},
ja={
{
name={"Kei"},
"“No puede ser imitación una obra capaz de tocar mi corazón.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0010",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001191",ch="ked"},
},
ja={
{
name={"Kei"},
"“Una imitación no podría conmover de esta forma a mi corazón...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0005",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001192",ch="ked"},
},
ja={
{
name={"Kei"},
"“Esos cuadros son obras auténticas. Digan lo que digan los demás, es una obra\nauténtica.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="man_ked_001193",ch="ked"},
},
ja={
{
name={"Kei"},
"“Kenichiro Kusanagi pensó lo mismo, seguramente.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0002",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001194",ch="ked"},
},
ja={
{
name={"Kei"},
"“Esa es una obra auténtica, por parte de Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0010",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001195",ch="ked"},
},
ja={
{
name={"Kei"},
"“La obra que Naoya Kusanagi le otorgó a Kenichiro Kusanagi, de pintor a pintor.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0001",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001196",ch="ked"},
},
ja={
{
name={"Kei"},
"“Una gran, impactante obra.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“K-Kei, no es eso...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
"Efectivamente, Kenichiro dijo que los cuadros eran dignos para su despedida.\nEsas palabras me salvaron.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"Pero la verdad es que solo son falsificaciones.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"Simples imitaciones de Kenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="man_ked_001197",ch="ked"},
},
ja={
{
name={"Kei"},
"“Y ahora, es mi turno de ir adelante.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tú?”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001198",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, así es. Es mi turno de crear una obra capaz de hacerte correr de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0014",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001199",ch="ked"},
},
ja={
{
name={"Kei"},
"“Una obra que te haga querer correr y correr, hacia adelante, hacia adelante,\ncomo nunca. La crearé.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que hagas eso... tú ya estás a kilómetros por delante de mí...”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0001",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0003",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001200",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué tonterías dices? Tú estás muy por delante de mí. Eres un genio.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, yo no soy ningún genio... No soy la clase de persona que crees...”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0002",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001201",ch="ked"},
},
ja={
{
name={"Kei"},
"“Tengo que avanzar tanto como pueda, así me cueste la vida, o no podré llegar a\ndonde tú estás.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Claro que no! ¡¿Qué tanto me estás sobreestimando?!”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0005",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001202",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Sobrestimar? Es imposible no pensar eso teniéndote siempre delante de mí. Aquí\ndonde estoy puedo ver lo grande que eres.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0004",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001203",ch="ked"},
},
ja={
{
name={"Kei"},
"“Así que exprimiré hasta la última gota de mi fuerza para ir mucho más allá de\nmi límite...”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"“K-Kei...”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Eso no es así.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"Nada de lo que dice es cierto.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"¿Por qué Kei piensa eso?",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"¿Yo, un genio?",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"Un genio no tendría que recurrir a esos métodos para producir una obra.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
"Lo único que hice fue imitar a alguien.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"¿Qué otro nombre hay para eso que no sea imitación?",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
"Yo no llego ni siquiera a tus pies.",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
"Y aun así...",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"A pesar de eso...",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0004",head="kei_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Quiere decir que... estás pintando algo para mí?”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0005",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001204",ch="ked"},
},
ja={
{
name={"Kei"},
"“Así es. Nada más ni nada menos que eso.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues vas a perder tu tiempo.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001205",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. No soy la clase de persona que me crees ser, y aun si llegas a producir\nuna obra impresionante, solo podré verla con admiración como un espectador\nmás...”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001206",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Sí? ¿Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto. Yo me conozco mejor que nadie...”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0002",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001207",ch="ked"},
},
ja={
{
name={"Kei"},
"“Yo también conozco mucho de ti, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y qué sabes tú de mí?”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0001",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001208",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sé que no te gusta perder.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qu--”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
vo={
{"vo",file="man_ked_001209",ch="ked"},
},
ja={
{
name={"Kei"},
"“Nunca te ha gustado quedar como el perdedor.”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
vo={
{"vo",file="man_ked_001210",ch="ked"},
},
ja={
{
name={"Kei"},
"“Por más tiempo que cueste, por más vueltas que des, jamás te has dejado quedar\ncomo el perdedor.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0014",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001211",ch="ked"},
},
ja={
{
name={"Kei"},
"“Siempre terminas alcanzando, y rebasando a los demás.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“---”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡P-Pues haz lo que te dé la gana! ¡No vengas llorando después cuando te\nenfermes y no puedas terminar tu obra!”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0701",face="a0003",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001212",ch="ked"},
},
ja={
{
name={"Kei"},
"“Está bien, no hay problema. No me importa lo que pase conmigo mientras pueda\nterminarla.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh...”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"se",file="se9002",id=1},
{"bg",time=500,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Salgo de la cocina.",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Siento mi sangre hirviendo.",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"Mis puños, calientes...",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"No cabe duda alguna. Mi cuerpo estaba respondiendo ante la manera de actuar de\nKei.",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Maldita sea, maldita sea!”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
"Yo me conozco mucho mejor que nadie.",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
"Y conozco mejor que nadie, lo vacío que estoy ahora...",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="05_the_happy_prince_03_1"},
{"text"},
linkback="block_00291",
},
label = {
top={block="block_00000",label=1},
},
}
