astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bgm",file="bgm038"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=200,zone="0x000000",file="zbg081g",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2i0000",face="i0001",head="rna_z2i",lv=5,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_rna_001340",ch="rna"},
},
ja={
{
name={"???"},
"“¿Kawachino... san?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_yum_001190",ch="yum"},
},
ja={
{
"Era una voz muy cálida.\nUna voz muy hermosa, que nada tenía que ver con este sombrío lugar.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_yum_001191",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿H-Hikawa-san?...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fgact",ch="里奈",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_001341",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg081g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000,sync=1},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1i0000",face="i0001",head="rna_z1i",x=-345,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1i0000",face="i0008",head="yum_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001192",ch="yum"},
},
ja={
{
"Hikawa-san respondió de una manera bastante llana, casi de la misma forma que\nlo hace cuando alguien la llama en el salón.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0011",head="yum_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001193",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Esto... ¿Q-Qué, estás haciendo?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="fem_yum_001194",ch="yum"},
},
ja={
{
"Suelto esa tonta pregunta, con una voz embobada.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0005",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001342",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué pareciera estar haciendo?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_yum_001195",ch="yum"},
},
ja={
{
"De inmediato mis ojos captan el blanco y brillante objeto que ella tenía en su\nmano.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0009",head="yum_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001196",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué... es eso?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0001",head="rna_z1i",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001343",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tiza.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0012",head="yum_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001197",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Tiza?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_yum_001198",ch="yum"},
},
ja={
{
"El objeto que Hikawa-san tenía no era algo brillando en blanco. Era un simple\ntrozo de tiza blanca.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_yum_001199",ch="yum"},
},
ja={
{
"Confundí esa blanca tiza con la hoja de algún objeto filoso, aun a pesar de que\nni siquiera brillaba.\nY pensar que por dentro me estaba muriendo de miedo por esa cosa...",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0008",head="yum_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001200",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y? ¿Qué haces con esa tiza?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0002",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001344",ch="rna"},
},
ja={
{
name={"Rina"},
"“Estoy dibujando.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0012",head="yum_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001201",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Dibujando? ¿A estas horas?",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0010",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0001",head="rna_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001345",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues lo mismo podría decir de ti, Kawachino-san.\n¿Eres realmente una delincuente como todos dicen?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001202",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y qué si lo soy?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0015",head="rna_z1i",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",size=5,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001346",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nada, la verdad. No me interesa en lo absoluto.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="里奈",mode=-1,lv=4,id=5},
{"se",file="se9004",vol=50,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_001203",ch="yum"},
},
ja={
{
"Hikawa-san perdió todo interés por mí y volvió a meterse al domo, sin decir más\nnada.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"se",stop=1,time=500,id=1},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0018",head="yum_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001204",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Que no te interesa?... Si realmente soy una delincuente entonces las cosas\npodrían ponerse feas para ti, estando acá a solas conmigo.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"se",file="se9010",vol=50,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=200,file="zbg081g",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2i0000",face="i0001",head="rna_z2i",lv=5,id=5,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_yum_001205",ch="yum"},
},
ja={
{
"Hikawa-san sacó su cabeza del domo.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0008",head="rna_z2i",lv=5,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="里奈",act="びっくり",loop=2,time=300,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001347",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Y qué harás, cortarme el cuello? Así, 'ue, ueh'...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_yum_001206",ch="yum"},
},
ja={
{
"Puso su dedo pulgar sobre su cuello, moviéndolo hacia un lado. Hizo como si\nalguien le hubiera cortado el cuello, imitando incluso el sonido.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_yum_001207",ch="yum"},
},
ja={
{
"'Incluso la voz que hace junto a esos gestos es linda'. Aun no teniendo nada\nque ver con la conversación, no pude evitar pensar en eso.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0009",head="rna_z2i",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0001",head="rna_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001348",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué haces merodeando el parque de noche y con un cuchillo, Kawachino-san? ¿Es\nque acaso no te bastó con desnudar a una estudiante de último año y planeas\nmatar a alguien ahora?...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_yum_001208",ch="yum"},
},
ja={
{
"El cuchillo que hasta hace un momento reposaba dentro de mi bolsillo estaba\nahora en mi mano.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_yum_001209",ch="yum"},
},
ja={
{
"Hikawa-san miró eso y preguntó con indiferencia: '¿Acaso planeas matar a\nalguien?'",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_yum_001210",ch="yum"},
},
ja={
{
"El hecho de que parecía ser la única que había pasado miedo hasta ahora me hizo\nhervir un poco la sangre.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_yum_001211",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, tal vez...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_yum_001212",ch="yum"},
},
ja={
{
"No mostraba ni un solo indicio de perder la compostura, así que decidí seguirle\nla corriente e intentar asustarla un poco.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0008",head="rna_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001349",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿A mí?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_001213",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0012",head="rna_z2i",lv=5,id=5},
{"fgact",ch="里奈",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001350",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Vaya, acerté? Estabas algo enfadada hoy, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_yum_001214",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No estaba enfadada, y además nadie mataría a alguien solo por eso.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0016",head="rna_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001351",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Sí?... Así que no lo estabas... Mmm.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"se",file="se9004",vol=50,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg081g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0008",head="yum_z1i",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_yum_001215",ch="yum"},
},
ja={
{
"Todavía sin mucho interés, esta regresó de nuevo al domo.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_001216",ch="yum"},
},
ja={
{
"Sus gestos eran hermosos, y su voz era tan tierna como siempre.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_yum_001217",ch="yum"},
},
ja={
{
"Y a pesar de eso, sentí algo distinto en ella a la Hikawa-san de la tarde.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001218",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me sorprendes. Pensé que eras más delicada y refinada.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_rna_001352",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo soy.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0018",head="yum_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001219",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Alguien realmente delicado y elegante no se pondría el dedo al cuello diciendo\n'ue, ueh'.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_yum_001220",ch="yum"},
},
ja={
{
"Hikawa-san me observa con algo que parecía sorpresa en sus ojos.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_yum_001221",ch="yum"},
},
ja={
{
"Me pongo en guardia, pensando que haría algo.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"se",file="se9010",vol=50,id=1},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1i0000",face="i0004",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001353",ch="rna"},
},
ja={
{
name={"Rina"},
"“... Tu voz cuando dijiste 'ue, ueh' sonó tierna, Kawachino-san.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001222",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0002",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001354",ch="rna"},
},
ja={
{
name={"Rina"},
"“A pesar de siempre hablar como un hombre tienes una voz muy tierna en estos\nmomentos. Realmente eres rara.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0018",head="yum_z1i",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001223",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“S-Solo estaba imitando tu voz.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0012",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0016",head="rna_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001355",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Mi voz? Hum, ya veo... ¿Así de tierna es mi voz?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001224",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“P-Pues, a mi parecer sí...\nY además, eres bonita también.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0001",head="rna_z1i",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001356",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hum.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_yum_001225",ch="yum"},
},
ja={
{
"Hikawa-san me responde sin mostrar interés alguno.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0009",head="yum_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001226",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Por eso es que eres tan popular con todos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0001",head="rna_z1i",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="おじぎ",size=5,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001357",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De verdad lo soy? Me parece que hay algunos por ahí que no me quieren tanto.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_yum_001227",ch="yum"},
},
ja={
{
"Hikawa-san me observa fijamente.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0011",head="yum_z1i",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001228",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Eso no es...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0002",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001358",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vaya que eres linda, Kawachino-san.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001229",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Qu--?!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0002",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001359",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Te molestó eso?”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0018",head="yum_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001230",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“N-No estoy molesta, pero ¿por qué dices esas cosas tan desagradables?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0010",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0016",head="rna_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001360",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Desagradable?... Entonces no lo diré más.\nNo volveré a decir que eres linda.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="里奈",mode=-1,lv=4,id=5},
{"se",file="se9004",vol=50,id=1},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001231",ch="yum"},
},
ja={
{
"Hikawa-san sacó un poco su lengua y volvió de nuevo al domo.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"se",stop=1,time=500,id=1},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x2=345,x=0,lv=4,id=6},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001232",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿D-De verdad eres Hikawa-san?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_rna_001361",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No lo soy?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0010",head="yum_z1i",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001233",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Soy yo la que está preguntando eso...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_rna_001362",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Soy distinta a la Hikawa que ves siempre en el salón.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0008",head="yum_z1i",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001234",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Muy distinta. Por lo general nunca eres así de fría, ¿o no?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_rna_001363",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, creo que nadie trataría con amabilidad a alguien que responde a una\nsonrisa pateando la mesa...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0011",head="yum_z1i",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001235",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En pocas palabras, es porque me odias...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_rna_001364",ch="rna"},
},
ja={
{
name={"Rina"},
"“Te equivocas, Kawachino-san. No te odio.\nAunque tampoco podría decir que me gustas demasiado.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0009",head="yum_z1i",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001236",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_rna_001365",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque te aprecio como compañera de clases. Tanto como a los demás.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0012",head="yum_z1i",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001237",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Los aprecias a todos tanto como a mí? ¿Te la pasas conversando de manera tan\namena con todos y aun así eres capaz de decir eso?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_rna_001366",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Y por eso estoy conversando ahora contigo de la misma forma que lo hago con\nlos demás compañeros de salón.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0008",head="yum_z1i",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001238",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No me mientas, eres más amable con los otros.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_rna_001367",ch="rna"},
},
ja={
{
name={"Rina"},
"“Si lo soy es porque los demás parecen preferir un trato más cordial, pero...\nese no es tu caso, ¿no, Kawachino-san?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0013",head="yum_z1i",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001239",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿P-Por qué piensas eso?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_rna_001368",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pues, porque pateaste aquella mesa, en primer lugar...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0011",head="yum_z1i",x=0,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001240",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Eso no...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_rna_001369",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fuiste muy cruel. Y pensar que yo solo intentaba hacerte un gesto amistoso...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0012",head="yum_z1i",x=0,lv=4,id=6},
{"fgact",ch="優美",act="いいえ",size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001241",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡N-No es por eso, e-es que me sonreíste de pronto, y yo--!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_rna_001370",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mis habilidades sociales son pésimas, así que de vez en cuando cometo locuras\nasí.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0011",head="yum_z1i",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001242",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Las mías también lo son...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_rna_001371",ch="rna"},
},
ja={
{
name={"Rina"},
"“Parece que tenemos algo en común entonces. Seamos amigas.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0009",head="yum_z1i",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001243",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, eh, s-sí...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",mode=-2},
{"text"},
text={
vo={
{"vo",file="fem_yum_001244",ch="yum"},
},
ja={
{
"Hikawa-san me sonrió amablemente.\nCon una sonrisa hermosa, pero algo ensombrecida.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_yum_001245",ch="yum"},
},
ja={
{
"Esta vez sí le devolví la sonrisa. Algo torpe y brusca fue, pero lo hice.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_yum_001246",ch="yum"},
},
ja={
{
"Las conversaciones no se me suelen dar bien.\nNo puedo mantenerlas por mucho tiempo.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_yum_001247",ch="yum"},
},
ja={
{
"La razón por la cual solo tengo chicos entre mis amigos es porque nunca\nnecesito hablar de más con ellos.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="fem_yum_001248",ch="yum"},
},
ja={
{
"No necesito decir nada estando entre todos ellos.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_yum_001249",ch="yum"},
},
ja={
{
"Solo me basta con usar la violencia una que otra vez.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_yum_001250",ch="yum"},
},
ja={
{
"Y por eso es que nunca llegué a sostener algo que se pudiera considerar como\nuna conversación normal.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_yum_001251",ch="yum"},
},
ja={
{
"Sin embargo, estoy ahora conversando como si nada con Hikawa-san.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_yum_001252",ch="yum"},
},
ja={
{
"Con una Hikawa-san distinta a la del salón.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_yum_001253",ch="yum"},
},
ja={
{
"Seguramente está intentado comportarse de manera que me sienta a gusto.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_yum_001254",ch="yum"},
},
ja={
{
"Es por eso que aun estando en el parque a medianoche pude entablar una\nconversación con ella a solas.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_yum_001255",ch="yum"},
},
ja={
{
"¿Pésimas habilidades sociales? Eso es mentira.\nEs raro ver a niñas tan hábiles para tratar con los demás como ella.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_yum_001256",ch="yum"},
},
ja={
{
"Transmite esa peculiar sensación de seguridad que dan esas personas capaces de\nhablar con habilidad. El silencio no la perturba, y más bien lo maneja al\nritmo de la conversación.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_yum_001257",ch="yum"},
},
ja={
{
"Puedo entender muy bien ahora su popularidad en el salón.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_yum_001258",ch="yum"},
},
ja={
{
"Pero, a medida que su charla se vuelve más mañosa, y a medida que la\nconversación con ella se vuelve más entretenida,",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_yum_001259",ch="yum"},
},
ja={
{
"siento aún más que solo es una hermosa autómata, vacía por dentro.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_yum_001260",ch="yum"},
},
ja={
{
"Y ahora, la idea de que esa bella autómata simplemente está adaptándose para\nresponderme siempre de la manera más óptima sentó raíz en mi cabeza.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=200,file="zbg081g",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="里奈",size="z2",mode=3,resize=1,path=":fg/rna/z2/",file="rna_z2i0000",face="i0001",head="rna_z2i",lv=5,id=5,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_yum_001261",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y bien, ¿qué estás haciendo dentro del domo?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0002",head="rna_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001372",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya te lo dije, estoy dibujando.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_yum_001262",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué estás dibujando dentro del domo?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0008",head="rna_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001373",ch="rna"},
},
ja={
{
name={"Rina"},
"“Parece que lo van a demoler. O más bien, debería decir todo el parque.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0010",head="rna_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001374",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es inevitable, supongo, si notas todo el tiempo que lleva sin recibir\nmantenimiento. Por culpa de este bosque tan frondoso de cipreses nadie sabe\nque hay juegos aquí...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0002",head="rna_z2i",lv=5,id=5},
{"fgact",ch="里奈",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001375",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y por eso estoy haciendo travesuras acá.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_yum_001263",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Travesuras, eh...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_yum_001264",ch="yum"},
},
ja={
{
"La observo a través de uno de los huecos del domo.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_yum_001265",ch="yum"},
},
ja={
{
"La mirada en sus ojos al dibujar portaba demasiada seriedad como para tratarse\nde una simple travesura.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_yum_001266",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué estás dibujando?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0012",head="rna_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001376",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Te interesa saber?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_yum_001267",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues, sí...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0002",head="rna_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001377",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me imagino que sí. Teniendo la imagen que tienes de mí probablemente te parezca\nraro que esté acá a esta hora.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_yum_001268",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, la verdad. Pero ¿por qué estás acá?\n¿Te sucedió algo malo?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0010",head="rna_z2i",lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0001",head="rna_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001378",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Algo malo?...\nSí, bueno, en la vida siempre ocurren cosas malas, es inevitable...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_yum_001269",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Siempre que te ocurre algo sales a estas horas de la noche?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0012",head="rna_z2i",lv=5,id=5},
{"fgact",ch="里奈",act="びっくり",size=5,lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0017",head="rna_z2i",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001379",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no, realmente no sucedió nada hoy en particular. Fue un día divertido.\nAunque alguien por ahí pateó una mesa frente a mí.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_yum_001270",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Q-Qué acaso estás resentida por eso?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0005",head="rna_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001380",ch="rna"},
},
ja={
{
name={"Rina"},
"“Te lo dije ya, tuve un buen día. Si estuviera resentida por eso entonces\nhubiera sido un mal día, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_yum_001271",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, supongo... Pero, entonces...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0002",head="rna_z2i",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001381",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mira esto.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"se",file="se9028",id=1},
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001272",ch="yum"},
},
ja={
{
"Al decir eso, Hikawa-san me invitó a entrar al domo.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_001273",ch="yum"},
},
ja={
{
"El tamaño del domo daba abasto para cinco niños apretujados, pero siendo solo\ndos había bastante espacio.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_yum_001274",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_yum_001275",ch="yum"},
},
ja={
{
"A pesar de no saber mucho de arte, sentí algo avasallante en el dibujo que\ntenía frente a mí. Tenía ese estilo en sus trazos.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0001",head="rna_z2i",x=-345,lv=5,id=5},
{"fg",ch="優美",size="z2",mode=3,resize=1,path=":fg/yum/z2/",file="yum_z2i0000",face="i0008",head="yum_z2i",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001276",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_rna_001382",ch="rna"},
},
ja={
{
name={"Rina"},
"“Zypressen...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0012",head="yum_z2i",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001277",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Zy, pressen? ¿Qué es eso?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0010",head="rna_z2i",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001383",ch="rna"},
},
ja={
{
name={"Rina"},
"“Cipreses.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0008",head="yum_z2i",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001278",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Cipreses? ¿Por qué andas dibujando eso aquí?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_yum_001279",ch="yum"},
},
ja={
{
"Era un dibujo de un ciprés. Un ciprés dibujado en la pared de un domo que a su\nvez estaba cercado por un bosque de cipreses.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0011",head="rna_z2i",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001384",ch="rna"},
},
ja={
{
name={"Rina"},
"“Por qué esto... y por qué aquí...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0009",head="rna_z2i",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001385",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jeje, ¿por qué será?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_yum_001280",ch="yum"},
},
ja={
{
"Hikawa-san se rió sarcásticamente.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_yum_001281",ch="yum"},
},
ja={
{
"Fue algo nuevo para mí verla así, indecisa ante una pregunta. Jamás lo había\nhecho.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0009",head="yum_z2i",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001282",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Dibujas porque tienes una razón para hacerlo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0011",head="rna_z2i",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001386",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tal vez...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0010",head="yum_z2i",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001283",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... ¿Tal vez, dices?...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0002",head="rna_z2i",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001387",ch="rna"},
},
ja={
{
name={"Rina"},
"“No sé si es solo impresión mía, pero siento que tu forma de hablar está más\nserena que hace un momento, Kawachino-san.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0013",head="yum_z2i",x=345,lv=5,id=6},
{"fgact",ch="優美",act="びっくり",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001284",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? ¿S-Sí?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0001",head="rna_z2i",x=-345,lv=5,id=5},
{"fgact",ch="里奈",act="うなづく",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001388",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. La verdad es que me gustas más así...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0018",head="yum_z2i",x=345,lv=5,id=6},
{"fgact",ch="優美",act="いいえ",size=5,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001285",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“M-Mi manera de hablar solo me concierne a mí.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0008",head="rna_z2i",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001389",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Te enojaste?\n¿Te hice molestar de nuevo?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0011",head="yum_z2i",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001286",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, no es eso.\nA-A mí también me alegra que me elogien...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0016",head="rna_z2i",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001390",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Pero no dijiste hace un momento que odiabas que te dieran cumplidos?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0005",head="yum_z2i",x=345,lv=5,id=6},
{"fgact",ch="優美",act="いいえ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001287",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No dije eso. Solo que sentí que me estabas tomando el pelo...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0008",head="rna_z2i",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001391",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué pensaste eso?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0005",head="yum_z2i",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001288",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Porque soy una salvaje...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0012",head="rna_z2i",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001392",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por eso? A mí me parece que eres linda.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0011",head="yum_z2i",x=345,lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0005",head="yum_z2i",x=345,lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_001289",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“E-Eso... no es cierto.\nY-Y bien, ¿vas a decirme por qué es que estás dibujando acá?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0008",head="rna_z2i",x=-345,lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0011",head="rna_z2i",x=-345,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_001393",ch="rna"},
},
ja={
{
name={"Rina"},
"“Razón no hay. Solo que...”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0010",head="rna_z2i",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001394",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tengo miedo...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_yum_001290",ch="yum"},
},
ja={
{
"Me pareció sentir algo de pesadumbre en la expresión de Hikawa-san.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_yum_001291",ch="yum"},
},
ja={
{
"En ese momento, esa misma expresión se me hizo hermosa.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_yum_001292",ch="yum"},
},
ja={
{
"A pesar de que claramente estaba afligida por algo, no pude evitar quedarme\natontada con su apesadumbrada, pero hermosa expresión.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0008",head="yum_z2i",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001293",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Tienes algún problema?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0011",head="rna_z2i",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001395",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Problema?...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0009",head="yum_z2i",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001294",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es que, te veo dibujando acá y de noche en este parque abandonado, dentro de un\ndomo... y además, dibujando cipreses... Es tétrico, sinceramente. Encima de\neso, acabas de decir que tenías miedo.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0010",head="rna_z2i",x=-345,lv=5,id=5},
{"fgact",ch="里奈",act="おじぎ",size=5,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001396",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0008",head="rna_z2i",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001397",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kawachino-san, ¿qué se te viene a la mente cuando te hablan de cipreses?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0010",head="yum_z2i",x=345,lv=5,id=6},
{"fgact",ch="優美",act="いいえ",size=5,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001295",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues, nada en particular, creo...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0011",head="rna_z2i",x=-345,lv=5,id=5},
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0001",head="yum_z2i",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_001398",ch="rna"},
},
ja={
{
name={"Rina"},
"“El artista posimpresionista Vincent Van Gogh pintó una gran cantidad de obras\nbasadas en cipreses.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0010",head="rna_z2i",x=-345,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001399",ch="rna"},
},
ja={
{
name={"Rina"},
"“En una de sus cartas llegó a dejar escrito lo siguiente: 'Nunca dejo de\nsentirme fascinado por los cipreses'. Yo creo que ese 'nunca' duró incluso\nhasta el instante de su último aliento...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_yum_001296",ch="yum"},
},
ja={
{
"Hikawa-san hizo como si estuviera hablándome, pero sus palabras parecían\nsimplemente tenues sonidos provenientes de algún lejano y frío lugar.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="優美",size="z2",mode=3,path=":fg/yum/z2/",file="yum_z2i0000",face="i0008",head="yum_z2i",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_001297",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En pocas palabras, cada vez que piensas en cipreses recuerdas las pinturas de\nGogh.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="里奈",size="z2",mode=3,path=":fg/rna/z2/",file="rna_z2i0000",face="i0011",head="rna_z2i",x=-345,lv=5,id=5},
{"fgact",ch="里奈",act="うなづく",size=5,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001400",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, bueno. Creo...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_yum_001298",ch="yum"},
},
ja={
{
"Allí culminó la conversación entre las dos.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"bg",file="ev_txt_c08_01",time=2000,path=":ev/ev_txt_c08/",set="ev_txt_c08"},
{"text"},
text={
ja={
{
"　　　　　　　　　　　　　　　――Modulación Ⅱ――",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"bg",file="ev_txt_c13_01",time=2000,path=":ev/ev_txt_c13/",set="ev_txt_c13"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001299",ch="yum"},
},
ja={
{
"'¿Y?　¿De qué forma la colgaremos?'\nUno de los muchachos de la clase vino a preguntarme eso.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_yum_001300",ch="yum"},
},
ja={
{
"-'¿A quién?'- respondí, haciéndome la tonta.\n-'¿No es obvio?', me contestó con actitud algo rebelde.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_yum_001301",ch="yum"},
},
ja={
{
"Le lanzo una mirada amenazadora.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_yum_001302",ch="yum"},
},
ja={
{
"Siempre se acobardan y se van cuando lo hago, pero hoy no.\nEl muchacho me devolvió una mirada aún más provocadora.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_yum_001303",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué mierda te crees, imbécil?...”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="man_okz_000001",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“No soy imbécil, soy Okazawa. Apréndete de una buena vez los nombres de tus compañeros.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_yum_001304",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Jaa? ¿Compañeros?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_yum_001305",ch="yum"},
},
ja={
{
"Jamás los he considerado compañeros míos.\nPor supuesto, no son tampoco mis esclavos, ni mis subordinados.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_yum_001306",ch="yum"},
},
ja={
{
"Por más que gatos callejeros se junten, manada no es.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_yum_001307",ch="yum"},
},
ja={
{
"Los gatos callejeros no tienen esos rasgos sociables bien formados que poseen los perros.\nSu visión del mundo es una de 'yo, y lo que me rodea'.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_yum_001308",ch="yum"},
},
ja={
{
"Para los gatos, el gato a su lado,\nasí como los humanos que le dan comida, las vallas de metal que bloquean su camino, y la fría nieve que cae del cielo,\nes todo lo mismo. Parte de su ambiente.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
vo={
{"vo",file="fem_yum_001309",ch="yum"},
},
ja={
{
"Nunca me he juntado con ellos.\nSolo están allí, a mi lado.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="man_okz_000002",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“¿Qué vas a hacer, sacar tu cuchillo como la vez pasada?　No creas que me vas a intimidar con eso.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_yum_001310",ch="yum"},
},
ja={
{
"Son solo piezas que componen mi ambiente.\nMeto rápidamente mi mano derecha en el bolsillo, como si fuera a sacar mi cuchillo.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_yum_001311",ch="yum"},
},
ja={
{
"El otro muchacho se puso en guardia. Con mi pie derecho algo doblado, tumbo al\nmuchacho con mi izquierdo.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"se",file="se2766",id=1},
{"quake",mode="mw"},
{"ex",time=1000,func="wait"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001312",ch="yum"},
},
ja={
{
"El cuchillo fue una finta. Con su concentración en mi mano derecha, cayó",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_yum_001313",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Das asco. Muérete.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_okz_000003",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“¡Kawachino!”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="fem_yum_001314",ch="yum"},
},
ja={
{
"Intentó levantarse, pero no tardé en pisotear su pecho.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_yum_001315",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me dan ganas de vomitar solo con escucharte hablar de 'compañeros'. Si eso es\nlo que quieres pues busca en otro lado.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="man_okz_000004",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“¿Pero qué demonios? ¿Crees que vamos a aceptar eso por respuesta, Kawachino?\nTú también te veías ansiosa por hacerlo ayer,\n¿es que acaso te dio miedo ahora?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_yum_001316",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Ahh?　¡En ningún momento he dicho que no lo haré, simplemente no tolero a\nidiotas repulsivos como tú!”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
vo={
{"vo",file="man_okz_000005",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Lo harás entonces, ¿verdad?　¿Ah?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="fem_yum_001317",ch="yum"},
},
ja={
{
"Me fui, sin decir nada más.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_yum_001318",ch="yum"},
},
ja={
{
"El muchacho tumbado me gritó, pero lo ignoré.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="fem_yum_001319",ch="yum"},
},
ja={
{
"¿Qué clase de melodrama juvenil se supone que es este?",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_yum_001320",ch="yum"},
},
ja={
{
"Es por estas cosas que odio juntarme con los hombres.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="fem_yum_001321",ch="yum"},
},
ja={
{
"Me gustan las chicas,\npero eso no significa que pueda entender a los hombres.\nPor eso no los comprendo nada y me altero.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_yum_001322",ch="yum"},
},
ja={
{
"Pero no había ningún grupo de chicas que aceptara a alguien como yo.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
vo={
{"vo",file="fem_yum_001323",ch="yum"},
},
ja={
{
"No quería juntarme con nadie. Quería estar sola.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_yum_001324",ch="yum"},
},
ja={
{
"¿En qué momento los hombres formaron manada a mi alrededor?",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_yum_001325",ch="yum"},
},
ja={
{
"Por supuesto, no es que me gustaba estar en medio de todos ellos.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="fem_yum_001326",ch="yum"},
},
ja={
{
"Solo que mi comportamiento violento\nno me permitía estar junto a las muchachas.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
vo={
{"vo",file="fem_yum_001327",ch="yum"},
},
ja={
{
"La verdad es que, aun como me ven, quería estar con chicas.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="fem_yum_001328",ch="yum"},
},
ja={
{
"Mi cabello es corto.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="fem_yum_001329",ch="yum"},
},
ja={
{
"Pero no porque quiera ser un hombre.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_yum_001330",ch="yum"},
},
ja={
{
"Es porque era indiferente conmigo misma, y con mi aspecto.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="fem_yum_001331",ch="yum"},
},
ja={
{
"Amaba más a las otras hermosas chicas que a mí misma.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="fem_yum_001332",ch="yum"},
},
ja={
{
"Creo que todo se trataba de una especie de proyección.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
vo={
{"vo",file="fem_yum_001333",ch="yum"},
},
ja={
{
"Quiero convertirme en Hikawa-san.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_yum_001334",ch="yum"},
},
ja={
{
"Quiero convertirme en esa llama débil e imperceptiblemente ondeante.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"excall",file="03_zypressen_02_4"},
{"text"},
linkback="block_00211",
},
label = {
top={block="block_00000",label=1},
},
}
