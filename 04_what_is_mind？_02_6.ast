astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo IV"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004d",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"bgm",file="bgm033"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000233",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Aún tiene la cara hinchada...”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="man_kid_000410",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No me puse nada después de que me golpearon...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"bg",file="ev_com_g03_01",path=":ev/ev_com_g03/",set="ev_com_g03"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000234",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Fue demasiado imprudente...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="man_kid_000411",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Después de lo que ha sucedido, no tengo manera alguna de negar eso.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000235",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Aunque estoy agradecida con usted. Me siento satisfecha de poder haberles\nhecho pagar, aunque sea un poco...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="man_kid_000412",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No te quedes satisfecha solo con esto.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="man_kid_000413",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Te salvaré, a como dé lugar.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000236",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Por qué hace usted tanto por mí?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="man_kid_000414",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Ajajaja, ahora que me lo recuerdas, creo que todavía no he confesado lo que\nsiento.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="man_kid_000415",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Aunque la abuela Natsume se me adelantó, sí... esa señora siempre habla de más.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000237",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“La señora Natsume es buena persona...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
vo={
{"vo",file="man_kid_000416",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No lo es. Los Natsume solo actúan por interés.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="man_kid_000417",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y yo también, en ese sentido.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000238",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Por interés?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_kid_000418",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Si no fuera por ese interés, jamás habría dado un paso sobre esta casa.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
vo={
{"vo",file="man_kid_000419",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Y sabes qué pasó cuando comencé a venir? Una vieja novia que tuve me proclamó\nsu enemistad.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000239",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Novia? ¿Su novia?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="man_kid_000420",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vieja, ex, eh. Se cansó de mis locuras, y me dejó. Está casada ahora con otro\nhombre.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000240",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿La profesora Saki Nakamura?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="man_kid_000421",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="man_kid_000422",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Se casó nada más ni nada menos que con el mismísimo Shoichi Nakamura. Vaya\nmierda todo, acabé en un netorare.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000241",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Netorare?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="man_kid_000423",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Olvídalo, cosas mías.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="man_kid_000424",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“En fin, decidí venir, aun teniendo de enemiga a la mujer que una vez amé. ¿De\nverdad crees que un hombre así podría hacer todo esto solo por amistad o\nfilantropía?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="man_kid_000425",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Sabes algo, Mizuna? Desde el primer momento en que nos vimos he estado\nenamorado de ti.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000242",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Eh? ¿Desde el primer momento? ¿Ehhh? Pero mi actitud con usted aquella vez\nfue terrible, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="man_kid_000426",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Una personalidad que rechaza a los demás, y sin embargo tenía mucha cordialidad\nen sí. Apenas te vi supe que algo tenías por detrás.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000243",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Apenas me vio? ¿Lo dice en serio?”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="man_kid_000427",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es, y no deberías subestimar el ojo de un artista. Podemos quedar\nfascinados por las más minuciosas expresiones de las personas...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000244",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“P-Pero, yo...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="man_kid_000428",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Yo, qué?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000245",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Yo no... soy digna de su amor, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="man_kid_000429",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Por qué lo dices?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000246",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“P-Pues, porque... porque ellos, me ultrajaron...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="man_kid_000430",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Ultrajar? ¿Ultrajar qué?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000247",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡Ellos ultrajaron mi cuerpo!”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000248",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Mi cuerpo...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="man_kid_000431",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No matter. Never mind.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="man_kid_000432",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Y qué importa? No te preocupes por eso.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="man_kid_000433",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No tienes por qué atormentarte por eso. Aunque les haremos pagar, eso sí.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000249",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡Pero, pero yo--!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="man_kid_000434",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya entendí, ya entendí. Bien, hagamos esto, siempre que estés conmigo olvídate\nde todo ese pasado. Hazlo por mí.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000250",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Por usted?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="man_kid_000435",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y para ya con el Kusanagi-san, ¿sí? Llámame Kenichiro-san.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000251",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Eh, ah? E-Esto... Kenichiro... san.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="man_kid_000436",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Muy bien, muy bien. Qué muchacha tan tierna.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"bgm",stop=1,time=1000},
{"se",file="se9010",vol=40,id=1},
{"bg",file="ev_com_g03_02",path=":ev/ev_com_g03/",set="ev_com_g03"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000252",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Wa, wawah.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Abrazo a Mizuna.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"bg",file="ev_com_g03_03",sync=0,face=1,time=400,path=":ev/ev_com_g03/",set="ev_com_g03"},
{"bgm",file="bgm107"},
{"text"},
text={
ja={
{
"Al principio se veía algo inquieta, pero poco a poco comenzó a abrazarme a mí\ntambién.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000253",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“... Qué cálido.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="man_kid_000437",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"bg",file="ev_com_g03_04",sync=0,face=1,time=400,path=":ev/ev_com_g03/",set="ev_com_g03"},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000254",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Qué cálido es el cuerpo humano...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="man_kid_000438",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Somos mamíferos, después de todo.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000255",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Qué bien se siente la calidez de alguien más...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="man_kid_000439",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Calor le dicen. ¿Sabes qué suele pasar con ese calor?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000256",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Qué? ¿Comenzamos a anhelarlo?”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="man_kid_000440",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es. El calor de alguien más se siente tan bien que comienzas a anhelarlo.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000257",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Por qué será?... Se supone que esta es la primera vez que lo siento...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="man_kid_000441",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Se te hace nostálgica la sensación?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000258",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Sí. ¿Por qué se siente tan bien, y a la vez tan nostálgico, el calor al abrazar\na alguien más?...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="man_kid_000442",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Porque somos mamíferos, te dije...”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000259",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Porque somos mamíferos?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="man_kid_000443",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es. Todos los mamíferos se abrazan con su madre al momento de lactar. Esta\ncalidez es esa misma calidez que sentimos al nacer. Y por eso todos la\nconocen.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000260",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ya veo... p-pero.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="man_kid_000444",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000261",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ah, no, n-no pasa nada...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_kid_000445",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es por ese hombre, ¿verdad? Debe haberse sentido terrible cuando te abrazaba.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000262",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“D-Disculpe que salga con esto, después de prometer que lo olvidaría...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="man_kid_000446",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Está bien. Se trata de algo importante.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000263",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿De algo importante?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="man_kid_000447",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí. Ese calor lo sentimos al ser abrazados por alguien que amamos. Ese calor\nnos llega incluso hasta el corazón.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="man_kid_000448",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El calor de alguien que no amamos, por otro lado, es horrible.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000264",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Al ser abrazados por alguien que amamos... Kenichiro-san, ¿mi calor no se le\nhace incómodo?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="man_kid_000449",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por supuesto que no, Mizuna. Te amo, y por eso mismo se siente muy bien.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000265",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿De verdad, de verdad? Pero, pero, ahora que me dice eso...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="man_kid_000450",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000266",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Por qué, será?... Mi corazón, se siente tan cálido ahora... y...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000267",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Por qué?... Mi corazón está tan cálido, y aun así...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"bg",file="ev_com_g03_05",sync=0,face=1,time=400,path=":ev/ev_com_g03/",set="ev_com_g03"},
{"text"},
text={
ja={
{
"Lágrimas brotan de los ojos de Mizuna, y las gotas cayeron sobre mí.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000268",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“P-Perdone que ensucie su cara. ¿Por qué estoy llorando? ¿Por qué, si no me\nsiento triste?...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="man_kid_000451",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Las personas no lloran solo cuando están tristes. También cuando están felices.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000269",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Las personas lloran también... cuando están felices...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="man_kid_000452",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es. Probablemente estás feliz ahora, Mizuna.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000270",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Estoy feliz. Yo...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="man_kid_000453",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lloras porque estás feliz. Y tu corazón está cálido porque estás feliz.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000271",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Ya, ya veo, sí. Jamás, entendí para qué servía mi corazón.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000272",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Siempre pensaba, que de no tener uno, no hubiera sufrido tanto.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000273",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Pensaba, si tan solo no tuviera corazón, si tan solo pudiera arrancarlo, me\nlibraría de tanto dolor...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000274",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Mi cuerpo está sucio ahora, y mi corazón me hacía sufrir por eso.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000275",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Mi cuerpo, y mi corazón... Siempre me he preguntado, para qué sirven.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="man_kid_000454",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tu cuerpo no está sucio, Mizuna. Solo que eso crees tú.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="man_kid_000455",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y ese corazón que tanto te ha hecho sufrir hasta hoy, está ahora dándote calor.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="man_kid_000456",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Con qué palabras podrías describir lo que sientes ahora?”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000276",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Qué palabra, podría usar... No consigo ninguna. Jamás, había sentido algo\nasí...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="man_kid_000457",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Felicidad, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000277",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Felicidad? Ah, claro... así que esto es felicidad...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000278",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Sí, creo que en este momento, estoy sintiendo felicidad...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="man_kid_000458",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tu corazón te hizo sufrir, pero es ese mismo corazón el que te hace feliz\nahora.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="man_kid_000459",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No debes repudiar tu propio corazón. Con eso no lograrás borrarlo, solo\nlastimarlo.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="man_kid_000460",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No debes repudiar tu propio cuerpo. Lo único que lograrás con eso es lastimar\ntu corazón...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000279",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Repudiar a mi corazón, o mi cuerpo, solo hará que lastime mi corazón... ¿es\nasí?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="man_kid_000461",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es. Mientras más te odies a ti misma, más dolor sufrirá tu corazón.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="man_kid_000462",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tu corazón no es tu cuerpo, ni tu cuerpo tu corazón.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="man_kid_000463",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero tu corazón es tu cuerpo, y tu cuerpo tu corazón.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="man_kid_000464",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Son distintos, y a la vez lo mismo.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="man_kid_000465",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Quizás solo haya diferencia en la manera de decir. O disonancia, en la misma\nmanera de decir. Así es como es.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="man_kid_000466",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y por eso debes cuidar de tu cuerpo, Mizuna. Y de tu corazón.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000280",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Cuidar de mi cuerpo y mi corazón?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="man_kid_000467",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es. No te hagas sufrir más, ni tampoco te encierres. Tienes todo el derecho\na ser más feliz.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000281",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Feliz, yo?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="man_kid_000468",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí. Tienes derecho a ser feliz.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000282",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Feliz... feliz, yo... uhh...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Lágrimas vuelven a brotar de los lagrimosos ojos de Mizuna.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000283",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¿Derecho, a ser feliz? Yo, a ser feliz... Uh, ughh... uwaaah.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Y rompió en llanto.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Gimiendo 'uwaaahn' como una niña pequeña.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Ella, que ha venido rechazando su propio corazón.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Ella, que ha venido rechazando su propio cuerpo.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Ella, que ha venido rechazándose a sí misma.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Pero ya no más.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Y por eso, llora.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"¿Y cómo no?",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
"Bastante ha aguantado. Bastante se ha esforzado.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"No es nada raro que las lágrimas se le salgan.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000284",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Estoy... muy feliz en este momento.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000285",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Es tanta la felicidad que hasta miedo me da. Es que, yo, ¿por qué estoy tan\nfeliz ahora?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000286",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“No sé, no lo sé.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="man_kid_000469",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No hace falta que lo sepas. Así es la felicidad. La persigues y no viene, pero\ncuando viene, lo hace de repente.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="man_kid_000470",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así que puedes estar tranquila.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="man_kid_000471",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Puedes estar tranquila y ser feliz, Mizuna.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_mzd_000287",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Uwaaahn.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"bg",time=2000,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Mizuna pasó todo el rato llorando.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Todas las lágrimas que se ha contenido por varios, o no, por más de diez años.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"A veces nos salen más lágrimas estando felices que tristes.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Y eso es lo que sucede ahora.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Por eso es que seguí abrazándola. Hasta que sus lágrimas se calmaron...",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"¿Que qué pasó después de eso?",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Vamos, ejercita un poco la imaginación.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"¿De mi parte? Lo único que puedo decir es que Mizuna ha sido la mejor mujer que\nhe tenido.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Ya sabrás de lo que hablo.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="cg_toki_bg048a",id=7,lv=7,path=":cg/",sync=0},
{"fg",ch="章一",size="z1",ex03="a0097",id=9,lv=8,mode=3,resize=1,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Días después, la familia Natsume arrinconó a los Nakamura.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Falsos yakuzas como los Nakamura no tenían manera de enfrentarse a verdaderos\nGokudo como los Natsume.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Los Nakamura fueron borrados por completo de los bajos mundos de Yumihari, y\nese golpe llegó incluso a afectar a sus negocios oficiales.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"La familia Nakamura llegó a tener el poder absoluto antes de la guerra.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Al culminar la misma, ese poder fue debilitándose, y terminaron permitiendo el\ncrecimiento de los Natsume.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Hubo un tiempo que trajeron a yakuzas de Tokio para bloquear ese crecimiento, lo\ncual terminó en conflicto. Y sin embargo, lo único que lograron fue\nfortalecer la influencia de los Natsume en los bajos fondos.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Los yakuzas de Tokio decidieron darse por vencidos ante el alargamiento del\nconflicto. Años después de que explotara la guerra, decidieron hacer la paz.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Dicen que en ese momento hubo la influencia de una enorme facción de derecha,\ntan poderosos que eran vistos como la eminencia gris del país.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"De ahí es que se dice que los Natsume tuvieron el apoyo de una eminencia gris.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Una entidad tan poderosa jamás se metería en un conflicto de yakuzas regionales.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Fue en eso que Kotoko Natsume se ganó aún más fama por su gran carácter.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Para el momento en que se logró el acuerdo de paz, los Nakamura habían perdido\nuna gran parte de su fuerza ante los Natsume.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"A pesar de eso, no perdieron el control de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="black",path=":bg/",sync=0},
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Y por eso es que este incidente fue una muy buena excusa para los Natsume.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"1 billón de yenes. Para Kotoko Natsume, ese dinero solo era un pretexto.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Su verdadera intención era eliminar a los Nakamura de los bajos mundos.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Por esa razón es que se mostró tanto entusiasmo por mi petición.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Solo hacía falta una razón de conflicto para ella y sus yakuzas. Lo demás, hacer\nlo que mejor saben hacer.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Era natural que los Natsume aprovecharan este incidente y arrinconaran a los\nNakamura.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Usaron todo método a la mano.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Sin mucho poder ya, y sin poder pagar 1 billón en efectivo, los Nakamura\npidieron que se aceptara la residencia como pago por la deuda.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Por supuesto, la abuela Natsume ni siquiera se inmutó.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"cgdel",id=-1,time=1000,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm026"},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000046",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“1 billón por la propiedad. Lo de afuera y lo de adentro.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000223",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Cómo que lo de afuera y lo de adentro?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000047",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Que me darás las muchachas que viven acá, eso significa.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Las negociaciones se hicieron en la residencia Kootoha.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Era un ambiente raro, donde ambas partes tenían a hombres en traje negro de su\nlado.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Que dos líderes en conflicto hablaran sin intermediario alguno era algo\ndefinitivamente excepcional.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Y esto se debe a que los Nakamura, a final de cuentas, no eran yakuzas.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Allí estaba yo, entre los yakuzas, escuchando a las dos partes.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000224",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Solo me quedan dos en la casa! ¡¿Que te las dé?! ¡No voy a hacerlo!”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000048",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Son solo dos muchachas, un precio muy barato a pagar por 1 billón, diría yo.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000225",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“No es por eso. Su valor está en la fuerte sangre Nakamura que llevan adentro.\nHemos venido conservando nuestra sangre de esa manera desde generaciones\npasadas.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000049",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Conservando la sangre desde generaciones pasadas? Muchacho imbécil, lo único\nque han hecho es jugar y abusar de dos muchachas indefensas.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0008",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000226",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“No, no es eso... hay una buena razón para todo esto.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000050",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Hakuki, será?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0007",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000227",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿C-Cómo es que conoces ese nombre?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Nakamura palideció.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",mode=-2},
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000051",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Cualquiera que haya nacido en Yumihari conoce la leyenda de los cerezos\nmilenarios.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000052",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“La sacerdotisa que traga los corazones de los demás. Desde que se mezclaron con\nlos Housou, los Nakamura se volvieron capaces de procrear, muy\nocasionalmente, a muchachas así.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000053",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Por eso es que ustedes no diluyen su sangre con otros. Por supuesto, sus\nmatrimonios demuestran otra cosa a la luz pública.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000054",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Pero en las sombras han estado mezclándose entre ustedes mismos, tratando de\nconservar esa sangre. Eso han estado haciendo ustedes, los Nakamura, por\nestos mil años.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0005",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000055",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Y esa es la razón por la cual se construyó esta residencia. Para impregnar a\nsus actuales amantes y procrear nuevas. Todo para obtener a Hakuki.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000056",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Ustedes están locos. Enloquecidos por esa absurda leyenda, destrozando las\nvidas de muchísimas mujeres en estos mil años.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000228",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Lo que es locura para ustedes es algo esencial para nosotros!”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000229",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Varias veces ha nacido la sacerdotisa Hakuki en nuestra línea histórica. Y en\ncada ocasión hemos podido prosperar. Los Nakamura hemos seguido haciendo eso\npor mil años.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000057",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Esencial para la familia, eh... ¿Es que de verdad creen en esa ridícula\nhistoria?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0001",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000230",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Sí creemos. La última Hakuki nació en el 3 de marzo del año 15 Meiji, 1882 en\ncalendario gregoriano. Esa Hakuki predijo la victoria de Japón en la guerra\nsino-japonesa, lo cual aprovechamos durante todo el conflicto para\nenriquecernos.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000058",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Acaso la has visto? A juzgar por esa fecha de nacimiento debería tener casi la\nmisma edad que yo ahora.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0007",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000231",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Eh? ¿C-Cuántos años tienes tú, anciana?”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",mode=-2},
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000059",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“98, por si no lo sabías.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="man_kid_000472",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Eh? ¿De verdad? ¿En serio tienes esa edad?”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",lv=4,id=9},
{"fgact",ch="琴子",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000060",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Así es. La que más ha durado en este negocio.”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Más obvio no podría ser. Ya tiene casi 100 años, cielo santo. Pero qué clase de\nmujer.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="man_syi_000232",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Hakuki no suele vivir mucho tiempo... Se dice que esa murió antes de llegar a\nlos 20.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000061",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Pues qué pena, eh. Probablemente son ustedes la razón de tan corta esperanza de\nvida.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="man_syi_000233",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“No es por eso. Hakuki no puede vivir mucho por toda la oscuridad que devora de\nlos corazones de las personas. En sus últimos momentos enloquece y muere, esa\nes su naturaleza.”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0005",head="ktk_z1a",lv=4,id=9},
{"fgact",ch="琴子",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000062",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Definitivamente ustedes solo piensan en sí mismos.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="man_syi_000234",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Digas lo que digas, esas dos muchachas llevan la preciada sangre de la familia\nNakamura.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",lv=4,id=9},
{"fgact",ch="琴子",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000063",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“No vamos a llegar a nada con esto.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_syi_000235",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Pues así será! ¡No les daré a Mizuna ni a Ai, pase lo que pase!”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000064",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Ah? ¿Quieres romper la negociación entonces? Está bien, pues si quieres guerra\nde verdad eso tendrás.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="man_syi_000236",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Eres tú quien está intentando romper con las negociaciones. Sí, si es por eso\naprovecharé de estrenar a Ai también...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000065",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Pero qué ridiculez dices? Ai es todavía una niña, así le pongas las manos\nencima no te dará ningún bebé.”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_syi_000237",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Eso no me importa!”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="man_syi_000238",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡No debí haber jugado tanto con Mizuna! ¡Me preocupaba de lo que dijeran en el\ncolegio, así que decidí esperar hasta que se graduara, pero bien que debí\nhaberla preñado mucho antes!”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",lv=4,id=9},
{"fgact",ch="琴子",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0005",head="ktk_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000066",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Ohhh, hay que ver que realmente eres una basura, muchacho. Pues si es así, quizá\nlo mejor sea acabar con la familia Nakamura.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000067",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Yasu, trae mi herramienta.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",mode=-2},
{"fg",ch="ヤス",size="z1",mode=3,resize=1,path=":fg/ysu/z1/",file="ysu_z1a0000",face="a0001",head="ysu_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ysu_000003",ch="ysu"},
},
ja={
{
name={"Yasu"},
"“Sí, seño'.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="ヤス",size="z2",mode=3,resize=1,path=":fg/ysu/z2/",file="ysu_z2a0000",face="a0001",head="ysu_z2a",lv=5,id=9},
{"fgact",ch="ヤス",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1,vol=40},
{"text"},
text={
ja={
{
"Yasu-san sacó un objeto envuelto en un pañuelo del bolsillo de su pecho y se lo\ndio a la abuela.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",mode=-2},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0007",head="syo_z1a",lv=4,id=9},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_syi_000239",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Herramienta? ¿Una, pistola? E-Espera, esp-, espera un segundo.”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
ja={
{
"No solo el propio Nakamura, también sus guardaespaldas estaban agitados.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Y es que todos los hombres del grupo Natsume estaban metiendo sus manos en los\nbolsillos de sus chaquetas.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Seguramente no los creyeron capaces de sacar pistolas a plena luz del día.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0006",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000240",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡¿Te volviste loca?! ¡Si se forma un tiroteo con toda esta cantidad de gente y\na esta distancia, saldrán muertos!”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000068",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Kotoko Natsume es una vieja que ya tiene un pie puesto sobre la tumba. Muera\nmañana o el año que viene no cambia mucho las cosas.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="man_kid_000473",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“......”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Quizás a ti no te importe, pero a mí sí. Yo no quiero morir...",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0004",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000241",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"*Tch*, *tch*...",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Aunque ya con esto el asunto estaba casi resuelto.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"Nakamura está casi a punto de desistir.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"No esperaba menos de la abuela. No muestra piedad alguna en las negociaciones.\nNo en vano ha logrado mantener el grupo en esta época donde casi todos los\ndemás han terminado uniéndose a las organizaciones más grandes.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Solo falta un empujón más para tumbar a Nakamura. Esta vez, hacerle una buena\noferta.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Eso pensábamos la abuela y yo.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Pero, justo en ese momento...",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="水菜",size="z1",mode=3,resize=1,path=":fg/miz/z1/",file="miz_z1a0200",face="a0007",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="うなづく",lv=4,id=9},
{"se",file="se9006",id=1},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000288",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡B-Basta con que te quedes conmigo, ¿no?!”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000069",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="man_kid_000474",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿M-Mizuna?”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000070",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¡Estamos en medio de una negociación, no te metas en esto, muchacha ingenua!”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0009",head="miz_z1a",lv=4,id=9},
{"fgact",ch="水菜",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000289",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“P-Pero no quiero que esto acabe en una masacre.”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",mode=-2},
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000071",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¡No tienes de qué preocuparte, sal ya!”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="man_syi_000242",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Ahhhn? Así que también está Mizuna acá. ¡Si ocurre un tiroteo, ella podría\nacabar en peligro también! ¡¿No es así, Natsume?!”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000072",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="man_syi_000243",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Supongo que no habrá balacera después de todo, eh. La custodia de esta muchacha\nes parte de la negociación también, si no mal recuerdo.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000073",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"La abuela Natsume se queda, por primera vez desde que llegó, en silencio.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Seguramente Mizuna, en su preocupación por todos, no pudo evitar intervenir...",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
vo={
{"vo",file="man_kid_000475",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lo siento, debí habérmela llevado afuera... Insistió en que quería ver lo que\npasaba...”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000074",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Bien que debiste. Sobre todo cuando la negociación es sobre ella.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",mode=-2},
{"ex",time=0,func="wait"},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Lo que hizo Mizuna volteó las cosas.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"Estas negociaciones requieren técnica.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
"Amenazas y extorsión son componentes naturales en ellas.",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"Nunca debes tomártelas muy en serio.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"Como iban las cosas hasta ahora teníamos la oportunidad de obtener también a\nlas dos muchachas.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Era justamente eso lo que la abuela Natsume quería.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Pero la bondad de Mizuna arruinó esa oportunidad.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"La grieta mejor oculta en el plan la abrió la misma muchacha sobre la cual se\nrealizaba la negociación.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"ex",time=0,func="wait"},
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000244",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Por qué no hacer lo que dice Mizuna?”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0010",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000245",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Ustedes se quedan con Ai y nosotros con Mizuna, mitad y mitad. No hay problema\nasí, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000075",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Claro que lo hay.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0002",head="syo_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000246",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Cuál? Ella misma está diciendo que no le importa. ¿O es que acaso piensas\nignorar su voluntad y llevártela a ella también? ¿Con qué propósito?”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000076",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Idioteces, no nos pongan en el mismo lugar que ustedes. ¿Propósito? Propósito\nno hay.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="章一",size="z1",ex03="a0097",mode=3,path=":fg/syo/z1/",file="syo_z1a0000",face="a0005",head="syo_z1a",lv=4,id=9},
{"fgact",ch="章一",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_syi_000247",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¿Por qué entonces quieren llevarse también a las muchachas de Kootoha sin razón\nalguna? No tiene sentido.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"El punto de la discusión no es claro ya.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
"Eso es lo peor que puede ocurrir en una negociación.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"Perdimos la cubierta que queríamos usar.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",mode=-2},
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0007",head="miz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="水菜",act="いいえ",lv=4,id=5},
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0009",head="miz_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0011",head="miz_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mzd_000290",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“¡Ya está bien! Me quedaré... con ellos.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000077",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Muchacha, ¿estás consciente de lo que has vivido hasta ahora, y de lo que te\ntocará vivir de ahora en adelante?”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0010",head="miz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="水菜",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mzd_000291",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0005",head="ktk_z1a",x=345,lv=4,id=6},
{"fgact",ch="琴子",act="いいえ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_ktk_000078",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Estos hombres vieron amenazada la pureza de su sangre por primera vez hoy. Solo\nde pensar lo que vivirás a partir de hoy... me da escalofríos.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0011",head="miz_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0006",head="miz_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mzd_000292",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“No se preocupe. Por más que ultrajen mi cuerpo, no podrán ultrajar mi espíritu.\nEso me enseñó Kenichiro-san.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",x=345,lv=4,id=6},
{"fgact",ch="琴子",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000079",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"La abuela Natsume pone su mano sobre la frente.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",x=345,lv=4,id=6},
{"fgact",ch="琴子",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000080",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¡Kenichiro! ¡¿Qué opinas tú de esto?!”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="man_kid_000476",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lo sé.”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0003",head="ktk_z1a",x=345,lv=4,id=6},
{"fgact",ch="琴子",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000081",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¡¿Lo sé?! ¡¿Saber qué?!”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_000477",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Que ya no puedes hacer nada más. ¿No es así, abuela?”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000082",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"La abuela Natsume se dio unos golpes en el hombro. Me recuerda a esas viejitas\nque hacen lo mismo mientras se relajan en la veranda de sus casas.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"fgact",ch="琴子",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_ktk_000083",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Fuh, diablos. Qué difícil es hacer funcionar las cosas cuando el corazón se\ninterpone.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000084",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Siempre termina llevándolo todo en direcciones inesperadas.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0002",head="ktk_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000085",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Aunque esa es la naturaleza del humano, después de todo...”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000086",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿De verdad estás de acuerdo con esto, Mizuna? Esta es tu última oportunidad.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0002",head="miz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="水菜",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="水菜",size="z1",mode=3,path=":fg/miz/z1/",file="miz_z1a0200",face="a0019",head="miz_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mzd_000293",ch="mzd"},
},
ja={
{
name={"Mizuna"},
"“Le agradezco todo lo que hizo por mí, pero no se preocupe. Estoy de acuerdo.”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0004",head="ktk_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000087",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Ya veo. Si esa es tu voluntad, no puedo hacer nada más.”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
vo={
{"vo",file="man_syi_000248",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",x=345,lv=4,id=6},
{"fgact",ch="琴子",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000088",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¡Pues entonces Ai y la residencia por el billón!”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"mwact",act="おじぎ"},
{"text"},
text={
vo={
{"vo",file="man_syi_000249",ch="syi"},
},
ja={
{
name={"Shoichi Nakamura"},
"“¡Está bien!”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="04_what_is_mind？_02_7"},
{"text"},
linkback="block_00277",
},
