astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c06_01",path=":ev/ev_eye_c06/",set="ev_eye_c06"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_eye_c10_01",path=":ev/ev_eye_c10/",set="ev_eye_c10"},
{"ex",time=3000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_winter",id=2,lv=2,sync=1,path=":cg/"},
{"bgm",file="bgm020"},
{"text"},
text={
ja={
{
"Cuando los vi, la discusión ya había comenzado.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_knd_000276",ch="knd"},
},
ja={
{
name={"???"},
"“¡Ahora sí no me equivoco! Tú eres la novia de Kusanagi-kun, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg044i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0200",face="a0002",head="kan_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1a0200",face="a0005",head="rna_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Kana Nagayama.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"No se ha cansado de buscar riña...",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Estuve por intentar acercarme, pero me contuve en el último momento.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="fem_yum_002428",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Rina tiene a Kusanagi para protegerla...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",mode=-2},
{"fg",ch="直哉",size="z1",mode=3,resize=1,path=":fg/nao/z1/",file="nao_z1a0200",face="a0001",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que es más que obvio. Y bien, ¿qué se te ofrece hoy?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_knd_000277",ch="knd"},
},
ja={
{
name={"Kana"},
"“Vaya vaya, así que es verdad. ¿Podrías explicarme entonces qué fue lo que\nrealmente sucedió?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0200",face="a0004",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo que realmente sucedió?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="fem_knd_000278",ch="knd"},
},
ja={
{
name={"Kana"},
"“Si no me dices, algo peor a lo de Yuumi podría pasarle a ella. Solo digo~”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0200",face="a0014",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué te refieres con lo que realmente sucedió?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"mwact",act="うんうん",time=300},
{"text"},
text={
vo={
{"vo",file="fem_knd_000279",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Tengo que volver a repetírtelooo? Tu retorno al arte, con esa obra,\nobviamenteee.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_knd_000280",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Por qué después de tanto tiempo sin tocar el pincel volviste a pintar de\nrepente, Kusanagi-kun?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0200",face="a0017",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo no he vuelto a pintar.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"mwact",act="いいえ",time=400},
{"text"},
text={
vo={
{"vo",file="fem_knd_000281",ch="knd"},
},
ja={
{
name={"Kana"},
"Mentira, una gran mentira. Quizás engañes a los demás con eso, pero a mí no.\nSakurasouzu. Lo pintaste tú, ¿verdad?",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0200",face="a0001",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rina, ¿tienes tiza?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_rna_002959",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Tiza? No, acá no.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0200",face="a0019",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No importa, otra cosa que sirva igual...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_rna_002960",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tengo carboncillo...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0200",face="a0009",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Con eso basta...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fgact",ch="直哉",act="うなづく",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Kusanagi toma el carboncillo.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",mode=-2},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0002",head="kan_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000282",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Carboncillo?\nBueno, bueno, ¿es que vas a pintarme algo?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Al tomar el carboncillo, Kusanagi comenzó a pintar algo en la pared que tenía\nal lado.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Mis ojos veían una buena composición, y sin embargo la expresión facial de\nNagayama fue retorciéndose cada vez más.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000283",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Q-Qué... es esto?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ngh...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"se",file="se_koton",id=1},
{"text"},
text={
ja={
{
"El carboncillo se cayó de las manos de Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0008",head="kan_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000284",ch="knd"},
},
ja={
{
name={"Kana"},
"“E-Esto, tiene que ser mentira... n-no puede ser...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Sin preocuparse por la alterada Nagayama, Kusanagi completó el dibujo, después\nde haber dejado caer el carboncillo varias veces.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"La temática del dibujo era de cerezos.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0007",head="kan_z1a",lv=4,id=5},
{"fgact",ch="香奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000285",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Qué demonios es esto?! ¡N-No estabas dibujando con seriedad, ¿verdad?!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí lo estaba.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",lv=4,id=5},
{"fgact",ch="香奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000286",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Muéstrame tu mano derecha!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",mode=-2},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Nagayama aprieta el brazo derecho de Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0200",face="a0001",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que revises, ya lo viste.\nNo siento casi mi mano derecha.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0200",face="a0017",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Perdí mi brazo dominante.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0200",face="a0014",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso mismo no puedo pintar como lo hacía antes, menos aún el Sakurasouzu\nque mencionas.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="fem_knd_000287",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Q-Qué hay de tu mano izquierda?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0200",face="a0008",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mi mano izquierda, eh. Mi mano izquierda...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",mode=-2},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0005",head="kan_z1a",x=-345,lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0005",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
"Kusanagi intenta tomar el carboncillo de nuevo, pero Rina lo detiene.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0006",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002961",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No te parece que es ya suficiente?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000288",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Suficiente?”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0005",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002962",ch="rna"},
},
ja={
{
name={"Rina"},
"“Teniendo las cualidades que tienes, deberías haberte dado cuenta ya.\nKusanagi-san ya no puede pintar como lo hacía antes...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0018",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000289",ch="knd"},
},
ja={
{
name={"Kana"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0005",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000290",ch="knd"},
},
ja={
{
name={"Kana"},
"“Vaya, así que sí era cierto.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0007",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000291",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Realmente eras una basura después de todo!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000292",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Sabía que te habías lastimado el brazo derecho, pero quién diría que a estos\nextremos!”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0004",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000293",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Me caigo de la risa! ¡Qué tonta fui, creyendo que esta basura podía ser capaz\nde pintar semejante obra!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0017",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000294",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ya veo, así que el autor de esa obra no fue Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0011",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000295",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Quizás sí fue entonces Kenichiro Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0005",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000296",ch="knd"},
},
ja={
{
name={"Kana"},
"“Qué más da. Total, ya ninguno de los dos puede pintar.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000297",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Como buenas chatarras que son, ciertamente!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0018",head="rna_z1a",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002963",ch="rna"},
},
ja={
{
name={"Rina"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Rina?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="香奈",mode=-1,lv=4,id=5},
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0018",head="rna_z1a",x2=345,x=0,lv=4,id=6},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0005",head="rna_z1a",x=0,lv=4,id=6},
{"text"},
text={
ja={
{
"Rina le arrebata el carboncillo a Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Y, después de respirar hondo,",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"comenzó a trazar sobre el dibujo de Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_knd_000298",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Qué? ¿Va a pintar ahora la señora Kusanagi? ¿Qué vas a dibujarme?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Nagayama la provoca.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Pero Rina la ignora, dibujando sin detenerse.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=-960,y=-586,speed=240000,file="zbg044a",path=":bg/",x2=0,y2=-586,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Su brazo no vaciló en ningún momento.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Jamás nadie pudo haber creído que habría tanta vitalidad en Rina.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Y sin embargo, su brazo estaba ahora dibujando con fuerza y firmeza.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Y la forma en que lo hacía, se asemejaba tanto a...",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_yum_002429",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Al Naoya Kusanagi, de la noche del tifón...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_knd_000299",ch="knd"},
},
ja={
{
name={"Kana"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"La expresión de Kana Nagayama cambió.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Habían unos cerezos, ardiendo.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Kana contiene la respiración.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Sin embargo, en algún momento los cerezos dejaron de ser cerezos. Y pasaron a\nser...",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_knd_000300",ch="knd"},
},
ja={
{
name={"Kana"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un ciprés...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Un ciprés ardiente, como en llamas.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Un ciprés totalmente distinto a todos los que Rina había pintado hasta el día\nde hoy.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Un ciprés rebosante de vida.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Suena paradójico, pero no es desacertado.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"El ciprés es símbolo de muerte, lamento y desesperanza.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Pero también simboliza reencarnación, inmortalidad, vida eterna.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"El ciprés no pierde sus hojas, aun en invierno.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Siempre porta un vivo y fuerte color verde, sin importar la época.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Y eso, más que 'muerte', se acerca más a la 'inmortalidad'.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"La misma inmortalidad de Cristo alimentó el mito de que la cruz en la que fue\ncrucificado fue hecha de madera de ciprés.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Encima de los cerezos llenos de vida que Naoya Kusanagi dibujó, Rina dibujó un\nciprés que los tragó dentro de sí.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg044i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0005",head="kan_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0005",head="rna_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_knd_000301",ch="knd"},
},
ja={
{
name={"Kana"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Al terminar de dibujar, Rina habló.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0006",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002964",ch="rna"},
},
ja={
{
name={"Rina"},
"“Quizás Kusanagi-san no pueda dibujar ya con su mano derecha, pero yo, como su\ndiscípula, continuaré con su legado.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0012",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000302",ch="knd"},
},
ja={
{
name={"Kana"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Abstraída hasta este momento, Kana Nagayama regresó en sí y soltó una pequeña\nrisa.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0002",head="kan_z1a",x=-345,lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0005",head="rna_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000303",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0009",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000304",ch="knd"},
},
ja={
{
name={"Kana"},
"“Sí, la forma de los trazos se asemeja a la de Naoya Kusanagi...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000305",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero tu dibujo tiene más oscuridad que los de él.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0018",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000306",ch="knd"},
},
ja={
{
name={"Kana"},
"“Evoca a la muerte.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0011",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000307",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero aun así... también emana vida.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000308",ch="knd"},
},
ja={
{
name={"Kana"},
"“Tch... es impresionante...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0015",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000309",ch="knd"},
},
ja={
{
name={"Kana"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Después de detenerse por un momento y de dar un suspiro, Nagayama dijo lo\nsiguiente.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0015",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000310",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ahhh, vayaaa, qué lata.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000311",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ya no cabe duda de que Naoya Kusanagi se convirtió en chatarra...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0009",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000312",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero parece que ha nacido una artista que podría ser igual, o incluso peor que\nél.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0011",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000313",ch="knd"},
},
ja={
{
name={"Kana"},
"“Talento. ¿Es que a final de cuentas siempre termina ganando el talento?...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0004",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="うんうん",time=300,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000314",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ay, ay, cómo me gustaría que se murieran todos aquellos más talentosos que yo.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0002",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000315",ch="knd"},
},
ja={
{
name={"Kana"},
"“Je, dios santo.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Por alguna razón, Nagayama sonrió.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0002",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000316",ch="knd"},
},
ja={
{
name={"Kana"},
"“Qué más da.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0003",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000317",ch="knd"},
},
ja={
{
name={"Kana"},
"“Yo soy Kana Nagayama. Artista, y una superior a ti.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0016",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000318",ch="knd"},
},
ja={
{
name={"Kana"},
"“De ahora en adelante me encargaré de aplastarte como artista.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0009",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002965",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Como artista?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0002",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000319",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Cómo te llamas?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0005",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002966",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me llamo Rina Hikawa.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0005",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000320",ch="knd"},
},
ja={
{
name={"Kana"},
"“Rina Hikawa... Aun teniendo semejante talento no te he visto en ninguna\nexposición...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0010",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002967",ch="rna"},
},
ja={
{
name={"Rina"},
"“No me interesa mucho eso...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0015",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0005",head="kan_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000321",ch="knd"},
},
ja={
{
name={"Kana"},
"“No te interesa, eh...\nPero yo sé.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0016",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000322",ch="knd"},
},
ja={
{
name={"Kana"},
"“Todos ustedes del club de arte de Yumihari están buscando entrar en la\nExposición Moore, ¿verdad? Obviamente tú también.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0002",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000323",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero ahora que Kenichiro Kusanagi murió, seré yo quien llevará las riendas del\nmundo artístico.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0005",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002968",ch="rna"},
},
ja={
{
name={"Rina"},
"“Jaa...”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0016",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000324",ch="knd"},
},
ja={
{
name={"Kana"},
"“Bien, espero verte en la Exposición Moore.\n¡Ya quiero ver qué vas a presentar!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0200",face="a0003",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000325",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Adiós!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="香奈",mx=-40,mode=-1,lv=4,id=5},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Apenas dijo eso, Kana Nagayama se fue.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0005",head="rna_z1a",x2=345,x=0,lv=4,id=6},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0002",head="rna_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002969",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajajaja... Creo que malentendió un poco las cosas al final.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0008",head="rna_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002970",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yo solo le di forma a lo que tú intentabas dibujar...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0015",head="rna_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002971",ch="rna"},
},
ja={
{
name={"Rina"},
"“En primer lugar, no tengo la más mínima intención de presentar en la Exposición\nMoore.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Acaso no dijiste que continuarías mi legado?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0006",head="rna_z1a",x=0,lv=4,id=6},
{"fgact",ch="里奈",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002972",ch="rna"},
},
ja={
{
name={"Rina"},
"“Como discípula no pude evitar decir eso, después de ver la manera en que\nhumillaron a mi maestro.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, por otro lado... Vaya dibujo que hiciste.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0009",head="rna_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002973",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nos podrían reprochar por haber dibujado acá, borrémoslo.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Borrarlo, eh...\n¿Realmente deberíamos borrar esto?...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Kusanagi observa el dibujo que hizo Rina.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jejeje. Creo que Nagayama no sería la única en sentirse amenazada, viendo a\nalguien con tanto talento aparecer de la nada.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pudiste dibujar con perfecta exactitud el diseño que intenté dibujar, y lo\nconvertiste en una composición impresionante. Creo que ya tienes lo necesario\npara llamarte artista profesional.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0002",head="rna_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002974",ch="rna"},
},
ja={
{
name={"Rina"},
"“No habría podido de hacerlo sola.\nFue gracias a tu boceto que pude dibujarlo.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Boceto? Lo que hice fue dibujar unos cerezos...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0003",head="rna_z1a",x=0,lv=4,id=6},
{"fgact",ch="里奈",act="うんうん",time=400,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002975",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero, pero... también es importante la esencia.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esencia...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ni uno, ni el otro, sino los dos?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0012",head="rna_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_002976",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso significaría que juntos hacemos un solo y genial artista...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Probablemente Kusanagi abrazó a Rina después de eso.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Me fui, sin terminar de ver lo que sucedió.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"msgoff"},
{"se",file="se9012",id=1},
{"ex",time=2000,func="wait"},
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"ex",time=2000,func="wait"},
{"bg",file="ev_com_d10_01",time=2000,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"bgm",file="bgm021"},
{"text"},
text={
ja={
{
"Por cosa extraña, vine a la playa.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"No tenía ningún propósito en mente.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Simplemente me habían dado ganas de ver el mar.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"No estaba haciendo nada en particular. Solo escuchando con mis audífonos la\naleatoria selección de canciones del reproductor.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Canciones de anime, electrónica, canciones de videojuegos, shoegaze, y viejas\ncanciones de idols. Toda una selección caótica.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"se",file="se9015",vol=20,id=1},
{"bg",file="ev_com_d10_02",path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="man_okz_000011",ch="okz"},
},
ja={
{
name={"Hombre"},
"“¿Mm? ¿Eh, qué haces por estos lugares?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"bg",file="ev_com_d10_03",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002430",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"¿Otro idiota buscando mujeres?... Cómo molestan.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"No me importaría que fuese una chica, pero este no es el caso.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Y nada me incomoda más que un hombre idiota intentando sacarme conversación en\nestos momentos.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="man_okz_000012",ch="okz"},
},
ja={
{
name={"Hombre"},
"“¿Qué haces aquí sola?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_yum_002431",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Ignoro al muchacho que tenía al lado.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="man_okz_000013",ch="okz"},
},
ja={
{
name={"Hombre"},
"“Igual de seca y antipática que siempre. No has cambiado ni un poco, eh,\nKawachino.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"bg",file="ev_com_d10_04",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002432",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"¿Cómo es que este tipo sabe mi nombre?",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"bg",file="ev_com_d10_03",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002433",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Quién eres? No, olvídalo, solo desaparece de mi vista. Me incomodas.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="man_okz_000014",ch="okz"},
},
ja={
{
name={"Hombre"},
"“Vamos, no digas eso.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Fue en ese momento que miré por primera vez al muchacho.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Vestía con ropa para correr, totalmente empapado en sudor. ¿Estaba corriendo?",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_yum_002434",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Estabas corriendo, ¿no? No sé para qué entrenarás, pero ocúpate en lo tuyo. Esa\ninsistencia me incomoda.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="man_okz_000015",ch="okz"},
},
ja={
{
name={"Hombre"},
"“¿Entrenando? Ah, sí.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Riéndose, el muchacho se sentó a mi lado.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"se",file="se9010",vol=50,id=1},
{"bg",file="ev_com_d10_05",path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002435",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Jaa? ¿Qué mierda haces?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="man_okz_000016",ch="okz"},
},
ja={
{
name={"Hombre"},
"“Ya los del salón me habían contado, pero vaya que sí sigues igual.\nAunque tienes un aspecto más tranquilo y decente ahora, eso sí...”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_yum_002436",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Los del... salón?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="man_okz_000017",ch="okz"},
},
ja={
{
name={"Hombre"},
"“Sí, a veces nos hablamos. Todos se han quejado de lo distanciada que estás.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"bg",file="ev_com_d10_06",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002437",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Su rostro se me hace familiar...",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"bg",file="ev_com_d10_08",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002438",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Okazawa?!”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="man_okz_000018",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“El mismo. ¿Quién más podría ser?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"bg",file="ev_com_d10_06",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002439",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, digo, solo que has cambiado bastante...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="man_okz_000019",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Ya han sido 4 años, obviamente iba a cambiar.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
vo={
{"vo",file="man_okz_000020",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“¿Y bien? ¿Qué haces tan deprimida acá, Kawachino?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"bg",file="ev_com_d10_06",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002440",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, no, deprimida no estoy.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="man_okz_000021",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Pues te veo y parecieras estarlo.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
vo={
{"vo",file="fem_yum_002441",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es tu imaginación. Estoy normal, como siempre...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="man_okz_000022",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“La Kawachino de siempre no vendría acá a sentarse a ver el mar como si nada.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
vo={
{"vo",file="fem_yum_002442",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“De vez en cuando no está mal venir, de vez en cuando...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="man_okz_000023",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“¿Te han... roto el corazón?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"bg",file="ev_com_d10_05",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002443",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... ¿Qué... estás diciendo?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="man_okz_000024",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“No me equivoco, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Okazawa dijo eso con un tono afectuoso.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"bg",file="ev_com_d10_07",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002444",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aghh, demonios, ¿es eso lo primero que se te ocurre decirle a alguien que\nllevas tiempo sin ver?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="man_okz_000025",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“¿Fue Hikawa?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"bg",file="ev_com_d10_05",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002445",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Permanezco sin responder nada.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="man_okz_000026",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Tiene que ser ella, vaya que era una preciosura. Dicen que ahora es más preciosa.\nCuando alguien habla de la chica de primer año más linda de Yumihari,\npor lo general se refieren a ella.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"bg",file="ev_com_d10_05",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002446",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Rina, preciosa? Eso es más que obvio.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
vo={
{"vo",file="man_okz_000027",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Creo que ahí diferimos un poco.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_yum_002447",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿De qué hablas?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
vo={
{"vo",file="man_okz_000028",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Nada, olvídalo...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="man_okz_000029",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Aunque, ¿el hecho de que te hayan roto el corazón significa que ya por fin\npuedo poner pies sobre la línea de partida?”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"bg",file="ev_com_d10_06",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002448",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
vo={
{"vo",file="man_okz_000030",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Nada más ni nada menos que lo que acabo de decir.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_yum_002449",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, sé qué clase de cosas te estás imaginando... Si me rompieron el corazón o\nno, eso no te afecta ni te incumbe de ninguna manera.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="man_okz_000031",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“¿A qué te refieres?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_yum_002450",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Soy lesbiana. Y seguiré siéndolo, por más que me rompan el corazón.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
vo={
{"vo",file="man_okz_000032",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Ajajaja, ¿pero qué dices? ¿Cómo no iba a saber eso de la chica que tanto me\ngustaba?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"bg",file="ev_com_d10_08",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002451",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿Qu--?!”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"Okazawa se ríe de una manera despreocupada y relajada, lo cual me dio algo de\npena.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"bg",file="ev_com_d10_05",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002452",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Q-Qué quieres decir entonces, con línea de partida?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="man_okz_000033",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Me daba curiosidad saber la cara que pondrías el día en que te rompieran el\ncorazón...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="man_okz_000034",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Pues para mí siempre has sido alguien fuerte, e inquebrantable...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"bg",file="ev_com_d10_06",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002453",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues te equivocas. Yo no soy tan fuerte.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="man_okz_000035",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Lo eras. Para mí tu fuerza era algo absoluto...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
vo={
{"vo",file="man_okz_000036",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Y por eso estaba convencido. De no llegar a ver la cara que pondrías después de\nque te rompieran el corazón, no podría estar a tu lado.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_yum_002454",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues aún no puedes estarlo. Soy lesbiana.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
vo={
{"vo",file="man_okz_000037",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“No me refería a eso.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
vo={
{"vo",file="man_okz_000038",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Por fin puedo estar a tu lado y hablarte como otra persona más, como iguales. A\neso me refiero.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"bg",file="ev_com_d10_06",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002455",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Hablarme como a otra persona más?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="man_okz_000039",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
vo={
{"vo",file="fem_yum_002456",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Es que acaso no podías hacerlo antes?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
vo={
{"vo",file="man_okz_000040",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“No podía. Siempre me inquietaba cuando te tenía frente a mí.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="man_okz_000041",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Siempre, desde niño...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_yum_002457",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya te lo dije...”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Eso es porque me viste como algo que no era...",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Yo no soy ni fuerte, ni inquebrantable...",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Y vaya que tampoco soporto estar sola.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"se",file="se9010",vol=50,id=1},
{"bg",file="ev_com_d10_03",path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="man_okz_000042",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Bueeeno, creo que me iré ya.”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"bg",file="ev_com_d10_02",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002458",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué andas haciendo de extracurricular?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="man_okz_000043",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Baloncesto.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="man_okz_000044",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Siendo de primer año aún no puedo entrar en la división oficial, pero estoy\nesforzándome.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_yum_002459",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
vo={
{"vo",file="man_okz_000045",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Venga, anímate, Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"bg",file="ev_com_d10_03",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002460",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Estoy bien.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
vo={
{"vo",file="man_okz_000046",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“No pareciera. Hikawa no es la única muchacha linda que hay, ¿sabes?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="fem_yum_002461",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Por supuesto que sí. La preciosura de Rina es algo fuera de este mundo.”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
vo={
{"vo",file="man_okz_000047",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Igual, seguramente algún día conseguirás a alguien más que te haga sentir\nmariposas en el estómago.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
vo={
{"vo",file="fem_yum_002462",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Y qué hay de ti? Bastante fea la manera en que te rechacé, ¿recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="man_okz_000048",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“¿Yo? Prefiero concentrarme en el club por un tiempo.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
vo={
{"vo",file="man_okz_000049",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“No tengo ganas de ir persiguiendo mujeres por ahí.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="man_okz_000050",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Por ahora soy feliz jugando baloncesto.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
vo={
{"vo",file="fem_yum_002463",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo, normie tenías que ser. Muérete.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="man_okz_000051",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“¡¿Qué tiene de normie alguien sin novia y que lo único que hace es jugar\nbaloncesto?!”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="fem_yum_002464",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero te ves feliz.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="man_okz_000052",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Pues sí lo estoy. Vivo mi día a día de forma íntegra y saludable.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"bg",file="ev_com_d10_02",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002465",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Qué bueno saber eso.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="man_okz_000053",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Pero, algún día――”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
vo={
{"vo",file="man_okz_000054",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Cuando me consiga una linda novia, espero que celebres conmigo, Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"bg",file="ev_com_d10_09",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002466",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tenlo por seguro. Pero a cambio, espero que te busques una tan linda que hasta\ncelos me dé.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="man_okz_000055",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Espero lo mismo de ti.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_yum_002467",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues gracias.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="man_okz_000056",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Bueno, por ahí nos vemos, Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
vo={
{"vo",file="fem_yum_002468",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Está bien. Escribe de vez en cuando.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
vo={
{"vo",file="man_okz_000057",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Igual no vas a responder.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
vo={
{"vo",file="fem_yum_002469",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Responder? Yo nunca respondo.”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="fem_yum_002470",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero igual me alegra cuando recibo un mensaje.”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
vo={
{"vo",file="man_okz_000058",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Esa es la jefa que conozco. Egoísta como siempre.”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"bg",file="ev_com_d10_02",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002471",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Más que egoísta, simplemente no me gusta sentirme sola.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
vo={
{"vo",file="man_okz_000059",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Ajajaja, lo sé.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="man_okz_000060",ch="okz"},
},
ja={
{
name={"Okazawa"},
"“Bien, me voy ya.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"bg",file="ev_com_d10_09",sync=0,face=1,time=400,path=":ev/ev_com_d10/",set="ev_com_d10"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002472",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Está bien...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"msgoff"},
{"se",file="se0744",vol=15,id=1},
{"bg",file="eveningsky_spring02",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"Okazawa se va corriendo.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Su silueta se va haciendo cada vez más pequeña.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"Y entonces, me quedé sola.",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
"Frente al mar sin olas.",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"Un mar que ni en broma se podría denominar hermoso.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"Y a pesar de eso, un mar que no me cansaba de observar...",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"Pero, después de observarlo un rato,",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"comencé a caminar lentamente.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
"Todo alrededor se está pintando de otoño.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"Y aun así, seguramente los Zypressen siguen igual de oscuros que siempre.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="zeveningsky_spring02",id=9,lv=9,speed=240000,sync=1,path=":cg/",x2=0,y2=-540,x=-960,y=-540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
vo={
{"vo",file="fem_yum_002473",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Una hilera de Zypressen en el cielo otoñal.”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
vo={
{"vo",file="fem_yum_002474",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Negros cual azabache, se chupan la ",
{"txruby",text="Éter"},
"luz",
{"txruby"},
"...”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
vo={
{"vo",file="fem_yum_002475",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y aunque de sus oscuras patas brille incluso el mar donde flotan los sueños...”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
vo={
{"vo",file="fem_yum_002476",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Olas de espejimos y blanca polarización.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
vo={
{"vo",file="fem_yum_002477",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pierdo las palabras de la verdad.”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="fem_yum_002478",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Las nubes se hacen pedazos y vuelan por los cielos.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
vo={
{"vo",file="fem_yum_002479",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, voy y vuelvo, rechinando los dientes y ardiendo, por el brillo de octubre,\nbajo el fondo del mar.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="fem_yum_002480",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así es ese caos que soy yo.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
vo={
{"vo",file="fem_yum_002481",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Zypressen, finalmente negro.”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
vo={
{"vo",file="fem_yum_002482",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Llueve entonces fuego de las nubes.”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="eveningsky_spring02",id=9,lv=9,sync=1,path=":cg/"},
{"text"},
text={
ja={
{
"Ya está por llegar la noche.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
"Suenan las varas de oro.",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"El sol del crepúsculo estaba completamente rojo.",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
"Y los ojos míos que observaban también.",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
"La brisa era fría, punzante, y también plácida.",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"eval",exp="g.rnaclear=1"},
{"eval",exp="g.clear_zyp=1"},
{"cgdel",id=-1},
{"bgm",stop=1,time=3000},
{"se",stop=1,id=-1,time=3000},
{"vostop",stop=1,time=3000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=3000,file="white",path=":bg/"},
{"cacheclear"},
{"ex",time=0,func="wait"},
{"staffroll",ch="st2"},
{"bgm",stop=1,time=3000},
{"se",stop=1,id=-1,time=3000},
{"vostop",stop=1,time=3000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=3000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"タイトル"},
{"text"},
linkback="block_00277",
},
label = {
top={block="block_00000",label=1},
},
}
