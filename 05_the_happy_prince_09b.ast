astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo V"},
{"bg",file="ev_eye_c13_01",path=":ev/ev_eye_c13/",set="ev_eye_c13"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="bluesky_spring",sync=1,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm013"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ai, ¿estás ahí?!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Grito desde la entrada de la residencia Natsume.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_aid_001602",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí estoy, Naoya. ¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"se",file="se9023",id=1},
{"text"},
text={
ja={
{
"Corro, dirigiéndome al lugar de la voz.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"cgdel",id=-1},
{"se",stop=1,time=500,id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg002a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001603",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué pasa? ¿Por qué gritabas?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Regresé al apartamento y... me encontré con esta notificación de la\nuniversidad.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0013",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001604",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Esa universidad...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, mi primera opción. Tu alma máter.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="fem_aid_001605",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿C-Cómo saliste?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todavía no he revisado. Pensé en abrirlo frente a ti.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001606",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿E-En serio? M-Me vas a poner nerviosa.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, digamos que tengo algo de seguridad...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso, gracias a todo el tiempo que pasaste conmigo ayudándome a estudiar.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001607",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues sí, fue un alivio que tus mejores asignaturas y las mías no coincidieran.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, abriré el sobre.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001608",ch="aid"},
},
ja={
{
name={"Ai"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="藍",mode=-1,lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Abro el sobre de la universidad.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Había una enorme cantidad de documentos adentro.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es esto? Está lleno de papeles... ¿Dónde está la notificación de\naceptación?...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0001",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001609",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Papeles?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0012",head="aix_z1h",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001610",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ah, ahora que recuerdo...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0003",head="aix_z1h",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001611",ch="aid"},
},
ja={
{
name={"Ai"},
"“Si has recibido ese sobre... el resultado debería ser obvio.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0002",head="aix_z1h",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001612",ch="aid"},
},
ja={
{
name={"Ai"},
"“No habría necesidad de mandar un sobre tan grande si hubieses reprobado...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Lo dices en serio? ¿Esta es la notificación de aceptación? Ah--”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"se",file="se2497",id=1},
{"text"},
text={
ja={
{
"Me encuentro con una hoja de papel.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"El título indicaba 'carta de aceptación'.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Es en serio?!”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0004",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001613",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Lo lograste, Naoya!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Sí!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2h0000",face="h0004",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
{"se",file="se3130",id=1},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"Ai me abraza.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y la misma facultad de educación en la cual estudiaste. Aunque la especialidad\nes distinta.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0003",head="aix_z2h",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001614",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ciertamente. Aunque te advierto que ir todos los días a la universidad desde\nacá cuesta trabajo.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero qué tonterías dices, tú también ibas y volvías acá, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0002",head="aix_z2h",lv=5,id=9},
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0004",head="aix_z2h",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001615",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, no lo niego.\nAunque vaya, jamás creí que aspirarías a ser profesor.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No era sorpresa, supongo...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno... Tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero ¿sabes? Yo también necesito algún sueño para salir adelante.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya perdí uno... Y quiero aferrarme ahora a uno nuevo.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0003",head="aix_z2h",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0002",head="aix_z2h",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001616",ch="aid"},
},
ja={
{
name={"Ai"},
"“No hables de un sueño como algo para aferrarse. Hay un camino de vida para\ncumplirlo, y acabas de dar el primer paso. Eres un triunfador.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0016",head="aix_z2h",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001617",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y debo admitirlo, con lo flojo que eras no pensé que llegarías a estudiar tanto\ncomo lo hiciste.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Desde hace tiempo he logrado cosas buenas cuando me concentro. Solo que no\nsuelo continuarlas.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2h0000",face="h0004",head="aix_z2h",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001618",ch="aid"},
},
ja={
{
name={"Ai"},
"“Me impresionaste con tu habilidad de concentración.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Y ya con esto soy un universitario, hecho y derecho.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1h0000",face="h0004",head="aix_z1h",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, Ai, ¿recuerdas la promesa que me hiciste?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0012",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001619",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Promesa? Mmm, ¿hice alguna promesa?”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te hagas la tonta. Acordamos que formalizaríamos nuestra relación al entrar\na la universidad.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0004",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001620",ch="aid"},
},
ja={
{
name={"Ai"},
"“Lo sé, no lo he olvidado. Pero ¿de verdad quieres hacerlo? La diferencia de\nedad es grande. Seré una señora en pocos años.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me tomes por tonto, ¿señora? ¡Señora serás cuando por fin te crezca algo de\nvello púbico!”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0007",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0008",head="aix_z1h",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_001621",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Uwaaan! ¡¿Vas a venir a decirme eso?! ¡¿Aun cuando lo hacemos nunca lo dices,\ny vienes a decirlo ahora?!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aunque para ser sincero, quería decírtelo cuando lo hicimos.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0018",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001622",ch="aid"},
},
ja={
{
name={"Ai"},
"“No tienes una sola pizca de delicadeza.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú mejor que nadie sabes eso.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0005",head="aix_z1h",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001623",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pues si estás consciente de ello deberías hacer algo para mejorar.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón. Si no te gusta, me esforzaré para arreglar eso.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0015",head="aix_z1h",lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001624",ch="aid"},
},
ja={
{
name={"Ai"},
"“Cielos, siempre tú tirando palabras de adulto.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bueno... Respecto a nuestra promesa...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001625",ch="aid"},
},
ja={
{
name={"Ai"},
"“No es una simple promesa.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_aid_001626",ch="aid"},
},
ja={
{
name={"Ai"},
"“Estaré siempre a tu lado, sea de la forma que sea.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_aid_001627",ch="aid"},
},
ja={
{
name={"Ai"},
"“Eso juré.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_aid_001628",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y por eso es que estaré siempre contigo.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_aid_001629",ch="aid"},
},
ja={
{
name={"Ai"},
"“Para protegerte de cualquier tristeza...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo... ya no estoy triste...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0003",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001630",ch="aid"},
},
ja={
{
name={"Ai"},
"“Naoya...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2e0000",face="e0003",head="aix_z2e",lv=5,id=9},
{"fgact",ch="藍",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Abrazo, a la vez, a Ai.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Su pecho estaba bastante cálido.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0002",head="aix_z2e",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001631",ch="aid"},
},
ja={
{
name={"Ai"},
"“Así que ya no estás triste... Ya es momento entonces de decirle adiós a la\ntristeza...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_aid_001632",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya van a florecer los cerezos de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así parece...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0004",head="aix_z2e",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001633",ch="aid"},
},
ja={
{
name={"Ai"},
"“Vayamos juntos a verlos este año...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2e0000",face="e0002",head="aix_z2e",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_001634",ch="aid"},
},
ja={
{
name={"Ai"},
"“Los cerezos de esta primavera estarán hermosos, estoy segura.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"msgoff"},
{"fg",mode=-2},
{"bg",file="bluesky_spring",sync=1,id=1,lv=5,path=":cg/"},
{"text"},
text={
ja={
{
"Ai fija su mirada a lo lejos.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Y en su foco, había una pequeña y única nube.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
