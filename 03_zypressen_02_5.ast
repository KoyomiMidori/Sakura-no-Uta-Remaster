astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bgm",file="bgm038"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg081g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1i0000",face="i0001",head="rna_z1i",x=-345,lv=4,id=5,sync=0},
{"fg",ch="直哉",size="z1",mode=3,resize=1,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Soy Naoya Kusanagi. Y este lugar forma parte de mi zona de graffitis\nartísticos.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0005",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001452",ch="rna"},
},
ja={
{
name={"Rina"},
"“Soy yo quien está dibujando aquí ahora.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0002",head="nao_z1i",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahora, sí. Pero no sino hasta hace poco...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0012",head="rna_z1i",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001453",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? Eso significa que...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="fem_yum_001449",ch="yum"},
},
ja={
{
"¡No dudé ni un segundo en interponerme frente al insolente intruso que osó\nviolar nuestro territorio!",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0012",head="rna_z1i",x2=-345,x=-570,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001450",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si es tu zona o no, eso me da igual. Vete ahora mismo, o si no...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"se",file="se9010",id=1},
{"fgact",ch="優美",act="うなづく",size=5,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001451",ch="yum"},
},
ja={
{
"Saqué mi cuchillo.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_yum_001452",ch="yum"},
},
ja={
{
"Y sin embargo, el muchacho se quedo viéndolo, sin inmutarse en lo más mínimo.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo llegué primero. Fueron ustedes las que vinieron después.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",x=0,lv=4,id=9},
{"fgact",ch="優美",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001453",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Eso no tiene nada que ver! ¡A nadie le importa si tú llegaste antes o no!”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0009",head="rna_z1i",x=-570,lv=4,id=5},
{"fgact",ch="里奈",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001454",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y-Yuumi, guarda eso.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, guarda esa cosa...\nNiñas como tú no deberían llevar esos juguetes tan peligrosos.\nUn paso en falso y terminarás cortándote, mocosa.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0018",head="yum_z1i",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001454",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué acabas de decir?...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="fem_yum_001455",ch="yum"},
},
ja={
{
"Ataco al muchacho con el cuchillo por arriba.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",x=0,lv=4,id=9},
{"se",file="se_arrow1",id=1},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",x2=0,x=210,lv=4,id=9},
{"fg",ch="優美",speed=150,mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",y2="0,10",x=210,y=0,lv=4,id=9},
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",x=345,lv=4,id=6},
{"fg",ch="直哉",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",x2=345,x=500,lv=4,id=6},
{"fg",ch="直哉",speed=150,mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",y2="0,-10",x=500,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uwaah, uwa, esp--, espera, espera un segundo, me vas a clavar, me vas a clavar\ncon eso.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",x=210,y=0,lv=4,id=9},
{"fgact",ch="優美",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001456",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Cállate y vete ya!”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"se",file="se_arrow2",id=1},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",x2=210,x=345,y=0,lv=4,id=9},
{"fg",ch="優美",speed=80,mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0006",head="yum_z1i",y2="0,10,0,10",x=345,y=0,lv=4,id=9},
{"fg",ch="直哉",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",x2=500,x=630,y=0,lv=4,id=6},
{"fg",ch="直哉",speed=150,mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0006",head="nao_z1i",y2="0,-10",x=630,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Esp--, para, para un momento, guarda ese cuchillo! ¡V-Vas a cortarme! ¡Wa,\nwawah!”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_yum_001457",ch="yum"},
},
ja={
{
"¿Qué demonios pasa con este idiota?",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_yum_001458",ch="yum"},
},
ja={
{
"Lo envalentonado del muchacho que tenía frente a mí se esfumó a la nada, y está\nahora huyendo de mi cuchillo, chillando.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0013",head="rna_z1i",x=-570,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001455",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡¿F-Fuiste tú quien dibujó aquel, aquel tronco?!”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0005",head="yum_z1i",x=345,y=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001459",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hikawa-san...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0002",head="nao_z1i",x=630,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, fui yo.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0009",head="rna_z1i",x=-570,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001456",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué no terminaste el dibujo?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=630,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no sé, la verdad. No tuve una intención concreta en mente cuando comencé a\nhacerlo.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0011",head="rna_z1i",x=-570,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001457",ch="rna"},
},
ja={
{
name={"Rina"},
"“Estaba esperando con muchas ansias que lo terminaras.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0002",head="nao_z1i",x=630,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“He dejado varios esbozos por allí y por allá, en bastantes paredes.\nEste fue uno más.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0010",head="rna_z1i",x=-570,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001458",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué pintas en tantos lugares?\n¿Y por qué no terminaste este dibujo?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=630,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dicen que los perros esconden sus tesoros más preciados en los lugares más\nextraños...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0016",head="yum_z1i",x=345,y=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_001460",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Entonces te olvidaste de tu dibujo. Así como los perros suelen olvidar el lugar\ndonde esconden sus huesos...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="優美",mode=-1,lv=4,id=9},
{"fg",ch="里奈",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0010",head="rna_z1i",x2=-570,x=-345,lv=4,id=5},
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=630,y=0,lv=4,id=6},
{"fg",ch="直哉",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x2=630,x=345,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cierra la boca.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0008",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001459",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ese tronco era realmente extraño. Tenía una forma bastante maltrecha.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0002",head="nao_z1i",x=345,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es porque viste un ciprés en él. Un ciprés negro, como en llamas.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0012",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001460",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿No lo es?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=345,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues ni idea. Lo que sí puedo decir es que la temática que tuve en mente al\npintarlo nada tenía que ver con la sumisión a la muerte.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0002",head="nao_z1i",x=345,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para poner más en concreto las cosas, no era la clase de dibujo que una chica\nlista, inspirada en las obras de Gogh que hacen alusión a la muerte,\nintentaría pintar solo para aceptar la suya propia.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0013",head="rna_z1i",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",size=5,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001461",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_001461",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0008",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_001462",ch="yum"},
},
ja={
{
"A duras penas, fijándome en las medicinas de Hikawa-san, es que logré saber de\nlo que sufría.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_yum_001463",ch="yum"},
},
ja={
{
"Mientras que este tipo apenas la conoció hoy.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="fem_yum_001464",ch="yum"},
},
ja={
{
"Y aun así, solo con ver el dibujo de Hikawa-san, adivinó la naturaleza de su\nenfermedad.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=345,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quisiste ver más de la pintura que dejé inconclusa... Por eso es que comenzaste\na pintar, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0011",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001462",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0002",head="nao_z1i",x=345,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y es por eso que hoy dibujé la continuación.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0013",head="rna_z1i",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001463",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Eh? ¿Estás hablando del dibujo del domo?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Teniendo este bosque de cipreses alrededor, entiendo muy bien que se te\nhaya venido Gogh a la mente. Y más aún teniendo la noche encima. Realmente\ndan ganas de meterse en sus obras.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, considerando la época, tal vez no te hayas dado cuenta. Hay, aparte de\nese, otro panorama en este lugar. Uno un tanto distinto.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0012",head="rna_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_001464",ch="rna"},
},
ja={
{
name={"Rina"},
"“Un panorama distinto...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=345,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso fue lo que vine a dibujar. Aunque no maté la figura de tu ciprés. Para ser\nsincero, tu dibujo está tan inspirado en Gogh que carece de originalidad.\nAunque, a pesar de eso, sentí algo imponente en él.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0002",head="nao_z1i",x=345,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tiene algo increíblemente vívido en sí. Como si la sombra de tu propia vida\ncubriera la pared del domo.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=345,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sentí haber visto la sombra de tu vida ahí adentro.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=345,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero... hay una parte que no me gusta.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_yum_001465",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡¿De qué mierda estás hablando?! ¡¿Quién rayos eres?! ¡Lárgate de una buena\nvez!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0005",head="nao_z1i",x=345,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que me lo pidas, ya me voy.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0004",head="nao_z1i",x=345,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo quiero hacerte saber que tu ciprés sirvió como parte de mi esbozo.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0001",head="nao_z1i",x=345,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para un ser dibujo que busca expresar aceptación a la muerte, es demasiado\ninfantil. Aún hay vida en él. Así que decidí dibujar lo que tenía planeado en\nun principio.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1i0000",face="i0002",head="nao_z1i",x=345,y=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si no te gusta, pues puedes borrarlo. Es solo tiza.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="直哉",mx=40,mode=-1,lv=4,id=6},
{"se",file="se9004",id=1},
{"text"},
text={
vo={
{"vo",file="fem_yum_001466",ch="yum"},
},
ja={
{
"El muchacho se fue.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_yum_001467",ch="yum"},
},
ja={
{
"Después de que se fue, entramos al domo.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_yum_001468",ch="yum"},
},
ja={
{
"Y lo que había adentro nos quitó el aliento.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001469",ch="yum"},
},
ja={
{
"Estaba el ciprés, negro y en llamas. Junto a muchas estrellas, rodeándolo.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_yum_001470",ch="yum"},
},
ja={
{
"Pero ninguna de ellas había sido dibujada.\nEran estrellas descritas sin haber sido dibujadas.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_yum_001471",ch="yum"},
},
ja={
{
"En pocas palabras, estrellas descritas por el cielo que había sido pintado a su\nalrededor.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_yum_001472",ch="yum"},
},
ja={
{
"Eran como chispas rojas, naciendo de las negras llamas.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="fem_rna_001465",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
vo={
{"vo",file="fem_yum_001473",ch="yum"},
},
ja={
{
"Hikawa-san se quedó en completo silencio mientras veía el dibujo.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="fem_yum_001474",ch="yum"},
},
ja={
{
"Ira. Tristeza. Sea cual fuese el sentimiento que tuviera ella en ese momento,\npensaba que se debía al hecho de que habían modificado su obra sin aviso ni\npermiso alguno. Sin embargo, la palabra que salió de su boca al siguiente\ninstante me daría a saber que estaba absolutamente equivocada.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="fem_rna_001466",ch="rna"},
},
ja={
{
name={"Rina"},
"“Increíble...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_yum_001475",ch="yum"},
},
ja={
{
"Pura y sencilla admiración.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="fem_yum_001476",ch="yum"},
},
ja={
{
"Admiración que haría nacer un impulso en ella.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_yum_001477",ch="yum"},
},
ja={
{
"Sentí una angustia indescriptible al ver que los ojos de Hikawa-san estaban,\ncomo nunca hasta ahora, rebosantes de vitalidad.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_yum_001478",ch="yum"},
},
ja={
{
"No esperó un segundo más para tomar la tiza y seguir dibujando la continuación\nde esa obra.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_yum_001479",ch="yum"},
},
ja={
{
"Me quedé parada.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_yum_001480",ch="yum"},
},
ja={
{
"Viendo a Hikawa-san, trabajando sin decir absolutamente nada.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_yum_001481",ch="yum"},
},
ja={
{
"La peste a muerte va desapareciendo.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_yum_001482",ch="yum"},
},
ja={
{
"En un cuerpo sano no pueden nacer gusanos.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_yum_001483",ch="yum"},
},
ja={
{
"Seguramente la mosca no sabrá qué hacer ahora.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"bg",file="ev_txt_c09_01",time=2000,path=":ev/ev_txt_c09/",set="ev_txt_c09"},
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　　　――Modulación III――",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bg",file="ev_txt_c04_01",time=2000,path=":ev/ev_txt_c04/",set="ev_txt_c04"},
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　　――El artista de los cerezos II――",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_yum_001484",ch="yum"},
},
ja={
{
"El muchacho no estaba.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_yum_001485",ch="yum"},
},
ja={
{
"Y sin embargo, al entrar al domo vimos cómo el dibujo había avanzado.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_yum_001486",ch="yum"},
},
ja={
{
"Al ver eso, Hikawa-san tomó de nuevo tiza en sus manos.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="fem_yum_001487",ch="yum"},
},
ja={
{
"El día siguiente fue lo mismo.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_yum_001488",ch="yum"},
},
ja={
{
" ",
{"rt2"},
"Y el siguiente a ese.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_yum_001489",ch="yum"},
},
ja={
{
" ",
{"rt2"},
" ",
{"rt2"},
"Y el siguiente a ese también.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_yum_001490",ch="yum"},
},
ja={
{
"Pintaban el mismo lienzo, en turnos, sin verse las caras.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_yum_001491",ch="yum"},
},
ja={
{
"Dibujando cada quien por su parte.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_yum_001492",ch="yum"},
},
ja={
{
"Era una obra conjunta no cooperativa.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_yum_001493",ch="yum"},
},
ja={
{
"Esta se iba actualizando, sin que ninguno de los dos viera al otro.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　　　――Actualización I――",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　　　――Actualización II――",		 
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　　　――Actualización III――",	 
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_yum_001494",ch="yum"},
},
ja={
{
"Las actualizaciones continuaban, siempre sujetas a la voluntad de quien\npintara.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="fem_yum_001495",ch="yum"},
},
ja={
{
"Y lo que allí plasmado estaba comenzó a tomar una dirección fija.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_yum_001496",ch="yum"},
},
ja={
{
"(Los gusanos dentro de mí comienzan a revolverse desesperadamente)",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_yum_001497",ch="yum"},
},
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　　　　　　Una carta",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_yum_001498",ch="yum"},
},
ja={
{
"　　　　　　　　　　　　　　　　　　　　　　　　　　(Ya las moscas no pueden acercarse)",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_yum_001499",ch="yum"},
},
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　　　Era una carta, intercambiada entre los dos.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="fem_yum_001500",ch="yum"},
},
ja={
{
" ",
{"rt2"},
" ",
{"rt2"},
"(El hedor a muerte se desvanece.)",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_yum_001501",ch="yum"},
},
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　　Ese maldito artista de los cerezos.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_yum_001502b",ch="yum"},
},
ja={
{
" ",
{"rt2"},
" ",
{"rt2"},
"　　　　　　　　　　　　　　　　　　　　　　(Sin un lecho de cría adecuado, la eclosión de los gusanos es imposible)",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_yum_001503",ch="yum"},
},
ja={
{
"La mano del artista hizo de la pared una carta, en forma de pintura.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_yum_001504",ch="yum"},
},
ja={
{
"No habían palabras, solo trazos y dibujos.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_yum_001505",ch="yum"},
},
ja={
{
"Hikawa-san no estuvo en ningún momento con ese tipo.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_yum_001506",ch="yum"},
},
ja={
{
"Siempre ha estado conmigo, acá.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_yum_001507",ch="yum"},
},
ja={
{
" ",
{"rt2"},
" ",
{"rt2"},
"　　　　　　　　　　　　　　　　　　　Pero la distancia entre las dos se va acrecentando cada vez más.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_yum_001508",ch="yum"},
},
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　El artista de los cerezos me la está arrebatando.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_yum_001509",ch="yum"},
},
ja={
{
"De la manera como debe ser.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="fem_yum_001510",ch="yum"},
},
ja={
{
" ",
{"rt2"},
"Su piel, siempre fría y pálida, comienza a sonrojarse y calentarse.",	
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_yum_001511",ch="yum"},
},
ja={
{
" ",
{"rt2"},
" ",
{"rt2"},
"Entre cada trazo que dibuja, su cuerpo recobra vitalidad.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_yum_001512",ch="yum"},
},
ja={
{
"Ella dibuja al símbolo de la muerte.\nY el artista de los cerezos solo dibuja un cielo.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_yum_001513",ch="yum"},
},
ja={
{
"Por alguna razón, a medida que dibujaba aquel símbolo mortal, se sentía menos\nel olor a muerte venir de ella.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_yum_001514",ch="yum"},
},
ja={
{
"Y en su lugar, comenzó a despedir el olor de un humano con vida.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_yum_001515",ch="yum"},
},
ja={
{
"　　　　　　Tiza blanca.",
{"rt2"},
"　　　　　　　　　　　　　　　　　　　　　　　　En ella no hay color.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
vo={
{"vo",file="fem_yum_001516",ch="yum"},
},
ja={
{
"En la acumulación de blanco que vertían, había infinidad de colores.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_yum_001517",ch="yum"},
},
ja={
{
"Los gusanos no se acercan a humanos vivos.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_yum_001518",ch="yum"},
},
ja={
{
" ",
{"rt2"},
" ",
{"rt2"},
"　　　　　　　　　　　　　　　　　　　No pude hacer más que quedarme parada a su lado.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"bg",file="ev_txt_c05_01",time=2000,path=":ev/ev_txt_c05/",set="ev_txt_c05"},
{"text"},
text={
ja={
{
" ",
{"rt2"},
"　　　　　　　　　　　　　　――Una pintura en verano――",	
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="fem_yum_001519",ch="yum"},
},
ja={
{
"Una noche en pleno verano.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_yum_001520",ch="yum"},
},
ja={
{
"Las nubes se mueven sin parar.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_yum_001521",ch="yum"},
},
ja={
{
"La luna se oculta entre las nubes,",
{"rt2"},
"　　　　　　　　　aparece, desaparece, y vuelve a aparecer,",
{"rt2"},
"　　　　　　　　　　　　　　　　　　　　titilando descontroladamente.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_yum_001522",ch="yum"},
},
ja={
{
"De la radio se escucha una y otra vez el pronóstico de un enorme tifón que se\nacerca.",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_yum_001523",ch="yum"},
},
ja={
{
"La mosca se regocijó ante aquella tormenta nocturna.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_yum_001524",ch="yum"},
},
ja={
{
"Seguramente el tifón se lo llevará todo.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_yum_001525",ch="yum"},
},
ja={
{
"El fuerte viento destrozará todo lo que hay dentro de ese agujereado domo,\ny acabará como si nada con el dibujo de tiza de los dos.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_yum_001526",ch="yum"},
},
ja={
{
"Los gusanos dentro de mí se revuelven, excitados.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="fem_yum_001527",ch="yum"},
},
ja={
{
"El viento toma fuerza.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_yum_001528",ch="yum"},
},
ja={
{
"Las nubes corren por la noche de verano, rápidas y ligeras.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_yum_001529",ch="yum"},
},
ja={
{
"No pude esperar a que llegara la hora, así que me fui de una vez allá.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_yum_001530",ch="yum"},
},
ja={
{
"A los juegos de chatarra ocultos en el bosque.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_yum_001531",ch="yum"},
},
ja={
{
"Y allí estaba, frente al domo erigido en el centro de toda la chatarra.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"ex",time=500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",y=200,file="zbg081i",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_yum_001532",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hikawa-san...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_rna_001467",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_yum_001533",ch="yum"},
},
ja={
{
"Hikawa-san se quedó parada, sin poder decir nada.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="fem_yum_001534",ch="yum"},
},
ja={
{
"Sin entender el motivo de su silencio, lo único que pude hacer fue ir hacia\ndonde estaba ella parada.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_yum_001535",ch="yum"},
},
ja={
{
"Y en el instante que llegué a su lado,\nvi un montón de flores que habían florecido dentro del domo.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_yum_001536",ch="yum"},
},
ja={
{
"Daba la ilusión de que estábamos en medio de un ventarrón de primavera.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="fem_yum_001537",ch="yum"},
},
ja={
{
"El muchacho, quien estaba al fondo del domo, volteó, con tiza en mano.\nEstaba allí, como aparecido de un remolino de flores...",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"bg",file="zev_com_d02_01",speed=30000,path=":ev/ev_com_d02/",set="ev_com_d02",x2=960,y2=-170,x=830,y=-170,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm105"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta noche de tormenta",
{"rt2"},
"　　　　　　　　　　　me pareció perfecta.",
{"rt2"},
"　　　　　　　　　　　　　　――Pensé que era buen momento para colocarle ya las flores.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_yum_001538",ch="yum"},
},
ja={
{
"Eso dijo el artista de los cerezos.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_rna_001468",ch="rna"},
},
ja={
{
name={"Rina"},
"“... N-No eran estrellas...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"bg",file="ev_com_d02_01",path=":ev/ev_com_d02/",set="ev_com_d02"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así es. Todo lo que está aquí pintado son pétalos de cerezos.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás sea difícil que lo notes ahora, pero en este lugar hay bastantes árboles\nde cerezos junto a los cipreses. Cuando comencé a pintar esto las flores de\ncerezo se podían ver por todos lados.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="fem_rna_001469",ch="rna"},
},
ja={
{
name={"Rina"},
"“Es por eso que...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es solo eso. Es que tampoco te queda bien el papel de estrella.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_rna_001470",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿A mí?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No encajan contigo, mocosa, y bien se nota que quieres ser una. A alguien como\ntú le sientan mejor las flores. Y de esas que florecen en primavera.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_rna_001471",ch="rna"},
},
ja={
{
name={"Rina"},
"“La belleza de los cerezos radica en que dan a sentir la muerte donde estén...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hubo un escritor que dijo eso mismo.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero fue gracias a que él vio la muerte en los cerezos que se logró aceptar su\nbelleza con simpleza, con naturalidad.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los cerezos son demasiado radiantes como para dedicárselos a los difuntos.\nSu lugar está con los que aún viven...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"Solo observa, ¿ves toda la energía y vitalidad que tiene el dibujo ahora?\nDiría que es una excelente obra.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_yum_001539",ch="yum"},
},
ja={
{
"Yo no era ninguna experta. No logré entender las partes más minuciosas de su\nobra.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_yum_001540",ch="yum"},
},
ja={
{
"Pero sí pude darme cuenta de que en la obra de ese muchacho llamado Naoya\nKusanagi había mucha más luz que en la de Hikawa-san. Y que esa misma luz\nhacía aún más profunda la oscuridad del cielo nocturno que había pintado con\ntiza.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_yum_001541",ch="yum"},
},
ja={
{
"La obra de Hikawa-san se concentra en el uso de las sombras para describir un\nprofundo abismo. Pero este tipo logró hacer de ese abismo algo aún más\nprofundo como si nada, solo usando luz.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_yum_001542",ch="yum"},
},
ja={
{
"Yendo directo al grano, la temática original, que hacía alusión a la muerte,\nreluce aún más ahora gracias a la vida que se siente en la obra.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_yum_001543",ch="yum"},
},
ja={
{
"Y de igual manera, la vida que hay en ella reluce a la vez gracias a la muerte\nque también se siente.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_yum_001544",ch="yum"},
},
ja={
{
"La magia de la técnica.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="fem_yum_001545",ch="yum"},
},
ja={
{
"Quedé asombrada al ver cómo la técnica puede cambiar de tal magnitud la forma\nde ver las cosas.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_yum_001546",ch="yum"},
},
ja={
{
"Y al mismo tiempo, grité el nombre del muchacho.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? No grites.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿O es que acaso piensas agregarle algo?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="fem_yum_001547",ch="yum"},
},
ja={
{
"Muevo mi cabeza a los lados.\nMis muelas rechinaron unas cuantas veces.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, es tu turno ahora. Yo ya terminé lo que tenía que hacer.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_rna_001472",ch="rna"},
},
ja={
{
name={"Rina"},
"“No... Ya este dibujo está listo...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué lo dices? Aún queda algo de tiempo antes de que llegue el tifón.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="fem_rna_001473",ch="rna"},
},
ja={
{
name={"Rina"},
"“No es cuestión de tiempo.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bg",file="black",path=":bg/"},
{"text"},
text={
vo={
{"vo",file="fem_yum_001548",ch="yum"},
},
ja={
{
"Hikawa-san entra al interior del domo.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_rna_001474",ch="rna"},
},
ja={
{
name={"Rina"},
"“Increíble...”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_rna_001475",ch="rna"},
},
ja={
{
name={"Rina"},
"“Este dibujo es absolutamente maravilloso. Es insuperable.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_rna_001476",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y por eso, es que ya está listo.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"bgm",stop=1,time=1000},
{"excall",file="03_zypressen_02_6"},
{"text"},
linkback="block_00170",
},
label = {
top={block="block_00000",label=1},
},
}
