astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg026a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"se",file="se0110",loop=1,id=1},
{"text"},
text={
ja={
{
"... Había un letrero puesto.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"A pesar de que hasta hace poco era solo un terreno desocupado...",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"En el letrero decía únicamente 'Prohibida la entrada a personal no autorizado'.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De verdad vendieron... este terreno.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"El terreno vacío estaba rodeado por unas simples vallas.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"No es completamente imposible que una persona entre.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Sin embargo, dentro de poco se levantarán unos rígidos muros de hierro\nalrededor que impedirán la entrada a personas ajenas, y la construcción\ncomenzará.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Las memorias que deben ser borradas...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Así como hay memorias que deben permanecer, también hay memorias que deben ser\nborradas.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Eso es algo obvio.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Salto la valla y entro al terreno desocupado.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"msgoff"},
{"bg",file="zbluesky_summer",id=9,lv=9,speed=240000,sync=1,path=":cg/",x2=0,y2=-540,x=0,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"No ha cambiado nada desde que hace 6 años desapareció lo que había aquí.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Ha crecido maleza alrededor.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"En algunas partes habían descuidados restos de lo que una vez fueron árboles de\njardín.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por lo menos esto...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Esparcí los pétalos de flor de cerezo en ese terreno.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Los pétalos que estaban adheridos a las páginas del álbum.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"No son todos, pero por lo menos quería esparcir parte de ellos en este terreno.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"No tengo ninguna razón en mente.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Solo que... probablemente él hubiera hecho lo mismo...",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Aunque solo se trate de una simple ilusión...",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Él hubiera hecho lo mismo que yo.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Por eso es que en este álbum estaban adheridos los pétalos de los cerezos de\nYumenouki.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque aún ahora, no tengo idea alguna de lo que él pensaba en aquel momento...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"cgdel",id=-1},
{"se",stop=1,time=500,id=1},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Me alejo del terreno desocupado.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Seguramente no volveré más nunca a poner mis pies sobre este lugar.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"bgm",stop=1,time=1000},
{"bg",file="bg013a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
"Llego a la estación de Sakuragahara.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"No es que tenía algo que hacer en concreto, pero en los alrededores de\nSakuragahara se pueden conseguir varias cosas sin tener que ir hacia el\ncorazón de la ciudad.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Para las personas que viven por este lugar, es normal comenzar buscando por\nSakuragahara cuando hay alguna cosa que les llama la atención.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Compro las cosas necesarias para mi nueva habitación.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Casi todas las cosas que tenía en el apartamento bastaron, pero habían otros\npequeños objetos que igualmente me hacían falta, como por ejemplo un\nsujetalibros, una lámpara, etc...",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"En el apartamento tengo un enorme estante para libros, y también hay una muy\nbuena lámpara de piso.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Aunque son muy grandes para la habitación que tomé prestada en la casa de los\nNatsume, y resultan más bien inconvenientes.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"bg",file="bg013a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000812",ch="mkd"},
},
ja={
{
name={"???"},
"“Oh, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Toritani? ¿Qué haces aquí? ¿Viniste a comprar materiales para pintar?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fgact",ch="真琴",act="おじぎ",time=800,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0011",head="mak_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000813",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ajajajaja... Podría ser eso en otro caso, pero hoy vine por otro asunto.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por otro asunto?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0003",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000814",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Les brindé el almuerzo a estas dos.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A estas dos?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A quién? ¿Y en primer lugar, tú le brindas comida a los demás?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",mode=-2},
{"fg",ch="小牧",size="z1",mode=3,resize=1,path=":fg/kom/z1/",file="kom_z1a0200",face="a0001",head="kom_z1a",x=-345,lv=4,id=5},
{"fg",ch="小沙智",size="z1",mode=3,resize=1,path=":fg/kos/z1/",file="kos_z1a0200",face="a0001",head="kos_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000815",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por lo menos eso sí lo hago de vez cuando... Esta es Komaki, y esta es Kosachi.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0004",head="kom_z1a",x=-345,lv=4,id=5},
{"fgact",ch="小牧",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000033",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Hola, es un placer conocerte.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0018",head="kos_z1a",x=345,lv=4,id=6},
{"fgact",ch="小沙智",act="おじぎ",size=8,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000060",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Mucho gusto.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Justo cuando pensé que había escuchado esos nombres por algún lado, resulta que\nse trataba de la presidenta del consejo estudiantil y la vicepresidenta.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ambas se parecen de cierta manera, eh.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000816",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, es que Komaki y Kosachi son gemelas.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0003",head="kom_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000034",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, somos las gemelas Komaki y Kosachi.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gemelas, y además presidenta y vicepresidenta.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000817",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es, y por eso es que no puedo hablar de más respecto a estas dos.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0006",head="kos_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0017",head="kos_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_ksd_000061",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“El hecho de que no puedas hablar de más es porque has venido cometiendo varias\nfechorías hasta ahora, ¿no? Si tuvieras una actuación correcta como jefa de\nclub el consejo estudiantil no tendría que meterse de ninguna manera.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000818",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Será verdad eso?...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0004",head="kom_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000035",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“El consejo estudiantil no tiene ninguna autoridad especial. En principio, más\nautoridad tiene el consejo de clubes conformado por cada uno de los jefes de\nclub de Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0015",head="kos_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000062",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“La razón por la cual el consejo estudiantil tiene el ojo puesto sobre ustedes\nes porque hemos recibido una montaña de reclamos por parte del consejo de\nclubes.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000819",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jajajajaja... Parece que tenemos enemigos por todos lados.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0008",head="kom_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000036",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Es muy bueno que actúen siempre con bastante vigor y ánimo, pero deben hacerlo\nsiempre con moderación.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0009",head="kos_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0007",head="kos_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_ksd_000063",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Por otro lado... Quizás no me importe tanto Toritani, pero aun con tantas ganas\nque tenía de que por lo menos expulsaran a Wataru Akashi, viniste a\ninterponerte, Komaki.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0016",head="kom_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000037",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Pero todo fue culpa tuya, Kosachi-chan. Errores son errores.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0005",head="kos_z1a",x=345,lv=4,id=6},
{"fgact",ch="小沙智",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000064",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Jaa, ciertamente, pero... Al hacer eso parecerá que el consejo estudiantil\nencubrió al club de arte.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000820",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Realmente lo siento bastante... Aunque por eso también fue que las invité a\ncomer.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="man_wtd_000240",ch="wtd"},
},
ja={
{
name={"???"},
"“¡Ohh!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"bgm",stop=1,time=1000},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0009",head="kos_z1a",x=345,lv=4,id=6},
{"fgact",ch="小沙智",act="うなづく",size=6,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000065",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Geh...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0004",head="kom_z1a",x=-345,lv=4,id=5},
{"fgact",ch="小牧",act="icon",lv=4,id=5,icon="icon03z1",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000038",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Ah ♪.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"bgm",file="bgm008"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000821",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Akashi-senpai... ¿Qué haces en este lugar?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000241",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Umuh, estuve aprovechando de hablarle a las chicas alrededor mientras hacía mi\npatrulla diaria de la ciudad.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Andabas cazando mujeres?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000242",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Por supuesto que no es eso.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A eso que haces le llaman cazar mujeres...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="明石",act="いいえ",size=4,lv=4,id=9},
{"fg",ch="明石",size="z1",ex02="b0098",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0008",head="aka_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000243",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Por qué preguntarle a una chica '¿Cómo estás?', '¿No te gustaría ir a algún\nlugar?' implica que ando cazando mujeres? Mmmm, Toritani, ¿qué piensas al\nrespecto?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000822",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pienso que eres un idiota, senpai.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000066",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Igual que siempre, eh... Wataru.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000244",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Oh, pero si también estaba Kosachi. ¿Cómo andas?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000067",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Hasta hace un rato estaba bien... Pero ahora que viniste, se me fueron los\nánimos por el piso.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000245",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ya veo, ¿quieres que te dé algo de este medicamento para la gripe? Me dieron\nbastantes en la farmacia.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por Dios, ¿pero cuántas muestras te robaste?...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000068",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“No tengo ninguna gripe. Aunque ciertamente, me duele la cabeza. Por lo de\nayer... Por no haber podido expulsarte...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",ex03="a0097",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000246",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Um, en lo que eso respecta yo estoy libre de todo cargo. Es Toritani quien\ntiene toda la culpa.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000823",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Akashi-senpai, ¿es que acaso no eres capaz de proteger a tus kouhais?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_ksd_000069",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Jaa, realmente me das vergüenza.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000039",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Pero no debes causarle muchas molestias a los demás.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0008",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000247",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Aunque no le he causado molestias a nadie, eh.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Akashi y las gemelas hablan con bastante familiaridad.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Parecen incluso hablar con más familiaridad que cuando lo hace con Toritani...\n¿Será que se conocen desde hace bastante tiempo?...",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Sin embargo, había escuchado que Toritani también conocía a estas gemelas desde\nhace tiempo...",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"¿Por qué las gemelas que presiden el consejo estudiantil en los cargos de\npresidencia y vicepresidencia son conocidas de Akashi, el mayor alborotador\nque ha pasado por Yumihari?...",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",mode=-2},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0011",head="kom_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000040",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Aunque si llegamos a recibir una queja más del consejo de estudiantes, ya no\npodremos cubrirte más las espaldas.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000248",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Vamos, no digas eso, Komaki. Eres una de mis pocas parientes, nunca está de más\nalgo de favoritismo.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_kmd_000041",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Eso no está bien. No puedes pensar en aprovecharte de tus parientes.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",mode=-2},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"¿No acaba de decir algo?...",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",mode=-2},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0006",head="kom_z1a",x=-345,lv=4,id=5},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0001",head="kos_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0018",head="kom_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_kmd_000042",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Onii-chan, parece que piensas que Komaki resolverá todos tus problemas\npidiéndole favores, pero Komaki es la presidenta del consejo estudiantil, así\nque no puedo permitir esa clase de actos injustos.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0010",head="kos_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0008",head="kos_z1a",x=345,lv=4,id=6},
{"fgact",ch="小沙智",act="おじぎ",time=800,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_ksd_000070",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Por Dios, no puedo contener la tristeza de pensar de que comparto la misma\nsangre que tú... Jaa, si es por tener hermanos me bastaba nada más con\nKomaki.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"¿Onii-chan?",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"¿Compartir la misma sangre?",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="man_wtd_000249",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Unuh, pero qué humillación. ¿Cómo vas a dirigirte de esa manera al próximo jefe\nde la familia Akashi?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0006",head="kos_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000071",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Jefe, tú?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"bgm",stop=1,time=300},
{"se",file="se3130",id=1},
{"quake"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ehhh!”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0013",head="kom_z1a",x=-345,lv=4,id=5},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0013",head="kos_z1a",x=345,lv=4,id=6},
{"fgact",ch="小沙智",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000072",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Eh? ¿Qué sucede? ¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“U-ustedes... No acaban... ¿No acaban de llamar a Akashi 'onii-chan'?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"bgm",file="bgm007"},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0004",head="kom_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000043",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, Wataru Akashi es el hermano de Komaki y Kosachi.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¡EHHHHHHH!!”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0006",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000250",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Qué pasa, Naoya? ¿Por qué la sorpresa?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿D-De verdad nacieron de los mismos genes?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fgact",ch="明石",act="いいえ",time=500,lv=4,id=9},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0005",head="aka_z1b",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000251",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Qué pasa, qué pasa? Por más atolondradas que sean mis hermanitas, ¿no te\nparece un poco cruel decir eso? Quizás no me lleguen a los pies, pero aun así\ntienen bastante aptitud.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es absolutamente obvio que entre los 3, el atolondrado eres tú...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",mode=-2},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0010",head="kom_z1a",x=-345,lv=4,id=5},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0001",head="kos_z1a",x=345,lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0009",head="kom_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_kmd_000044",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Por otro lado, no sabía que onii-chan había repetido el año. Juraba que había\naprobado los exámenes de reparación al ver cómo mamá lo encerró en la casa\npara que estudiara.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0010",head="kos_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000073",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Yo pensaba que ya se había graduado. Jamas se me ocurrió que aún estaba\nrecibiendo exámenes suplementarios...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Por qué no sabías? Son familia, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0005",head="kos_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000074",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Por qué debería saberlo? En la casa trato siempre de no involucrarme con este\ntipo.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero aun así todas las mañanas salía con el uniforme puesto, así que era de\nimaginarse...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0008",head="kom_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000045",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Lo que sucede es que desde hace mucho tiempo, onii-chan siempre anda vestido\ncon uniforme, incluso en la casa. Por eso, independientemente de si se\ngraduara o no, me parecía normal que llevara uniforme en todo momento...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero qué rayos...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fgact",ch="小沙智",act="icon",x=10,lv=4,id=4,icon="icon14z1",y=-225},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0015",head="kos_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000075",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Ni siquiera usa pijama... Será idiota.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="man_wtd_000252",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡El uniforme del colegio es para mí el uniforme de la vida!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa... ¿Qué clase de patrañas sin sentido andas escupiendo como si fuera la\ngran cosa?...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0011",head="kos_z1a",x=345,lv=4,id=4},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000076",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Fuu... Aun cuando pensaba que ya no tendría que verte la cara en el colegio...”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0017",head="kom_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000046",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Onii-chan, ¿este año planeas hacer muchas cosas que ameriten llamarte a la sala\ndel consejo estudiantil?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="man_wtd_000253",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Pues aún no he definido mis planes, pero si me llamas yo siempre apareceré\nfrente a ti, Komaki. Pues esa es la condición esencial y necesaria de un\nhéroe, nya~”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0007",head="kos_z1a",x=345,lv=4,id=4},
{"fgact",ch="小沙智",act="びっくり",lv=4,id=4},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0006",head="kos_z1a",x=345,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_ksd_000077",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Eso es porque haces cosas por las cuales tiene que llamarte! ¡Komaki no te\nconvoca a la sala por simple gusto!”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000254",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Jajajaja, Kosachi, aún eres muy joven para entenderlo, pero Komaki me llama\nsiempre por gusto.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0007",head="kos_z1a",x=345,lv=4,id=4},
{"fgact",ch="小沙智",act="icon",lv=4,id=4,icon="icon05z1",x=40,y=-550},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0006",head="kos_z1a",x=345,lv=4,id=4},
},
},
text={
vo={
{"vo",file="fem_ksd_000078",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Idiota! ¡Te llaman siempre por andar causando problemas! ¡De ninguna manera\nKomaki te quiere!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0006",head="kos_z1a",x2=345,x=0,lv=4,id=4},
{"se",file="se0744",id=1,vol=50},
{"ex",time=0,func="wait"},
{"se",stop=1,id=1,time=500},
{"se",file="se9010",id=2},
{"fg",mode=-2,sync=0},
{"bg",file="bg013a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="小牧",size="z2",mode=3,resize=1,path=":fg/kom/z2/",file="kom_z2a0200",face="a0010",head="kom_z2a",lv=5,id=5,sync=0},
{"fgact",ch="小牧",act="icon",lv=5,id=5,icon="icon12z2",x=50,y=-550,sync=0},
{"extrans",time=500},
{"fgact",ch="小牧",act="いいえ",time=600,lv=5,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z2",mode=3,path=":fg/kom/z2/",file="kom_z2a0200",face="a0009",head="kom_z2a",lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_kmd_000047",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Awawa, eso duele, Kosachi-chan... Si me abrazas tan fuerte me aplastarás.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",mode=-2},
{"fg",ch="小牧",size="z1",mode=3,resize=1,path=":fg/kom/z1/",file="kom_z1a0200",face="a0009",head="kom_z1a",x=-345,lv=4,id=5},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0013",head="kos_z1a",x=210,lv=4,id=8},
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0013",head="kos_z1a",x2=210,x=345,lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000079",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡Ah, lo siento!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0011",head="mak_z1b",x=-570,lv=4,id=3},
{"fg",ch="小牧",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0009",head="kom_z1a",x2=-345,x=0,lv=4,id=5},
{"fg",ch="小沙智",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0013",head="kos_z1a",x2=345,x=570,lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000824",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuu, veo que ni siquiera Kosachi puede controlar a Akashi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0010",head="kos_z1a",x=570,lv=4,id=8},
{"fgact",ch="小沙智",act="おじぎ",time=1000,lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000080",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Personalmente, eres igual de incontrolable que Akashi para mí, Makoto...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0013",head="mak_z1d",x=-570,lv=4,id=3},
{"fgact",ch="真琴",act="びっくり",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000825",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Soy igual a Akashi-senpai?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0008",head="kom_z1a",x=0,lv=4,id=5},
{"fgact",ch="小牧",act="うなづく",time=500,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000048",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, por lo general recibimos quejas sobre ti del consejo de estudiantes, con la\nmisma frecuencia que él.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0007",head="mak_z1d",x=-570,lv=4,id=3},
{"fgact",ch="真琴",act="びっくり",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0009",head="mak_z1a",x=-570,lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000826",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué yo? Alguien está tratando de conspirar contra mí, difamándome.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0017",head="kos_z1a",x=570,lv=4,id=8},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000081",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Nadie está conspirando contra ti...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás cosechando lo que sembraste.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="真琴",mode=-1,lv=4,id=3},
{"fg",ch="小沙智",mode=-1,lv=4,id=8},
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0017",head="kom_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_kmd_000048b",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Por otro lado... Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0010",head="kom_z1a",x=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0006",head="kom_z1a",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_kmd_000049",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“He oído que tú también causas problemas frecuentemente. Si te sobrepasas\nhaciendo ese tipo de cosas podríamos tener que llamarte en cualquier momento.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, escuchen, en mi caso... yo sí soy inocente...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque... El hecho de que sean hermanas de Akashi significa que...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0003",head="kom_z1a",x=0,lv=4,id=5},
{"fgact",ch="小牧",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="小牧",speed=500,mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0003",head="kom_z1a",x2=0,x=-345,lv=4,id=5},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0001",head="kos_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_kmd_000050",ch="kmd"},
},
ja={
{
name={"Komaki"},
"“Sí, yo soy Komaki Akashi, y esta es Kosachi Akashi. Espero que podamos\nllevarnos bien de ahora en adelante.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, debe ser bastante extenuante para ti tener a dos hermanos mayores tan\nintensos como Wataru y Kosachi.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="小牧",size="z1",mode=3,path=":fg/kom/z1/",file="kom_z1a0200",face="a0002",head="kom_z1a",x=-345,lv=4,id=5},
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0018",head="kos_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000083",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¿Qué? Tú, no me pongas al mismo nivel que Wataru.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0006",head="kos_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000084",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Además, Komaki no es mi hermanita, es mi hermana mayor. Ella es Komaki\nonee-chan, ¿te quedó claro?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te comportas de manera arrogante, así que pensé que tú eras la hermana mayor,\nKosachi.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0009",head="kos_z1a",x=345,lv=4,id=6},
{"fgact",ch="小沙智",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000085",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Yo no soy arrogante.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0006",head="kos_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="小沙智",size="z1",mode=3,path=":fg/kos/z1/",file="kos_z1a0200",face="a0017",head="kos_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_ksd_000086",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“Aunque te advierto que si llegas a ponerle las manos encima a Komaki\nonee-chan, usaré todas mis influencias y poder para llevarte a la expulsión.\n¿Te ha quedado claro, Naoya Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Tan rápido y ya dejó de llamarme con honorífico.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0003",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000255",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Si llegas a hacerle algo a Komaki y a Kosachi, no creas que me quedaré\ncallado, eh. Dependiendo de lo que suceda, no solamente podría hacer uso de\nla violencia, sino que también podría exigirte que tomes responsabilidad al\nrespecto, que no se te olvide.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ohhh, así que tú también puedes hablar como un hermano mayor...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000256",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Si llega a sucederte algo, yo también tendré la responsabilidad de asumir la\nherencia de Kenichiro Kusanagi, así que ten cuidado.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No hace falta tener cuidado, yo no tengo ni un centavo de la herencia de\nKenichiro Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No deberías ser tú el que mejor sabe eso?...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"quake",mode="mw"},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000257",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡¿Qué dices, imbécil?! ¡Justo ahora que pisoteaste la pureza de mis\nhermanitaaasss! ¡¿Y dices ahora que no hay herencia?!”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"se",file="se3130",vol=70,id=1},
{"bg",y=-230,speed=300,sync=0,file="zbg013a",path=":bg/",x2=-760,y2=-230,x=-960,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="小沙智",size="z2",speed=300,sync=0,mode=3,resize=1,path=":fg/kos/z2/",file="kos_z2a0200",face="a0006",head="kos_z2a",x2=200,x=0,lv=5,id=6},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_ksd_000087",ch="ksd"},
},
ja={
{
name={"Kosachi"},
"“¡¿Qué dices?! ¡¡Tú!! ¡¿Le hiciste algo a Komaki?!”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Por supuesto que NO!”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",mode=-2,sync=0},
{"bg",file="bg013a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0016",head="mak_z1b",lv=4,id=3,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000827",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, eres de temer, eh... No pensé que ya estuvieras haciendo eso, a pesar\nde apenas haberla conocido hoy.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todos ustedes... tienen que ser idiotas...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg014a",path=":bg/",sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=3,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm004"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aún no puedo creer que esas dos sean las hermanitas de Akashi.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fgact",ch="真琴",act="うなづく",lv=4,id=3},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0022",head="mak_z1a",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000828",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí. Aunque bueno, aunque sean hermanos, eso no significa que deban\nparecerse. En particular, sus personalidades.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, incluso Komaki y Kosachi tienen personalidades totalmente distintas una\nrespecto a la otra... Pero Akashi es...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000829",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... Aunque, da algo de risa el solo pensar que esos tres viven en la misma\ncasa.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te da risa eso?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0012",head="mak_z1d",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000830",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, tengo que hacer algo en esta tienda.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La tienda de instrumentos de pintura?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0003",head="mak_z1d",lv=4,id=3},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",lv=4,id=3},
},
},
text={
vo={
{"vo",file="fem_mkd_000831",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Tengo algunas cosas que comprar, así que me quedo acá.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000832",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vale, nos vemos mañana en el colegio.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"msgoff"},
{"fg",ch="真琴",sync=1,mx=40,mode=-1,lv=4,id=3},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mañana... en el colegio... eh.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Después de despedirnos de los Akashi, caminé por un rato con Toritani.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"No tenía nada en particular qué hacer, pero... de alguna u otra manera terminé\nacompañándola caminando...",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Terminé llegando a este lugar sin ningún propósito en particular...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué debería hacer ahora?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Bueh, lo más razonable sería regresar a la casa Natsume...",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"bgm",stop=1,time=1000},
{"se",file="se9004",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",stop=1,time=500,id=1},
{"ex",time=800,func="wait"},
{"bg",speed=120000,rule=139,vague=40,file="zbg016b",path=":bg/",x2=590,y2=-20,x=250,y=-20,ax=1920,ay=1126,bx=-960,by=-586},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“La costa Hinayumi... Tiempo sin venir acá.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"En esta ciudad se puede ver el mar desde cualquier lugar.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Un mar que siempre se puede ver.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Quizás es justamente por eso que nunca vengo a la costa...",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué habré venido hasta la costa?...”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"El sol vespertino se hunde en el horizonte...",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Supongo que de vez en cuando sucede esto...",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Aunque no se le puede llamar 'hermosa' a esta línea costera, ni siquiera como\ncumplido.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Esta costa con vista tan particularmente rara es una costa artificial,\nconstruida hace más de diez años, usando un gran cargamento de arena traído\nhasta acá.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Pero realmente es algo que no tiene caso saber...",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Según lo que dicen los ancianos que viven por este lugar, parece que hasta el\ninicio de la guerra el mar llegaba hasta los alrededores de la estación\nSakuragahara.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Hasta la colina de cerezos que se observa desde acá... El mar se extendía hasta\njustamente debajo de la colina de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Gran parte de esta ciudad era, en principio, mar...",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"bg",file="bg016b",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"¿Será por eso?...",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Me da la impresión de que esta costa se me hizo bastante hermosa cuando la\ncaminé con mamá.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"La arena era totalmente blanca... y el mar, azul...",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Tengo esos recuerdos.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Quizás para esa época fue cuando se creó esta costa artificial...",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"O tal vez...",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Quizás estoy idealizando y embelleciendo las memorias que viví junto a mi\nmadre...",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"La palabra 'hermoso' no encaja de ninguna manera con el paisaje de la costa\nHinayumi que estoy caminando en este momento.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Arena turbia.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"Mar turbio.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"En la playa, donde de manera vaga se estaba poniendo el sol, hay una\nacumulación de espuma de aspecto sucio en el agua.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Camino sin cesar por esta costa artificial.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Más adelante está el Parque Costero Hinayumi, el cual forma una colina.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Es el lugar donde está el bosque de cerezos donde fue cremado Kenichiro\nKusanagi.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"bg",file="bg033b",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
"Subo las escaleras desde el lado de la playa.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Desde la colina formada por el Parque Costero Hinayumi se puede contemplar\nenteramente la playa de Hinayumi.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"A pesar de lo horrenda que se veía la playa al caminarla de cerca, al\nobservarla desde esta altura, se ve bastante hermosa, teñida por el sol\nvespertino.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"A veces, nos damos cuenta por primera vez de la belleza de las cosas al\nalejarnos de ellas.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo que... ya se acerca la hora de que las flores de cerezos caigan.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Entro al parque.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Los árboles de cerezo, ya a punto de dejar caer sus flores, están erectos de\nmanera alineada.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"bg",file="bg036b",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Al avanzar por el parque, mis alrededores se transforman en el bosque de\ncerezos.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Al subir aún más, está el crematorio municipal.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Camino sin cesar por ese camino.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"bgm",stop=1,time=1000},
{"se",id=1,file="se0728"},
{"bg",rule=104,time=500,file="white",path=":bg/"},
{"text"},
text={
ja={
{
"El sonido del viento.",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Por un momento, pensé que algo había sido secuestrado, de nuevo, por ese sueño\nde cerezos――",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"El fuerte viento se detuvo en un instante.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Y el crujido de los árboles dejó de escucharse.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"bg",file="ev_com_a29_01",time=1500,path=":ev/ev_com_a29/",set="ev_com_a29"},
{"bgm",file="bgm105"},
{"text"},
text={
ja={
{
"Era justo como el aspecto contrario de aquel atardecer en la colina de\nYumenouki.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Sin embargo, este no es ese bosque de cerezos.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Es solo el parque municipal donde Kenichiro Kusanagi fue cremado.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"No hay ningún misterio ni enigma.",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Y aun así...",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Ai y el bosque de cerezos.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"La figura de Ai observando las flores de cerezo cayendo.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Ahora a lo lejano, inalcanzables.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Los pétalos de flores de cerezo, absorbidas por esa lejanía.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Vuelan ahora hacia el cielo eterno.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"bg",file="ev_com_a29_02",sync=0,face=1,time=400,path=":ev/ev_com_a29/",set="ev_com_a29"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000380",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿K-Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ai.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="fem_aid_000381",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿P-Por qué estás aquí?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... pura casualidad... ¿Y tú?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="fem_aid_000382",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Y-Yo--!”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Por alguna razón, los ojos de Ai están completamente enrojecidos.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"bg",file="ev_com_a29_01",sync=0,face=1,time=400,path=":ev/ev_com_a29/",set="ev_com_a29"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000383",ch="aid"},
},
ja={
{
name={"Ai"},
"“No es tanto... solo que, al correr con la motocicleta me di cuenta de lo\nhermoso que estaba el sol del atardecer...”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El sol vespertino...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_aid_000384",ch="aid"},
},
ja={
{
name={"Ai"},
"“Es bastante inesperado... que nos encontremos acá, ¿no?...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
vo={
{"vo",file="fem_aid_000385",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"bg",file="ev_com_a29_01",sync=0,face=1,time=400,path=":ev/ev_com_a29/",set="ev_com_a29"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000386",ch="aid"},
},
ja={
{
name={"Ai"},
"“Hoy es el fin para este bosque de cerezos... así que quizás no fue casualidad,\nni nada inesperado...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos dices?”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
vo={
{"vo",file="fem_aid_000387",ch="aid"},
},
ja={
{
name={"Ai"},
"“No, no es nada... no es nada...”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pareciera que...”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pareciera mentira que el funeral fue hace poco, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
vo={
{"vo",file="fem_aid_000388",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí... tienes razón. Pareciera algo del pasado, bastante lejano.”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, algo así...”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="fem_aid_000389",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí... Los cerezos caen... y la primavera terminará...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
name={"Naoya"},
"“El fin de la primavera...”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Al final, veo un espejismo de flores de cerezo cayendo como la nieve de\nprimavera.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
vo={
{"vo",file="fem_aid_000390",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No... no es nada...”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, ¿será que regresamos ya?...”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A la casa Natsume.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
vo={
{"vo",file="fem_aid_000391",ch="aid"},
},
ja={
{
name={"Ai"},
"“Umuh.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"bg",file="reco",id=9,lv=9,path=":sys/"},
{"text"},
text={
ja={
{
"El fin de la primavera.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
"La estación en la cual nos despedimos de Kenichiro Kusanagi llega a su fin.",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"Las flores de cerezo caen...",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
"Y entonces, la lluvia humedece el aire...",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
"El verano se acerca.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"eval",exp="g.clear_1=1"},
{"bgm",stop=1,time=4000},
{"se",stop=1,id=-1,time=4000},
{"vostop",stop=1,time=4000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=4000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"cgdel",id=-1},
{"excall",file="02_abend_01_1"},
{"text"},
linkback="block_00264",
},
label = {
top={block="block_00000",label=1},
},
}
