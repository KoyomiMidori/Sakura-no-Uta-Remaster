astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"bg",file="eveningsky_summer",id=8,lv=8,rule=139,sync=1,vague=40,path=":cg/"},
{"ex",time=500,func="wait"},
{"bg",file="nightsky_summer",id=9,lv=9,sync=1,path=":cg/"},
{"ex",time=1000,func="wait"},
{"text"},
text={
ja={
{
"Unas horas después, el sol comenzó a ponerse y la oscuridad se asomaba poco a\npoco en la habitación.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Dejamos atrás la oscurecida habitación y salimos.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"El lugar estaba a 20 minutos de casa.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que todo inició acá...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063c",path=":bg/",sync=0},
{"extrans",time=500},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"bgm",file="bgm003"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001731",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Acá comenzó todo...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0010",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001732",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y no solo en el sentido de que acá Rin pintó los cerezos milenarios. En este\nlugar comenzó también la leyenda de Hakuki...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Y bien, qué ha pasado con los cerezos milenarios que Rin revivió?",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001733",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Igual que entonces... siguen ahí, pero aún sin forma completa. En un caso\nnormal, no serían capaces de producir ningún milagro.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Me estás insinuando que hay la posibilidad de que sí produzcan uno?",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0009",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001734",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Sí, o al menos hasta que 'Las huellas de los cerezos' deje de ser algo novedoso\ny se convierta en una obra cualquiera... aunque, siempre hay la posibilidad\nde que resuene con los sentimientos de alguien.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Quieres decir que 'Las huellas de los cerezos' sí tiene el poder para hacer\neso?",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0009",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001735",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Me baso meramente en el precedente de Rin y los cerezos milenarios que pintó\nella...",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pues si Rin pudo dibujar los cerezos milenarios, eso quiere decir que hay una\nbuena posibilidad de que estos florezcan, ¿no?",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001736",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Creo que no. Es muy baja la posibilidad.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"Se supone que florecen al resonar con los sentimientos de alguien, ¿no? Si son\ncapaces de afectar a la ciudad entera, pues... no sé qué tanta fuerza habría\nen ese acumulado, pero eso aumentaría la posibilidad de que ocurriera, ¿o no?",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001737",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Por más fuertes que sean los sentimientos de cada uno de los habitantes de la\nciudad, no hay manera de que haya resonancia. Los milagros no ocurren así de\nsimple...",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0009",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001738",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Pero, si esos fuertes sentimientos vinieran de alguien involucrado con la\nobra...",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Alguien involucrado con 'Las huellas de los cerezos'?",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0010",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001739",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Muchos sentimientos complicados se cruzaron entre sí en la creación de esa\nobra.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Sentimientos complicados? ¿Eh, es en serio?",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001740",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Sí. Probablemente ese día, todos los que participaron en la creación de esa\nobra sentían, cada uno, algo distinto... Esa obra no nació solo por mero\nespíritu creativo.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0017",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001741",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Y debo decir que muchos de esos sentimientos entrecruzados, van dirigidos a\nti...",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿A-A mí? No puede ser, esa obra le pertenece a Akashi, ¿no?",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001742",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Sí, la obra efectivamente es de él... Pero es tu presencia lo que llevó a\nproducir esos complicados sentimientos.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿P-Por qué yo?...",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0005",head="shz_z1a",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001743",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Naoya, ¿es que acaso no te has dado cuenta?",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿D-De qué?...",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001744",ch="szd"},
},
ja={
{
name={"Shizuku"},
"De lo que sienten todas esas chicas por ti...",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"P-Pues, mucho ha ocurrido en el pasado... Supongo que cada quien tendrá algo\ndistinto en el corazón...",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0005",head="shz_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001745",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Tal cual.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0003",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001746",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Pero todos esos sentimientos cruzándose en la obra convergen, al final, al\nsentimiento de 'diversión'... Es por eso que la obra en sí es bella, y tiene\nun toque de diversión.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001747",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Habiendo sido creada con todos esos alegres sentimientos, dudo mucho que la\nobra sea capaz de crear milagros a partir de malos sentimientos... pero, si\nen los sentimientos de las personas involucradas en la obra hubiese algo de\nmala naturaleza...",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"Los cerezos milenarios podrían volver a florecer...",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"bgm",stop=1,time=500},
{"text"},
text={
vo={
{"vo",file="fem_sud_000555",ch="sud"},
},
ja={
{
name={"???"},
"Así es.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Esa voz--!",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0013",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001748",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Es Sui.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="吹",size="z1",mx=-40,mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0000",face="a0003",head="sui_z1a",x=-345,lv=4,id=10},
{"fg",ch="雫",speed=500,mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0013",head="shz_z1b",x2=0,x=345,lv=4,id=9},
{"se",file="se9010",id=1},
{"bgm",file="bgm038"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000556",ch="sud"},
},
ja={
{
name={"Sui"},
"Buenas noches para ti, Shizuku.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0003",head="shz_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001749",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Hola.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya está bien con los saludos, ¿es cierto lo que acabas de decir? ¿En verdad hay\nla posibilidad de que florezcan los cerezos milenarios?",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0011",head="sui_z1a",x=-345,lv=4,id=10},
{"fgact",ch="吹",act="おじぎ",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_sud_000557",ch="sud"},
},
ja={
{
name={"Sui"},
"De que la hay la hay, sí...",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0002",head="sui_z1a",x=-345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_sud_000558",ch="sud"},
},
ja={
{
name={"Sui"},
"Pero no hay nada de qué preocuparse.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Por qué?",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0017",head="shz_z1b",x=345,lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001750",ch="szd"},
},
ja={
{
name={"Shizuku"},
"No hay indicio alguno de que eso esté por suceder.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0003",head="sui_z1a",x=-345,lv=4,id=10},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_sud_000559",ch="sud"},
},
ja={
{
name={"Sui"},
"Así es. Yo puedo ver los colores en los lazos de causalidad. Si algo indicara\nque están por florecer, me daría cuenta de inmediato.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0011",head="sui_z1a",x=-345,lv=4,id=10},
{"fgact",ch="吹",act="おじぎ",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_sud_000560",ch="sud"},
},
ja={
{
name={"Sui"},
"Y, además... hay otro detalle que te debería aliviar aún más.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Otro detalle que me debería aliviar?",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",x=-345,lv=4,id=10},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0009",head="shz_z1b",x=345,lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001751",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Sí. Es posible que, si en algún momento llegaran a florecer los cerezos, sería\nsin duda alguna, por algo concerniente a ti.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Eh? ¡¿Concerniente a mí?!",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0003",head="shz_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001752",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Sí, así que no debes preocuparte.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"E-Espera un momento, ¿me dices que sería algo concerniente a mí y me pides que\nno me preocupe? Eso significa que si hago algo mal podrían florecer, ¿sabes?",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0004",head="shz_z1b",x=345,lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0003",head="shz_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001753",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Por eso mismo lo digo. Sé que aun si ocurriera un mal milagro, tú serías capaz\nde guiarlo por el buen camino...",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Y-Yo? ¿Por el buen camino? No, no, ¿cómo esperas que pueda hacer algo frente a\nesa cosa sobrenatural?",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0002",head="shz_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001754",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Los cerezos milenarios son, ciertamente, algo similar a un fenómeno\nsobrenatural. Pero son los corazones de las personas los que le dan forma.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0003",head="sui_z1a",x=-345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_sud_000561",ch="sud"},
},
ja={
{
name={"Sui"},
"Si guías ese milagro por el buen camino no ocurrirá error alguno, Kusanagi-san.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿P-Pero, cómo podría yo hacer eso?",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",x=-345,lv=4,id=10},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0003",head="shz_z1b",x=345,lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0002",head="shz_z1b",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_szd_001755",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Puedes hacerlo. Siempre lo has hecho. Desde hace un buen tiempo has venido\nsalvando a los corazones de muchos, llevándolos por el buen camino.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0017",head="shz_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001756",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Una vez pude verte usando el poder de Rin. Solo un instante.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0008",head="shz_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001757",ch="szd"},
},
ja={
{
name={"Shizuku"},
"En ese momento, entendí por fin por qué Rin te llamaba 'El artista de los\ncerezos'.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0002",head="shz_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001758",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Siempre has atraído muchas personas a ti. Como si de alguna forma pudieras\nenlazar los sentimientos de todos ellos. Tienes un color similar al de la luz\nde la causalidad enlazada.",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0003",head="shz_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001759",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Similar al brillo de las estrellas, y también similar a los cerezos que\nrecubren el cielo con sus pétalos.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",x=-345,lv=4,id=10},
{"fgact",ch="吹",act="おじぎ",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0016",head="sui_z1a",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_sud_000562",ch="sud"},
},
ja={
{
name={"Sui"},
"Así es Kusanagi-san, sí. Aunque todavía le falta mucho que aprender en lo que a\npintura se refiere.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"Déjame en paz.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0011",head="sui_z1a",x=-345,lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_sud_000563",ch="sud"},
},
ja={
{
name={"Sui"},
"Aunque, pintar no es solo cuestión de técnica. Ni tampoco únicamente de\ntalento. Y creo que el encanto que tienes como persona te da, efectivamente,\nvalor como artista.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0001",head="shz_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001760",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Solo donde el genio es fino, puede verse el talento. Genio es lo que nos hace\nolvidar el talento.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0003",head="shz_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001761",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Eso es lo que Kei nii-san dice siempre, elogiándote...",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"Jaa, me estás poniendo muy por encima de lo que realmente soy...",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0016",head="shz_z1b",x=345,lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001762",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Eso crees?",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0016",head="sui_z1a",x=-345,lv=4,id=10},
{"fgact",ch="吹",act="おじぎ",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_sud_000564",ch="sud"},
},
ja={
{
name={"Sui"},
"Yo no diría eso.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Sui y Shizuku sonrieron juntas.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"Cambiando de tema, Shizuku, ¿no deberíamos pedirle permiso ahora que está?",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0012",head="shz_z1b",x=345,lv=4,id=9},
{"fgact",ch="雫",act="びっくり",size=10,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001763",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Ah, cierto... Sui, hay algo que debo preguntarte.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0012",head="sui_z1a",x=-345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_sud_000565",ch="sud"},
},
ja={
{
name={"Sui"},
"¿A Sui?",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0008",head="shz_z1b",x=345,lv=4,id=9},
{"fgact",ch="雫",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001764",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Sí. ¿Puedo contarle a Naoya de nuestro pasado?",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0011",head="sui_z1a",x=-345,lv=4,id=10},
{"fgact",ch="吹",act="おじぎ",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0008",head="sui_z1a",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_sud_000566",ch="sud"},
},
ja={
{
name={"Sui"},
"¿Hacía falta que me lo preguntaras? Nunca he pretendido hacerlo un secreto...",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0009",head="shz_z1b",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001765",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Sui, también te falla la memoria de lo que ocurrió en el pasado, ¿verdad?",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0010",head="sui_z1a",x=-345,lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0011",head="sui_z1a",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_sud_000567",ch="sud"},
},
ja={
{
name={"Sui"},
"Pues sí. Aunque, gracias a los pétalos de cerezos milenarios guardados en el\nálbum de Rin que fueron esparcidos en ese terreno, pude aparecer de nuevo.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Eh? Espera, ¿fueron los pétalos que esparcí allá lo que te hicieron regresar?",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0002",head="sui_z1a",x=-345,lv=4,id=10},
{"fgact",ch="吹",act="うなづく",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_sud_000568",ch="sud"},
},
ja={
{
name={"Sui"},
"Algo así.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0003",head="sui_z1a",x=-345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_sud_000569",ch="sud"},
},
ja={
{
name={"Sui"},
"¿Caminamos un poco mientras les cuento? Les hablaré de eso también.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0011",head="shz_z1b",x=345,lv=4,id=9},
{"fgact",ch="雫",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_001766",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Sí. De nuestra historia...",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Caminar a dónde?",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",x=-345,lv=4,id=10},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_sud_000570",ch="sud"},
},
ja={
{
name={"Sui"},
"A la otra fuente de los cerezos milenarios, por supuesto.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"se",file="se9004",id=1},
{"fg",ch="雫",mx=-40,mode=-1,lv=4,id=9},
{"fg",ch="吹",mx=-40,mode=-1,lv=4,id=10},
{"text"},
text={
ja={
{
"Al decir eso, las dos comenzaron a caminar hacia el edificio del colegio.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Lentamente, hablando del pasado.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"bgm",stop=1,time=1000},
{"bg",time=2000,file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"bg",file="ev_uni_c37_01",time=2000,path=":ev/ev_uni_c37/",set="ev_uni_c37"},
{"bgm",file="bgm019"},
{"text"},
text={
ja={
{
"No recuerdo casi nada de mi vida en Nueva York.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Sin emoción alguna, todo escenario a mi alrededor se me hacía igual de\nmonótono. Cuando las personas no tienen corazón, pierden toda habilidad para\nrecordar cosas.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Y por eso no recuerdo mucho del panorama en la ciudad.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"La isla de Manhattan era una mezcla de arquitectura neogótica y el estilo Art\nDéco. Enormes, viejas edificaciones que jamás verías en Tokio convivían con\nedificios de vidrio modernos.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Aunque fue después de todo que me enteré de eso.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Nuestra casa estaba en Chelsea.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Vivíamos en un taller dentro de uno de los varios almacenes que había\nalrededor, en la cercanía del río Hudson.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
"Muchos artistas vivían cerca, y el taller era muy frecuentado.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"Allí estaba yo, sola, siempre quieta y tranquila, como si de un objeto sin vida\nse tratara.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Ese día estaba sentada en el sofá ubicado a una esquina del almacén, como era\nde costumbre.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"bg",file="ev_com_f06_01",path=":ev/ev_com_f06/",set="ev_com_f06"},
{"text"},
text={
vo={
{"vo",file="man_kid_001207",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Mmm.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="man_kid_001208",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Mm, mmm?",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_szd_001767",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Qué pasa?",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="man_kid_001209",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Ah, no, es que me pareció haber escuchado una voz justo ahora...",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_szd_001768",ch="szd"},
},
ja={
{
name={"Shizuku"},
"No hay nadie aparte de mí...",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="man_kid_001210",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Lo sé, pero...",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Kenichiro fijó su mirada en el otro lado del sofá donde estaba yo sentada.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="man_kid_001211",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Hay alguien ahí?",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_szd_001769",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Solo lo que ves...",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="man_kid_001212",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Solo lo que veo, eh...",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_szd_001770",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Ves algo?",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="man_kid_001213",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"No, nada de nada.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_szd_001771",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Pues, ya tienes tu respuesta...",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"se",file="se9002",vol=50,id=1},
{"text"},
text={
ja={
{
"Kenichiro-san inclina la cabeza en incomprensión, y camina hacia el taller.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"se",stop=1,time=500,id=1},
{"bg",file="ev_com_f06_03",alpha=64,id=9,lv=9,time=500,sync=1,path=":ev/ev_com_f06/",set="ev_com_f06"},
{"cgdel",id=9,time=1000,sync=1,lv=5},
{"ex",time=500,func="wait"},
{"bg",file="ev_com_f06_03",id=9,lv=9,time=3000,rule=146,path=":ev/ev_com_f06/",set="ev_com_f06"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000571",ch="sud"},
},
ja={
{
name={"Sui"},
"¿Qué le pasa? ¿Por qué se me ha quedado viendo fijamente?...",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_szd_001772",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Tranquila... por más fijamente que parezca verte, en realidad no puede ver\nnada...",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_sud_000572",ch="sud"},
},
ja={
{
name={"Sui"},
"¿Sí?... Qué mal ojo tiene Kenichiro-san. No puedo creer que sus ojos no sean\ncapaz de captar la exuberante belleza de Sui.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_szd_001773",ch="szd"},
},
ja={
{
name={"Shizuku"},
"No creo que sea precisamente por mala vista...",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Los sentimientos de Rin fueron demasiado fuertes como para alojarse en mi\ncuerpo, y se escaparon.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Poco a poco fueron tomando forma.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Y se convirtieron en un ser que solo yo podía ver.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"cgdel",id=9,lv=5,time=400},
{"bg",file="ev_com_f06_01",sync=0,face=1,time=400,path=":ev/ev_com_f06/",set="ev_com_f06"},
{"text"},
text={
vo={
{"vo",file="man_kid_001214",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Con quién hablas?",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_szd_001774",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Con nadie. Hablaba sola...",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
vo={
{"vo",file="man_kid_001215",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"... Hmph.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"bg",file="ev_uni_c37_01",path=":ev/ev_uni_c37/",set="ev_uni_c37"},
{"text"},
text={
ja={
{
"Y de ese ser que solo yo podía ver, me hice amiga. Pero, un día Kenichiro- san\nme dijo...",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"bg",file="ev_com_f06_01",path=":ev/ev_com_f06/",set="ev_com_f06"},
{"text"},
text={
vo={
{"vo",file="man_kid_001216",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Hay alguien ahí, ¿verdad?",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_szd_001775",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Quién?",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="man_kid_001217",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"No lo sé. Pero se siente como... sí, se parece a Rin.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_szd_001776",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Rin está en Japón.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="man_kid_001218",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Sí, así que probablemente no sea ella.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_szd_001777",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Pues entonces no puede haber nadie...",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="man_kid_001219",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Quién sabe. Me parece que últimamente se te ha ido quitando el carácter de\nHakuki que tenías.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_szd_001778",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿El carácter de Hakuki?",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="man_kid_001220",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Sí. Aun no te has abierto conmigo, pero pareces estar algo alegre últimamente.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_szd_001779",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Alegre?",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="man_kid_001221",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Así es. Lo inexpresiva no se te quita, eso sí...",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_szd_001780",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Inexpresiva... pero aun así alegre...",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="man_kid_001222",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Me pregunto qué pasará con eso.",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_szd_001781",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Con qué?",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="man_kid_001223",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Con lo que te tragaste.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="fem_szd_001782",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Yo?",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="man_kid_001224",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Te tragaste algo de una magnitud inconmensurable. Algo capaz de crear cosas de\nla nada.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="man_kid_001225",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Todo ese poder materializador... ¿Qué tanto tiempo podrá permanecer dentro de\nti?",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_szd_001783",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Kenichiro-san...",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="man_kid_001226",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Cómo se llama?",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_szd_001784",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Su nombre? No lo sé... Ah, dice que se llama Sui.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="man_kid_001227",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Sui... ya veo. Igual que ella...",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_szd_001785",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Que quién?",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="man_kid_001228",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Ah, nada. Cosas mías.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="man_kid_001229",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿No te sientes sola hablando solo con Shizuku, Sui? Puedes hablar conmigo\ncuando quieras, eh.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_szd_001786",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Kenichiro-san, también la puedes ver?",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="man_kid_001230",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Para nada. Ni la puedo ver, ni la puedo escuchar.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="man_kid_001231",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Solo que pensé que quizás ambas se sentirían solas. Por mi parte tengo\nbastantes compinches por acá, pero ustedes dos no tienen casi amigos.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="man_kid_001232",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Así que, ¿por qué no me incluyen a mí también en el grupo?",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="man_kid_001233",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Qué dices, Sui?",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"bg",file="ev_com_f06_03",sync=0,face=1,time=400,path=":ev/ev_com_f06/",set="ev_com_f06"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000573",ch="sud"},
},
ja={
{
name={"Sui"},
"¡Pues si así lo quieres!",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bg",file="ev_uni_c37_02",path=":ev/ev_uni_c37/",set="ev_uni_c37"},
{"text"},
text={
ja={
{
"Después de eso, Kenichiro-san empezó a tratar a Sui como una persona más.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Cuando salíamos a comer afuera tomaba siempre tres sillas, y no dos. Y también\npedía comida para Sui.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Kenichiro-san no conversaba solo conmigo, sino también con el asiento vacío.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Se supone que no podía ver a Sui, y sin embargo conversaba con ella.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
"Conversaciones que no deberían llegar a ningún lugar, y sin embargo siempre\nterminaban tomando vuelo.",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Recuerdo haberle preguntado a Kenichiro-san una vez esto.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"bg",file="ev_com_f06_01",path=":ev/ev_com_f06/",set="ev_com_f06"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001787",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Puedes ver a Sui?",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="man_kid_001234",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"No, no puedo.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_szd_001788",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Pero las conversaciones entre los dos siempre se dan bien.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="man_kid_001235",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Pues, no sé realmente, la verdad. Quizás sí, en lo que a pinturas se refiere.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_szd_001789",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿En pinturas?",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="man_kid_001236",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"De alguna forma me doy cuenta dónde ella podría quejarse conmigo, y dónde\npodría elogiarme. ¿A que no, Sui?",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bg",file="ev_com_f06_02",path=":ev/ev_com_f06/",set="ev_com_f06"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000574",ch="sud"},
},
ja={
{
name={"Sui"},
"Pues sí. No voy a negar que hay muchos problemas en tus cuadros, pero sí. En lo\nque a pinturas concierne nos llevamos muy bien.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="man_kid_001237",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Te acabas de quejar de mis cuadros, ¿verdad?",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="fem_sud_000575",ch="sud"},
},
ja={
{
name={"Sui"},
"¿Qué podría hacer? Para una genio como Sui, tus cuadros todavía dejan mucho que\ndesear.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
vo={
{"vo",file="man_kid_001238",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"¿Y que hay de ti? Mucho que dices, pero capaz y si llegas a pintar te sacas\nalgo horrible. Criticar es mucho más fácil que hacer, eh.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_sud_000576",ch="sud"},
},
ja={
{
name={"Sui"},
"Hmph, qué acusación tan ridícula. Pero qué más da, te haré entrar en cuenta de\nla diferencia de talento entre los dos cuando recupere mi cuerpo original.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="man_kid_001239",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Jamás llegará ese día.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
vo={
{"vo",file="fem_sud_000577",ch="sud"},
},
ja={
{
name={"Sui"},
"Aunque debo admitir que 'Cerezos recostados' no es mala obra. Es la clase de\ncuadro que podría quizás ganarle a uno de mis cuadros en un día malo. Pero un\ncuadro de esos que salen bien a pesar de ser un día malo.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="man_kid_001240",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"No entiendo qué demonios quieres decir...",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
vo={
{"vo",file="fem_szd_001790",ch="szd"},
},
ja={
{
name={"Shizuku"},
"E-Están... conversando, con normalidad...",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="man_kid_001241",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"Ya te dije que no la puedo escuchar. Solo lo que me parece escuchar.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
vo={
{"vo",file="fem_sud_000578",ch="sud"},
},
ja={
{
name={"Sui"},
"Kenichiro-san tiene una excelente intuición artística, seguramente es capaz de\npercibir de alguna manera lo que digo.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"bg",file="ev_uni_c37_01",path=":ev/ev_uni_c37/",set="ev_uni_c37"},
{"text"},
text={
ja={
{
"Cualquiera que lo viera pensaría que está hablando en voz alta solo.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Siempre que me llevaba a algún lugar, también le hablaba a Sui. Fuese en el\ntaller, en algún restaurante, de compras o incluso en galerías.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Todos alrededor, incluyéndome a mí, veían esa actitud suya como una de esas\n'excentricidades' típicas de un genio.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Y no es de sorprenderse. Para las personas que no pueden percibir la presencia\nde Sui, la manera de actuar de Kenichiro-san era toda una excentricidad.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Kenichiro nunca se preocupó de que el mundo lo viera así.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"bg",file="znightsky_summer",speed=300000,sync=1,id=1,lv=5,path=":cg/",x2=960,y2=540,x=-960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
name={"Naoya"},
"Ya veo... Así que Sui es el propio talento de Rin...",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_sud_000579",ch="sud"},
},
ja={
{
name={"Sui"},
"No creo que sea exactamente eso. Si fuera simplemente el talento de Rin, no\ncreo que hubiese tomado esta forma.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
vo={
{"vo",file="fem_sud_000580",ch="sud"},
},
ja={
{
name={"Sui"},
"Creo que en gran parte de mí llevo los sentimientos de Rin.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
vo={
{"vo",file="fem_sud_000581",ch="sud"},
},
ja={
{
name={"Sui"},
"No en vano el regreso de Rin a la ciudad llevó a que mi existencia se\nreiniciara.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿A que tu existencia se reiniciara?",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
vo={
{"vo",file="fem_szd_001791",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Es probable que la existencia de Sui se mantenga en base al balance entre Rin y\nyo.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
vo={
{"vo",file="fem_szd_001792",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Estando en Nueva York, Rin se encontraba muy lejos, lo cual hacía más fuerte mi\ninfluencia. Pero desde que Rin vino a la ciudad, ese balance de fuerza ha\ncambiado.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_szd_001793",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Creo que la propia existencia de Sui ha sufrido del hecho que Rin haya perdido\nla memoria.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
vo={
{"vo",file="fem_szd_001794",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Y por eso es que al aparecer de nuevo en esta zona, Sui no tenía ningún\nrecuerdo de hasta entonces.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_sud_000582",ch="sud"},
},
ja={
{
name={"Sui"},
"Así es. Aún conservaba la sensación de amistad que tenía con Shizuku, pero...\nno quedaba ni un solo recuerdo al respecto.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_szd_001795",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Así que, si la frecuencia con la que Rin y Sui se encuentran hubiese aumentado,\nquizás ambas hubiesen comenzado a buscar, ambas, sus recuerdos perdidos...",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
name={"Naoya"},
"No sabía eso... Pues qué buena suerte que no se han visto tanto.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
vo={
{"vo",file="fem_szd_001796",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Eso piensas?",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"Esas son memorias que deben permanecer ocultas para Rin. O al menos así lo veo\nyo...",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_szd_001797",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Bueno...",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Shizuku contesta de manera ambigua.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"Vamos, ¿qué pasa, Shizuku? ¿Es que acaso crees que sería mejor que Rin recobre\nsu memoria?",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
vo={
{"vo",file="fem_szd_001798",ch="szd"},
},
ja={
{
name={"Shizuku"},
"No. No lo sé... no lo sé, pero...",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Pero?",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_szd_001799",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Pero creo que si eso hubiese pasado, probablemente hubieses seguido tu camino\njunto a ella...",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Junto a Rin?",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_szd_001800",ch="szd"},
},
ja={
{
name={"Shizuku"},
"No estarías a mi lado, es lo que quise decir.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Pero qué estás diciendo? Yo te amo es a ti, Shizuku.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
vo={
{"vo",file="fem_szd_001801",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Sí, lo sé.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_szd_001802",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Y por lo mismo, creo que estuvo de más decir eso...",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"se",file="se9004",id=1},
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057c",path=":bg/",sync=0},
{"extrans",rule="083r",vague=40},
{"bgm",file="bgm035"},
{"text"},
text={
ja={
{
"Después de tomar un camino más largo de lo normal, llegamos a uno de los lados\nde la iglesia.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0001",head="sui_z1a",x=-345,lv=4,id=10},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0012",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001803",ch="szd"},
},
ja={
{
name={"Shizuku"},
"No sabía que se podía llegar de esta manera...",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
name={"Naoya"},
"Yumihari tiene muchos caminos ocultos. Pasando por el bosque puedes entrar al\nterreno del colegio. Aunque, nos tardamos un poco más de lo normal, eso sí...",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0011",head="sui_z1a",x=-345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_sud_000583",ch="sud"},
},
ja={
{
name={"Sui"},
"En fin, todo lo que estaba oculto respecto a mí lo reveló Shizuku en lo que te\ncontó.",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0008",head="sui_z1a",x=-345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_sud_000584",ch="sud"},
},
ja={
{
name={"Sui"},
"Por otra parte, al parecer esta pintura ha creado conexiones entre mí y una\ngran cantidad de personas...",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"'Las huellas de los cerezos'...",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_001804",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Haya sido por televisión, o en persona... Todas las personas que han visto\nestos cerezos milenarios se volvieron capaces de percibir a Sui...",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"Por eso es que aquella vez... Cuando fuimos al local de trajes de baño, la\nempleada no lograba verte...",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011",head="shz_z1a",x=345,lv=4,id=6},
{"fgact",ch="雫",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_001805",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Así es. Probablemente no había visto aún la obra, ni siquiera en televisión.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0011",head="sui_z1a",x=-345,lv=4,id=10},
{"fgact",ch="吹",act="いいえ",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_sud_000585",ch="sud"},
},
ja={
{
name={"Sui"},
"Pero, a final de cuentas, estos cerezos milenarios... no están al nivel de lo\nque Rin pintó...",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0008",head="sui_z1a",x=-345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_sud_000586",ch="sud"},
},
ja={
{
name={"Sui"},
"Algún día la gente se acostumbrará a verla, y perderán interés en ella. Y\ncuando llegue ese momento, ya nadie podrá volver a percibir a Sui jamás...",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Nadie? ¿Por qué? Yo podía verte aun antes de que esta obra se completara.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0011",head="sui_z1a",x=-345,lv=4,id=10},
{"fgact",ch="吹",act="おじぎ",lv=4,id=10},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0009",head="sui_z1a",x=-345,lv=4,id=10},
},
},
text={
vo={
{"vo",file="fem_sud_000587",ch="sud"},
},
ja={
{
name={"Sui"},
"Porque tocaste el pétalo de los cerezos milenarios... Y su efecto no durará por\nsiempre...",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pues aun así Shizuku debería verte, ¿no? Después de todo fue ella quien te\ncreó.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001806",ch="szd"},
},
ja={
{
name={"Shizuku"},
"......",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Qué pasa? ¿Por qué no dices nada, Shizuku?",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",file="bg064c",path=":bg/",sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"fg",ch="伯奇",size="z1",mode=3,resize=1,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",lv=4,id=9,sync=0},
{"extrans",time=2000},
{"text"},
text={
vo={
{"vo",file="fem_sud_000588",ch="sud"},
},
ja={
{
name={"Sui"},
"¿Conoces la razón por la cual Hakuki hizo florecer los cerezos milenarios?",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Dejando caer lluvia, no fue?",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="義貞",size="z1",mode=3,resize=1,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",x=-680,lv=4,id=1},
{"fg",ch="義貞",speed=1500,mode=3,path=":fg/yos/z1/",file="yos_z1a0000",face="a0001",head="yos_z1a",x2=-680,x=-345,lv=4,id=1},
{"fg",ch="伯奇",speed=1500,mode=3,path=":fg/hak/z1/",file="hak_z1a0000",face="a0001",head="hak_z1a",x2=0,x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000589",ch="sud"},
},
ja={
{
name={"Sui"},
"Esa no es la razón, fue la consecuencia. ¿Sabes por qué ella creó los cerezos\nmilenarios? Porque se enamoró.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_sud_000590",ch="sud"},
},
ja={
{
name={"Sui"},
"Hakuki era en principio un ser sin corazón, algo así como un recipiente. Es por\neso que podía tomar en sí los corazones de los demás.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_sud_000591",ch="sud"},
},
ja={
{
name={"Sui"},
"Y si bien Shizuku no era Hakuki por completo, sí tenía su poder. Digamos que\nestaba flotando en la frontera entre humano y Hakuki.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057c",path=":bg/",sync=0},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0009",head="sui_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=2000},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0001",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000592",ch="sud"},
},
ja={
{
name={"Sui"},
"Pero ahora, ella conoció lo que es enamorarse. Y conoció el amor.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Conoció el amor?",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0003",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000593",ch="sud"},
},
ja={
{
name={"Sui"},
"Siendo una de las personas más cercanas a ella debes saber de lo que hablo,\nKusanagi-san. Poco a poco Shizuku ha comenzado a actuar más como una muchacha\nnormal. Riendo, enojándose... avergonzándose...",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0016",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000594",ch="sud"},
},
ja={
{
name={"Sui"},
"Debo admitir que los vi hoy mientras se hacían cariño.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡¿Estabas viendo?!",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0015j",head="shz_z1a",x=345,lv=4,id=6},
{"fgact",ch="雫",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001807",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¡----!",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011j",head="shz_z1a",x=345,lv=4,id=6},
{"fgact",ch="雫",act="おじぎ",time=1000,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001808",ch="szd"},
},
ja={
{
name={"Shizuku"},
"N-Nos estabas viendo...",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0011",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000595",ch="sud"},
},
ja={
{
name={"Sui"},
"Y muy de cerca, aunque... en ningún momento Shizuku se dio cuenta de mi\npresencia...",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0009",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000596",ch="sud"},
},
ja={
{
name={"Sui"},
"Hasta ahora, Shizuku ha podido percibirme, incluso en esos momentos en los que\nme oculto...",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0010",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000597",ch="sud"},
},
ja={
{
name={"Sui"},
"Y sin embargo, hoy no me percibió en ningún momento.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0009",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000598",ch="sud"},
},
ja={
{
name={"Sui"},
"Esa es prueba de que su balanza está inclinándose hacia su parte humana...",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿S-Será que... por haberla llevado, a hacer esos juegos sexuales, Shizuku ha\nperdido el poder de Hakuki?...",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0016",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0004",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000599",ch="sud"},
},
ja={
{
name={"Sui"},
"¡No! Definitivamente no es culpa alguna de los juegos sexuales. Aunque, sí debo\nadmitir que la Shizuku que he visto hoy es la más expresiva que he visto\njamás...",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0014j",head="shz_z1a",x=345,lv=4,id=6},
{"fgact",ch="雫",act="いいえ",size=10,time=500,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001809",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Wah~, wah~, wah~",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"Shizuku se encontraba muy inquieta.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="雫",mode=-1,lv=4,id=6},
{"fg",ch="吹",speed=1000,mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0004",head="sui_z1a",x2=-345,x=0,lv=4,id=5},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",x=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0011",head="sui_z1a",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000600",ch="sud"},
},
ja={
{
name={"Sui"},
"Viéndolos hoy, llegué a una conclusión... Ahora que los dos están finalmente\njuntos, probablemente ya no podrán percibirme más.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0009",head="sui_z1a",x=0,lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000601",ch="sud"},
},
ja={
{
name={"Sui"},
"Es muy posible que esta noche... sea la última que nos veamos...",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"S-Sui...",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0016",head="sui_z1a",x=0,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0011",head="sui_z1a",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000602",ch="sud"},
},
ja={
{
name={"Sui"},
"No te preocupes, Kusanagi-san. Será difícil no poder ver más a esta hermosura,\npero no dejaré que te sientas triste.",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"Pues, la verdad es que aunque no seas bella ni hermosa, me sentiré muy triste\nsi no puedo verte más.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0016",head="sui_z1a",x=0,lv=4,id=5},
{"fgact",ch="吹",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000603",ch="sud"},
},
ja={
{
name={"Sui"},
"¡Pues, debo decir que soy una bella y hermosa mujer!",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"¿No piensas ceder en eso?...",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0011",head="sui_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000604",ch="sud"},
},
ja={
{
name={"Sui"},
"No te preocupes, Kusanagi-san. No permitiré que te sientas triste...",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000605",ch="sud"},
},
ja={
{
name={"Sui"},
"Me aseguraré de borrar todos los recuerdos respecto a mí tan pronto\ndesaparezca...",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Borrar todos los recuerdos de ti?",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0004",head="sui_z1a",x=0,lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0002",head="sui_z1a",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000606",ch="sud"},
},
ja={
{
name={"Sui"},
"Es lo mejor. Si aparte de mí misma, también mis recuerdos desaparecen... nadie\nse entristecerá.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"E-Eso es imposible.",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0011",head="sui_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000607",ch="sud"},
},
ja={
{
name={"Sui"},
"Solo para recordarte, yo nací del mismo poder de los cerezos milenarios. No me\ncostaría mucho desaparecer mis propios trazos...",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0002",head="sui_z1a",x=0,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000608",ch="sud"},
},
ja={
{
name={"Sui"},
"Soy muy buena pintando, pero también soy muy buena borrando...",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡De igual forma es absurdo! ¡¿Cómo crees que nadie va a lamentarse que te\nvayas?!",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0002",head="sui_z1a",x=0,lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0010",head="sui_z1a",x=0,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000609",ch="sud"},
},
ja={
{
name={"Sui"},
"Esa forma en la que te molestas conmigo, lo dice todo. Tengo que borrar tu\nmemoria de alguna u otra forma... No quiero hacerte sufrir...",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
name={"Naoya"},
"S-Sui, e-escucha...",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0010",head="sui_z1a",x2=0,x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0006",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001810",ch="szd"},
},
ja={
{
name={"Shizuku"},
"N-No voy a dejar que hables así de mí...",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0005",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001811",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Solo porque tenga un corazón humano ahora no significa que dejaré de verte.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0006",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001812",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Nací como Hakuki, y ahora vivo también como humana. Jamás llegaré a perder\nninguna de esas dos esencias.",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0012",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000610",ch="sud"},
},
ja={
{
name={"Sui"},
"......",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"Sui muestra una expresión de sorpresa ante la reacción de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0003",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000611",ch="sud"},
},
ja={
{
name={"Sui"},
"Vaya que has cambiado, Shizuku... Es la primera vez que te veo con esa cara...",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0010",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000612",ch="sud"},
},
ja={
{
name={"Sui"},
"Sí, lo sé... y me alegra que me lo digas, pero...",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0008",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000613",ch="sud"},
},
ja={
{
name={"Sui"},
"No puedo... Tengo que borrarlo todo, lo sabes...",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0019",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000614",ch="sud"},
},
ja={
{
name={"Sui"},
"De lo contrario... quedaremos las dos solas, de nuevo...",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0007",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001813",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¡¿Es que acaso prefieres estar sola?!",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0301",face="b0008",head="shz_z1b",x=345,lv=4,id=6},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0009",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000615",ch="sud"},
},
ja={
{
name={"Sui"},
"Sí. Así fue como nací, en primera instancia...",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0011",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0004",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000616",ch="sud"},
},
ja={
{
name={"Sui"},
"Haré que todos me olviden... y desapareceré.",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"Sui estaba sonriendo.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"Pero sus hombros estaban temblando ligeramente.",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
"¿Qué diablos dices?...",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
ja={
{
"¿De verdad crees que una muchachita tan ruidosa y jovial como tú puede estar\nsola?...",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",mode=-2},
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0010",face="a0009",head="sui_z2a",lv=5,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"¡To, n, ta!",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
"Alboroto fuertemente el cabello de Sui.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
"Voy a alborotarlo tan fuerte como sea necesario para que esta pequeña tonta\nentre en razón.",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0010",face="a0022",head="sui_z2a",lv=5,id=5},
{"fgact",ch="吹",act="icon",lv=5,id=5,icon="icon09z2",x=50,y=-550},
{"fgact",ch="吹",act="ジャンプ",lv=5,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="吹",act="いいえ",loop=4,time=500,lv=5,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000617",ch="sud"},
},
ja={
{
name={"Sui"},
"¡¿Nyo?! ¡¿Nyowaah, p-pero qué haces?! ¡¿Por qué, alborotas de nuevo, mi\ncabello?!",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"fgact",ch="吹",act="停止",lv=5,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"Me estás viendo la cara de tonto a mí también, ¿verdad?",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0006",head="sui_z2a",lv=5,id=5},
{"fgact",ch="吹",act="ジャンプ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000618",ch="sud"},
},
ja={
{
name={"Sui"},
"¡¿P-Por qué lo dices?!",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, eres casi como la propia definición de una pintura. Así de enorme y\ndescabellado es tu talento...",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Pero déjame decirte algo! ¡El talento de este hombre aquí le hizo ganar el\ntítulo de 'artista de los cerezos'!",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0017",head="sui_z2a",lv=5,id=5},
{"fgact",ch="吹",act="いいえ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000619",ch="sud"},
},
ja={
{
name={"Sui"},
"¿Y-Y qué pasa con eso?",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Si es por cerezos milenarios, crearé tantos como lo necesites!",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0001",head="sui_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000620",ch="sud"},
},
ja={
{
name={"Sui"},
"......",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
vo={
{"vo",file="fem_szd_001814",ch="szd"},
},
ja={
{
name={"Shizuku"},
"......",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡No voy a permitir que nos hagas olvidarnos de ti, jamás!",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0010",face="a0016",head="sui_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000621",ch="sud"},
},
ja={
{
name={"Sui"},
"*Puh*...",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0010",face="a0004",head="sui_z2a",lv=5,id=5},
{"fgact",ch="吹",act="いいえ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000622",ch="sud"},
},
ja={
{
name={"Sui"},
"¡¡*Pwwwwh*!!, ¿pero qué estás diciendo? ¿Es un chiste o algo así?",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0010",face="a0016",head="sui_z2a",lv=5,id=5},
{"fgact",ch="吹",act="ジャンプ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000623",ch="sud"},
},
ja={
{
name={"Sui"},
"Kusanagi-san, en ese estado ya no puedes ni siquiera pintar bien.",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, lo sé... mi mano derecha ya no da para pintar nada medianamente bueno.",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0010",face="a0011",head="sui_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000624",ch="sud"},
},
ja={
{
name={"Sui"},
"Pues entonces...",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
ja={
{
name={"Naoya"},
"Y aun así, fui capaz de convertir la obra de mi padre en una serie completa...",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0001",head="sui_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000625",ch="sud"},
},
ja={
{
name={"Sui"},
"......",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
name={"Naoya"},
"El viejo dijo que eran sus epitafios.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
name={"Naoya"},
"Las seis partes de 'Sakura Nanasouzu' fueron una de mis mejores obras, o al\nmenos eso pienso yo. ¿Nada buenas para ti?",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0011",head="sui_z2a",lv=5,id=5},
{"fgact",ch="吹",act="おじぎ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000626",ch="sud"},
},
ja={
{
name={"Sui"},
"Sakura Nanasouzu...",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0009",head="sui_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000627",ch="sud"},
},
ja={
{
name={"Sui"},
"Una serie de pinturas... inspiradas en las etapas de la muerte...",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
name={"Naoya"},
"Si no son lo suficiente para ti, me esforzaré más. Crearé obras aún más\ngeniales.",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Crearé unos cerezos milenarios que dejarán un impacto tal en el mundo, que tu\nexistencia permanecerá por toda la eternidad!",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Creéme que lo haré!",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0010",head="sui_z2a",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000628",ch="sud"},
},
ja={
{
name={"Sui"},
"......",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0016",head="sui_z2a",lv=5,id=5},
{"fgact",ch="吹",act="いいえ",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000629",ch="sud"},
},
ja={
{
name={"Sui"},
"*risas*... Tan falto de talento pero no de alardeo, ¿no, Kusanagi-san?...",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
name={"Naoya"},
"Por supuesto. Incluso el mismo Kei lo ha dicho. Un verdadero genio es capaz de\nhacer olvidar cualquier talento.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
name={"Naoya"},
"Quizás no tenga talento, pero soy un genio tan grande como tú. Y no tengo nada\nque envidiarle a Kenichiro Kusanagi tampoco.",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Así que créeme cuando digo que no permitiré que nadie te olvide!",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"fg",ch="吹",size="z2",mode=3,path=":fg/sui/z2/",file="sui_z2a0000",face="a0020",head="sui_z2a",lv=5,id=5},
{"fgact",ch="吹",act="びっくり",lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000630",ch="sud"},
},
ja={
{
name={"Sui"},
"--",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"fg",mode=-2},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0000",face="a0020",head="sui_z1a",x=-345,lv=4,id=10},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001815",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Sui...",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"bgm",stop=1,time=1000},
{"fg",ch="雫",speed=800,mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0011",head="shz_z1a",x2=345,x=0,lv=4,id=6},
{"text"},
delay={
[800]={
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"se",file="se9010",id=1},
},
[1000]={
{"bg",time=500,sync=0,file="black",path=":bg/"},
},
},
text={
ja={
{
"Shizuku abraza cariñosamente a Sui por los hombros.",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"bg",file="ev_com_f07_01",time=2000,path=":ev/ev_com_f07/",set="ev_com_f07"},
{"bgm",file="bgm040"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000631",ch="sud"},
},
ja={
{
name={"Sui"},
"Ya veo... hmph, no me extraña ahora que hayas podido robar el corazón de Rin...",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
vo={
{"vo",file="fem_sud_000632",ch="sud"},
},
ja={
{
name={"Sui"},
"Sí, ciertamente tu valor como artista no se puede medir en talento.",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
vo={
{"vo",file="fem_sud_000633",ch="sud"},
},
ja={
{
name={"Sui"},
"Jamás llegaste a tomar de nuevo el pincel frente a los demás. Y sin embargo,\ncuando se trata de ayudar a alguien no dudas en crear obras, aun sabiendo que\ntu nombre no quedará impreso en ellas.",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Y crees que no lo sé? Para mí pintar se trata de eso. He tenido un pincel en\nla mano desde que tengo uso de razón.",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, quizás ya no tenga esa mano. Pero aun así sé que cuando el deseo de pintar\nllegue a mí, el espíritu de la pintura estará conmigo.",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"text"},
text={
ja={
{
name={"Naoya"},
"Y bueno, a fin de cuentas pintar se trata de eso, ¿no?",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
vo={
{"vo",file="fem_sud_000634",ch="sud"},
},
ja={
{
name={"Sui"},
"......",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
"Después de mostrar una expresión algo exasperada, Sui dijo...",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"text"},
text={
vo={
{"vo",file="fem_sud_000635",ch="sud"},
},
ja={
{
name={"Sui"},
"Te lo agradezco... E-Está bien, veamos qué puedes hacer entonces...",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"text"},
text={
ja={
{
name={"Naoya"},
"Puedes esperar con ansias.",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
vo={
{"vo",file="fem_sud_000636",ch="sud"},
},
ja={
{
name={"Sui"},
"Kusanagi-san, si es verdad lo que dices, entonces mañana podremos vernos de\nnuevo, supongo...",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, por supuesto...",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000637",ch="sud"},
},
ja={
{
name={"Sui"},
"--",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
vo={
{"vo",file="fem_sud_000638",ch="sud"},
},
ja={
{
name={"Sui"},
"... Fuh, debo admitir que me siento alegre...",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
vo={
{"vo",file="fem_sud_000639",ch="sud"},
},
ja={
{
name={"Sui"},
"Sui, se...",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
ja={
{
"Sui se detiene abruptamente.",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
ja={
{
"Shizuku la abraza cariñosamente.",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"text"},
text={
vo={
{"vo",file="fem_sud_000640",ch="sud"},
},
ja={
{
name={"Sui"},
"Yo...",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
"Lágrimas comienzan a caer por las mejillas de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"bg",file="ev_com_f07_02",sync=0,face=1,time=400,path=":ev/ev_com_f07/",set="ev_com_f07"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000641",ch="sud"},
},
ja={
{
name={"Sui"},
"Shizukuu... me siento, tan feliz...",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
vo={
{"vo",file="fem_szd_001816",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Sí...",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"bg",file="ev_com_f07_03",sync=0,face=1,time=400,path=":ev/ev_com_f07/",set="ev_com_f07"},
{"text"},
text={
vo={
{"vo",file="fem_sud_000642",ch="sud"},
},
ja={
{
name={"Sui"},
"Yo... Sui, creyó... que la, olvidarían...",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
vo={
{"vo",file="fem_sud_000643",ch="sud"},
},
ja={
{
name={"Sui"},
"Y por eso me preparé, para poder aceptarlo...",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
vo={
{"vo",file="fem_sud_000644",ch="sud"},
},
ja={
{
name={"Sui"},
"Ese es mi destino, pensé... No importa lo sola que me sintiera...",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"text"},
text={
vo={
{"vo",file="fem_sud_000645",ch="sud"},
},
ja={
{
name={"Sui"},
"Así que Sui pensó que debía desaparecer... y para eso me preparé...",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
vo={
{"vo",file="fem_sud_000646",ch="sud"},
},
ja={
{
name={"Sui"},
"Pero la verdad es que, no quería desaparecer de la vida de los demás...",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"text"},
text={
vo={
{"vo",file="fem_sud_000647",ch="sud"},
},
ja={
{
name={"Sui"},
"Jamás, quise que me olvidaran... ni Shizuku, ni Kusanagi-san tampoco...",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
vo={
{"vo",file="fem_sud_000648",ch="sud"},
},
ja={
{
name={"Sui"},
"Pero, pensé que de no desaparecer... solo le dejaría tristeza, a los dos...",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"text"},
text={
vo={
{"vo",file="fem_sud_000649",ch="sud"},
},
ja={
{
name={"Sui"},
"No podía tolerar la idea, de... dejarles solos, tristeza...",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"text"},
text={
vo={
{"vo",file="fem_sud_000650",ch="sud"},
},
ja={
{
name={"Sui"},
"Y por eso, pensé en borrar los recuerdos de los dos...",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"text"},
text={
vo={
{"vo",file="fem_sud_000651",ch="sud"},
},
ja={
{
name={"Sui"},
"Pero... perooo...",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
vo={
{"vo",file="fem_szd_001817",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Lo sabemos, Sui... todo estará bien. Pase lo que pase, jamás te olvidaremos...",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
vo={
{"vo",file="fem_szd_001818",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Verdad, Naoya?",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
ja={
{
name={"Naoya"},
"Así es. Y por eso no hay razón alguna para llorar. Dios santo, paren ya con\nesas caras de velorio...",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
vo={
{"vo",file="fem_szd_001819",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Pero tú también estás llorando...",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Llorando, yo?... No me jodas, demonios...",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
vo={
{"vo",file="fem_szd_001820",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿De verdad?",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"text"},
text={
ja={
{
name={"Naoya"},
"Por supuesto que no...",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
vo={
{"vo",file="fem_sud_000652",ch="sud"},
},
ja={
{
name={"Sui"},
"Entiendo... gracias a los dos.",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"text"},
text={
vo={
{"vo",file="fem_sud_000653",ch="sud"},
},
ja={
{
name={"Sui"},
"Mañana los podré ver de nuevo, ¿verdad?",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
vo={
{"vo",file="fem_szd_001821",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Mañana, y pasado mañana, y el día que viene después. Siempre, siempre nos\npodremos volver a ver, Sui.",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"text"},
text={
vo={
{"vo",file="fem_sud_000654",ch="sud"},
},
ja={
{
name={"Sui"},
"Bueno...",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
vo={
{"vo",file="fem_szd_001822",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Estoy segura de que si Naoya y yo combinamos nuestros poderes, no\ndesaparecerás...",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
vo={
{"vo",file="fem_sud_000655",ch="sud"},
},
ja={
{
name={"Sui"},
"¡Está bien!",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"text"},
text={
vo={
{"vo",file="fem_szd_001823",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Así que no tienes nada de qué preocuparte...",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057c",path=":bg/",sync=0},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0019",head="sui_z1a",x=0,lv=4,id=9,sync=0},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0009",head="shz_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=1000},
{"fg",ch="吹",speed=1000,mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0019",head="sui_z1a",x2=0,x=-345,lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Sui se aleja lentamente de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0010",face="a0008",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000656",ch="sud"},
},
ja={
{
name={"Sui"},
"Shizuku... Kusanagi-san... quiero darles las gracias a los dos...",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0003",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000657",ch="sud"},
},
ja={
{
name={"Sui"},
"Y si ese es el caso, les prometo esto.",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"fg",mode=-2},
{"fg",ch="吹",size="z2",mode=3,resize=1,path=":fg/sui/z2/",file="sui_z2a0010",face="a0004",head="sui_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000658",ch="sud"},
},
ja={
{
name={"Sui"},
"Nos veremos de nuevo mañana, ¿está bien?",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"text"},
text={
ja={
{
name={"Naoya"},
"Por supuesto.",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"fg",mode=-2},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0010",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0003",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001824",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Nos vemos mañana.",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0000",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000659",ch="sud"},
},
ja={
{
name={"Sui"},
"¡Pues hasta mañana entonces!",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"se",file="se0744s",id=1},
{"fg",ch="吹",mx=-40,mode=-1,lv=4,id=5},
{"text"},
text={
ja={
{
"Sui se va corriendo.",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"text"},
text={
ja={
{
"Con la misma endemoniada rapidez de siempre.",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"text"},
text={
ja={
{
"Aun a pesar de haber llorado tanto hace un momento... Básicamente se fue\ncorriendo intentando hacer secar las lágrimas.",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"msgoff"},
{"se",file="se9004",vol=40,id=1},
{"fg",ch="雫",time=500,sync=1,mode=-1,lv=4,id=6},
{"fg",ch="雫",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0301",face="a0009",head="shz_z2a",lv=5,id=6},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="fem_szd_001825",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Naoya...",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"fgact",ch="雫",act="うなづく",lv=5,id=6},
{"se",file="se9010",vol=40,id=1},
{"text"},
text={
ja={
{
"Shizuku me coge del brazo.",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Qué pasa?",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0010",head="shz_z2a",lv=5,id=6},
{"fgact",ch="雫",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001826",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Gracias...",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Por qué me estás dando las gracias?",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0011",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001827",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Pues, es que...",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"text"},
text={
ja={
{
name={"Naoya"},
"No seas tonta. Si estoy haciendo esto es porque así lo quiero. Todo...",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"text"},
text={
ja={
{
name={"Naoya"},
"Yo solo me dispongo a hacer lo que realmente quiero hacer, ¿sabías?",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"text"},
text={
ja={
{
name={"Naoya"},
"Así que no importa lo difícil que sea, lo lograré pase lo que pase...",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"text"},
text={
ja={
{
name={"Naoya"},
"No por algo pensé en hacerlo en un principio.",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"text"},
text={
ja={
{
name={"Naoya"},
"Debo hacerlo hasta el final, por más obstáculos que se interpongan en el\ncamino...",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0019",head="shz_z2a",lv=5,id=6},
{"fgact",ch="雫",act="おじぎ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001828",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Está bien...",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"text"},
text={
ja={
{
"Shizuku se limpia las lágrimas.",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"text"},
text={
ja={
{
"Y entonces――",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"text"},
text={
ja={
{
"C-Cuánta fuerza le está poniendo a mi brazo...",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0006",head="shz_z2a",lv=5,id=6},
{"fgact",ch="雫",act="いいえ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001829",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¡Pero sí! ¡Definitivamente eres capaz de cualquier cosa!",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿De qué? Soy todo un inútil, por Dios.",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0005",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001830",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¡Por supuesto que no!",
{"rt2"},
},
},
},
linkback="block_00378",
linknext="block_00380",
},
block_00380={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0011",head="shz_z2a",lv=5,id=6},
{"fgact",ch="雫",act="いいえ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001831",ch="szd"},
},
ja={
{
name={"Shizuku"},
"......",
{"rt2"},
},
},
},
linkback="block_00379",
linknext="block_00381",
},
block_00381={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0009",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001832",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Jamás me imaginé que dirías en ese momento que pintarías los cerezos\nmilenarios.",
{"rt2"},
},
},
},
linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"text"},
text={
ja={
{
name={"Naoya"},
"Por supuesto que lo haré...",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
{"text"},
text={
ja={
{
name={"Naoya"},
"Es para eso que he estado conservando mi habilidad para pintar...",
{"rt2"},
},
},
},
linkback="block_00382",
linknext="block_00384",
},
block_00384={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0012",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001833",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Conservando tu habilidad para pintar?",
{"rt2"},
},
},
},
linkback="block_00383",
linknext="block_00385",
},
block_00385={
{"text"},
text={
ja={
{
name={"Naoya"},
"Así es. No creas que ya no puedo pintar. He estado preparándome y conservándome\npara poder pintar cuando llegue el momento que desee hacerlo...",
{"rt2"},
},
},
},
linkback="block_00384",
linknext="block_00386",
},
block_00386={
{"text"},
text={
ja={
{
name={"Naoya"},
"No es solo mi mano derecha la que pinta...",
{"rt2"},
},
},
},
linkback="block_00385",
linknext="block_00387",
},
block_00387={
{"text"},
text={
ja={
{
name={"Naoya"},
"Mis pinturas no salen solo de un brazo derecho.",
{"rt2"},
},
},
},
linkback="block_00386",
linknext="block_00388",
},
block_00388={
{"text"},
text={
ja={
{
name={"Naoya"},
"Mis pinturas no nacen solo de talento.",
{"rt2"},
},
},
},
linkback="block_00387",
linknext="block_00389",
},
block_00389={
{"text"},
text={
ja={
{
name={"Naoya"},
"Es el deseo de pintar lo que produce todas mis pinturas.",
{"rt2"},
},
},
},
linkback="block_00388",
linknext="block_00390",
},
block_00390={
{"text"},
text={
ja={
{
name={"Naoya"},
"Por eso es que siempre puedo volver a pintar, cuando así lo desee.",
{"rt2"},
},
},
},
linkback="block_00389",
linknext="block_00391",
},
block_00391={
{"text"},
text={
ja={
{
name={"Naoya"},
"Y no por alguien... sino por mí, y nada más que mí.",
{"rt2"},
},
},
},
linkback="block_00390",
linknext="block_00392",
},
block_00392={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0301",face="a0002",head="shz_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001834",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Naoya...",
{"rt2"},
},
},
},
linkback="block_00391",
linknext="block_00393",
},
block_00393={
{"text"},
text={
ja={
{
"Shizuku se me queda viendo.",
{"rt2"},
},
},
},
linkback="block_00392",
linknext="block_00394",
},
block_00394={
{"text"},
text={
ja={
{
"Me está dando algo de pena.",
{"rt2"},
},
},
},
linkback="block_00393",
linknext="block_00395",
},
block_00395={
{"text"},
text={
ja={
{
name={"Naoya"},
"Ajaja, sí, bueno, déjalo así...",
{"rt2"},
},
},
},
linkback="block_00394",
linknext="block_00396",
},
block_00396={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0301",face="a0002",head="shz_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"Pues bieeen, ya es hora, ¿sabes? ¡Es hora!",
{"rt2"},
},
},
},
linkback="block_00395",
linknext="block_00397",
},
block_00397={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0012",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001835",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¿Es hora?",
{"rt2"},
},
},
},
linkback="block_00396",
linknext="block_00398",
},
block_00398={
{"text"},
text={
ja={
{
name={"Naoya"},
"¡Tenemos que regresar ya! ¡Los Natsume deben estar enojados de que la cena\ntodavía no está sobre la mesa!",
{"rt2"},
},
},
},
linkback="block_00397",
linknext="block_00399",
},
block_00399={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0008",head="shz_z1a",lv=4,id=6},
{"fgact",ch="雫",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001836",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Ah, supongo...",
{"rt2"},
},
},
},
linkback="block_00398",
linknext="block_00400",
},
block_00400={
{"text"},
text={
ja={
{
name={"Naoya"},
"Así que...",
{"rt2"},
},
},
},
linkback="block_00399",
linknext="block_00401",
},
block_00401={
{"text"},
text={
ja={
{
name={"Naoya"},
"Vayamos de vuelta a casa, ¿sí?",
{"rt2"},
},
},
},
linkback="block_00400",
linknext="block_00402",
},
block_00402={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0301",face="a0004",head="shz_z1a",lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001837",ch="szd"},
},
ja={
{
name={"Shizuku"},
"¡Sí!",
{"rt2"},
},
},
},
linkback="block_00401",
linknext="block_00403",
},
block_00403={
{"text"},
text={
ja={
{
"Shizuku contesta alegremente.",
{"rt2"},
},
},
},
linkback="block_00402",
linknext="block_00404",
},
block_00404={
{"se",file="se9004",vol=40,id=1},
{"bg",file="zev_uni_c38_01",speed=300000,path=":ev/ev_uni_c38/",set="ev_uni_c38",x2=420,y2=-540,x=-960,y=-540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
"Era una noche bajo un cielo despejado de otoño.",
{"rt2"},
},
},
},
linkback="block_00403",
linknext="block_00405",
},
block_00405={
{"text"},
text={
ja={
{
"Y el panorama se veía como si la propia ciudad de Yumihari estuviera reflejada\nsobre el cielo.",
{"rt2"},
},
},
},
linkback="block_00404",
linknext="block_00406",
},
block_00406={
{"text"},
text={
ja={
{
"Luces titilando tanto arriba como abajo.",
{"rt2"},
},
},
},
linkback="block_00405",
linknext="block_00407",
},
block_00407={
{"text"},
text={
ja={
{
name={"Naoya"},
"Las luces de causalidad enlazada, eh...",
{"rt2"},
},
},
},
linkback="block_00406",
linknext="block_00408",
},
block_00408={
{"text"},
text={
ja={
{
"Hay un verso de eso en el poema de mi padre.",
{"rt2"},
},
},
},
linkback="block_00407",
linknext="block_00409",
},
block_00409={
{"text"},
text={
ja={
{
"Una ilusoria apariencia del color de primavera, recubriendo el cielo. Solo\nalumbra, brillante, radiante, deslumbrante, ciegamente, sin pensarlo, esa\nlámpara de causalidad enlazada.'",
{"rt2"},
},
},
},
linkback="block_00408",
linknext="block_00410",
},
block_00410={
{"text"},
text={
ja={
{
"La verdad es que no entiendo qué quiere decir.",
{"rt2"},
},
},
},
linkback="block_00409",
linknext="block_00411",
},
block_00411={
{"text"},
text={
ja={
{
"Pero cuando veo las luces de la ciudad, de cierta manera siento que logro\nentenderlo.",
{"rt2"},
},
},
},
linkback="block_00410",
linknext="block_00412",
},
block_00412={
{"text"},
text={
ja={
{
"En cada una de las ventanas brillando casi como estrellas que puedo ver de acá\nhacen vida personas.",
{"rt2"},
},
},
},
linkback="block_00411",
linknext="block_00413",
},
block_00413={
{"text"},
text={
ja={
{
"Es el brillo de la luz de causalidad enlazada.",
{"rt2"},
},
},
},
linkback="block_00412",
linknext="block_00414",
},
block_00414={
{"bg",file="ev_uni_c38_01",path=":ev/ev_uni_c38/",set="ev_uni_c38"},
{"text"},
text={
vo={
{"vo",file="fem_szd_001838",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Las estrellas están brillantes, resplandecientes...",
{"rt2"},
},
},
},
linkback="block_00413",
linknext="block_00415",
},
block_00415={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, así es...",
{"rt2"},
},
},
},
linkback="block_00414",
linknext="block_00416",
},
block_00416={
{"text"},
text={
vo={
{"vo",file="fem_szd_001839",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Caminar juntos bajo el cielo estrellado...",
{"rt2"},
},
},
},
linkback="block_00415",
linknext="block_00417",
},
block_00417={
{"text"},
text={
vo={
{"vo",file="fem_szd_001840",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Un milagro así no cae nada mal...",
{"rt2"},
},
},
},
linkback="block_00416",
linknext="block_00418",
},
block_00418={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Milagro? Esto no es milagro... esto es destino.",
{"rt2"},
},
},
},
linkback="block_00417",
linknext="block_00419",
},
block_00419={
{"text"},
text={
vo={
{"vo",file="fem_szd_001841",ch="szd"},
},
ja={
{
name={"Shizuku"},
"Brillan, resplandecientes...",
{"rt2"},
},
},
},
linkback="block_00418",
linknext="block_00420",
},
block_00420={
{"text"},
text={
ja={
{
"Shizuku me toma del brazo, sonriendo, y bajamos juntos la colina.",
{"rt2"},
},
},
},
linkback="block_00419",
linknext="block_00421",
},
block_00421={
{"text"},
text={
ja={
{
"En el cielo brillaban, resplandecientes, las estrellas.",
{"rt2"},
},
},
},
linkback="block_00420",
linknext="block_00422",
},
block_00422={
{"eval",exp="g.shzclear=1"},
{"eval",exp="g.clear_ani=1"},
{"bgm",stop=1,time=3000},
{"se",stop=1,id=-1,time=3000},
{"vostop",stop=1,time=3000},
{"ntclear"},
