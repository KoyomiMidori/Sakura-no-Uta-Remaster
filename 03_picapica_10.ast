astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c05_01",path=":ev/ev_eye_c05/",set="ev_eye_c05"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0110",face="a0004",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm041"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003498",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Bien, a trabajar duro desde hoy!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Caminando a mi lado, Toritani dijo eso con una expresión jovial y alegre en su\nrostro bajo el refrescante sol matutino.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Exposición Moore?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003499",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003500",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si no vas a presentar nada, entonces tengo que encargarme yo de hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Toritani contesta con una cara fresca, como si no fuera la gran cosa, pero la\npasión y empeño que ha puesto hasta ahora en el club de arte y la Exposición\nMoore no es algo que cualquiera pueda hacer.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"La razón por la cual Toritani luchó por mantener el club de arte fue por el\nbien de los dos genios. Ella misma dijo que los dos genios no podrían estar\nuno sin el otro.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"De que uno no estaría completo sin el otro.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Quiero que pintes'. Toritani me pidió eso con mucha gravedad y seriedad. Y es\npor eso mismo que no pude evadir su petición.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Le di respuesta a su convicción, a mi manera. Sin embargo, eso acabó haciendo\nañicos su sueño.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Y fui yo quien lo aplastó.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003501",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué pasa? ¿Por qué la cara seria?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para ser sincero, aún no sé qué puedo hacer por ti. Pero, quisiera servirte de\nalgo, aunque sea solo un poco.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003502",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si llegas a necesitar algo, dímelo sin reserva alguna. Te ayudaré.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0029",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003503",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué clase de objeto de arte piensas fabricar?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0003",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003504",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es un secreto, por ahora.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003505",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo único que puedo decirte es que pondré todo mi conocimiento y capacidad en\nella. Tomaré mi mejor camino.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"se",file="se9004",id=1},
{"fg",ch="真琴",speed=5000,mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0002",head="mak_z1d",x2=0,x=1000,lv=4,id=9},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="cg_zbg041a",speed=300000,id=9,lv=9,path=":cg/",x2=800,y2=0,x=-400,y=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Vamos subiendo la colina de Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Quizás por estar subiendo al colegio más tarde de lo normal es que resaltan\nbastante las estudiantes de otros colegios.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_jga_000004",ch="jga"},
},
ja={
{
name={"Estudiante A"},
"“Ah, oye oye, ¿no es ese Naoya Kusanagi-kun? Del que todas hablan.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="fem_jgb_000004",ch="jgb"},
},
ja={
{
name={"Estudiante B"},
"“Ah, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_jga_000005",ch="jga"},
},
ja={
{
name={"Estudiante A"},
"“Increíble, creo que se ve más guapo en persona que en TV.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="fem_jgb_000005",ch="jgb"},
},
ja={
{
name={"Estudiante B"},
"“¿Quién es la mujer que tiene al lado? ¿No será que esta saliendo con ella, o\nsí?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_jga_000006",ch="jga"},
},
ja={
{
name={"Estudiante A"},
"“Eh~, Naoya-kun no se ve nada bien con esa mujer a su lado.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Toritani no le presta nada de atención a los atrevidos comentarios de las\ncolegialas a su alrededor. Más bien camina a mi lado con toda soltura y\nlibertad.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Por lo general yo tampoco le presto mucha atención, pero me inquietan las\nhostiles miradas que las colegialas dirigen hacia ella.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="fem_jgb_000006",ch="jgb"},
},
ja={
{
name={"Estudiante B"},
"“¡Ah, es esa, esa mujer! ¡¿No es esa la mujer que Kusanagi-kun cargó hace unos\ndías?!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_jga_000007",ch="jga"},
},
ja={
{
name={"Estudiante A"},
"“¡Eh~, eso es injusto!”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_jgb_000007",ch="jgb"},
},
ja={
{
name={"Estudiante B"},
"“¡¿Es que Kusanagi-kun está en verdad saliendo con esa mujer?!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="fem_jga_000008",ch="jga"},
},
ja={
{
name={"Estudiante A"},
"“No lo puedo creer. Esa mujer no es nada digna de ser la novia de Naoya-kun.\n¡Debería ahorrarse la pena y alejarse de él!”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="fem_jgb_000008",ch="jgb"},
},
ja={
{
name={"Estudiante B"},
"“Sí, es verdad. ¡Esa mujercita debería apartarse de Kusanagi-kun!...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"... Esto no es bueno.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Aquel día que las colegialas nos persiguieron y tuve que cargar a Toritani, fui\njustamente yo quien dijo que convenía comportarnos como si realmente\nestuviéramos saliendo, pero...",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Las cosas han cambiado.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Ahora que el malentendido de aquella vez pasó a hacerse realidad ayer, no puedo\npermitirme causarle molestias a Toritani, justo después de haberle prometido\nmi apoyo.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg041a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2d0100",face="d0001",head="mak_z2d",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003506",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien, solo ignorémoslas.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No. Es mejor dejar las cosas claras acá y de una vez.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003507",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eso crees? Decirlo todo acá podría causar histeria entre todas... Creo que\nquizás lo mejor sea ignorarlas, por, ahora――”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
"Las palabras de Toritani se desvanecen al final. Su mirada se queda fija sobre\nuna chica que se encuentra tras el rebaño de colegialas.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="真琴",mode=-1,lv=5,id=9},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="稟",mode=-1,lv=4,id=9},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0011",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003508",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Rin-chan...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0005",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003509",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“――”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0005",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Toritani apretó mi mano fuertemente. Las muchachas de los otros colegios que\nnos rodeaban empezaron a alzar chillidos.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"bgm",file="bgm105"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003510",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me importa un bledo lo que todas ustedes digan.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003511",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Yo seguiré al lado de Naoya Kusanagi. Cuidaré de él hasta el final. Jamás\nsoltaré esta mano.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
"Esas palabras parecían ser dirigidas, no al grupo de colegialas, sino a una\nsola y única persona.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="真琴",mode=-1,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_jga_000009",ch="jga"},
},
ja={
{
name={"Estudiante A"},
"“¡Eh~, Kusanagi-san, ¿es eso cierto?!”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_jgb_000009",ch="jgb"},
},
ja={
{
name={"Estudiante B"},
"“¿No está diciendo solo por decirlo?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que es verdad, demonios.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Makoto Toritani es mi preciada y amada novia. Es el amor de mi vida.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque hay unas cuantas por ahí que estuvieron criticándola, diciendo que\ndebería desaparecerse, o que deberíamos terminar...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No perdonaré a nadie que ose hacerle algo. Encontraré a toda costa a esa\npersona y le daré una paliza, sea mujer u hombre.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="fem_jga_000010",ch="jga"},
},
ja={
{
name={"Estudiante A"},
"“¿P-Pero qué?... ¿Es, para tanto?...”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_jgb_000010",ch="jgb"},
},
ja={
{
name={"Estudiante B"},
"“Eh~, esto me está dando miedo...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_jga_000011",ch="jga"},
},
ja={
{
name={"Estudiante A"},
"“¿Verdad?... Mejor vámonos, esto no me gusta...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="fem_jgb_000011",ch="jgb"},
},
ja={
{
name={"Estudiante B"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"Las muchachas de los otros colegios se hacen señas con los ojos y se retiran\ncon agilidad.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"La gente de nuestro colegio que transitaba también por la vía no parecen estar\nmuy consternada por lo que está sucediendo.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
"Hay unos pocos dando pequeños silbidos burlones, pero solo eso.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Nuestro colegio es relativamente liberal, y como consecuencia reúne una buena\ncantidad de gente rara y particular en sus instalaciones. Probablemente están\nacostumbrados ya a esta clase de situaciones.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"No por nada hay incluso un tipejo por ahí que llegó a volar por los aires\nusando una muñeca sexual inflable.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0001",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003512",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, lo siento, adelántate tú.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Después de ver que todas las muchachas de los otros colegios se habían retirado\ndel lugar, Toritani soltó mi mano.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0001",head="mak_z2b",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"En ese preciso instante agarro su muñeca, y procuro confirmar una vez más.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Puedes ir sola?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Toritani sonríe, tratando de despojar mi preocupación.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0002",head="mak_z2b",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003513",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estoy bien. Gracias a lo tajante que fuiste hace un rato con ellas, ya no hay\npeligro alguno, y además...”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003514",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No estaré sola.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="真琴",speed=3000,mode=3,path=":fg/mak/z2/",file="mak_z2b0100",face="b0002",head="mak_z2b",x2=0,x=-1500,lv=5,id=9},
{"se",file="se0744",vol=50,id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg063a",path=":bg/",sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"La sigo a ella mientras va caminando por el sendero que se desvía de la colina\nde Yumenouki.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Aunque la perdiese de vista, seguramente hubiera terminado llegando aquí.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0001",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003515",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003680",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Hace un tiempo, en este mismo lugar, ella me dijo lo mucho que le hacía sufrir\nmi amabilidad.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003516",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003681",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Si yo estuviera en el lugar en que ella está, también sufriría. Pero\nprobablemente desearía también que no me dijera nada.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Yo soy débil. Y ella es muy fuerte.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"La quiero mucho. A ella――a Rin-chan.\nY por eso mismo, no puedo ser 'amable' con ella ahora. De ninguna forma.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003517",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi... me gusta.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003682",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003518",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Le dije que me gustaba.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003683",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003519",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi también respondió a mis sentimientos.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003684",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003520",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y por eso, por eso...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003521",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi y yo decidimos tener una relación...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"Estuve a punto de seguir con un 'perdóname', pero me tragué la palabra. Me\npareció que, por nada del mundo, debía decir justamente esa palabra.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0100",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003685",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Entiendo. Gracias por contármelo.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rin-chan extiende suavemente sus manos. Sus brazos me envuelven delicadamente.",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"De su larga cabellera se siente un gentil y plácido aroma. Rin-chan es\nextraordinariamente linda, cariñosa y amable. Cualquiera quedaría encariñado\ncon ella.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003686",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo que dijiste en la colina Yumenouki... Esas palabras eran para mí, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003522",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"La verdad es que en el momento en que me vi rodeada por las chicas de los otros\ncolegios en la colina Yumenouki, pensé en ignorarlas y seguir de largo.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Pero mientras trataba de ignorarlas, Rin-chan saltó a mi vista. Nuestras\nmiradas se cruzaron.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"No me importa en lo absoluto lo que hagan o digan un puñado de chicas que solo\npuede ver lo más superficial de Kusanagi. Pero no en el caso de Rin-chan.\nTenía que decirle esto, a como dé lugar.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"A simple vista, todo pareció como una intimidante declaración ante las chicas\nde los otros colegios, pero en realidad esas palabras fueron solo para ella.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003523",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pensé... que debía contarte bien todo lo que sucedió, Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0004",head="rin_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2a0100",face="a0002",head="rin_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003687",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo. Por eso es que a pesar de ser tan penosita, gritaste eso en medio de\ntanta gente. Gracias. Muchísimas gracias, Mako-chan.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003524",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, espera, no tienes por qué... yo solo---”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003688",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Sabes? En ningún momento, e incluso ahora, has dejado de ser tú. Por eso me\nalegro de poder seguir queriéndote tanto como hasta ahora, Mako-chan.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003525",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Rin-chan...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Rin-chan me abraza fuertemente. Le devuelvo el abrazo lenta y suavemente.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"La brisa de la mañana trajo consigo un pequeño preludio del otoño.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"A pesar de que hasta hace poco daba la sensación de que el tan ardiente verano\nse quedaría por siempre.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"El paso del tiempo... Las estaciones van cambiando.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Rin-chan suelta sus brazos. Yo también alejo mis manos de ella.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg063a",path=":bg/",sync=0},
{"extrans",time=1000},
{"bgm",file="bgm003"},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003689",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mako-chan, quiero que sepas algo.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="fem_rnd_003690",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En caso de que no estés muy segura de ti o no sepas algo, puedes preguntarme lo\nque sea, ¿está bien? Te enseñaré muchas cosas.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003526",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eh.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"El repentino desenlace me impidió por un momento entender de qué estaba\nhablando. Pero, lo que Rin-chan está tratando de decir, es... en pocas\npalabras...",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0016",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_003691",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pareces ser un poquito ingenua respecto a 'esas' cosas, Mako-chan. Por eso lo\ndigo. ¿Sabes? Yo soy versada en lo que a cosas pervertidas se refiere.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003527",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Cosas pervertidas...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003528",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003692",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajaja, Mako-chan, tienes la cara completamente roja.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003529",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡E-Eso no! ¡Ciertamente dije que él y yo estamos en una relación, pero no\nhay por qué ponerse a pensar de repente en esas cosas ahora, ¿no?!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Mi cuerpo se calienta. Estoy a punto de recordar lo que sucedió ayer... A pesar\nde que adentro todavía queda el dolor de aquel momento...",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0002",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003693",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Solo es conocimiento teórico.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003530",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Incluso para estas cosas... eres demasiado estudiosa...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0110",face="a0004",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003694",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si no tienes problema puedes preguntarme cuando quieras, ¿sí, Mako-chan?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003531",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“G-Gracias... ehm, lo pensaré.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003695",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Rin-chan es una chica amable, de buen corazón, capaz de atraer a cualquier\npersona. Eso pensaba, y sigo pensando igual, pero...",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Quizás es también una chica un tanto rara.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"bg",time=1500,file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg044e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="直哉",size="z1",mode=3,resize=1,path=":fg/nao/z1/",file="nao_z1a0100",face="a0013",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh, llegaste.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003532",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ugeh.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Pensé que estaba en el salón, así que me agarró por sorpresa. Sin querer solté\nun extraño rugido.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0015",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué la reacción tan poco sutil? ¿Quizás hubiera sido mejor no esperarte?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003533",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo por esta vez, sí...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Considerando lo que sucedió hace un momento con las otras muchachas,\nseguramente solo estaba preocupado por mí. Me pone feliz, pero en este\npreciso momento también me compromete un poco...",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="直哉",size="z1",mode=3,path=":fg/nao/z1/",file="nao_z1a0100",face="a0016",head="nao_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes la cara roja, ¿pasa algo?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003534",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“N-No es nada.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="直哉",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Mira nada más. Siempre, siempre en estos momentos se da cuenta de todo, con esa\ncara tan despreocupada.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Y mientras me arrepentía de no haberme quedado esperando en el templo a que mi\ncara recobrara su color normal, me dirigí al salón a pasos rápidos.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bgm",stop=1,time=1000},
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"... Para cuando terminó la hora de receso, Rin-chan me pasó unos apuntes.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"msgoff"},
{"bg",file="bg048g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
"A simple vista, era un simple cuaderno de clases. La siguiente clase estaba a\npunto de comenzar al momento que me lo dio, así que no pude preguntar nada\nrespecto a su contenido.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"En el instante que lo abrí casualmente y le eché una ojeada, lo cerré de golpe.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Lo que había adentro era un escrito con una letra hermosa y fácil de leer\nreferente a... ehm, bueno, 'ese' tema. Todo muy detalladamente explicado, y\nsencillo de entender.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Al voltear a ver a Rin-chan, esta me devuelve la mirada con un saludo de la\nmano, luciendo alegre. ¡No, no es eso! ¡No se trata de eso, Rin-chan!",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
"Por Dios... Jaa. Realmente no sé qué hacer con esto... Además, me da mucha\npena...",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Sin embargo, pensando las cosas fríamente, no cabe duda de que es necesario\ntener algo de conocimiento al respecto. Seguramente esto es solo una muestra\nde afecto por parte de Rin-chan.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Pero... ¿En qué momento habrá escrito todo esto? No creo que lleve estos\napuntes consigo a todas partes, ¿o sí?",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"¿O será que recopiló todo durante toda la clase anterior?... ¿Sin ver nada?",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Sea cual sea la opción correcta, eso no cambia lo descabellado que es todo\nesto. Rin-chan es, de verdad, una chica rara.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",id=1,file="se1895"},
{"msgoff"},
{"bg",file="bg048e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
"Suena la campana y comienza el receso del mediodía. Lamentablemente, hoy no\ntraje nada para comer.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Aunque, quizás quede algo de arroz para cocinar en la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"El arroz es un alimento perecedero así que no es recomendable dejarlo sin tocar\npor tanto tiempo. Pero bueno, seguramente todavía se puede comer.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"se",file="se9012",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg046e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mmm?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"Justo antes de entrar a la sala de arte, siento la presencia de alguien\nadentro. Parece que hay alguien gruñendo...",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Abro la puerta lentamente, procurando no hacer ruido.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"se",id=1,file="se1279"},
{"msgoff"},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003535",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh～”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Se escucha la voz de Toritani, pero no la veo por ningún lado. ¿Estará por el\ndesván?",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",y=-340,x=-960,file="zbg051a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2c0100",face="c0001",head="mak_z2c",lv=5,id=9,sync=0},
{"bg",lv=9,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",rule="083r",vague=40},
{"fgact",ch="真琴",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003536",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uhhh～～～～”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Toritani estaba sentada de cuclillas en el desván, gruñendo mientras tenía un\ncuaderno abierto frente a ella.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Está tan concentrada que ni se dio cuenta de mi presencia. ¿Será que está\npreocupada por el asunto de la obra para la exposición?",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fgact",ch="真琴",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
},
vl02={
{"fgact",ch="真琴",act="びっくり",size=5,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003537",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, ah... esto, no puede... Nadie haría esto en su sano... N-No puede ser...\nI-Incluso esto...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"¿¿¿¿Q-Qué está sucediendo????",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fgact",ch="真琴",act="おじぎ",time=1000,lv=5,id=9},
{"fgact",ch="真琴",act="いいえ",time=300,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003538",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“N-No puedo hacer esto...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Toritani se desplomó sobre el suelo, con sus ojos dando vueltas.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, tampoco te exijas tanto. ¿Estás bien?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"bgm",stop=1,time=300},
{"msgoff"},
{"cgdel",time=300,lv=5,id=5,rule="cinema"},
{"ex",time=0,func="wait"},
{"se",file="se3130",id=1},
{"fg",ch="真琴",size="z2",time=300,mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0014h",head="mak_z2a",lv=5,id=9},
{"cgact",stage="bg051",act="いいえ",size=20},
{"ex",time=300,func="wait"},
{"msgoff"},
{"bg",file="bg051a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=200},
{"fg",ch="真琴",size="z1",my=40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1d0100",face="d0014h",head="mak_z1d",lv=4,id=9},
{"se",file="se3130",id=1},
{"bgm",file="bgm031"},
{"quake"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003539",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡¡Mmm!!!”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Toritani se para de un solo golpe y esconde el cuaderno tras su espalda.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0014",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="quake",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003540",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Es, es, es, e-e-e-estuviste viendo?!”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, estuve viendo... lo siento. A nadie le gusta que lo vean sufrir en medio\ndel proceso de creación de una obra, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0017",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003541",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sufrir... en medio del proceso de creación de una obra?...”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es eso?”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0013",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="いいえ",lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0018h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003542",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“S-Sí lo es, por supuesto que sí, sí. He estado muy preocupada por eso, sí.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te entiendo. Cuando quieras puedes venir y hablar conmigo. Hay veces que hablar\ncon alguien te quita el peso de encima, e incluso podrías llegar a conseguir\nun nuevo punto de vista.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0011h",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003543",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“S-Sí... gracias.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Toritani me da las gracias entre murmuros mientras aparta su mirada. Tiene la\ncara roja, y está sorpresivamente dócil. Una reacción rara, viniendo de ella.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"Aunque se ve linda.",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Pero bueno... fue apenas ayer que hicimos eso... Supongo que no se le puede\nculpar.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Se ve linda.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",speed=200000,file="zbg031a",path=":bg/",x2=960,y2=100,x=0,y=100,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm009"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003544",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias por venir.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_bit_000037",ch="bit"},
},
ja={
{
name={"Muchacha"},
"“Makoto-san, Makoto-san.”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003545",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué sucede?... ¿Eh? Pero... sí, así es... pero...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"(¿...?)",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Detengo mi mano mientras escribía sobre el cuaderno. ¿Habrá ocurrido algún\nproblema?",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0910",face="a0027",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003546",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Uwah.”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Toritani estaba ahora frente a mí, más cerca de lo que pensaba.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede? Tienes una cara bien rara.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0018",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003547",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Disculpa entonces. Vine al mundo con esta cara.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, ¿qué es lo que pasa?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0017",head="mak_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0910",face="a0009",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003548",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me exigieron que tomara un descanso. Lo admito, no he tomado mis descansos como\ndebería ser... Y si me sacan la ley como argumento no me queda más opción que\nobedecer.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="真琴",mode=-1,lv=5,id=9},
{"text"},
text={
ja={
{
"Mientras dice eso, Toritani se sienta en el otro lado de la mesa, frente a mí.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"La mesa está del lado de la ventana, y gracias a que está oculta por las\nplantas decorativas, los clientes no pueden ver a Toritani desde donde están.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",x=500,y=-120,file="zbg031a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"bg",file="zchair1",id=3,lv=3,zoom=70,x=310,y=10,path=":cg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"fg",ch="真琴",size="z2",my=-40,mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0015",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"se",file="se3214",id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003549",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Todas han estado muy pendientes de mí porque viniste hoy... Dios...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Toritani se queja entre murmuros, por cosa rara, y abre el libro que trajo\nconsigo.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vas a leer?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0027",head="mak_z2a",x=0,y=50,lv=5,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003550",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, solo para despejarme un rato. La verdad es que quisiera estudiar, pero...\nya cumplí con mi cuota semanal de vocabulario de inglés, y no tengo mucho\ntiempo como para adelantar el contenido de las clases...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0012",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003551",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, Kusanagi, si hay algo que no entiendas te puedo explicar.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obedece a tus empleadas y descansa. Si te pones a explicarme ya no sería un\ndescanso para ti, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003552",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Creo que yo también me tomaré un descanso.”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003553",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien, ¿pero has avanzado?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, perfectamente. Hice todo esto.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0012",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0028",head="mak_z2a",x=0,y=50,lv=5,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003554",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Je... has avanzado bastante. Muy bien, muy bien.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, ¿qué andas leyendo?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0012",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003555",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Mm? Esto.”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"se",file="se9010",vol=60,id=1},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"fgact",ch="真琴",act="うなづく",lv=5,id=16},
{"text"},
text={
ja={
{
"Toritani me muestra la portada del libro.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo compraste tú?”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0003",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003556",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por supuesto que no. La dueña dejó una buena cantidad de libros en el segundo\npiso, y los estoy leyendo ahora.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Toritani acaricia la portada de cubierta dura del libro, un tanto quemada por\nel sol.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003557",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“También habían en la casa. Así como este.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En la casa de tu familia?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fgact",ch="真琴",act="うなづく",lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003558",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, en la de los Toritani. Lo que había escrito en la faja del libro me dejó\nuna impresión tan fuerte que aún recuerdo lo que decía.”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué decía?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0028",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003559",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“'Cuando el amor no florece, florece todo lo que amor no es.'”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cuando el amor no florece, florece todo lo que amor no es... eh.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003560",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A veces se me hace bastante curioso el trato tan preciado que se le da al amor.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003561",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay tantos cuentos e historias del estilo de 'Por ti me enfrentaría con el\nmismo mundo', o cosas así. Es lo mismo a decir que te enfrentarías con el\nmundo por el amor, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0026",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003562",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El amor se relata como un ideal, como algo bello y sin igual. Hay una tendencia\na darle el mismo peso en la balanza al amor que todo lo demás.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003563",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Será que acaso el amor vale tanto como todo lo demás? ¿Si ponemos el amor de\nun lado y todo lo demás del otro, estaría igualmente equilibrada la balanza?”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0027",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003564",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"Toritani acaricia la portada del libro una y otra vez, con la mirada echada\nhacia abajo, como si estuviera inmersa en sus pensamientos.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003565",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Suponiendo que, de florecer el amor, florecieran solo tragedias y calamidades,\nsería terrible...”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003566",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003567",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hay algo... algo, que si de sacrificar el amor, pudiera obtener... quisiera\ntener...”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya cosa que dices frente a tu novio.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Toritani alza su mirada, y me mira.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0003",head="mak_z2a",x=0,y=50,lv=5,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003568",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, tienes razón... pero...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003569",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tanto en la realidad como en la ficción hay una gran cantidad de hombres que\ndejan al amor de su vida y se marchan, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0028",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003570",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Buscando lograr hacer algo realidad. Por el honor, por sus ideales, por la paz,\npor la justicia... Por algo hermoso, que no es necesariamente amor...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003571",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“O quizás... buscando sacrificar su vida por algo feo y terrible, distinto al\namor.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0027",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003572",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El amor es algo tan, pero tan grande, que quizás sea imposible que conviva con\nlas otras cosas importantes que hay... No soy hombre para saberlo, pero creo\nque lo puedo entender.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003573",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo deberías entender mejor tú que yo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No. En realidad, no.”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"Toritani abre sus ojos y parpadea ante mi súbita respuesta.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0012",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003574",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Y es que los hombres de la familia Kusanagi... suelen dar sus vidas por el\namor.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0008",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0028",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"fgact",ch="真琴",act="うなづく",lv=5,id=16},
},
},
text={
vo={
{"vo",file="fem_mkd_003575",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Entiendo... sí, ya veo.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0027",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003576",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El amor...”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"se",file="se2497",vol=50,id=1},
{"fgact",ch="真琴",act="うなづく",size=5,lv=5,id=16},
{"text"},
text={
ja={
{
"Toritani hojea el libro. Pasa las páginas sin leer, y entonces lo cierra.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003577",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero hay algo que quiero. Como sea. Algo de lo que no puedo resignarme. Algo\nmuy preciado... y que quiero cumplir, de cualquier manera.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por el bien de los genios, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0001",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"fgact",ch="真琴",act="うなづく",lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003578",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás no lo parezca, pero yo también estoy tratando de entender lo que\nquieres.”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0900",face="a0002",head="mak_z2a",x=0,y=50,lv=5,id=16},
{"fgact",ch="真琴",act="うなづく",lv=5,id=16},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003579",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
