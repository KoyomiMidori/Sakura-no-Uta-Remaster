astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo IV"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg067c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=2000},
{"text"},
text={
ja={
{
"El cuarto del hospital estaba ya en completa oscuridad.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Solo familiares están autorizados para visitas a esta hora.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Pero Wakata seguía sentado frente a Kenichiro.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"bg",file="ev_com_g01_06",path=":ev/ev_com_g01/",set="ev_com_g01"},
{"bgm",file="bgm001"},
{"text"},
text={
vo={
{"vo",file="man_wkd_000102",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Seguramente Mizuna-san solo quería protegerlos a todos.”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
vo={
{"vo",file="man_kid_000478",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, pensó que de verdad ocurriría una masacre.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
vo={
{"vo",file="man_wkd_000103",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Jamás se imaginaría que se trataba de un avanzado truco de negociación de\n la Yakuza, eh.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
vo={
{"vo",file="man_kid_000479",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Aunque igualmente la abuela quedó satisfecha con esa elección, al parecer.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="man_wkd_000104",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Satisfecha?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
vo={
{"vo",file="man_kid_000480",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Supongo que quedó encantada con Mizuna.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
vo={
{"vo",file="man_kid_000481",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Aunque no lo pareciera, la abuela creía fuertemente en el honor.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
vo={
{"vo",file="man_wkd_000105",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Pero la negociación terminó fracasando, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"bg",file="ev_com_g01_08",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000482",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No. Fue mejor así, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="man_kid_000483",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“La abuela vio que ella estaba dispuesta a hacer lo que fuera. Así que fue a mí\na quien reclamó.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
vo={
{"vo",file="man_kid_000484",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“'Ya la mujer tomó su decisión. Ahora falta que el hombre actúe. ¿Eres capaz de\nasumir la tarea?'. Eso dijo, básicamente.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
vo={
{"vo",file="man_wkd_000106",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"bg",file="ev_com_g01_06",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000485",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Un poco después de la negociación, me llevé a Mizuna y huimos juntos.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="man_kid_000486",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Bueno, supongo que fue una huida romántica para ustedes...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="man_kid_000487",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero en realidad fue más como un secuestro. Mizuna no quería irse.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="man_kid_000488",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Estaba preocupada de que algo malo le pasara a Ai si ella huía.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
vo={
{"vo",file="man_wkd_000107",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Pero no había nada de qué preocuparse, ¿no? Después de eso la residencia\nKootoha se convirtió en la residencia Natsume.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="man_kid_000489",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí. No creí que la vieja esa llegaría a hacer tanto por nosotros.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="man_kid_000490",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De Ai y la casa me preocupo yo, ustedes huyan y ocúpense de ustedes mismos. Eso\nquiso decirnos la abuela.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="man_kid_000491",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Aunque bueno, la enormidad de la casa ayudó después de todo. La tropa podía\nentrar y salir con facilidad, y Ai pudo criarse bien.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="man_wkd_000108",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Ai-san quería mucho a la abuela Natsume.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"bg",file="ev_com_g01_07",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000492",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, y me imagino que por eso Ai todavía ama esa casa...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
vo={
{"vo",file="man_wkd_000109",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Pero vaya agallas que tuvo para pensar en huir con ella, eh. Los Nakamura eran\nmuy violentos todavía para esa época, ¿no? Quizá no tanto como los Natsume,\npero igual.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"bg",file="ev_com_g01_06",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000493",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Al contrario, al contrario, si no me hubiese llevado a Mizuna probablemente los\nNatsume me habrían obligado a cortarme el dedo...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="man_wkd_000110",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Cortarse el dedo? Claro que no, es absurdo. Usted es el nieto de la mismísima\nseñora Natsume, Kenichiro-san.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="man_kid_000494",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Eso no sirve de nada. Esa abuela está convencida de que cuando una mujer se\ndecide por algo el hombre debe actuar para cumplir eso.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
vo={
{"vo",file="man_kid_000495",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Mizuna y yo huimos. Y fue divertido, la verdad. Visitamos muchos lugares que\nella jamás había visto. Incluyendo Estados Unidos.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="man_wkd_000111",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Muy alegre para tan dramático inicio, eh.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="man_kid_000496",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Alegre? No me jodas. Los imbéciles trataron el secuestro de Mizuna como un\npréstamo. Es decir, una deuda.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
vo={
{"vo",file="man_kid_000497",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Después de la amenaza de la abuela no se atrevieron a poner un 10 % por 10 días\no alguna tasa así de descabellada. Pero fue alta, muy cercana al límite\nlegal.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
vo={
{"vo",file="man_wkd_000112",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Pero fue por esa deuda que Mizuna-san pudo regresar de nuevo a la residencia,\n¿no? A la residencia Natsume.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"bg",file="ev_com_g01_07",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000498",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="man_wkd_000113",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Ya veo, eso le da algo de sentido al tema anterior.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"bg",file="ev_com_g01_06",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000499",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Al tema anterior?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
vo={
{"vo",file="man_wkd_000114",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“De lo que me contó antes de esta historia. De la muchacha que se trajo de Nueva\nYork.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"bg",file="ev_com_g01_08",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000500",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, sí. Sí, bueno, algo así.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
vo={
{"vo",file="man_kid_000501",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es parecido a lo de Mizuna. Aunque hay algo más problemático.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="man_wkd_000115",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Fuh, y ahora decidió dejarle toda la responsabilidad a Naoya, ¿eh?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"bg",file="ev_com_g01_06",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000502",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es. Naoya es mi hijo, y también bisnieto de Kotoko Natsume.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="man_wkd_000116",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Vaya confianza que le tiene, eh. Aun después de haberlo abandonado por tanto\ntiempo.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"bg",file="ev_com_g01_06",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000503",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Claro que no, idiota. Fue él quien huyó de Nueva York. Y yo que pensaba\nenseñarle todo lo que sé de la pintura...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"bg",file="ev_com_g01_08",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000504",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Naoya, eh...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="man_kid_000505",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Naoya se parece a mí, pero también a Mizuna...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"bg",file="ev_com_g01_07",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000506",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Todavía recuerdo el día en que nació.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"bg",time=1500,file="white",path=":bg/"},
{"bg",file="ev_com_g04_01",time=2000,path=":ev/ev_com_g04/",set="ev_com_g04"},
{"text"},
text={
vo={
{"vo",file="man_kid_000507",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fue algo curioso ver nacer a la criatura que procreé.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="man_kid_000508",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ver a una personita que hasta ahora no existía.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="man_kid_000509",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y que se materializó en este mundo como hijo mío y de Mizuna.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="man_kid_000510",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es algo normal. Muy normal para cualquier ser vivo... pero se siente muy\nextraño cuando te sucede.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="man_kid_000511",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es algo común y corriente, pero en sí hay una rareza similar a la de un\nmilagro.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="man_kid_000512",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es realmente extraño procrear a un niño.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="man_kid_000513",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Más aún el hecho de que crecerá, de que me sobrepasará algún día y emprenderá\nel camino por delante.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="man_kid_000514",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y de que, aunque yo me detenga acá, él seguirá el resto del camino...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
vo={
{"vo",file="man_kid_000515",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es una sensación extraña...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
vo={
{"vo",file="man_kid_000516",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“La extrañeza de la sangre.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="man_kid_000517",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“La extrañeza en la familia...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"bg",file="ev_com_g01_06",path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000518",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por cierto, Wakata, ¿no piensas casarte?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="man_wkd_000117",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“No tengo con quien.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="man_kid_000519",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Casarse es genial, te lo digo. Es de lo mejor cuando lo haces con la persona\nque realmente amas.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="man_wkd_000118",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"bg",file="ev_com_g01_07",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000520",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Aunque a final de cuentas tuve que viajar solo afuera por trabajo.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
vo={
{"vo",file="man_kid_000521",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Me fui hasta Nueva York para conseguir el dinero de la deuda.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bg",file="ev_com_g01_08",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000522",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Conocí a Fridmann allá, y me propuso hacer dinero con pinturas. Fui haciéndome\npopular, pero de igual forma me costaba mantenerme al día con los intereses.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
vo={
{"vo",file="man_wkd_000119",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Sí, bueno, fue mucho después que ganó el Platine Épaulard...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
vo={
{"vo",file="man_kid_000523",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, después de que Mizuna falleciera.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="man_kid_000524",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fue después de su muerte que pude terminar 'Cerezos recostados'.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="man_kid_000525",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vaya ironía, sí señor. Cuando Mizuna estaba viva lo único que pensaba era en\ncómo conseguir dinero, y aun así no conseguí nada.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="man_kid_000526",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fue después de que ella murió que pude completar la obra y ganar el premio\nmayor de la más grande exposición de todas, el Platine Épaulard de la\nExposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
vo={
{"vo",file="man_wkd_000120",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Por qué decidió pintar cerezos después de que Mizuna-san falleciera?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"bg",file="ev_com_g01_07",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000527",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Fue en época de cerezos que nos conocimos... pero no, la razón es más\ncomplicada.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="zev_uni_c04_01",speed=300000,time=2000,path=":ev/ev_uni_c04/",set="ev_uni_c04",x2=960,y2=0,x=-960,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
vo={
{"vo",file="man_kid_000528",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Una ilusoria apariencia del color de primavera, recubriendo el cielo. Solo\nalumbra, brillante, radiante, deslumbrante, ciegamente, sin pensarlo, esa\nlámpara de causalidad enlazada.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="man_kid_000529b",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Un magneto de sandía, el punto de cruce del sonido y las palabras, cada vez más\ndentro de un mundo excesivamente coloreado.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="man_kid_000530",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Los siete cerezos me sobrepasaron.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="man_kid_000531",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vinieron hacia mí y me sobrepasaron.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="man_kid_000532",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Más allá del paisaje, no estoy yo, y más allá de mí, no está el paisaje.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="man_kid_000533",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Persiguen, sobrepasan, y desaparecen.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="man_kid_000534",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y este mundo suavemente envuelto va desapareciendo.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="man_kid_000535",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El mundo resonó, dentro de ese suave bosque de cerezos. El mundo resonó con un\nhermoso tono.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="man_kid_000536",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Si eso es el vacío, entonces el mismo vacío es así, Y hasta cierto grado, es\ncompartido por todos.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="man_kid_000537",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"(Y así como el todo son todos dentro de mí, también así es el todo dentro de\ncada uno de todos)",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"bg",file="ev_com_g01_07",path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_wkd_000121",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Es el poema escrito detrás del lienzo de 'Cerezos recostados'.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"bg",file="ev_com_g01_06",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000538",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
vo={
{"vo",file="man_wkd_000122",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Qué significado hay en ese poema?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="man_kid_000539",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El mismo poema lo dice. Lo escribí para comunicar eso, así como está escrito.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="man_wkd_000123",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Así como está escrito... Qué poema tan enigmático, si me permite decirlo...”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"bg",file="ev_com_g01_08",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000540",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Enigmático?... ¿Eso crees? Bueno, tal vez...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="man_kid_000541",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Cuerpo, y corazón... Mizuna nunca dejó de ser atormentada por esos dos.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="man_kid_000542",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es muy fácil pedirle a alguien que cuide de sí. Que lo hagan, no tanto.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
vo={
{"vo",file="man_kid_000543",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero después de todo, el corazón y el cuerpo son exactamente la misma cosa...\nEs solo un problema de perspectiva...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="man_kid_000544",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y a pesar de eso, las personas siguen percibiendo corazón ahí.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
vo={
{"vo",file="man_kid_000545",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y es cuando lo perciben que el corazón existe.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="man_kid_000546",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“A veces este atormenta a las personas, y consume su cuerpo poco a poco...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="man_wkd_000124",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Pero es ese mismo corazón el que nos da felicidad.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"bg",file="ev_com_g01_07",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000547",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“... Esta noche, hace casi nada, soñé que moría. Y por cosa extraña, fue justo\nen el instante en que recordé lo feliz que fui viviendo.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="man_kid_000548",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Dentro del sueño, un ángel de alas blancas vino hacia mí con una sonrisa.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
vo={
{"vo",file="man_kid_000549",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“A su lado estaba un anciano con un enorme reloj de arena.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="man_kid_000550",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De nada sirve que me preguntes, me dijo el ángel.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="man_kid_000551",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sé lo que estás pensando.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="man_kid_000552",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pídele a este viejo hombre que te guíe después al Infinito.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="man_kid_000553",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así sabrás lo que Dios tiene en mente para ti, y descubrirás lo lejos que estás\nahora de ser completo.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="man_kid_000554",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué sería de la labor del Creador de hacerse todo en un solo día?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
vo={
{"vo",file="man_kid_000555",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Dios nunca descansa...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"bg",file="ev_com_g01_08",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000556",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="man_wkd_000125",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿De qué está hablando?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bg",file="ev_com_g01_06",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000557",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Del sueño que tuvo antes de morir un salvaje francés que viajó al sur hace 100\naños.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
vo={
{"vo",file="man_wkd_000126",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Un salvaje francés?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"bg",file="ev_com_g01_07",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000558",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Olvídalo...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="man_kid_000559",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es el corazón lo que nos lleva a sentir felicidad...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="man_kid_000560",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Es así, pero encontrar esa felicidad, eso sí es difícil.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
vo={
{"vo",file="man_wkd_000127",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Es difícil encontrar la felicidad?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"bg",file="ev_com_g01_06",sync=0,face=1,time=400,path=":ev/ev_com_g01/",set="ev_com_g01"},
{"text"},
text={
vo={
{"vo",file="man_kid_000561",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Exactamente. De la misma forma que este licor...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"se",file="se9010",vol=50,id=1},
{"bg",time=1000,file="black",path=":bg/"},
{"bg",file="ev_com_g05_01",time=2000,path=":ev/ev_com_g05/",set="ev_com_g05"},
{"text"},
text={
ja={
{
"Saco una botella de whisky que tenía debajo del futón.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="man_wkd_000128",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿E-Era verdad lo de que había conseguido licor?”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="man_kid_000562",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, es una botella de mi colección secreta. Lo compré en Estados Unidos.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="man_wkd_000129",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Pero es un whisky japonés, puedo ver.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"bg",file="ev_com_g05_02",sync=0,face=1,time=400,path=":ev/ev_com_g05/",set="ev_com_g05"},
{"text"},
text={
vo={
{"vo",file="man_kid_000563",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Lo es. Es un licor japonés que estaba a la venta al otro lado del mundo, y por\neso mismo lo compré.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="man_kid_000564",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Estaba bien caro, y por eso se me ocurrió, 'lo abriré en el mejor momento de mi\nvida'.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="man_wkd_000130",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“Pero no lo ha abierto aún.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"bg",file="ev_com_g05_01",sync=0,face=1,time=400,path=":ev/ev_com_g05/",set="ev_com_g05"},
{"text"},
text={
vo={
{"vo",file="man_kid_000565",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué no es obvio? Lo mejor siempre lo descubrimos después de que ocurre.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
vo={
{"vo",file="man_wkd_000131",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Los mejores momentos... los descubrimos después?...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="man_kid_000566",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tal cual. Es difícil dar con uno.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="man_kid_000567",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Varias veces me he puesto a pensar y he descubierto que he tenido varios de\nesos momentos.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="man_kid_000568",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tuve una vida muy afortunada, sí...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
vo={
{"vo",file="man_wkd_000132",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Una vida... afortunada? Sinceramente, una persona normal no diría lo mismo\nteniendo la vida tan tormentosa y movida que tuvo usted.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="man_kid_000569",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"bg",file="ev_com_g05_02",sync=0,face=1,time=400,path=":ev/ev_com_g05/",set="ev_com_g05"},
{"text"},
text={
vo={
{"vo",file="man_kid_000570",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero ¿sabes qué? Hace poco di con el mejor momento de mi vida.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="man_kid_000571",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así que abriré este pequeño ya.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="man_wkd_000133",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“¿Ya?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="man_kid_000572",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="man_kid_000573",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Me acompañas a unos tragos?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="man_wkd_000134",ch="wkd"},
},
ja={
{
name={"Wakata"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Wakata asintió con un ligero movimiento.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"La felicidad es como una ilusoria apariencia de primavera recubriendo el cielo.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Es como una manada de lámparas de muchos colores cuyas luces comienzan a\naparecer poco a poco, sin cuerpo alguno.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Los cerezos que vi ese día, la muchacha que vi ese día.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"¿Será que ese paisaje me sobrepasó y se fue a algún lugar?",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"¿O será que lo olvidé en algún lado?",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Siete sufrimientos, siete felicidades.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Entre ellas oscilamos.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Como un péndulo.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
"Y por eso――",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"bg",file="ev_com_g05_01",path=":ev/ev_com_g05/",set="ev_com_g05"},
{"text"},
text={
vo={
{"vo",file="man_kid_000574",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sonríe y brinda conmigo.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="man_kid_000575",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por la vida que tuve.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="man_kid_000576",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y por los momentos de felicidad que vendrán.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
