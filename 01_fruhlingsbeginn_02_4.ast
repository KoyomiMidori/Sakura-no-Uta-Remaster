astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"se",file="se1279",id=1},
{"fg",ch="真琴",size="z1",mx=40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mx=40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"bgm",file="bgm037"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000421",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así que la traje acá.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000190",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, h-hola, muchachos...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="man_ked_000625",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Cómo que 'así que'?... ¿No te parece demasiado pronto? Solo han pasado 5\nminutos desde entonces...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Volviste a secuestrar de nuevo?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0006",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000422",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No lo he hecho!”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000191",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No es cierto. Yo encontré a Toritani-san y le hablé.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad? Eso me huele a mentira, eh. Rin, siempre eres rápida para defender\na los demás.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="man_ked_000626",ch="ked"},
},
ja={
{
name={"Kei"},
"“Quizás incluso le ordenaron que dijera eso...”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000423",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ustedes dos, ¿quieren ser golpeados?...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="真琴",mode=-1,lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1b0210",face="b0003",head="rna_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_000051",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bienvenida, Misakura-senpai.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000192",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Rina-chan. Así que pertenecías al club de arte.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0004",head="rna_z1b",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0200",face="b0008",head="rna_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rna_000052",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí. Aunque, debería acotar que desde hace poco. Desde el receso del mediodía.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000193",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo. Entonces eres mi senpai por tres horas, Rina-chan.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="里奈",mode=-1,lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0220",face="a0003",head="yum_z1a",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000044",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Misakura-senpai, es un placer. Soy Yuumi Kawachino, de primer año. Espero que\npodamos llevarnos bien.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Kawachino saluda de manera educada. Con una actitud completamente diferente a\nla que toma con nosotros...",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000194",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Es un placer para mí también. Me llamo Rin Misakura. Soy de tercer año, fui\ntransferida este período.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="優美",mode=-1,lv=4,id=5},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0003",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000424",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“También falta un tipo llamado Akashi que aún no ha podido graduarse, pero en\ngeneral, nuestro club de arte está conformado por estas caras.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000195",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Son todos? ¿Eh? ¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0012",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000425",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000196",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, Kusanagi-kun... ¿Y la hermanita de Kei-kun?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000627",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000426",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿La hermanita de Kei? ¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000197",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Ayer tu hermanita estaba repartiendo folletos del club de arte, ¿no? Era\nbastante linda, y le quedaba muy bien el uniforme de maid.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"bgm",vol=0,file="bgm037"},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",time=300,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000628",ch="ked"},
},
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"El tiempo se congela por un instante.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Un aire inerte se cernió en la sala. Algo así como un extraño silencio, o\ndebería decir, un retraso de tiempo mientras las palabras de Rin llegaban a\nnuestros cerebros...",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"La primera que rompió con ese extraño silencio, fue, como cosa obvia... la risa\nde Toritani.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"bgm",vol=100,file="bgm037"},
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0004",head="mak_z1a",lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000427",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Buh... K-Kukuku. ¡Nyajajajajajajaja!”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kuh...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"En lo que a mí respecta, suelto una risa irónica.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Podría reírme. Pero, fui yo quien creó la causa, así que si llego a reírme\nfuertemente acá, no sé qué me podría hacer Kei después.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Y en lo que respecta a Rin, esta nos veía alternadamente a mí, ahora viendo\nhacia abajo y conteniendo la risa de tanta incomodidad, y a Toritani, quien\nhabía comenzado a reír repentinamente.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0004",head="mak_z1a",x2=0,x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000198",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, l-lo siento, ¿dije algo raro?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Kuh... kukuh...”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0004",head="mak_z1b",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000428",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ajajajajajaja... Su hermanita, eh. Sí, ciertamente, pareciera serlo, ajajajaja.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="icon",lv=4,id=6,icon="icon02z1",x=40,y=-550},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000199",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Esto...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fgact",ch="稟",act="停止",lv=4,id=6},
{"text"},
text={
ja={
{
"Sin poder entender absolutamente nada de lo que pasaba, Rin estaba parada sola,\ncasi con un signo de interrogación intermitente encima de su cabeza.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0008",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0010",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000200",ch="rnd"},
},
ja={
{
name={"Rin"},
"“L-Lo siento. ¿Q-Quizás dije algo verdaderamente extraño? ¡Lo dije, ¿cierto?!\n¡Lo siento tanto!”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="真琴",mode=-1,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x=-345,lv=4,id=9},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000629",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, no, tú no tienes la culpa en este caso, Rin-chan... ¡Probablemente el\nculpable eres tú! ¡Naoya!”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No había otra manera. ¿O es que acaso hubieras preferido que le revelara en ese\nmomento que tú eres un pervertido con tendencias travestistas?”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0022",head="kei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000630",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Cómo que un pervertido con tendencias travestistas?! ¡Y espera un segundo!\n¡¿Qué pretendes diciéndolo ahora?!”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000201",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eh...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"fgact",ch="圭",act="icon",lv=4,id=9,icon="icon18z1",x=-150,y=-550},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000631",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡N-No es así! ¡Yo no tengo esa clase de gustos! ¡Fue Makoto quien me obligó a\nhacerlo!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000202",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah, sí!”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Rin está completamente paralizada. Solo puede quedarse parada sin hacer nada.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0020",head="kei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000632",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Eh! ¡Pero si estás completamente repugnada de mí!”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0013",head="rin_z1b",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0200",face="d0008",head="rin_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000203",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no. No estoy repugnada, estoy asombrada. Porque, te veías muy lindo...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás para ti sea un cumplido, pero no se lo digas mucho. Kei es muy sensible\nrespecto al asunto de que lo vean como mujer.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0023",head="kei_z1a",x=-345,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000633",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No trates de apoyarme nada más en estos momentos! ¡Es más triste aún!”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1d0200",face="d0011",head="rin_z1d",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000204",ch="rnd"},
},
ja={
{
name={"Rin"},
"“L-Lo siento. Y-Yo...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_mkd_000429",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien, es lo mismo de siempre, así que no te preocupes mucho.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000634",ch="ked"},
},
ja={
{
name={"Kei"},
"“Por más que sea lo mismo de siempre no significa que esté bien.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0010",head="rin_z1b",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0008",head="rin_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000205",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Lo siento... Lo siento tanto, de verdad. A pesar de no saber nada al respecto,\nmencioné algo tan sensible para ti...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0008",head="kei_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000635",ch="ked"},
},
ja={
{
name={"Kei"},
"“A-Ahh, no te preocupes, Rin-chan.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Rin se disculpa, luciendo apenada.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Y por otro lado, Kei sonríe con una expresión totalmente enervada.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="圭",mode=-1,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0003",head="mak_z1d",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000430",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, volviendo al tema del club de arte.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000206",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, quisiera entrar con todo gusto.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, ¿hablas en serio?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
vo={
{"vo",file="man_ked_000636",ch="ked"},
},
ja={
{
name={"Kei"},
"“Rin-chan, ¿estás segura que Makoto no se está aprovechando de algun asunto\ndelicado tuyo? Tienes que mantenerte atenta. Si en algún instante llegas a\nmostrarle alguna debilidad a Makoto, se aprovechará de ti y te comerá por\ncompleto.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0017",head="mak_z1d",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0002",head="mak_z1d",x=-345,lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0016",head="mak_z1d",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000431",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Realmente a ustedes dos les encanta hablar y decir esto y aquello, eh.\n¡Escuchen atentamente! ¡Misakura-san dijo, por voluntad propia, que quería\nentrar a nuestro club de arte del colegio Yumihari!”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000207",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Así es. Di un recorrido por todos los clubes del colegio Yumihari, y me pareció\nque el club de arte era el mejor... Eso pensé.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0009",head="mak_z1d",x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000432",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué la cara complicada, Naoya? ¿Aún estás dudoso?”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es eso. Solo que...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0012",head="mak_z1d",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000433",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Solo que?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin, ¿vas a pintar?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000208",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Sí. ¿H-Hay algún problema?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, me parece bien. Me parece que no hay ningún problema, creo...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0017",head="mak_z1d",x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0001",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000434",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué es eso? Qué manera tan extraña de decir las cosas, eh.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no te preocupes. En fin, la persona que deseabas entró al club, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0022",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0028",head="mak_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000435",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Pensé que nos bajarían de categoría de club a agrupación por la falta de\nmiembros, pero parece que pudimos reunir nuevo personal sin bajar la calidad.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="man_ked_000637",ch="ked"},
},
ja={
{
name={"Kei"},
"“Por cierto, con ella ya somos finalmente cinco, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso quiere decir que ya estamos seguros. Después de todo, Toritani estaba\ninquieta por eso.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000436",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tampoco estaba así. Pero es un alivio. Este es mi último año, y también tengo\ncosas que quiero hacer...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cosas que quieres hacer?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000437",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Cosas que quería hacer en caso de volverme jefa.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tenías eso?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0004",head="mak_z1a",x=-345,lv=4,id=9},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0003",head="mak_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_000438",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, eso da igual. En fin, ahora tenemos a 3 nuevos integrantes. ¡Hoy marca\nel comienzo del renovado club de arte de Yumihari! Comenzando con Yuumi\nKawachino-san, de primer año.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="稟",mode=-1,lv=4,id=6},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0003",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000045",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es un placer.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="優美",mode=-1,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",x=-345,lv=4,id=9},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0002",head="rna_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000439",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Rina Hikawa-san, también de primer año. Parece que ya conocías a Kusanagi y a\nKei, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0003",head="rna_z1b",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000053",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, conocí a los senpai por una cierta y particular circunstancia.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="里奈",mode=-1,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0003",head="mak_z1a",x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000440",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y la última de los nuevos miembros es Rin Misakura-san. Es amiga de la infancia\nde Kusanagi, y parece que estuvo un buen tiempo fuera de esta ciudad, pero\nvolvió este año.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000209",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Espero que podamos llevarnos bien todos.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="稟",mode=-1,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",x=-345,lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000441",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y este es Kei Natsume, de tercer año. Desde pequeño ha sido conocido y temido\npor arrasar con los premios en toda clase de exhibiciones de pintura.”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="稟",mode=-1,lv=4,id=6},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000638",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ouh, sí es por número de premios, estoy por encima de Naoya.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="圭",mode=-1,lv=4,id=6},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",x2=-345,x=0,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000442",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y aquella quien a partir de este año se volvió la nueva jefa del club de arte,\nmi persona, Makoto Toritani.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_rna_000054",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Desde este año? ¿No se supone que normalmente los jefes de club se retiran por\nverano? ¿El jefe anterior estuvo en el cargo hasta justo antes de graduarse?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0016",head="mak_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000443",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí, normalmente es hasta verano. Aunque durante generaciones, se ha vuelto\nuna tradición que los jefes del club de arte de Yumihari ocupen su cargo\nhasta el final del otoño.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_yum_000046",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Por qué hasta el final del otoño?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",x=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000444",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso lo sabrán después.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0012",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000210",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ehm... ¿Kusanagi-kun no es miembro del club?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no lo soy.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000445",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bueh, es como si fuera un miembro más. Siempre se la pasa acá.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000211",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Entonces pintas acá sin estar inscrito?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, dejé de pintar hace bastante tiempo...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0013",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000212",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, dejé de hacerlo. Ya no pinto.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="man_ked_000639",ch="ked"},
},
ja={
{
name={"Kei"},
"“Por ahora, eh. Parece que pasó por varias cosas, y no está pintando, pero en\ncualquier momento――”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"bgm",stop=1,time=0},
{"bg",time=50,file="black",path=":bg/"},
{"se",file="se9014",id=1},
{"bg",file="ev_uni_c35_01",rule=7,time=50,path=":ev/ev_uni_c35/",set="ev_uni_c35"},
{"ex",time=0,func="wait"},
{"bg",rule=7,time=50,file="black",path=":bg/"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No! ¡No pintaré! Ya lo dejé.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0008",head="mak_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0008",head="rin_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"El pacífico aire de la sala se silenció con mis palabras.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000446",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No? ¿No dijiste varias veces que en cualquier momento volverías a pintar?”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo bromeaba. Yo no volveré a pintar jamás.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0024",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0009",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000447",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué pasa, Kusanagi? Por lo general nunca te pones así de obstinado...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, lo siento. Realmente no es la gran cosa...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0009",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000213",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kusanagi-kun, ¿cuándo dejaste de pintar?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hace ya bastante...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0010",head="kei_z1a",lv=4,id=6},
{"bgm",file="bgm108"},
{"text"},
text={
vo={
{"vo",file="man_ked_000640",ch="ked"},
},
ja={
{
name={"Kei"},
"“Aproximadamente hace 6 años.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000214",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Seis... años?...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000641",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué? ¿Por qué me miras con esa cara?...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es nada...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0011",head="kei_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000642",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Tienes algo que reclamarme, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... No, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0011",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000448",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Está bien. Dejemos este tema atrás.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_rna_000055",ch="rna"},
},
ja={
{
name={"Rina"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000449",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi es el único que puede decidir respecto a sus asuntos. En fin, ¿será\nque comenzamos las actividades del día de hoy?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000643",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué dejaste de pintar repentinamente?... Aún no he escuchado la razón.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"bg",speed=300,sync=0,file="zbg049a",path=":bg/",x2=400,y2=0,x=600,y=0,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="真琴",size="z2",speed=300,sync=0,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2b0200",face="b0006",head="mak_z2b",x2=-200,x=0,lv=5,id=5},
{"quake"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000450",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Kei!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No hay ninguna razón! Simplemente dejé de hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2b0200",face="b0005",head="mak_z2b",x=0,lv=5,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000451",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Kusanagi, basta tú también!”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",lv=4,id=6,sync=0},
{"extrans",time=500},
{"se",file="se9012",id=1},
{"fg",ch="圭",time=500,sync=1,mode=-1,lv=4,id=6},
{"fg",ch="圭",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0005",head="kei_z2a",lv=5,id=6},
{"se",stop=1,time=500,id=1},
{"text"},
text={
vo={
{"vo",file="man_ked_000644",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Simplemente dejaste de hacerlo? Eso es imposible. ¡No hay forma alguna de que\nhayas dejado de pintar sin razón alguna!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí la hay...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0006",head="kei_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000645",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No has cambiado nada, eh, Naoya! ¡Siempre lo mismo desde hace 6 años, cada vez\nque se toca el tema apartas la mirada! ¡¿Qué demonios te pasa?! ¡¿Por qué no\nme cuentas la razón por la cual dejaste de pintar?!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay razón alguna. ¡Y por ende no hay nada de qué hablar!”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0005",head="kei_z2a",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000646",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué dices?... Naoya, maldito...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Kei me observa ferozmente.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"No es la forma jocosa que tiene siempre de molestarse. Kei está verdaderamente\nenojado.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Esta es la segunda vez que Kei me observa con esos ojos. Con esos ojos, como si\nestuviera a punto de venir a golpearme.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"Es exactamente igual a aquel momento.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"A la primera vez que le dije 'dejaré de pintar'.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que no estás de nada de acuerdo, eh.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0006",head="kei_z2a",lv=5,id=6},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000647",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No lo estoy! ¡¿Acaso no es obvio?!”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sin embargo, no hay necesidad de que tú conozcas mis circunstancias. Estés o no\nde acuerdo, eso no tiene nada que ver contigo.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Después de todo, tú y yo no somos nada, solo extraños.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bgm",stop=1,time=3000},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0005",head="kei_z2a",lv=5,id=6},
{"quake",mode="mw"},
{"fgact",ch="圭",act="うなづく",size=10,lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",zoom=130,speed=100,mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0006",head="kei_z2a",y2=0,z2=100,y=110,lv=5,id=6},
{"se",file="se9015",id=1},
},
vl02={
{"se",id=2,file="se1730"},
{"bg",time=100,file="black",path=":bg/"},
},
},
text={
vo={
{"vo",file="man_ked_000648",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Qué dices?! ¡Maldito! ¡¿Con qué boca――”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
"Un explosivo sonido de piel siendo fuertemente golpeada.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000649",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh.”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Ante ese claro e imponente sonido, Kei y yo nos separamos sin querer.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Seguramente todos los que estaban ahí pensaron que fue el sonido de yo\ngolpeando a Kei.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"Sin embargo, la realidad era distinta.",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0200",face="a0006",head="mak_z1a",lv=4,id=5,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Toritani estaba juntando sus dos manos, parada entre Kei y yo.",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0019",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000452",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uhhh～”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000215",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿T-Toritani-san?!”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Parece que ese imponente sonido explosivo lo originó Toritani al extender sus\nbrazos y haber aplaudido fuertemente.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Es, lo que llaman en sumo, un 'Nekodamashi'.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
"Debe haberse forzado demasiado al hacerlo. Toritani tenía lágrimas en sus ojos\ndespués de haber producido ese sonido.",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"bgm",file="bgm110"},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000453",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“O-Oye. Kusanagi, ¿podrías enseñarle cómo pintar a Rin-chan?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
vo={
{"vo",file="fem_rnd_000216",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
"Toritani me pidió eso, aún con lágrimas en sus ojos. Debe haberle dolido\nbastante.",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
name={"Naoya"},
"“T-Tú... de qué manera vienes ahora a...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0008",head="mak_z1a",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000454",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mi petición no es nada rara, ¿no? Simplemente no pintas ya, ¿no es así? Si es\npor enseñar a pintar, sí podrías hacerlo, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="man_ked_000650",ch="ked"},
},
ja={
{
name={"Kei"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Kei sigue aún observándome fijamente.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Toritani me observa, a medio reír, con lágrimas en sus ojos.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Qué demonios tienen en mente todos...",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0013",head="rin_z1a",lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000217",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y-Yo también quisiera pedirte el favor. Sé que es algo atrevido pedir esto,\npero si aun así estás de acuerdo con hacerlo, entonces me encantaría...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"Al leer la atmósfera alrededor, Rin también se dispuso a pedirme el favor.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"Seguramente presintió que podría calmar los ánimos del lugar haciendo eso.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Rin me está pidiendo que le enseñe a pintar...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué está sucediendo? Kenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",x2=0,x=345,lv=4,id=6},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0009",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000455",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Kenichiro Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no es nada. Está bien, está bien, ¡no sé realmente qué está pasando,\npero está bien! Haré lo que me pides, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0025",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000456",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡P-Pues obvio que lo harás! Siempre usas la sala del club de arte a tu\nconveniencia, así que por lo menos eso debes hacer por mí.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Aun cuando ayer dijo que solo bastaba con que la ayudara a cazar nuevos\nintegrantes y con el festival de cultura... Esta mujer.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0005",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_000218",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Toritani-san, ¿está bien tu mano? Muéstramela, por favor.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0029",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000457",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué cosa? A-Ahh, ¿lo dices por haber palmoteado mis dos manos? Lo hice sin\nquerer porque se me ocurrió una buena idea. Fue como '¡Ah, claro, Kusanagi\npodría enseñarle a Rin-chan!'.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"¿En qué parte del mundo hay alguien que de un aplauso tan fuerte que hasta las\nlagrimas se le salen solo porque se le ocurre una buena idea?...",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Además, previo a eso tú misma sugeriste que Kei y yo podríamos enseñarle a\nRin...",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Toritani no cambia nada... Realmente es torpe... seria y diligente... y...",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0019",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000458",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Auch...”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0010",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0006",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000219",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si palmoteas tan fuertemente las manos como lo hiciste podrías torcerte las\nmuñecas. Traeré algo de hielo de la sala de cocina.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000459",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estoy bien, de verdad...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aquí hay un refrigerador, ¿traigo algo de hielo?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000460",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Están exagerando. Realmente estoy bien.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0005",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_000220",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eres pintora, así que si esta inflamación pasara a convertirse en tendonitis\nsería bastante grave para ti. Lo siento, Kusanagi-kun, ¿podrías traerme el\nhielo?”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
"Rin metió el hielo en una bolsa de plástico, la envolvió con un pañuelo y la\npuso sobre la zona afectada de Toritani.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"De comienzo a fin Toritani estuvo riéndose, diciendo 'están exagerando', pero\nRin no le prestó atención.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0016",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000651",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero... aún no estoy de acuerdo, no lo olvides...”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Kei susurró eso, de una manera mucho más calmada que hace un rato.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0015",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うんうん",time=300,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0022",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000461",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, sí, Kei, deja de andar murmullando de una buena vez. Y bien, Rin-chan, ¿qué\nquisieras hacer? ¿Pinturas de óleo? ¿Alfarería?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fgact",ch="真琴",act="停止",lv=4,id=5},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Aún no está de acuerdo...",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Fue la misma Toritani quien me dijo eso hace unos días.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
ja={
{
"Pero aun así, Toritani hizo un esfuerzo para calmar la situación.",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"Aun cuando probablemente ella piensa lo mismo que Kei piensa respecto a mí...",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Se me hace realmente vergonzoso esto.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Quizás si Kei me hubiera golpeado me hubiera podido sentir algo más aliviado\nmentalmente...",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"ex",time=0,func="wait"},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000462",ch="mkd"},
},
ja={
{
name={"Makoto"},
