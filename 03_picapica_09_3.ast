{"vo",file="fem_mkd_003452",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... ngh, jaa...”",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"text"},
text={
ja={
{
"Su expresión está aún contorsionada en dolor, pero va calmándose lentamente.",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"text"},
text={
ja={
{
"Me di cuenta de que la fuerza de la constricción que apretaba mi pene iba\naflojándose lenta, pero seguramente.",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"bg",file="ev_mak_h04_06",sync=0,face=1,time=400,path=":ev/ev_mak_h04/",set="ev_mak_h04"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003453",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... Jaa... parece, que... ya, se calmó un poco el dolor... Creo, que... ya\npuedes moverte...”",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"text"},
text={
ja={
{
"Ciertamente, su interior sigue aún terriblemente estrecho, pero la fortísima\nconstricción de hace rato se había aflojado bastante.",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien... Me moveré entonces, ¿sí?”",
{"rt2"},
},
},
