linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"bg",file="ev_mak_h04_08",sync=0,face=1,time=400,path=":ev/ev_mak_h04/",set="ev_mak_h04"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003445b",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Hyauuh! E-Espera... solo, un segundo... auh... N-No te muevas... t-\ntodavía, ¿sí?... Ngh.”",
