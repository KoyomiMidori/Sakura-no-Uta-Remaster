linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"bg",file="ev_mak_h04_07",sync=0,face=1,time=400,path=":ev/ev_mak_h04/",set="ev_mak_h04"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003443",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Qué... bien... Jaa, jaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
ja={
{
"En las esquinas de sus apenas abiertos ojos se acumulan las lágrimas.\nSeguramente sufrió bastante en el acto, pues sonríe aliviada ahora al\nescuchar mi respuesta.",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué bien?”",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003444",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí... Si, hubieses... Jaa... intentado, detenerte a medio camino, solo por\nverme sufriendo... te hubiera golpeado...”",
