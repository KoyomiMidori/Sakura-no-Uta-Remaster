linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"text"},
text={
ja={
{
"Mientras saboreo la prueba de pureza de Toritani en carne propia, vuelvo a\ninsertar mi pene a mitad de haberlo sacado.",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"bg",file="ev_mak_h04_15",sync=0,face=1,time=400,path=":ev/ev_mak_h04/",set="ev_mak_h04"},
