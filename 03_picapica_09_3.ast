{"vo",file="fem_mkd_003456",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... aahh... uh... fuh, fuuh... kuun... Jaa... Jaa... fuu, fuh... uhnnn...”",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"text"},
text={
ja={
{
