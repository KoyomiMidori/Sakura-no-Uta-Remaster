},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003445",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pero tu cosa es... nkuh... tan, grande... que casi me canso de esperar a que\nentrara todo...”",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"mwact",act="びっくり",size=5},
