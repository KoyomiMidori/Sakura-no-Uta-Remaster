astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg032c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=2000},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"bgm",file="bgm022"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003305",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fue... como si me hubiera enamorado.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003306",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Todo mi mundo cambió. Como si todos sus colores hubieran sido pintados por\nencima con otros nuevos.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003307",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Es por eso que nada ocurrirá entre mi madre y yo.”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003308",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Todo el odio, conflicto, tristeza, complicaciones, dolor, sufrimiento que debió\nhaber ocurrido entre las dos, todo---”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003309",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Terminó como si nunca hubiera existido.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003310",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, así de mágicos son tus cuadros. Tus cuadros tienen el poder de\nrepintar el mundo de alguien.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003311",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y por eso, quiero que pintes.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003312",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pinta. Pinta esos cuadros que solo tú sabes crear. Por favor.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="真琴",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"La manera en que Toritani juntó sus manos sobre su pecho rogándome se asemejaba\nbastante a un rezo, haciendo que se me apretara fuerte y dolorosamente el\npecho.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Está implorándome desde lo más profundo de su corazón.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, yo---”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Y por eso, es que debo darle respuesta a su convicción.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"No puedo correr ni huir. Por más que mi respuesta no sea la que ella desea.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No pintaré.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0009",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003313",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Los labios de Toritani tiemblan. Su cara estaba pálida, despojada de todo\ncolor.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0008",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003314",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por más que te lo pida?...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por más que me lo pidas.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya no pinto. No, más bien no puedo hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú también lo sabes, ¿no? No siento casi mi mano derecha. Ya no es cuestión de\nsi quiera o no, simplemente no puedo pintar.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0009",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003315",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo sé. Eso lo sé, pero--- ¡Tú todav--”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, no presentaré nada ante la Exposición Moore.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0010",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003316",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"Los labios de Toritani tiemblan.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Su completamente palidecida cara pareciera estar a punto de romper en llanto\nahora mismo. Pareciera estar a punto de romper en sollozos.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Sin embargo, Toritani no dice nada. Las manos juntadas sobre su pecho se fueron\nhacia abajo, y sus ahora apretados puños están temblando.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No presentaré nada en la Exposición Moore, Toritani. Pero---”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si quieres ver mis cuadros, entonces pintaré para ti.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0020",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003317",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso... eso es...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Toritani se cubrió la cara con las manos. Se cayó de rodillas mientras hacía\ntemblar sus hombros. Las lágrimas que se escaparon de entre sus dedos cayeron\nal piso.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003318",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso, es tan injusto...”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"bg",file="black",path=":bg/"},
{"se",file="se9010",vol=40,id=1},
{"text"},
text={
ja={
{
"Abracé a Toritani mientras sollozaba, aún con sus hombros temblando.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es todo lo que puedo hacer ahora.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me quedaré contigo, por el resto de mi vida, pintando para ti.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003319",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh... uhhh... ¡¡¡Uwaaaahhhh!!!”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Los gemidos de Toritani resonaron en la solitaria habitación donde estábamos\nsolo los dos.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Toritani luchó entre sangre y lagrimas por mantener el club de arte. Todo, por\nesos dos genios. Por dejar el nombre de los dos marcado en la historia.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Ese deseo suyo no se cumplió. Ni se cumplirá.",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Las manos de Toritani alcanzan mi espalda. Los dedos suyos que agarraban\nfijamente mi camisa aprietan aún más.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg032c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0019",head="mak_z2d",lv=5,id=9,sync=0},
{"extrans",time=1000},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003320",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi... Kusanagi... ¿Sabes? ¿Sabes algo?...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0020",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003321",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tus cuadros son muy valiosos para mí, y realmente me molesta lo poco que te\nvaloras y cuidas a ti mismo... y me frustra tanto...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003322",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me... me...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0010",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",size=5,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0009",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003323",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gustan...”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0007",head="mak_z2d",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うんうん",lv=5,id=9},
},
vl02={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0010",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003324",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me gustan tus cuadros... Me gusta ese mundo que creas al pintar... Es como el\namor... Y-Y dicen que el que se enamora primero pierde, pero... pero...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0019",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003325",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No puedo creer que terminé enamorándome de ti también... Esto es horrible...”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no digas eso. Tú me gustas, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y lo que dije hace un momento no es broma. Si así lo deseas me quedaré a tu\nlado por el resto de nuestras vidas, pintando solo para ti.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0011",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003326",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dices algo tan serio... como si no fuera nada...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no, estoy hablando en――”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0110",face="d0009",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",size=5,lv=5,id=9},
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
"Los dedos de Toritani tocaron mis labios, como tratando de interrumpir mis\npalabras. Esta alza su cara, sonriendo suavemente dentro de mis brazos.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003327",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo sé. Sé que solo hay sinceridad en tus palabras. Lo sé perfectamente.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",size=5,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003328",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me gustas.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú también a... no.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"No quise dejarlo todo en un simple 'yo también', así que aclaro mis palabras.\nVeo a Toritani a los ojos, y lo digo.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"excall",label="yesextrascene",cond="s.scene==1",call=0},
{"excall",label="noextrascene",cond="s.scene==0",call=0},
{"bgm",file="bgm022"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg032c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002",head="mak_z2a",lv=5,id=9,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tú me gustas.”",
{"rt2"},
},
},
},
labelcount=9,
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"msgoff"},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0012h",head="mak_z2a",lv=5,id=9},
{"fg",ch="真琴",speed=150,mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0012h",head="mak_z2a",y2="0,-5",y=0,lv=5,id=9},
{"ex",time=500,func="wait"},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002h",head="mak_z2a",lv=5,id=9},
{"fg",ch="真琴",speed=300,mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0002h",head="mak_z2a",y2="0,5",lv=5,id=9},
{"ex",time=500,func="wait"},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0028",head="mak_z2a",lv=5,id=9},
{"fgact",ch="真琴",act="いいえ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003329",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tú también... no...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0029",head="mak_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_003329b",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tú... me gustas.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"se",file="se9010",id=1,vol=50},
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Toritani me abraza apretándome, e igualmente yo también la abrazo fuertemente.\nSentí los latidos de su corazón cerca de mí.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003330",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“――――”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Acerco lentamente mi cara a la de Toritani, quien estaba alzando su cabeza\nahora viéndome. En lugar de decir algo, esta cerró sus ojos silenciosamente.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"bg",file="bg032c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=2000},
{"ex",time=500,func="wait"},
{"se",file="se2580",id=1},
{"msgoff"},
{"bg",file="bg032d",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"ex",time=500,func="wait"},
{"bg",file="ev_mak_h05_01",path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"bgm",file="bgm029"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003331",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Por primera vez sentí sus labios. Estaban suaves y húmedos. No sé si por\nnervios o por algo más, pero sentí además un leve temblor venir de ellos.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"bg",file="ev_mak_h05_02",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003332",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Al separar nuestros labios, Toritani apartó su mirada a un lado, avergonzada.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003333",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Se siente... algo raro...”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Sí?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003334",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Besarme contigo se... siente raro.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te gusta?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003335",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Claro que sí. Si no me gustara no cerraría los ojos.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003336",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tienes una cara un tanto rara. ¿Será, que estás nervioso?”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, sí, es la primera vez que beso a alguien.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003337",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eh, vaya... no me lo esperaba... o, tal vez sí.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no soy del tipo de persona que besa, y menos aun se confiesa, con tanta\nligereza.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003338",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Eso ya lo sé muy bien...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Puedo hacerlo de nuevo?”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003339",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"bg",file="ev_mak_h05_01",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003340",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mm... fuh...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Volvemos a repetir otro beso, solo juntando nuestros labios. Y a pesar de hacer\nsolo eso, me da la sensación de que mi temperatura corporal va subiendo.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Los carnosos y húmedos labios de Toritani se sienten realmente bien. Nos\ntocamos, nos separamos un poco, y luego nos tocamos de nuevo. Rozamos\nnuestros labios.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003341",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ngh... fuh... mm...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Toritani se retuerce ligeramente. Sus dedos se sientan sobre mis biceps. Los\ndedos que me aprietan fuertemente ahora están temblando.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003342",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... ngh... fuh... mm... fuh...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Un dulce olor se siente de su ligeramente abierta boca. Huele bien. Debe ser su\nolor.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Abrazo fuertemente a Toritani, y me dan ganas de besarla más profundamente. Al\npasar mis brazos por su espalda, el cuerpo de Toritani se estremeció y se\npuso tieso.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"bg",file="ev_mak_h05_02",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003343",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, esp-- era, un momento...”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003344",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Solo me asusté un poco, no es que no me gustó ni nada por el estilo...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si, te acabas de estremecer, ¿no? No llegué a pensar eso. Aunque veo que tú\ntambién te pones nerviosa en estos momentos, eh...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003345",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿P-Por qué tienes que decirlo?... T-También es m-mi primera vez... ¿Cómo\nesperas que mantenga la calma en este momento?...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Entiendo.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Así de nerviosa está ahora que se le escaparon descuidadamente esas palabras.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003346",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Además, tienes una cara increíble ahora... No hay manera de que no me ponga\nnerviosa...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh, así de fea es la cara que estoy poniendo ahora? ¿Tipo violador depravado?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003347",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tampoco así, pero tienes una cara que jamás había visto antes... Es... por eso...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, es que...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Nos revelamos nuestros sentimientos, nos besamos, y sus labios se sienten mucho\nmejor de lo que esperaba. Es tan suave cuando la tengo dentro de mis brazos,\ny huele tan bien...",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Es imposible que no ponga una cara de miedo. Es bien difícil mantener la calma\nen esta situación.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, no tienes nada de qué temer. No haré nada que te desagrade.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003348",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿T-Temer? No estoy temiendo por nada.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003349",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Cómo crees que voy... que voy a tener miedo, o sentir asco de lo que me\nhagas?... Solo por haber temblado un poco... Simplemente, es la emoción del\nmomento...”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bg",file="ev_mak_h05_01",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003350",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ngh!”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Toritani echó su boca contra la mía. Sus labios se adhieren a los míos, y una\nmuy suave sensación que no parecieran las de unos labios corre y se extiende\npor los míos.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Y se me viene a la mente que jamás había sentido algo tan placentero. Son más\ngelatinosos que el warabimochi, y más carnosos que un malvavisco.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003351",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ngh... fuh... *chuu*... ngh... nmm... *chuu*...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Repetimos una y otra vez los mismos besos de labio con labio, con un pequeño\nsonido entre cada uno. A medida que nuestros labios se tocan, su temperatura\nva subiendo.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"Las manos de Toritani se alejan de mis biceps y agarran ahora fuertemente la\nzona de mi camisa que estaba sobre mi pecho. Sus manos estaban temblando, y\nera más que obvio que estaba nerviosa.",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003352",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ngh... *chuu*, *chuu*... nnngh... fuh... *chuu*...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"A diferencia de lo que Toritani espera demostrar juntando sus labios\ndesesperadamente con los míos, se ve extrañamente adorable. Es bastante\ntierna.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Y por otro lado, ya no tengo tanta compostura de mi parte. No sé qué estará\nsintiendo Toritani conmigo ahora, pero para ser sinceros, me siento\nextraordinariamente bien ahora, y estoy excitado.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003353",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Hafuu... ngh... *chuu*... *chuu*... mnn...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"A medida que nuestros besos, tan similares a picoteos, continúan, los labios de\nToritani van humedeciéndose con la saliva de los dos. La piel que está\njustamente tras sus labios me transmite una sensación resbalosa.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"El impulso de querer explorar aún más en lo profundo de sus carnosos labios va\nencendiéndose dentro de mí. Seguramente el interior de su boca está cálida y\nhúmeda.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Abro los labios de Toritani con mi lengua y la inserto en el húmedo interior de\nsu boca.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"bg",file="ev_mak_h05_03",path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003354",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡Ngh!!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Juntamos nuestras mojadas lenguas, moviéndolas de un lado a otro como si\ntratáramos de escudriñar el interior de nuestras bocas.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003355",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nmuh... *chuu*, *churuu*... *rero*... *chubuh*... Ngh... ¡Fuh!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"El interior de la boca de Toritani estaba muy suave, húmedo y cálido como lo\nimaginaba. O no, incluso más que de lo que pensaba.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"bg",file="ev_mak_h05_02",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003356",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡E-Espera un segundo!”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Toritani separó su boca de la mía, completamente sonrojada, y me dijo eso.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“L-Lo siento... Me quedé absorto en el acto...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003357",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“N-No es eso... tonto, no te disculpes... S-Solo... solo me asusté un poquito...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003358",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Estoy bien... Ya sabía que tus niveles de erocontaminación estaban por el\ntecho... C-Cuando comenzamos a besarnos pensé que quizás terminaríamos\nhaciendo esto también...”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si por un simple beso profundo me reclamas por mi erocontaminación, ¿qué vas a\nhacer con lo que viene ahora?...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003359",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡¡¿C-Con lo que viene ahora?!!!”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003360",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Espera un momento, no digas más nada. Dame algo de tiempo para calmarme.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003361",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es que me desagrade, en serio, simplemente me sorprendí un poco. Cuando me\ncalme y organice mi cabeza todo estará bien, sí... ¡Créeme!”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya entendí, vamos, cálmate Toritani.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003362",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003363",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De verdad crees que puedo calmarme en esta situación?...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Toritani susurra eso silenciosamente mientras aparta su mirada.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tienes razón...”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque bueno, no hay problema, tranquilízate. Por más que te agites, no creo\nque estés tan mal como yo. Son tantas las cosas que quiero hacerte, que no sé\ncómo calmarme yo mismo.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003364",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No sé... de qué manera esperas que me tranquilice diciéndome eso...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón, perdóname.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003365",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... está bien... Entre tanto hablar me calmé...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003366",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ya estoy bien. V-Vamos... ¡Ven con todo, estoy lista!”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues... tampoco tienes que ponerte como si fueras a pelear...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003367",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Jaa?! ¿A pelear? ¡No creas que soy capaz... d-de alterarme, con un simple\nbeso profundo!”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No? Yo sí lo estoy, y bastante. Tengo el pecho latiendo a millón.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003368",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Guh.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003369",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Realmente eres siempre sincero en esta clase de momentos.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí... No gano nada poniéndome a la defensiva, y además, me muero por\nseguir besándote. Quisiera ir aún más allá, de poder.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003370",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Eres terriblemente honesto.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La honestidad es una de mis pocas virtudes. Además, ya desde un buen tiempo has\nsabido lo erocontaminado que estoy, ¿no? Simplemente dalo por hecho y\nresígnate.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003371",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tonto.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003372",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Que lo dé por hecho y me resigne? Si lo hago es porque eres tú y nadie más.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Toritani sonríe suavemente. Parece que logró calmarse un poco. Después de dejar\nsu mirada flotando por un momento, esta susurró algo apenada.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003373",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Seguimos... entonces?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"bg",file="ev_mak_h05_03",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003374",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuh... *chuu*... *chuuru*... *kuchuu*... *chuu*... fuh... *chuuru*...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Al rozar la punta de mi lengua y envolverla con la de Toritani, esta comenzó a\nmover la suya, con algo de recelo.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003375",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nm... fuh... *chuu*... *churuu*... *kuchuu*... *chu*, *churu*... fuh...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Al mover mi lengua dentro de su boca, la saliva que se había enganchado despide\nun sonido líquido. Al adherir mis labios a los suyos, me doy cuenta de que\nestos estaban más carnosos, húmedos y cálidos que hace un momento.",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003376",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... nfuh... *chuu*... *churu*... nfuh... *kuchuu*...”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
"Chupo su lengua emitiendo el característico sonido del acto, y luego lamo la\nparte trasera de sus labios. Al insertar mi lengua en su boca, mezclo una y\notra vez la saliva que se desbordaba de los dos.",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003377",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kufuh... ngh, mm... *chuchuru*... *kuchuu*... *churuu*... fuuh... ngh...\n*churu*... fuun...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"En el intermedio entre cada beso una dulce voz sale de los labios de Toritani.\nLa zona interior de sus tiernas mejillas estaba caliente, soltando una gran\ncantidad de saliva.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003378",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Haafuu... ngh... *churu*... Jaa... ngh... *kuchuu*... *chuu*... fuu.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bg",file="ev_mak_h05_04",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"quake",size=2},
{"text"},
text={
ja={
{
"Al rozar la zona trasera de sus dientes y la rugosa zona de su paladar, el\ncuerpo de Toritani dio un pequeño salto.",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"A medida que enganchamos nuestras lenguas, el cuerpo de Toritani va\ncalentándose cada vez más. Las manos que estaban ahora sobre mi espalda están\ncalientes.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003379",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“*chuu*... nmuh... *churuu*... nkuh... *rero*... *kuchuu*... *churuu*...\n*koku*... fuh, ah... gh... *churu*...”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"La saliva entremezclada por el movimiento de nuestras lenguas corre por la\nlengua de Toritani, tragándose ella el transparente y viscoso líquido\nmientras hace sonar su garganta.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"bg",file="ev_mak_h05_05",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003380",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Haafuu... la saliva... tiene un sabor raro... *rero*... Hace que mi cabeza se\nquede en blanco... y, me sienta, algo extra, ña... nh... *rero*... *chuu*...\n*kuchuu*...”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"La lengua de Toritani, ahora totalmente cubierta en saliva, se retuerce\nsensualmente enrollándose con la mía.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003381",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... aah... *rero*... *churuu*... *reru*... *reru*... *kuchuri*...\n*chuchuruu*... *churu*... *chu*, *churu*... nfuh... ngh.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"La suave lengua de Toritani se mueve saliendo y entrando, y sus húmedos labios\nchupan mi lengua.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Su lengua es tierna y carnosa, y el interior de su boca húmeda. Los alientos\nque se escapan de ella entre cada beso despiden un dulce olor.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"La fluida saliva de Toritani se entremezcla por acción de mi lengua dentro de\nsu boca, alcanzando una consistencia más sensualmente viscosa.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003382",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ja, jaa... hafuu... *churuu*... *kuchuu*... *chururu*... ng, ngh... fuh...\n*chuuu*... *churuu*... *kuchuu*... nfuh... ah...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"El excitante movimiento de su lengua retorciéndose no busca seducirme\nintencionalmente, sino seguramente devolver mis besos con toda su alma, pero\naun así es suficientemente excitante.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Sus ligeramente abiertos ojos estaban humedecidos, y sus mejillas rojas, como\nsi estuviera aquejada con fiebre.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Al abrazarla con más fuerza, los pechos de Toritani se deforman sobre mi pecho.\nSon realmente suaves... Nada que haya sentido antes.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
"Quiero tocar y sentir más a Toritani. Ese impulso me hace poner mis manos sobre\nlos botones de su uniforme.",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003383",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... ah... n-no... e-espe... ra... por, favor... ng...”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Toritani me pide eso entre nuestros besos, jadeando y sin aire. Sin fuerza\nalguna ahora en su cuerpo, su voz carece del característico ímpetu que tiene\nsiempre.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003384",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Q-Quiero... que lo hagas... después de que te... desnudes tú... Me da pena...\ndesnudarme primero...”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es por eso, no tengo ningún problema. Solo basta con que me desnude y ya,\n¿no? ¿Si me desnudo por completo daría a usted a mí el honor de quitarle la\nropa?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Hago lo imposible por ocultar mi impaciencia, y estoy fallando estrepitosamente\nen el intento. Realmente ninguno de los dos puede pensar con claridad\nahora... Y mientras pienso en eso, me resigno a decir la verdad, sin más qué\npoder hacer.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Quiero tocar el cuerpo de Toritani, darle muchos besos. Quiero pasar mis manos\npor su trasero y sus pechos, y lamerlos. Quiero disfrutar de cada uno de los\nrincones del cuerpo que se oculta tras este uniforme.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"bg",file="ev_mak_h05_02",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003385",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tu japonés está fuera de sí... cálmate... Me hiciste recobrar la calma diciendo\ncosas raras...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me alegro de haberte ayudado, supongo.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003386",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, bueno... en fin, si te desnudas tú me quedaré sin nada que hacer mientras\ntanto, o digo... no sabré qué hacer, ¿no crees? Así que resígnate y deja que\nyo te desnude.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"se",vol=30,id=1,file="se2016"},
{"bg",file="ev_mak_h05_06",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh... ¿Ohh? E-Esp--, esper--”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"Toritani me quita la camisa con una inesperada velocidad, y ahora pone sus\nmanos sobre mi pantalón.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003387",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Quédate quieto! Siento que si no lo hago todo de una vez y termino retornando\na la misma yo de siempre, no podré hacerlo de nuevo... eh――”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"se",stop=1,time=500,id=1},
{"bg",file="ev_mak_h05_07",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"quake",size=6,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003388",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡---!!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Las manos de Toritani puestas sobre el botón de mi pantalón se detienen de\ngolpe.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que al fin me descubriste...”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003389",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿D-D-D-Des, descubrir?... ¡¿Q-Qué, es esto?!”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Toritani aleja sus manos, con un aspecto a punto de entrar en pánico.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Mi pene, que comenzó a llenarse de sangre entre los besos y se levantó con\nbastante fuerza, está ahora a punto de explotar dentro de mis pantalones. Y\nsin exagerar, duele bastante abajo.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad, está tan hinchado que incluso duele.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003390",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡¡¿Q-Qué pretendes siendo tan estúpidamente honesto con esa cara tan seria?!!!\n¡¡I-Idiota!!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003391",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“U-Uwaa... así que, de verdad se ponen así... *traga saliva*... (ve de reojo)...\nUhh, no puedo verlo directamente... Está realmente, fuera de control...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"text"},
text={
ja={
{
"Aparta su mirada, y luego la devuelve, al instante se pone completamente roja y\ncierra sus ojos, para luego mover su cabeza a los lados fuertemente. No se\ncansa.",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Supongo que de cierta forma, es de buena suerte para mí que esté tan nerviosa\nahora.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, ¿qué harás? ¿Vas a desnudarme?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Pregunto eso, con un tercio de curiosidad, otro tercio de expectativa y un\ntercio con la intención de soltarle un comentario picante. Toritani mueve su\ncabeza a los lados con sorprendente fuerza.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"bg",file="ev_mak_h05_08",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"mwact",act="いいえ",size=5},
{"text"},
delay={
vl01={
{"bg",file="ev_mak_h05_06",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
},
},
text={
vo={
{"vo",file="fem_mkd_003392",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Nopuedonopuedonopuedo! ¡Esto es demasiado, demasiado para mí...! Disculpa\nque te pida esto después de lo que dije, pero, desnúdate tú... por favor.”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"La fuerza en sus palabras se fue apaciguando al final, y me pide el favor con\nuna voz casi imperceptible.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"La cubierta de esa Toritani que no se preocupa por lo que digan o hagan los\ndemás se cae, y ahora está la verdadera ella, mansa como nunca.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"Sin embargo, la verdadera Toritani es muy tierna, así que realmente esto no\nimplica ningún problema para mí.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien. Espera un momento.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Desabotono mi pantalón y bajo la cremallera.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
"Ese inocente pero también lujurioso roce de carne que conocemos como 'beso' se\nsintió mucho mejor de lo que mi imaginación esperaba, y me costó trabajo\nsacar mi endurecido y casi tieso pene.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"bg",file="ev_mak_h05_07",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003393",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... *traga saliva*.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Desnudo ahora por completo, Toritani observa mi fuertemente erecto pene y traga\nsaliva sin pensarlo.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003394",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿E-En dónde se supone que estuviste escondiendo... esa cosa tan grande?...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En ninguna parte... Por lo general no está siempre así de hinchado...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"bg",file="ev_mak_h05_06",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003395",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A-Ah, cierto... Eso lo vi en las clases de salud, ya lo sé...”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"bg",file="ev_mak_h05_07",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003396",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es justo que seas el único desnudo acá, ¿verdad? Y-Yo también me quitaré la\nropa y--”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera. Solo cálmate un momento, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"bg",file="ev_mak_h05_06",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003397",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“A-Ah... s-sí... me alteré de nuevo otra vez... Perdóname.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003398",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... Qué patética me veo, agitándome yo misma...”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No creas, yo también lo estoy. O digo, estoy perdiendo gradualmente la razón.\nSi dices que vas a desnudarte, pues me encantaría que me dejaras hacerlo yo.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003399",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Ehh--”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003400",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Tú... a mí?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003401",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¿P-Por qué?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es el sueño de cualquier hombre desnudar a su novia, ¿no? Quiero quitarte la\nropa. Eso es lo que mi corazón más desea en este momento.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"bg",file="ev_mak_h05_07",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003402",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡E-Está bien, entiendo, deja ya de pedirlo con tanto empeño!...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Puedo entonces... ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"bg",file="ev_mak_h05_06",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
ja={
{
"Al comenzar a extender mis manos, Toritani bajó su mirada apenada, sin tratar\nde escaparse de mis brazos.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003403",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003404",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Uh.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"se",file="se0897s",vol=30,id=1},
{"text"},
text={
ja={
{
"Le quito su uniforme y su ropa interior. Es la primera vez que toco un brasier,\npero agradezco haber podido desengancharlo de manera relativamente rápida.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"bg",file="ev_mak_h05_09",path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
ja={
{
"En su uniforme quedaban todavía trazas de su calor corporal y su olor, y solo\neso bastó para que mi pene reaccionara. Hinchado completamente ahora, está\ntan irritado que incluso duele.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Ahora solo queda...",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003405",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y-Yo me encargo de quitarme lo de abajo...”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Mientras oculta sus ahora expuestos pechos con un brazo, Toritani se retuerce\nligeramente, y se quita el último trozo de tela que la cubría.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
"Las pantis de Toritani caen rápidamente sobre la montaña de ropa que había\nahora justo al lado de la cama.",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Mi atención estuvo por desviarse, por un instante, a ese dulce olor que muy\nseguramente debe emanar de su ropa interior. Sin embargo, justo entonces\nagito mi cabeza y me esfuerzo por calmarme.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Las pantis son fantásticas. Son realmente algo maravilloso. Pero, en este\nmomento deberías concentrarte en lo que hasta hace un momento ellas cubrían.\n¿No es así?",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Al tratar de dirigir mi mirada hacia el blanco y desnudo cuerpo de Toritani que\ntenía frente a mí, esta susurra de manera avergonzada.",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003406",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kusanagi, cierra los ojos...”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, pero eso... Quiero verte má--”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003407",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aún me da pena. Cierra los ojos... por favor.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"bg",time=500,sync=0,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Al cerrar mis ojos, sentí el aliento de Toritani justo frente a mi nariz. E\nincluso antes de poder darme cuenta de lo que era...",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003408",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nm... fuh...”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"Fue un beso por parte de ella. Sus labios, tan jugosos y carnosos como una\nfruta, se unen con los míos.",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"bg",file="ev_mak_h05_10",path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003409",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ha, ah... fuh... *chuu* *churuu*... *reru*... *kuchuu*... *chuu*.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Toritani va adentrando cada vez más en sus besos. Al principio, con algo de\nmiedo... pero luego, y progresivamente, con más atrevimiento...",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003410",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fuh... nngh... *chu*, *churuu*... *kuchuu*... *chuu*... ngh... *churuu*...\nJaa... ngh... fuh... *chuu*... *churuu*...”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Los labios que hasta hace un rato eran de color rosado estaban ahora\nenrojecidos, a pesar de no tener labial alguno encima. Más hinchados, y más\ncalientes que hace poco.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"bg",file="ev_mak_h05_11",sync=0,face=1,time=400,path=":ev/ev_mak_h05/",set="ev_mak_h05"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_003411",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... Te, dije... *rero*... que, cerraras... *kuchuu*... los ojos... *reru*...\n*churu*...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento... Aunque, a esta distancia no tengo forma de ver tu cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003412",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Cierta... mente... *rero*... *kuchuu*... fuh... ngh... *rero* *rero*...\n*kuchuu*... *churu*... *rero*...”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
"Chupo la punta de la tierna lengua de Toritani con mis labios, y escurro la mía\nadentro de sus abiertos labios, los cuales desprendían un dulce olor.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
vo={
{"vo",file="fem_mkd_003413",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kufuu... ngh... *chupuh*... *kuchuu*... *chururu*... *reru*... *churuu*...\nfuh... nngh... *chu*, *churuu*... *reru*... faah...”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
"Lamo los carnosos tejidos del interior de su boca, para luego enlazar nuestras\nlenguas una y otra vez, comenzando de la base a la punta.",
{"rt2"},
