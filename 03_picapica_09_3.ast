vo={
{"vo",file="fem_mkd_003418",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“*churuu*... puhaa... gh.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"Al alejar mis labios y tratar de tirarla a la cama, Toritani me observó con\nojos humedecidos.",
