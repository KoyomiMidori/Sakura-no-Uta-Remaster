astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="nightsky_winter",rule=139,sync=1,vague=40,id=1,lv=5,path=":cg/"},
{"ex",time=500,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0910",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="あくび",lv=4,id=9},
{"bgm",file="bgm010"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002882",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Per, fecto--”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Ya después de cerrar el local, Toritani se estira ligeramente, habiendo\nterminado de calcular lo que quedaba en la caja y de haber limpiado y\nterminado con los preparativos de mañana.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ya terminaste?”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0001",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002883",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, ya terminé con todo. Me di cuenta que estuviste estudiando todo este rato,\n¿cómo has avanzado, Kusanagi?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, diría que más o menos, supongo.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Para decir la verdad, mis estudios andan peor aún ahora. La razón es evidente.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"Lo que Toritani y yo acordamos ayer hacer. Lo de dibujarla desnuda aun con su\nropa puesta, usando mi imaginación.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"No me puedo concentrar en los estudios con el tema viniendo y rondando por mi\nmente una y otra vez.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"No tiene mucho caso tratar de buscar el momento indicado y decírselo\nindirectamente. Mejor vayamos directo al grano.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Torita--”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0001",head="mak_z1b",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0002",head="mak_z1b",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002884",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, disculpa, voy a cambiarme, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="真琴",mx=-40,mode=-1,lv=4,id=9},
{"se",file="se9010",vol=50,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Oh--? Está, bien...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Mi ligeramente levantada mano se queda extendida en el aire, sin que ella se\ndiera cuenta.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Mierda. ¿Será que me aceleré demasiado?",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"No, no es posible... No debería serlo.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002885",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Disculpa la espera. Bien, ¿vamos?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"msgoff"},
{"se",file="se9012",id=1},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1c0100",face="c0001",head="mak_z1c",lv=4,id=9},
{"ex",time=50,func="wait"},
{"fg",ch="真琴",sync=1,mode=-1,lv=4,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Toritani se dirige a las escaleras que llevan al segundo piso. No hace falta\npreguntarle a dónde vamos.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg032c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"bgm",file="bgm023"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002886",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Puedes entrar.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ouh.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Esta es la segunda vez que entro a la habitación de Toritani. La primera vez\nfue cuando entré a ayudarla con los paquetes.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pensé que lo haríamos en Quimera.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002887",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mmm... Pensé en hacerlo allí, pero...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Toritani cruza sus manos, haciendo un gesto algo apenado.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002888",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Quizás no fuera tan problemático si se tratara de un retrato normal, pero no lo\nserá, ¿verdad? Y por eso me pareció indebido hacerlo en un lugar donde los\nclientes vienen todos los días a comer y beber...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No será normal?... Ah, ¿te refieres al hecho de que usaré mi imaginación para\ndibujarte desnuda?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002889",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No lo digas así como si nada! Te voy a patear de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Hoy sí te pusiste los leggings?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002890",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sin comentarios.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mala.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0022",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002891",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque no lo parezca, hago esto considerando que quizás sea necesario para\nencenderle llamas a tu imaginación.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En pocas palabras, ¿existe la posibilidad de que no lleves nada abajo?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0013",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0018",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002892",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Guh... Agradece a mi poder de autocontrol por haberte salvado de una patada\nmía.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Siempre le estoy agradecido.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0025",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002893",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, está bien, está bien. En fin, comencemos ya. 3 rondas, 20 minutos de dibujo\ny 10 minutos de descanso cada una. ¿Te parece bien así?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"20 minutos de dibujo, 10 de descanso, por 3 rondas... 1 hora y media, eh.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo mismo debería preguntarte yo a ti. ¿Realmente puedes aguantar estando tanto\ntiempo ahí?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Posar de modelo es, aunque no lo parezca, una labor muy extenuante. La agonía\nde tener que estar inerte con la misma pose y la misma mirada, y esa\nparticular sensación de molestia que lo invade a uno al quedarse tanto tiempo\nasí. Los que hayan experimentado alguna vez los saludos matutinos de los\ncolegios o las empresas sabrán de lo que hablo.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002894",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No tengo problema. Déjame preguntar, solo por si acaso. No tiene por qué ser\ntan estricto lo de la pose y eso, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tiene por qué... Aunque en fin, es solo un juego esto, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Toritani se encoge ligeramente de hombros.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002895",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, tienes razón. Esto no es más que un juego.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0003",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002896",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿No te importa entonces que ponga algo de música? Así podré relajarme un poco\nmás, y me ayudará a mantener la pose.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Como quieras, no me importa.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002897",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ah, pero se preocuparán en tu casa si llegas muy tarde, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Ciertamente, de aquí a una hora y media más adelante ya será bastante tarde.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya no soy un niño, les dije que llegaría tarde, así que no te preocupes.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0025",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002898",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No te vengas a quejar después si te agarra la policía afuera para escoltarte de\nvuelta a casa.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni creas que voy a dejar que me agarren.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002899",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, ¿comenzamos entonces? ¿Me siento en la silla o me quedo parada? ¿Está\nmejor de frente, o diagonal?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Yo me encargaré de mover el caballete, solo siéntate como lo harías\nnormalmente.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002900",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",speed=1000,mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x2=0,x=240,lv=4,id=9},
{"text"},
delay={
[1000]={
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"se",file="se9010",id=1},
},
},
text={
ja={
{
"Toritani asiente, y se sienta en la silla tomando una pose cómoda. Me muevo con\ncuidado a su alrededor, buscando la mejor posición.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estarás pensando ahora que es solo un juego, pero estás a poco de arrepentirte,\nte lo aseguro.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0028",head="mak_z1a",x=240,lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002901",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fufun, ya desde hace un buen rato me di cuenta de lo obsesionado que eres con\nel arte, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0022",head="mak_z1a",x=240,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002902",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Cuando comiences a dibujar te darás cuenta, y dirás 'lo siento, mi imaginación\nme falló esta vez'. Lo verás.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hay una parte de mí que pareces no entender en lo absoluto.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quizás no me suceda tanto con modelos desconocidas o con profesionales, pero\ncréeme que no soy tan perfecto como persona como para no verme alterado\nemocionalmente dibujando a una compañera de clases desnuda.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",x=240,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002903",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y eso quiere decir que...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que mi imaginación erótica ganará sin lugar a dudas, ¿no es lo más obvio?”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0004",head="mak_z1a",x=240,lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0003",head="mak_z1a",x=240,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002904",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ajaja, si te pones así menos te voy a creer. Sé que tu nivel de\nerocontaminación está por niveles críticos, Kusanagi, pero eso es eso, y esto\nes esto.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No vayas a llorar y quejarte después entonces. Aunque lo hagas, no pararé de\ndibujar.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0022",head="mak_z1a",x=240,lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002905",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jeje, no puedo esperar a que suceda eso.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"se",file="se_koton",vol=50,id=1},
{"text"},
text={
ja={
{
"Apoyo el cuaderno de dibujo que me traje sobre el caballete.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Traje uno de los montones de cuadernos que hay en la casa Natsume. Con el\npermiso de Ai, claro.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",x=240,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002906",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así que trajiste un cuaderno de dibujo...”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí, tenía que mostrarte de alguna manera de que vengo en serio para esta\nsesión de dibujo al desnudo imaginativo. De que vengo con todas las ganas de\nhacerlo.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",x=240,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002907",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Con todas las ganas de hacerlo?... Qué forma tan vulgar de decirlo.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Que no te lo he dicho ya? Soy un vulgar pervertido... Realmente me es un\nmisterio de dónde viene la confianza que me tienes.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya terminé con mis preparativos. ¿Qué hay de ti?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",x=240,lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002908",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Cuando tú quieras. ¿Comenzamos ya?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"se",file="se9047",id=1},
{"text"},
text={
ja={
{
"Toritani extiende su mano al reproductor de casetes que había en la mesita al\nlado de la silla, y pulsó el botón de reproducir.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Una pieza estándar de jazz con un cierto aire nostálgico comienza a sonar.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un reproductor de casetes?... Bien raro, eh.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002909",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo compré a 10 yenes en el mercado de pulgas. Los casetes los puedes comprar a\n100 yenes cada uno.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"msgoff"},
{"bg",y=0,speed=300000,file="zbg032c",path=":bg/",x2=960,y2=0,x=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Voy moviéndome mientras hablamos. Los primeros 20 minutos los gasté captando su\nfigura con ropa encima.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"La labor avanza mientras voy viendo y detallando los músculos y huesos que se\nesconden debajo de su piel.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Tal como se lo explique a Toritani hace poco, para mí, dibujar es prácticamente\nuna labor mecánica.",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"De ser necesario, a veces también reflejo el interior como elemento del\ncompuesto final, pero ese no es mi objetivo.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"El interior es simplemente, un elemento más que compone y le da forma a la obra\ncompleta.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"Sin embargo, en esta ocasión, mi objetivo no es, en primer lugar, retratar.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Debo dibujar el cuerpo desnudo de Toritani tal como realmente se vería al\narrancar toda su ropa, de la misma forma que dibujaría sus músculos y huesos\nal arrancar su piel.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Lo mejor para mí sería que Toritani se avergüence. Y aunque no lo haga, muy\nprobablemente no tenga otra oportunidad de contemplarla a mi gusto tanto como\nahora, y menos aun con su autorización.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Voy dibujándola con bastante empeño y seriedad en el cuaderno de dibujo. Los\nprimeros 20 minutos pasaron como si se trataran de segundos.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"msgoff"},
{"bg",file="bg032c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002910",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué tal? ¿Pudiste dibujarme?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"msgoff"},
{"se",file="se9012",id=1},
{"fg",ch="真琴",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="真琴",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2d0100",face="d0001",head="mak_z2d",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Toritani se acerca por detrás, y se inclina a ver.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0012",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002911",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Vaya, pero si estás dibujando muy bien.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué te refieres con que muy bien? ¿A la ropa?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0017",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002912",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es eso. Solo haz silencio un momento.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0001",head="mak_z2d",lv=5,id=9},
{"text"},
text={
ja={
{
"Toritani observa fijamente a su 'yo' plasmada en papel. Esta asintió,\nlentamente, como si estuviera disfrutando de algo.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0002",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0003",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002913",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, creo que está muy, muy bien.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Se trata de tu rostro, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0005",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002914",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué andas diciendo? Mi rostro no importa para nada. Es el hecho de que tú\nhayas dibujado esto lo que le da valor, Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0002",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002915",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me parece que está muy bien hecho.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"La mirada de Toritani se dirigió de nuevo al dibujo.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Su mirada era cálida. Sentí un profundo amor de su parte hacia la pintura.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te encantan mis pinturas, eh.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0009",head="mak_z2d",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0011",head="mak_z2d",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002916",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿A... qué vienes... con eso ahora?... Sí, bueno.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo. Gracias, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002917",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Está bien.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="真琴",mode=-1,lv=5,id=9},
{"text"},
text={
ja={
{
"Un breve y cosquilleante aire se cierne entre los dos. Toritani aparta su\nmirada a un lado, luciendo inquieta por algo.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Sin embargo, justamente después Toritani comienza a hablar en un tono burlón,\ncomo si tratara de hacer a un lado su inquietud.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0110",face="a0022",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002918",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque después de todo parece que las cosas resultaron como me lo esperaba.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002919",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sabía que te quedarías absorto en el dibujo y se te olvidaría por completo eso\ndel desnudo imaginativo.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0028",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002920",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Mira nada más, Kusanagi. Realmente eres un obsesionado con el arte, hasta la\nraíz. Te gané esta.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero qué ridiculez, aún quedan 2 rondas en esta pelea.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0025",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002921",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿En esta pelea? No estamos en un ring de boxeo...”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuiste tú la que dijo primero que ganó.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0028",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002922",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahora que lo dices, tienes razón. Aunque bueno, ya pude verte pintar, así que\nno me importaría competir ahora o hacer lo que sea.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me estás diciendo que vamos a terminar ya, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002923",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si quieres seguir, pues no tengo problema en hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que seguiremos. Ahora es que viene lo mejor.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0003",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002924",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Reiniciamos entonces?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="真琴",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani está equivocada.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Sí, puede que sea un tonto del arte, pero sobre todo, también soy un tonto de\nla imaginación erótica",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Solo es una fantasía, no necesito una acompañante cuando ya tengo una todos los\ndías",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Al ver el reloj, el descanso de 10 minutos estaba ya por terminar. Toritani se\nestira ligeramente, y hace la misma pose de hace un rato.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Era de esperarse que su ropa se arrugara, pero la pose es prácticamente la\nmisma",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Jeje, es sincera.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
"Desde ahora, despojaré hasta la última prenda de vestir por este delirio mío",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Mis ojos se abren de golpe.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"se",file="se9045",id=1,vol=10,loop=1},
{"bg",file="ev_mak_h01_01",path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Solo el tenue sonido del lápiz corriendo por el cuaderno de dibujos resuena\nalrededor.",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Ya capturé por completo la forma de la ropa de Toritani. Lo que queda ahora es\nir arrancando parche por parche toda esa tela que la envuelve.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
"La observo fijamente. Tanto que en cualquier momento su piel podría verse a\ntravés de su ropa.",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
"Interpreto y asimilo sus zonas de volumen, retiro todos aquellos elementos\ninnecesarios, y voy reproduciendo en el papel la figura de su cuerpo que se\nva armando en mi cerebro.",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Así... más... sí, así es, más...",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Me voy concentrando. Tanto que su ropa va haciéndose translúcida...",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"se",stop=1,id=1,time=500},
{"bg",file="ev_mak_h01_02",path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Lo veo, sí... excelente...",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002925",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"La cara de Toritani comenzó a tomar un tinte rojo. Su mirada empieza a agitarse\ndescontroladamente.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
"Bien, ¿por dónde comenzaré a dibujar?",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Aquella parte frontal de Toritani que más acentúa su feminidad... Sus curvados\ny voluminosos... pechos.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"El cuerpo de Toritani, que hasta ahora estuvo inerte a pesar de su relajada\npose, comienza a inquietarse.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
"Perfecto, parece que se dio cuenta de lo que está tras mi mirada. Estoy ahora\ncontemplándola a mi gusto, tal como ella accedió a permitirme.",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Si esa no fuera mi intención, entonces las cosas hubieran tomado un rumbo\ndistinto. ¡Pero vaya que lo siento, Toritani! ¡Desde un principio dije que\nharía de esto algo erótico y pervertido!",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bg",file="ev_mak_h01_03",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002926",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Uh...”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Muy bien. Voy a plasmar en este papel, mi fantasía de un boceto de Toritani\ndesnuda y avergonzada.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bg",file="ev_mak_h01_04",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002927",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oye... espe... ra...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Ese curvo blanco que respira tras su uniforme, que de agarrarlo con su mano\ntransmitiría su peso. Su textura es suave... Su poca exposición al sol la\nhace más blanca que su cuello.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002928",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Te... digo que... espe...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“..............”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"bg",file="ev_mak_h01_05",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Su piel es más delgada que la de las otras partes. Gracias al peso de toda su\ncarne, la piel está algo estirada.",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Están inflados, pero de hundir los dedos seguramente se sentirán\nextraordinariamente blandos. El valle entre sus pechos puede tener algo de\nsudor.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002929",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Me oyes?... Oye...”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"bg",file="ev_mak_h01_06",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Si le quito la ropa interior, ¿el centro de gravedad de sus pechos bajará un\npoco? Pues nada podrá resistir el peso... ¡No! ¡No hay manera de que las\ntetas de Toritani puedan ser derrotadas por el peso!",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"bg",file="ev_mak_h01_05",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002930",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oye... no me mires así... Eh...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
"No, con semejante volumen... Aunque estén firmemente sostenidos por los\nligamentos de Cooper, que conectan las glándulas mamarias con los músculos\npectorales, la gravedad les afecta en cierta medida.",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"bg",file="ev_mak_h01_06",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002931",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Mmmmmm!”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
"Que esté desnuda no es lo que importa. Lo que importa es acercarse lo más\nposible a lo que estoy viendo ahora mismo. Es decir, dibujarla en ropa\ninterior y lograr que se vea translúcida.",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"bg",file="ev_mak_h01_08",path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002932",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Espera... un momento...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
ja={
{
"La línea que une el pecho desde la axila es... así. Bien, bien.",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Si asumo que lleva la ropa interior puesta, la parte donde comienza la curva\ndel pecho desde el escote cambia considerablemente... ¿La ropa interior de\nToritani es del tipo que junta y levanta un poco?",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"bg",file="ev_mak_h01_09",path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002933",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No... escucha... lo que te digo... uh...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"La parte superior del pecho comienza a hincharse notablemente en este punto. El\nescote crea sombras definidas, mientras que la línea inferior del pecho es\nsuave y redondeada...",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"bg",file="ev_mak_h01_11",path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Y además... ¿qué hay del tamaño de los pezones y las areolas? ¿Qué tan firmes?\n¿Deben mantenerse presionadas dentro de la ropa interior?",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"bg",file="ev_mak_h01_10",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002934",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oye, espera un momento...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Eh... ¿Podrían ser pezones invertidos? No, no creo que Toritani tenga ese\nrasgo... no lo creo.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"bg",file="ev_mak_h01_12",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Los pezones invertidos son un punto de encanto por sí solos, pero creo que\ntienen un color más bonito y un equilibrio casi perfecto.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
"El contraste de color entre el pecho, el pezón y la areola, la proporción entre\nsus áreas y el efecto tridimensional. Sin duda, debe formar la proporción\náurea que representa el pecho ideal.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
"Pues bien, ¿qué hacemos?",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Es cierto. Este es el único lugar sobre el cual no se puede especular desde un\npunto de vista externo. Los pezones, las areolas... aquí es donde la fantasía\nrealmente cobra vida.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"No se puede observar desde fuera. En pocas palabras, se trata de un problema de\nobservación. No se está definiendo nada.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Una revelación fulminante rasga las tinieblas.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"¡Ah!",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bg",file="ev_mak_h01_23",path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Lo veo.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"El sabor del néctar blanco que gotea. Sí, así es como lo llaman: leche materna.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"No se puede observar a simple vista. Asumir que los pechos de Toritani no\nproducen leche no es más que una estúpida idea preconcebida.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"La leche materna fluye de las mujeres embarazadas. Pero eso no significa que la\nleche materna no fluya de Toritani. No, ¡debe fluir! Porque mi intuición\nartística me lo susurra.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Lo veo. ¡Lo veo, Toritani!",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"¡¡Un suministro desbordante de leche materna!!",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"bg",file="ev_mak_h01_24",path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"¡Lo veo!",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"En mi juventud, se me temía como a un prodigio: ¡mis ojos lo revelarán todo!",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
ja={
{
"¡Leche materna! ¡La leche materna fluye sin parar! Si fluye tanto, una vez que\nempieza a fluir...",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"bg",file="ev_mak_h01_25",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002935",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡¡Kusanagi!!!”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"excall",label="join1"},
{"text"},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
ja={
{
"Toritani demuestra una mirada de vergüenza.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Esta expresión. Mientras tenga esta mirada, podré hacer lo que me venga en gana",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"bg",file="ev_mak_h01_04",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah!”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"El ojo de mi mente. Mi tercer ojo se abre.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"Lo veo. ¡Lo veo!",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Ese curvo blanco que respira tras su uniforme, que de agarrarlo con su mano\ntransmitiría su peso. Su textura es suave... Su poca exposición al sol la\nhace más blanca que su cuello.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"bg",file="ev_mak_h01_05",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Su piel es más delgada que la de las otras partes. Gracias al peso de toda su\ncarne, la piel está algo estirada.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Están inflados, pero de hundir los dedos seguramente se sentirán\nextraordinariamente blandos. Posiblemente Toritani esté sudando un poco en\neste momento.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002927",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oye... esp-- er...”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"No escucho las palabras de Toritani. Solo escucho al ojo de mi mente.",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"bg",file="ev_mak_h01_06",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Toritani aprieta los ojos, avergonzada.",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Esa expresión hace que el ojo de mi mente se agudice aún más.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Si le quito la ropa interior, ¿el centro de gravedad de sus pechos bajará un\npoco? Pues nada podrá resistir el peso...",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"¿No? ¿No?",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"No! ¡No hay manera de que las tetas de Toritani puedan ser derrotadas por el\npeso!",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"¡Esas tetas son definitivamente las tetas de Toritani! Son muy fuertes, tensas\ny pegajosas como las de ella.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"¡Y eso es porque son las tetas de Toritani! Hasta pueden desafiar el peso, ¿no?",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"bg",file="ev_mak_h01_05",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002928",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Así que... habla...”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"Toritani-san está diciendo algo.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Pero el contenido es irrelevante.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Lo que importa es su voz y sus labios temblorosos.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"bg",file="ev_mak_h01_07",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Jajaja... cada vez estoy más atento...",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"bg",file="ev_mak_h01_08",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002929",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Me oyes?... Oye...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
"No te oigo.",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
"Porque solo estoy agudizando el ojo de mi mente.",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
"Todo el conocimiento que he adquirido hasta ahora, y todo el conocimiento que\nhe tenido, está reunido.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"Estudios de dibujo humano, estudios de color y anatomía.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
"Los sentidos absolutos, respaldados por el conocimiento, dan forma a los pechos\nde Toritani.",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"La línea que une el pecho desde la axila es... así. Bien, bien.",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
"¡Tetas!",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
ja={
{
"Grito en mi mente.",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"bg",file="ev_mak_h01_09",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Lo veo.",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"text"},
text={
ja={
{
"Ya lo veo.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Y entonces llegó el momento.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"bg",file="ev_mak_h01_10",path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"El ojo de mi mente había captado completamente su pecho.",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Lo veo. Sí, ya lo veo.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
"Pero no del todo.",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"No, es que esta es la parte importante.",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
"Porque a partir de este punto, todos mis estudios son inútiles.",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"El dibujo humano, la ciencia del color, la anatomía, nada puede ayudarme\ndespués de esto.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"A partir de este momento, solo mi perspicaz imaginación puede ayudarme.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"La areola",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Es importante. Sin ella, no habría diferencia entre un pecho y un culo.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"Es por los anillos de los pezones. Es su tenue color rosa lo que las hace tan\nvaliosas. Las tetas tienen valor.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Y hay más.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
"Los pezones.",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"Si las montañas no tuvieran picos, la gente no las escalaría. Es porque hay una\ncima que la gente sube a las montañas.",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
"Los pezones.",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"text"},
text={
ja={
{
"¿Cómo es que un niño nace sabiendo que la leche de su madre sale del pezón?",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Porque los pechos tienen un pico.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"bg",file="ev_mak_h01_11",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002930",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Oye... no me mires así... Eh...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ah!”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Ha llegado el momento.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"bg",file="ev_mak_h01_13",path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Lo veo.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Ya la veo. Ya la veo.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"La areola del pezón de Toritani. Y sus pezones.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"Son de un color precioso. Y sus pezones son lindas",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"bg",file="ev_mak_h01_14",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002931",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Mmmmmm!”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
"Toritani está muy avergonzada para mirarme.",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002932",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Espera... un momento...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"text"},
text={
ja={
{
"Toritani avergonzada... Ahh.... Q-Qué erótica...",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
"Expone incluso sus pezones delante de mí. Debe ser vergonzoso.",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
"Pero no hay nada de qué avergonzarse. Toritani.",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
"Tus pezones son tan bonitos. No hay nada de qué avergonzarse.",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
"No... No...",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
"Toritani es así de tímida.",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
"¡Asi que no pueden ser estos adorables pezones!",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
"Más pezones y areolas en vergüenza... Más, mucho más erotismo.",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Así es.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"¿Qué tal algo así por ejemplo?",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"bg",file="ev_mak_h01_15",path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Pezones que son más grandes... y parece que tendrían mucha presencia si te los\nllevaras a la boca...Tales pezones.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"¿No valdría la pena darles vueltas con la lengua?",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"text"},
text={
ja={
{
"Pezones, sí. Tienen una presencia acorde con esos enormes pechos. Sería bueno\ntenerlos",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
"Pezones y areolas grandes.",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
ja={
{
"Cuando las mira, siento que los pequeños pezones que vi antes son un poco\ninadecuados.",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
ja={
{
"Tiene unas tetas grandes. Los pezones y las areolas tan grandes no son nada\nextraños.",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
ja={
{
"De hecho, si no fueran tan grandes, no serían suficientes.",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
ja={
{
"¡El tamaño del pezón y la areola es la justicia!",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"bg",file="ev_mak_h01_16",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002933",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vaya... ahora sí que no vas a escuchar a nadie...”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
ja={
{
"Me habla con timidez.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
ja={
{
"Sí, así es. Debes estar muy avergonzada si expones unos pezones y areolas tan\nobscenos",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
ja={
{
"¡Toritani, eres muy erótica!",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
ja={
{
"¿Qué pasa con esas escandalosas tetas? ¿Eh? ¿Qué pasa con esas tetas eróticas?",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
ja={
{
"¡Ah!",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
ja={
{
"Esperen.",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
ja={
{
"Rin dijo algo.",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
"¡Miren nada más esta muñeca sexual andante!",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
ja={
{
"Eh, eh, Rin dijo eso, ¿no?",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
ja={
{
"No creo que sea una buena idea.",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
ja={
{
"Los pezones y los anillos de los pezones de tal nivel, ¿ante ello diría Rin que\nes una muñeca erótica?",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
"La respuesta es no.",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
ja={
{
"¡Definitivamente, no!",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
ja={
{
"Eso dijo Rin. Muñeca sexual andante.",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"bg",file="ev_mak_h01_17",path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"¿Qué es? Esos desagradables pezones son casi como juguetes sexuales, ¿no?",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
ja={
{
"Casi como si estuvieran fruncidos, como los pequeños genitales de una niña en\nsus tetas.",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
ja={
{
"Pezones hinchados.",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
ja={
{
"Los pezones que van allí.",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
ja={
{
"¡Eso es un pezón con forma de c*ño!",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"bg",file="ev_mak_h01_18",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002934",ch="mkd"},
},
ja={
{
name={"Makoto"},
"Q-Que esperes...",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
"Esperen, ¡esa es mi línea! ¿Qué está pasando?",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
"No es pornográfico ni nada por el estilo. Es obsceno. Esos pezones.",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
ja={
{
"¿No debería haber un mosaico? No, no está bien poner un mosaico en un simple\npezón hundido. Calma, calma, eso es solo un pezón hundido.",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
"Aun así, eso es demasiado pornográfico. ¿Qué hay que comer para crecer con\npezones que se abren así?",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
ja={
{
"¡Así que esta es la 'muñeca erótica' de la que hablaba Rin!",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
"¿Fue porque Rin sabía este hecho que la estaba llamando 'muñeca erótica'\nmientras frotaba las tetas de Toritani?",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
"¿En serio? ¡Lo estás diciendo de otra manera!",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
ja={
{
"¡No eres mi amiga de la infancia!",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
"¿Qué?",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
ja={
{
"No, pero dijo eso, ¿sabes?",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
"¡No soy una amiga tuya de la infancia!",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
ja={
{
"Creo que está bien que produzca leche materna, ¿no?",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
"Porque, ya sabes.",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"bg",file="ev_mak_h01_19",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Esto no es bueno.",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
"No es como la leche materna, pero parece que el jugo del amor sale de su raja,\n¿no? ¿Necesitamos el mosaico esta vez? ¿Cuántos píxeles?",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
ja={
{
"¡No! ¡No! ¡No! ¡No! ¡No! ¡No! No es eso.",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
ja={
{
"No, esos son pezones hundidos. Y vale la pena porque es leche materna lo que\ngotea.",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
ja={
{
"La leche materna gotea de los pezones hundidos.",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
ja={
{
"Qué erótico",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"bg",file="ev_mak_h01_20",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Toritani me lanza una mirada húmeda de lágrimas.",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
ja={
{
"Pero más que eso, los pezones de Toritani están cada vez más húmedos.",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
"De las grietas, sale cada vez más jugo ecogénico.",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
"¡Es tan erótico! ¡Es muy erótico!",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
"¡Pezones hundidos!",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
"Por ejemplo.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"bg",file="ev_mak_h01_21",path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Pensemos en el primer pezón que imaginaste, un pezón pequeño.",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
"No se puede observar desde fuera. En otras palabras, se trata de un problema de\nobservación. No se está definiendo nada.",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"text"},
text={
ja={
{
"Una revelación fulminante rasga las tinieblas.",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"¡Ah!",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"bg",file="ev_mak_h01_23",path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"text"},
text={
ja={
{
"Lo veo.",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"text"},
text={
ja={
{
"El sabor del néctar blanco que gotea. Sí, así es como lo llaman: leche materna.",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
"No se puede observar a simple vista. Asumir que los pechos de Toritani no\nproducen leche no es más que una estúpida idea preconcebida.",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"text"},
text={
ja={
{
"La leche materna fluye de las mujeres embarazadas. Pero eso no significa que la\nleche materna no fluya de Toritani. No, ¡debe fluir!. Porque mi intuición\nartística me lo susurra.",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"text"},
text={
ja={
{
"Lo veo. ¡Lo veo, Toritani!",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"text"},
text={
ja={
{
"¡¡Un suministro desbordante de leche materna!!",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"bg",file="ev_mak_h01_24",path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
"¡Lo veo!",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"text"},
text={
ja={
{
"En mi juventud, se me temía como a un prodigio: ¡mis ojos lo revelarán todo!",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"text"},
text={
ja={
{
"¡Leche materna! ¡La leche materna fluye sin parar! Si fluye tanto, una vez que\nempieza a fluir...",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"bg",file="ev_mak_h01_25",sync=0,face=1,time=400,path=":ev/ev_mak_h01/",set="ev_mak_h01"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002935",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡¡Kusanagi!!!”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"bg",time=200,file="black",path=":bg/"},
{"msgoff"},
{"bg",file="bg032c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="008b",time=200},
{"cgact",stage="bg032",act="いいえ",size=5,lv=5},
{"se",file="se2790",id=1},
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Uohhh?!”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"text"},
text={
ja={
{
"Me asusto terriblemente ante esta violenta sensación de despertar, como si\nhubiera regresado de un sueño.",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"text"},
text={
ja={
{
"Se pareció bastante a aquellos momentos en que soñamos que caemos al vacío y\ndespertamos de repente.",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0009h",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002936",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“D-Dios...”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"text"},
text={
ja={
{
"Al darme cuenta, Toritani, quien estaba frente a mí, tenía la cara sonrojada, y\nsu respiración agitada",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0011h",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002937",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Estabas completamente inmerso, ¿verdad?... Realmente eres un tonto...”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo admito... Admito que soy un tremendo idiota.”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Soy todo un idiota...”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0012h",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0013h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
},
vl02={
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002938",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué estás diciendo?... Eh, ¿estás llorando...? No es como para llorar, ¿no?\n¡Y espera, ¿pero por qué estás llorando?!”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo digas... En este momento estoy maldiciendo lo estúpido que soy...”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"fg",ch="真琴",mode=-1,lv=4,id=9},
{"text"},
text={
ja={
{
"Me distraje con las tetas y me dejé llevar...",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
ja={
{
"No, pero esto está bien. Porque las tetas son justicia...",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"text"},
text={
ja={
{
"No podía creerlo... Las vi.",
{"rt2"},
},
},
},
linkback="block_00327",
linknext="block_00329",
},
block_00329={
{"text"},
text={
ja={
{
"Las vi...",
{"rt2"},
},
},
},
linkback="block_00328",
linknext="block_00330",
},
block_00330={
{"text"},
text={
ja={
{
"Pude la belleza de una pezón hundido goteando leche materna...",
{"rt2"},
},
},
},
linkback="block_00329",
linknext="block_00331",
},
block_00331={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011h",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010h",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002939",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No sé qué es lo que está pasando, pero en fin, la culpa la tuve yo, lo\nsiento... Admito que es más vergonzoso hacer esto con ropa.”",
{"rt2"},
},
},
},
linkback="block_00330",
linknext="block_00332",
},
block_00332={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, así que por fin lo entendiste.”",
{"rt2"},
},
},
},
linkback="block_00331",
linknext="block_00333",
},
block_00333={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008h",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002940",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, en carne propia... No lo volveré a hacer...”",
{"rt2"},
},
},
},
linkback="block_00332",
linknext="block_00334",
},
block_00334={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo... Es una lástima.”",
{"rt2"},
},
},
},
linkback="block_00333",
linknext="block_00335",
},
block_00335={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002941",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ni porque pongas esa cara de tristeza lo haré!”",
{"rt2"},
},
},
},
linkback="block_00334",
linknext="block_00336",
},
block_00336={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque quedó muy bien el dibujo. ¿Quieres verlo?”",
{"rt2"},
},
},
},
linkback="block_00335",
linknext="block_00337",
},
block_00337={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0007h",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002942",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡¿Crees que voy a ver eso, idiota?!! ¡Y tú tampoco lo hagas!”",
{"rt2"},
},
},
},
linkback="block_00336",
linknext="block_00338",
},
block_00338={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien. Tendré que llevármelo entonces.”",
{"rt2"},
},
},
},
linkback="block_00337",
linknext="block_00339",
},
block_00339={
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2d0100",face="d0006",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"se",file="se3130",id=1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002943",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Espera.”",
{"rt2"},
},
},
},
linkback="block_00338",
linknext="block_00340",
},
block_00340={
{"text"},
text={
ja={
{
"Toritani me agarra firmemente el hombro. D-Duele un poco.",
{"rt2"},
},
},
},
linkback="block_00339",
linknext="block_00341",
},
block_00341={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿S-Sí?”",
{"rt2"},
},
},
},
linkback="block_00340",
linknext="block_00342",
},
block_00342={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0017",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002944",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No estarás pensando en llevártelo, ¿o sí?”",
{"rt2"},
},
},
},
linkback="block_00341",
linknext="block_00343",
},
block_00343={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, como sabrás, este es mi cuaderno de dibujo.”",
{"rt2"},
},
},
},
linkback="block_00342",
linknext="block_00344",
},
block_00344={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0005",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002945",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Te lo compraré.”",
{"rt2"},
},
},
},
linkback="block_00343",
linknext="block_00345",
},
block_00345={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es caro, te lo advierto.”",
{"rt2"},
},
},
},
linkback="block_00344",
linknext="block_00346",
},
block_00346={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002946",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Conozco perfectamente cuánto cuesta un simple cuaderno de dibujo. Te lo\ncompraré al precio de tienda.”",
{"rt2"},
},
},
},
linkback="block_00345",
linknext="block_00347",
},
block_00347={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pueees, digo--”",
{"rt2"},
},
},
},
linkback="block_00346",
linknext="block_00348",
},
block_00348={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0006",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="ジャンプ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002947",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Deja ya de hablar y dame eso! ¡Te puedo dar un gyuudon de extra si quieres,\npero si no me lo das te voy a patear de verdad!”",
{"rt2"},
},
},
},
linkback="block_00347",
linknext="block_00349",
},
block_00349={
{"text"},
text={
ja={
{
"Vaya que se salió de sus casillas, eh. Supongo que incluso la muy serena y\ntenaz Makoto Toritani no resiste a perder la calma cuando de sus desnudos se\ntrata.",
{"rt2"},
},
},
},
linkback="block_00348",
linknext="block_00350",
},
block_00350={
{"text"},
text={
ja={
{
"Es como eso, como un collage. Cualquiera recibiría un fuerte shock si\ndescubriera que su compañero de clases hizo un collage con su cara.",
{"rt2"},
},
},
},
linkback="block_00349",
linknext="block_00351",
},
block_00351={
{"text"},
text={
ja={
{
"Aunque esto no es algo tan suave como un simple collage. Es el producto de mi\npoder imaginativo, fantasioso y delirante.",
{"rt2"},
},
},
},
linkback="block_00350",
linknext="block_00352",
},
block_00352={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0019",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002948",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uhhh～～～～”",
{"rt2"},
},
},
},
linkback="block_00351",
linknext="block_00353",
},
block_00353={
{"text"},
text={
ja={
{
"Toritani se veía bastante linda al molestarse, y no pude evitar esquivarla una\ny otra vez. Sus ojos van poniéndose cada vez más llorosos.",
{"rt2"},
},
},
},
linkback="block_00352",
linknext="block_00354",
},
block_00354={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, espera, no tienes por qué ponerte así de llorosa tampoco...”",
{"rt2"},
},
},
},
linkback="block_00353",
linknext="block_00355",
},
block_00355={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0009",head="mak_z2d",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002949",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Me lo darás entonces?”",
{"rt2"},
},
},
},
linkback="block_00354",
linknext="block_00356",
},
block_00356={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, y si quieres patearme, hazlo. No te reserves, vamos.”",
{"rt2"},
},
},
},
linkback="block_00355",
linknext="block_00357",
},
block_00357={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0021",head="mak_z2d",lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002950",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Si te pateo estando así de alterada lo único que lograré es que termines\nagarrándome del tobillo de nuevo! ¡¿No?!”",
{"rt2"},
},
},
},
linkback="block_00356",
linknext="block_00358",
},
block_00358={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No te lo voy a agarrar, rayos! ¡Toma!”",
{"rt2"},
},
},
},
linkback="block_00357",
linknext="block_00359",
},
block_00359={
{"fgact",ch="真琴",act="うんうん",lv=5,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="真琴",act="ジャンプ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002951",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Crees que voy a patear a alguién que está ahora alzando la bandera blanca?!\n¡Kusanagi, idiota～～～!”",
{"rt2"},
},
},
},
linkback="block_00358",
linknext="block_00360",
},
block_00360={
{"bg",file="black",path=":bg/"},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"... Al final me confiscó el cuaderno de dibujos. Sabía que esto terminaría así,\npero es realmente una lástima.",
{"rt2"},
},
},
},
linkback="block_00359",
linknext="block_00361",
},
block_00361={
{"msgoff"},
{"bg",file="bg032c",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Piensas verlo cuando me vaya?”",
{"rt2"},
},
},
},
linkback="block_00360",
linknext="block_00362",
},
block_00362={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002952",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No lo voy a ver. Pero lo guardaré...”",
{"rt2"},
},
},
},
linkback="block_00361",
linknext="block_00363",
},
block_00363={
{"text"},
text={
ja={
{
"Ya calmada después del alboroto, Toritani estaba ahora acariciando con su dedo\nla portada del cuaderno.",
{"rt2"},
},
},
},
linkback="block_00362",
linknext="block_00364",
},
block_00364={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0028",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002953",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Lo importante es que dibujaste.”",
{"rt2"},
},
},
},
linkback="block_00363",
linknext="block_00365",
},
block_00365={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo importante?”",
{"rt2"},
},
},
},
linkback="block_00364",
linknext="block_00366",
},
block_00366={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002954",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí. Aun después de haber insistido tanto en que no pintarías, lo hiciste para\nmí. Te agradezco que, a pesar de haberlo puesto todo como un juego al\nprincipio... pintaras.”",
{"rt2"},
},
},
},
linkback="block_00365",
linknext="block_00367",
},
block_00367={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me estás poniendo muy por encima de lo que realmente soy.”",
{"rt2"},
},
},
},
linkback="block_00366",
linknext="block_00368",
},
block_00368={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente dije que no pintaría. Pero mis palabras son siempre poco serias y\npueden cambiar. Lo mejor es que no te las tomes a pecho.”",
{"rt2"},
},
},
},
linkback="block_00367",
linknext="block_00369",
},
block_00369={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002955",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿De verdad es así? No puedo creer eso, realmente...”",
{"rt2"},
},
},
},
linkback="block_00368",
linknext="block_00370",
},
block_00370={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha... No estás entendiendo nada ahora, así que me tomaré la oportunidad de\naclarar todo. Dibujé porque me diste permiso para verte tanto como me diera\nla gana. ¿Te quedó claro?”",
{"rt2"},
},
},
},
linkback="block_00369",
linknext="block_00371",
},
block_00371={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006h",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002956",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh, l-lo confiesas con tanta sinceridad...”",
{"rt2"},
},
},
},
linkback="block_00370",
linknext="block_00372",
},
block_00372={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué parte no me entendiste de que aclararía todo? No soy ningún santo como\npara dejar pasar de largo esta tremenda oportunidad.”",
{"rt2"},
},
},
},
linkback="block_00371",
linknext="block_00373",
},
block_00373={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002957",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Realmente eres un pervertido...”",
{"rt2"},
},
},
},
linkback="block_00372",
linknext="block_00374",
},
block_00374={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, y lo diré tanto como sea necesario. Soy un depravado.”",
{"rt2"},
},
},
},
linkback="block_00373",
linknext="block_00375",
},
block_00375={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002958",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y a pesar de eso, no has tratado de hacerme nada en la realidad...”",
{"rt2"},
},
},
},
linkback="block_00374",
linknext="block_00376",
},
block_00376={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso sería un crimen.”",
{"rt2"},
},
},
},
linkback="block_00375",
linknext="block_00377",
},
block_00377={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0013",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0007",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002960",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... ¡Ah! ¡¡Lo sé!! ¡¡¡Y si llegaras a tratar de atacarme y hacerme algo, te\npatearía hasta más no poder, sin mediar palabra!!!”",
{"rt2"},
},
},
},
linkback="block_00376",
linknext="block_00378",
},
block_00378={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me gustaría para nada que por tratar de acosarte terminaras odiándome, y por\neso no lo haré.”",
{"rt2"},
},
},
},
linkback="block_00377",
linknext="block_00379",
},
block_00379={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002961",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“S-Si es así, entonces... pues sí, me alegro que lo entiendas...”",
{"rt2"},
},
},
},
linkback="block_00378",
linknext="block_00380",
},
block_00380={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque si fuéramos novios entonces entre tantos 'no quiero' hubiéramos\nterminado en un 'sí quiero'.”",
{"rt2"},
},
},
},
linkback="block_00379",
linknext="block_00381",
},
block_00381={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0013",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0007",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002962",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“----¡¡No somos novios ni estamos saliendo!!”",
{"rt2"},
},
},
},
linkback="block_00380",
linknext="block_00382",
},
block_00382={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002963",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Escúchame muy bien. ¡De ninguna forma voy a salir con alguien solo porque no le\nimportan que los demás malinterpreten las cosas, ni porque le convenga! ¡Ni\ncreas que lo haré!”",
{"rt2"},
},
},
},
linkback="block_00381",
linknext="block_00383",
},
block_00383={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0018",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002964",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡Y buenas noches!!”",
{"rt2"},
},
},
},
linkback="block_00382",
linknext="block_00384",
},
block_00384={
{"bg",file="black",path=":bg/"},
{"se",file="se2225",vol=50,id=1},
{"text"},
text={
ja={
{
"Parece que me corrieron por hoy.",
{"rt2"},
},
},
},
linkback="block_00383",
linknext="block_00385",
},
block_00385={
{"text"},
text={
ja={
{
"Bueh, no importa. Hoy fue un día divertido. Regresemos a casa.",
{"rt2"},
},
},
},
linkback="block_00384",
linknext="block_00386",
},
block_00386={
{"bgm",stop=1,time=2000},
{"bgm",stop=1,time=2000},
{"se",stop=1,id=-1,time=2000},
{"vostop",stop=1,time=2000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=2000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"excall",file="03_picapica_07_1"},
{"text"},
linkback="block_00385",
},
label = {
top={block="block_00000",label=1},
join1={block="block_00316",label=1},
},
}
