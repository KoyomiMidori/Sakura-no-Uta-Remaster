astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg003a",path=":bg/",sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm005"},
{"text"},
text={
ja={
{
"Reviso lo que queda en el refrigerador.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0700",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku, ¿hay algo que no te guste?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0008",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000058",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Algo que no me guste...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0017",head="shz_z1b",lv=4,id=9},
{"fgact",ch="雫",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000059",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Odio eso de morir...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso lo sé, pero... ¡Espera, no me refiero a eso! Nadie está hablando de eso.\n¡Además, la muerte no es algo que se 'odia', es algo que se teme! ¡¿No?!”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me refiero a la comida, a la comida. Hay gente que odia los pimentones, o el\napio, o muchas otras cosas, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0004",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000060",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me gusta comer.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fgact",ch="雫",act="ジャンプ",lv=4,id=9},
{"text"},
text={
ja={
{
"Una radiante sonrisa.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Pasó de estar completamente inexpresiva a tener una repentina sonrisa en su\nrostro. Eso es, ciertamente, típico de ella.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0001",head="shz_z1b",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, no tienes ninguna comida en particular que no te guste, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fgact",ch="雫",act="うんうん",time=400,size=5,lv=4,id=9},
{"text"},
text={
ja={
{
"Shizuku asiente con la cabeza varias veces.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"No es muy habladora, pero es una chica con muchas reacciones distintas.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Preparo el desayuno entonces?”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0003",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000061",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Desayuno? ¿Qué vas a preparar?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué quieres comer?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0016",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000062",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Carne.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Carne, eh.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
"Carne desde la mañana.",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"se",id=1,file="se2397"},
{"text"},
text={
ja={
{
"Reviso el contenido del refrigerador.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Tal como me lo imaginaba, se había acabado la carne.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La carne se acabó anoche. No hay salchichas, ni jamón ni tocino tampoco.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Por eso tenía planeado para el desayuno de hoy preparar salmón salado y sopa\nmiso.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0009",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000063",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No hay carne?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay. Ni siquiera hay nada ahumado como jamón o salchichas.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0011",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000064",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero no te preocupes. Haré algo respecto a la carne.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0013",head="shz_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_szd_000065",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Vas a ir a comprarla?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no, no hay ninguna tienda abierta a esta hora, ¿no? En fin,\nobserva y verás. Voy a preparártela.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0700",face="b0012",head="shz_z2b",x=345,lv=5,id=6,sync=0},
{"extrans",rule=139,vague=40},
{"bg",file="ev_uni_c12_01",zoom=35,x=-300,id=9,lv=9,y=-209,time=300,path=":ev/ev_uni_c12/",set="ev_uni_c12",ax=960,ay=947,bx=0,by=-407},
{"text"},
text={
vo={
{"vo",file="fem_szd_000066",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A qué se te parece?”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fgact",ch="雫",act="停止",lv=5,id=6},
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0013",head="shz_z2b",x=345,lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0008",head="shz_z2b",x=345,lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000067",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Albóndigas? Pero se supone que no había carne.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. En fin, toma un bocado.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0012",head="shz_z2b",x=345,lv=5,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="雫",act="うんうん",time=1000,size=10,lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000068",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Umuh. *mokyuh, mokyuh*...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué tal?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fgact",ch="雫",act="停止",lv=5,id=6},
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0004",head="shz_z2b",x=345,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000069",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Está muy bueno.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"cgdel",id=-1},
{"fg",ch="雫",speed=800,mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0004",head="shz_z2b",x2=345,x=0,lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Verdad? Pero no son albóndigas de carne.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0013",head="shz_z2b",x=0,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000070",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Eh? Pero, por más que las vea son albóndigas de carne, y el sabor también...”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No he usado nada de carne. Toma, observa esto.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0009",head="shz_z2b",x=0,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000071",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿K O U K I B I? ¿Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no, es sorgo (Takakibi). Sorgo.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0017",head="shz_z2b",x=0,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000072",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Sorgo? ¿Maíz?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no. El sorgo tiene una elasticidad y un sabor parecido al de la carne\nmolida, así que los vegetarianos lo usan bastante en lugar de carne de res.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si la usas como caldo en sopas chinas, toman un sabor aún más cercano a la\ncarne.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se conserva mucho mejor que la carne, así que es perfecta para esos momentos en\nlos que quieres comer carne. Es además barata, y baja en calorías, así que\nquizás sea adecuada también para trabajos como el tuyo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0004",head="shz_z2b",x=0,lv=5,id=6},
{"fgact",ch="雫",act="うんうん",time=700,size=10,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000073",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“*mokyu, mokyu*...”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Shizuku comienza a comer de nuevo, antes de que yo terminara mi explicación.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Así de hambrienta habrá estado.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0020",head="shz_z2b",x=0,lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estás llorando de nuevo?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fgact",ch="雫",act="停止",lv=5,id=6},
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0019",head="shz_z2b",x=0,lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0011",head="shz_z2b",x=0,lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000074",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ah, esto es como un hábito mío... No le prestes tanta atención.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Observo a Shizuku.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"Shizuku se lleva silenciosamente a la boca las albóndigas de sorgo.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Shizuku Natsume...",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Shizuku.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"Ya veo.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"Mientras me repetía el nombre de Shizuku en mi mente, me acordé también del\nnombre de ella.",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Ciertamente, la última silaba de su nombre evocaba a la 'muerte.' (shi) (死)",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"Por eso, esa sílaba había desaparecido de su nombre.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"No pensé que me daría cuenta justo en este momento...",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Así de grande fue su existencia... Kenichiro Kusanagi...",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b0700",face="b0001",head="shz_z1b",lv=4,id=6},
{"text"},
text={
ja={
{
"Mi mirada se cruza con la de ella.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
"Sentí que se había dado cuenta de lo que estaba pensando, así que por un\ninstante bajo mi mirada.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0008",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000075",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“... Toma.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Shizuku me extendió las albóndigas con vinagre dulce aún a mitad de comer.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? ¿Ya no quieres más? ¿O es que no están buenas?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0002",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="いいえ",size=3,time=300,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0009",head="shz_z1b",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000076",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No. Están muy buenas. Pero no has comido...”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No te preocupes por mí. No tengo tanta hambre tampoco.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0012",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000077",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oye, Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0002",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000078",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Saben bien?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0003",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000079",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0004",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000080",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y... gracias.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"La inexpresiva Shizuku sonríe felizmente.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Sin querer, acabé apartando mi mirada a un lado.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Me sorprendí cuando comenzó a llorar al comer lo que preparé, pero bueno,\nsupongo que es normal que suceda esto también.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"Porque ella es――",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0700",face="b0010",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000081",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="雫",my=40,mode=-1,lv=4,id=6},
{"se",id=1,file="se2766"},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eh! ¡¿O-Oye, estás bien?!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"msgoff"},
{"bg",x=-800,y=-473,zoom=90,file="zbg004a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2b0700",face="b0010",head="shz_z2b",lv=5,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_szd_000082",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Zzz...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"¿Dormida?",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0019",head="shz_z2b",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000083",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Zzz... Esto es... una, deuda...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Está hablando dormida...",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"excall",label="flagon01",cond="g.rinclear==1&&g.makclear==1&&g.rnaclear==1"},
{"excall",label="flagoff01"},
{"text"},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"select",label="label01",text="select"},
{"select",label="label02",exp="f.shz=f.shz+1",text="select"},
{"select",name="select01_01_1",mode="sys"},
{"text"},
select={
ja={
"Mejor hago como si no hubiera oído nada.",
"No es una deuda.",
{"rt2"},
},
},
labelcount=1,
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"No... mejor hago como si no hubiera oído nada.",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"No me gustaría que tomara incluso algo como esto como una deuda.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"excall",label="join01"},
{"text"},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es ninguna deuda. Con esto ya se saldó...”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0700",face="b0020",head="shz_z2b",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000084",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya... Siempre... tan tramposo...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cómo que tramposo?... Por Dios.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"excall",label="join01"},
{"text"},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"msgoff"},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien...”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Observo el reloj.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"Aún es muy temprano como para levantarse.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, si te duermes acá vas a agarrar una gripe... Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"cgact",stage="bg004",act="rlr",time=1000,size=5},
{"se",file="se9009",id=1},
{"text"},
text={
ja={
{
"Toco un par de veces los cachetes de Shizuku con mi dedo.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"No hay ninguna reacción.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Bueh, es de esperarse. Después de haber pasado una noche entera sin dormir...",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me queda de otra...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Cargo a Shizuku en mis brazos. Era tan ligera como un edredón relleno.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Estará comiendo bien?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"¿No pesa casi lo mismo que un perro de tamaño mediano?...",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg002a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Al estar frente a la habitación de Shizuku, se me ocurrió.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
"¿Será que no hay problema con que cargue a una muchacha de esta edad?",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"¿Y, por encima de eso, que entre a su habitación?",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"No me había preocupado tanto por eso mientras la traía hasta acá, pero...",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es esta situación algo peligrosa?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
name={"Naoya"},
"“O no, más bien sí lo es, por lo general...”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Aunque de igual manera no puedo abandonar a Shizuku acá.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Bueno, no tengo ningún sentimiento oscuro.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Juro por los cielos que no tengo ninguna oscura intención!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Por ahora, le juro eso a Dios.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Por los momentos.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"se",id=1,file="se1372"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg007a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
"Había vacilado un poco en entrar, pues se trataba de la habitación de una\nchica, pero... me quedé asombrado.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es aún más sobria que mi habitación...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Pero qué panorama tan monótono.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tiene casi cosas.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
"Bueno, supongo que eso es típico de Shizuku.",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La forma más extrema de organización es reducir las posesiones de uno, supongo.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"cgact",stage="bg007",act="ジャンプ",size=10,time=700},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
"Recuesto a Shizuku sobre el futón.",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aún hay algo de tiempo, descansa hasta que sea la hora.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque dicen que los trasnochos son los peores enemigos de la belleza...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
"La Shizuku de ahora puede preocuparse por ese tipo de cosas ordinarias, sin\nproblema alguno.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque eres solo una muchacha...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"se",id=1,file="se1372"},
{"msgoff"},
{"bg",file="bg002a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1e0700",face="e0012",head="aix_z1e",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",stop=1,time=1},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000256",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Eh?!”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm? Ahh, Ai, ¿ya despertaste?”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0700",face="e0013",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0700",face="e0005",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000257",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Ehhhhh! ¡N-Naoya! ¡¿Tú, d-de dónde saliste?!”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De dónde? Pues, de la habitación de Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bg",file="black",path=":bg/"},
{"fg",mode=-2,sync=0},
{"bg",zone="0x000000",file="bg007a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2b0600",face="b0001",head="shz_z2b",x=-345,lv=5,id=5,sync=0},
{"fg",ch="直哉",size="z2",mode=3,resize=1,path=":fg/nao/z2/",file="nao_z2a0200",face="a0001",head="nao_z2a",x=210,lv=5,id=8,sync=0},
{"bg",file="icon_heart",id=9,lv=9,zoom=70,x=500,y=-250,path=":cg/",ax=250,ay=250,bx=710,by=290,sync=0},
{"se",file="se9011",id=1},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=500},
{"ex",time=1200,func="wait"},
{"se",file="se3130",id=1},
{"cgdel",id=-1},
{"bg",time=100,file="black",path=":bg/"},
{"fg",mode=-2,sync=0},
{"bg",file="bg002a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0700",face="e0005",head="aix_z1e",lv=4,id=9,sync=0},
{"extrans",time=100},
{"bgm",file="bgm015"},
{"quake",mode="mw"},
{"quake"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Ah?!”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Escucha. No es lo que crees. No sé qué clase de malentendido tienes, pero...\nno es eso.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0700",face="e0006",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000258",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡¿Qué se supone que no es?! ¡Acabas de salir de la habitación de Shizuku, de\nuna muchacha que acaba de entrar en su edad reproductiva, y en pleno\namanecer!”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No! ¡Te equivocas! ¡Aunque sí es cierto que acabo de salir de la habitación de\nShizuku! ¡Pero no es nada de lo que crees!”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2e0700",face="e0007",head="aix_z2e",lv=5,id=9},
{"bg",lv=8,id=8,file="line2",time=0,notone=1,path=":ani/",ax=960,ay=540,bx=0,by=0},
{"se",id=1,file="se2362"},
{"quake"},
{"ex",time=200,func="wait"},
{"cgdel",lv=8,id=8,time=400},
{"text"},
text={
vo={
{"vo",file="fem_aid_000259",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡No necesito ninguna explicación!”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"msgoff"},
{"bg",time=100,sync=1,file="black",path=":bg/"},
{"se",id=2,file="se1747"},
{"bg",file="閃光中",id=9,lv=9,rule=105,time=100,sync=1,path=":cg/battle/",set="battle"},
{"quake",size=30},
{"ex",time=500,func="wait"},
{"bgm",stop=1,time=1000},
{"bg",time=500,file="black",path=":bg/"},
{"ex",time=1500,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",lv=4,id=9,sync=0},
{"extrans",rule=139,vague=40},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"bgm",file="bgm037"},
{"text"},
text={
vo={
{"vo",file="fem_aid_000260",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Lo siento! ¡Perdóname, por favor!”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"quake",size=4,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Si vas a disculparte entonces procura no golpearme más bien!”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000261",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Es que si cualquiera te viera saliendo de la habitación de Shizuku en la\nmañana, creería que...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
"Un huésped hombre saliendo temprano en la mañana de la habitación de su\nhermanita.",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Pues, sí, tal como Ai lo dice, cualquiera malinterpretaría las cosas.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
"Es por eso que lo único que podría decirle es 'te lo dije'.",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Demonios, ya te lo había dicho. Te había preguntado si no había problema con\nque alguien ajeno a la familia se quedara a vivir acá.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0013",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000262",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero yo confió en ti...”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eres capaz de golpear sin mediar palabras a alguien en quien confías? Teniendo\ncinturón en varias artes marciales.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000263",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero tengo tercer nivel en contaduría... Realmente soy mala con los cálculos.\nSoy del campo de sociales y humanismo, hasta la médula.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="藍",size="z2",mode=3,resize=1,path=":fg/aix/z2/",file="aix_z2f0000",face="f0011",head="aix_z2f",lv=5,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡EL HECHO DE QUE SEPAS O NO CONTADURÍA NO CAMBIA LA\nFUERZA DE TUS GOLPES!”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0009",head="aix_z2f",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z2",mode=3,path=":fg/aix/z2/",file="aix_z2f0000",face="f0020",head="aix_z2f",lv=5,id=9},
{"fgact",ch="藍",act="おじぎ",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000264",ch="aid"},
},
ja={
{
name={"Ai"},
"“C-Ciertamente, pero... sí, tienes razón, pero... Lo siento. Realmente actúe de\nuna manera muy precipitada...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1f0000",face="f0020",head="aix_z1f",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuh... ¿No te parece que realmente sí hay problemas con esto?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0013",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000265",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Eh? ¿C-Con qué?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, con que yo viva aquí.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0014",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="うんうん",lv=4,id=9},
{"fgact",ch="藍",act="icon",y=-500,loop=-1,lv=4,id=9,icon="icon18z1",x=-150},
{"text"},
text={
vo={
{"vo",file="fem_aid_000266",ch="aid"},
},
ja={
{
name={"Ai"},
"“E-Eso no es verdad.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fgact",ch="藍",act="停止",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tus palabras no me convencen ni un poco...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0011",head="aix_z1f",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000267",ch="aid"},
},
ja={
{
name={"Ai"},
"“Yo quise vivir con Shizuku. Y con Kei, y también contigo, a-así que...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku y Kei son tu familia, ¿no?... No me pongas en el mismo envase que a\nellos.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0019",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000268",ch="aid"},
},
ja={
{
name={"Ai"},
"“N-No quise decir eso, sino que...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, no importa. También fue mi culpa por no haber sido lo suficientemente\nprecavido. En realidad, también me había parecido que no estaba del todo bien\nentrar...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0009",head="aix_z1f",lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000269",ch="aid"},
},
ja={
{
name={"Ai"},
"“Lo siento... Naoya...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Ai pone una cara triste.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Ai siempre me llama como 'Kusanagi'.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"Eso no es de hace tiempo.",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"Cuando Kenichiro Kusanagi aún estaba vivo, me llamaba Naoya.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Por supuesto, con 2 Kusanagis vivos tendría que llamarme en algún momento por\nmi nombre.",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
"Pero, aun así, al parecer Ai comenzó a tratar de llamarme en la medida de lo\nposible 'Kusanagi' desde que se volvió profesora.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Esto también es para evitar llamar a uno de sus alumnos por su nombre en el\ncolegio.",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Por eso, desde que papá murió, me ha estado llamando 'Kusanagi'.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Sin embargo, siempre que explotan sus sentimientos hacia afuera, el nombre que\nAi usa para llamarme cambia de 'Kusanagi' a 'Naoya'.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Seguramente lo hace sin querer.",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"(Supongo que no debería acorralar tanto a Ai...)",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0001",head="aix_z1e",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, está bien, ya entendí. Pero por favor, no vuelvas a golpearme de nuevo\nsin mediar ninguna palabra.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0020",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うんうん",time=300,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000270",ch="aid"},
},
ja={
{
name={"Ai"},
"“Naoyaaa.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, no pongas esa cara. ¿Qué pasó con los aires de onee-san que tienes\nsiempre?”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000271",ch="aid"},
},
ja={
{
name={"Ai"},
"“S-Sí, t-tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, cierto, ya el desayuno está listo. Aún es un poco temprano pero ¿quieres\ncomer ya?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000272",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, creo que sí. Iré a despertar a Kei también.”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, te lo encargo.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="01_fruhlingsbeginn_01_3"},
{"text"},
linkback="block_00180",
},
label = {
top={block="block_00000",label=1},
flagon01={block="block_00088",label=1},
flagoff01={block="block_00089",label=1},
label01={block="block_00089",label=1},
label02={block="block_00092",label=1},
join01={block="block_00096",label=1},
},
}
