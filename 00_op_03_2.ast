astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué buena habitación, eh.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Una habitación bastante normal de 6 tatamis.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"No tenía mucha decoración alrededor, pero era una habitación con un aspecto\nbastante limpio.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Había escuchado que la habitación que me asignaron no había sido usada durante\ntodo este tiempo, pero estaba tan limpia y mantenida que no daba esa\nimpresión.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Supongo que es una habitación bastante importante...",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Si no le hubieran hecho mantenimiento constante, estaría en peores condiciones.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"El mantenimiento que le han hecho, es como si... la tuvieran preparada para que\ncualquier persona pueda vivir acá en cualquier momento.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"se",id=1,file="se1412_l"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans"},
{"text"},
text={
ja={
{
"Al abrir las ventanas, un viento un tanto frío sopló hacia adentro.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Sin embargo, con la habitación templada con el sol de abril, el frío del viento\nse me hizo confortable.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué cálido está...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A pesar de que hasta hace poco teníamos el frío de invierno...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
"Comienzo de abril. Siempre me quedo sorprendido ante las diferencias de\ntemperatura de esta época.",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"El frío de hace unas pocas semanas cambió ahora a los templados rayos del sol.\nParece mentira.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Se pueden ver cerezos de montaña desde la ventana.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Parece que extrañamente este año los cerezos Yoshino y los cerezos de montaña\nflorecieron juntos…",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fue porque se puso cálido de repente el clima, eh...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"El contraste entre los blancos cerezos Yoshino y los ligeramente rosados\ncerezos de montaña es asombroso...",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, no es hora de andar quedándome admirando esto. Tengo que desempacar todo\neste equipaje y organizarlo.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
"Comienzo a organizar las cajas que Kei abrió desordenadamente.",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ese idiota... Lo único que hizo fue desordenar los libros que estaban dentro de\nla caja...”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"fg",ch="圭",size="z1",mx=40,mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000254",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Cómo vas con el desempaque?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No ves que acabo de comenzar?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000255",ch="ked"},
},
ja={
{
name={"Kei"},
"“Creo que te ayudaré.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta, ya voy a terminar.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000256",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Ya vas a terminar?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, con esto termino...”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000257",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿De veras solo tienes esto de equipaje?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, solo pienso quedarme hasta que terminen las reparaciones del apartamento.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Organicé rápidamente lo que estaba en las cajas. La ropa al closet, y los\nlibros al estante. Todo terminó en un instante.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo único que me falta es decidir dónde guardaré la tabla de dibujo que dejé\nrecostada sobre la pared, y los instrumentos de pintura.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000258",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Dejaste todos tus muebles en casa? ¿No van a traerlos después?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo estaré acá de unas cuantas semanas a unos cuantos meses, así que es\nsuficiente con esto.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000259",ch="ked"},
},
ja={
{
name={"Kei"},
"“Realmente no trajiste casi nada... ¿Eh? Hay un álbum.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Álbum?”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000260",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí. Esto es un álbum, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"se",file="se9010",id=1},
{"bg",file="ev_com_a10_05",path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
ja={
{
"Kei sacó un libro que estaba en una esquina del estante y lo abrió de repente.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Y como si fuera algo totalmente obvio, por supuesto, no me pidió permiso para\nhacerlo.",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"La carpeta con todos los documentos relacionados a la herencia... junto a los\ndocumentos de los que tuve que encargarme cuando mamá murió, junto a otros\ntantos…",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"Hay un estante de libros donde estuve acumulando, desde que comencé a vivir en\nese apartamento, todos los documentos que parecían ser importantes.",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
"Recuerdo que metí todos los documentos y libros que habían en ese estante en la\ncaja, sin preocuparme por revisarlos.",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
"Así que se me había olvidado por completo que se trataba de ese álbum.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿También estaba ese álbum adentro? Si me hubiera dado cuenta no hubiera traído\nesa cosa tan innecesaria...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"bg",file="ev_com_a10_04",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000261",ch="ked"},
},
ja={
{
name={"Kei"},
"“No le digas innecesaria. Los recuerdos son importantes.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Recuerdos importantes, eh...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",mode=-2},
{"bg",file="ev_com_a10_03",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000262",ch="ked"},
},
ja={
{
name={"Kei"},
"“Eh, no has colocado muchas fotos.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Mientras pasaba rápidamente las páginas, Kei dijo eso brevemente. A pesar de\nque el álbum como tal es grueso, en realidad solo he usado alrededor del 1/10\nde su espacio total.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"bg",file="ev_com_a10_04",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000263",ch="ked"},
},
ja={
{
name={"Kei"},
"“Aryarya, parece que lo único que has hecho es juntar todas tus fotos de niño de\nmanera desordenada. Y esa manera de pegarlas, está todo repleto de huecos...”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me parece que los álbumes fueron hechos para eso.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="man_ked_000264",ch="ked"},
},
ja={
{
name={"Kei"},
"“No, no es eso, ¿cómo podría decirlo? En pocas palabras, es aburrido.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué se supone que tengo que entretenerte con mi álbum?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bg",file="ev_com_a10_09",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000265",ch="ked"},
},
ja={
{
name={"Kei"},
"“Me parece que sería más atractivo para el lector que lo edites de una manera\nmás apegada al tema de tu crecimiento.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué se supone que debo exponer mi pasado editándolo tanto a gusto del\nlector?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
vo={
{"vo",file="man_ked_000266",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues, obviamente, para entretenerme a mí.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es suficiente tu cara para entretener a los demás.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"bg",file="ev_com_a10_06",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000267",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ya te dije que mi cara no tiene nada de cómica ni entretenida!”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hay forma de que mi álbum se vuelva entretenido. Y en primer lugar, la razón\npor la cual hay pocas fotos es porque le pertenece a otra persona.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"bg",file="ev_com_a10_09",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000268",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿De otra persona? Pero si está lleno de puras fotos tuyas.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, hay varias circunstancias de por medio.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="man_ked_000269",ch="ked"},
},
ja={
{
name={"Kei"},
"“Varias circunstancias, eh.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bg",file="ev_com_a10_07",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000271",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, mira, mira, observa esta cara.”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Mi mirada daba miedo, así que los adultos solían enfadarse conmigo.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"bg",file="ev_com_a10_09",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
delay={
vl01={
{"bg",file="ev_com_a10_05",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
},
},
text={
vo={
{"vo",file="man_ked_000272",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Se enfadaban contigo? ¿De verdad? A mi parecer, más bien me das la imagen de\nque le buscabas peleas a los adultos en ese entonces...”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque en realidad no era así...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"bg",file="ev_com_a10_07",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="man_ked_000273",ch="ked"},
},
ja={
{
name={"Kei"},
"“Jajaja, pero cuando éramos pequeños, yo estaba secretamente fascinado por la\nmanera en que ni siquiera te acobardabas ante los adultos.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te estoy diciendo que las cosas no eran así.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Y mientras decía eso, Kei comenzó a comparar al yo niño de las fotos y al yo de\nahora.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"bg",file="ev_com_a10_05",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000274",ch="ked"},
},
ja={
{
name={"Kei"},
"“Oh, pero qué nostálgico esto. ¿No es esta foto de la época en la cual nos\nconocimos?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues sí.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"bg",file="ev_com_a10_07",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000275",ch="ked"},
},
ja={
{
name={"Kei"},
"“Para esa época, aún a pesar de ser un niño te la pasabas causando revuelo en\nlas exhibiciones de arte.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"bg",file="ev_com_a10_03",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000276",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Quién es esta chica? La chica de esta foto.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"bg",file="ev_uni_c68_01",path=":ev/ev_uni_c68/",set="ev_uni_c68"},
{"text"},
text={
ja={
{
"En la esquina derecha de la página abierta que Kei me mostró, había una vieja\nfotografía pegada.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"En ella había una niña parada.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Dentro del bosque de cerezos... viendo hacia la cámara con una sonrisa.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bg",file="ev_com_a10_09",path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000277",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué pasa?... ¿Por qué te callaste de repente? ¿Sucede algo? ¿Hay algo con esta\nchica?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no es nada...”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
vo={
{"vo",file="man_ked_000278",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué pasa? ¿Quién es esta chica?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni idea.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"bg",file="ev_com_a10_04",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000279",ch="ked"},
},
ja={
{
name={"Kei"},
"“Solo estás pretendiendo que no sabes.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué piensas eso?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
vo={
{"vo",file="man_ked_000280",ch="ked"},
},
ja={
{
name={"Kei"},
"“Porque en el instante en que viste la foto te detuviste. Tu expresión se detuvo\npor completo. No era para nada la cara de alguien que ve la foto de un\ndesconocido. Tenías una cara de 'Ah, esta foto...'.”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa... tienes perspicacia para cosas sin importancia alguna, eh.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sé quién es.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"bg",file="ev_com_a10_09",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000281",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Quién es? Tus fotos también son así, pero la foto de esta chica es también de\ncuando aún era solo una niña, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, es una foto de cuando era una niña. Vivía cerca de mi casa hace tiempo.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
vo={
{"vo",file="man_ked_000282",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Vivían en el mismo edificio?”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, vivía cerca. Justo al lado de mi edificio.”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
delay={
vl01={
{"bg",file="ev_com_a10_04",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
},
},
text={
vo={
{"vo",file="man_ked_000283",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Cerca? ¿No se supone que el terreno que está al lado de tu edificio es un\nterreno desocupado?”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, creo que sí...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Su apellido es Misakura, y su nombre es Rin.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"bg",file="ev_com_a10_09",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000284",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ehh, ¿y dónde está esta muchacha ahora? No está en el colegio Yumihari,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ella se mudó. Ya no vive en esta ciudad.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
delay={
vl01={
{"bg",file="ev_com_a10_04",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
},
},
text={
vo={
{"vo",file="man_ked_000285",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ya veo. Qué mal.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué mal? ¿Qué cosa?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"bg",file="ev_com_a10_07",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000286",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pues, es bastante linda, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kei, ¿eres un lolicon?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bg",file="ev_com_a10_06",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000287",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué debería ser un lolicon?!”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues al ver esta foto dijiste que era bastante linda, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="man_ked_000288",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No! ¡Quise decir que ahora debe ser toda una belleza!”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Linda, eh.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Jamás llegué a tener consciencia de eso...",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Ciertamente, quizás para la época en que se tomó esta foto, a mí me gustaba\nRin.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Aunque esos sentimientos de 'gustar' eran los típicos de un niño de esa edad.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Ahora que ha pasado tanto tiempo desde ese entonces, ¿de qué manera habrá\ncambiado la percepción de los dos?",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"No lo sé muy bien ahora.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"bg",file="ev_com_a10_09",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000289",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Más o menos cuándo se mudó?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Diría que alrededor de hace seis o siete años. Fue hace bastante tiempo.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="man_ked_000291",ch="ked"},
},
ja={
{
name={"Kei"},
"“Mmm, ¿y no la has visto más desde entonces?”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no la he visto más.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="man_ked_000292",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Ni una sola vez? ¿Y se han escrito cartas?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cartas...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="man_ked_000293",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Mm? ¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, ¿pues cómo lo digo? Recordé que llegué a recibir cartas de Rin, pero nunca\nllegué a contestarle ni una sola vez...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"bg",file="ev_com_a10_03",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000294",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué?!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, así es mi personalidad...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"bg",file="ev_com_a10_04",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000295",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué clase de personalidad es esa? ¡No le respondiste ni una vez a las cartas\nde tu amiga de la infancia! ¡¿Es que acaso no tienes corazón alguno,\nimbécil?!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hmm, sí, más o menos me da esa impresión, aunque realmente no pude responderle\ntampoco.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
vo={
{"vo",file="man_ked_000296",ch="ked"},
},
ja={
{
name={"Kei"},
"“Mmm, ¿no habrá manera de volver a encontrarla en algún lado?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué te pasa? Parece que quedaste cautivado con Rin, eh. ¿Amor a primera vista?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"bg",file="ev_com_a10_03",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000297",ch="ked"},
},
ja={
{
name={"Kei"},
"“N-No, no quise decir eso. Sino que debe conocer muchas leyendas de tu infancia\nque yo no conozco, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esas leyendas no existen.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"bg",file="ev_com_a10_07",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000298",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Debe saber muchas interesantes y terriblemente divertidas historias de cuando\neras un niño!”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si es por historias interesantes y terriblemente divertidas, tú las produces\ntodos los días, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bg",file="ev_com_a10_06",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000299",ch="ked"},
},
ja={
{
name={"Kei"},
"“Claro que no.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bueno, de igual manera, ella debe haberse olvidado ya de mí.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"bg",file="ev_com_a10_04",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000300",ch="ked"},
},
ja={
{
name={"Kei"},
"“Me parece que no. Las memorias de la infancia suelen perdurar bastante.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Las memorias de la infancia perduran?...”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
vo={
{"vo",file="man_ked_000301",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, así es.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tienes razón. Pero nadie sabe de qué manera perduran, así que hay que tener\ncuidado.”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
vo={
{"vo",file="man_ked_000302",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué hablas de esa manera? ¿Acaso le hiciste algo malo a esta muchacha?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es posible.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"bg",file="ev_com_a10_08",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000303",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uhh... Después de haberle hecho algo malo y dejar de necesitarla, no le\nrespondes sus cartas. ¿Pero qué clase de demonio sin corazón eres?...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Al escapársele esas palabras, Kei dejó caer desanimadamente sus hombros y\nsiguió hojeando el álbum.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"bg",file="ev_com_a10_03",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000304",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? Esa era la última foto, no debería salir nada más aunque sigas\nhojeando.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bg",file="ev_com_a10_09",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000305",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sí, así es, pero... no es eso. ¿Por qué todas las páginas que vienen después de\nla foto de esta muchacha tienen pétalos de flor de cerezo adentro?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pétalos de flor de cerezo?”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"Al alcanzar a ver el álbum, vi que varias páginas que venían después de la foto\nde Rin tenían pétalos adentro.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esto es...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Jamás me había dado cuenta de esto...",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"De que estaban todos estos pétalos de flores de cerezo pegados a las páginas...",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="man_ked_000306",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Trataste de hacer unas oshibana?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no es eso...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="man_ked_000307",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Entonces por qué hay pétalos de flores adentro?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo idea. Tal como te dije hace un rato, ese álbum no es mío. No sé por\nqué el dueño original puso pétalos de flores adentro.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero... probablemente fue porque la última vez que abrió fue debajo de un árbol\nde cerezos...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"bg",file="ev_com_a10_04",sync=0,face=1,time=400,path=":ev/ev_com_a10/",set="ev_com_a10"},
{"text"},
text={
vo={
{"vo",file="man_ked_000308",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Qué dices? ¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Solo hablaba solo. En fin, dame eso ya. Originalmente ese álbum le pertenece a\notra persona, no está bien que lo veas sin permiso alguno.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"bgm",stop=1,time=1000},
{"se",file="se9010",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Le arrebaté el álbum a Kei y lo regresé al estante.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bg",file="zev_com_a10_04",zoom=70,x=-110,y=210,path=":ev/ev_com_a10/",set="ev_com_a10",ax=1920,ay=1080,bx=-960,by=-540},
{"bgm",file="bgm031"},
{"text"},
text={
vo={
{"vo",file="man_ked_000309",ch="ked"},
},
ja={
{
name={"Kei"},
"“Aun siendo relativamente popular con las chicas, es por esa personalidad que\ntienes que no consigues novia.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="man_ked_000310",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué no le respondiste en ningún momento a esa chica? Es por ser tan poco\natento y desconsiderado que no tienes remedio alguno.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="man_ked_000311",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿'Ya veo'? ¿Sabes lo que estás diciendo? Ahh, es que eres un tanto popular con\nlas chicas, sí.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo soy. El tiempo que llevo viviendo = Tiempo sin novia.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"bg",file="zev_com_a10_06",sync=0,face=1,time=400,zoom=70,path=":ev/ev_com_a10/",set="ev_com_a10",ax=1920,ay=1080,bx=-960,by=-540,x=-110,y=210},
{"text"},
text={
vo={
{"vo",file="man_ked_000312",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Pero acaso no se te confiesan a cada rato?!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No he recibido tantas confesiones así. Además, el número de confesiones que uno\nrecibe no equivale al grado de popularidad con las chicas...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
vo={
{"vo",file="man_ked_000313",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Claro que sí! ¡Que se te confiesen bastante es lo mismo a ser muy popular con\nlas mujeres!”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no. ¿Ser popular con las chicas no implica acaso poder salir\ncon la chica que te gusta? A alguien como yo cuyo tiempo viviendo = tiempo\nsin novia, no se le llama 'popular con las chicas'.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="man_ked_000314",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ahh, Naoya, dices una cosa y luego vienes con otra. Demonios, ¿es que acaso\nestás en tu período de rebeldía, hermanito?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tal vez, onee-chan.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bg",file="zev_com_a10_08",sync=0,face=1,time=400,zoom=70,path=":ev/ev_com_a10/",set="ev_com_a10",ax=1920,ay=1080,bx=-960,by=-540,x=-110,y=210},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000315",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uwaaan. ¡¡Estás diciendo de nuevo cosas que no debes decir!!”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eyy, deja ya el escándalo! ¡Y no te me pegues encima!”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
vo={
{"vo",file="man_ked_000316",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No me llames escandaloso!”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"bgm",stop=1,time=1000},
{"text"},
text={
vo={
{"vo",file="fem_aid_000169",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué están haciendo ustedes dos?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg005a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1h0000",face="h0005",head="aix_z1h",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm023"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh... Estaba profundizando mi amistad con uno de los integrantes de mi nueva\nfamilia.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0009",head="aix_z1e",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0015",head="aix_z1e",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000170",ch="aid"},
},
ja={
{
name={"Ai"},
"“Está bien que profundicen su amistad, ¿pero podrían hacerlo en silencio? No\naguanto el ruido.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ya veo, acabaré con la vida de esta bestia rara en unos segundos, tranquila!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="藍",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0015",head="aix_z1e",x2=0,x=-345,lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0021",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0022",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000317",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué profundizar nuestra amistad implica que acabes con mi vida?! ¡¿Y qué\nes eso de bestia rara?!”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0017",head="aix_z1e",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000171",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, está bien, dejen ya el alboroto. En fin, la fiesta de bienvenida será esta\nnoche a las 7. Vengan a la sala cuando sea la hora.”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Una fiesta de bienvenida? No tienes por qué hacer eso...”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="うんうん",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000318",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡E-Ehm! L-La comida de la fiesta será de restaurante, ¡¿verdad?!”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fgact",ch="藍",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000172",ch="aid"},
},
ja={
{
name={"Ai"},
"“No.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0008",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000319",ch="ked"},
},
ja={
{
name={"Kei"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0017",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000173",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué pasa, Kei? Tienes una cara de insatisfacción.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0019",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000320",ch="ked"},
},
ja={
{
name={"Kei"},
"“Eh, no, no es eso...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0015",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000174",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bueno, qué más da. Iré ahora a comprar los ingredientes para la comida de la\nfiesta. Cuiden de la casa mientras estoy afuera.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000321",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, ¿si vas a prepararlo todo ahora entonces no conviene más pedirlo todo de\nuna vez de un restaurante?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0017",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000175",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué pasa, Kei? ¿No te gusta mi comida?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="quake",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0020",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000322",ch="ked"},
},
ja={
{
name={"Kei"},
"“N-No es eso--”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0004",head="aix_z1f",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0003",head="aix_z1f",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000176",ch="aid"},
},
ja={
{
name={"Ai"},
"“Jajaja. Bueno, juzgando por mis records anteriores, no es de sorprenderse que\nte asustes.”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0004",head="aix_z1f",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000177",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero no te preocupes. Esta vez todo saldrá bien. Será distinta a las ocasiones\nanteriores.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0016",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000323",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Q-Qué, exactamente?...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0015",head="aix_z1f",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000178",ch="aid"},
},
ja={
{
name={"Ai"},
"“Hasta ahora, siempre a lo último la angustia de que no supiera bien la comida\nme llevaba a echarle mayonesa encima, y siempre terminaba fallando.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0002",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000179",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero tu onee-chan aprendió ya de una buena vez que no se puede resolver todo\nnada más con mayonesa.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0010",head="aix_z1f",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0008",head="aix_z1f",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000180",ch="aid"},
},
ja={
{
name={"Ai"},
"“En especial las sopas que no se ven nada bien con mayonesa encima. Sobretodo la\nsopa miso.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
"…",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"text"},
text={
ja={
{
"Pues, obviamente que no...",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0003",head="aix_z1f",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000181",ch="aid"},
},
ja={
{
name={"Ai"},
"“Y por eso llegué a la conclusión de que no hay problema alguno siempre y cuando\nmantenga la cantidad de mayonesa a un mínimo.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000324",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Espera! ¡¿Aun así planeas seguir usándola?!”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0001",head="aix_z1f",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0004",head="aix_z1f",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000182",ch="aid"},
},
ja={
{
name={"Ai"},
"“Claro, por supuesto. La mayonesa sabe muy bien.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0008",head="kei_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000325",ch="ked"},
},
ja={
{
name={"Kei"},
"“Escucha... Me parece que el problema es que tu comida empeora tanto a medida\nque la preparas, tanto así que el producto final acaba siendo tan horrendo\nque debes echarle mayonesa para arreglarlo...”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0017",head="aix_z1f",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_aid_000183",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0009",head="kei_z1a",x=345,lv=4,id=6},
{"fgact",ch="圭",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000326",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah, no es nada.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1f0000",face="f0004",head="aix_z1f",x=-345,lv=4,id=9},
{"fgact",ch="藍",act="ジャンプ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0002",head="aix_z1e",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_aid_000184",ch="aid"},
},
ja={
{
name={"Ai"},
"“Bueno, observa y verás. Bien, les encargo la casa hasta que regrese.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"se",file="se9002",vol=30,id=1},
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",ch="藍",sync=1,mx=-40,mode=-1,lv=4,id=9},
{"ex",time=500,func="wait"},
{"fg",ch="圭",time=500,mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0009",head="kei_z1a",x2=345,x=0,lv=4,id=6},
{"se",stop=1,time=500,id=1},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000327",ch="ked"},
},
ja={
{
name={"Kei"},
"“Jaa...”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hace falta que hagan ninguna fiesta de bienvenida...”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"bgm",file="bgm012"},
{"se",file="se3130",id=1},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0023",head="kei_z2a",x=0,lv=5,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0006",head="kei_z2a",x=0,lv=5,id=6},
},
vl02={
{"fgact",ch="圭",act="うんうん",lv=5,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000329",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Si pudiera impedirlo tan fácilmente no pasaría tanto trabajo! ¡Aneki es la\nclase de mujer que cuando dice que hará algo lo hará! ¡Si Aneki llega a decir\n'quiero hacer una guerra nuclear' entonces el mundo quedará abrasado ante las\nllamas de los misiles nucleares!”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es absurdo... En primer lugar, sería terrible que cualquiera pudiera\niniciar una guerra nuclear solo porque diga 'quiero hacerlo'.”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0006",head="kei_z2a",x=0,lv=5,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=6},
{"quake",mode="mw"},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0012",head="kei_z2a",x=0,lv=5,id=6},
{"fgact",ch="圭",act="いいえ",time=1200,size=100,lv=5,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000330",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Esa cosa 'terrible' está a punto de suceder ahora! ¿Ya tienes listas tus\nhombreras y tu buggy? ¿Ya tienes listo el lanzallamas?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás demasiado alterado... Y no sé qué rayos quieres decir. ¿Por qué estás tan\nalterado por una simple fiesta de bienvenida?”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0021",head="kei_z2a",x=0,lv=5,id=6},
{"fgact",ch="圭",act="うんうん",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0023",head="kei_z2a",x=0,lv=5,id=6},
},
vl02={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0006",head="kei_z2a",x=0,lv=5,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000331",ch="ked"},
},
ja={
{
name={"Kei"},
"“Razones tengo para alterarme. La comida de Aneki es horriblemente pésima. ¡Es\nhorrenda! ¡Estamos como Khrushchev cuando detuvo a último momento a Kennedy\nantes de que pulsara accidentalmente el botón para lanzar los misiles\nnucleares!”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A pesar de ser tan idiota, hay que ver que conoces bien la crisis de los\nmisiles en Cuba, eh...”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0023",head="kei_z2a",x=0,lv=5,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000332",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ese no es el problema! ¡Esto está grave! ¡Dejar que Aneki prepare la comida no\ntiene ninguna diferencia con una guerra nuclear!”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"¿Qué clase de comida es esa que no tiene ninguna diferencia con una guerra\nnuclear?",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La verdad es que no entiendo qué quieres decir con que es igual a una guerra\nnuclear.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0006",head="kei_z2a",x=0,lv=5,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0004",head="kei_z2a",x=0,lv=5,id=6},
},
vl02={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0015",head="kei_z2a",x=0,lv=5,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000333",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué no lo entiendes?! ¡¿Si te digo que es tan grave como si un pato\nllevara un cebollín consigo me entenderías?! Me entiendes, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te entiendo. Sería perfecto, una oportunidad de oro.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0023",head="kei_z2a",x=0,lv=5,id=6},
{"fgact",ch="圭",act="うんうん",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000334",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué?! El pato estaría en graves problemas, ¡¿no?! ¡Sería muy peligroso,\n¿no es así?!”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Pues, ciertamente lo sería para el pato, pero... por lo general, en el idioma\njaponés, cuando hablamos de 'patos' y 'cebollas', nos referimos a una\noportunidad muy buena...",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0015",head="kei_z2a",x=0,lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000335",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Puedes entender entonces el grado de peligro que involucra esto si te pongo\ncomo ejemplo a un pato marchando con un cebollín?”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No es como que algo lindo?”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0023",head="kei_z2a",x=0,lv=5,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0006",head="kei_z2a",x=0,lv=5,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000336",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No es lindo! ¡Está marchando! ¡Una marcha del pato y el cebollín! ¡La vida del\npato estaría en peligro al nivel de una marcha!”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
ja={
{
"¿Qué clase de situación es esa?",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien, no entiendo muy bien tu ejemplo, pero ya entendí que estás realmente\nalterado. ¿Qué hay de tu hermanita? ¿Qué tal cocina?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"se",file="se3130",id=1},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=0,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000337",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uh...!”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Solo con decir eso, la espalda de Kei se enderezó en un instante.",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000338",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ella es... aún peor...”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, espera, no hay nada peor que una sopa miso con mayonesa, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0016",head="kei_z1a",x=0,lv=4,id=6},
{"fgact",ch="圭",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000339",ch="ked"},
},
ja={
{
name={"Kei"},
"“No, es totalmente peor...”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0009",head="kei_z1a",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000340",ch="ked"},
},
ja={
{
name={"Kei"},
"“Hace poco, comí una sopa de udon que Shizuku preparó, pero... esa noche, el\nporcentaje de ocupación del retrete de la casa Natsume se incrementó en un\n530000 %.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿530000?...",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"text"},
text={
ja={
{
"En primer lugar, esa magnitud con esa unidad porcentual es imposible, pero...\ndejando eso de lado...",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿530000? ¿No es esa una forma final?...”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0021",head="kei_z1a",x=0,lv=4,id=6},
{"fgact",ch="圭",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000341",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Así es! ¡La comida de Shizuku es la forma final! Es extremadamente peligrosa.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo... Así que es tan peligroso como el hecho de que el pronombre personal\nde Freezer cambie de 'Watashi' y 'Watakushi' a 'Boku', eh...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0015",head="kei_z1a",x=0,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0021",head="kei_z1a",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000342",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué estás hablando de un congelador? No sé qué rayos estás diciendo, y no\nes momento para bromas. Piensa seriamente...”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"Ya veo...",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Ni siquiera se dio cuenta de que le regresé con un chiste su propio chiste.\nEste tipo es un caso verdaderamente serio.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya entendí en buena parte la situación.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En pocas palabras, la Tierra está en peligro.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por eso quieres impedir que esas dos preparen la comida, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0014",head="kei_z1a",x=0,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0016",head="kei_z1a",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000343",ch="ked"},
},
ja={
{
name={"Kei"},
"“V-Vaya, pero sí entiendes entonces. Eres bastante avispado... Sí, así es...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me parece que incluso alguien bastante torpe podría darse cuenta de eso.”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y bien, respecto al asunto de la comida, tengo una idea.”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En este caso, soy yo el que está siendo bienvenido, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0015",head="kei_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000344",ch="ked"},
},
ja={
{
name={"Kei"},
"“Así es, pero ¿qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, escucha. Soy yo quien va a recibir la bienvenida, pero también sirve\nque yo, en agradecimiento, prepare la comida, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",x=0,lv=4,id=6},
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000345",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Mm? ¿En pocas palabras?”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si tan solo logramos inventar una muy buena razón, no habrá problema alguno con\nque yo prepare la comida antes de que Ai regrese.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fgact",ch="圭",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000346",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh? ¿Lo harás?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, quién sabe...”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Alguien por ahí me dijo que mis platillos eran afeminados, no mantenían la\nforma de los ingredientes ni se sabía qué eran...”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",x=0,lv=4,id=6},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x=0,lv=4,id=6},
},
vl02={
{"fgact",ch="圭",act="いいえ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000347",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Q-Quién fue la persona sin corazón que dijo eso?! ¡Tu comida es la mejor! ¡Es\ncomida masculina, para machos! ¡Si alguien llega a quejarse de ella le daré\ncon mis varoniles puños!”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",mode=-2,sync=0},
{"bg",zoom=120,speed=300,file="bg005a",path=":bg/",z2=100,ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z2",zoom=100,speed=300,mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0023",head="kei_z2a",y2=-170,z2=69.1,y=0,lv=5,id=6,sync=0},
{"extrans",time=0},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0023",head="kei_z2a",lv=5,id=6},
{"quake"},
{"quake",mode="mw"},
{"se",id=1,file="grigri"},
{"fgact",ch="圭",act="いいえ",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000348",ch="ked"},
},
ja={
{
name={"Kei"},
"“Duele, duele, lo siento. No me taladres con tus puños...”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"bgm",stop=1,time=1000},
{"se",stop=1,time=500,id=1},
{"cgdel",id=-1},
