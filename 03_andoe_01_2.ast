astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_uni_c24_01",path=":ev/ev_uni_c24/",set="ev_uni_c24"},
{"bgm",file="bgm038"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmmm.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Me paro frente a la iglesia, y observo el mural. 'Las huellas de los cerezos'.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, definitivamente...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"se",file="se2497",vol=50,id=1},
{"text"},
text={
ja={
{
"Vuelvo a abrir una vez más la copia de los planos de diseño de Kenichiro\nKusanagi.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Habiendo perdido el derecho a la herencia, no puedo tener los originales en mis\nmanos.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Los originales seguramente pasarán por todos los procesos adecuados para luego\nconvertirse en dinero, y serán usados tal como Kenichiro lo tenía en mente.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"De seguro el condenado gringo Fridmann se encargará de que todo vaya viento en\npopa.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Pero, más importante que eso ahora...",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"No cabe duda alguna, parte de los pétalos tienen una forma totalmente distinta\na la del diseño original.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"Posición, ángulo, y además la puesta del pincel (¿o en este caso, uwabaki?).\nDiferentes en todos estos aspectos.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No incluí a Kei en la labor puesto que su talento podría provocar que dejara\nplasmado su propio estilo en la obra... Con el enorme talento que tiene,\nhabía la posibilidad de que su estilo de obra entrara en conflicto con el de\nKenichiro Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Pero ¿qué hay de esta parte de los pétalos?",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tiene un estilo aún más egocéntrico que el de Kei, y a pesar de eso...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No acabó con la creación de Kenichiro Kusanagi. Más bien toma provecho de ella\ny la hace resaltar.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
"Este plano de diseño fue dibujado por Kenichiro Kusanagi antes de realizar su\ndebut. Una obra que pertenece a, como le llaman generalmente, su etapa\nprevia.",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
"Y por eso mismo, aun habiendo algo fuera de lugar en esta parte, nadie se da\ncuenta de esa anormalidad.",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esta parte fuera de lugar tiene una fuerza en sus pinceladas más parecida a su\netapa posterior. No, se podría decir que se acerca incluso a la época de\n'Cerezos recostados'...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Es como si... Kenichiro Kusanagi hubiese revivido...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"No. Tampoco eso.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si exageramos un poco, se podría decir que incluso supera al Kenichiro Kusanagi\nen pleno apogeo...”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"No, ya eso es decir mucho.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
"Yo conozco muy bien la magnitud de su genialidad y talento.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
ja={
{
"El primer y último japonés en obtener el máximo premio de la Exposición Moore,\nel Platine Épaulard.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Aun siendo llamado avaro y tacaño, artista de negocios, estafador, sus obras\nson aún amadas por una gran cantidad de personas alrededor del globo.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
"Es absurdo afirmar con tanta ligereza que hay alguien superior a él.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso perdí mi buen juicio?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"En fin, solo hay una persona que pudo haber pintado esta parte.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sui...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Solo puede ser ella.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Solo unos pocos grabaron con los uwabaki el muro, y bien que mantuve el ojo\npuesto sobre todos los demás mientras avanzaba la obra.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"Hay una sola persona a la cual no pude observar mientras pintaba con los\nuwabaki.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"msgoff"},
{"bg",file="bg057g",path=":bg/",sync=0},
{"fg",ch="吹",size="z1",mode=3,resize=1,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",lv=4,id=9,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Justo en el momento que Sui se unió...”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Mientras trabajaba junto a ella, mi consciencia se nubló y terminé\ndesmayándome.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Y fue esta la parte de la obra que se culminó después de que me desmayara.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"cgdel",id=-1},
{"bg",file="ev_uni_c24_01",path=":ev/ev_uni_c24/",set="ev_uni_c24"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Casualidad?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"¿Ese poder de salto le dio un toque único a los trazos?",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
"Simple 'azar'. ¿Sería normal pensar eso?",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
"¿Realmente fue así?",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Akashi dijo que había practicado durante varios años para desarrollar esa única\npincelada que usó al dibujar el tronco.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es posible poder dar estos trazos tan perfectamente elaborados solo por mera\ncasualidad?...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
"De ninguna forma.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
"Es lo mismo a que si un mono golpeara al azar las teclas de una máquina de\nescribir y acabara reproduciendo a Shakespeare.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Es imposible producir esa calidad de trazo solo por coincidencia.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa muchacha... ¿Quién rayos es en realidad?”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Siento como si lo entendiera.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Como si lo supiera.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"Esta sensación.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Es como si los puntos dispersos dentro de mí estuvieran a punto de conectarse\npor una línea, pero de repente se esfumaran. Esa fugaz sensación me invade de\nprincipio a fin.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_sud_000476",ch="sud"},
},
ja={
{
name={"???"},
"“No has parado de verlo, eh, Kusanagi-san.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, llevo un rato ya acá.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057a",path=":bg/",sync=0},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_sud_000477",ch="sud"},
},
ja={
{
name={"Sui"},
"“Debo admitir que fue una labor divertida.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"Divertida, eh.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Eso dice la muchacha que, aun en medio de ese abrasador infierno, y habiéndome\nyo desmayado, continuó pintando.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿En qué andas ahora?”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000478",ch="sud"},
},
ja={
{
name={"Sui"},
"“Encontré a Kusanagi-san acá y decidí venir.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se supone que estamos en hora de clases.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0009",head="sui_z1a",lv=4,id=9},
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000479",ch="sud"},
},
ja={
{
name={"Sui"},
"“No entiendo qué pretendes decirme. También estás afuera.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bgm",stop=1,time=300},
{"text"},
text={
vo={
{"vo",file="fem_szd_000574",ch="szd"},
},
ja={
{
name={"???"},
"“Tiene toda la razón...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000480",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="雫",size="z1",mx=40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"fg",ch="吹",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",x2=0,x=-345,lv=4,id=9},
{"bgm",file="bgm031"},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0003",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000481",ch="sud"},
},
ja={
{
name={"Naoya y Sui"},
"“-¡Shizuku!-”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000482",ch="sud"},
},
ja={
{
name={"Naoya y Sui"},
"“-Espera, ¿cómo es que conoces a Shizuku?-”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000575",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No será porque ambos me conocen?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Es que conoces a esta niña, Shizuku?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0018",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000483",ch="sud"},
},
ja={
{
name={"Sui"},
"“Me has dejado pasmada. Incluso Shizuku... Bestia tenias que ser, Kusanagi-san.\nTus garras no titubean cuando encuentran a una muchacha preciosa.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cualquiera querría acercarse a una muchacha preciosa, digo yo.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0006",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000484",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Las mujeres solo somos físico! ¡¿Es eso lo que insinúas?!”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me da más curiosidad saber por qué te incluyes entre las 'muchachas preciosas'.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0013",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000485",ch="sud"},
},
ja={
{
name={"Sui"},
"“Vaya pregunta más ridícula. ¡Porque Sui es también una niña preciosa,\nobviamente!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
name={"Naoya"},
"“S-Si tú lo dices...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000486",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Una preciosura como Sui no puede vivir de manera tan desvergonzada!”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
name={"Naoya"},
"“De manera desvergonzada, eh. Si tú misma admites que das vergüenza, pues tiene\nsentido... Aunque esa clase de palabra jamás se usaría con una muchacha\nlinda.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000487",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Que Sui da vergüenza?! ¡¿Pero qué insinúas?!”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fgact",ch="吹",act="icon",y=-400,lv=4,id=9,icon="icon01z1",x=40},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0013",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000488",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Jaa! ¿E-Es que... acaso obligarás a Sui a hacer cosas vergonzosas?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que tienes dentro de la cabeza da vergüenza. Eso quise decir.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0008",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000489",ch="sud"},
},
ja={
{
name={"Sui"},
"“No comprendo. Nada dentro de la cabeza de Sui da vergüenza. Así la saques y la\nexpongas...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0018",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x=-345,lv=4,id=9},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0013",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
},
vl03={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",x=-345,lv=4,id=9},
},
vl04={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0017",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
},
vl05={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0022",head="sui_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000490",ch="sud"},
},
ja={
{
name={"Sui"},
"“Así la expongas afuer... ¿Eh? ¡Jaa! K-Kusanagi-san, ¿no estarás planeando,\npedirle a Sui que exponga toda su vergüenza al aire?... ¡¿Y, me, desnude?!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Cómo demonios llegaste a esa conclusión?!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0009",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0005",head="sui_z1a",x=-345,lv=4,id=9},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0006",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000491",ch="sud"},
},
ja={
{
name={"Sui"},
"“Vas a pedirme que muestre todas mis zonas vergonzosas, ¿cierto? Por ejemplo mis\npechos, ¡y mis pechos, y mis voluptuosos pechos!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Estás... pisando cada vez más cerca la línea del masoquismo...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0016",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000576",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Juego sexual, le llamarían a eso.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0018",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000492",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Ya veo, un juego sexual! ¡Sui ha comprendido!”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0018",head="sui_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000493",ch="sud"},
},
ja={
{
name={"Sui"},
"“Qué atroz, qué monstruoso. Bestia tenías que ser. ¡Kusanagi-san, bestia! ¡Estoy\nindefensa! ¡Ni en mis peores pesadillas querría hacer algo así, pero igual\naceptaré tu juego!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0018",head="sui_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000494",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Vamos, juega todo lo que quieras con el cuerpo de Sui! ¡A Sui también le\nencantaría!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Tanto que dijiste y ahora resulta que te encantaría?!”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000495",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿En qué clase de juegos sexuales iniciarás a Sui?!”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ninguno.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0008",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x=-345,lv=4,id=9},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0006",head="sui_z1a",x=-345,lv=4,id=9},
},
vl03={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0022",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000496",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Ninguno? ¿Jaa? ¿Es que vas a colocar las fotos de los juegos sexuales de Sui\nen la pantalla de inicio de tu celular? ¡No lo puedo creer! ¡Pero qué\nbestialidades se te ocurren! ¡Bestia! ¡Eres un monstruo!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Cómo diablos vienes de eso a colocar semejantes fotos como pantalla de\ninicio?! ¡¿De qué manera están conectadas tus neuronas?!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000577",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Hay juegos sexuales que pueden hacerse afuera. Exhibicionismo, por ejemplo...\nEn Goglee lo encuentras.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Tú! ¡Nada de buscar cosas raras en el celular!”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000497",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Qué es exhi, bicio, nismo?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0004",head="shz_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000578",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Solo te sientas desnuda, piernas abiertas formando la letra M, signo de la paz\ncon ambas manos. Yaaay.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No des tú el ejemplo!”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0002",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0005",head="sui_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000498",ch="sud"},
},
ja={
{
name={"Sui"},
"“Ya veo, he comprendido lo del doble signo de la paz. Pero aún no logro\ncomprender lo de la letra M con las piernas.”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000579",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Puedes ver las fotografías que me tomé ayer practicando. Pensé que serían\nnecesarias algún día y las tomé.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Necesarias?! ¡¿Necesarias para qué?!”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000580",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Para cuando me las pidieras. ¿Supongo?”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿E-Estuviste practicando eso?!”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000581",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, bueno, solo bromeaba.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qu--”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0015",head="shz_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000582",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“En primer lugar, sé que eres la clase de persona que jamás se atrevería a ver\nfotos así, Naoya. Lamentablemente...”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000583",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Por supuesto, de haber la necesidad las tomaría. Pero no me ofrezco para algo\nsin demanda.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000499",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Kusanagi-san jamás vería fotos así?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000584",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, la observación me lo ha confirmado.”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0017",head="sui_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_sud_000500",ch="sud"},
},
ja={
{
name={"Sui"},
"“No entiendo entonces por qué Kusanagi-san estaba inclinándose tanto para ver tu\ncelular, Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0012",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0016",head="shz_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000585",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ohhh... ¿Es eso cierto? No me di cuenta. Veo que eres sensible ante\neventualidades eróticas.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Eventualidades eróticas? Qué rayos es...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000586",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Situaciones que se tornan súbitamente eróticas, así como ahora. Maldito\nsuertudo, te llamarían.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“N-No creo que sea realmente así...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0012",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0016",head="shz_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000587",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿No? Ahora que lo pienso, situaciones del estilo de hundir súbitamente tu cara\nen los genitales de una chica encajan bastante con tu imagen.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, para nada, y además nunca me ha pasado algo así...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0005",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="びっくり",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000588",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Todo protagonista hoy en día debe ver a la heroína desnuda en su primera\naparición. ¡Y siendo así, tú también deberías!”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Qué idioteces dices!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0005",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0018",head="sui_z1a",x=-345,lv=4,id=9},
},
vl02={
{"fgact",ch="吹",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000501",ch="sud"},
},
ja={
{
name={"Sui"},
"“Eso no importa ahora. A Sui le preocupa más saber si lo de la fotografía es\nverdad. ¡No he podido parar de pensar en qué será eso de las piernas en letra\nM!”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000589",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo. Lo has mencionado en buen momento, haré una demostración acá, frente a\nNaoya.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Qué clase de buen momento es este?!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000590",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pues es que parece que tienes una debilidad por las eventualidades eróticas...”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No es que sea débil, solo que suceden de un momento a otro!”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000591",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eso lo comprobaremos ahora. Te mostraré cómo se hace, así que puedes intentarlo\ndespués de mí, Sui...”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0016",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000592",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Justo en ese instante la pasmada cara de Naoya vendrá volando directamente a\nnuestras partes privadas.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Me crees comediante?!”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0013",head="sui_z1a",x=-345,lv=4,id=9},
{"fgact",ch="吹",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_sud_000502",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Esto es de terror! ¡Me das escalofríos, Kusanagi-san! Sui no puede contener el\nmiedo ante tal bestial perversión.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Tengo mucho que reclamar en lo que dices!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="吹",mode=-1,lv=4,id=9},
{"fg",ch="雫",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0016",head="shz_z1b",x2=345,x=0,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-En primer lugar, Shizuku, ¿qué viniste a hacer acá? Se supone que tú también\ntienes clases.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000593",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me fui temprano.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
"Intenté redirigir la conversación del terrible rumbo que tomaba, y por suerte\nShizuku me respondió con normalidad.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué? ¿Te sientes mal?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000594",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Pareciera estarlo?”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, te ves completamente bien...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0002",head="shz_z1a",x=0,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000595",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y sí lo estoy. Me salí temprano para venir a ver este mural.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El mural? ¿Esta pintura?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"bgm",stop=1,time=1000},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000596",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Esta.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"bg",file="ev_uni_c24_01",path=":ev/ev_uni_c24/",set="ev_uni_c24"},
{"bgm",file="bgm003"},
{"text"},
text={
ja={
{
"Al decir eso, Shizuku se paró frente al mural.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
"Y después de verlo con fijeza por un rato, asintió, como si hubiera descubierto\nalgo.",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_szd_000597",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo... así que de esto se trataba...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué viste?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_szd_000598",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No es nada. Solo que nunca llegué a enterarme de lo que había en esta pintura\nhasta que se volvió noticia...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De lo que había en ella?”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_szd_000599",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Estos cerezos están inspirados en los cerezos milenarios, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, posiblemente. No sé qué tenía en mente Kenichiro Kusanagi, pero sé que\nAkashi intentó reproducir los cerezos que sus hermanas vieron.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los cerezos milenarios. Esa es la temática de 'Las huellas de los cerezos'.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_szd_000600",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Una reproducción... ya veo. Aunque parece casi real.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Casi real?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_szd_000601",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Algo así como el 'Garyou Tensei', diría.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Ah... eso...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_szd_000602",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Pensaste en lo mismo, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, lo he pensado...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg057a",path=":bg/",sync=0},
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0001",head="sui_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_szd_000603",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sui. ¿Has hablado con alguien más aparte de Naoya?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000503",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí, lo hice. ¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0015",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000604",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Fuh, supongo que sí...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
"Shizuku suelta un suspiro.",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué pasa? ¿Sucedió algo?”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0017",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000605",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Por alguna razón, Shizuku me ve con una mirada un tanto amenazadora.",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿Qué pasa? ¿Hice... algo?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0015",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000606",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Fuh, el mismo círculo vicioso de siempre. O debería llamarlo círculo\naltruista...”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000607",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aunque de igual manera, no puedo recriminarte en lo absoluto...”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000608",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Está bien, no importa. Por cierto, Naoya, ¿cómo van tus calificaciones?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Calificaciones? ¿Del colegio?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000609",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué lo preguntas?”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000610",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me dio curiosidad, considerando que saldrás ahora conmigo a divertirnos un\nrato.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Salir contigo?”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000611",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Tendremos una cita.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
},
vl02={
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000504",ch="sud"},
},
ja={
{
name={"Sui"},
"“Una cita... entiendo, entiendo. Ya lo veo todo.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0018",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0016",head="sui_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000505",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Kusanagi-san, decidiste usar a mi amiga Shizuku para acortar tu distancia con\nSui e invitarme de manera indirecta a una cita! ¡Sui lo descubrió todo en un\nabrir y cerrar de ojos!”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero si ha sido Shizuku quien lo propuso...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000612",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sui, ¿vienes también?”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0002",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000506",ch="sud"},
},
ja={
{
name={"Sui"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0016",head="shz_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000613",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo, una cita de tres. Considerando la clase de animal que eres, lo más\nseguro es que terminará en un trío.”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Cómo rayos terminaría así?!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0012",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000614",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Es que acaso no te gustaría tener un trío, Naoya?”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"mwact",act="びっくり"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Me encantaría!”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0012",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0003",head="shz_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_szd_000615",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ohhh, ¿conque sí? Si ese es el caso entonces accederé.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh--?”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000616",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Y tú, Sui?”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0012",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0005",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="du",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000507",ch="sud"},
},
ja={
{
name={"Sui"},
"“¿Yo? No sé muy bien qué pasa, pero si tú lo haces Sui también\naceptará el reto.”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a1000",face="a0001",head="shz_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000617",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya oíste, Naoya. ¿Y bien? Tratándose de un trío no tendrás problema en hacerme\ntuya, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ugh...”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0015",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000618",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me lo imaginaba...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0017",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000619",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Eres un cobarde, Naoya. Y por eso deberías de dejar de decir cosas que no\nharás.”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0018",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000620",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me irrita.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"text"},
text={
ja={
{
"L-La hice enojar...",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000508",ch="sud"},
},
ja={
{
name={"Sui"},
"“Y por cierto, ¿qué significa tener un trío?”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0001",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000621",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Significa que Naoya nos adiestrará y domará hasta convertirnos en sus esclavas\nsexuales.”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0013",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0015",head="sui_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0008",head="sui_z1a",x=-345,lv=4,id=5},
},
vl03={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0015",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="いいえ",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000509",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡¿Esclavas sexuales?! No lo puedo creer. No puedo negarlo, Sui tiene un encanto\nque enloquece a los hombres. ¡Ahh, pero que llegue a los extremos de\nconvertir a Naoya-san en un criminal!”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0012",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000510",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Jaa! ¿Eso quiere decir que el juego sexual de hace un rato era ya parte del\nadiestramiento?”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0005",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000622",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Posiblemente.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0005",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うんうん",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0110",face="a0018",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_sud_000511",ch="sud"},
},
ja={
{
name={"Sui"},
"“L-Lo cual significa que me harás cosas perversas ya y ahora, ¿verdad? ¡Debo\ndesnudarme ya!”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Que no, demonios!”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, ya me cansé de todo. Bueno, salgamos a algún lugar los tres. No sé a\ndónde.”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b1000",face="b0002",head="shz_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000623",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Bien, vayamos entonces. Cita de tres.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"fg",ch="吹",size="z1",mode=3,path=":fg/sui/z1/",file="sui_z1a0100",face="a0003",head="sui_z1a",x=-345,lv=4,id=5},
{"fgact",ch="吹",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_sud_000512",ch="sud"},
},
ja={
{
name={"Sui"},
"“¡Sí! ¡Y al final de la cita, un trío! ¡¿Verdad?!”",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡No, maldita sea!”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
