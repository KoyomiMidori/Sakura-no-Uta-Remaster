astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c06_01",path=":ev/ev_eye_c06/",set="ev_eye_c06"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_eye_c09_01",path=":ev/ev_eye_c09/",set="ev_eye_c09"},
{"ex",time=3000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg013e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0020",face="a0001",head="yum_z1a",lv=4,id=9},
{"bgm",file="bgm006"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ey.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_yum_002087",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"Llego temprano al lugar de encuentro, y noto que ya Kawachino estaba.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Pensé que estaría de mal humor estando a solas conmigo. Pero...",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0002",head="yum_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_002088",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Llegaste temprano. Ya me estaba aburriendo aquí sola, qué bueno que llegaste.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Parece que no está de tan mal genio.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pensé que sería el primero en llegar...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0015",head="yum_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_002089",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Debo admitir que has llegado temprano, senpai. Pero estoy acá desde hace una\nhora, así que no fue tan temprano después de todo.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tanto llevas esperando?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0016",head="yum_z1a",lv=4,id=9},
{"fgact",ch="優美",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_002090",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. Llevo toda la semana esperando ansiosa por este día.”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Aunque creo que estoy sobrando acá...”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0011",head="yum_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_002091",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“... Te estás dando muchas ideas.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0002",head="yum_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_002092",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Acordamos salir los tres, no dos. Me conformo con esto.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"-Qué raro ver a Kawachino así- pensé por un momento. Pero es lógico, nadie es\nrealmente capaz de permanecer irritado en todo momento con la misma persona.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"En fin, qué bueno que no está de mal humor.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entiendo...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0002",head="yum_z1a",lv=4,id=9},
{"fgact",ch="優美",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0001",head="yum_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_yum_002093",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí, aunque bueno, Rina y yo solemos estar solas las dos casi todo el tiempo.\nPero, nunca he tenido algo a lo que se le pueda llamar cita.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0016",head="yum_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_002094",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero hoy es una fecha importante, día de mi primera cita con ella. No me\nmolesta realmente si estás o no.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0011",head="yum_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_002095",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y además...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y además?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Kawachino se queda en silencio.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0001",head="yum_z1a",lv=4,id=9},
{"fg",ch="里奈",size="z1",mx=-40,mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1d0000",face="d0013",head="rna_z1d",x=-345,lv=4,id=5},
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0001",head="yum_z1a",x2=0,x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002132",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Wah! ¡¿Ya habían llegado?!”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0004",head="yum_z1a",x=345,lv=4,id=9},
{"fgact",ch="優美",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_002096",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Buenos días, Rina. Estás tan linda como de costumbre.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0015",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002133",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vine con 10 minutos de antelación pensando que llegaría temprano... Siento\nahora que soy la única que llegó tarde.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0002",head="yum_z1a",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0003",head="yum_z1a",x=345,lv=4,id=9},
{"fgact",ch="優美",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_yum_002097",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No te preocupes, las esperas no son siempre aburridas... ¿Verdad, senpai?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh? ¿P-Pues, sí?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002134",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿A dónde vamos hoy?”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0016",head="yum_z1a",x=345,lv=4,id=9},
{"fgact",ch="優美",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_002098",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya lo tengo todo planeado.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias. Tengo que admitir que nunca he tenido una cita con alguien.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0017",head="yum_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_002099",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Con o sin experiencia, es igual deber del hombre planificar las salidas.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo excusa alguna.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0015",head="yum_z1a",x=345,lv=4,id=9},
{"fgact",ch="優美",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_yum_002100",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No importa.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"se",file="se9004",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg018e",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
ja={
{
"Hay un centro comercial a unos minutos caminando desde Sakuragahara.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Es relativamente grande, así que también vienen personas en coche. En los días\nferiados se llena de gente.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Y hoy no es la excepción. Está repleto.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0001",head="rna_z1d",x=-345,lv=4,id=9},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0016",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002101",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si el objetivo de esta cita fuese dar la imagen de que realmente somos novios,\nentonces este lugar sería el indicado.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0015",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0003",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_002102",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y por ende, es solo una farsa para engañar a los demás... Bien, Rina, vayamos\nprimero a la tienda de lencería.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0017",head="rna_z1d",x=-345,lv=4,id=9},
{"fgact",ch="里奈",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rna_002135",ch="rna"},
},
ja={
{
name={"Rina"},
"“Eh, espera, ¿por qué primero la tienda de lencería?”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うんうん",time=200,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002103",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vamos, vamos.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"fg",ch="優美",speed=500,mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0004",head="yum_z1a",x2=345,x=-680,lv=4,id=6},
{"text"},
delay={
[500]={
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"se",file="se9010",id=1},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0013",head="rna_z1a",x=-345,lv=4,id=9},
},
[800]={
{"fg",ch="優美",mx=-40,mode=-1,lv=4,id=6},
{"fg",ch="里奈",mx=-40,mode=-1,lv=4,id=9},
},
},
text={
ja={
{
"Kawachino lleva a Hikawa de la mano y entra al centro comercial.",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vaya que se llevan bien esas dos...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg081g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1i0000",face="i0001i",head="rna_z1i",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1i0000",face="i0001",head="yum_z1i",x=345,lv=4,id=6,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Recuerdo que sentí algo extraño en las dos cuando las vi por primera vez, en\naquel parque.",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
"Una niña y un niño, solos de noche en un parque.",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Y si eso no era suficiente, una niña ataviada en blanco, y un niño con aspecto\nde malandrín.",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
"Terrible combinación, pensé.",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
"Pero fue después que me di cuenta de que la extraña sensación que tenía no era\nalgo justificado en lo superficial.",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
"El niño de cabello recortado era en realidad una niña, y además estudiaba con\nla niña de blanco.",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
"Y fue en esa combinación de niña y niña donde, realmente, sentí algo extraño.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"cgdel",id=-1},
{"msgoff"},
{"bg",file="zbluesky_spring",id=9,lv=9,speed=300000,sync=1,path=":cg/",x2=960,y2=-540,x=960,y=540,ax=1920,ay=1080,bx=-960,by=-540},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Una era casi como la personificación de la vitalidad. Y la otra tenía la sombra\nde la muerte siempre encima de ella...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Siento que la conexión entre ambas no se limita a una simple relación de\namigas.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
"El contrastante aura que envolvía a ambas en ese entonces ya no está ahora.",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Solo hay dos muchachas, divirtiéndose.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
"De una forma totalmente natural.",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002136",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Senpai, no te quedes parado ahí! ¡Ven!”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Con sus manos en el traje de baño que intentaba recomendarle a Hikawa,\nKawachino me dice lo siguiente.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
vo={
{"vo",file="fem_yum_002104",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Eh? Kusanagi, ¿vas a ponerte este traje de baño de puntitos?”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué idioteces dices?...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Me uno a las dos.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"cgdel",id=-1},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"text"},
text={
vo={
{"vo",file="fem_rna_002137",ch="rna"},
},
ja={
{
name={"Rina"},
"“Waah, llevaba tiempo sin venir a este parque a plena luz del día.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_yum_002105",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Vaya que sí.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg081a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0002",head="rna_z1e",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0002",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Estabamos ahora en el parque de cipreses.",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué hacemos? Si es por almorzar era mejor quedarnos en el centro comercial,\nhabían varios restaurantes.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0015",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うんうん",time=300,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002138",ch="rna"},
},
ja={
{
name={"Rina"},
"“Lo sé, claro que lo sé. ¿Creíste que los había traído acá solo porque sí? Mira\nnada más.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Al decir eso, Hikawa sacó una bolsa de su mochila.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0002",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002139",ch="rna"},
},
ja={
{
name={"Rina"},
"“Procuré no inclinar mucho la mochila, así que deben haber conservado bien la\nforma.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Obentous?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0016",head="rna_z1e",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002140",ch="rna"},
},
ja={
{
name={"Rina"},
"“Has acertado. Sí, obentous.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1e0000",face="e0002",head="rna_z1e",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002141",ch="rna"},
},
ja={
{
name={"Rina"},
"“Este es el tuyo, Yuumi.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0000",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002106",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Waah, gracias.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"bg",file="ev_com_d07_01",path=":ev/ev_com_d07/",set="ev_com_d07"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Obentous en el parque, eh. Digo...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"bg",file="ev_com_d07_02",sync=0,face=1,time=400,path=":ev/ev_com_d07/",set="ev_com_d07"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002142",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué sucede? Si vas a quejarte por algo te lo quitaré.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_002107",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡No tomes ni un bocado de ese obentou, yo me lo comeré! ¡Dame acá!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡N-Ni en broma! ¡¿C-Cómo crees que podría quejarme?! ¡Estoy agradecido con\nella!”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Me atiborro con el obentou que Hikawa me preparó para evitar que Kawachino me lo\nquitara.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Está muy bueno! Me gusta lo dulce de este pollo teriyaki.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bg",file="ev_com_d07_01",sync=0,face=1,time=400,path=":ev/ev_com_d07/",set="ev_com_d07"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002143",ch="rna"},
},
ja={
{
name={"Rina"},
"“Me aseguré de hacerlo bastante dulce.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
vo={
{"vo",file="fem_yum_002108",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Perfecto.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué hablan?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
vo={
{"vo",file="fem_yum_002109",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No hace falta que lo sepas.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Es indescriptible lo divertido que es llevarse a la boca cada uno de los\nmanjares que adornaban estos obentous.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si me hubieras dicho hubiese preparado algo yo también...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
vo={
{"vo",file="fem_rna_002144",ch="rna"},
},
ja={
{
name={"Rina"},
"“Se me ocurrió hacerlo, pero me daba algo de miedo llegar a comparar tus obentous\ncon los míos...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
vo={
{"vo",file="fem_rna_002145",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Debo decirlo? Eres un maestro de la cocina, senpai.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que no, simplemente he tenido que valerme por mi cuenta desde hace\ntiempo. Además, tus obentous están realmente buenos.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="fem_rna_002146",ch="rna"},
},
ja={
{
name={"Rina"},
"“Gracias también a que mamá me ayudó un poco...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me tranquiliza saber eso. El toque de una experimentada ama de casa explica\neste sabor.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="fem_rna_002147",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿De qué hablas?... Yo también soy capaz de preparar cosas buenas por mi cuenta.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Créeme que eso lo sé. Solo que está todo tan bueno que por poco pierdo la\nconfianza en mí mismo. Y necesitaba un justificativo...”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_rna_002148",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Ves? Estás consciente de que eres bueno en la cocina...”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es para tanto, solo que llevo bastante tiempo cocinando.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
vo={
{"vo",file="fem_yum_002110",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Qué plato se te da mejor, Kusanagi-senpai?”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Realmente no lo sé, la verdad. Soy bueno haciendo platos con todo lo que haya a\nmitad de precio en el super...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
vo={
{"vo",file="fem_rna_002149",ch="rna"},
},
ja={
{
name={"Rina"},
"“T-Te pareces a mamá...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_yum_002111",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Se te da la comida japonesa?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál en particular?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
vo={
{"vo",file="fem_yum_002112",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pues dicen que lo más difícil de cocinar son los guisos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, si tratas de hacerlo como debe ser, lo es. Pero en mi caso, soy la clase\nde persona que prefiere usar el caldo en polvo que venden en supermercados.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
vo={
{"vo",file="fem_rna_002150",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿En serio? Te veía más como el tipo de persona que prepara el caldo por su\ncuenta. Usando bonito, por ejemplo.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Preparar caldo directamente del bonito sale bastante caro. Solo lo hago con\nplatillos especiales.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
vo={
{"vo",file="fem_yum_002113",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Como cuáles?”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por lo general, sopas claras. En raras ocasiones hago también mentsuyu. Y debo\ndecir que el caldo extraído del bonito es riquísimo. Sabe mucho mejor a los\ncaldos ya hechos para la venta.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
vo={
{"vo",file="fem_rna_002151",ch="rna"},
},
ja={
{
name={"Rina"},
"“Vaya, ¿también preparas tu propio mentsuyu? Increíble.”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tampoco es tan difícil. Pero es terriblemente costoso. Tomar el bonito rallado\ny meterlo sin titubear en la olla toma algo de valor.”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
vo={
{"vo",file="fem_yum_002114",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Es costoso el bonito rallado?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“980 yenes por 500 gramos en almacenes. Si es solo por el caldo en polvo, son\n480 yenes el kilo.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_rna_002152",ch="rna"},
},
ja={
{
name={"Rina"},
"“Hasta los precios te los sabes...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Comprar es también parte de lo que cocinar implica. El precio importa, y los\ndías de descuento varían de supermercado en supermercado, así que debo\nrecordarlos todos.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_rna_002153",ch="rna"},
},
ja={
{
name={"Rina"},
"“Realmente eres como una ama de casa.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me he estado encargando de las comidas de los Natsume por medio año ya, así que\nse podría decir que lo soy.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
vo={
{"vo",file="fem_rna_002154",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero también preparas cosas más elaboradas, según he escuchado.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni tanto, diría. Por lo menos no me creo capaz de preparar comida al nivel de\nun restaurante.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
vo={
{"vo",file="fem_yum_002115",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero el curry que preparaste en el colegio estaba realmente bueno. Parecía\nsalido de un local especializado en curry.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué dices? ¡Si estuviste comiendo solo del curry de Rin!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"bg",file="ev_com_d07_03",sync=0,face=1,time=400,path=":ev/ev_com_d07/",set="ev_com_d07"},
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_002116",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eh~, es que da algo de asquito comer un curry preparado por ti.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pero qué falta de respeto!”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"bg",file="ev_com_d07_01",sync=0,face=1,time=400,path=":ev/ev_com_d07/",set="ev_com_d07"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002155",ch="rna"},
},
ja={
{
name={"Rina"},
"“Solo bromea, Yuumi también estuvo comiéndolo con gusto. Pero el Nagi- curry\ntuvo bastante popularidad entre las chicas, y probablemente Yuumi no quiso\ncomer por eso.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Popular entre las chicas? Kei estuvo tragando sin parar también.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
vo={
{"vo",file="fem_rna_002156",ch="rna"},
},
ja={
{
name={"Rina"},
"“Kei-senpai entra en la categoría de chica.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
"Uwah... Kei perdería los estribos si escuchara eso.",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_yum_002117",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No cabe duda de que eres bueno en la cocina... Sí, vaya que eres bueno en\nmuchas cosas...”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"bg",file="ev_com_d07_04",sync=0,face=1,time=400,path=":ev/ev_com_d07/",set="ev_com_d07"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002118",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El único defecto que tienes es lo repulsivo.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Tanto elogio para terminar tan mal?!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"bg",file="ev_com_d07_01",sync=0,face=1,time=400,path=":ev/ev_com_d07/",set="ev_com_d07"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002157",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ajajaja. Por cierto, Yuumi, ¿qué llevas en tu bolso?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
vo={
{"vo",file="fem_yum_002119",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, cierto. Eh--”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Kawachino comienza a buscar en su bolso.",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
vo={
{"vo",file="fem_yum_002120",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es lo único que pude preparar, así que...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bg",file="ev_com_d07_06",path=":ev/ev_com_d07/",set="ev_com_d07"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002158",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Tamagoyaki!”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tamagoyaki, eh.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="fem_yum_002121",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Soy pésima cocinando, y bueno...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
ja={
{
"Kawachino sacó un obentou repleto únicamente de tamagoyaki. Se veía simple, pero\nigualmente bueno.",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Gracias, probaré un poco.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
ja={
{
"Estiro mis palillos.",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"bg",file="ev_com_d07_07",sync=0,face=1,time=400,path=":ev/ev_com_d07/",set="ev_com_d07"},
{"mwact",act="rl"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002122",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Muh, Rina primero.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vale, vale.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"bg",file="ev_com_d07_06",sync=0,face=1,time=400,path=":ev/ev_com_d07/",set="ev_com_d07"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002159",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tomaré un poco. *Ahm*... *hm, hm*...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="fem_rna_002160",ch="rna"},
},
ja={
{
name={"Rina"},
"“Je, están muy bien hechos.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
vo={
{"vo",file="fem_yum_002123",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Gracias. Preparar tamagoyaki y rallar bonito han sido mis pasatiempos desde\npequeña...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"¿Qué clase de pasatiempos son esos?",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Probaré ahora yo. *Ahm*, *hm, hm*...”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm? Estos huevos...”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="fem_rna_002161",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Pasa algo?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tienen azúcar, ¿cierto?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="fem_yum_002124",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Tamagoyaki dulce? Imposible para mí.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Tus padres son de Kansai?”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="fem_yum_002125",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí. Vaya que te diste cuenta.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Simplemente he escuchado que en Kansai no le ponen azúcar al tamagoyaki. Aunque\nsí mirin, según tengo entendido.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="fem_yum_002126",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si le agregas mirin se vuelve dulce. Me gustan los tamagoyaki con solo sal.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te gustan las cosas dulces, Kawachino?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="fem_yum_002127",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“De ser otros platillos, sí. Los prefiero dulces.”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="fem_rna_002162",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, sí, Yuumi siempre le pone bastante azúcar a su sukiyaki, por ejemplo.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="fem_yum_002128",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sabe mejor con azúcar.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="fem_rna_002163",ch="rna"},
},
ja={
{
name={"Rina"},
"“Y por eso es que hice bastante dulce este teriyaki.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="fem_yum_002129",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¡Hurraaa!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, así que el teriyaki está cocinado al gusto de Kawachino.”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"bg",file="ev_com_d07_07",sync=0,face=1,time=400,path=":ev/ev_com_d07/",set="ev_com_d07"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002130",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así es. Y si tienes algún reclamo simplemente no comas de mi tamagoyaki.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo ninguno. De hecho, mi madre tampoco le agregaba azúcar a sus\ntamagoyaki.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"bg",file="ev_com_d07_06",sync=0,face=1,time=400,path=":ev/ev_com_d07/",set="ev_com_d07"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002131",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Sí? ¿Era de Kansai también?”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No lo sé. Tuvo unas raíces familiares un poco complicadas, y nunca llegué a\nenterarme dónde nació.”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
vo={
{"vo",file="fem_yum_002132",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso mismo me da nostalgia este sabor.”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No se me dan bien los tamagoyaki, y jamás he podido prepararlos tan bien como\nestos.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"bg",file="ev_com_d07_05",sync=0,face=1,time=400,path=":ev/ev_com_d07/",set="ev_com_d07"},
{"text"},
text={
vo={
{"vo",file="fem_yum_002133",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“G-Gracias... No esperaba un elogio tan franco.”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué no? Está muy bueno.”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
vo={
{"vo",file="fem_yum_002134",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Pero cualquiera puede prepararlos, con solo tener la sartén adecuada.”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa es la frase usual de los que saben cocinar.”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
vo={
{"vo",file="fem_rna_002164",ch="rna"},
},
ja={
{
name={"Rina"},
"“Creo que eso aplica para ti, senpai.”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"Para un solo platillo hay toda una infinidad de preparaciones que varían entre\nhogar y hogar.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Eso es lo que hace divertido saborear la comida de otros.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"bg",file="ev_com_d07_06",sync=0,face=1,time=400,path=":ev/ev_com_d07/",set="ev_com_d07"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002165",ch="rna"},
},
ja={
{
name={"Rina"},
"“Aunque debo decir que estoy aliviada. Me estaba muriendo del miedo.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De qué?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"text"},
text={
vo={
{"vo",file="fem_rna_002166",ch="rna"},
},
ja={
{
name={"Rina"},
"“Con lo bueno que eres cocinando, temía que fueras también quisquilloso al probar\nla comida de otros.”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aquellos que cocinamos nuestra propia comida no solemos quejarnos mucho de la\ncomida de los demás.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y así es igual para todo, ¿no? Son aquellos que no hacen nada los que dan las\ncríticas más exageradas. Cuando cocinas aprendes a disfrutar de los platillos\nde los demás, y aprendes cuándo decir las cosas y cuando no.”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"text"},
text={
vo={
{"vo",file="fem_rna_002167",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya entiendo.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"La charla siguió mientras almorzábamos.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Quizás se escuche raro de mi parte, pero vaya que la comida sabe deliciosa\ncuando te la preparan.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Pasé un excelente rato.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg081a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0003",head="rna_z1d",lv=4,id=5,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
vo={
{"vo",file="fem_rna_002168",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Dibujemos!”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Dibujar?”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0002",head="rna_z1d",lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002169",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, en el suelo. Así...”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"se",file="se9050",vol=50,id=1},
{"text"},
text={
ja={
{
"Hikawa comienza a dibujar algo en el suelo con una rama.",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que vas a dibujar las líneas de Nazca?”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0016",head="rna_z1d",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002170",ch="rna"},
},
ja={
{
name={"Rina"},
"“No es mala idea. Pero de esta forma podrás pintar sin que tu mano te moleste,\n¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ciertamente.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"se",file="se9050",vol=30,id=1},
{"text"},
text={
ja={
{
"Tomo yo también una rama y comienzo a dibujar sobre el suelo.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Lo primero que se me ocurrió dibujar fue un perro.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0013",head="rna_z1d",lv=4,id=5},
{"fgact",ch="里奈",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002171",ch="rna"},
},
ja={
{
name={"Rina"},
"“Uwaah, en una sola línea. Qué diseño.”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Suele ser difícil mantener el mismo diseño cuando pintas en grande... Aunque\nhay varias formas de hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0003",head="rna_z1d",lv=4,id=5},
{"fgact",ch="里奈",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002172",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Dibuja un lobo!”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un lobo?”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0004",head="rna_z1d",lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002173",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Sí, un lobo!”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hm, bueno, intentaré dibujarlo.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Un lobo... ¿Qué tienen de diferente un lobo y un perro?",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"¿Basta con que dibuje un perro más feroz?",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"se",file="se9050",vol=50,id=1},
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0001",head="yum_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002135",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
ja={
{
"Kawachino también dibuja algo.",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué dibujas, Kawachino?”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0017",head="yum_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002136",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es un secreto.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Después de dibujar el lobo, Hikawa dibujó un enano encima de este.",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
ja={
{
"O eso pensé, pero...",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué rayos es esto? ¿Yartsa gunbu?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"fg",ch="優美",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0017",head="yum_z1a",x2=0,x=345,lv=4,id=6},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002174",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Yartsa gunbu?”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No lo conoces? Es un hongo que crece en los cadáveres de animales. Es uno de\nlos artículos de más lujo que hay en la medicina china.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0012",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002175",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ehh, no conocía ese hongo...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, aunque bueno, en realidad su forma es distinta.”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
"Hikawa estaba dibujando sobre mi lobo un hongo que parecía un enano.",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"text"},
text={
ja={
{
"Que también, de hecho, se asemejaba a una muchacha con una sombrilla.",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0010",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002137",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fuh...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"text"},
text={
ja={
{
"Al parecer Kawachino terminó ya.",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué es esto? ¿Un matagi?”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002138",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Más o menos. Es un cazador.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un cazador, eh... Ya tenemos al lobo y al cazador, deberíamos dibujar a\nCaperucita roja también.”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002176",ch="rna"},
},
ja={
{
name={"Rina"},
"“No hace falta.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0016",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002177",ch="rna"},
},
ja={
{
name={"Rina"},
"“Caperucita no tiene lugar acá.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002178",ch="rna"},
},
ja={
{
name={"Rina"},
"“En su lugar está este hongo.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un hongo? ¿En lugar de Caperucita?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"text"},
text={
ja={
{
"La verdad es que no tengo ni idea de lo que Hikawa pretende.",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"text"},
text={
ja={
{
"Pero Kawachino parecía entender.",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0001",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002179",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi, ¿dibujaste al cazador?”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0004",head="yum_z1a",x=345,lv=4,id=6},
{"fgact",ch="優美",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002139",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0008",head="rna_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002180",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0002",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002140",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Porque el cazador es fuerte...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0000",face="a0002",head="rna_z1a",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002181",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Después de eso seguimos dibujando.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
"Hikawa me pedía que dibujara varias criaturas, y siempre que terminaba ella le\nagregaba hongos encima.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"Criaturas con hongos creciendo en sus espaldas. Era toda una vista de fantasía.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"bg",file="bluesky_spring",id=8,lv=8,sync=1,path=":cg/"},
{"ex",time=1000,func="wait"},
{"bg",file="eveningsky_spring01",id=9,lv=9,sync=1,path=":cg/"},
{"ex",time=1000,func="wait"},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg081b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0002",head="rna_z1d",x=-345,lv=4,id=5,sync=0},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0008",head="yum_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm023"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002182",ch="rna"},
},
ja={
{
name={"Rina"},
"“Qué divertido fue hoy.”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque nada parecido a una cita, debo decir.”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0004",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002183",ch="rna"},
},
ja={
{
name={"Rina"},
"“A fin de cuentas disfrutamos, es lo que importa, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0011",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002141",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0008",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002184",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué sucede, Yuumi?”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0020",face="a0009",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_002142",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Ah, no es nada...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0010",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002185",ch="rna"},
},
ja={
{
name={"Rina"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0009",head="rna_z1d",x=-345,lv=4,id=5},
{"fgact",ch="里奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002186",ch="rna"},
},
ja={
{
name={"Rina"},
"“Bueno.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0001",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002187",ch="rna"},
},
ja={
{
name={"Rina"},
"“Una cita de tres... Quizás esta sea la primera y última vez que tenga una...”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quién sabe.”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0002",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002188",ch="rna"},
},
ja={
{
name={"Rina"},
"“Mis más preciosas memorias son las de aquellos tiempos.”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0004",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002189",ch="rna"},
},
ja={
{
name={"Rina"},
"“Cuando estaba con Yuumi, en este parque, y luego viniste tú.”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0002",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002190",ch="rna"},
},
ja={
{
name={"Rina"},
"“Era una relación bastante extraña la que teníamos.”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0003",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002191",ch="rna"},
},
ja={
{
name={"Rina"},
"“Pero en esos momentos me sentía viva.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Viva...”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1d0000",face="d0002",head="rna_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rna_002192",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sé que suena raro. Pero así me sentía.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"text"},
text={
ja={
{
"Hikawa mira al cielo, cada vez más oscuro.",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"text"},
text={
ja={
{
"El sol vespertino tenía un curioso matiz.",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"text"},
text={
ja={
{
"Parecía un vidrio de azul y rojo. Translúcido, y fino, sumamente fino.",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"text"},
text={
ja={
{
"No conozco ningún otro lugar en el mundo donde haya este nivel de translucidez.",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"bgm",stop=1,time=1000},
{"bg",file="ev_uni_c56_01",path=":ev/ev_uni_c56/",set="ev_uni_c56"},
{"bgm",file="bgm019"},
{"text"},
text={
vo={
{"vo",file="fem_rna_002193",ch="rna"},
},
ja={
{
name={"Rina"},
"“¡Venus!”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, lo es.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"text"},
text={
vo={
{"vo",file="fem_rna_002194",ch="rna"},
},
ja={
{
name={"Rina"},
"“La estrella del crepúsculo.”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"text"},
text={
vo={
{"vo",file="fem_yum_002143",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En caso de verla en la madrugada, le llaman la estrella del alba. Los nombres\nson distintos, aunque es el mismo planeta.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"text"},
text={
vo={
{"vo",file="fem_yum_002144",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Venus.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"text"},
text={
vo={
{"vo",file="fem_rna_002195",ch="rna"},
},
ja={
{
name={"Rina"},
"“La estrella más brillante. No hay ningún otro astro en el firmamento que brille\nmás que Venus...”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"text"},
text={
vo={
{"vo",file="fem_yum_002145",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No, en realidad sí hubo una estrella que brilló tanto como Venus.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"text"},
text={
vo={
{"vo",file="fem_yum_002146",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“SN 1572.”",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"text"},
text={
vo={
{"vo",file="fem_rna_002196",ch="rna"},
},
ja={
{
name={"Rina"},
"“¿Qué es eso?”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"text"},
text={
vo={
{"vo",file="fem_yum_002147",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Es una supernova que fue detectada en la constelación de Casiopea y que brilló\ncon diez veces la intensidad de Sirius... Quizás la conozcas por su otro\nnombre, la supernova de Tycho.”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"text"},
text={
vo={
{"vo",file="fem_rna_002197",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, he escuchado de ella. Si la memoria no me falla, se llegó a decir que\nsirvió como modelo de la estrella chotacabras.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"text"},
text={
vo={
{"vo",file="fem_yum_002148",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Aunque la luz de Tycho no fue la de una estrella como tal.”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"text"},
text={
vo={
{"vo",file="fem_yum_002149",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fue producida por una explosión de supernova. No era la luz de una estrella con\nvida, sino la de una muriendo.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"text"},
text={
vo={
{"vo",file="fem_yum_002150",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y es por eso que ya no podemos verla...”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La supernova de Tycho...\nPrimera vez que escucho ese nombre. ¿Hace cuánto fue eso?”",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"text"},
text={
vo={
{"vo",file="fem_yum_002151",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Fue descubierta en Europa, durante la Edad Media, así que fue hace un buen\ntiempo.”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"text"},
text={
vo={
{"vo",file="fem_yum_002152",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y encima de eso, su brillo duró solo por dos años.”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
vo={
{"vo",file="fem_yum_002153",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“A pesar de eso, durante esos dos años que brilló, iluminó al firmamento con una\nluz que nada tenía que envidiarle a Venus...”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
vo={
{"vo",file="fem_yum_002154",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Brillaba casi como si estuviera en llamas.”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"text"},
text={
vo={
{"vo",file="fem_rna_002198",ch="rna"},
},
ja={
{
name={"Rina"},
"“No sabía eso.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"text"},
text={
vo={
{"vo",file="fem_yum_002155",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En este aspecto, creo que logro entender por qué Miyazawa usó la imagen de la\nestrella chotacabras.”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"text"},
text={
vo={
{"vo",file="fem_yum_002156",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El deseo de la autoinmolación... claro.”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"text"},
text={
vo={
{"vo",file="fem_yum_002157",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El deseo de autoinmolación que aparece en las obras de Miyazawa es el punto\nextremo de su altruismo...”",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"text"},
text={
vo={
{"vo",file="fem_yum_002158",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y está en esa estrella que brilla con culpa y arrepentimiento. La estrella del\naltruismo...”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"text"},
text={
vo={
{"vo",file="fem_yum_002159",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Si tan solo... si tan solo hubiera podido discutir de esta manera cuando me\ncontaste la historia del chotacabras, yo...”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"text"},
text={
vo={
{"vo",file="fem_rna_002199",ch="rna"},
},
ja={
{
name={"Rina"},
"“Tranquila, de hecho no sabía eso. Se me ha hecho bastante interesante.”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
vo={
{"vo",file="fem_yum_002160",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿Sí? Me reconforta que me digas eso. Valió la pena el tiempo que invertí\nestudiando en el club de astronomía...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
vo={
{"vo",file="fem_yum_002161",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No soy inteligente como tú, no tenía manera de entablar una conversación acerca\nde literatura. Así que pensé que quizás, por lo menos, podría hablarte de las\nestrellas...”",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por eso es que estabas en el club de astronomía...”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"text"},
text={
vo={
{"vo",file="fem_yum_002162",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Eso no descarta el hecho de que sí me gustan las estrellas.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
vo={
{"vo",file="fem_yum_002163",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Las estrellas que vi con Rina en este parque han sido las más hermosas que he\nvisto...”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"text"},
text={
vo={
{"vo",file="fem_yum_002164",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Las estrellas son geniales. Se desplazan con belleza y en orden,\nindependientemente de todo el caos en la tierra.”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
vo={
{"vo",file="fem_yum_002165",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“En ese entonces todavía no lograba entenderlo muy bien, pero... creo que ahora\nentiendo cómo se sentían el chotacabras y el escorpión.”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Kawachino...”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"text"},
text={
vo={
{"vo",file="fem_yum_002166",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“La estrella chotacabras... Enormemente bella, y completamente alejada de mí.\nPero es esa infinita distancia lo que tanto me atrae ahora a la historia...”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
vo={
{"vo",file="fem_yum_002167",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Horror, vergüenza, culpabilidad. Todo eso convirtió al chotacabras en una\nhermosa, llameante estrella.”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"text"},
text={
vo={
{"vo",file="fem_yum_002168",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Un relato demasiado hermoso como para mí.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
vo={
{"vo",file="fem_yum_002169",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Y, así como puedes ver, me he vuelto toda una conocedora de las\nestrellas.”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"text"},
text={
vo={
{"vo",file="fem_rna_002200",ch="rna"},
},
ja={
{
name={"Rina"},
"“Fue una hermosa historia, me divertí.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
vo={
{"vo",file="fem_yum_002170",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Hablar de cosas hermosas hace hermosas historias.”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"text"},
text={
vo={
{"vo",file="fem_yum_002171",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“No en vano, la supernova de Tycho es de por sí preciosa...”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
vo={
{"vo",file="fem_yum_002172",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Jaa, las cosas hermosas son lo mejor...”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"text"},
text={
vo={
{"vo",file="fem_yum_002173",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Me encanta lo hermoso.”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"text"},
text={
vo={
{"vo",file="fem_yum_002174",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Por lo general nunca suelo darme cuenta de lo que hay dentro, y por eso me veo\natraída por lo bello que se ve en lo externo.”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"text"},
text={
vo={
{"vo",file="fem_yum_002175",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Por eso me gusta la historia del chotacabras, y la manera en que se describe la\npurificación y su transformación estética mediante la autoinmolación...”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"text"},
text={
vo={
{"vo",file="fem_rna_002201",ch="rna"},
},
ja={
{
name={"Rina"},
"“Yuumi...”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
vo={
{"vo",file="fem_yum_002176",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Bieeen, ¿nos vamos ya? Es tarde.”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"text"},
text={
vo={
{"vo",file="fem_rna_002202",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, sí...”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, ya es hora.”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"text"},
text={
ja={
{
"Nos fuimos del parque de cipreses.",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"text"},
text={
ja={
{
"El parque donde nos conocimos.",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
"El ciprés es símbolo de muerte, lamento y desesperanza.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"text"},
text={
ja={
{
"Pero paradojicamente, es también visto como símbolo de la inmortalidad y la\nreencarnación.",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_zypressen_10_2"},
{"text"},
linkback="block_00302",
},
label = {
top={block="block_00000",label=1},
},
}
