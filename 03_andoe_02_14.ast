{"extrans",time=1000,sync=1},
{"bg",file="ed_sakura_03",id=3,lv=3,speed=5000,ease="easeinout_sine",path=":cg/kusouzu/",set="kusouzu",x2=2103,y2=-200,x=3357,y=228,ax=1365,ay=768,bx=-405,by=-228,sync=0},
{"bg",file="ed_sakura_02",id=2,lv=2,speed=5000,ease="easeinout_sine",path=":cg/kusouzu/",set="kusouzu",x2=-627,y2=-200,x=627,y=228,ax=1365,ay=768,bx=-405,by=-228,sync=0},
{"bg",file="ed_sakura_01",id=1,lv=1,speed=5000,ease="easeinout_sine",path=":cg/kusouzu/",set="kusouzu",x2=-3357,y2=-200,x=-2103,y=228,ax=1365,ay=768,bx=-405,by=-228,sync=0},
{"extrans",time=0},
{"ex",time=5000,sync=0,func="wait"},
{"bg",file="ev_uni_c67_07",id=6,lv=6,time=2000,rule=214,sync=1,path=":ev/ev_uni_c67/",set="ev_uni_c67"},
{"ex",time=2000,func="wait"},
{"msgoff"},
{"cgdel",id=3,lv=3,sync=0},
{"cgdel",id=6,lv=6,sync=0},
{"extrans",time=1000,sync=1},
{"bg",file="ed_sakura_02",id=2,lv=2,speed=5000,ease="easeinout_sine",path=":cg/kusouzu/",set="kusouzu",x2=627,y2=228,x=1881,y=-228,ax=1365,ay=768,bx=-405,by=-228,sync=0},
{"bg",file="ed_sakura_01",id=1,lv=1,speed=5000,ease="easeinout_sine",path=":cg/kusouzu/",set="kusouzu",x2=-2103,y2=228,x=-849,y=-228,ax=1365,ay=768,bx=-405,by=-228,sync=0},
{"extrans",time=0},
{"ex",time=5000,func="wait"},
{"bg",file="ev_uni_c67_09",id=5,lv=5,time=2000,rule=214,sync=1,path=":ev/ev_uni_c67/",set="ev_uni_c67"},
{"ex",time=2000,func="wait"},
{"msgoff"},
{"cgdel",id=5,lv=5,sync=0},
{"extrans",time=1000,sync=1},
{"bg",file="ed_sakura_02",id=2,lv=2,speed=5000,ease="easeinout_sine",path=":cg/kusouzu/",set="kusouzu",x2=1881,y2=-228,x=3135,y=228,ax=1365,ay=768,bx=-405,by=-228,sync=0},
{"bg",file="ed_sakura_01",id=1,lv=1,speed=5000,ease="easeinout_sine",path=":cg/kusouzu/",set="kusouzu",x2=-849,y2=-228,x=405,y=228,ax=1365,ay=768,bx=-405,by=-228,sync=0},
{"extrans",time=0},
{"ex",time=5000,func="wait"},
{"ex",time=1000,func="wait"},
{"bg",file="ev_uni_c67_11",id=4,lv=4,time=2000,rule=214,sync=1,path=":ev/ev_uni_c67/",set="ev_uni_c67"},
{"text"},
text={
ja={
{
"La caligrafía de Kenichiro Kusanagi va inscribiéndose sobre los cuadros.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001079",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Naoya...”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0005",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001080",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Grabaré mi nombre sobre los cuadros.”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hazlo. Eso convertirá esta serie de seis obras en la falsificación perfecta.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0011",head="ken_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_001081",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Una falsificación perfecta?... No, no lo es.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué? ¿Algún defecto?”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001082",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Para ser una falsificación sí, tiene muchísimos defectos.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso no está nada bien entonces, hay que arreglar--”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0006",head="ken_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_001083",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Cabeza hueca, ¿cómo se supone que vas a arreglar esto? Esto me pertenece...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te pertenece?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"bg",file="ev_com_f04_14",path=":ev/ev_com_f04/",set="ev_com_f04"},
{"text"},
text={
vo={
{"vo",file="man_kid_001084",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No podía haber mejor final para el estafador del siglo, sí señor...”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
vo={
{"vo",file="man_kid_001085",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Estos epitafios me los dedicaste tú a mí, Naoya. Y por eso inscribiré mi nombre\nsobre ellos.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
vo={
{"vo",file="man_kid_001086",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Esta obra no la hice yo.”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"text"},
text={
vo={
{"vo",file="man_kid_001087",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Esta obra la creó Naoya Kusanagi para despedirme, ya en la cercanía de mi\nmuerte.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
vo={
{"vo",file="man_kid_001088",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Seguramente la tumba que me harán estará cubierta de muchas flores. Pero esa\nserá solo una tumba de mentira. Mi verdadera tumba está aquí, ahora, junto a\nestos cuadros.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"text"},
text={
vo={
{"vo",file="man_kid_001089",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“... Esta noche, hace casi nada, soñé que moría. Y por cosa extraña, fue justo\nen el instante en que recordé lo feliz que fui viviendo.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
vo={
{"vo",file="man_kid_001090",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Gracias, Naoya.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="man_kid_001091",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No podía haber recibido una mejor pintura de regalo. Estos cuadros son\nperfectos para mi despedida eterna...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
vo={
{"vo",file="man_kid_001092",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Qué buena vida tuve...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
vo={
{"vo",file="man_kid_001093",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Son momentos como estos los que me lo recuerdan...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="man_kid_001094",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“La pintura es una de las mejores cosas que puede haber...”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"text"},
text={
vo={
{"vo",file="man_kid_001095",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Muchas personas incluyen palabras en sus sentimientos, y los expresan.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="man_kid_001096",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero el habla es algo de muy poca esencia.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
vo={
{"vo",file="man_kid_001097",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Por eso es que muchos sabios prefieren permanecer callados.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
vo={
{"vo",file="man_kid_001098",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Hablar de más ensucia el cuerpo.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
vo={
{"vo",file="man_kid_001099",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y de un cuerpo sucio solo nacen palabras tan sustanciosas como el propio\nhumo...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
vo={
{"vo",file="man_kid_001100",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero en el arte el habla es innecesaria.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
vo={
{"vo",file="man_kid_001101",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Solo reluce, de manera muy pulida, lo importante.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"bg",file="ev_com_f04_07",sync=0,face=1,time=400,path=":ev/ev_com_f04/",set="ev_com_f04"},
{"text"},
text={
vo={
{"vo",file="man_kid_001102",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“A Nice Derangement of Epitaphs.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
vo={
{"vo",file="man_kid_001103",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De esa manera será tratada esta obra, seguramente...”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="man_kid_001104",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pero no me importa.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"text"},
text={
vo={
{"vo",file="man_kid_001105",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Después de todo, estos cuadros son epitafios dedicados para mí...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="man_kid_001106",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Moriré pronto.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
vo={
{"vo",file="man_kid_001107",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Esta vida se sintió larga, y también sorprendentemente corta, pero a pesar de\ntodo larga... Así lo percibo ahora.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
vo={
{"vo",file="man_kid_001108",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Cuando te detienes a pensar un poco antes del final, llegas a comprender varias\ncosas.”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
vo={
{"vo",file="man_kid_001109",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Gracias.”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
vo={
{"vo",file="man_kid_001110",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Esa es la única palabra que te puedo dar, Naoya...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
"Se me aprieta la garganta.",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
"No me sale ninguna palabra.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"text"},
text={
vo={
{"vo",file="man_kid_001111",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pude pasar toda mi vida pintando... y qué feliz fui haciéndolo.”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
vo={
{"vo",file="man_kid_001112",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, qué feliz fui...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"text"},
text={
ja={
{
"Kenichiro Kusanagi escribió su nombre y estampó el sello que sacó del bolsillo\ndel pecho de su camisa sobre los seis cuadros.",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"Su nombre quedó grabado sobre 'Sakura Musouzu'.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"bgm",stop=1,time=3000},
{"se",stop=1,id=-1,time=3000},
{"vostop",stop=1,time=3000},
{"ntclear"},
