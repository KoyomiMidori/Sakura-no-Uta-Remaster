astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"text"},
text={
vo={
{"vo",file="man_kid_001040",ch="kid"},
},
ja={
{
name={"???"},
"“Es hasta mañana, ¿no? Supongo que ya estarás terminando.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Bwah? ¿Quién está ahí?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",zoom=50,zone="0x000000",file="zbg009g",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="健一郎",size="z1",mode=3,resize=1,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=1500},
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero qu--, ¿qué haces acá?...”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Y allí estaba la persona a quien menos esperaba ver acá.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Por un momento creí que estaba viendo un espejismo.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg009g",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9,sync=0},
{"extrans",time=1500},
{"bgm",file="bgm029"},
{"text"},
text={
vo={
{"vo",file="man_kid_001041",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Estas pintando algo, ¿no? Vamos, muéstrame qué has hecho.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Un momento, tú... ¿Realmente eres tú?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0007",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001042",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Se supone que estás hospitalizado, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001043",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, me escapé.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0008",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001044",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Perdiste la cordura ya? Por supuesto que yo soy yo.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, he estado trabajando tanto que no he pegado casi el ojo... Aún no puedo\nasimilar que estás aquí.”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
{"fgact",ch="健一郎",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001045",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya veo, ¿te sorprendiste de verme acá?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto...”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001046",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sentí que alguien me estaba llamando.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quién?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0007",head="ken_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_001047",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Quién sabe? ¿El destino, tal vez?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué locura dices?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0005",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_001048",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El destino me trajo acá. Por eso estoy ahora aquí. ¿No te convence mi\nrespuesta?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Convencer? Suena más a puros disparates.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
{"fgact",ch="健一郎",act="びっくり",time=100,size=7,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_001049",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Disparates? Claro que no. Bien, muéstrame la obra.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿La obra?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fgact",ch="健一郎",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001050",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, tu obra. Estás pintando la continuación de 'Cerezos recostados', ¿no?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿El hospital te dejó chiflado? No es ninguna continuación, es una\nfalsificación.”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0003",head="ken_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_001051",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Y eso qué importa? Vamos, muéstrame.\nSi no me convence, la romperé en pedazos.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si llegas a hacer eso, nada podrá salvar a Kuzu.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0007",head="ken_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_001052",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, tienes toda la razón. Pero en lo que concierne a la estética y la belleza,\nlas personas no se mueven solo por razón.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_001053",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Las personas pueden llegar a actuar de manera irracional ante lo bello. ¿No es\nasí, Naoya?...”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Ante tanta idiotez, no me queda más que rascarme la cabeza.",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, sí, sí, ¿qué haremos con Kuzu entonces si decides romper la obra?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001054",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues, ahí veremos.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001055",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Yo confío en Naoya Kusanagi. No, podría decir que entre tanta confianza hay\nincluso algo de pavor.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001056",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Y por eso sé que eso no pasará.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pavor? Vamos, por Dios... ¿Yo, a ti?”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0007",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001057",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pavor, eso dije y eso quise decir.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué idiotez dices... ¿Cómo podrías sentir pavor de tu propio hijo?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_001058",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Yo diría que sí. Tú representas muy bien la irracionalidad en la belleza. Y esa\nirracionalidad me causa escalofríos a veces.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo, la irracionalidad en la belleza? Por supuesto que no, qué disparates\ndices.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001059",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Eres el salvajismo en la filantropía. El salvajismo en el afecto. Una especie\nde premonición de cómo el sacrificio en la autoinmolación podría quemar el\nmundo entero...”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001060",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Así es ese artista conocido como Naoya Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Artista? Solo soy un simple estudiante, qué idioteces...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001061",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ese simple estudiante está ahora intentando engañar al mundo con una\nfalsificación, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0010",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001062",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Trompe le Monde.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0005",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001063",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Una espléndida confusión de epitafios.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0005",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001064",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“A veces la confusión en el significado nos puede llevar a crear definiciones\naún más espléndidas.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001065",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“De eso se trata.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No entiendo nada.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0004",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001066",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿De verdad? Yo no entiendo cómo tú no podrías entenderlo, la verdad...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, supongo que debería agradecerle a ese destino del que tanto hablas\nentonces.”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001067",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Por qué?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quería mostrártelas al menos una vez.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001068",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Qué retador, eh.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No es eso, demonios. Simplemente quería tu opinión de qué tan bien está esto\ncomo falsificación...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0003",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001069",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tantas mansas excusas. Desde aquí puedo oler ese espíritu desafiante que\ntienes...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué? Eso no...”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0007",head="ken_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_001070",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ahh, ya está, no importa. En fin, me escapé del hospital. Y aun así como me\nves, solo estar parado me cuesta... Ya la morfina está perdiendo su efecto.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y eso qué me importa? ¡Si tanto te duele, regrésate a dormir a tu cama del\nhospital!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0003",head="ken_z1a",lv=4,id=9},
{"fgact",ch="健一郎",act="うなづく",size=5,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_kid_001071",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Y crees que haré eso, idiota? Después de todo el trabajo que me tomé para\nvenir.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001072",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Bien, muéstrame tu obra, ¿sí?...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien... aunque cada cuadro es enorme, así que tomará algo de tiempo.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0003",head="ken_z1a",lv=4,id=9},
{"fgact",ch="健一郎",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001073",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Estoy al borde de la muerte, esperaré tanto como tenga que esperar.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No vayas a estirar la pata acá...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0002",head="ken_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001074",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Entonces apúrate.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, sí, está bien.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Levanto uno de los cuadros que había terminado ya.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Este es el primero.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0006",head="ken_z1a",lv=4,id=9},
{"fgact",ch="健一郎",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001075",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Deja la presuntuosidad y retira de una vez esa tela. Ya tantas mujeres que he\nconocido me han cansado de esos juegos.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Deja de hablar tanto, cadáver andante.”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Retiro la manta.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"msgoff"},
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0007",head="ken_z1a",lv=4,id=9},
{"fgact",ch="健一郎",act="びっくり",size=5,lv=4,id=9},
{"ex",time=1500,func="wait"},
{"fg",ch="健一郎",size="z1",time=500,mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0001",head="ken_z1a",lv=4,id=9},
{"ex",time=2000,func="wait"},
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1a0000",face="a0005",head="ken_z1a",lv=4,id=9},
{"fgact",ch="健一郎",act="うなづく",size=5,lv=4,id=9},
{"ex",time=1500,func="wait"},
{"bg",file="ev_com_f04_01",id=9,lv=9,path=":ev/ev_com_f04/",set="ev_com_f04"},
{"text"},
text={
ja={
{
"Primer cuadro.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"'Cerezos en destrucción (Esou no Sakura)'.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Kenichiro Kusanagi se queda observando el cuadro.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Un árbol de cerezos con la piel deshecha, rota, exponiendo la carne.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Kenichiro se quedó observando, sin decir nada.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bg",file="ev_com_f04_02",path=":ev/ev_com_f04/",set="ev_com_f04"},
{"text"},
text={
ja={
{
"Levanto el segundo cuadro.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"Segundo cuadro.",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
"'Cerezos desangrándose (Kechizusou no Sakura)'",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"La descomposición avanza, deshaciendo la carne y la grasa, manchando el suelo\ncon sangre y fluidos.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"Kenichiro se queda observando.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"text"},
text={
ja={
{
"No despega un ojo del cuadro.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"bg",file="ev_com_f04_03",path=":ev/ev_com_f04/",set="ev_com_f04"},
{"text"},
text={
ja={
{
"Tercer cuadro.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"'Cerezos pudriéndose (Nouransou no Sakura)'",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
"Los cerezos se han descompuesto ya.",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Kenichiro observa.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Observa los cerezos descompuestos y deshechos.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"bg",file="ev_com_f04_04",path=":ev/ev_com_f04/",set="ev_com_f04"},
{"text"},
text={
ja={
{
"Cuarto cuadro.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"'Cerezos entre moscas (Tansou no Sakura)'",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Aparecen gusanos, moscas y todo tipo de insectos atraídos por la muerte.",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
"Kenichiro Kusanagi observa.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
"No despega el ojo de los cerezos invadidos por las moscas.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"bg",file="ev_com_f04_05",path=":ev/ev_com_f04/",set="ev_com_f04"},
{"text"},
text={
ja={
{
"Quinto cuadro.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
"'Cerezos dispersándose (Sansou no Sakura)'",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Los cerezos comienzan a esparcirse.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
"Kenichiro observa los cerezos esparciéndose.",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
"Solo observa.",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"bg",file="ev_com_f04_07",path=":ev/ev_com_f04/",set="ev_com_f04"},
{"text"},
text={
ja={
{
"El sexto, y último cuadro.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"'Cerezos en cenizas (Shousou no Sakura)'",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"No habían más cerezos.",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"No había nada, solo un campo desolado.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"bgm",stop=1,time=3000},
{"text"},
text={
ja={
{
"Kenichiro Kusanagi cerró silenciosamente sus ojos.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"El depósito estaba a oscuras.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Y el silencio se extendió por segundos.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Pero se sintió mucho más largo.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"bgm",stop=1,time=500},
{"text"},
text={
vo={
{"vo",file="man_kid_001076",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Falta algo...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Y lo que rompió el silencio fueron unas palabras que acabaron con toda la\ntensión en la atmósfera.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"De repente, Kenichiro Kusanagi tomó el pincel que había enganchado a los\nresortes, y lo apretó en su mano.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Ese mismo larguísimo pincel.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_kid_001077",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡Bermellón!”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
"Kenichiro gritó, pidiendo bermellón.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Capto el significado de sus palabras y comienzo a disolver el pigmento.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
"Y se lo pongo enfrente.",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"bgm",file="bgm022"},
{"text"},
text={
vo={
{"vo",file="man_kid_001078",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Yo grabaré los nombres. Estos serán mis epitafios.”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"se",file="se0897s",id=1},
{"bg",time=1000,file="black",path=":bg/"},
{"ex",time=3000,func="wait"},
{"bg",file="ev_com_f04_08",id=1,lv=5,time=2000,path=":ev/ev_com_f04/",set="ev_com_f04"},
{"text"},
text={
ja={
{
"Toma el pincel en su mano.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Con ese particular estilo que lo caracteriza a él. Al gran maestro Kenichiro\nKusanagi.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
"Pero su brazo no temblaba ni un poco.",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
ja={
{
"Estaba completamente inmóvil, como si se hubiera paralizado por un momento.",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"No hace falta ningún resorte ahora. Estos son los trazos del auténtico\nKenichiro Kusanagi.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Sus dedos van grabando los nombres.",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",mode=-2},
{"cgdel",id=-1},
{"bg",time=1000,file="white",path=":bg/"},
{"bg",file="ed_sakura_03",id=3,lv=3,x=-405,y=-228,sync=1,path=":cg/kusouzu/",set="kusouzu",ax=1365,ay=768,bx=-405,by=-228},
{"ex",time=500,func="wait"},
{"bg",file="ev_uni_c67_01",id=9,lv=9,rule=214,time=2000,sync=1,path=":ev/ev_uni_c67/",set="ev_uni_c67"},
{"ex",time=2000,func="wait"},
{"msgoff"},
{"cgdel",id=9,lv=9,sync=0},
{"extrans",time=1000,sync=1},
{"bg",file="ed_sakura_03",id=3,lv=3,speed=5000,ease="easeinout_sine",path=":cg/kusouzu/",set="kusouzu",x2=-405,y2=-228,x=849,y=228,ax=1365,ay=768,bx=-405,by=-228,sync=0},
{"bg",file="ed_sakura_02",id=2,lv=2,speed=5000,ease="easeinout_sine",path=":cg/kusouzu/",set="kusouzu",x2=-3135,y2=-228,x=-1881,y=228,ax=1365,ay=768,bx=-405,by=-228,sync=0},
{"extrans",time=0},
{"ex",time=5000,func="wait"},
{"bg",file="ev_uni_c67_03",id=8,lv=8,time=2000,rule=214,sync=1,path=":ev/ev_uni_c67/",set="ev_uni_c67"},
{"ex",time=2000,func="wait"},
{"msgoff"},
{"cgdel",id=8,lv=8,sync=0},
{"extrans",time=1000,sync=1},
{"bg",file="ed_sakura_03",id=3,lv=3,speed=5000,ease="easeinout_sine",path=":cg/kusouzu/",set="kusouzu",x2=849,y2=228,x=2103,y=-200,ax=1365,ay=768,bx=-405,by=-228,sync=0},
{"bg",file="ed_sakura_02",id=2,lv=2,speed=5000,ease="easeinout_sine",path=":cg/kusouzu/",set="kusouzu",x2=-1881,y2=228,x=-627,y=-200,ax=1365,ay=768,bx=-405,by=-228,sync=0},
{"extrans",time=0},
{"ex",time=5000,func="wait"},
{"bg",file="ev_uni_c67_05",id=7,lv=7,time=2000,rule=214,sync=1,path=":ev/ev_uni_c67/",set="ev_uni_c67"},
{"ex",time=2000,func="wait"},
{"msgoff"},
