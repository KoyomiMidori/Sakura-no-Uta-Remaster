astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="black",path=":bg/"},
{"bgm",file="bgm019"},
{"text"},
text={
ja={
{
"Todo esto sucedió hace más de 10 años.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"Abandonada por mis padres, la familia Natsume me había acogido.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"No, en realidad no sé si me abandonaron. Quizás mi madre pensó que dejarme con\nla familia Natsume sería la mejor opción para protegerme.",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Y es que ni siquiera recuerdo su cara.",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"text"},
text={
ja={
{
"Apenas nací ya estaba bajo el cuidado de los Natsume.",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Y por supuesto, no soy ninguna excepción. Yo también soy una de las hijas\nocultas de Shoichi Nakamura.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
"¿Tuve algún vestigio del poder de Hakuki al nacer? La verdad es que eso tampoco\nlo sé.",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
"Solo recuerdo que fue la abuela Natsume, quien en ese entonces todavía seguía\ncon vida, quien se ocupó de todo.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
"Fueron 3 años los que pasé con la abuela Kotoko en esta casa. Pero todavía\nrecuerdo bien su cara.",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
"Probablemente la yo de entonces era una niña normal, con un corazón normal como\ncualquier otro.",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"text"},
text={
ja={
{
"En las memorias que tengo de esos tiempos, yo reía y lloraba.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg010a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1500},
{"fg",ch="琴子",size="z1",ex03="a0097",mode=3,resize=1,path=":fg/ktk/z1/",file="ktk_z1a0000",face="a0001",head="ktk_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000089",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Qué pasa, Shizuku? ¿Estás llorando?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
vo={
{"vo",file="fem_szd_001036",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,resize=1,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0004",head="ktk_z2a",lv=5,id=9},
{"fgact",ch="琴子",act="おじぎ",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000090",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Venga...”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"La abuela Kotoko se sentó a mi lado, mientras yo lloraba.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0002",head="ktk_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000091",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Por qué? ¿Extrañas a tu madre?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
vo={
{"vo",file="fem_szd_001037",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No. Nunca conocí a mamá, no la extraño...”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000092",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Entonces por qué lloras solita?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
vo={
{"vo",file="fem_szd_001038",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No lo sé... Solo que apenas terminé de comer, comencé a llorar.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0005",head="ktk_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0004",head="ktk_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000093",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Comenzaste a llorar después de comer... ya veo.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
vo={
{"vo",file="fem_szd_001039",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Por qué será?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0002",head="ktk_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000094",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Quién sabe... Tal vez eres muy sensible, y al comer sientes que estás comiendo\ntambién del corazón de seres vivos...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0004",head="ktk_z2a",lv=5,id=9},
{"fgact",ch="琴子",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000095",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Pero no... no creo que sea eso.”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000096",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Tal vez llegaste a percibir los sentimientos que habían en ese platillo que te\nprepararon...”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
vo={
{"vo",file="fem_szd_001040",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Qué quieres decir?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0002",head="ktk_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000097",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Las lágrimas también pueden ser de felicidad.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000098",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Cuando se le pone amor a un platillo, se le pone corazón. Por algo se dice\n'ponerle corazón' a las cosas.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000099",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Probablemente eres capaz de percibir ese corazón...”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
vo={
{"vo",file="fem_szd_001041",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿El corazón que hay en la... comida?”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fgact",ch="琴子",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000100",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Sí, seguramente fue esa bondad lo que te hizo llorar...”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000101",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Porque eres una niña de buen corazón.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
vo={
{"vo",file="fem_szd_001042",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Yo?... ¿Una niña de buen corazón?”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fgact",ch="琴子",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000102",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Sí, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0004",head="ktk_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0001",head="ktk_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000103",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Aunque quizás más pronto que tarde aparecerán malas personas que intentarán\ntratarte como un objeto, y no como la buena niña que eres.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0004",head="ktk_z2a",lv=5,id=9},
{"fgact",ch="琴子",act="いいえ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000104",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Pero no olvides esto que te voy a decir, jamás. Eres sensible, más sensible que\ncualquiera. Y por eso es que tienes un poder especial en ti.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0001",head="ktk_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000105",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Jamás llegues a creer que eres solo una marioneta sin corazón.”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
vo={
{"vo",file="fem_szd_001043",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Corazón? Abuela Kotoko, ¿qué es el corazón?”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0005",head="ktk_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0004",head="ktk_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000106",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“¿Que qué es el corazón? Vaya que haces preguntas difíciles... Ahora que lo\nrecuerdo, Mizuna siempre se la pasaba meditando acerca de esos temas tan\ncomplicados...”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000107",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Y bueno, yo tampoco llegué a estudiar mucho, así que no puedo darte una\nrespuesta complicada. Pero...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0001",head="ktk_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000108",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“El corazón es, probablemente, lo que sentiste en eso.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
vo={
{"vo",file="fem_szd_001044",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Lo que sentí en eso?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0002",head="ktk_z2a",lv=5,id=9},
{"fgact",ch="琴子",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000109",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Sí, en la comida. En la comida también hay corazón. Siempre y cuando sientas\nque lo hay...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
vo={
{"vo",file="fem_szd_001045",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Hay también corazón en la comida?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0004",head="ktk_z2a",lv=5,id=9},
{"fgact",ch="琴子",act="いいえ",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0002",head="ktk_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000110",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Tampoco es que todo tenga un corazón. Pero, si llegas a sentir corazón en algo,\nsabrás que ese algo tiene corazón.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000111",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Y así como ahí, también dentro de ti.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
vo={
{"vo",file="fem_szd_001046",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿El corazón está presente en varios lugares?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fgact",ch="琴子",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000112",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Tal vez. Así decían los antepasados.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_szd_001047",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Antepasados?”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fgact",ch="琴子",act="うなづく",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0004",head="ktk_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000113",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Sí. Nuestros antepasados eran inteligentes, y percibían corazón en los árboles,\nen las piedras e incluso en los ríos. Sabían que el corazón no era algo que\nsolamente las personas tienen.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0002",head="ktk_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000114",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Para mí, esa es una visión del mundo muy acertada...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
vo={
{"vo",file="fem_szd_001048",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_szd_001049",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Abuela Kotoko, abuela Kotoko, ¿dónde está tu corazón entonces?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fgact",ch="琴子",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000115",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Dentro de ti, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_szd_001050",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿D-Dentro de mí? ¿Eh? Entonces... ¿dónde está mi corazón?”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
vo={
{"vo",file="fem_ktk_000116",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Dentro de mí. Y cómo no, también dentro de ti, Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fgact",ch="琴子",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000117",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Así que no te preocupes. Dentro de ti residen muchos, muchos corazones.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"La abuela Kotoko sonrió cariñosamente.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0004",head="ktk_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000118",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Y aun cuando yo me vaya, dentro de ti vivirá mi corazón.”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
vo={
{"vo",file="fem_szd_001051",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No quiero que te vayas, abuela Kotoko.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0002",head="ktk_z2a",lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0001",head="ktk_z2a",lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_ktk_000119",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Qué contenta me pone que me digas eso. Pero todos, en algún momento u otro,\ntenemos que despedirnos. Y por eso debes conservar con cuidado el corazón de\nesa persona...”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
vo={
{"vo",file="fem_szd_001052",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aun así no quiero que te vayas, abuela Kotoko.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="琴子",size="z2",ex03="a0097",mode=3,path=":fg/ktk/z2/",file="ktk_z2a0000",face="a0002",head="ktk_z2a",lv=5,id=9},
{"fgact",ch="琴子",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_ktk_000120",ch="ktk"},
},
ja={
{
name={"Kotoko"},
"“Tranquila, no me iré tan fácilmente. No te preocupes.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
vo={
{"vo",file="fem_szd_001053",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Uhm.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Yo quería mucho a la abuela Kotoko.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
"La quería más que a nadie.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"Y por eso es que el día en que ella murió.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Perdí, como si nada, mi corazón.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"No pude cumplir con lo que la abuela Kotoko me pidió.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"Tanto que insistió la abuela en que yo tenía un corazón. Y a pesar de eso,\napenas partió, yo misma hice perder ese corazón.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Y así como perdí el mío, no pude cuidar el suyo...",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Era una muchacha débil... Creo que quizás intenté darle la espalda a la verdad\nacabando con mi propio corazón.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"De ahí en adelante no volví a reír, ni a llorar.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Hasta ese entonces, mi mundo había estado repleto de corazones.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Pero ahora no había nada de eso.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Me había convertido en Hakuki.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg004a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"fg",ch="健一郎",size="z1",mode=3,resize=1,path=":fg/ken/z1/",file="ken_z1b0000",face="b0011",head="ken_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001113",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Shizuku? ¿Tienes un momento?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
vo={
{"vo",file="fem_szd_001054",ch="szd"},
},
ja={
{
name={"Shizuku"},
"*asiente*...",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0006",head="ken_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001114",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Igual de inexpresiva como siempre, eh...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
"Ese día Kenichiro vino a la residencia Natsume, como era de costumbre.",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
"En esa época se había descubierto que la madre de Naoya, Mizuna, estaba\nenferma, y Kenichiro había regresado para cuidar de ella.",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="健一郎",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0006",head="ken_z1b",x2=0,x=-345,lv=4,id=9},
{"fg",ch="藍",size="z1",mode=3,resize=1,path=":fg/aix/z1/",file="aix_z1i0000",face="i0001",head="aix_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000818",ch="aid"},
},
ja={
{
name={"Ai"},
"“Kenichiro, ¿té caliente?”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=-345,lv=4,id=9},
{"fgact",ch="健一郎",act="いいえ",size=6,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001115",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, por favor...”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000819",ch="aid"},
},
ja={
{
name={"Ai"},
"“Quizás estés bien con eso, pero supongo que nuestra pequeña visita también\nquerrá algo.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0007",head="ken_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_kid_001116",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, cierto. Se me había pasado la presentación.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Una pequeña y suave melena se movió detrás de Kenichiro. La niña bajó la cabeza\ny se presentó.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="健一郎",mode=-1,lv=4,id=9},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003807",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mi nombre es Rin, es un placer conocerles.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0002",head="aix_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000820",ch="aid"},
},
ja={
{
name={"Ai"},
"“El placer es mío, me llamo Ai Natsume. Soy la hermana mayor acá, y la jefa de\nla casa también.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0012",head="rin_z1i",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",time=100,size=7,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003808",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=345,lv=4,id=6},
{"fgact",ch="藍",act="うなづく",size=6,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000821",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, bueno, es normal que te sorprendas. Hasta el año pasado había un adulto\nencabezando la familia, y no una niña como yo.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
vo={
{"vo",file="man_kid_001117",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ahora que lo recuerdo, ya casi pasa un año desde su partida... Ni siquiera la\nvieja esa pudo salvarse de la muerte. Aún me cuesta creerlo.”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0006",head="aix_z1i",x=345,lv=4,id=6},
{"fgact",ch="藍",act="びっくり",size=6,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000822",ch="aid"},
},
ja={
{
name={"Ai"},
"“¡Kenichiro! ¡¿Qué manera de hablar de la abuela es esa?!”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001118",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¡¿Y cómo debería hablar de ella?! Quizás haya sido una dulce abuelita con\nustedes, pero conmigo fue un ogro.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0002",head="aix_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000823",ch="aid"},
},
ja={
{
name={"Ai"},
"“... Eso es porque ella tenía su confianza depositada en ti...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0010",head="aix_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000824",ch="aid"},
},
ja={
{
name={"Ai"},
"“Yo también quería que la abuela confiara tanto en mí como lo hacía en ti. Por\neso quería que la abuela viviera lo suficiente hasta verme convertida en una\nmujer adulta y fuerte...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
vo={
{"vo",file="man_kid_001119",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Vivir lo suficiente, eh... Esa abuela vivió 103 años. Pedir que viviera más...\nMe dan escalofríos de solo pensarlo.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003809",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Kotoko Natsume? ¿La cabeza de la familia Natsume?”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="man_kid_001120",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Sabes quién es? ¿Una muchachita como tú sabe quién es?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0008",head="rin_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003810",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Mi padre trabaja como comerciante de pinturas, y he escuchado ese nombre en sus\nconversaciones. Aunque cuando se lo menciono, se enoja conmigo...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="稟",mode=-1,lv=4,id=5},
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001121",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“La abuela tenía una gran cantidad de artículos de arte en su posesión, supongo\nque no tiene nada de raro que cualquier comerciante de arte en Yumihari la\nconociera... Y el nombre de Misakura también es famoso en el negocio,\nciertamente.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0010",head="ken_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0002",head="ken_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_kid_001122",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Pero que se enojara contigo solo por mencionar su nombre? Aunque sí, bueno, la\nseñora era una yakuza, así que no es de sorprenderse.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0002",head="aix_z1i",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="藍",act="うなづく",size=6,lv=4,id=6},
},
vl02={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0016",head="aix_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000825",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Misakura es que se llama esta pequeña?...\nHmph, qué bueno. Pensé que me diría que era una Kusanagi.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0006",head="ken_z1b",x=-345,lv=4,id=5},
{"fgact",ch="健一郎",act="いいえ",size=10,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0004",head="ken_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_kid_001123",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ai, ¿a qué vienes con eso? Yo jamás le pondría una mano encima a otra mujer que\nno sea Mizuna.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0018",head="aix_z1i",x=345,lv=4,id=6},
{"fgact",ch="藍",act="うんうん",time=200,size=10,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0017",head="aix_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000826",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, sí, sé muy bien que solo amas a una sola mujer y esa es Mizuna nee-sama,\nKenichiro. Ya sé que ninguna otra mujer podría ocupar ese puesto.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0011",head="ken_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001124",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Por qué dices entonces esas cosas?”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0018",head="aix_z1i",x=345,lv=4,id=6},
{"fgact",ch="藍",act="ud",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0017",head="aix_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000827",ch="aid"},
},
ja={
{
name={"Ai"},
"“Por qué será, ¿eh? ¿No será porque eres tan popular con las mujeres?”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1c0000",face="c0010",head="ken_z1c",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001125",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué vas a saber tú de esas cosas, niñita?...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0004",head="aix_z1i",x=345,lv=4,id=6},
{"fgact",ch="藍",act="icon",y=-360,lv=4,id=6,icon="icon05z1",x=40},
{"fgact",ch="藍",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0006",head="aix_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000828",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ja, ja, ja, ja, ¿niñita? Pero qué maleducado. Kenichiro, ¿quieres que te vuelva\na saludar con un golpe como lo hacía hace tiempo?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"fgact",ch="藍",act="停止",lv=4,id=6},
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1c0000",face="c0009",head="ken_z1c",x=-345,lv=4,id=5},
{"fgact",ch="健一郎",act="du",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1c0000",face="c0002",head="ken_z1c",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_kid_001126",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Preferiría ahorrarme el saludo.\nBien, Rin, ¿qué quieres? ¿Está bien con té?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="藍",mode=-1,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0008",head="rin_z1i",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003811",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Estoy bien, gracias. No me gusta el sabor amargo del té.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1c0000",face="c0011",head="ken_z1c",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001127",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya escuchaste.”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_aid_000829",ch="aid"},
},
ja={
{
name={"Ai"},
"“Ya veo. Ahh, pero se me acabó el jugo.”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0012",head="rin_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003812",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No se preocupe, por favor. Por cierto, Kenichiro-san.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1c0000",face="c0002",head="ken_z1c",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001128",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Qué pasa?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003813",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Quién es esta muchacha?”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001129",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ah, ¿esta niña? Se llama Shizuku.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003814",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku-chan...”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"text"},
text={
vo={
{"vo",file="fem_szd_001055",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"Al ver mi cara, Rin se volvió alegremente hacia Kenichiro-san.",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0004",head="rin_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003815",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Wah, pero qué muchacha tan linda, Kenichiro-san!”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0010",head="ken_z1b",x=-345,lv=4,id=5},
{"fgact",ch="健一郎",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001130",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí lo es. La gran mayoría de las Natsume son preciosas.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003816",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Si logro cautivar a esta muchacha cumplirás con tu promesa de dejarme usar\ntodos los pigmentos minerales que yo quiera, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0002",head="ken_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001131",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí. Si cumples con tu parte, te daré los pigmentos.”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
vo={
{"vo",file="fem_aid_000830",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Pigmentos minerales? ¿Qué es eso?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0011",head="ken_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001132",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Tal como lo indica su nombre, son pigmentos a base de minerales pulverizados.\nSe utilizan principalmente en pinturas japonesas, aunque también tienen otros\nusos.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
vo={
{"vo",file="fem_aid_000831",ch="aid"},
},
ja={
{
name={"Ai"},
"“Je, ¿y quiere pigmentos? Qué muchacha tan rara.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0004",head="rin_z1i",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003817",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, iré a pintar los cerezos con Kenichiro-san.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
vo={
{"vo",file="fem_aid_000832",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Pintar los cerezos?”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003818",ch="rnd"},
},
ja={
{
name={"Rin"},
"“En la estación de tren más próxima está la colina de Yumihari. Quiero dibujar\nlos cerezos que hay allí.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0002",head="ken_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_kid_001133",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Está hablando de los cerezos que hay en el colegio Yumihari, el lugar donde\ntrabajé antes. Y ahora que lo recuerdo, ¿no era ese colegio tu primera\nopción, Ai?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"fg",ch="稟",mode=-1,lv=4,id=6},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0011",head="aix_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000833",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí... Siendo el colegio donde fuiste tú y Mizuna nee-sama, yo también quería\nentrar ahí...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000834",ch="aid"},
},
ja={
{
name={"Ai"},
"“Pero un Natsume jamás podría poner los pies allí.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0007",head="ken_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_kid_001134",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Eso crees? Quizás algo se pueda hacer, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0010",head="aix_z1i",x=345,lv=4,id=6},
{"fgact",ch="藍",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0009",head="aix_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000835",ch="aid"},
},
ja={
{
name={"Ai"},
"“No, no se puede hacer nada. Y bueno, cerca está el San Ruan, que también es un\ncolegio de prestigio, así que estoy pensando en intentar ahí...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0011",head="ken_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_kid_001135",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Mmmm, pues qué más da. Tu sabrás elegir cuando llegue el momento. Total, ambos\nrequieren más o menos el mismo promedio de calificaciones, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0011",head="aix_z1i",x=345,lv=4,id=6},
{"fgact",ch="藍",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000836",ch="aid"},
},
ja={
{
name={"Ai"},
"“Sí, bueno...”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="藍",mode=-1,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_001056",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Por qué vas a pintar los cerezos de Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0004",head="rin_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003819",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Los cerezos allí se me hacen algo misteriosos. No solo por lo hermoso, sino\nporque también pareciera que de alguna forma de ellos florecen los\nsentimientos de varias personas.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
vo={
{"vo",file="fem_szd_001057",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Como si de ellos, florecieran los sentimientos de varias personas...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"No pude evitar superponer esas palabras con aquellas que me había dado la\nabuela Kotoko.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0008",head="rin_z1i",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0004",head="rin_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003820",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nadie me entendía cuando hablaba de eso, excepto por Kenichiro-san.”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0006",head="ken_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_kid_001136",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Más que entender, fue simplemente porque hay una leyenda de ese estilo acerca\nde ese lugar y la conocía.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
vo={
{"vo",file="fem_aid_000837",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Una leyenda?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0011",head="ken_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001137",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Nunca has escuchado la leyenda de los cerezos milenarios? Es relativamente\nconocida en Yumihari.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
vo={
{"vo",file="fem_aid_000838",ch="aid"},
},
ja={
{
name={"Ai"},
"“S-Sí, la he escuchado.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0010",head="ken_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001138",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Esta muchacha siente que hay algo en esos cerezos.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0005",head="rin_z1i",x=345,lv=4,id=6},
{"fgact",ch="稟",act="びっくり",time=100,size=7,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003821",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Tú también habías dicho que sentías algo, Kenichiro-san. ¿No recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0009",head="ken_z1b",x=-345,lv=4,id=5},
{"fgact",ch="健一郎",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001139",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Sí, lo recuerdo, pero yo no tengo esa misma sensibilidad que tienes tú...”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003822",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿De verdad? Yo sé que tú también puedes entender lo que hay ahí, Kenichiro-san.\nPara mí eres un genio.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1c0000",face="c0003",head="ken_z1c",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001140",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Qué puedo hacer si mi propia discípula me dice eso, ¿eh?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_aid_000839",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿D-Discípula? ¡¿Esta niña?! ¿N-No estabas solamente intentando ayudarle a\naprender a pintar?”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1c0000",face="c0002",head="ken_z1c",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001141",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No se equivoca, sí es mi discípula. Como verás, es solo una enana, pero tiene\nhabilidad.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
vo={
{"vo",file="fem_aid_000840",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Habilidad? ¿Esta pequeña niña?”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1c0000",face="c0010",head="ken_z1c",x=-345,lv=4,id=5},
{"fgact",ch="健一郎",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1c0000",face="c0002",head="ken_z1c",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_kid_001142",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Cualquiera diría lo mismo, sí. Bien, Rin, ¿por qué no nos pintas algo?”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0016",head="rin_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003823",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Está bien. Basta con que cautive a esta muchacha, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1c0000",face="c0003",head="ken_z1c",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001143",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Te advierto que hacerlo no es tan fácil como decirlo.”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003824",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo. Si así lo dices, debe ser cierto...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003825",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero me trajiste acá porque pensaste que podría hacerlo, ¿verdad,\nKenichiro-san?”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1c0000",face="c0001",head="ken_z1c",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001144",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Quién sabe?”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0004",head="rin_z1i",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003826",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ejejeje.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"se",file="se9002",vol=40,id=1},
{"fg",ch="稟",mx=-40,mode=-1,lv=4,id=6},
{"text"},
text={
ja={
{
"Rin salió al jardín alegremente.",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Salgo al jardín yo también, siguiéndola.",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg010a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",lv=4,id=6,sync=0},
{"extrans",rule="083r",vague=40},
{"text"},
text={
vo={
{"vo",file="man_kid_001145",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Por qué afuera?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",lv=4,id=6},
{"fgact",ch="稟",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003827",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Tiene que ser afuera!”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"La muchacha saca pigmento de los tubos.",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"Y luego toma el pincel, y lo alza hacia el cielo.",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0004",head="rin_z1i",lv=4,id=6},
{"fgact",ch="稟",act="du",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003828",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Muy bien, comencemos ya!”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
vo={
{"vo",file="fem_szd_001058",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No hay papel...”",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",lv=4,id=6},
{"fgact",ch="稟",act="びっくり",time=100,size=7,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003829",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡No necesito lienzo! ¡Solo con esto puedo pintar, así!”",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"bgm",stop=1,time=500},
{"fg",mode=-2},
{"se",file="se_arrow1",vol=20,id=1},
{"text"},
text={
ja={
{
"Al decir eso, Rin comenzó de repente a mover el pincel, dirigiéndolo al cielo.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"bgm",file="bgm038"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_001059",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"text"},
text={
ja={
{
"No hay manera de pintar algo sobre el aire.",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"Y sin embargo, por alguna razón pude ver allí un colorido mundo expandiéndose.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",mode=-2},
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0004",head="ken_z1b",x=-345,lv=4,id=5},
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001146",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0013",head="aix_z1i",x=345,lv=4,id=6},
{"fgact",ch="藍",act="びっくり",time=100,size=7,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000841",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿P-Pero qué... es esto?...”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001147",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No lo sé... ¿Puedes verlo también, Ai?”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0012",head="aix_z1i",x=345,lv=4,id=6},
{"fgact",ch="藍",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1i0000",face="i0008",head="aix_z1i",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000842",ch="aid"},
},
ja={
{
name={"Ai"},
"“S-Sí... No sé por qué, pero siento que estoy viendo una pintura donde en\nrealidad no hay nada.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0010",head="ken_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0004",head="ken_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="man_kid_001148",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Ya varias veces he visto a Rin pintando, pero... esto es completamente distinto\na lo que he visto hasta ahora... ¿Qué rayos es?...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Según Kenichiro-san nos contó.",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"text"},
text={
ja={
{
"Aquellas personas capaces de pintar cuadros hermosos tienen también una\nhermosa, coloreada paleta.",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"text"},
text={
ja={
{
"Probablemente el gradiente de colores de la paleta se está reflejando en el\ncielo.",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"text"},
text={
ja={
{
"Por supuesto, simplemente mover el pincel hacia el cielo no causa ese efecto.\nEs justamente el tempo de sus movimientos lo que provoca ese efecto ilusorio\nen el cielo.",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"text"},
text={
ja={
{
"El efecto fue provocado porque su pintura dejó de ser pintura, y pasó a ser\nalgo más parecido a música.",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
"Eso fue lo que nos explicó.",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"text"},
text={
ja={
{
"Aunque me parece que esa interpretación es parcialmente incorrecta.",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"text"},
text={
ja={
{
"Despues de terminar de crear esos trazos, y con una sonrisa en su cara, Rin\ndijo――",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0004",head="rin_z1i",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003830",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Este es el corazón de los cerezos.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003831",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Describí cerezos en pleno florecimiento, de aquellos que resuenan los\nsentimientos de las personas.”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"text"},
text={
vo={
{"vo",file="fem_szd_001060",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“El corazón... de los cerezos...”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Rin trazó sobre el cielo los sentimientos resonados por los cerezos milenarios.",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"text"},
text={
ja={
{
"Fue Rin quien por primera vez, en estos tiempos, le dio cuerpo a esa leyenda.",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"text"},
text={
ja={
{
"Como su nombre lo implica, estos cerezos no florecen por un milenio entero.",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"text"},
text={
ja={
{
"Después de eso Rin los hizo florecer de verdad, pero no hay ningún relato o\nleyenda que indique un florecimiento pasado.",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"text"},
text={
ja={
{
"Solo cuando los sueños que Hakuki tragó se volvieron nubes, y cayeron como\nlluvia sobre la tierra, fue que florecieron en plenitud.",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"text"},
text={
ja={
{
"Dicen que trajeron toda clase de milagros, como si resonaran con los\nsentimientos de alguien.",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"text"},
text={
ja={
{
"Pero después de eso pasaron a ser solo unos simples cerezos, erigidos sobre la\ncolina de Yumihari.",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"text"},
text={
ja={
{
"La ilusión que vimos aquel día fueron resultado, probablemente, no solo de la\nhabilidad de Rin, sino también del poder de los cerezos milenarios.",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"Fue su cualidad de genio lo que la llevó a darle cuerpo a los cerezos\nmilenarios. A los mismos que los relatos decían que no florecen sino cada\nmilenio.",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"text"},
text={
ja={
{
"Así que tal vez fue en ese momento que las agujas del reloj comenzaron a\nmoverse.",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0012",head="rin_z1i",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003832",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Pudieron verlo aunque sea un pequeñito instante?”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"text"},
text={
vo={
{"vo",file="fem_szd_001061",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí... pude verlo... ¿Qué sentimientos resonaron de esos cerezos?”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003833",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Probablemente fueron los cerezos de la tristeza. No sé de quién habra sido esa\ntristeza, pero fue justamente ese el espejismo de cerezos que vi sobre la\ncolina.”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003834",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Siendo solo un espejismo, pensé que quizás lo mejor sería dibujarlos sobre el\ncielo.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
vo={
{"vo",file="fem_szd_001062",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"text"},
text={
vo={
{"vo",file="man_kid_001149",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿P-Pero qué... qué explicación tan absurda es esa?”",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0008",head="rin_z1i",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0009",head="rin_z1i",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003835",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ciertamente fue algo absurda, pero pudiste verlos, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
vo={
{"vo",file="man_kid_001150",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues sí, me parece que sí.”",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2i0000",face="i0003",head="rin_z2i",lv=5,id=6},
{"fgact",ch="稟",act="うなづく",lv=5,id=6},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003836",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡¿Y, Shizuku-chan?! ¡¿Qué tal estuvo?!”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"text"},
text={
vo={
{"vo",file="fem_szd_001063",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Me parecieron preciosos...”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0005",head="rin_z2i",lv=5,id=6},
{"fgact",ch="稟",act="うなづく",lv=5,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003837",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Kenichiro-san, ¿qué tal?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"mwact",act="いいえ",size=5},
{"text"},
text={
vo={
{"vo",file="man_kid_001151",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues, ya escuchaste sus inexpresivas palabras. No había ni un trazo de cautivo\nen ellas...”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0004",head="rin_z2i",lv=5,id=6},
{"fgact",ch="稟",act="びっくり",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0002",head="rin_z2i",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003838",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajaja, ciertamente. Sí, ya me parecía...”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0005",head="rin_z2i",lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0001",head="rin_z2i",lv=5,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_003839",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No es suficiente aún... Quizás por eso se esfumaron en un instante...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",x=-345,lv=4,id=5},
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0008",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001152",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Pues a mí me parece ya bastante impresionante que hayas podido crear una\npintura en el aire, así haya sido solo un instante...”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0004",head="rin_z1i",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003840",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, no tiene nada de impresionante. No logré cautivar a Shizuku-chan, en primer\nlugar.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003841",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Shizuku-chan, dibujaré muchos, muchos corazones de cerezos más. Y el día en que\nrealmente aparezcan cerezos en el cielo lograré hacer que quedes cautivada,\n¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"text"},
text={
vo={
{"vo",file="fem_szd_001064",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Puedes hacer eso?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0016",head="rin_z1i",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003842",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No lo sé. Pero tengo el presentimiento de que si sigo pintando, lo lograré.”",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0009",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001153",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Crear algo en el aire? Eso ya no es pintar, eso es hacer magia, por Dios.”",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0012",head="rin_z1i",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003843",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Claro que no. Lo único que puedo hacer yo es pintar.”",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0011",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001154",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“¿Podría preguntar por qué se te ocurrió pintar cerezos en el aire?”",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0008",head="rin_z1i",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003844",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No lo sé, pero sentí que podía hacerlo.”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_003845",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Cuando vi a Shizuku-chan, sentí que de alguna forma podría pintar los\nsentimientos encerrados en los cerezos de esa colina.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0004",head="rin_z1i",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003846",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, realmente es la primera vez que llego a sentir esto. Kenichiro-san, muchas\ngracias por presentarme a Shizuku-chan.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0010",head="ken_z1b",x=345,lv=4,id=6},
{"fgact",ch="健一郎",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0001",head="ken_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="man_kid_001155",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“No hace falta que me lo agradezcas. Fui nada más ni nada menos que yo quien te\npidió que la cautivaras y le dieras un corazón.”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0004",head="rin_z1i",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_003847",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No hay problema. Aunque, ahora acabo de recordar lo que me dijiste, lo de lo\nimportante que es mostrarle a los demás. Es difícil darle forma a las\ncreaciones, definitivamente.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="健一郎",size="z1",mode=3,path=":fg/ken/z1/",file="ken_z1b0000",face="b0006",head="ken_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_kid_001156",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Creo que crear una pintura en el aire ya no es cuestión de difícil o fácil...”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"text"},
text={
ja={
{
"Kenichiro-san mostró una sonrisa sarcástica.",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"text"},
text={
ja={
{
"Al ver la expresión en el rostro de Kenichiro-san, me di cuenta de lo mucho que\nél confiaba en esta muchacha.",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"bg",file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Después de ese día, Rin vino muchas otras veces a la casa a pintar cerezos en\nel aire.",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"text"},
text={
ja={
{
"A veces de felicidad, otras de diversión, y en algunas ocasiones de\nsentimientos horrendos. Habían incluso algunos días en los cuales no podía\ndarle forma.",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"text"},
text={
ja={
{
"Pero en todos los casos, Rin pintaba con alegría.",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"text"},
text={
ja={
{
"Ella sentía un gran amor por los sentimientos de las personas. Incluso por los\nmás terribles.",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"text"},
text={
ja={
{
"Para ella, tanto lo bello como lo horrendo era todo parte de este mundo, y era\npropio de pintar.",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"text"},
text={
ja={
{
"En algún momento, Kenichiro-san vio a Rin y dijo esto.",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="man_kid_001157",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“Si Dios realmente existe, entonces es probable que para él, tanto lo hermoso\ncomo lo horrendo de este mundo se debe amar por igual...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"text"},
text={
vo={
{"vo",file="man_kid_001158",ch="kid"},
},
ja={
{
name={"Kenichiro"},
"“El Señor está lleno de infinita gracia, y por eso mismo es cruel también...”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"text"},
text={
ja={
{
"Todavía no entiendo el significado de esas palabras.",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"ex",time=1000,func="wait"},
{"excall",file="03_andoe_04_3"},
{"text"},
linkback="block_00236",
},
label = {
top={block="block_00000",label=1},
},
}
