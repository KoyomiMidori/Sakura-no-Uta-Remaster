{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0000",face="h0015",head="aix_z1h",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1h0010",face="h0008",head="aix_z1h",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000377",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Podrían dejar de pelear tan temprano en un domingo? ¿Qué fue lo que sucedió?”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa, este idiota estaba atolondrado por el sueño y se metió en mi futón.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0011",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_aid_000378",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Y por eso te pusiste así de malhumorado?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, tenerlo enrollado en mi brazo es suficiente para ponerme así de malhumorado\ndesde temprano.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0013",head="aix_z1e",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="藍",size="z1",mode=3,path=":fg/aix/z1/",file="aix_z1e0000",face="e0015",head="aix_z1e",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_aid_000379",ch="aid"},
},
ja={
{
name={"Ai"},
"“¿Kei se enrolló alrededor tuyo?... Aunque bueno, hace poco también se te montó\nencima semidesnudo.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0700",face="a0008",head="kei_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000826",ch="ked"},
},
ja={
{
name={"Kei"},
"“Eso no es verdad. Solo que vino alguien no muy adecuado.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"fg",mode=-2,sync=0},
{"bg",x=420,y=-10,file="zbg004a",path=":bg/",ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0700",face="a0019",head="kei_z2a",lv=5,id=9,sync=0},
{"quake"},
{"quake",mode="mw"},
{"se",file="se3130",id=1},
{"extrans",time=200},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿ACASO NO FUISTE TÚ, IMBÉCIL? ESE SER TOTALMENTE INADECUADOOOO.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"se",id=1,file="se1194"},
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0700",face="a0020",head="kei_z2a",lv=5,id=9},
{"fgact",ch="圭",act="いいえ",loop=-1,time=400,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000827",ch="ked"},
},
ja={
{
name={"Kei"},
"“Duele... Eso duele... Naoya...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Tipos como tú, como tú, COMO TÚ--!”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"se",stop=1,time=500,id=1},
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bgm",file="bgm030"},
{"fg",mode=-2,sync=0},
{"bg",file="bg022a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"text"},
text={
ja={
{
"Después de un largo tiempo, regreso a mi apartamento.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oohh, hay bastante correo directo.”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
"El buzón que había dejado abandonado por 1 semana estaba ahora repleto de\npapeles inservibles.",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"bg",file="bg023a",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Pensé que llegarían algunas cartas con documentos relacionados a papá, pero\nsolo vinieron cosas insignificantes...",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jajaja...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuu... Al regresar después de tanto tiempo, me doy cuenta de lo poco que me\nrelaciono con los demás.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"Tantas relaciones que he tenido con los demás durante esta semana que he pasado\nen la casa Natsume me ha hecho darme de cuenta de eso en carne propia.",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Relaciones con otras personas, eh...”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien...”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"bgm",stop=1,time=10000},
{"se",id=1,file="gatya"},
{"bg",time=500,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Salgo del edificio, y camino en dirección contraria a la de siempre.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
"A la parte trasera del edificio.",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"bgm",stop=1,time=500},
{"text"},
text={
ja={
{
"Ese lugar es mi objetivo de hoy.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",style="sepia"},
{"bg",file="bg002a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"bgm",file="bgm019"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000128",ch="szd"},
},
ja={
{
name={"???"},
"“¿Vas a salir?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
"Al voltear, Shizuku estaba parada allí.",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
"A pesar de parecer tener la misma expresión de siempre, tenía algo ligeramente\ndistinto en ella, o algo así.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0012",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000129",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿A qué te refieres?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues parecieras estar algo diferente a como usualmente estás...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0310",face="a0001",head="shz_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
"Shizuku señala despacio con su dedo.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_szd_000131",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“El álbum...”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah...”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Shizuku señaló el álbum que tenía en mis manos.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ahh, ¿esto? Lo confundí con parte de mi equipaje necesario y lo metí sin\nquerer.”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En principio, no tenía intención de traerlo acá...”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0011",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000132",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Yo... conozco al propietario de ese álbum.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, me lo imagino.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0010",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000133",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y también sé que ella regresó.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, supongo que ya lo sabes.”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0011",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000134",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Naoya, tú...”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Shizuku trata de decir algo.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
"Pero permanece en silencio, sin decir nada más.",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000135",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Yo... soy feliz. Así que...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Así que?”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0011",head="shz_z1a",lv=4,id=6},
{"fgact",ch="雫",act="いいえ",size=5,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000136",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No. No es nada.”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku, ¿has sido feliz?”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0003",head="shz_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000137",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"excall",label="flagon01",cond="g.rinclear==1&&g.makclear==1&&g.rnaclear==1"},
{"excall",label="flagoff01"},
{"text"},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"select",label="label01",text="select"},
{"select",label="label02",exp="f.shz=f.shz+2",text="select"},
{"select",name="select01_06_1",mode="sys"},
{"text"},
select={
ja={
"Ya veo.",
"Si de verdad piensas que lo eres, me haces sentir alegre.",
{"rt2"},
},
},
labelcount=1,
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"excall",label="join1"},
{"text"},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si de verdad piensas que lo eres, y vives de esa manera, entonces me haces\nsentir alegre a mí también.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0018",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000138",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Obviamente que así lo pienso.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"excall",label="join1"},
{"text"},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0005",head="shz_z1b",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000139",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Odio a las personas que mencionan lo obvio.”",
{"rt2"},
},
},
},
labelcount=1,
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Supongo que sí.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0002",head="shz_z1b",lv=4,id=6},
{"fgact",ch="雫",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000140",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Shizuku ríe.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1d0300",face="d0003",head="shz_z1d",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_szd_000141",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Que te vaya bien.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"bgm",stop=1,time=500},
{"bg",file="black",path=":bg/"},
{"colortone",style="reset"},
{"text"},
text={
ja={
{
"Dentro de una gran extensión de tiempo, nos relacionamos con un gran número de\npersonas.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"No solo lo que está dentro del álbum es el pasado.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
"Hay varios pasados que no han sido registrados de ninguna manera, en ningún\nlugar.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
"Tanto Shizuku como yo sabemos muy bien eso.",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Así que――",
{"rt2"},
},
},
},
