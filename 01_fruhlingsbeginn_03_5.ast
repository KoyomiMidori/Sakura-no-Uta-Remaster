astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg040a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm023"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001036",ch="rnd"},
},
ja={
{
name={"???"},
"“... ¿Y... si... no?”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001627",ch="mkd"},
},
ja={
{
name={"???"},
"“... es... par... tanto...”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
"¿Oh?",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
"Me paro en medio de la colina de Yumenouki, envuelta en el bullicio de los\nestudiantes que van de regreso a sus casas. Me parece que acabo de escuchar\nunas voces familiares...",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"msgoff"},
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ustedes dos, ¿qué hacen acá?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001037",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Kusanagi-kun. Llegaste en buen momento, esto...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0013",head="mak_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001628",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uwah, llegaste en el peor momento...”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toritani, no trates a las personas como si fueran fantasmas o apariciones.\nRin, ¿qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0003",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001038",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Toritani-san me acaba de regresar mi pañuelo.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pañuelo? Ahh, el de ayer...”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0002",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
"Recuerdo cómo ayer Rin envolvió, con su pañuelo, las manos lastimadas de\nToritani después de haber hecho ese nekodamashi tan fuerte.",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001039",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"El pañuelo que Rin me mostró no solo había sido lavado, sino también planchado.",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Lo planchaste también?... Qué formal y seria eres, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0008",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001629",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Formal y seria? ¿Acaso no es lo natural hacer esto?”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0004",head="rin_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001040",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Y además, me dio también unas golosinas muy lindas.”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0001",head="mak_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jojo, golosinas, eh.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0012",head="rin_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001041",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Esto, Kusanagi-kun, ¿te gustan las golosinas dulces?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, diría que sí me gustan.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0002",head="rin_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001042",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ya veo, me lo imaginé.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Hay algún problema?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0012",head="rin_z1b",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001043",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no, no, en lo que respecta a eso no hay ningún problema, pero...”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0002",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001630",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ah~, ya va a comenzar mi turno del trabajo, así que me voy ya!”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0013",head="rin_z1b",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001044",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡E-Espera un momento, por favor!”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"se",file="se9004",id=1},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0001",head="mak_z1d",x=345,lv=4,id=6},
{"fg",ch="真琴",speed=700,mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0001",head="mak_z1d",x2=345,x=445,lv=4,id=6},
{"text"},
delay={
[300]={
{"se",stop=1,time=500,id=1},
{"fg",ch="稟",speed=200,mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0013",head="rin_z1b",x2="-345,-45",x=-145,lv=4,id=5},
},
[350]={
{"se",file="se9010",id=2},
{"fg",ch="真琴",speed=200,mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0001",head="mak_z1d",x2=445,x=345,lv=4,id=6},
},
},
text={
ja={
{
"Toritani trató de comenzar a caminar con pasos rápidos, pero Rin agarró el\nborde de su uniforme y la detuvo.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="稟",speed=500,mode=3,path=":fg/rin/z1/",file="rin_z1b0200",face="b0013",head="rin_z1b",x2=-145,x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y bien? ¿Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001045",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, esto, Toritani-san dijo que ya había una cantidad suficiente de miembros\npara el club de arte, así que a partir de hoy volvería a comenzar de nuevo su\ntrabajo de medio tiempo...”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0210",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001046",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Parece que hoy se repartirán muestras de una nueva mezcla de café en la entrada\nde la tienda.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0008",head="mak_z1d",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0011",head="mak_z1d",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001631",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El maestro terminó su nueva mezcla y nos envió un gran cargamento. Es bastante\nbuena, y además no podemos dejarlo para otro día.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0010",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0200",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001047",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero parece que las manos de Toritani-san no están completamente bien aún, y\ncuando le propuse ayudarla, me dijo que no era necesario.”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, Toritani, deja que te ayuden. ¿Cuál es el problema?”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0012",head="mak_z1b",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0011",head="mak_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_mkd_001632",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No puedo permitir que Rin-chan haga eso por mí cuando apenas la conocí ayer!\n¡Solo eso!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Cuál es el problema? La misma Rin está diciendo que te ayudará.”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"fg",mode=-2},
{"fg",ch="優美",size="z1",mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1a0220",face="a0009",head="yum_z1a",x=-345,lv=4,id=5},
{"fg",ch="里奈",size="z1",mode=3,resize=1,path=":fg/rna/z1/",file="rna_z1d0200",face="d0002",head="rna_z1d",x=345,lv=4,id=6},
{"fgact",ch="優美",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000793",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Así es, qué fría eres, dejándonos por fuera.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1a0200",face="a0016",head="rna_z1a",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="うんうん",time=250,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000065",ch="rna"},
},
ja={
{
name={"Rina"},
"“Así es, así es.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001633",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿U-Ustedes también?! P-Por qué...”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0016",head="yum_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000794",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Senpais, llaman demasiado la atención. Quisimos saber qué era lo que estaba\npasando y nos acercamos.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0200",face="b0003",head="rna_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000066",ch="rna"},
},
ja={
{
name={"Rina"},
"“Nosotras también te ayudaremos.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
vo={
{"vo",file="fem_mkd_001634",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Escuchen algo...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0015",head="yum_z1a",x=-345,lv=4,id=5},
{"fgact",ch="優美",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0016",head="yum_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_yum_000795",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Al final, no pudimos hacer nada en el club hoy por el asunto de Akashi- senpai,\ny además, el uniforme de Quimera es bastante lindo.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="里奈",size="z1",mode=3,path=":fg/rna/z1/",file="rna_z1b0210",face="b0012",head="rna_z1b",x=345,lv=4,id=6},
{"fgact",ch="里奈",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rna_000067",ch="rna"},
},
ja={
{
name={"Rina"},
"“Ah, no sabía eso.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0200",face="b0016",head="yum_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_yum_000796",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Seguramente te quedará muyyyyy bien, Rina.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"fgact",ch="圭",act="icon",lv=4,id=9,icon="icon15z1",x=40,y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_001018",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Eh, qué pasa, qué pasa? ¿Qué hacen todos reunidos aquí?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"text"},
text={
vo={
{"vo",file="fem_yum_000797",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Acaba de aparecer otra persona a quien también le queda muy bien el uniforme de\nQuimera. Esto es una oportunidad de oro... o no, una oportunidad celestial.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, deja que te ayuden. Será una sesión de labor social por parte de los\nmiembros del club de arte.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fgact",ch="圭",act="停止",lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0008",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",lv=4,id=9},
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0002",head="kei_z1a",x2=0,x=345,lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0010",head="mak_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001635",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No puedo permitir eso. Está bien, no me queda otra opción... Les pagaré por su\ntrabajo. Pero todo el dinero del pago será destinado a cubrir el presupuesto\ndel club. ¿Aun así están de acuerdo?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001048",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No me importa en lo absoluto.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
vo={
{"vo",file="fem_rna_000068",ch="rna"},
},
ja={
{
name={"Rina"},
"“Sí, me esforzaré bastante.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"text"},
text={
vo={
{"vo",file="fem_yum_000798",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Yo tampoco tengo problema.”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0011",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001636",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por Dios...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
"Después de soltar un suspiro algo exasperado, Toritani nos señaló firmemente\ncon su dedo a todos.",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0005",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001637",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Los pondré a trabajar a todos como esclavos. Puede que incluso terminen\narrepintiéndose de haber aceptado hacerlo de manera tan ligera. ¡Prepárense!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0004",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001638",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Ahh, Kei. Tú también llevarás uniforme de maid.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0012",head="kei_z1a",x=345,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"fgact",ch="圭",act="icon",lv=4,id=9,icon="icon18z1",x=-150,y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_001019",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaan! ¡¿Qué significa esto?! ¡¡No volveré a ponerme un uniforme de maid más\nnunca!!”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"mwact",act="うんうん"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001049",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajaja, no hay problema. Te quedaba bastante bien. Tanto así que llegué a\nconfundirte con tu hermanita.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0023",head="kei_z1a",x=345,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0008",head="kei_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001020",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Ese no es el problema! ¡Naoya, tú también di algo!”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ríndete.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0023",head="kei_z1a",x=345,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001021",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¡¡¿Qué estás diciendo~?!!!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="圭",mode=-1,lv=4,id=9},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0006",head="mak_z1b",x=-345,lv=4,id=5},
{"fg",ch="真琴",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0006",head="mak_z1b",x2=-345,x=0,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"se",file="se9031",id=1},
},
},
text={
vo={
{"vo",file="fem_mkd_001639",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si estamos listos entonces vámonos ya. ¡Bien, hoy vamos a hacer bastante\ndinero! ¡Kusanagi, detente ahí! ¡No trates de huir discretamente!”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"... Me descubrieron.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"bg",file="eveningsky_winter",id=9,lv=9,rule=139,sync=1,vague=40,path=":cg/"},
{"text"},
text={
vo={
{"vo",file="fem_rna_000069",ch="rna"},
},
ja={
{
name={"Rina"},
"“Les invitamos a que tomen una muestra de nuestro nuevo café.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
vo={
{"vo",file="fem_yum_000799",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Tenemos muestras de golosinas también por si les apetece.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg031a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0002",head="mak_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0002",head="rin_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"bgm",file="bgm006"},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001050",ch="rnd"},
},
ja={
{
name={"Rin"},
"“El local está totalmente repleto hoy.”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
"Por lo general el local está siempre en silencio, pero hoy está repleto de\nclientes.",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. No creo que Toritani y las otras personas de la tienda hubieran podido\natenderlos a todos por su cuenta.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0004",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001640",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Gracias a las muchachas anunciando y atrayendo clientes en la entrada, y a\nRin-chan y Kei, pudimos reunir 3 veces la cantidad de clientes que\nesperábamos. Menos mal que trajimos bastante mercancía e ingredientes hoy.”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"se",id=1,file="se2225"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"extrans",time=500},
{"fg",ch="霧乃",size="z1",sync=1,mx=40,mode=3,resize=1,path=":fg/kir/z1/",file="kir_z1a0000",face="a0007",head="kir_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="霧乃",size="z1",mode=3,path=":fg/kir/z1/",file="kir_z1a0000",face="a0008",head="kir_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_krd_000001",ch="krd"},
},
ja={
{
name={"Cliente A"},
"“Vaya, parece que hoy estás bastante ocupada, ¿no? Sí es por eso, puedo venir\notro día...”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0900",face="b0002",head="mak_z1b",x=-345,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0910",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001641",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No hay problema. Tome asiento acá, por favor.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
vo={
{"vo",file="man_jrb_000001",ch="jrb"},
},
ja={
{
name={"Cliente A"},
"“Disculpen~, ¿puedo pedir ya?”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001051",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Por supuesto, ahora mismo voy.”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0002",head="kei_z1c",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001022",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Disculpe la tardanza! ¡Una orden de panqueques y blend!”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
vo={
{"vo",file="fem_jrc_000001",ch="jrc"},
},
ja={
{
name={"Cliente C"},
"“Wah, esa muchacha es bastante linda, ¿no crees?”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
vo={
{"vo",file="fem_jrd_000001",ch="jrd"},
},
ja={
{
name={"Cliente D"},
"“De verdad que sí~ Es toda una hermosura.”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0019",head="kei_z1c",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001023",ch="ked"},
},
ja={
{
name={"Kei"},
"“*gusun*, yo no soy ninguna muchacha.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"fg",mode=-2},
{"text"},
text={
ja={
{
"Mientras observaba cómo Toritani, Rin y Kei, todos vestidos de maid, trabajaban\nde manera ajetreada en la tienda, yo me encargaba de limpiar las mesas y de\natender la caja.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
vo={
{"vo",file="fem_bit_000001",ch="bit"},
},
ja={
{
name={"Muchacha"},
"“Un set de macarrones Sakura y un New Blend, junto con un ramen sobre piedra y\nun café helado. Aquí tienen.”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
"¿Un ramen cocinado sobre piedra? Como siempre, bien raros los platillos del\nmenú de Quimera, eh...",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0024",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0002",head="kei_z1c",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_001642",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“El ramen sobre piedra es para esta mesa... ah, yo lo llevo. Kei, ¿puedes\nencargarte de esos macarrones Sakura?”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0003",head="kei_z1c",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0016",head="kei_z1c",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001024",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Yo tengo bastante fuerza, así que yo llevaré el ramen sobre piedra! Toritani,\naún tienes herida la mano, no te esfuerces tanto.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0013",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001643",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Ah, espera, Kei! ¡Es bastante difícil sostener con equilibrio eso!”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0003",head="kei_z1c",x=345,lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0013",head="kei_z1c",x=345,lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_001025",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No hay problema! Yo me... Eh, uwah... ¡Totototo!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"Aún después de haber dicho todo eso, Kei comienza a perder el equilibrio.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eh, Kei!”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0013",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001644",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Cuidado!”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"Justo en ese instante, cuando creímos que ese pesado ramen sobre piedra y el\ncafé helado se habían resbalado de la bandeja de Kei y caído al suelo――",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"fg",ch="真琴",mx=-1280,mode=-1,lv=4,id=5},
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0013",head="kei_z1c",x2=345,x=-345,lv=4,id=9},
{"fg",ch="稟",size="z1",mx=1280,mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0005",head="rin_z1a",x=345,lv=4,id=10},
{"fg",ch="稟",speed=200,mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0005",head="rin_z1a",y2="0,50",x=345,y=0,lv=4,id=10},
{"se",file="se9032",id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001052",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Fuh...!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Rin, quien estaba a su lado, atrapó de manera espectacular el plato y la bebida\ncon su propia bandeja.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
vo={
{"vo",file="man_jrb_000002",ch="jrb"},
},
ja={
{
name={"Cliente B"},
"“Ohh...”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
vo={
{"vo",file="man_jre_000001",ch="jre"},
},
ja={
{
name={"Cliente C"},
"“¡Esa maid es increíble!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"se",file="se9034",id=1},
{"text"},
text={
ja={
{
"Inesperadamente, todos a nuestro alrededor reventaron en aplausos.",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0900",face="a0002",head="rin_z1a",x=345,lv=4,id=10},
{"text"},
text={
ja={
{
"Después de sonreír avergonzada a los clientes aplaudiendo, Rin se dirigió a la\nmesa donde estaba el cliente de esa orden.",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Yo también me quedé asombrado. Increíble... Es imposible hacer eso con los\nreflejos y habilidades motrices de una persona normal.",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0010",head="kei_z1c",x=-345,lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001026",ch="ked"},
},
ja={
{
name={"Kei"},
"“M-Me asusté...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
"Toritani le extiende su mano a Kei, quien había caído sentado sobre el suelo.",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="稟",mode=-1,lv=4,id=10},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0025",head="mak_z1a",x=345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001645",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por eso te lo dije, hay un cierto truco para cargar eso.”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0011",head="kei_z1c",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_001027",ch="ked"},
},
ja={
{
name={"Kei"},
"“Makoto, tienes la mano herida, no puedes llevar esa clase de cosas pesadas...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
"Kei se levantó por su cuenta, sin tomar la mano de Toritani. Toritani sabe que\nKei lo hizo considerando el estado de su mano, así que no se molestó por\nello.",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0910",face="a0016",head="mak_z1a",x=345,lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001646",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tienes razón, gracias.”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1c0000",face="c0002",head="kei_z1c",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_jrb_000003",ch="jrb"},
},
ja={
{
name={"Cliente B"},
"“Disculpa, ¿podrías darme lo mismo de siempre?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0900",face="a0003",head="mak_z1a",x=345,lv=4,id=10},
{"fgact",ch="真琴",act="びっくり",lv=4,id=10},
{"text"},
text={
vo={
{"vo",file="fem_mkd_001647",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Claro! En breve se lo preparo.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Parece que seguiremos así de ocupados hasta la hora del cierre.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
