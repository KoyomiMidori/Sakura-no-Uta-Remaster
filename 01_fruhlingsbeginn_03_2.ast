astver = 2.0
astname = "ast"
ast = {
block_00000={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0009",head="kei_z1a",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"bgm",file="bgm007"},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000686",ch="ked"},
},
ja={
{
name={"Kei"},
"“Fuu, llegué a tiempo.”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Se te dañó el reloj o es que no has visto la hora?... Después de esto viene la\ntercera clase del día.”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0011",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000687",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Pero, pero! ¡Es que no me despertaste, Naoya!”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Te desperté! ¡Te levanté y te di el desayuno! ¡Fuiste tú el que dijo 'Ah, iré\na buscar algo que olvidé' y se desapareció en su habitación para más nunca\nvolver!”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0008",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0019",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000688",ch="ked"},
},
ja={
{
name={"Kei"},
"“Es que... hoy me levantaste más temprano de lo usual. Y cuando regresé a la\nhabitación aún quedaba bastante tiempo.”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me dieron ganas de levantarte de nuevo.”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0018",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="icon",lv=4,id=9,icon="icon04z1",x=25,y=-525},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000689",ch="ked"},
},
ja={
{
name={"Kei"},
"“Uhh... Naoya, eres tan hábil hablando que siento que me estás convenciendo. No\nsé por qué, pero siento que estás ganándome con tus argumentos.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Claro que no! Eres tú el que hizo algo completamente incorrecto, y simplemente\nno encuentras que decir ahora.”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="圭",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0005",head="kei_z1a",x2=0,x=345,lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000582",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vamos, qué importa. Deja que pase un año más acá como Akashi-senpai.”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué? ¿Eso quiere decir que ya es un hecho que va a repetir el año?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0015",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000583",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, son altas las posibilidades. Si no aprueba los próximos exámenes\nsuplementarios entonces parece que sí repetirá de año definitivamente.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"text"},
text={
ja={
{
"Por ahora, aún no ha sido decidido...",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
"Será horriblemente desagradable tener a ese hombre otro año más en el colegio.",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0001",head="mak_z1a",x=-345,lv=4,id=5},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",x=345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000690",ch="ked"},
},
ja={
{
name={"Kei"},
"“Pero había escuchado que está encerrado estudiando.”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0009",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000584",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues, más que estar encerrado, parece que su familia lo tiene encerrado. A mi\ntambién me pidieron el favor de, que si se escapaba y lo veía afuera jugando\ny perdiendo el tiempo, los contactara inmediatamente...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, así que no eras tú quien lo tenía encerrado.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0002",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000585",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. Apenas lo veo perdiendo el tiempo en el colegio o en la ciudad, lo\namarro, lo torturo y luego espero a que su familia lo venga a buscar. Algo\nasí, supongo.”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No dijiste algo raro entre la parte de 'amarrar' y 'que su familia lo venga a\nbuscar'?”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0004",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000586",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Lo de la tortura? Ahh, pues, qué puedo decir. Ajaja.”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Das miedo diciendo eso con esa sonrisa.”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0016",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000587",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es tampoco algo tan exagerado como una tortura de verdad. Aunque, si la ley\nme lo permitiera quisiera castrarlo, por lo menos.”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Castrarlo?... ¿Qué demonios hizo?”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0029",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000588",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí, se podría decir que fue un acto de maldad que a nadie con sentido\ncomún se le podría ocurrir. En fin, tengo que dar con la razón aún.”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Razón, eh. ¿Es que acaso habrá razón alguna en sus acciones?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0016",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000589",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pues sí. ¿Es que acaso no está en el mismo nivel que tú? A simple vista, los\ndos hacen únicamente cosas disparatadas y sin sentido.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Esa manera de hablar de mí deja algo que desear, eh.”",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000590",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque, siempre que se escapa de su casa es detectado rápidamente por mi red de\ninformación.”",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",x=345,lv=4,id=9},
{"fgact",ch="圭",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0008",head="kei_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000691",ch="ked"},
},
ja={
{
name={"Kei"},
"“Sin duda alguna, la red de información de Makoto no se puede subestimar. En mi\ncaso también me atrapan rápidamente cada vez que trato de huir de las\nactividades para atraer a nuevos integrantes del club.”",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
"Eso es simplemente porque eres un tonto...",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0017",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000591",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Si no quieres terminar como Akashi-senpai entonces asiste a clases.”",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0007",head="kei_z1a",x=345,lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",x=345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000692",ch="ked"},
},
ja={
{
name={"Kei"},
"“E-Está bien. ¡A partir de mañana me esforzaré más!”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"se",id=1,file="se1895"},
{"text"},
text={
ja={
{
"Las clases de la mañana terminan sin inconveniente alguno.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Al agarrar mi obentou, me dirijo a la sala de arte a comer.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",rule=139,vague=40},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Hoy pude preparar mi propio obentou...”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
"Preparé uno para mí, y para Ai, y también para Shizuku.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"text"},
text={
ja={
{
"Pero...",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0001",head="kei_z1a",lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0023",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000693",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Por qué mi obentou es el único que falta? ¿Estás tratando de hacerme bullying?”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah~, es que estuviste todo el tiempo dormido, eh. Me olvidé por completo de tu\nexistencia.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0012",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="icon",lv=4,id=9,icon="icon05z1",x=40,y=-550},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000694",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No te olvides de la existencia de los demás solo porque se queden dormidos!”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué escandaloso, eh. Si sigues diciendo eso, me comeré todo lo que hay acá. Por\nalguna misteriosa razón hay 2 obentou adentro.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al decir eso, le muestro las dos cajas de obentou envueltas dentro del mantel a\nKei.",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="icon",lv=4,id=9,icon="icon15z1",x=40,y=-550},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000695",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Yo sabía que tú eras amable! ¡Naoya! ¡Preparaste mi parte también, ¿verdad?!”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fgact",ch="圭",act="停止",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escuchaste mal, simplemente preparé dos. Nunca dije que había preparado tu\nparte.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"fg",mode=-2},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0022",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000592",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Entonces dámelo a mí.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no me importa.”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000696",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Debería importarte!”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Toma.”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0012",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000593",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Saqué otro contenedor de obentou aún más pequeño de mi mochila.",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0008",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000594",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Q-Qué es esto?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me sobraron algunos ingredientes~, así que preparé otro más. Lo hice por si me\ndaba algo de hambre en la tarde, así que es pequeño.”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000595",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Pequeño?...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
ja={
{
"Era una caja de obentou pequeña, como la que cualquier chica llevaría consigo.\nAyer la compré en una tienda de 100 yenes después de cenar.",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0005",head="mak_z1a",lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000596",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y-Ya te dije que no pienso tener ninguna deuda con--”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fuiste tú la que me pidió que te diera, ¿no? Acéptalo.”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0011",head="mak_z1a",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000597",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Ugh.”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="ジャンプ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000697",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Dame a mí también!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No quiero.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0023",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000698",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡¿Por qué?! ¡A como iban las cosas se supone que me tenías que dar la otra\ncaja!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya dije que esa caja la tenía por si me daba hambre en la tarde. Si me quedo\nsin esta no tendré nada que comer después de clases.”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0023",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000699",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Piensa un momento en lo que pasará conmigo en la tarde con lo hambriento que\nestoy ahora!”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... ¿Terminarás seco y flaco como una momia?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0022",head="kei_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0006",head="kei_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000700",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡No terminaré así! ¡¿Por qué debería convertirme en una momia de repente?! ¡Con\nuna sola comida que me salte no terminaré así!”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entonces no hay problema, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0023",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0012",head="kei_z1a",lv=4,id=9},
{"fgact",ch="圭",act="いいえ",loop=-1,size=10,time=300,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_ked_000701",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Uwaan, qué malo eres! ¡Sí me convertiré! ¡Me convertiré en una momia, así que\ndame!”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que sí te convertirás en una. Creo que tengo ganas de ver entonces... De\nver cómo un humano se convierte en una momia.”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"fgact",ch="圭",act="停止",lv=4,id=9},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_ked_000702",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Es que acaso eres un demonio?”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"bg",time=500,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"Realmente no quería hacerlo, pero decidí darle el otro obentou a Kei.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Estaba siendo bastante terco, y también porque...",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg049a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"bg",file="reco",id=9,lv=9,path=":sys/",sync=0},
{"extrans",time=1000},
{"fg",ch="圭",size="z2",mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0003",head="kei_z2a",lv=5,id=9},
{"se",file="se9031",id=1},
{"fgact",ch="圭",act="icon",lv=5,id=9,icon="icon15z2",x=80,y=-550},
{"fgact",ch="圭",act="びっくり",sync=1,lv=5,id=9},
{"text"},
delay={
[1000]={
{"fg",ch="圭",speed=500,mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0003",head="kei_z2a",x2="0,-1500,1500,-1500",x=0,lv=5,id=9},
{"se",file="se9003",id=1},
},
[1500]={
{"se",file="se9003",id=1},
},
[2000]={
{"se",file="se9003",id=1},
},
[2500]={
{"se",file="se9003",id=1},
},
},
text={
ja={
{
"Cuando le ordené que diera tres vueltas y ladrara 'Guau guau', obedeció todas\nmis órdenes con alegría y lágrimas en los ojos...",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"cgdel",id=-1},
{"bg",time=500,file="black",path=":bg/"},
{"text"},
text={
ja={
{
"En fin, comimos el almuerzo en la sala de arte junto a Rin, quien se unió\ndespués.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Rin vio con ojos de envidia la comida que preparé, aunque el obentou de ella\nparecía ser mucho más delicioso... Lo llevaba en una impresionante caja\nplegable de dos pisos.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"bgm",stop=1,time=1000},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg048i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0001",head="mak_z1a",x=-345,lv=4,id=5,sync=0},
{"extrans",time=1000},
{"fg",ch="優美",size="z1",mx=40,mode=3,resize=1,path=":fg/yum/z1/",file="yum_z1b0210",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"se",file="se1279",id=1},
{"bgm",file="bgm007"},
{"text"},
text={
vo={
{"vo",file="fem_yum_000054",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Algo terrible ha sucedido... Toritani-senpai.”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Sin lucir con mucha gravedad en su aspecto, Yuumi Kawachino entró después de\nclases al salón de tercer año.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0012",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000598",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué sucedió?”",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0005",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0200",face="b0005",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000055",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“El hombre de esta foto estuvo merodeando por el colegio, así que vine a\nreportarme, Toritani-senpai.”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0006",head="mak_z1b",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="ジャンプ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0005",head="mak_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000599",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡¿Qué dices?!! V-Vaya que le encanta moverse por ahí y subestimarme, eh...”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fgact",ch="真琴",act="うなづく",size=20,lv=4,id=5},
{"se",file="se1780",id=1},
{"text"},
text={
ja={
{
"Toritani golpea el escritorio y alza la voz. Parece que está de bastante mal\nhumor, pero... ¿qué fue lo que hizo de verdad ahora?",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dejando eso de lado, Kawachino, ¿por qué llevas una foto de Akashi contigo?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0016",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0005",head="yum_z1b",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_yum_000056",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Se trata del maestro de Kusanagi-acosador-senpai, en pocas palabras, el\nsuper-acosador-senpai, así que se distribuyeron sus fotos a los nuevos\nintegrantes del club para levantar un llamado de precaución.”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Akashi no es mi maestro, ni yo soy ningún acosador-senpai!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0008",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0005",head="mak_z1b",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0006",head="mak_z1b",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000600",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sería un peligro que se encontraran a Akashi en la sala de arte mientras no\nestoy, ¿no crees? Por eso es que les repartí fotos de él a todas. Al estilo\nde '¡En caso de ver a este tipo, huye rápidamente y repórtate!'.”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo. Pero se supone que no debería venir, ¿no? Según escuché, debería estar\nen su casa estudiando para los exámenes de recuperación.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0200",face="a0017",head="mak_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0025",head="mak_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0029",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000601",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es... Si se hubiera quedado encerrado en casa tranquilito no tendría que\nsufrir tanto ahora. Qué pena, qué lamentable, parece que ahora sí tengo una\nrazón válida para torturar a Akashi-senpai. Fufufu...”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Espera, esa no es razón para torturarlo.”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0005",head="mak_z1a",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0210",face="a0006",head="mak_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000602",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Lo es, recibí autorización de su familia para hacerlo! ¡Además, ese hombre no\naprende a menos que se le lleve hasta el borde de la muerte!”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"¿Recibió autorización de su familia para eso?... ¿De esa manera lo tratan sus\npadres?",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0006",head="mak_z1d",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="びっくり",lv=4,id=5},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1b0210",face="b0001",head="yum_z1b",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000603",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Y bien, Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah~, lo sé. Vas a pedirme que nos separemos y lo busquemos, ¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0005",head="mak_z1d",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000604",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No, quédate en la sala de arte haciendo guardia. Hay la posibilidad de que\nsenpai regrese allí.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"fg",ch="優美",mode=-1,lv=4,id=6},
{"fg",ch="圭",size="z1",mode=3,resize=1,path=":fg/kei/z1/",file="kei_z1a0200",face="a0011",head="kei_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000703",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ciertamente son altas las posibilidades de que regrese a la sala de arte.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0210",face="d0006",head="mak_z1d",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0200",face="d0005",head="mak_z1d",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_mkd_000605",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Kei y yo iremos a capturar a Akashi-senpai. Si llegamos a atraparlo lo\nescoltaremos hasta la sala de arte, así que quédate allí hasta entonces.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo, está bien.”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0002",head="mak_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000606",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y aparte de eso, prosigue con las lecciones para Rin-chan, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Está bien.”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"fg",ch="圭",mode=-1,lv=4,id=6},
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0001",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, Kawachino, ¿vamos?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0220",face="a0017",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000057",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“¿A dónde vamos?”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues tú también vas a la sala de arte, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"fg",ch="優美",size="z1",mode=3,path=":fg/yum/z1/",file="yum_z1a0200",face="a0005",head="yum_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_yum_000058",ch="yum"},
},
ja={
{
name={"Yuumi"},
"“Respecto a eso, tengo algo que hacer antes, así que iré en un rato.”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya veo.”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0200",face="b0003",head="mak_z1b",x=-345,lv=4,id=5},
{"fgact",ch="真琴",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_000607",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Así es. En fin, te encargo con la sala de arte por ahora.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Entendido.”",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Ciertamente, no estaría muy bien que Akashi y Rin llegaran a encontrarse solos\nde repente. Por eso lo mejor es que yo me quede en la sala de arte.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"se",file="se9012",id=1},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"bg",rule="083r",vague=40,file="bg043e",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
"Toritani estaba mucho más enojada de lo usual. Akashi debe haber embarrado las\ncosas terriblemente esta vez.",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eso es porque Akashi es, básicamente, un idiota, eh...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
"Podría hacer las cosas mucho mejor, pero siempre se le sale lo torpe en algún\nmomento.",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"bg",file="bg047i",path=":bg/",ax=960,ay=563,bx=0,by=-23},
{"bgm",stop=1,time=500},
{"text"},
text={
vo={
{"vo",file="man_tkd_000001",ch="tkd"},
},
ja={
{
name={"???"},
"“Ah, tiempo sin vernos, Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Oh, tiempo sin verte.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"bgm",file="bgm030"},
{"fg",ch="琢磨",size="z1",mode=3,resize=1,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0001",head="tkm_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
"Un delgado y apuesto joven me habla.",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
ja={
{
"Su nombre es Takuma Hirose.",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tiene las mejores calificaciones del colegio, es apuesto, es bueno en todo tipo\nde deportes, también es amable y gentil, y es bastante depravado.”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"fg",ch="琢磨",size="z1",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0012",head="tkm_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tkd_000002",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“¿Por qué soy bastante depravado?”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento, se me escapó sin querer.”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"fg",ch="琢磨",size="z1",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0006",head="tkm_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tkd_000003",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“Ese no es el problema, sino la razón por la cual se supone que soy bastante\ndepravado.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ya tienes excelentes calificaciones, y también eres bastante serio y\nresponsable. Sería grave que una persona así no fuera bastante depravada,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="琢磨",size="z1",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0013",head="tkm_z1a",lv=4,id=9},
{"fgact",ch="琢磨",act="おじぎ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="琢磨",size="z1",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0008",head="tkm_z1a",lv=4,id=9},
},
vl02={
{"fg",ch="琢磨",size="z1",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0010",head="tkm_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_tkd_000004",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“¿Por qué sería grave eso? Y, de ser posible, ¿podrías por lo menos llamarme\nsimplemente 'depravado'?... Eso de 'bastante depravado' suena como si yo\nfuera un depravado sin salvación alguna, y la verdad que no me agrada mucho\ncómo suena eso.”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
"¿Es ese para ti el problema, Hirose?",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
"Bueh, si Hirose está de acuerdo con eso, supongo que está bien...",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dejando eso de lado, ¿te vas ya a tu club?”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="琢磨",size="z1",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0003",head="tkm_z1a",lv=4,id=9},
{"fgact",ch="琢磨",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_tkd_000005",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“Sí, planeo asistir al club de astronomía ahora mismo.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"bgm",stop=1,time=300},
{"text"},
text={
vo={
{"vo",file="man_wtd_000053",ch="wtd"},
},
ja={
{
name={"???"},
"“¡Esa es una excelente idea! ¡A mí también me encantaría darles una visita!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,resize=1,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",lv=4,id=9},
{"bgm",file="bgm008"},
{"text"},
text={
vo={
{"vo",file="man_tkd_000006",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, Akashi. ¿Por qué estás acá?...”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000054",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Cómo que Akashi? Es Akashi-senpai-sama, ¿no? Debí haberte enseñado ya una y\notra vez que debes darle más respeto a tu senpai de la vida.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no sé cómo sea el rollo con la vida, pero somos del mismo año, ¿no?\nPorque estás repitiendo.”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"fg",ch="明石",size="z1",ex02="b0098",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0008",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0002",head="aka_z1b",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000055",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fuh, nada sorprendente de estas masas idiotizadas, siempre cayendo en las redes\nde desinformatzia. Yo no he repetido ningún año.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000056",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Yo solo retrasé un poco mi graduación! ¿Sabes por qué, Hirose?”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"fg",ch="明石",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x2=0,x=-345,lv=4,id=9},
{"fg",ch="琢磨",size="z1",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0013",head="tkm_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_tkd_000007",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“¿Eh? ¿M-Me lo preguntas a mí?”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque eres un idiota, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="明石",size="z1",ex04="a0096",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0004",head="aka_z1a",x=-345,lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",x=-345,lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000057",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Ehh! ¡No estoy preguntándote a ti! Estoy preguntándole al más grande talento\nque ha pasado por los pasillos de Yumihari desde su fundación, a Takuma\nHirose.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"fg",ch="琢磨",size="z1",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0022",head="tkm_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_tkd_000008",ch="tkd"},
},
ja={
{
name={"Takuma"},
"“P-Por qué será... ¿eh?”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000058",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Has escuchado eso, Kusanagi? ¡Incluso un genio de la talla de Hirose no puede\ndar con el por qué!”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000059",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡De ser así, ¿por qué alguien de tu diminuta magnitud debería saberlo\nentonces?!”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Porque tus calificaciones están por el suelo.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="明石",size="z1",ex02="b0098",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0008",head="aka_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000060",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fuh, ¿es que acaso no te cabe en la cabeza lo totalmente descabellado que es\nque alguien que forma parte de las masas idiotizadas como tú entienda algo\nque un hombre de la talla de Hirose no puede? Mientras más precipitadas las\nrespuestas más alejadas están de la verdad.”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ah? ¿Entonces por qué no te has graduado aún?”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0003",head="aka_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000061",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Fuh, tal vez quería ver un poco más...”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ver qué?”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0001",head="aka_z1b",x=-345,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000062",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“El futuro de este colegio...”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Preocúpate más por tu propio futuro.”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
"A pesar de que Toritani estaba buscándolo frenéticamente, diciendo que lo iba a\ndejar medio muerto...",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1b0000",face="b0004",head="aka_z1b",x=-345,lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x=-345,lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000063",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“En fin, eso no va al caso. ¡Cállate de una buena vez, masa idiotizada! ¡Bien,\nHirose! ¡Te acompañaré al club de astronomía!”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"bgm",stop=1,time=300},
{"text"},
text={
vo={
{"vo",file="man_ked_000704",ch="ked"},
},
ja={
{
name={"???"},
"“¡Esa es buena idea, eh!”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",mode=-2},
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0003",head="kei_z1a",lv=4,id=6},
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, pero tú... ¿Por qué rayos también estás acá?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0017",head="kei_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000705",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Mm? ¿Por qué lo dices?”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No se supone que irías a buscar junto a Toritani?”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"fg",ch="圭",size="z1",mode=3,path=":fg/kei/z1/",file="kei_z1a0200",face="a0013",head="kei_z1a",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="man_ked_000706",ch="ked"},
},
ja={
{
name={"Kei"},
"“Ah~, parece que la captura se hará por separado.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"text"},
text={
ja={
{
name={"Naoya"},
"“La captura... por separado, eh.”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
"Observo la cara de Akashi.",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"fg",mode=-2},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0008",head="aka_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000064",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Captura? ¿Es que hay alguna presa grande por ahí?”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah~, parece que hay un idiota por ahí que ha estado cometiendo fechorías.\nToritani anda desesperada tratando de capturar a ese idiota.”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0005",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="man_wtd_000065",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“Ah~, los idiotas son de lo peor. Siempre hacen cosas innecesarias. Las\nestadísticas dicen que el 90 % de los criminales son idiotas, nya~”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
vo={
{"vo",file="man_ked_000707",ch="ked"},
},
ja={
{
name={"Kei"},
"“Los idiotas son idiotas, y por eso no distinguen entre el bien y el mal. Así\nes, así es.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
"Es tanta la idiotez que desprenden estos dos que al hablar con ellos, mi cabeza\ntambién termina dando vueltas en el proceso...",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"mwact",act="びっくり"},
{"text"},
text={
vo={
{"vo",file="man_ked_000708",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Mm? ¡A-Ahh! ¡Pero si es Akashi-senpai!”",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Te acabas de dar cuenta ahora?...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0009",head="aka_z1a",lv=4,id=9},
{"fgact",ch="明石",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="man_wtd_000066",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¿Qué sucede, Kei? ¿Por qué el asombro?”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
vo={
{"vo",file="man_ked_000709",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡A-Akashi-senpai, e-escucha!”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"se",id=1,file="se0002_z"},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="man_ked_000710",ch="ked"},
},
ja={
{
name={"Kei"},
"“¡Auch! ¡¿Por qué me lanzas un golpe de karate?! ¡Naoya!”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"bg",y=-230,speed=300,sync=0,file="zbg047a",path=":bg/",x2=-760,y2=-230,x=-960,ax=1920,ay=1126,bx=-960,by=-586},
{"fg",ch="圭",size="z2",speed=300,sync=0,mode=3,resize=1,path=":fg/kei/z2/",file="kei_z2a0200",face="a0015",head="kei_z2a",x2=200,x=0,lv=5,id=6},
{"text"},
text={
ja={
{
name={"Naoya"},
"“No hables más de lo necesario...”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"(Si llegas a contarle a Akashi que Toritani está buscándolo, huirá, ¿no crees?)",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
"(Si Toritani se entera de que lo dejamos huir, no sabemos que podría hacernos\ndespués)",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"text"},
text={
ja={
{
"(Pero aun así, si tratamos de atraparlo ahora podría ocurrir el mismo desastre\nque sucedió en mi casa)",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
"(Lo mejor ahora es dejarlo 'nadar' un rato)",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"text"},
text={
ja={
{
"(En fin, llevémoslo a la sala del club de astronomía. Una vez allá podremos\nencerrarlo fácilmente)",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"(¡Te quedó claro, ¿no, Kei?!)",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"text"},
text={
ja={
{
"Le hago esas señales con los ojos a Kei.",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"Kei me observa a los ojos... Y entonces...",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0007",head="kei_z2a",x=0,lv=5,id=6},
{"text"},
delay={
vl01={
{"fg",ch="圭",size="z2",mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0003",head="kei_z2a",x=0,lv=5,id=6},
},
},
text={
vo={
{"vo",file="man_ked_000711",ch="ked"},
},
ja={
{
name={"Kei"},
"“¿Mm? ¿Por qué me observas, Naoya? ¿Te llamo la atención? ¿Tanto así te llamo yo\nla atención?”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"se",id=1,file="se0002_z"},
{"fg",mode=-2,sync=0},
{"bg",y=-270,x=-1060,zoom=110,speed=200,file="zbg047a",path=":bg/",z2=100,x2=-960,y2=-230,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="圭",size="z2",zoom=110,speed=200,mode=3,path=":fg/kei/z2/",file="kei_z2a0200",face="a0020",head="kei_z2a",y2=0,z2=100,y=20,lv=5,id=6,sync=0},
{"extrans",time=0},
{"fgact",ch="圭",act="びっくり",lv=5,id=6},
{"fgact",ch="圭",act="icon",lv=5,id=6,icon="icon09z2",x=50,y=-550},
{"text"},
text={
vo={
{"vo",file="man_ked_000712",ch="ked"},
},
ja={
{
name={"Kei"},
"“Gyan.”",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"text"},
text={
ja={
{
"Fui todo un idiota al haber esperado que un idiota como este pudiera manejar\neste método de comunicación tan avanzado...",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg047i",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0001",head="aka_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="琢磨",size="z1",mode=3,path=":fg/tkm/z1/",file="tkm_z1a0000",face="a0012",head="tkm_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
name={"Naoya"},
"“En fin, Hirose, ¿vamos ya al club de astronomía?”",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="明石",size="z1",mode=3,path=":fg/aka/z1/",file="aka_z1a0000",face="a0002",head="aka_z1a",x=-345,lv=4,id=5},
{"fgact",ch="明石",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="man_wtd_000067",ch="wtd"},
},
ja={
{
name={"Akashi"},
"“¡Vayamos con ímpetu!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
vo={
{"vo",file="man_ked_000713",ch="ked"},
},
ja={
{
name={"Kei"},
"“No sé muy bien, pero no suena mal.”",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jaa... ¿De verdad?...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule="083r",wait=250,file="black",path=":bg/",vague=40},
{"excall",file="01_fruhlingsbeginn_03_3"},
{"text"},
linkback="block_00176",
},
label = {
top={block="block_00000",label=1},
},
}
