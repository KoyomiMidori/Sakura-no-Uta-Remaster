astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"bg",file="ev_eye_c05_01",path=":ev/ev_eye_c05/",set="ev_eye_c05"},
{"ex",time=5000,func="wait"},
{"bgm",stop=1,time=1000},
{"se",stop=1,id=-1,time=1000},
{"vostop",stop=1,time=1000},
{"ntclear"},
{"cgdel",id=-1},
{"bg",time=1000,file="black",path=":bg/"},
{"cacheclear"},
{"ex",time=1000,func="wait"},
{"bg",file="bluesky_winter",sync=1,id=1,lv=5,path=":cg/"},
{"bgm",file="bgm030"},
{"text"},
text={
ja={
{
"A pesar de que es septiembre, hace algo de calor. Mi acortada sombra se agacha\nnegra ante mis pies.",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
ja={
{
"De mi frente cae una gota de sudor.",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002454",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... No te parece que...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"msgoff"},
{"bg",file="bg057a",path=":bg/",sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"cgdel",id=-1},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002455",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Que te estás saltando demasiadas clases?”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No creas, al principio traté de venir a verlo en las mañanas. Pero entonces me\nencontré con un montón de gente agolpada aquí...”",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002456",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, lo mostraron ayer en la TV, así que la gente comenzó a aglomerarse de\nnuevo.”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0010",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="おじぎ",lv=4,id=9},
{"text"},
text={
ja={
{
"Toritani lanza un pequeño suspiro.",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0015",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002457",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aun cuando por fin ya estaba comenzando a calmarse...”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿De verdad?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002458",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Incluso han venido estudiantes de otros años y salones a verte a nuestra clase.\n¿Es que acaso no te has dado cuenta?”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Para nada.”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0015",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002459",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Jaa... realmente no le prestas ni la más mínima atención a las miradas que te\npersiguen...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No me importan mucho, la verdad.”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"text"},
text={
ja={
{
"Toritani observa el mural.",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002460",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Vuelvo a repetir lo mismo que dije hace un tiempo. ¿Puede alguien que realmente\nno tenga interés en los demás prestarse a ayudar a crear algo como esto?”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Soy un hombre que ama el arte.”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002461",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Por qué no pintas, entonces?”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Amar no significa 'hacerlo'.”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0017",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002462",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué es eso? ¿Un chiste picante?”",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿De qué rayos estás hablando?”",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0012",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002463",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Eh? ¿Cuando dices que amar no significa 'hacerlo', no te estás refiriendo a\nhacer 'eso'?”",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No... Amar al arte no necesariamente significa hacer arte. Ese es el\nsignificado más razonable que se le puede dar, ¿no? A juzgar por cómo comenzó\nla conversación...”",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002464",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Eh?! ¿E-Es en serio?”",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En primer lugar, es descabellado decir que amor es igual a deseo sexual, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0010h",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0011h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002465",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uh... m-me equivoqué... corregiré, déjame corregir.”",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"Toritani corrigió su afirmación, avergonzada.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"No me pareció que hubiera necesidad de corregir, pero esa clase de actitud es\ntambién parte de su personalidad.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Parece que en particular, se alteró un poco al haberse confundido e\ninterpretado en el sentido picante. Parece que su autoritario carácter se\nesfumó por un instante y salió a relucir su verdadera y siempre oculta\npersonalidad.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005h",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002466",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡E-Estabas pensando en alguna cosa ridícula, ¿verdad?!”",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Sin embargo, su perspicacia sigue igual que como siempre.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Cambiando de tema, realmente no me esperaba eso de ti.”",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002467",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Qué?”",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que tuvieras tiempo para ver la tele.”",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002468",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No la vi, le pregunté a un compañero de clases.”",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es parte de tu recolección usual de información?”",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0002",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002469",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No es la gran cosa, y no está de más tener algo de información a la mano. Ah,\naunque es divertido también hablar con los del salón, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Me lo imagino. Das la sensación de estar siempre en medio de la gente.”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0027",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002470",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Igualmente tú.”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Yo? Diría que más bien soy la oveja negra del rebaño.”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0001",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002471",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, tienes razón. Eres una oveja negra, que a pesar de tener una cara de\n'siempre estoy en el rincón más lejano', de un momento a otro las personas\ncomienzan a agruparse a tu alrededor... Más o menos así es la imagen que\nevocas, supongo.”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0016",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002472",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque solo gente rara, eso sí.”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que tú también eres una.”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0002",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002473",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tanto Rin-chan como Rina y yo estamos fuera de ese grupo, por supuesto.”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
"Me da la ligera sensación de que falta Kawachino en esa lista, pero... bueno,\nsupongo que no hay argumento para incluirla en esa lista...",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0008",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002474",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿Y bien, qué tal si regresas ya al salón?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Mm? Ah, en un rato voy.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0010",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002475",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Por Dios...”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"msgoff"},
{"bg",y=-210,file="zbg057a",path=":bg/",ax=1920,ay=1080,bx=-960,by=-540,sync=0},
{"fg",ch="真琴",size="z2",mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0110",face="a0027",head="mak_z2a",lv=5,id=9,sync=0},
{"extrans",time=500},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002476",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Aunque bueno... por culpa del programa de ayer no había forma de hablarle\ncamino al colegio, ni tampoco en el salón...”",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0110",face="a0011",head="mak_z2a",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002477",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Me siento feliz que podamos hablar los dos sin preocuparnos por los ojos de los\ndemás, y la verdad quisiera hablar un poquito más, pero...”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"bgm",stop=1,time=500},
{"msgoff"},
{"bg",file="bg057a",path=":bg/",sync=0},
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0110",face="a0011",head="mak_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm031"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué dijiste? ¿Qué es lo que andas murmurando?”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0026",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002478",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No es nada!”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por supuesto que sí hay algo. Es raro verte diciendo cosas tan tiernas como eso\nde que te sientes feliz hablando a solas conmigo, Toritani.”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0110",face="a0018h",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002479",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“S-Se supone que debías hacer como si no hubieras escuchado nada, ¿no? Se supone\nque un verdadero protagonista debería hacerse el tonto después de decir '¿Qué\ndijiste?'.”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No tengo nada que ver con ese esquema de protagonista que describes. En fin,\nmis orejas captan absolutamente cualquier cosa solo cuando más me conviene.\n¿Qué dijiste? Dilo una vez más.”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005h",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0011h",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002480",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Se supone que te debes fingir que no escuchaste nada al principio, no al\nfinal! ¡N-No es nada!”",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero te sientes feliz de poder hablar a solas conmigo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0018h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002481",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡N-No malinterpretes las cosas, no lo dije en ese sentido!”",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Mmm, esto se siente de maravilla.”",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0008h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002482",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Qué?!”",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ni en mis sueños pensé que podría escuchar esas palabras venir de t--”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"msgoff"},
{"fg",ch="真琴",size="z1",time=300,mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0005",head="mak_z1b",lv=4,id=9},
{"ex",time=50,func="wait"},
{"se",file="se3130",id=1},
{"fg",ch="真琴",time=200,sync=1,my=40,mode=-1,lv=4,id=9},
{"fg",ch="真琴",size="z2",my=40,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2b0100",face="b0005",head="mak_z2b",lv=5,id=9},
{"se",id=2,file="se2192"},
{"quake",mode="mw"},
{"quake"},
{"text"},
text={
ja={
{
name={"Naoya"},
"*hidebuh*.",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="真琴",size="z1",my=40,mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1b0100",face="b0016",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002483",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Fu, fu, fu, ¿qué tal se siente la patada alta que he venido practicando con\nThomas?”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya te dije, que se te ven las panties, cuando haces eso...”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1b0100",face="b0003",head="mak_z1b",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002484",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“No hay problema, siempre llevo leggings abajo.”",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Es que acaso tus leggings son invisibles?”",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0013",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0005h",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002485",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡T-Tonto! ¡¿D-Dónde estás poniendo los ojos?!”",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te lo juro, lo vi todo. No tenías ningún legging puesto. Te va a ver Thomas.”",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0006h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002486",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Nadie me ha visto... Siempre me pongo los leggings antes de ir al club, y\nprocuro no lanzar patadas cuando no los tengo...”",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Por qué lo hiciste ahora entonces?”",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0018h",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005h",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002487",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“N-No lo sé. ¡Dijiste tantas idioteces que mis piernas no se pudieron quedar\nquietas! Normalmente yo no hago esa clase de cosas.”",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0006h",head="mak_z1d",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002488",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Además, la vez pasada no pudiste ver nada! ¡¿Por qué ahora si puedes ver todo\ny con lujo de detalles?!”",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, simplemente pude ver. ¿No será que aflojaste la mano conmigo?”",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0008h",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0007h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002489",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¡P-Por supuesto que no!!”",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé por qué, pero te ves algo linda, eh. ¿Por qué será que estás ahora tan\nruborizada y alterada?”",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"bgm",stop=1,time=100},
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0018h",head="mak_z1a",lv=4,id=9},
{"fgact",ch="真琴",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002490",ch="mkd"},
},
ja={
{
name={"Makoto"},
"*buchii*",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"bgm",file="bgm007"},
{"msgoff"},
{"se",file="se3130",id=1},
{"fg",ch="真琴",time=100,sync=1,my=40,mode=-1,lv=4,id=9},
{"bg",id=6,lv=6,time=200,sync=0,file="black",path=":bg/"},
{"ex",time=50,func="wait"},
{"bg",file="連続斬撃_001",id=7,lv=7,time=100,path=":cg/battle/",set="battle"},
{"se",id=1,file="se_arrow1"},
{"quake"},
{"ex",time=50,func="wait"},
{"bg",file="連続斬撃_002",id=8,lv=8,time=100,path=":cg/battle/",set="battle"},
{"se",id=2,file="se_arrow1"},
{"quake"},
{"ex",time=50,func="wait"},
{"bg",file="連続斬撃_003",id=9,lv=9,time=100,path=":cg/battle/",set="battle"},
{"se",id=3,file="se_arrow1"},
{"quake"},
{"ex",time=50,func="wait"},
{"cgdel",id=-1},
{"bg",speed=300,sync=0,file="zbg057a",path=":bg/",x2=390,y2=-180,x=590,y=-180,ax=1920,ay=1080,bx=-960,by=-540},
{"fg",ch="真琴",size="z2",speed=300,sync=0,mode=3,resize=1,path=":fg/mak/z2/",file="mak_z2a0110",face="a0005h",head="mak_z2a",x2=-200,x=0,lv=5,id=9},
{"quake"},
{"se",file="se3130",id=4},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Uohh! ¡S-Si sigues lanzando tantas patadas se te verán las panties, espera,\nno, se te ve incluso el estampado de ellas!”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0007h",head="mak_z2d",x=0,lv=5,id=9},
{"fgact",ch="真琴",act="いいえ",loop=2,time=130,size=20,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0006h",head="mak_z2d",x=0,lv=5,id=9},
},
vl02={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0110",face="d0007h",head="mak_z2d",x=0,lv=5,id=9},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
},
vl03={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0110",face="d0006h",head="mak_z2d",x=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002491",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Cállate, cállate! ¡La culpa la tienes tú por venir a sacar algo más vergonzoso\nque el tema de las pantaletas! ¡Olvidalo ya! ¡Olvida la expresión que tengo\nahora! ¡Bórrala de tu mente!”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vamos, te ves muy tierna, ¿cuál es el problema?”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0007h",head="mak_z2d",x=0,lv=5,id=9},
{"fgact",ch="真琴",act="うんうん",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002492",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Está de más que digas eso, eso es lo que trato de explicarte!”",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0005h",head="mak_z2d",x=0,lv=5,id=9},
{"se",id=1,file="se2192"},
{"fgact",ch="真琴",act="うなづく",lv=5,id=9},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Guhaa!”",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0005h",head="mak_z2d",x=0,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002493",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Bien, muy bien, atacaré tu cabeza hasta que lo olvides...”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Imbécil, si tratas de borrarme la memoria a punta de patadas me dejarás\nsecuelas en el cerebro.”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0018h",head="mak_z2d",x=0,lv=5,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2d0100",face="d0006h",head="mak_z2d",x=0,lv=5,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002494",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Eso no me importa! ¡Voy por el golpe final!”",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Kuh!”",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"bgm",stop=1,time=500},
{"se",file="se3130",id=1},
{"fg",ch="真琴",size="z2",mode=3,path=":fg/mak/z2/",file="mak_z2a0100",face="a0012h",head="mak_z2a",x=0,lv=5,id=9},
{"fgact",ch="真琴",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002495",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Qu--?!”",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"bg",file="ev_com_b04_01",path=":ev/ev_com_b04/",set="ev_com_b04"},
{"quake",mode="mw"},
{"bgm",file="bgm031"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002496",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Quuuuuu----!”",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Jejeje, la vez pasada fallé en mi intento del shinken shirahadori cuando me\natacaste con la escoba, pero esta vez se trata de tus piernas. Se te ven.”",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"bg",file="ev_com_b04_02",sync=0,face=1,time=400,path=":ev/ev_com_b04/",set="ev_com_b04"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002497",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Esp--, ocúpate solo de defenderte! ¡¿Por qué tienes que agarrar mi pierna?!”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Todo por eso que llaman por ahí 'causa justa'.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002498",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Qué demonios es eso?! ¡No entiendo nada!”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"text"},
text={
ja={
{
name={"Naoya"},
"“En la guerra siempre es necesaria una causa justa. Cuando uno es atacado la\nlegítima defensa aplica.”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"bg",file="ev_com_b04_03",sync=0,face=1,time=400,path=":ev/ev_com_b04/",set="ev_com_b04"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002499",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿A-A qué viene eso de legítima defensa?! ¡Eso no me importa ahora, solo\nsuéltame!”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Veré tus pantaletas por tantos minutos como veces me atacaste!”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"bg",file="ev_com_b04_02",sync=0,face=1,time=400,path=":ev/ev_com_b04/",set="ev_com_b04"},
{"quake",size=5,mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002500",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Pero qué rayos?! ¡¿Por qué tiene que ser así?!”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues me atacaste, así que debes hacer algo por mí como indemnización...\nSiempre te la pasas hablando de deudas y préstamos, ¿no? En este caso\nentonces yo debería cobrar de manera equivalente por todas tus agresiones,\n¿no es así?”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"bg",file="ev_com_b04_04",sync=0,face=1,time=400,path=":ev/ev_com_b04/",set="ev_com_b04"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002501",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Esto lo hago, porque dices, cosas raras...”",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que yo diga cosas raras no te da permiso de atacarme con tus piernas. Si mis\npalabras fueron inadecuadas entonces tú debías corregir eso mediante métodos\nde opinión crítica no invasivos. ¡¿Es que acaso no estoy en lo cierto?!”",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002502",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Eso...”",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"text"},
text={
ja={
{
"Ahora con una pierna hacia arriba y sus pantaletas completamente expuestas ante\nmis ojos, seguramente Toritani no debe estar en capacidad de pensar\nadecuadamente en este momento. Sus lagrimosos ojos dan vueltas. Está en total\nestado de conmoción.",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
"Basta con pensar las cosas lógicamente para darse cuenta que mis argumentos son\nsimples falacias.",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"En cualquier momento se dará cuenta. Le daré un pequeño gusto a mis ojos\nmientras tanto, ¿por qué no?",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"bg",file="ev_com_b04_05",sync=0,face=1,time=400,path=":ev/ev_com_b04/",set="ev_com_b04"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002503",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Tal vez, sea cierto, pero... p-pero, esto es vergonzoso, y ya sé que tengo la\nculpa por haberte atacado con mis piernas, déjame compensarte de alguna otra\nforma, por favor.”",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Silencio. Solicito disculpas y una compensación (pantaletas) de tu parte. ¡No\nvoy a aceptar más nada!”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002504",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“P-Por quééé...”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
"Creí que Toritani respondería de manera agresiva a mis argumentos falaces, pero\npor alguna razón está cubriendo su cara con sus manos ahora y sin ofrecer\nresistencia alguna, como si se hubiera resignado.",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002505",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y-Y bien, ¿por cuántos minutos piensas tenerme así?...”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, me diste entre 5 o 6 patadas, así que serán de 5 a 6 minutos, supongo...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002506",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Uhh... ¿p-por qué me haces esto? No creo que esto sirva de compensación\nalguna... ¿Estás tratando de hostigarme?”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no estoy tratando de hostigarte ni nada de eso... ¿Se te cansó la\npierna? ¿Quieres que pare ya?”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"bg",file="ev_com_b04_02",sync=0,face=1,time=400,path=":ev/ev_com_b04/",set="ev_com_b04"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002507",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡¿Por qué lo haces entonces?!”",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, es que...”",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Quería ver.”",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002508",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Dices eso, pero aun así nunca has tratado de verlas! ¡¿No es que puedas\nhacerlo, pero por qué ahora, Y-Y, d-de esta forma?!”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"bg",file="ev_com_b04_04",sync=0,face=1,time=400,path=":ev/ev_com_b04/",set="ev_com_b04"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002509",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Pensé que realmente no te importaban las pantis...”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"bg",file="ev_com_b04_06",sync=0,face=1,time=400,path=":ev/ev_com_b04/",set="ev_com_b04"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002510",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Además, por lo general una verdadera actitud de protagonista hace que este\nsea... sea inmune a esas tentaciones, o algo así, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué estás diciendo? ¿Y en primer lugar, qué es exactamente eso de actitud de\nprotagonista?”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"text"},
text={
vo={
{"vo",file="fem_mkd_002511",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“E-Esto... Es que, hay veces que te me pareces al protagonista de algún manga...\najaja.”",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues no, no soy ningún protagonista de manga, y me muero por ver tus\npantaletas. Esa expresión que tienes en tu rostro ahora es muy linda.”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"bg",file="ev_com_b04_03",sync=0,face=1,time=400,path=":ev/ev_com_b04/",set="ev_com_b04"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002512",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Uwaan! ¡¿Cuál se supone que es esa bendita expresión?! Estás tratando de jugar\ny tomarme el pelo, ¿verdad? ¡Ya está bien!”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, no, no estoy tratando de tomarte el pelo, pero... ¿quieres que pare ya?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"bg",file="ev_com_b04_06",sync=0,face=1,time=400,path=":ev/ev_com_b04/",set="ev_com_b04"},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002513",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Eso dejaría la deuda sin pagarse.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"bg",file="ev_com_b04_03",sync=0,face=1,time=400,path=":ev/ev_com_b04/",set="ev_com_b04"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002514",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No importa! ¡No me gustan las deudas, así que aguantaré! ¡Tonto Kusanagi!”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, e-ehm...”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"text"},
text={
ja={
{
"Parece que traje a Toritani al borde de las lágrimas.",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Perdóname...”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"se",file="se9010",id=1},
{"msgoff"},
{"bg",file="bg057a",path=":bg/",sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Bajo la pierna de Toritani.",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"fg",ch="真琴",size="z1",mode=3,resize=1,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002515",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“... Ah.”",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo siento. No tenía intención de hacerte pasar tan mal rato...”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Simplemente quería ver tus pantis...”",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0009h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002516",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¿S-Simplemente?”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Los niveles de erocontaminación de mi cabeza son realmente críticos. En lo que\na eso respecta, es tal como Kawachino lo ha venido diciendo.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002517",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y-Ya veo... entonces realmente solo querías verlas...”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, no pensé en hacerte llorar o tomarte el pelo. Y disculpa por haber\nterminado poniéndote triste.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026h",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002518",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Está bien así, entonces. Quedamos a mano con esto.”",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0008h",head="mak_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0011h",head="mak_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002519",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Más que las pantaletas, me dio vergüenza que comentaras acerca de la expresión\nque llevaba en ese momento... Si tan solo olvidas eso...”",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Entonces no olvidaré el color de tus pantis!”",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0007h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002520",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡No hace falta que lo mantengas en tu memoria!”",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, dejemos la deuda en cero con esto entonces.”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0008h",head="mak_z1d",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0009h",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002521",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Sí, se me hace mucho mejor que lo dejes así.”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0005",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002522",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Y ahora que lo pienso bien, es absurda la idea de que deba dejar que agarres mi\npierna por tantos minutos como patadas te di.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Que lo es, eh.”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
"Poco a poco, Toritani va regresando a la misma Toritani de siempre.",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1a0100",face="a0026",head="mak_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_mkd_002523",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“Dios, estuve a punto de caer víctima de tu charla persuasiva.”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque de igual manera la culpa la tienes tú por venir a patearme mostrando\ntus pantaletas en todo su esplendor.”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0100",face="d0006h",head="mak_z1d",lv=4,id=9},
{"fgact",ch="真琴",act="うんうん",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="真琴",size="z1",mode=3,path=":fg/mak/z1/",file="mak_z1d0110",face="d0007h",head="mak_z1d",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_mkd_002524",ch="mkd"},
},
ja={
{
name={"Makoto"},
"“¡Y-Ya está bien, te prohíbo que sigas diciendo eso! ¡Te lo advierto, está\nprohibido!”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vale, vale.”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"ex",time=500,func="wait"},
{"excall",file="03_picapica_05_2"},
{"text"},
linkback="block_00149",
},
label = {
top={block="block_00000",label=1},
},
}
