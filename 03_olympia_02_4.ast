astver = 2.0
astname = "ast"
ast = {
block_00000={
{"savetitle",text="Capítulo III"},
{"se",id=1,file="se1961"},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg025a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=500},
{"quake",size=5,mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡R-Rin! ¡¿Qué sucede?!”",
{"rt2"},
},
},
},
linknext="block_00001",
},
block_00001={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001406",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Auchhh... ¿Eh? ¿Ah? ¿Ehh?”",
{"rt2"},
},
},
},
linkback="block_00000",
linknext="block_00002",
},
block_00002={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh... Rin...”",
{"rt2"},
},
},
},
linkback="block_00001",
linknext="block_00003",
},
block_00003={
{"bg",file="ev_com_c04_01",path=":ev/ev_com_c04/",set="ev_com_c04"},
{"bgm",file="bgm007"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿E-Eso es?”",
{"rt2"},
},
},
},
linkback="block_00002",
linknext="block_00004",
},
block_00004={
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001407",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Ah? E-Esto... esto es...”",
{"rt2"},
},
},
},
linkback="block_00003",
linknext="block_00005",
},
block_00005={
{"text"},
text={
ja={
{
"Por alguna... razón, Rin estaba enterrada bajo una montaña de mangas eróticos.",
{"rt2"},
},
},
},
linkback="block_00004",
linknext="block_00006",
},
block_00006={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Qué es eso?”",
{"rt2"},
},
},
},
linkback="block_00005",
linknext="block_00007",
},
block_00007={
{"bg",file="ev_com_c04_02",sync=0,face=1,time=400,path=":ev/ev_com_c04/",set="ev_com_c04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001408",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... ¿R-Recuerdos, tal vez?”",
{"rt2"},
},
},
},
linkback="block_00006",
linknext="block_00008",
},
block_00008={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Recuerdos?... ¿Será que todo eso son los mangos eróticos que recogimos hace\ntiempo?”",
{"rt2"},
},
},
},
linkback="block_00007",
linknext="block_00009",
},
block_00009={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Lo que tenías oculto debajo del escritorio hace un momento... ¿era eso?”",
{"rt2"},
},
},
},
linkback="block_00008",
linknext="block_00010",
},
block_00010={
{"bg",file="ev_com_c04_03",sync=0,face=1,time=400,path=":ev/ev_com_c04/",set="ev_com_c04"},
{"mwact",act="うんうん",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001409",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajaja, no tengo... excusa alguna.”",
{"rt2"},
},
},
},
linkback="block_00009",
linknext="block_00011",
},
block_00011={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y por otro lado, ¿por qué toda esta cantidad?”",
{"rt2"},
},
},
},
linkback="block_00010",
linknext="block_00012",
},
block_00012={
{"bg",file="ev_com_c04_04",sync=0,face=1,time=400,path=":ev/ev_com_c04/",set="ev_com_c04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001410",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto... ehm... no me sentí capaz, de deshacerme de todos, y...”",
{"rt2"},
},
},
},
linkback="block_00011",
linknext="block_00013",
},
block_00013={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y espera, no fueron tantos los mangas eróticos que recogimos en aquel entonces,\n¿no?”",
{"rt2"},
},
},
},
linkback="block_00012",
linknext="block_00014",
},
block_00014={
{"bg",file="ev_com_c04_01",sync=0,face=1,time=400,path=":ev/ev_com_c04/",set="ev_com_c04"},
{"mwact",act="びっくり",size=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001411",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡E-Esto es!”",
{"rt2"},
},
},
},
linkback="block_00013",
linknext="block_00015",
},
block_00015={
{"bg",file="ev_com_c04_02",sync=0,face=1,time=400,path=":ev/ev_com_c04/",set="ev_com_c04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001412",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, lo que sucede es... cómo podría ponerlo, esto... hay ciertas series que\nme llamaban la atención, y...”",
{"rt2"},
},
},
},
linkback="block_00014",
linknext="block_00016",
},
block_00016={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Será entonces que estuviste comprándolas todo este tiempo?”",
{"rt2"},
},
},
},
linkback="block_00015",
linknext="block_00017",
},
block_00017={
{"bg",file="ev_com_c04_04",sync=0,face=1,time=400,path=":ev/ev_com_c04/",set="ev_com_c04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001413",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí... Aunque no pude completarlas todas...”",
{"rt2"},
},
},
},
linkback="block_00016",
linknext="block_00018",
},
block_00018={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Y-Ya veo...”",
{"rt2"},
},
},
},
linkback="block_00017",
linknext="block_00019",
},
block_00019={
{"text"},
text={
ja={
{
"Recuerdos.",
{"rt2"},
},
},
},
linkback="block_00018",
linknext="block_00020",
},
block_00020={
{"text"},
text={
ja={
{
"Pues sí, ciertamente lo son.",
{"rt2"},
},
},
},
linkback="block_00019",
linknext="block_00021",
},
block_00021={
{"text"},
text={
ja={
{
"Rin y yo solíamos recoger cosas de entre la basura con frecuencia.",
{"rt2"},
},
},
},
linkback="block_00020",
linknext="block_00022",
},
block_00022={
{"bgm",stop=1,time=1000},
{"text"},
text={
ja={
{
"O, así era el nombre que le dábamos a nuestra recolección de mangas eróticos.",
{"rt2"},
},
},
},
linkback="block_00021",
linknext="block_00023",
},
block_00023={
{"bg",file="black",path=":bg/"},
{"ex",time=1000,func="wait"},
{"msgoff"},
{"colortone",style="sepia"},
{"bg",file="eveningsky_winter",id=1,lv=5,path=":cg/",sync=0},
{"extrans",time=1500},
{"bgm",file="bgm036"},
{"text"},
text={
ja={
{
"Un atardecer de pleno verano.",
{"rt2"},
},
},
},
linkback="block_00022",
linknext="block_00024",
},
block_00024={
{"text"},
text={
ja={
{
"Un largo, largo atardecer.",
{"rt2"},
},
},
},
linkback="block_00023",
linknext="block_00025",
},
block_00025={
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",style="sepia"},
{"bg",zone="0x000000",file="bg083b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
"Creo que eso fue a la ladera del río.",
{"rt2"},
},
},
},
linkback="block_00024",
linknext="block_00026",
},
block_00026={
{"text"},
text={
ja={
{
"No recuerdo los detalles.",
{"rt2"},
},
},
},
linkback="block_00025",
linknext="block_00027",
},
block_00027={
{"text"},
text={
ja={
{
"Lo único que sé, es que era un escenario muy típico de la infancia.",
{"rt2"},
},
},
},
linkback="block_00026",
linknext="block_00028",
},
block_00028={
{"text"},
text={
ja={
{
"Había encontrado un manga erótico de entre los matorrales.",
{"rt2"},
},
},
},
linkback="block_00027",
linknext="block_00029",
},
block_00029={
{"text"},
text={
ja={
{
name={"Naoya"},
"... *traga saliva*",
{"rt2"},
},
},
},
linkback="block_00028",
linknext="block_00030",
},
block_00030={
{"text"},
text={
ja={
{
"Si hubiera sido una foto de una mujer desnuda, quizás no hubiera mostrado tanto\ninterés.",
{"rt2"},
},
},
},
linkback="block_00029",
linknext="block_00031",
},
block_00031={
{"text"},
text={
ja={
{
"La verdad es que ya me había hartado de ver tantos cuerpos femeninos expuestos\nen las sesiones de dibujo al desnudo, y ya solo podía ver los desnudos con\nesos ojos.",
{"rt2"},
},
},
},
linkback="block_00030",
linknext="block_00032",
},
block_00032={
{"text"},
text={
ja={
{
"Sin embargo, los mangas, con sus historias, me enseñaron por primera vez lo que\nsignificaba verdaderamente el desnudo de una mujer.",
{"rt2"},
},
},
},
linkback="block_00031",
linknext="block_00033",
},
block_00033={
{"text"},
text={
ja={
{
"Estuve minutos, o no, unas cuantas decenas de minutos... quizás hasta una hora.",
{"rt2"},
},
},
},
linkback="block_00032",
linknext="block_00034",
},
block_00034={
{"text"},
text={
ja={
{
"Estaba tan concentrado que no me di cuenta de la presencia de la personita que\ntenía detrás.",
{"rt2"},
},
},
},
linkback="block_00033",
linknext="block_00035",
},
block_00035={
{"fg",ch="稟",size="z1",mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1i0000",face="i0017",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001414",ch="rnd"},
},
ja={
{
name={"???"},
"... *mira fijamente*.",
{"rt2"},
},
},
},
linkback="block_00034",
linknext="block_00036",
},
block_00036={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿Mm?!”",
{"rt2"},
},
},
},
linkback="block_00035",
linknext="block_00037",
},
block_00037={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",style="reset"},
{"bg",file="bg083b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0017",head="rin_z1i",lv=4,id=9,sync=0},
{"extrans",time=1000},
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eh, waah, Rin!”",
{"rt2"},
},
},
},
linkback="block_00036",
linknext="block_00038",
},
block_00038={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0013",head="rin_z1i",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001415",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Waah, m-me asustaste...”",
{"rt2"},
},
},
},
linkback="block_00037",
linknext="block_00039",
},
block_00039={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Fui yo el que se asustó. ¡¿P-Por qué estuviste viendo sin decir nada?!”",
{"rt2"},
},
},
},
linkback="block_00038",
linknext="block_00040",
},
block_00040={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0011",head="rin_z1i",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001416",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Te llamé varias veces, pero... no te diste cuenta, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00039",
linknext="block_00041",
},
block_00041={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0008",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001417",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Además, es la primera vez que te veo tan concentrado en otra cosa que no\ntuviera nada que ver con pinturas...”",
{"rt2"},
},
},
},
linkback="block_00040",
linknext="block_00042",
},
block_00042={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿A-Así de concentrado andaba?”",
{"rt2"},
},
},
},
linkback="block_00041",
linknext="block_00043",
},
block_00043={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0009",head="rin_z1i",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001418",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, bastante...”",
{"rt2"},
},
},
},
linkback="block_00042",
linknext="block_00044",
},
block_00044={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿En otra cosa que no tuviera nada que ver con pinturas?... Pero si esto también\ntiene dibujos.”",
{"rt2"},
},
},
},
linkback="block_00043",
linknext="block_00045",
},
block_00045={
{"fg",ch="稟",size="z2",mode=3,resize=1,path=":fg/rin/z2/",file="rin_z2i0000",face="i0012",head="rin_z2i",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001419",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué clase de dibujos tiene?”",
{"rt2"},
},
},
},
linkback="block_00044",
linknext="block_00046",
},
block_00046={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Wa, wawawah, no lo veaaas.”",
{"rt2"},
},
},
},
linkback="block_00045",
linknext="block_00047",
},
block_00047={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0013",head="rin_z2i",lv=5,id=9},
{"fgact",ch="稟",act="びっくり",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001420",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡Ah, s-sí!”",
{"rt2"},
},
},
},
linkback="block_00046",
linknext="block_00048",
},
block_00048={
{"fg",mode=-2},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Al decir eso, Rin volteó hacia atrás.",
{"rt2"},
},
},
},
linkback="block_00047",
linknext="block_00049",
},
block_00049={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001421",ch="rnd"},
},
ja={
{
name={"Rin"},
"“A-Así está bien, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00048",
linknext="block_00050",
},
block_00050={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No, no me refería a que voltearas hacia atrás...”",
{"rt2"},
},
},
},
linkback="block_00049",
linknext="block_00051",
},
block_00051={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001422",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Qué debería hacer entonces?”",
{"rt2"},
},
},
},
linkback="block_00050",
linknext="block_00052",
},
block_00052={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Qué deberías?...”",
{"rt2"},
},
},
},
linkback="block_00051",
linknext="block_00053",
},
block_00053={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001423",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Nao-kun, dijiste que no podía ver, pero... me da curiosidad saber qué es eso,\ny...”",
{"rt2"},
},
},
},
linkback="block_00052",
linknext="block_00054",
},
block_00054={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Curiosidad...”",
{"rt2"},
},
},
},
linkback="block_00053",
linknext="block_00055",
},
block_00055={
{"text"},
text={
ja={
{
"¿Quizás pensé que de mostrárselo se asquearía y se iría?",
{"rt2"},
},
},
},
linkback="block_00054",
linknext="block_00056",
},
block_00056={
{"text"},
text={
ja={
{
"¿O es que me dio pena por Rin, quien aún teniendo interés por ello hizo todo lo\nque le dije como una buena niña?...",
{"rt2"},
},
},
},
linkback="block_00055",
linknext="block_00057",
},
block_00057={
{"text"},
text={
ja={
{
"No recuerdo los detalles.",
{"rt2"},
},
},
},
linkback="block_00056",
linknext="block_00058",
},
block_00058={
{"text"},
text={
ja={
{
"Lo único que recuerdo es que...",
{"rt2"},
},
},
},
linkback="block_00057",
linknext="block_00059",
},
block_00059={
{"text"},
text={
ja={
{
"Al darme cuenta, estábamos Rin y yo con nuestros ojos pegados a esa cosa.",
{"rt2"},
},
},
},
linkback="block_00058",
linknext="block_00060",
},
block_00060={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0008",head="rin_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001424",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Q-Qué estarán haciendo... aquí?”",
{"rt2"},
},
},
},
linkback="block_00059",
linknext="block_00061",
},
block_00061={
{"text"},
text={
ja={
{
name={"Naoya"},
"“No sé. Yo tampoco lo entiendo.”",
{"rt2"},
},
},
},
linkback="block_00060",
linknext="block_00062",
},
block_00062={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0011",head="rin_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001425",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero... Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00061",
linknext="block_00063",
},
block_00063={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Si no te gusta entonces no lo veas. ¡Si vas a verlo entonces cállate!”",
{"rt2"},
},
},
},
linkback="block_00062",
linknext="block_00064",
},
block_00064={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0017",head="rin_z2i",lv=5,id=9},
{"fgact",ch="稟",act="うなづく",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001426",ch="rnd"},
},
ja={
{
name={"Rin"},
"*mira fijamente*...",
{"rt2"},
},
},
},
linkback="block_00063",
linknext="block_00065",
},
block_00065={
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40},
{"text"},
text={
ja={
{
"Rin leyendo con detenimiento.",
{"rt2"},
},
},
},
linkback="block_00064",
linknext="block_00066",
},
block_00066={
{"text"},
text={
ja={
{
"Aún recuerdo el perfil de su cara mientras hacía eso.",
{"rt2"},
},
},
},
linkback="block_00065",
linknext="block_00067",
},
block_00067={
{"text"},
text={
ja={
{
"Su piel estaba mojada.",
{"rt2"},
},
},
},
linkback="block_00066",
linknext="block_00068",
},
block_00068={
{"text"},
text={
ja={
{
"No podía distinguir el color de su piel por el sol del atardecer.",
{"rt2"},
},
},
},
linkback="block_00067",
linknext="block_00069",
},
block_00069={
{"text"},
text={
ja={
{
"Solo que, el hecho de que sus ojos observando con tanta vehemencia y seriedad\nese manga estuvieran humedecidos dejó una fuerte impresión en mí.",
{"rt2"},
},
},
},
linkback="block_00068",
linknext="block_00070",
},
block_00070={
{"text"},
text={
ja={
{
"Un atardecer de pleno verano.",
{"rt2"},
},
},
},
linkback="block_00069",
linknext="block_00071",
},
block_00071={
{"text"},
text={
ja={
{
"El concreto abrasado por el día conservaba aún calor, y debajo de las pilas del\npuente hacía aún un calor pegajoso.",
{"rt2"},
},
},
},
linkback="block_00070",
linknext="block_00072",
},
block_00072={
{"text"},
text={
ja={
{
"Ambos teníamos las camisas empapadas de sudor.",
{"rt2"},
},
},
},
linkback="block_00071",
linknext="block_00073",
},
block_00073={
{"text"},
text={
ja={
{
"Pero aun así, no volvimos a intercambiar más palabras.",
{"rt2"},
},
},
},
linkback="block_00072",
linknext="block_00074",
},
block_00074={
{"text"},
text={
ja={
{
"Simplemente leímos una y otra vez, de comienzo a fin, ese manga.",
{"rt2"},
},
},
},
linkback="block_00073",
linknext="block_00075",
},
block_00075={
{"text"},
text={
ja={
{
"Aún después de que sonara la campana de regreso seguimos leyendo, pero la zona\ndebajo de las pilas del puente comenzó a oscurecerse poco a poco,\nimpidiéndonos seguir haciéndolo.",
{"rt2"},
},
},
},
linkback="block_00074",
linknext="block_00076",
},
block_00076={
{"cgdel",lv=1,id=5,rule="cinema",time=400},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tu familia es estricta, ¿no? ¿No deberías regresar ya?”",
{"rt2"},
},
},
},
linkback="block_00075",
linknext="block_00077",
},
block_00077={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0008",head="rin_z2i",lv=5,id=9},
{"fgact",ch="稟",act="おじぎ",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001427",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí... tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00076",
linknext="block_00078",
},
block_00078={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vámonos entonces.”",
{"rt2"},
},
},
},
linkback="block_00077",
linknext="block_00079",
},
block_00079={
{"fg",ch="稟",size="z2",mode=3,path=":fg/rin/z2/",file="rin_z2i0000",face="i0011",head="rin_z2i",lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001428",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Deberíamos irnos ya...”",
{"rt2"},
},
},
},
linkback="block_00078",
linknext="block_00080",
},
block_00080={
{"fg",ch="稟",size="z1",my=40,mode=3,resize=1,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",lv=4,id=9},
{"se",file="se9010",id=1},
{"text"},
text={
ja={
{
"Aprieto la mano de Rin y nos paramos.",
{"rt2"},
},
},
},
linkback="block_00079",
linknext="block_00081",
},
block_00081={
{"text"},
text={
ja={
{
"La mano de Rin estaba terriblemente caliente, y mojada en sudor.",
{"rt2"},
},
},
},
linkback="block_00080",
linknext="block_00082",
},
block_00082={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0009",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001429",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Q-Qué sucede?”",
{"rt2"},
},
},
},
linkback="block_00081",
linknext="block_00083",
},
block_00083={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, n-no...”",
{"rt2"},
},
},
},
linkback="block_00082",
linknext="block_00084",
},
block_00084={
{"text"},
text={
ja={
{
"La infancia.",
{"rt2"},
},
},
},
linkback="block_00083",
linknext="block_00085",
},
block_00085={
{"text"},
text={
ja={
{
"Hasta ese entonces, había apretado ya la mano de Rin incontables veces.",
{"rt2"},
},
},
},
linkback="block_00084",
linknext="block_00086",
},
block_00086={
{"text"},
text={
ja={
{
"Pero hasta ahora nunca llegué a sentir nada por ese gesto.",
{"rt2"},
},
},
},
linkback="block_00085",
linknext="block_00087",
},
block_00087={
{"text"},
text={
ja={
{
"Siempre andaba tomado de la mano con Rin, inocentemente.",
{"rt2"},
},
},
},
linkback="block_00086",
linknext="block_00088",
},
block_00088={
{"text"},
text={
ja={
{
"Sin embargo, ese día, yo...",
{"rt2"},
},
},
},
linkback="block_00087",
linknext="block_00089",
},
block_00089={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Ah, mi mano, está cubierta de sudor, así que... pensé que no sería bueno que\nagarrara la tuya...”",
{"rt2"},
},
},
},
linkback="block_00088",
linknext="block_00090",
},
block_00090={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0011",head="rin_z1i",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001430",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, para nada. Además, mi mano también está bastante sudada.”",
{"rt2"},
},
},
},
linkback="block_00089",
linknext="block_00091",
},
block_00091={
{"text"},
text={
ja={
{
name={"Naoya"},
"“A-Así parece.”",
{"rt2"},
},
},
},
linkback="block_00090",
linknext="block_00092",
},
block_00092={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0008j",head="rin_z1i",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001431",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00091",
linknext="block_00093",
},
block_00093={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Tu mano está... caliente...”",
{"rt2"},
},
},
},
linkback="block_00092",
linknext="block_00094",
},
block_00094={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0011j",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001432",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-Nao-kun, la tuya también...”",
{"rt2"},
},
},
},
linkback="block_00093",
linknext="block_00095",
},
block_00095={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00094",
linknext="block_00096",
},
block_00096={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001433",ch="rnd"},
},
ja={
{
name={"Rin"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00095",
linknext="block_00097",
},
block_00097={
{"text"},
text={
ja={
{
"Silencio.",
{"rt2"},
},
},
},
linkback="block_00096",
linknext="block_00098",
},
block_00098={
{"text"},
text={
ja={
{
"¿Es que acaso llegamos a tener algún otro rato de tan largo silencio como este\nanteriormente, aún de niños?...",
{"rt2"},
},
},
},
linkback="block_00097",
linknext="block_00099",
},
block_00099={
{"text"},
text={
ja={
{
"Al permanecer un rato sin que viniera ninguna palabra de los dos, Rin abrió su\nboca.",
{"rt2"},
},
},
},
linkback="block_00098",
linknext="block_00100",
},
block_00100={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0004",head="rin_z1i",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001434",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿V-Vamos a casa?”",
{"rt2"},
},
},
},
linkback="block_00099",
linknext="block_00101",
},
block_00101={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, vamos.”",
{"rt2"},
},
},
},
linkback="block_00100",
linknext="block_00102",
},
block_00102={
{"text"},
text={
ja={
{
"Rin sonríe alegremente.",
{"rt2"},
},
},
},
linkback="block_00101",
linknext="block_00103",
},
block_00103={
{"text"},
text={
ja={
{
"Bajo mi mirada y me doy la vuelta.",
{"rt2"},
},
},
},
linkback="block_00102",
linknext="block_00104",
},
block_00104={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0013",head="rin_z1i",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001435",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, Nao-kun... espera...”",
{"rt2"},
},
},
},
linkback="block_00103",
linknext="block_00105",
},
block_00105={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Q-Qué?”",
{"rt2"},
},
},
},
linkback="block_00104",
linknext="block_00106",
},
block_00106={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0009",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001436",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No podemos dejar la basura tirada en el suelo...”",
{"rt2"},
},
},
},
linkback="block_00105",
linknext="block_00107",
},
block_00107={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es, ¿y?”",
{"rt2"},
},
},
},
linkback="block_00106",
linknext="block_00108",
},
block_00108={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001437",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Hace unos días reunimos bastante basura con el club de niños.”",
{"rt2"},
},
},
},
linkback="block_00107",
linknext="block_00109",
},
block_00109={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Escucha, eso es porque se trata de una actividad del club de niños...”",
{"rt2"},
},
},
},
linkback="block_00108",
linknext="block_00110",
},
block_00110={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0008",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001438",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Pero incluso en los ratos normales siempre tiras toda la basura que\nencuentras, Nao-kun...”",
{"rt2"},
},
},
},
linkback="block_00109",
linknext="block_00111",
},
block_00111={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues... es que...”",
{"rt2"},
},
},
},
linkback="block_00110",
linknext="block_00112",
},
block_00112={
{"text"},
text={
ja={
{
"Desde hace bastante tiempo he tenido un fuerte sentido de la justicia por las\ncosas más raras.",
{"rt2"},
},
},
},
linkback="block_00111",
linknext="block_00113",
},
block_00113={
{"text"},
text={
ja={
{
"Una vez encontré un cigarro tirado sobre el suelo. Al ver a los lados y\nconfirmar que no venía nadie, salté a la calle, lo mojé en un charco de agua\ny luego lo lancé al bote de basura.",
{"rt2"},
},
},
},
linkback="block_00112",
linknext="block_00114",
},
block_00114={
{"text"},
text={
ja={
{
"Aunque aun así, eso y esto son cosas distintas.",
{"rt2"},
},
},
},
linkback="block_00113",
linknext="block_00115",
},
block_00115={
{"text"},
text={
ja={
{
name={"Naoya"},
"“D-Deja eso así.”",
{"rt2"},
},
},
},
linkback="block_00114",
linknext="block_00116",
},
block_00116={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0012",head="rin_z1i",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001439",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Deberíamos dejar esto así?”",
{"rt2"},
},
},
},
linkback="block_00115",
linknext="block_00117",
},
block_00117={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, así es. No importa dejarlo ahí.”",
{"rt2"},
},
},
},
linkback="block_00116",
linknext="block_00118",
},
block_00118={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0006",head="rin_z1i",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001440",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Eso no está bien.”",
{"rt2"},
},
},
},
linkback="block_00117",
linknext="block_00119",
},
block_00119={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",lv=4,id=9},
{"se",file="se9004",id=1},
{"fg",ch="稟",speed=900,mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0001",head="rin_z1i",x2=0,x=-570,lv=4,id=9},
{"text"},
delay={
[1000]={
{"se",stop=1,id=1,time=500},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"se",file="se9010",id=2},
},
},
text={
ja={
{
"Rin tomó el manga erótico en sus manos.",
{"rt2"},
},
},
},
linkback="block_00118",
linknext="block_00120",
},
block_00120={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0002",head="rin_z1i",x=-570,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001441",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Yo me encargaré de tirarlo a la basura, ¿sí?”",
{"rt2"},
},
},
},
linkback="block_00119",
linknext="block_00121",
},
block_00121={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Eh?”",
{"rt2"},
},
},
},
linkback="block_00120",
linknext="block_00122",
},
block_00122={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0011",head="rin_z1i",x=-570,lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001442",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿N-No debería?”",
{"rt2"},
},
},
},
linkback="block_00121",
linknext="block_00123",
},
block_00123={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no hay problema, supongo.”",
{"rt2"},
},
},
},
linkback="block_00122",
linknext="block_00124",
},
block_00124={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",x=-570,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001443",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí. Y además, hasta ahora siempre he tirado la basura a su lugar como debe ser.”",
{"rt2"},
},
},
},
linkback="block_00123",
linknext="block_00125",
},
block_00125={
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues sí...”",
{"rt2"},
},
},
},
linkback="block_00124",
linknext="block_00126",
},
block_00126={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"colortone",style="sepia"},
{"bg",file="bg083b",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1i0000",face="i0003",head="rin_z1i",x=-570,lv=4,id=9,sync=0},
{"extrans",time=1500},
{"ex",time=500,func="wait"},
{"bg",file="black",path=":bg/"},
{"ex",time=1500,func="wait"},
{"msgoff"},
{"colortone",style="reset"},
{"bg",file="ev_com_c04_02",path=":ev/ev_com_c04/",set="ev_com_c04",sync=0},
{"extrans",time=1000},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pensé que todos esos mangas los reuníamos para luego lanzarlos a la basura.”",
{"rt2"},
},
},
},
linkback="block_00125",
linknext="block_00127",
},
block_00127={
{"bg",file="ev_com_c04_03",sync=0,face=1,time=400,path=":ev/ev_com_c04/",set="ev_com_c04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001444",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí. Tenía toda esa intención, al principio.”",
{"rt2"},
},
},
},
linkback="block_00126",
linknext="block_00128",
},
block_00128={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Aunque, bueno, supongo que después de todo no quisiste deshacerte de ellos.”",
{"rt2"},
},
},
},
linkback="block_00127",
linknext="block_00129",
},
block_00129={
{"bg",file="ev_com_c04_04",sync=0,face=1,time=400,path=":ev/ev_com_c04/",set="ev_com_c04"},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001445",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00128",
linknext="block_00130",
},
block_00130={
{"text"},
text={
ja={
{
"Tomo un volumen de los tantos mangas eróticos que estaban amontonados sobre\nRin.",
{"rt2"},
},
},
},
linkback="block_00129",
linknext="block_00131",
},
block_00131={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Qué recuerdos me trae, eh. Esta serie era bastante caliente.”",
{"rt2"},
},
},
},
linkback="block_00130",
linknext="block_00132",
},
block_00132={
{"text"},
text={
ja={
{
"Al comentar eso, se lo muestro a Rin.",
{"rt2"},
},
},
},
linkback="block_00131",
linknext="block_00133",
},
block_00133={
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg025a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001446",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí, los dibujos son lindos, y la historia es muy interesante.”",
{"rt2"},
},
},
},
linkback="block_00132",
linknext="block_00134",
},
block_00134={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Parece que el autor comenzó a trabajar después en una revista regular. Y este\nmanga terminó con su propio anime también.”",
{"rt2"},
},
},
},
linkback="block_00133",
linknext="block_00135",
},
block_00135={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001447",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿D-De verdad?”",
{"rt2"},
},
},
},
linkback="block_00134",
linknext="block_00136",
},
block_00136={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Así que no lo sabías. Me lo imaginaba.”",
{"rt2"},
},
},
},
linkback="block_00135",
linknext="block_00137",
},
block_00137={
{"text"},
text={
ja={
{
"Contemplo los mangas eróticos de Rin.",
{"rt2"},
},
},
},
linkback="block_00136",
linknext="block_00138",
},
block_00138={
{"text"},
text={
ja={
{
"La cantidad sí que ha crecido, pero no de todo tipo.",
{"rt2"},
},
},
},
linkback="block_00137",
linknext="block_00139",
},
block_00139={
{"text"},
text={
ja={
{
"Probablemente no pudo conseguir mangas eróticos de menor fama en el campo.",
{"rt2"},
},
},
},
linkback="block_00138",
linknext="block_00140",
},
block_00140={
{"text"},
text={
ja={
{
"Y además, no había forma de que Rin pudiera saber después qué sucedió con ese\nescritor.",
{"rt2"},
},
},
},
linkback="block_00139",
linknext="block_00141",
},
block_00141={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿No te gustaría leer más mangas de este autor?”",
{"rt2"},
},
},
},
linkback="block_00140",
linknext="block_00142",
},
block_00142={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0003",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001448",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Me los prestarás?”",
{"rt2"},
},
},
},
linkback="block_00141",
linknext="block_00143",
},
block_00143={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, hay también muchos otros escritores que comenzaron a trabajar en revistas\nregulares y siguieron publicando buenos trabajos, y también hay otros que\nhicieron su debut y cuyos dibujos son más lindos que los que salen en los\nmangas eróticos que tienes.”",
{"rt2"},
},
},
},
linkback="block_00142",
linknext="block_00144",
},
block_00144={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001449",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿E-En serio?”",
{"rt2"},
},
},
},
linkback="block_00143",
linknext="block_00145",
},
block_00145={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí. Te los prestaré.”",
{"rt2"},
},
},
},
linkback="block_00144",
linknext="block_00146",
},
block_00146={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001450",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¡S-Sí, por favor!”",
{"rt2"},
},
},
},
linkback="block_00145",
linknext="block_00147",
},
block_00147={
{"text"},
text={
ja={
{
name={"Naoya"},
"“... Eh, kukuku...”",
{"rt2"},
},
},
},
linkback="block_00146",
linknext="block_00148",
},
block_00148={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001451",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? ¿Sucede algo? ¿Por qué te ríes de repente? ¿Hubo algo extraño?”",
{"rt2"},
},
},
},
linkback="block_00147",
linknext="block_00149",
},
block_00149={
{"text"},
text={
ja={
{
name={"Naoya"},
"Sí, es extraño. Realmente eres extraña, Rin. Regresaste y de repente, eras la\nchica perfecta, sin ningún tipo de defectos. Así que la verdad, por dentro\nandaba algo aterrado...”",
{"rt2"},
},
},
},
linkback="block_00148",
linknext="block_00150",
},
block_00150={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pero vaya, quién diría que te brillarían tanto los ojos al enterarte que te\nprestaría más mangas eróticos.”",
{"rt2"},
},
},
},
linkback="block_00149",
linknext="block_00151",
},
block_00151={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001452",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Uh... c-ciertamente, es raro...”",
{"rt2"},
},
},
},
linkback="block_00150",
linknext="block_00152",
},
block_00152={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001453",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Soy extraña, ¿verdad?...”",
{"rt2"},
},
},
},
linkback="block_00151",
linknext="block_00153",
},
block_00153={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Sí, bueno, sí lo eres.”",
{"rt2"},
},
},
},
linkback="block_00152",
linknext="block_00154",
},
block_00154={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001454",ch="rnd"},
},
ja={
{
name={"Rin"},
"“P-Pero de verdad me gustan todos estos escritores... así que, me alegra saber\nque podré leer sus nuevos trabajos...”",
{"rt2"},
},
},
},
linkback="block_00153",
linknext="block_00155",
},
block_00155={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00154",
linknext="block_00156",
},
block_00156={
{"text"},
text={
ja={
{
"Ya veo, así que Rin sigue siendo Rin después de todo...",
{"rt2"},
},
},
},
linkback="block_00155",
linknext="block_00157",
},
block_00157={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0010",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001455",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Soy una muchacha muy rara, ¿verdad? Gustando de historias eróticas y eso...”",
{"rt2"},
},
},
},
linkback="block_00156",
linknext="block_00158",
},
block_00158={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, tal vez lo seas, pero a mí también me gustan.”",
{"rt2"},
},
},
},
linkback="block_00157",
linknext="block_00159",
},
block_00159={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Dentro del círculo de autores de mangas eróticos, hay una buena cantidad de\nescritores que dibujan muy bien, y además hay cierta pasión en esas\npublicaciones no encuentras en los mangas de mayor popularidad. No es nada\nraro que disfrutes leyéndolos.”",
{"rt2"},
},
},
},
linkback="block_00158",
linknext="block_00160",
},
block_00160={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",time=300,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001456",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00159",
linknext="block_00161",
},
block_00161={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Quieres ir a mi casa de una vez?”",
{"rt2"},
},
},
},
linkback="block_00160",
linknext="block_00162",
},
block_00162={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0013",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001457",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Y-Ya?”",
{"rt2"},
},
},
},
linkback="block_00161",
linknext="block_00163",
},
block_00163={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, podría ser después, pero aún nos queda tiempo, ¿no?”",
{"rt2"},
},
},
},
linkback="block_00162",
linknext="block_00164",
},
block_00164={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",lv=4,id=9},
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001458",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, me encantaría ir.”",
{"rt2"},
},
},
},
linkback="block_00163",
linknext="block_00165",
},
block_00165={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Bien, ¿vamos entonces?”",
{"rt2"},
},
},
},
linkback="block_00164",
linknext="block_00166",
},
block_00166={
{"bgm",stop=1,time=2000},
{"msgoff"},
{"bg",file="zbluesky_spring",speed=240000,sync=1,id=1,lv=5,path=":cg/",x2=0,y2=0,x=-960,y=0,ax=1920,ay=1080,bx=-960,by=-540},
{"se",file="se9004",id=1},
{"text"},
text={
ja={
{
"Después de salir del apartamento de Rin en Kootoha y movernos en tren hasta\nSakuragahara, usamos el mismo camino que recorremos siempre para ir al\ncolegio.",
{"rt2"},
},
},
},
linkback="block_00165",
linknext="block_00167",
},
block_00167={
{"text"},
text={
ja={
{
"Y, al desviarnos un poco de ese camino...",
{"rt2"},
},
},
},
linkback="block_00166",
linknext="block_00168",
},
block_00168={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",lv=4,id=9,sync=0},
{"extrans",time=500},
{"bgm",file="bgm039"},
{"fgact",ch="香奈",act="うんうん",time=300,size=20,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000046",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Waaaah, Naoya-kun, tiempo sin verte!”",
{"rt2"},
},
},
},
linkback="block_00167",
linknext="block_00169",
},
block_00169={
{"text"},
text={
ja={
{
"¿Por qué me encuentro de nuevo con esta mujer?",
{"rt2"},
},
},
},
linkback="block_00168",
linknext="block_00170",
},
block_00170={
{"msgoff"},
{"se",file="se0744",vol=40,id=1},
{"fg",ch="香奈",time=500,sync=1,mode=-1,lv=4,id=9},
{"fg",ch="香奈",size="z2",time=500,sync=1,mode=3,resize=1,path=":fg/kan/z2/",file="kan_z2a0100",face="a0015",head="kan_z2a",lv=5,id=9},
{"se",stop=1,time=500,id=1},
{"fgact",ch="香奈",act="おじぎ",time=1000,lv=5,id=9},
{"text"},
text={
vo={
{"vo",file="fem_knd_000047",ch="knd"},
},
ja={
{
name={"Kana"},
"“Increíble, realmente, es increíble la casualidad, ¿no crees?... Jaa, jaa,\njaa, jaa...”",
{"rt2"},
},
},
},
linkback="block_00169",
linknext="block_00171",
},
block_00171={
{"text"},
text={
ja={
{
"La muchacha que, a simple vista vino corriendo con todas sus fuerzas, aparece\nde nuevo fingiendo casualidad.",
{"rt2"},
},
},
},
linkback="block_00170",
linknext="block_00172",
},
block_00172={
{"fg",mode=-2},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",lv=4,id=9},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Vámonos, Rin.”",
{"rt2"},
},
},
},
linkback="block_00171",
linknext="block_00173",
},
block_00173={
{"text"},
text={
ja={
{
"Jalo la mano de Rin.",
{"rt2"},
},
},
},
linkback="block_00172",
linknext="block_00174",
},
block_00174={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",x2=0,x=345,lv=4,id=9},
{"fg",ch="香奈",size="z1",mx=-40,mode=3,resize=1,path=":fg/kan/z1/",file="kan_z1a0100",face="a0007",head="kan_z1a",x=-345,lv=4,id=5},
{"se",file="se9010",id=1},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0013",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="びっくり",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000048",ch="knd"},
},
ja={
{
name={"Kana"},
"“Espera, no me gusta que me ignores. ¡Naoya-kun, Naoya-kun!... Eh, ¡¿t-tú?!”",
{"rt2"},
},
},
},
linkback="block_00173",
linknext="block_00175",
},
block_00175={
{"text"},
text={
ja={
{
"Nagayama señala a Rin mientras la jalaba de la mano.",
{"rt2"},
},
},
},
linkback="block_00174",
linknext="block_00176",
},
block_00176={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000049",ch="knd"},
},
ja={
{
name={"Kana"},
"“Uh...”",
{"rt2"},
},
},
},
linkback="block_00175",
linknext="block_00177",
},
block_00177={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0015",head="kan_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="うんうん",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000050",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Por qué hay tantas mujeres alrededor de Naoya-kun? Primero Kuzuka y ahora\nesta. Y además, de tan alto nivel.”",
{"rt2"},
},
},
},
linkback="block_00176",
linknext="block_00178",
},
block_00178={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",x=345,lv=4,id=9},
{"fgact",ch="稟",act="おじぎ",lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001459",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Esto, ¿será que eres una de las fanáticas de Naoya-kun? Si es por eso, yo\nsolo soy una compañera de clases de él, y también pertenecemos al mismo\nclub...”",
{"rt2"},
},
},
},
linkback="block_00177",
linknext="block_00179",
},
block_00179={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0013",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="びっくり",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=-345,lv=4,id=5},
{"fgact",ch="香奈",act="うんうん",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000051",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Qué?! ¡No me pongas en la misma olla que a todo ese montón de seguidoras!\n¡Naoya-kun y yo nos conocemos desde hace tiempo!”",
{"rt2"},
},
},
},
linkback="block_00178",
linknext="block_00180",
},
block_00180={
{"se",file="se9010",vol=40,id=1},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",x=345,lv=4,id=9},
{"fg",ch="稟",speed=100,mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",y2="0,-5",x=345,y=0,lv=4,id=9},
{"fg",ch="稟",speed=300,mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",x2=345,x=395,y=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001460",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿E-Es verdad eso?”",
{"rt2"},
},
},
},
linkback="block_00179",
linknext="block_00181",
},
block_00181={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=-345,lv=4,id=5},
{"fg",ch="香奈",speed=300,mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x2=-345,x=-295,lv=4,id=5},
{"se",file="se9080",id=1},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=-295,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000052",ch="knd"},
},
ja={
{
name={"Kana"},
"“Así es, mi nombre es Kana Nagayama. ¡Y déjame hacerte saber que soy la amiga de\nla infancia de Naoya-kun!”",
{"rt2"},
},
},
},
linkback="block_00180",
linknext="block_00182",
},
block_00182={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Claro que no, no me jodas.”",
{"rt2"},
},
},
},
linkback="block_00181",
linknext="block_00183",
},
block_00183={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",x=395,y=0,lv=4,id=9},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001461",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Kana... Nagayama-san?”",
{"rt2"},
},
},
},
linkback="block_00182",
linknext="block_00184",
},
block_00184={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0008",head="kan_z1a",x=-295,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000053",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Pasa algo?”",
{"rt2"},
},
},
},
linkback="block_00183",
linknext="block_00185",
},
block_00185={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",x=395,y=0,lv=4,id=9},
{"fgact",ch="稟",act="いいえ",lv=4,id=9},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=395,y=0,lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001462",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no. Yo soy Rin Misakura.”",
{"rt2"},
},
},
},
linkback="block_00184",
linknext="block_00186",
},
block_00186={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0011",head="kan_z1a",x=-295,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0013",head="kan_z1a",x=-295,lv=4,id=5},
{"fgact",ch="香奈",act="びっくり",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000054",ch="knd"},
},
ja={
{
name={"Kana"},
"“Rin... Misakura... ¿Eh? ¿Misakura?”",
{"rt2"},
},
},
},
linkback="block_00185",
linknext="block_00187",
},
block_00187={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0013",head="rin_z1a",x=395,y=0,lv=4,id=9},
{"fgact",ch="稟",act="びっくり",lv=4,id=9},
{"text"},
delay={
vl01={
{"fgact",ch="稟",act="うなづく",lv=4,id=9},
},
},
text={
vo={
{"vo",file="fem_rnd_001463",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eh? Ah, sí.”",
{"rt2"},
},
},
},
linkback="block_00186",
linknext="block_00188",
},
block_00188={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0013",head="kan_z1a",x=-295,lv=4,id=5},
{"fgact",ch="香奈",act="うんうん",lv=4,id=5},
{"text"},
delay={
vl01={
{"fgact",ch="香奈",act="びっくり",lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_knd_000055",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Rin Misakura?! ¡Tú! ¡¡Tú!!”",
{"rt2"},
},
},
},
linkback="block_00187",
linknext="block_00189",
},
block_00189={
{"bg",zone="0x000000",speed=500,file="zbg015a",path=":bg/",x2=390,y2=0,x=590,y=0,ax=1920,ay=1126,bx=-960,by=-586,sync=0},
{"fg",ch="雫",size="z2",speed=500,mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0300",face="a0001",head="shz_z2a",x2=-200,x=0,lv=5,id=9,sync=0},
{"bg",lv=1,id=5,rule="cinema",file="cinema01",alpha=255,time=400,path=":sys/",vague=40,sync=0},
{"extrans",time=200},
{"text"},
text={
vo={
{"vo",file="fem_szd_000467",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Aún estás persiguiéndolo? Kana Nagayama-san.”",
{"rt2"},
},
},
},
linkback="block_00188",
linknext="block_00190",
},
block_00190={
{"se",file="se9004",id=1},
{"msgoff"},
{"fg",mode=-2,sync=0},
{"bg",file="bg015a",path=":bg/",ax=960,ay=563,bx=0,by=-23,sync=0},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"fg",ch="雫",size="z1",mx=-40,mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_knd_000056",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Cómo que persiguiendo?! ¡¿Qué insinúas, Kuzuka Kusanagi?!”",
{"rt2"},
},
},
},
linkback="block_00189",
linknext="block_00191",
},
block_00191={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0005",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000468",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Estuviste siguiendo a Naoya todo este rato, Nagayama-san.”",
{"rt2"},
},
},
},
linkback="block_00190",
linknext="block_00192",
},
block_00192={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0005",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000057",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Y cómo sabes tú eso?!”",
{"rt2"},
},
},
},
linkback="block_00191",
linknext="block_00193",
},
block_00193={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0003",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000469",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Porque yo también estuve siguiendo a Naoya.”",
{"rt2"},
},
},
},
linkback="block_00192",
linknext="block_00194",
},
block_00194={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0007",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="icon",y=-500,lv=4,id=6,icon="icon05z1",x=40},
{"fgact",ch="香奈",act="びっくり",lv=4,id=6},
{"quake",mode="mw"},
{"text"},
text={
vo={
{"vo",file="fem_knd_000058",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Tú también?!”",
{"rt2"},
},
},
},
linkback="block_00193",
linknext="block_00195",
},
block_00195={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1d0300",face="d0016",head="shz_z1d",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000470",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí. Viendo a Rin y a Naoya juntos, decidí seguirlos, aunque eso implicara\ntomarme el día libre del trabajo.”",
{"rt2"},
},
},
},
linkback="block_00194",
linknext="block_00196",
},
block_00196={
{"text"},
text={
ja={
{
"¿Te tomaste el día libre solo para seguirnos?",
{"rt2"},
},
},
},
linkback="block_00195",
linknext="block_00197",
},
block_00197={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0005",head="shz_z1a",x=-345,lv=4,id=5},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0005",head="kan_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0003",head="shz_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000471",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aunque, parece que tú encontraste a Naoya en la estación de Sakuragahara,\npero... yo estuve siguiéndolo desde el instante en que salió de la casa\nNatsume.”",
{"rt2"},
},
},
},
linkback="block_00196",
linknext="block_00198",
},
block_00198={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Espera un segundo! ¡Shizuku! ¡¿Qué estuviste haciendo entonces mientras yo\nestaba dentro del apartamento de Rin?!”",
{"rt2"},
},
},
},
linkback="block_00197",
linknext="block_00199",
},
block_00199={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0016",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000472",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pues, estuve vigilándolos con cariño y calidez...”",
{"rt2"},
},
},
},
linkback="block_00198",
linknext="block_00200",
},
block_00200={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vigilándonos con cariño y calidez? Vamos...”",
{"rt2"},
},
},
},
linkback="block_00199",
linknext="block_00201",
},
block_00201={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0003",head="shz_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000473",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Aunque, solo en sentimiento. La verdad es que durante ese rato, estuve\ncomprando algo de comida preparada en el supermercado que había cerca.”",
{"rt2"},
},
},
},
linkback="block_00200",
linknext="block_00202",
},
block_00202={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Comida preparada?”",
{"rt2"},
},
},
},
linkback="block_00201",
linknext="block_00203",
},
block_00203={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0002",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="おじぎ",lv=4,id=5},
{"se",file="se9010",vol=70,id=1},
{"text"},
text={
ja={
{
"Al decir eso, Shizuku me mostró la gran cantidad de comida preparada que había\ncomprado.",
{"rt2"},
},
},
},
linkback="block_00202",
linknext="block_00204",
},
block_00204={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うんうん",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000059",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Sea lo que sea, la famosísima y prestigiosa actriz Kuzuka Kusanagi se prestó\npara seguir y espiar a alguien! ¡Vaya pero qué de mal gusto es eso, eh!”",
{"rt2"},
},
},
},
linkback="block_00203",
linknext="block_00205",
},
block_00205={
{"text"},
text={
ja={
{
"¿Vas a decir eso tú?",
{"rt2"},
},
},
},
linkback="block_00204",
linknext="block_00206",
},
block_00206={
{"fg",ch="雫",mode=-1,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0002",head="kan_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000060",ch="knd"},
},
ja={
{
name={"Kana"},
"“Dejando eso a un lado, Misakura-san.”",
{"rt2"},
},
},
},
linkback="block_00205",
linknext="block_00207",
},
block_00207={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001464",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, sí.”",
{"rt2"},
},
},
},
linkback="block_00206",
linknext="block_00208",
},
block_00208={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000061",ch="knd"},
},
ja={
{
name={"Kana"},
"“Eres esa Rin Misakura, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00207",
linknext="block_00209",
},
block_00209={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001465",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Esa?... ¿Qué quieres decir exactamente? Yo soy Rin Misakura.”",
{"rt2"},
},
},
},
linkback="block_00208",
linknext="block_00210",
},
block_00210={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0002",head="kan_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うんうん",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000062",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿No te acuerdas de mí? Soy Kana Nagayama. Estuvimos juntas en la primaria de\nYumihari, ¿no recuerdas?”",
{"rt2"},
},
},
},
linkback="block_00209",
linknext="block_00211",
},
block_00211={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001466",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ehm... e-esto...”",
{"rt2"},
},
},
},
linkback="block_00210",
linknext="block_00212",
},
block_00212={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000063",ch="knd"},
},
ja={
{
name={"Kana"},
"“Desde aquel entonces eras ya una chica muy linda y popular, Rin. Lo recuerdo\nmuy bien.”",
{"rt2"},
},
},
},
linkback="block_00211",
linknext="block_00213",
},
block_00213={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うんうん",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000064",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿No ves? Rin y yo somo amigas de la infancia. Y por supuesto, su amigo de la\ninfancia, Naoya-kun, también es amigo de la infancia mío.”",
{"rt2"},
},
},
},
linkback="block_00212",
linknext="block_00214",
},
block_00214={
{"text"},
text={
vo={
{"vo",file="fem_szd_000474",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No le veo la lógica a ese argumento.”",
{"rt2"},
},
},
},
linkback="block_00213",
linknext="block_00215",
},
block_00215={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000065",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿No lo ves? ¿No estoy diciendo la verdad?”",
{"rt2"},
},
},
},
linkback="block_00214",
linknext="block_00216",
},
block_00216={
{"text"},
text={
ja={
{
"Eso no es más que un sofisma.",
{"rt2"},
},
},
},
linkback="block_00215",
linknext="block_00217",
},
block_00217={
{"text"},
text={
ja={
{
"Aunque por otro lado, esta mujer, Nagayama... Realmente es bien tediosa, eh...",
{"rt2"},
},
},
},
linkback="block_00216",
linknext="block_00218",
},
block_00218={
{"text"},
text={
ja={
{
"Quién diría que trataría de meterse incluso con Rin...",
{"rt2"},
},
},
},
linkback="block_00217",
linknext="block_00219",
},
block_00219={
{"text"},
text={
ja={
{
"Así que era esto a lo que se refería Shizuku la vez pasada.",
{"rt2"},
},
},
},
linkback="block_00218",
linknext="block_00220",
},
block_00220={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000066",ch="knd"},
},
ja={
{
name={"Kana"},
"“Misakura-san, ¿en qué momento regresaste a Yumihari?”",
{"rt2"},
},
},
},
linkback="block_00219",
linknext="block_00221",
},
block_00221={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001467",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, me mudé a Yumihari en abril de este año.”",
{"rt2"},
},
},
},
linkback="block_00220",
linknext="block_00222",
},
block_00222={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000067",ch="knd"},
},
ja={
{
name={"Kana"},
"“Je, en abril de este año. Aunque vaya que no eres de subestimar, Rin.”",
{"rt2"},
},
},
},
linkback="block_00221",
linknext="block_00223",
},
block_00223={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001468",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿A qué te refieres?”",
{"rt2"},
},
},
},
linkback="block_00222",
linknext="block_00224",
},
block_00224={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000068",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ah, nada, nada, solo que aún no puedo creer que a pesar de haber regresado y\nhaber sido transferida hace poco, en solo cuestión de meses estés ahora en\nuna relación con Naoya Kusanagi, y una tal que incluso se pueden ver a solas.”",
{"rt2"},
},
},
},
linkback="block_00223",
linknext="block_00225",
},
block_00225={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0010",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
},
vl03={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0008",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001469",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Eso, no, y-yo... no es realmente tan exagerado... ¿Verdad, Nao-k... Ah, no,\nK-Kusanagi-kun.”",
{"rt2"},
},
},
},
linkback="block_00224",
linknext="block_00226",
},
block_00226={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0005",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000069",ch="knd"},
},
ja={
{
name={"Kana"},
"“Y dices que no están en ese tipo de relación, eh. ¿Aún tomándose de las manos\ncon tanta cercanía?”",
{"rt2"},
},
},
},
linkback="block_00225",
linknext="block_00227",
},
block_00227={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0310",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_rnd_001470",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Ah, eh? E-esto es--”",
{"rt2"},
},
},
},
linkback="block_00226",
linknext="block_00228",
},
block_00228={
{"text"},
text={
ja={
{
name={"Naoya"},
"“E-Esto es porque yo la jalé de la mano a la fuerza.”",
{"rt2"},
},
},
},
linkback="block_00227",
linknext="block_00229",
},
block_00229={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000070",ch="knd"},
},
ja={
{
name={"Kana"},
"“Además, según acabo de escuchar, estuviste sola en tu apartamento con\nNaoya-kun...”",
{"rt2"},
},
},
},
linkback="block_00228",
linknext="block_00230",
},
block_00230={
{"fg",ch="稟",mode=-1,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0017",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000475",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Fuh, pero qué mujer tan latosa...”",
{"rt2"},
},
},
},
linkback="block_00229",
linknext="block_00231",
},
block_00231={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000071",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Has dicho algo, Kuzuka-san?”",
{"rt2"},
},
},
},
linkback="block_00230",
linknext="block_00232",
},
block_00232={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0010",head="shz_z1b",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0005",head="shz_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000476",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin está claramente perturbada. ¿No te das cuenta de eso al verla? Y aun así,\nactúas sin escrúpulo alguno pretendiendo ser la amiga de la infancia de Rin.”",
{"rt2"},
},
},
},
linkback="block_00231",
linknext="block_00233",
},
block_00233={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0002",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000072",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pues realmente lo somos. ¿Verdad, Rin?”",
{"rt2"},
},
},
},
linkback="block_00232",
linknext="block_00234",
},
block_00234={
{"text"},
text={
vo={
{"vo",file="fem_rnd_001471",ch="rnd"},
},
ja={
{
name={"Rin"},
"“S-Sí...”",
{"rt2"},
},
},
},
linkback="block_00233",
linknext="block_00235",
},
block_00235={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0016",head="shz_z1b",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000477",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo, así que Nagayama-san y Rin son amigas de la infancia. Siendo así, sabes\nentonces dónde vivía Rin antes, ¿verdad?”",
{"rt2"},
},
},
},
linkback="block_00234",
linknext="block_00236",
},
block_00236={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0013",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="びっくり",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0011",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="いいえ",time=500,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000073",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿Eh? ¿El lugar donde Rin vivía?... Uhm, ehm.”",
{"rt2"},
},
},
},
linkback="block_00235",
linknext="block_00237",
},
block_00237={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0015",head="shz_z1b",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000478",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No eres capaz de responder.”",
{"rt2"},
},
},
},
linkback="block_00236",
linknext="block_00238",
},
block_00238={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0007",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000074",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡S-Simplemente lo olvidé!”",
{"rt2"},
},
},
},
linkback="block_00237",
linknext="block_00239",
},
block_00239={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0005",head="shz_z1b",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="いいえ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0017",head="shz_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000479",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No. No conoces absolutamente nada de Rin. ¿Debería preguntarte entonces en más\nprofundo detalle respecto a Rin, Nagayama-san?”",
{"rt2"},
},
},
},
linkback="block_00238",
linknext="block_00240",
},
block_00240={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0011",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000075",ch="knd"},
},
ja={
{
name={"Kana"},
"“P-Pues...”",
{"rt2"},
},
},
},
linkback="block_00239",
linknext="block_00241",
},
block_00241={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0015",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0005",head="shz_z1b",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000480",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Desde aquellos tiempos, ella no ha sido más que un estorbo, una molestia, que\nse la pasa todo el tiempo al lado de Naoya. ¿Puedes negar que Rin no es eso\npara ti?”",
{"rt2"},
},
},
},
linkback="block_00240",
linknext="block_00242",
},
block_00242={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="びっくり",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000076",ch="knd"},
},
ja={
{
name={"Kana"},
"“¿E-En base a qué dices eso?”",
{"rt2"},
},
},
},
linkback="block_00241",
linknext="block_00243",
},
block_00243={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0001",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000481",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ayer le dijiste a Naoya en su cara. 'Siempre me has gustado'.”",
{"rt2"},
},
},
},
linkback="block_00242",
linknext="block_00244",
},
block_00244={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000077",ch="knd"},
},
ja={
{
name={"Kana"},
"“A-Así es. ¿Algún reclamo al respecto?”",
{"rt2"},
},
},
},
linkback="block_00243",
linknext="block_00245",
},
block_00245={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0015",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000482",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Pero Naoya dice que no te conoce.”",
{"rt2"},
},
},
},
linkback="block_00244",
linknext="block_00246",
},
block_00246={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000078",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡¿Qué pasa con eso entonces?!”",
{"rt2"},
},
},
},
linkback="block_00245",
linknext="block_00247",
},
block_00247={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0011",head="kan_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000079",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Rin también me gustaba! Y en cierta forma, de verdad...”",
{"rt2"},
},
},
},
linkback="block_00246",
linknext="block_00248",
},
block_00248={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000080",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Aunque obviamente, alguien como tú no podrá entender lo que eso significa!”",
{"rt2"},
},
},
},
linkback="block_00247",
linknext="block_00249",
},
block_00249={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0001",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000483",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00248",
linknext="block_00250",
},
block_00250={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0011",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000484",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya veo... realmente eres una oponente dura.”",
{"rt2"},
},
},
},
linkback="block_00249",
linknext="block_00251",
},
block_00251={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0005",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000081",ch="knd"},
},
ja={
{
name={"Kana"},
"“Por supuesto que lo soy.”",
{"rt2"},
},
},
},
linkback="block_00250",
linknext="block_00252",
},
block_00252={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fgact",ch="香奈",act="いいえ",lv=4,id=6},
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000082",ch="knd"},
},
ja={
{
name={"Kana"},
"“Kuzuka Kusanagi... No. ¿Shizuku Natsume, era?”",
{"rt2"},
},
},
},
linkback="block_00251",
linknext="block_00253",
},
block_00253={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0001",head="shz_z1b",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000485",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, mi verdadero nombre es Shizuku Natsume.”",
{"rt2"},
},
},
},
linkback="block_00252",
linknext="block_00254",
},
block_00254={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うんうん",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000083",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡No sé por qué te entrometes en la relación mía y de Naoya-kun, pero ni creas\nque voy a flaquear solo por eso! No voy a rendirme.”",
{"rt2"},
},
},
},
linkback="block_00253",
linknext="block_00255",
},
block_00255={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1b0300",face="b0015",head="shz_z1b",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000486",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Así parece.”",
{"rt2"},
},
},
},
linkback="block_00254",
linknext="block_00256",
},
block_00256={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0017",head="kan_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0006",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="いいえ",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000084",ch="knd"},
},
ja={
{
name={"Kana"},
"“... Kuzuka. No, Shizuku. Que no se te olvide eso.”",
{"rt2"},
},
},
},
linkback="block_00255",
linknext="block_00257",
},
block_00257={
{"fg",ch="雫",mode=-1,lv=4,id=5},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0001",head="rin_z1a",x=-345,lv=4,id=5},
{"text"},
text={
ja={
{
"Al decir eso con una voz un tanto espeluznante, volteó hacia nosotros.",
{"rt2"},
},
},
},
linkback="block_00256",
linknext="block_00258",
},
block_00258={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うんうん",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000085",ch="knd"},
},
ja={
{
name={"Kana"},
"“Ejeje, parece que las cosas terminaron de forma rara otra vez. Lo siento, ¿sí?\nNaoya-kun, Rin.”",
{"rt2"},
},
},
},
linkback="block_00257",
linknext="block_00259",
},
block_00259={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0009",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="いいえ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001472",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No, discúlpame a mí. A pesar, de habernos reencontrado después de tanto tiempo,\nyo...”",
{"rt2"},
},
},
},
linkback="block_00258",
linknext="block_00260",
},
block_00260={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0002",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="おじぎ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000086",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pues sí. Aunque parece que para ti, no tengo ni siquiera valor como para ser\nrecordada, así que... no hay mucho remedio, tal vez.”",
{"rt2"},
},
},
},
linkback="block_00259",
linknext="block_00261",
},
block_00261={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0013",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001473",ch="rnd"},
},
ja={
{
name={"Rin"},
"“E-Eso no es...”",
{"rt2"},
},
},
},
linkback="block_00260",
linknext="block_00262",
},
block_00262={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0008",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000087",ch="knd"},
},
ja={
{
name={"Kana"},
"“Perdón. ¿Quizás sonó desagradable mi comentario? Aunque, no lo dije con esa\nintención.”",
{"rt2"},
},
},
},
linkback="block_00261",
linknext="block_00263",
},
block_00263={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000088",ch="knd"},
},
ja={
{
name={"Kana"},
"“Pero...”",
{"rt2"},
},
},
},
linkback="block_00262",
linknext="block_00264",
},
block_00264={
{"text"},
text={
ja={
{
"Nagayama voltea a verme.",
{"rt2"},
},
},
},
linkback="block_00263",
linknext="block_00265",
},
block_00265={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",x=345,lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0005",head="kan_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000089",ch="knd"},
},
ja={
{
name={"Kana"},
"“Fui yo quien se enamoró de él primero. Se supone que fui yo. Así que no voy a\ndesistir.”",
{"rt2"},
},
},
},
linkback="block_00264",
linknext="block_00266",
},
block_00266={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",x=-345,lv=4,id=5},
{"fgact",ch="稟",act="びっくり",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001474",ch="rnd"},
},
ja={
{
name={"Rin"},
"“--”",
{"rt2"},
},
},
},
linkback="block_00265",
linknext="block_00267",
},
block_00267={
{"text"},
text={
vo={
{"vo",file="fem_szd_000487",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00266",
linknext="block_00268",
},
block_00268={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, no tengo ni idea de lo que hablas, así que no le veo mucho sentido a eso\nde no desistir...”",
{"rt2"},
},
},
},
linkback="block_00267",
linknext="block_00269",
},
block_00269={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0003",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うなづく",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0004",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="うんうん",lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_knd_000090",ch="knd"},
},
ja={
{
name={"Kana"},
"“Bien, me iré ya por hoy. Disfruten ahora mientras puedan, muchachos.”",
{"rt2"},
},
},
},
linkback="block_00268",
linknext="block_00270",
},
block_00270={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Eh, pero escucha lo que te estoy diciendo!”",
{"rt2"},
},
},
},
linkback="block_00269",
linknext="block_00271",
},
block_00271={
{"fg",ch="香奈",size="z1",mode=3,path=":fg/kan/z1/",file="kan_z1a0100",face="a0016",head="kan_z1a",x=345,lv=4,id=6},
{"fgact",ch="香奈",act="ジャンプ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_knd_000091",ch="knd"},
},
ja={
{
name={"Kana"},
"“¡Lo estoy haciendo! ¡Pero me iré ya, adiós!”",
{"rt2"},
},
},
},
linkback="block_00270",
linknext="block_00272",
},
block_00272={
{"fg",ch="香奈",mx=-40,mode=-1,lv=4,id=6},
{"se",file="se1135",id=1},
{"text"},
text={
ja={
{
"Nagayama dio una vuelta y comenzó a correr.",
{"rt2"},
},
},
},
linkback="block_00271",
linknext="block_00273",
},
block_00273={
{"bgm",stop=1,time=1000},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué demonios le pasa?... ¡¿No piensas lo mismo, Shizuku?!”",
{"rt2"},
},
},
},
linkback="block_00272",
linknext="block_00274",
},
block_00274={
{"se",file="se9010",vol=40,id=1},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-345,lv=4,id=5},
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0004",head="shz_z1a",x=-570,lv=4,id=3},
{"fgact",ch="雫",act="いいえ",size=10,time=500,lv=4,id=3},
{"fg",ch="雫",speed=500,mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0004",head="shz_z1a",x2=-570,x=-370,lv=4,id=3},
{"fg",ch="稟",speed=500,mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x2=-345,x=-145,lv=4,id=5},
{"bgm",file="bgm031"},
{"text"},
text={
vo={
{"vo",file="fem_szd_000488",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Rin, Rin, Rin～”",
{"rt2"},
},
},
},
linkback="block_00273",
linknext="block_00275",
},
block_00275={
{"fgact",ch="雫",act="停止",lv=4,id=3},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=-145,lv=4,id=5},
{"fgact",ch="稟",act="おじぎ",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001475",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajaja, si me abrazas tan fuerte me va a doler...”",
{"rt2"},
},
},
},
linkback="block_00274",
linknext="block_00276",
},
block_00276={
{"text"},
text={
ja={
{
name={"Naoya"},
"“...”",
{"rt2"},
},
},
},
linkback="block_00275",
linknext="block_00277",
},
block_00277={
{"text"},
text={
ja={
{
"Primero una, luego la otra, de verdad que no entiendo a ninguna...",
{"rt2"},
},
},
},
linkback="block_00276",
linknext="block_00278",
},
block_00278={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Eh, Shizuku. Te estoy hablando.”",
{"rt2"},
},
},
},
linkback="block_00277",
linknext="block_00279",
},
block_00279={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0005",head="shz_z1a",x=-370,lv=4,id=3},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=-145,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000489",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Su llamada no puede ser atendida en estos momentos. Estoy disfrutando de Rin.”",
{"rt2"},
},
},
},
linkback="block_00278",
linknext="block_00280",
},
block_00280={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Pero si siempre lo estás haciendo!”",
{"rt2"},
},
},
},
linkback="block_00279",
linknext="block_00281",
},
block_00281={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0016",head="shz_z1a",x=-370,lv=4,id=3},
{"text"},
text={
vo={
{"vo",file="fem_szd_000490",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Quisiera hacerlo todos los días.”",
{"rt2"},
},
},
},
linkback="block_00280",
linknext="block_00282",
},
block_00282={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero qué rayos?...”",
{"rt2"},
},
},
},
linkback="block_00281",
linknext="block_00283",
},
block_00283={
{"fg",mode=-2},
{"fg",ch="雫",size="z2",mode=3,resize=1,path=":fg/shz/z2/",file="shz_z2a0300",face="a0001",head="shz_z2a",lv=5,id=3},
{"text"},
text={
ja={
{
name={"Naoya"},
"“Por cierto, Shizuku, ¿por qué compraste tanta comida preparada? Me parece que\nes demasiado como para el almuerzo.”",
{"rt2"},
},
},
},
linkback="block_00282",
linknext="block_00284",
},
block_00284={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0003",head="shz_z2a",lv=5,id=3},
{"text"},
text={
vo={
{"vo",file="fem_szd_000491",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Ya almorcé. Esto será la cena.”",
{"rt2"},
},
},
},
linkback="block_00283",
linknext="block_00285",
},
block_00285={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Jaa? ¿Cena?”",
{"rt2"},
},
},
},
linkback="block_00284",
linknext="block_00286",
},
block_00286={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0016",head="shz_z2a",lv=5,id=3},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0003",head="shz_z2a",lv=5,id=3},
},
},
text={
vo={
{"vo",file="fem_szd_000492",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Y por lo tanto, la cena de la familia Natsume hoy será esto. Así que pueden\npasar un buen rato los dos juntos por lo que resta del día.”",
{"rt2"},
},
},
},
linkback="block_00285",
linknext="block_00287",
},
block_00287={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Un buen rato?...”",
{"rt2"},
},
},
},
linkback="block_00286",
linknext="block_00288",
},
block_00288={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0310",face="a0017",head="shz_z2a",lv=5,id=3},
{"fgact",ch="雫",act="うんうん",lv=5,id=3},
{"text"},
text={
vo={
{"vo",file="fem_szd_000493",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No, más bien, váyanse a tu casa.”",
{"rt2"},
},
},
},
linkback="block_00287",
linknext="block_00289",
},
block_00289={
{"text"},
text={
ja={
{
name={"Naoya"},
"¿Por qué estás ordenándome?”",
{"rt2"},
},
},
},
linkback="block_00288",
linknext="block_00290",
},
block_00290={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0015",head="shz_z2a",lv=5,id=3},
{"fgact",ch="雫",act="おじぎ",lv=5,id=3},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0016",head="shz_z2a",lv=5,id=3},
},
},
text={
vo={
{"vo",file="fem_szd_000494",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sé que de no ordenarte no harás nada, Naoya. Nunca paras de preocuparte por los\ndemás, así que lo de 'váyanse' fue una orden, en todo el sentido de la\npalabra.”",
{"rt2"},
},
},
},
linkback="block_00289",
linknext="block_00291",
},
block_00291={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Pues, si es por mi apartamento, de vez en cuando voy para echarle un ojo...”",
{"rt2"},
},
},
},
linkback="block_00290",
linknext="block_00292",
},
block_00292={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0005",head="shz_z2a",lv=5,id=3},
{"text"},
text={
vo={
{"vo",file="fem_szd_000495",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Y cuándo fue la última vez que fuiste?”",
{"rt2"},
},
},
},
linkback="block_00291",
linknext="block_00293",
},
block_00293={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“P-Pues...”",
{"rt2"},
},
},
},
linkback="block_00292",
linknext="block_00294",
},
block_00294={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0002",head="shz_z2a",lv=5,id=3},
{"text"},
text={
vo={
{"vo",file="fem_szd_000496",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Las casas son seres vivos también. Si no vives en ellas de vez en cuando,\nenvejecen y se pudren, así que procura quedarte a dormir de vez en cuando en\ntu casa.”",
{"rt2"},
},
},
},
linkback="block_00293",
linknext="block_00295",
},
block_00295={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0001",head="shz_z2a",lv=5,id=3},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0008",head="shz_z2a",lv=5,id=3},
},
},
text={
vo={
{"vo",file="fem_szd_000497",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Además, ese lugar es muy importante para ti... Y además, para mí también lo es,\ny bastante...”",
{"rt2"},
},
},
},
linkback="block_00294",
linknext="block_00296",
},
block_00296={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Shizuku...”",
{"rt2"},
},
},
},
linkback="block_00295",
linknext="block_00297",
},
block_00297={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0003",head="shz_z2a",lv=5,id=3},
{"fgact",ch="雫",act="うなづく",lv=5,id=3},
{"text"},
text={
vo={
{"vo",file="fem_szd_000498",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“No te preocupes por lo que acabo de decir. Solo fue una simple equivocación.”",
{"rt2"},
},
},
},
linkback="block_00296",
linknext="block_00298",
},
block_00298={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Vas a decir que fue una equivocación?...”",
{"rt2"},
},
},
},
linkback="block_00297",
linknext="block_00299",
},
block_00299={
{"fg",ch="雫",size="z2",mode=3,path=":fg/shz/z2/",file="shz_z2a0300",face="a0004",head="shz_z2a",lv=5,id=3},
{"fgact",ch="雫",act="おじぎ",lv=5,id=3},
{"text"},
text={
vo={
{"vo",file="fem_szd_000499",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Piensa que lo fue, por favor...”",
{"rt2"},
},
},
},
linkback="block_00298",
linknext="block_00300",
},
block_00300={
{"fg",mode=-2,sync=0},
{"fg",ch="雫",size="z1",mode=3,resize=1,path=":fg/shz/z1/",file="shz_z1a0300",face="a0001",head="shz_z1a",x=-345,lv=4,id=5,sync=0},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=345,lv=4,id=6,sync=0},
{"extrans",time=500},
{"text"},
text={
ja={
{
"Al decir eso, Shizuku volteó su mirada hacia Rin.",
{"rt2"},
},
},
},
linkback="block_00299",
linknext="block_00301",
},
block_00301={
{"text"},
text={
ja={
{
"Rin tenía la misma sonrisa que siempre lleva encima.",
{"rt2"},
},
},
},
linkback="block_00300",
linknext="block_00302",
},
block_00302={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001476",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No te preocupes, Shizuku-chan. Todos saben que Nao-kun siempre anda metiéndose\nen los problemas de los demás.”",
{"rt2"},
},
},
},
linkback="block_00301",
linknext="block_00303",
},
block_00303={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Pero de qué rayos hablan?”",
{"rt2"},
},
},
},
linkback="block_00302",
linknext="block_00304",
},
block_00304={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001477",ch="rnd"},
},
ja={
{
name={"Rin"},
"“No es nada, no es nada. Solo conversábamos entre las dos.”",
{"rt2"},
},
},
},
linkback="block_00303",
linknext="block_00305",
},
block_00305={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0010",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="おじぎ",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0008",head="shz_z1a",x=-345,lv=4,id=5},
},
vl02={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0005",head="shz_z1a",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000500",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí... Pero yo soy tu aliada, Rin. Estoy solo de tu lado. Y aun si Naoya llega a\nvolverse tu enemigo, yo me convertiré en el enemigo de él.”",
{"rt2"},
},
},
},
linkback="block_00304",
linknext="block_00306",
},
block_00306={
{"mwact",act="びっくり",size=5},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡¿P-Pero qué estás diciendo?!”",
{"rt2"},
},
},
},
linkback="block_00305",
linknext="block_00307",
},
block_00307={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0003",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うんうん",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000501",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Doy fe de que la amistad entre chicas es más fuerte que todo.”",
{"rt2"},
},
},
},
linkback="block_00306",
linknext="block_00308",
},
block_00308={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Y por qué me pones de enemigo a mí?...”",
{"rt2"},
},
},
},
linkback="block_00307",
linknext="block_00309",
},
block_00309={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うんうん",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=345,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001478",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ajajaja, sí. Aunque es imposible que eso pase, así que no hay problema.”",
{"rt2"},
},
},
},
linkback="block_00308",
linknext="block_00310",
},
block_00310={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0004",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000502",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Sí, tienes razón.”",
{"rt2"},
},
},
},
linkback="block_00309",
linknext="block_00311",
},
block_00311={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0310",face="a0016",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000503",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“En fin, no hay problema con que no regreses hoy, Naoya. Ni tampoco con que te\nquedes a dormir en su apartamento, Rin.”",
{"rt2"},
},
},
},
linkback="block_00310",
linknext="block_00312",
},
block_00312={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001479",ch="rnd"},
},
ja={
{
name={"Rin"},
"“N-No, creo que eso ya es demasiado.”",
{"rt2"},
},
},
},
linkback="block_00311",
linknext="block_00313",
},
block_00313={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0012",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000504",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“¿Sí? ¿Naoya, sientes que vas a terminar haciendo 'eso'?”",
{"rt2"},
},
},
},
linkback="block_00312",
linknext="block_00314",
},
block_00314={
{"quake",mode="mw"},
{"text"},
text={
ja={
{
name={"Naoya"},
"“¡Ni en broma!”",
{"rt2"},
},
},
},
linkback="block_00313",
linknext="block_00315",
},
block_00315={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0003",head="shz_z1a",x=-345,lv=4,id=5},
{"fgact",ch="雫",act="うなづく",lv=4,id=5},
{"text"},
delay={
vl01={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1d0300",face="d0002",head="shz_z1d",x=-345,lv=4,id=5},
},
},
text={
vo={
{"vo",file="fem_szd_000505",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Bueno, esa decisión se la dejo al juicio personal de cada uno. Y por ahora,\nparece que aquí nos separamos.”",
{"rt2"},
},
},
},
linkback="block_00314",
linknext="block_00316",
},
block_00316={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0003",head="rin_z1a",x=345,lv=4,id=6},
{"fgact",ch="稟",act="うなづく",lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001480",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, sí.”",
{"rt2"},
},
},
},
linkback="block_00315",
linknext="block_00317",
},
block_00317={
{"fg",ch="雫",size="z1",mode=3,path=":fg/shz/z1/",file="shz_z1a0300",face="a0016",head="shz_z1a",x=-345,lv=4,id=5},
{"text"},
text={
vo={
{"vo",file="fem_szd_000506",ch="szd"},
},
ja={
{
name={"Shizuku"},
"“Bien, les deseo un rato de felicidad a los dos～”",
{"rt2"},
},
},
},
linkback="block_00316",
linknext="block_00318",
},
block_00318={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x=345,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001481",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Sí, adiós.”",
{"rt2"},
},
},
},
linkback="block_00317",
linknext="block_00319",
},
block_00319={
{"se",file="se9004",id=1},
{"msgoff"},
{"fg",ch="雫",speed=500,sync=1,mx=-40,mode=-1,lv=4,id=5},
{"se",stop=1,time=500,id=1},
{"text"},
text={
ja={
{
name={"Naoya"},
"“De verdad que no se entiende nada de lo que hace...”",
{"rt2"},
},
},
},
linkback="block_00318",
linknext="block_00320",
},
block_00320={
{"fg",ch="稟",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0004",head="rin_z1a",x2=345,x=0,lv=4,id=6},
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0012",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001482",ch="rnd"},
},
ja={
{
name={"Rin"},
"“¿Eso crees?”",
{"rt2"},
},
},
},
linkback="block_00319",
linknext="block_00321",
},
block_00321={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Creer qué?”",
{"rt2"},
},
},
},
linkback="block_00320",
linknext="block_00322",
},
block_00322={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0003",head="rin_z1a",x=0,lv=4,id=6},
{"text"},
text={
vo={
{"vo",file="fem_rnd_001483",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Me da la impresión de que Shizuku-chan me ha estado ayudando bastante.”",
{"rt2"},
},
},
},
linkback="block_00321",
linknext="block_00323",
},
block_00323={
{"text"},
text={
ja={
{
name={"Naoya"},
"“¿Ayudando?”",
{"rt2"},
},
},
},
linkback="block_00322",
linknext="block_00324",
},
block_00324={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0011",head="rin_z1a",x=0,lv=4,id=6},
{"fgact",ch="稟",act="いいえ",lv=4,id=6},
{"text"},
delay={
vl01={
{"fg",ch="稟",size="z1",mode=3,path=":fg/rin/z1/",file="rin_z1a0300",face="a0002",head="rin_z1a",x=0,lv=4,id=6},
},
},
text={
vo={
{"vo",file="fem_rnd_001484",ch="rnd"},
},
ja={
{
name={"Rin"},
"“Ah, no es que de verdad haya ocurrido una situación que se diera a eso, pero...\nme da esa sensación.”",
{"rt2"},
},
},
},
linkback="block_00323",
linknext="block_00325",
},
block_00325={
{"text"},
text={
ja={
{
name={"Naoya"},
"“Te da la sensación...”",
{"rt2"},
},
},
},
linkback="block_00324",
linknext="block_00326",
},
block_00326={
{"text"},
text={
ja={
{
"Da la sensación...",
{"rt2"},
},
},
},
linkback="block_00325",
linknext="block_00327",
},
block_00327={
{"text"},
text={
ja={
{
"Sí, tiene razón...",
{"rt2"},
},
},
},
linkback="block_00326",
linknext="block_00328",
},
block_00328={
{"bgm",stop=1,time=1000},
{"cgdel",id=-1},
{"bg",time=1000,rule=139,wait=500,file="black",path=":bg/",vague=40},
{"excall",file="03_olympia_02_5"},
